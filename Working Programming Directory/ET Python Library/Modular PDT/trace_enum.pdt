        ) (D |manifold [self, other]|)
        P value = self D _value_
        → self D __class__((value ^ other_value))
    }
    D Flag____invert = λ self . {
        T cond = → if self D _get_value(self) == P → → E TypeError("'" + self + "' cannot be inverted")
        T cond = → if self D _inverted_ == P → P
            T cond = → if self D _boundary_ == manifold [EJECT, KEEP] → D self_D__inverted = self D __class__((-self D _value_ - 1))  // self D _inverted_ := self D __class__((-self D _value_ - 1))
            → E D self_D__inverted = self D __class__((self D _singles_mask_ & (-self D _value_ - 1)))  // self D _inverted_ := self D __class__((self D _singles_mask_ & (-self D _value_ - 1)))
        → self D _inverted_
    }
    P __rand__ = __and__
    P __ror__ = __or__
    P __rxor__ = __xor__
D IntFlag = λ . P  // class(int, ReprEnum, Flag)
    // Support for integer-based Flags
D high_bit = λ value . {
    // returns index of highest bit, or -1 if value is zero or negative
    → (value D bit_length(P) - 1)
}
D unique = λ enumeration . {
    // Class decorator for enumerations ensuring unique member values.
    P duplicates = manifold []
    T loop = ∞ (
        P manifold__name__member = enumeration D __members__ D items(P)[_loop_index]  // manifold [name, member]
        T cond = → if name ≠ member D name → duplicates D append(manifold [name, member D name])
    ) (D |enumeration D __members__ D items(P)|)
    T cond = → if duplicates → P
        P alias_details = ", " D join({ T loop = ∞ (("%s -> %s" % manifold [alias, name])) (D |duplicates|) })
        → E ValueError(("duplicate values found in %r: %s" % manifold [enumeration, alias_details]))
    → enumeration
}
D dataclass_repr = λ self . {
    P dcf = self D __dataclass_fields__
    → ", " D join({ T loop = ∞ (("%s=%r" % manifold [k, getattr(self, k)]) → E dcf[k] D repr) (D |dcf D keys(P)|) })
}
D global_enum_repr = λ self . {
    // use module.enum_name instead of class.enum_name      the module is the last module in case of a multi-module name
    P module = self D __class__ D __module__ D split(".")[(-1)]
    → ("%s.%s" % manifold [module, self D _name_])
}
D global_flag_repr = λ self . {
    // use module.flag_name instead of class.flag_name      the module is the last module in case of a multi-module name
    P module = self D __class__ D __module__ D split(".")[(-1)]
    P cls_name = self D __class__ D __name__
    T cond = → if self D _name_ == P → → ("%s.%s(%r)" % manifold [module, cls_name, self D _value_])
    T cond = → if _is_single_bit(self D _value_) → → ("%s.%s" % manifold [module, self D _name_])
    T cond = → if self D _boundary_ ≠ FlagBoundary D KEEP → → "|" D join({ T loop = ∞ (("%s.%s" % manifold [module, name])) (D |self D name D split("|")|) })
    → E P
        P name = manifold []
        T loop = ∞ (
            P n = self D _name_ D split("|")[_loop_index]
            T cond = → if n[0] D isdigit(P) → name D append(n)
            → E name D append(("%s.%s" % manifold [module, n]))
        ) (D |self D _name_ D split("|")|)
        → "|" D join(name)
}
D global_str = λ self . {
    // use enum_name instead of class.enum_name
    T cond = → if self D _name_ == P → P
        P cls_name = self D __class__ D __name__
        → ("%s(%r)" % manifold [cls_name, self D _value_])
    → E → self D _name_
}
D global_enum = λ cls, update_str . {
    // decorator that makes the repr() of an enum member reference its module     instead of its class; also exports all member
    T cond = → if issubclass(cls, Flag) → D cls_D___repr = global_flag_repr  // cls D __repr__ := global_flag_repr
    → E D cls_D___repr = global_enum_repr  // cls D __repr__ := global_enum_repr
    T cond = → if ((!issubclass(cls, ReprEnum)) || update_str) → D cls_D___str = global_str  // cls D __str__ := global_str
    sys D modules[cls D __module__] D __dict__ D update(cls D __members__)
    → cls
}
D simple_enum = λ etype . {
    // Class decorator that converts a normal class into an :class:`Enum`.  No     safety checks are done, and some advanced be
    D convert_class = λ cls . {
        // nonlocal use_args
        P cls_name = cls D __name__
        T cond = → if use_args == P → P use_args = etype D _use_args_
        P __new__ = cls D __dict__ D get("__new__")
        T cond = → if __new__ ≠ P → P new_member = __new__ D __func__
        → E P new_member = etype D _member_type_ D __new__
        P attrs = manifold []
        P body = manifold []
        T cond = → if __new__ ≠ P → P  // pass
        // body["_new_member_"] := new_member
        // body["_use_args_"] := use_args
        // body["_generate_next_value_"] := etype D _generate_next_value_
        P gnv = etype D _generate_next_value_
        // body["_member_names_"] := manifold []
        P member_names = manifold []
        // body["_member_map_"] := manifold []
        P member_map = manifold []
        // body["_value2member_map_"] := manifold []
        P value2member_map = manifold []
        // body["_hashable_values_"] := manifold []
        P hashable_values = manifold []
        // body["_unhashable_values_"] := manifold []
        P unhashable_values = manifold []
        // body["_unhashable_values_map_"] := manifold []
        // body["_member_type_"] := etype D _member_type_
        P member_type = etype D _member_type_
        // body["_value_repr_"] := etype D _value_repr_
        T cond = → if issubclass(etype, Flag) → P  // pass
        T loop = ∞ (
            P manifold__name__obj = cls D __dict__ D items(P)[_loop_index]  // manifold [name, obj]
            T cond = → if name == manifold ["__dict__", "__weakref__"] → P  // pass
            T cond = → if (_is_dunder(name) || _is_private(cls_name, name) || _is_sunder(name) || _is_descriptor(obj)) → P  // pass
        ) (D |cls D __dict__ D items(P)|)
        T cond = → if cls D __dict__ D get("__doc__") == P → P  // pass
        P enum_class = type(cls_name, manifold [etype], body, manifold ["boundary", boundary], manifold ["_simple", 1])
        T loop = ∞ (
            P name = manifold ["__repr__", "__str__", "__format__", "__reduce_ex__"][_loop_index]
            T cond = → if name ≠ body → P
                P enum_method = getattr(etype, name)
                P found_method = getattr(enum_class, name)
                P object_method = getattr(object, name)
                P data_type_method = getattr(member_type, name)
                T cond = → if found_method == manifold [data_type_method, object_method] → setattr(enum_class, name, enum_method)
        ) (D |manifold ["__repr__", "__str__", "__format__", "__reduce_ex__"]|)
        P gnv_last_values = manifold []
        T cond = → if issubclass(enum_class, Flag) → P
            P single_bits = 0
            P multi_bits = 0
            T loop = ∞ (
                P manifold__name__value = attrs D items(P)[_loop_index]  // manifold [name, value]
                T cond = → if (isinstance(value, auto) && auto D value == _auto_null) → P value = gnv(name, 1, len(member_names), gnv_last_values)
                T cond = → if use_args → P
                    T cond = → if (!isinstance(value, tuple)) → P value = manifold [value]
                    P member = new_member(enum_class, value)
                    P value = value[0]
                → E P member = new_member(enum_class)
                T cond = → if __new__ == P → D member_D__value = value  // member D _value_ := value
                T attempt = → P  // try
                    P contained = value2member_map D get(member D _value_)
                → E TypeError (_)
                    P contained = P
                    T cond = → if (member D _value_ == unhashable_values || member D value == hashable_values) → P
                        T loop = ∞ (
                            P m = enum_class[_loop_index]
                            T cond = → if m D _value_ == member D _value_ → P contained = m
                        ) (D |enum_class|)
                T cond = → if contained ≠ P → contained D _add_alias_(name)
                → E P
                    D member_D__name = name  // member D _name_ := name
                    D member_D___objclass = enum_class  // member D __objclass__ := enum_class
                    member D __init__(value)
                    D member_D__sort_order = len(member_names)  // member D _sort_order_ := len(member_names)
                    T cond = → if name ≠ manifold ["name", "value"] → setattr(enum_class, name, member)
                    → E enum_class D _add_member_(name, member)
                    // value2member_map[value] := member
                    hashable_values D append(value)
                    T cond = → if _is_single_bit(value) → P
                        member_names D append(name)
                        P single_bits = single_bits | value
                    → E P multi_bits = multi_bits | value
                    gnv_last_values D append(value)
            ) (D |attrs D items(P)|)
            D enum_class_D__flag_mask = (single_bits | multi_bits)  // enum_class D _flag_mask_ := (single_bits | multi_bits)
            D enum_class_D__singles_mask = single_bits  // enum_class D _singles_mask_ := single_bits
            D enum_class_D__all_bits = ((2 ^ (single_bits | multi_bits) D bit_length(P)) - 1)  // enum_class D _all_bits_ := ((2 ^ (single_bits | multi_bits) D bit_length(P)) - 1)
            P member_list = { T loop = ∞ (m D _value_) (D |enum_class|) }
            T cond = → if member_list ≠ sorted(member_list) → D enum_class_D__iter_member = enum_class D _iter_member_by_def_  // enum_class D _iter_member_ := enum_class D _iter_member_by_def_
        → E P
            T loop = ∞ (
                P manifold__name__value = attrs D items(P)[_loop_index]  // manifold [name, value]
                T cond = → if isinstance(value, auto) → P
                    T cond = → if value D value == _auto_null → D value_D_value = gnv(name, 1, len(member_names), gnv_last_values)  // value D value := gnv(name, 1, len(member_names), gnv_last_values)
                    P value = value D value
                T cond = → if use_args → P
                    T cond = → if (!isinstance(value, tuple)) → P value = manifold [value]
                    P member = new_member(enum_class, value)
                    P value = value[0]
                → E P member = new_member(enum_class)
                T cond = → if __new__ == P → D member_D__value = value  // member D _value_ := value
                T attempt = → P  // try
                    P contained = value2member_map D get(member D _value_)
                → E TypeError (_)
                    P contained = P
                    T cond = → if (member D _value_ == unhashable_values || member D _value_ == hashable_values) → P
                        T loop = ∞ (
                            P m = enum_class[_loop_index]
                            T cond = → if m D _value_ == member D _value_ → P contained = m
                        ) (D |enum_class|)
                T cond = → if contained ≠ P → contained D _add_alias_(name)
                → E P
                    D member_D__name = name  // member D _name_ := name
                    D member_D___objclass = enum_class  // member D __objclass__ := enum_class
                    member D __init__(value)
                    D member_D__sort_order = len(member_names)  // member D _sort_order_ := len(member_names)
                    T cond = → if name ≠ manifold ["name", "value"] → setattr(enum_class, name, member)
                    → E enum_class D _add_member_(name, member)
                    member_names D append(name)
                    gnv_last_values D append(value)
                    T attempt = → P  // try
                        enum_class D _value2member_map_ D setdefault(value, member)
                        T cond = → if value ≠ hashable_values → hashable_values D append(value)
                    → E TypeError (_)
                        enum_class D _unhashable_values_ D append(value)
                        enum_class D _unhashable_values_map_ D setdefault(name, manifold []) D append(value)
            ) (D |attrs D items(P)|)
        T cond = → if "__new__" == body → D enum_class_D___new_member = enum_class D __new__  // enum_class D __new_member__ := enum_class D __new__
        D enum_class_D___new = Enum D __new__  // enum_class D __new__ := Enum D __new__
        → enum_class
    }
    → convert_class
}
D EnumCheck = λ . P  // class
    // various conditions to check an enumeration for
    P CONTINUOUS = "no skipped integer values"
    P NAMED_FLAGS = "multi-flag aliases may not contain unnamed flags"
    P UNIQUE = "one name per value"
P manifold__CONTINUOUS__NAMED_FLAGS__UNIQUE = EnumCheck  // manifold [CONTINUOUS, NAMED_FLAGS, UNIQUE] := EnumCheck
D verify = λ . P  // class
    // Check an enumeration for various constraints. (see EnumCheck)
    D verify____init = λ self . D self_D_checks = checks  // self D checks := checks
    D verify____call = λ self, enumeration . {
        P checks = self D checks
        P cls_name = enumeration D __name__
        T cond = → if (Flag ≠ P && issubclass(enumeration, Flag)) → P enum_type = "flag"
        → E P
            T cond = → if issubclass(enumeration, Enum) → P enum_type = "enum"
            → E → E TypeError("the 'verify' decorator only works with Enum and Flag")
        T loop = ∞ (
            P check = checks[_loop_index]
            T cond = → if check == UNIQUE → P
                P duplicates = manifold []
                T loop = ∞ (
                    P manifold__name__member = enumeration D __members__ D items(P)[_loop_index]  // manifold [name, member]
                    T cond = → if name ≠ member D name → duplicates D append(manifold [name, member D name])
                ) (D |enumeration D __members__ D items(P)|)
                T cond = → if duplicates → P
                    P alias_details = ", " D join({ T loop = ∞ (("%s -> %s" % manifold [alias, name])) (D |duplicates|) })
                    → E ValueError(("aliases found in %r: %s" % manifold [enumeration, alias_details]))
            → E P
                T cond = → if check == CONTINUOUS → P
                    P values = set({ T loop = ∞ (e D value) (D |enumeration|) })
                    T cond = → if len(values) < 2 → P  // pass
                    P manifold__low__high = manifold [min(values), max(values)]  // manifold [low, high] := manifold [min(values), max(values)]
                    P missing = manifold []
                    T cond = → if enum_type == "flag" → P
                        T loop = ∞ (
                            P i = range((_high_bit(low) + 1), _high_bit(high))[_loop_index]
                            T cond = → if (2 ^ i) ≠ values → missing D append((2 ^ i))
                        ) (D |range((_high_bit(low) + 1), _high_bit(high))|)
                    → E P
                        T cond = → if enum_type == "enum" → P
                            T loop = ∞ (
                                P i = range((low + 1), high)[_loop_index]
                                T cond = → if i ≠ values → missing D append(i)
                            ) (D |range((low + 1), high)|)
                        → E → E Exception(("verify: unknown type %r" % enum_type))
                    T cond = → if missing → → E ValueError(("invalid %s %r: missing values %s" % manifold [enum_type, cls_name, ", " D join({ T loop = ∞ (str(m)) (D |missing|) })])[0:256])
                → E P
                    T cond = → if check == NAMED_FLAGS → P
                        P member_names = enumeration D _member_names_
                        P member_values = { T loop = ∞ (m D value) (D |enumeration|) }
                        P missing_names = manifold []
                        P missing_value = 0
                        T loop = ∞ (
                            P manifold__name__alias = enumeration D _member_map_ D items(P)[_loop_index]  // manifold [name, alias]
                            T cond = → if name == member_names → P  // pass
                            T cond = → if alias D value < 0 → P  // pass
                            P values = list(_iter_bits_lsb(alias D value))
                            P missed = { T loop = ∞ (v → E v ≠ member_values) (D |values|) }
                            T cond = → if missed → P
                                missing_names D append(name)
                                T loop = ∞ (
                                    P val = missed[_loop_index]
                                    P missing_value = missing_value | val
                                ) (D |missed|)
                        ) (D |enumeration D _member_map_ D items(P)|)
                        T cond = → if missing_names → P
                            T cond = → if len(missing_names) == 1 → P alias = ("alias %s is missing" % missing_names[0])
                            → E P alias = ("aliases %s and %s are missing" % manifold [", " D join(missing_names[0:(-1)]), missing_names[(-1)]])
                            T cond = → if _is_single_bit(missing_value) → P value = ("value 0x%x" % missing_value)
                            → E P value = ("combined values of 0x%x" % missing_value)
                            → E ValueError(("invalid Flag %r: %s %s [use enum.show_flag_values(value) for details]" % manifold [cls_name, alias, value]))
        ) (D |checks|)
        → enumeration
    }
D test_simple_enum = λ checked_enum, simple_enum . {
    // A function that can be used to test an enum created with :func:`_simple_enum`     against the version created by subclas
    P failed = manifold []
    T cond = → if checked_enum D __dict__ ≠ simple_enum D __dict__ → P
        P checked_dict = checked_enum D __dict__
        P checked_keys = list(checked_dict D keys(P))
        P simple_dict = simple_enum D __dict__
        P simple_keys = list(simple_dict D keys(P))
        P member_names = set((list(checked_enum D _member_map_ D keys(P)) + list(simple_enum D _member_map_ D keys(P))))
        T loop = ∞ (
            P key = set((checked_keys + simple_keys))[_loop_index]
            T cond = → if key == manifold ["__module__", "_member_map_", "_value2member_map_", "__doc__", "__static_attributes__", "__firstlineno__"] → P  // pass
        ) (D |set((checked_keys + simple_keys))|)
        failed D sort(P)
        T loop = ∞ (
            P name = member_names[_loop_index]
            P failed_member = manifold []
            T cond = → if name ≠ simple_keys → failed D append(("missing member from simple enum: %r" % name))
            → E P
                T cond = → if name ≠ checked_keys → failed D append(("extra member in simple enum: %r" % name))
                → E P
                    P checked_member_dict = checked_enum[name] D __dict__
                    P checked_member_keys = list(checked_member_dict D keys(P))
                    P simple_member_dict = simple_enum[name] D __dict__
                    P simple_member_keys = list(simple_member_dict D keys(P))
                    T loop = ∞ (
                        P key = set((checked_member_keys + simple_member_keys))[_loop_index]
                        T cond = → if key == manifold ["__module__", "__objclass__", "_inverted_"] → P  // pass
                    ) (D |set((checked_member_keys + simple_member_keys))|)
            T cond = → if failed_member → failed D append(("%r member mismatch:\n      %s" % manifold [name, "\n      " D join(failed_member)]))
        ) (D |member_names|)
        T loop = ∞ (
            P method = manifold ["__str__", "__repr__", "__reduce_ex__", "__format__", "__getnewargs_ex__", "__getnewargs__", "__reduce_ex__", "__reduce__"][_loop_index]
            T cond = → if (method == simple_keys && method == checked_keys) → P  // pass
        ) (D |manifold ["__str__", "__repr__", "__reduce_ex__", "__format__", "__getnewargs_ex__", "__getnewargs__", "__reduce_ex__", "__reduce__"]|)
    T cond = → if failed → → E TypeError(("enum mismatch:\n   %s" % "\n   " D join(failed)))
}
D old_convert = λ etype, name, module, _et_filter, source . {
    // Create a new Enum subclass that replaces a collection of global constants
    P module_globals = sys D modules[module] D __dict__
    T cond = → if source → P source = source D __dict__
    → E P source = module_globals
    P members = { T loop = ∞ (manifold [name, value] → E _et_filter(name)) (D |source D items(P)|) }
    T attempt = → P  // try
        members D sort(manifold ["key", λ t . manifold [t[1], t[0]]])
    → E TypeError (_)
        members D sort(manifold ["key", λ t . t[0]])
    P cls = etype(name, members, manifold ["module", module], manifold ["boundary", (boundary || KEEP)])
    → cls
}
P _stdlib_enums = manifold [IntEnum, StrEnum, IntFlag]

