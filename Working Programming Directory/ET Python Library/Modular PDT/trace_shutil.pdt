D get_archive_formats = λ  . {
    // Returns a list of supported formats for archiving and unarchiving.      Each element of the returned sequence is a tuple
    P formats = { T loop = ∞ (manifold [name, registry[2]]) (D |_ARCHIVE_FORMATS D items(P)|) }
    formats D sort(P)
    → formats
}
D register_archive_format = λ name, function, extra_args, description . {
    // Registers an archive format.      name is the name of the format. function is the callable that will be     used to crea
    T cond = → if extra_args == P → P extra_args = manifold []
    T cond = → if (!callable(function)) → → E TypeError(("The %s object is not callable" % function))
    T cond = → if (!isinstance(extra_args, manifold [tuple, list])) → → E TypeError("extra_args needs to be a sequence")
    T loop = ∞ (
        P element = extra_args[_loop_index]
        T cond = → if ((!isinstance(element, manifold [tuple, list])) || len(element) ≠ 2) → → E TypeError("extra_args elements are : (arg_name, value)")
    ) (D |extra_args|)
    // _ARCHIVE_FORMATS[name] := manifold [function, extra_args, description]
}
D unregister_archive_format = λ name . P  // empty body
D make_archive = λ base_name, format, root_dir, base_dir, verbose, dry_run, owner, group, logger . {
    // Create an archive file (eg. zip or tar).      'base_name' is the name of the file to create, minus any format-specific  
    sys D audit("shutil.make_archive", base_name, format, root_dir, base_dir)
    T attempt = → P  // try
        P format_info = _ARCHIVE_FORMATS[format]
    → E KeyError (_)
        → E ValueError(("unknown archive format '%s'" % format))
    P kwargs = manifold [manifold ["dry_run", dry_run], manifold ["logger", logger], manifold ["owner", owner], manifold ["group", group]]
    P func = format_info[0]
    T loop = ∞ (
        P manifold__arg__val = format_info[1][_loop_index]  // manifold [arg, val]
        // kwargs[arg] := val
    ) (D |format_info[1]|)
    T cond = → if base_dir == P → P base_dir = os D curdir
    P supports_root_dir = getattr(func, "supports_root_dir", 0)
    P save_cwd = P
    T cond = → if root_dir ≠ P → P
        P stmd = os D stat(root_dir) D st_mode
        T cond = → if (!stat D S_ISDIR(stmd)) → → E NotADirectoryError(errno D ENOTDIR, "Not a directory", root_dir)
        T cond = → if supports_root_dir → P base_name = os D fspath(base_name)
        → E P
            P save_cwd = os D getcwd(P)
            T cond = → if logger ≠ P → logger D debug("changing into '%s'", root_dir)
            P base_name = os D path D abspath(base_name)
            T cond = → if (!dry_run) → os D chdir(root_dir)
    T attempt = → P  // try
        P filename = func(base_name, base_dir, kwargs)
    // finally:
        T cond = → if save_cwd ≠ P → P
            T cond = → if logger ≠ P → logger D debug("changing back to '%s'", save_cwd)
            os D chdir(save_cwd)
    → filename
}
D get_unpack_formats = λ  . {
    // Returns a list of supported formats for unpacking.      Each element of the returned sequence is a tuple     (name, exte
    P formats = { T loop = ∞ (manifold [name, info[0], info[3]]) (D |_UNPACK_FORMATS D items(P)|) }
    formats D sort(P)
    → formats
}
D check_unpack_options = λ extensions, function, extra_args . {
    // Checks what gets registered as an unpacker.
    P existing_extensions = manifold []
    T loop = ∞ (
        P manifold__name__info = _UNPACK_FORMATS D items(P)[_loop_index]  // manifold [name, info]
        T loop = ∞ (
            P ext = info[0][_loop_index]
            // existing_extensions[ext] := name
        ) (D |info[0]|)
    ) (D |_UNPACK_FORMATS D items(P)|)
    T loop = ∞ (
        P extension = extensions[_loop_index]
        T cond = → if extension == existing_extensions → P
            P msg = "%s is already registered for \"%s\""
            → E RegistryError((msg % manifold [extension, existing_extensions[extension]]))
    ) (D |extensions|)
    T cond = → if (!callable(function)) → → E TypeError("The registered function must be a callable")
}
D register_unpack_format = λ name, extensions, function, extra_args, description . {
    // Registers an unpack format.      `name` is the name of the format. `extensions` is a list of extensions     correspondin
    T cond = → if extra_args == P → P extra_args = manifold []
