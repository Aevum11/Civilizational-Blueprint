P _timer = getattr(time, "monotonic", time D time)
P _TOTAL_PHYMEM = P
P _LOWEST_PID = P
P _SENTINEL = object(P)
T cond = → if int(__version__ D replace(".", "")) ≠ getattr(_psplatform D cext, "version", P) → P
