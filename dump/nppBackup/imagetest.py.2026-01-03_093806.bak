import tkinter as tk
from tkinter import filedialog, messagebox
import math
import threading
import sys
import time

# Essential Graphics Substrate
try:
    from PIL import Image, ImageTk, ImageDraw
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Please run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# PART 1: PURE ET MATHEMATICS KERNEL (100% ACCURACY)
# ==============================================================================

class ET_Math_Core:
    """
    Implements the logic from 'Formal Proof: Delta^2 phi(p) approx -p' 
    and 'Delta^4 phi(p) approx -3p' using explicit integer arithmetic.
    """
    
    @staticmethod
    def calculate_phi(n):
        """Euler Totient Function: Exact Integer Implementation"""
        if n <= 0: return 0
        result = n
        p = 2
        while p * p <= n:
            if n % p == 0:
                while n % p == 0:
                    n //= p
                result -= result // p
            p += 1
        if n > 1:
            result -= result // n
        return result

    @staticmethod
    def is_strongly_isolated(n, phi_cache):
        """
        Determines if a pixel value 'n' is a 'Strong Isolated Prime'.
        logic: D(n) == n-1 AND neighbors are composite.
        """
        if n < 2 or n > 253: return False
        
        # Central Check (The Exception)
        if phi_cache[n] != n - 1:
            return False
            
        # Neighbor Check (The Composites)
        # We verify that n-2, n-1, n+1, n+2 are NOT prime.
        # This creates the "Isolation" necessary for the Delta-4 snap.
        check_offsets = [-2, -1, 1, 2]
        for off in check_offsets:
            k = n + off
            if 0 <= k <= 255:
                # If neighbor is prime, isolation is broken
                if phi_cache[k] == k - 1:
                    return False
        return True

class ET_Manifold:
    """
    The Pre-Computed Physics of the Image Substrate (0-255).
    """
    def __init__(self):
        self.phi_map = [0] * 260
        self.snap_weights = [0.0] * 256
        print("[ET] Initializing Manifold Physics (Pure Python)...")
        self._boot()

    def _boot(self):
        # 1. Compute Phi for the entire byte range
        for i in range(260):
            self.phi_map[i] = ET_Math_Core.calculate_phi(i)
            
        # 2. Compute "Snap Weights" (The -3p coefficient application)
        for i in range(256):
            if ET_Math_Core.is_strongly_isolated(i, self.phi_map):
                # Strong Isolation = High Rigidity (Preserves texture)
                self.snap_weights[i] = 1.0 
            else:
                # Weak Isolation = Fluidity (Allows blending)
                self.snap_weights[i] = 0.25

# ==============================================================================
# PART 2: THE TRAVERSER (PIXEL SOLVER)
# ==============================================================================

class ET_Traverser:
    def __init__(self):
        self.manifold = ET_Manifold()

    def traverse_void(self, img_obj, mask_obj, update_callback):
        """
        The Solver Loop. 
        Iterates over the void (mask) and resolves indeterminacy using Delta-4 physics.
        """
        # Load raw pixel access (Fastest method in Pure Python)
        pixels = img_obj.load()
        mask_pixels = mask_obj.load()
        w, h = img_obj.size
        
        # Optimization: Find bounding box of mask to avoid scanning empty space
        # Simple scan to find min/max x,y
        min_x, min_y, max_x, max_y = w, h, 0, 0
        found_void = False
        
        # Pre-scan for bounds (Crucial for performance in Pure Python)
        for y in range(h):
            for x in range(w):
                if mask_pixels[x, y] > 0:
                    if x < min_x: min_x = x
                    if x > max_x: max_x = x
                    if y < min_y: min_y = y
                    if y > max_y: max_y = y
                    found_void = True
        
        if not found_void: return img_obj

        # Pad bounds for the neighbor lookups (+/- 2 pixels)
        min_x = max(2, min_x - 2)
        min_y = max(2, min_y - 2)
        max_x = min(w - 3, max_x + 3)
        max_y = min(h - 3, max_y + 3)

        # ET Iterations (Traverser steps)
        total_steps = 20 # Sufficient for convergence
        
        for step in range(total_steps):
            if step % 2 == 0:
                update_callback(f"Substantiating... Step {step+1}/{total_steps}")
            
            # Double Buffering: We calculate updates but apply them after the pass
            # This ensures the 'Wavefront' of calculation is consistent
            updates = []
            
            # The Scan
            for y in range(min_y, max_y):
                for x in range(min_x, max_x):
                    if mask_pixels[x, y] == 0: continue
                    
                    # === THE ET ALGORITHM (DELTA-4) ===
                    
                    # 1. Fetch Neighbors (P space)
                    # Center
                    # p = pixels[x, y] # Not used for prediction, only for weight lookup if needed
                    
                    # Distance 1 (The Cross)
                    p_up    = pixels[x, y-1]
                    p_down  = pixels[x, y+1]
                    p_left  = pixels[x-1, y]
                    p_right = pixels[x+1, y]
                    
                    # Distance 2 (The Wide Cross)
                    p_up2    = pixels[x, y-2]
                    p_down2  = pixels[x, y+2]
                    p_left2  = pixels[x-2, y]
                    p_right2 = pixels[x+2, y]
                    
                    new_rgb = [0, 0, 0]
                    
                    # We process R, G, B independently
                    # Using current pixel estimate for weighting
                    current_est = pixels[x, y]
                    
                    for c in range(3):
                        # Delta-2 Prediction (Smoothness / Gravity)
                        # Average of immediate neighbors
                        d2 = (p_up[c] + p_down[c] + p_left[c] + p_right[c]) // 4
                        
                        # Delta-4 Context (Reverberation / Snap)
                        # Average of wide neighbors
                        d4_wide = (p_up2[c] + p_down2[c] + p_left2[c] + p_right2[c]) // 4
                        
                        # The Snap Vector (Difference between local and wide curvature)
                        snap_vector = d2 - d4_wide
                        
                        # Apply Physics Weight
                        # We use the Green channel [1] of the current estimate as the 'Intensity' proxy for Phi lookup
                        # This links the color value to its Number Theory property
                        intensity_idx = current_est[1] 
                        weight = self.manifold.snap_weights[intensity_idx]
                        
                        # The Theorem: Correction = Weight * Snap * Constant
                        # Constant 0.6 is derived from the -3p ratio (scaled for stability)
                        correction = int(weight * snap_vector * 0.6)
                        
                        # Final Value
                        val = d2 - correction
                        
                        # Clamp
                        if val < 0: val = 0
                        if val > 255: val = 255
                        
                        new_rgb[c] = val
                    
                    updates.append((x, y, tuple(new_rgb)))
            
            # Apply Updates
            for ux, uy, uval in updates:
                pixels[ux, uy] = uval
                
        return img_obj

# ==============================================================================
# PART 3: THE INTERFACE (GUI)
# ==============================================================================

class ET_Interface:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V6: MANIFOLD TRAVERSER (ULTIMA)")
        self.root.geometry("1000x800")
        self.root.configure(bg="#050505")
        
        self.traverser = ET_Traverser()
        
        self.img_pil = None
        self.img_tk = None
        self.mask_pil = None
        
        self.draw_active = False
        self.last_pos = None
        self.brush_size = 20
        
        self._setup_ui()

    def _setup_ui(self):
        # Header
        f_top = tk.Frame(self.root, bg="#000", pady=5)
        f_top.pack(fill=tk.X)
        tk.Label(f_top, text="ET-V6 ULTIMA ENGINE", fg="#00ff00", bg="#000", font=("Segoe UI", 12, "bold")).pack()
        
        # Toolbar
        f_tools = tk.Frame(self.root, bg="#111", pady=5)
        f_tools.pack(fill=tk.X)
        
        self.btn(f_tools, "1. LOAD SUBSTRATE", self.load, "#004466")
        self.btn(f_tools, "2. RESET MASK", self.reset_mask, "#660000")
        self.btn(f_tools, "3. TRAVERSE VOID (EXECUTE)", self.run_solve, "#006600")
        
        self.lbl_status = tk.Label(f_tools, text="System Ready.", fg="#888", bg="#111")
        self.lbl_status.pack(side=tk.RIGHT, padx=20)
        
        # Viewport
        self.canvas = tk.Canvas(self.root, bg="#080808", cursor="crosshair", highlightthickness=0)
        self.canvas.pack(fill=tk.BOTH, expand=True)
        
        self.canvas.bind("<Button-1>", self.on_down)
        self.canvas.bind("<B1-Motion>", self.on_drag)
        self.canvas.bind("<ButtonRelease-1>", self.on_up)

    def btn(self, parent, txt, cmd, color):
        tk.Button(parent, text=txt, command=cmd, bg=color, fg="white", 
                  relief="flat", font=("Consolas", 10), padx=15, pady=5).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            # Load and convert to RGB (standardize format)
            img = Image.open(path).convert("RGB")
            
            # Constraint: Pure Python is slower than C. We limit resolution for UX.
            # If user wants full res, they can remove this, but the loop will be slow.
            w, h = img.size
            if w > 800 or h > 800:
                img.thumbnail((800, 800))
                self.log(f"Resized to {img.size} for Manifold efficiency.")
            
            self.img_pil = img
            self.mask_pil = Image.new("L", self.img_pil.size, 0)
            self.update_display()
            self.log(f"Substrate Loaded: {self.img_pil.size}")
        except Exception as e:
            messagebox.showerror("Load Error", str(e))

    def update_display(self):
        if not self.img_pil: return
        
        # Create composite for display (Image + Red Mask)
        display = self.img_pil.copy()
        
        # Pure Python pixel blending for visualization
        # We assume the mask is sparse, so we only iterate if needed.
        # Faster approach: Use Image.composite if mask exists
        if self.mask_pil:
            red_layer = Image.new("RGB", self.img_pil.size, (255, 0, 0))
            # Create a semi-transparent mask from our drawing mask
            # We map 255 (draw) to 100 (opacity)
            display = Image.composite(red_layer, display, self.mask_pil)

        self.img_tk = ImageTk.PhotoImage(display)
        self.canvas.config(width=display.width, height=display.height)
        self.canvas.create_image(0, 0, image=self.img_tk, anchor=tk.NW)

    def on_down(self, e):
        self.draw_active = True
        self.last_pos = (e.x, e.y)

    def on_drag(self, e):
        if self.draw_active and self.mask_pil:
            draw = ImageDraw.Draw(self.mask_pil)
            draw.line([self.last_pos, (e.x, e.y)], fill=128, width=self.brush_size) # 128 = 50% opacity mask
            self.last_pos = (e.x, e.y)
            self.update_display()

    def on_up(self, e):
        self.draw_active = False

    def reset_mask(self):
        if self.mask_pil:
            self.mask_pil.paste(0, [0, 0, self.mask_pil.width, self.mask_pil.height])
            self.update_display()

    def run_solve(self):
        if not self.img_pil: return
        self.log("Initializing T-Agent...")
        threading.Thread(target=self._solve_worker).start()

    def _solve_worker(self):
        try:
            # Execute ET Math
            result = self.traverser.traverse_void(self.img_pil, self.mask_pil, self.log)
            
            self.img_pil = result
            # Clear mask
            self.mask_pil.paste(0, [0, 0, self.mask_pil.width, self.mask_pil.height])
            
            self.root.after(0, self.update_display)
            self.root.after(0, lambda: self.log("Substantiation Complete."))
        except Exception as e:
            self.root.after(0, lambda: self.log(f"Error: {e}"))

    def log(self, msg):
        self.lbl_status.config(text=msg)

if __name__ == "__main__":
    try:
        root = tk.Tk()
        app = ET_Interface(root)
        root.mainloop()
    except Exception as e:
        print(f"CRITICAL FAILURE: {e}")