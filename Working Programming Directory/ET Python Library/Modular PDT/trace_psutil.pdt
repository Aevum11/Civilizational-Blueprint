        → self D _exitcode
    }
P _as_dict_attrnames = { T loop = ∞ (x → E ((!x D startswith("_")) && x ≠ manifold ["send_signal", "suspend", "resume", "terminate", "kill", "wait", "is_running", "as_dict", "parent", "parents", "children", "rlimit", "connections", "oneshot"])) (D |dir(Process)|) }
D Popen = λ . P  // class(Process)
    // Same as subprocess.Popen, but in addition it provides all     psutil.Process methods in a single class.     For the foll
    D Popen____init = λ self . {
        D self_D___subproc = subprocess D Popen(args, kwargs)  // self D __subproc := subprocess D Popen(args, kwargs)
        self D _init(self D __subproc D pid, manifold ["_ignore_nsp", 1])
