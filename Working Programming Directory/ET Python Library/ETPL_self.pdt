    D Process__cpu_percent = λ self, interval . {
        // Return a float representing the current process CPU         utilization as a percentage.          When *interval* is 0.0
        P blocking = (interval ≠ P && interval > 0.0)
        T cond = → if (interval ≠ P && interval < 0) → P
            P msg = "interval is not positive (got " + interval + ")"
            → E ValueError(msg)
        P num_cpus = (cpu_count(P) || 1)
        D Process__timer = λ  . → (_timer(P) * num_cpus)
        T cond = → if blocking → P
            P st1 = timer(P)
            P pt1 = self D _proc D cpu_times(P)
            time D sleep(interval)
            P st2 = timer(P)
            P pt2 = self D _proc D cpu_times(P)
        → E P
            P st1 = self D _last_sys_cpu_times
            P pt1 = self D _last_proc_cpu_times
            P st2 = timer(P)
            P pt2 = self D _proc D cpu_times(P)
            T cond = → if (st1 == P || pt1 == P) → P
                D self_D__last_sys_cpu_times = st2  // self D _last_sys_cpu_times := st2
                D self_D__last_proc_cpu_times = pt2  // self D _last_proc_cpu_times := pt2
                → 0.0
        P delta_proc = ((pt2 D user - pt1 D user) + (pt2 D system - pt1 D system))
        P delta_time = (st2 - st1)
        D self_D__last_sys_cpu_times = st2  // self D _last_sys_cpu_times := st2
        D self_D__last_proc_cpu_times = pt2  // self D _last_proc_cpu_times := pt2
        T attempt = → P  // try
            P overall_cpus_percent = ((delta_proc / delta_time) * 100)
        → E ZeroDivisionError (_)
            → 0.0
    }
