    D FrameSummary____repr = λ self . → "<FrameSummary file {filename}, line {lineno} in {name}>" D format(manifold ["filename", self D filename], manifold ["lineno", self D lineno], manifold ["name", self D name])
    D FrameSummary____len = λ self . → 4
    D FrameSummary___set_lines = λ self . {
        T cond = → if (self D _lines == P && self D lineno ≠ P && self D end_lineno ≠ P) → P
