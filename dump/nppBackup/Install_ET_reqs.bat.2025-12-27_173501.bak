@echo off
setlocal

echo [1/4] Installing Core Math (Numpy, Scipy)...
python -m pip install "numpy>=1.20.0" "scipy>=1.7.0"
if %errorlevel% neq 0 goto :error

echo.
echo [2/4] Installing Visualization and Astronomy (Matplotlib, Astropy)...
python -m pip install "matplotlib>=3.4.0" "astropy>=5.0"
if %errorlevel% neq 0 goto :error

echo.
echo [3/4] Installing Data and Optionals (NetCDF4, H5py, Fitsio, Joblib)...
python -m pip install "netCDF4>=1.5.0" "h5py>=3.0.0" "fitsio>=1.1.0" "joblib>=1.0.0"
if %errorlevel% neq 0 goto :error

echo.
echo [4/4] Verifying Installation...
python -c "import numpy, scipy, matplotlib, astropy, netCDF4, h5py, fitsio, joblib, tkinter; print('SUCCESS: All requirements installed and verified.')"
if %errorlevel% neq 0 goto :error

echo.
echo Done.
pause
exit /b 0

:error
echo.
echo ERROR: Installation failed.
pause
exit /b 1