D FrozenInstanceError = λ . P  // class(AttributeError)
    // pass
D HAS_DEFAULT_FACTORY_CLASS = λ . P  // class
    D HAS_DEFAULT_FACTORY_CLASS____repr = λ self . → "<factory>"
P _HAS_DEFAULT_FACTORY = _HAS_DEFAULT_FACTORY_CLASS(P)
D MISSING_TYPE = λ . P  // class
    // pass
P MISSING = _MISSING_TYPE(P)
D KW_ONLY_TYPE = λ . P  // class
    // pass
P KW_ONLY = _KW_ONLY_TYPE(P)
P _EMPTY_METADATA = types D MappingProxyType(manifold [])
D FIELD_BASE = λ . P  // class
    D FIELD_BASE____init = λ self, name . D self_D_name = name  // self D name := name
    D FIELD_BASE____repr = λ self . → self D name
P _FIELD = _FIELD_BASE("_FIELD")
P _FIELD_CLASSVAR = _FIELD_BASE("_FIELD_CLASSVAR")
P _FIELD_INITVAR = _FIELD_BASE("_FIELD_INITVAR")
P _FIELDS = "__dataclass_fields__"
P _PARAMS = "__dataclass_params__"
P _POST_INIT_NAME = "__post_init__"
P _MODULE_IDENTIFIER_RE = re D compile("^(?:\\s*(\\w+)\\s*\\.)?\\s*(\\w+)")
P _ATOMIC_TYPES = frozenset(manifold [types D NoneType, bool, int, float, str, complex, bytes, types D EllipsisType, types D NotImplementedType, types D CodeType, types D BuiltinFunctionType, types D FunctionType, type, range, property])
D InitVar = λ . P  // class
    P __slots__ = manifold ["type"]
    D InitVar____init = λ self, type . D self_D_type = type  // self D type := type
    D InitVar____repr = λ self . {
        T cond = → if isinstance(self D type, type) → P type_name = self D type D __name__
        → E P type_name = repr(self D type)
        → "dataclasses.InitVar[" + type_name + "]"
    }
    D InitVar____class_getitem = λ cls, type . → InitVar(type)
D Field = λ . P  // class
