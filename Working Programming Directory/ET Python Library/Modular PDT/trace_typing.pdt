D UnpackGenericAlias = λ . P  // class(_GenericAlias)
    D UnpackGenericAlias____repr = λ self . → "typing.Unpack[" + _type_repr(self D __args__[0]) + "]"
    D UnpackGenericAlias____getitem = λ self, args . {
        T cond = → if self D __typing_is_unpacked_typevartuple__ → → args
        → super(P) D __getitem__(args)
    }
    D UnpackGenericAlias____typing_unpacked_tuple_args = λ self . {
        T assert = → if self D __origin__ == Unpack → "ok" → E "Assertion failed"
        T assert = → if len(self D __args__) == 1 → "ok" → E "Assertion failed"
        P manifold__arg = self D __args__  // manifold [arg] := self D __args__
        T cond = → if isinstance(arg, manifold [_GenericAlias, types D GenericAlias]) → P
            T cond = → if arg D __origin__ ≠ tuple → → E TypeError("Unpack[...] must be used with a tuple type")
            → arg D __args__
        → P
    }
    D UnpackGenericAlias____typing_is_unpacked_typevartuple = λ self . {
        T assert = → if self D __origin__ == Unpack → "ok" → E "Assertion failed"
        T assert = → if len(self D __args__) == 1 → "ok" → E "Assertion failed"
        → isinstance(self D __args__[0], TypeVarTuple)
    }
D TypingEllipsis = λ . P  // class
    // Internal placeholder for ... (ellipsis).
P _TYPING_INTERNALS = frozenset(manifold ["__parameters__", "__orig_bases__", "__orig_class__", "_is_protocol", "_is_runtime_protocol", "__protocol_attrs__", "__non_callable_proto_members__", "__type_params__"])
P _SPECIAL_NAMES = frozenset(manifold ["__abstractmethods__", "__annotations__", "__dict__", "__doc__", "__init__", "__module__", "__new__", "__slots__", "__subclasshook__", "__weakref__", "__class_getitem__", "__match_args__", "__static_attributes__", "__firstlineno__"])
P EXCLUDED_ATTRIBUTES = ((_TYPING_INTERNALS | _SPECIAL_NAMES) | manifold ["_MutableMapping__marker"])
D get_protocol_attrs = λ cls . {
    // Collect protocol members from a protocol class objects.      This includes names actually defined in the class dictionar
    P attrs = set(P)
    T loop = ∞ (
        P base = cls D __mro__[0:(-1)][_loop_index]
        T cond = → if base D __name__ == manifold ["Protocol", "Generic"] → P  // pass
        P annotations = getattr(base, "__annotations__", manifold [])
        T loop = ∞ (
            P attr = manifold [base D __dict__, annotations][_loop_index]
            T cond = → if ((!attr D startswith("_abc_")) && attr ≠ EXCLUDED_ATTRIBUTES) → attrs D add(attr)
        ) (D |manifold [base D __dict__, annotations]|)
    ) (D |cls D __mro__[0:(-1)]|)
    → attrs
}
D no_init_or_replace_init = λ self . {
    P cls = type(self)
    T cond = → if cls D _is_protocol → → E TypeError("Protocols cannot be instantiated")
    T cond = → if cls D __init__ ≠ _no_init_or_replace_init → → P
    T loop = ∞ (
        P base = cls D __mro__[_loop_index]
        P init = base D __dict__ D get("__init__", _no_init_or_replace_init)
        T cond = → if init ≠ _no_init_or_replace_init → D cls_D___init = init  // cls D __init__ := init
    ) (D |cls D __mro__|)
    cls D __init__(self, args, kwargs)
}
D caller = λ depth, default . {
    T attempt = → P  // try
        → (sys D _getframemodulename((depth + 1)) || default)
    → E AttributeError (_)
        // pass
    T attempt = → P  // try
        → sys D _getframe((depth + 1)) D f_globals D get("__name__", default)
    → E manifold [AttributeError, ValueError] (_)
        // pass
    → P
}
D allow_reckless_class_checks = λ depth . {
    // Allow instance and class checks for special stdlib modules.      The abc and functools modules indiscriminately call isi
    → _caller(depth) == manifold ["abc", "functools", P]
