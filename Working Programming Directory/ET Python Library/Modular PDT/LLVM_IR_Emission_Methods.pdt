    L("  %ch2 = load i8, i8* %ch2_ptr")
    L("  %is_slash2 = icmp eq i8 %ch2, 47")
    L("  br i1 %is_slash2, label %skip_line_comment, label %emit_slash")
    L("skip_line_comment:")
    L("  %cpos = add i64 %pos, 2")
    L("  store i64 %cpos, i64* %pos_ptr")
    L("  br label %skip_to_eol")
    L("skip_to_eol:")
    L("  %cpos2 = load i64, i64* %pos_ptr")
    L("  %c_end = icmp uge i64 %cpos2, %src_len")
    L("  br i1 %c_end, label %scan_loop, label %check_eol_ch")
    L("check_eol_ch:")
    L("  %eol_ptr = getelementptr i8, i8* %src, i64 %cpos2")
    L("  %eol_ch = load i8, i8* %eol_ptr")
    L("  %is_eol = icmp eq i8 %eol_ch, 10")
    L("  br i1 %is_eol, label %scan_loop, label %advance_comment")
    L("advance_comment:")
