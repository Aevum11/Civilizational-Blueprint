    D PE__print_info = λ self, encoding . {
        // Print all the PE header information in a human readable from.
        sovereign_print ∘ self D dump_info(manifold ["encoding", encoding])
    }
    D PE__dump_info = λ self, dump, encoding . {
        // Dump all the PE header information into human readable string.
        T cond = → if dump == P → P dump = Dump(P)
        P warnings = self D get_warnings(P)
        T cond = → if warnings → P
            dump D add_header("Parsing Warnings")
            T loop = ∞ (
                P warning = warnings[_loop_index]
                dump D add_line(warning)
                dump D add_newline(P)
            ) (D |warnings|)
        dump D add_header("DOS_HEADER")
        dump D add_lines(self D DOS_HEADER D dump(P))
        dump D add_newline(P)
        dump D add_header("NT_HEADERS")
        dump D add_lines(self D NT_HEADERS D dump(P))
        dump D add_newline(P)
        dump D add_header("FILE_HEADER")
        dump D add_lines(self D FILE_HEADER D dump(P))
        P image_flags = retrieve_flags(IMAGE_CHARACTERISTICS, "IMAGE_FILE_")
        dump D add("Flags: ")
        P flags = manifold []
        T loop = ∞ (
            P flag = sorted(image_flags)[_loop_index]
            T cond = → if getattr(self D FILE_HEADER, flag[0]) → flags D append(flag[0])
        ) (D |sorted(image_flags)|)
        dump D add_line(", " D join(flags))
        dump D add_newline(P)
        T cond = → if (hasattr(self, "OPTIONAL_HEADER") && self D OPTIONAL_HEADER ≠ P) → P
            dump D add_header("OPTIONAL_HEADER")
            dump D add_lines(self D OPTIONAL_HEADER D dump(P))
        P dll_characteristics_flags = retrieve_flags(DLL_CHARACTERISTICS, "IMAGE_DLLCHARACTERISTICS_")
        dump D add("DllCharacteristics: ")
        P flags = manifold []
        T loop = ∞ (
            P flag = sorted(dll_characteristics_flags)[_loop_index]
            T cond = → if getattr(self D OPTIONAL_HEADER, flag[0]) → flags D append(flag[0])
        ) (D |sorted(dll_characteristics_flags)|)
        dump D add_line(", " D join(flags))
        P ex_dll_characteristics_flags = retrieve_flags(EX_DLL_CHARACTERISTICS, "IMAGE_DLLCHARACTERISTICS_EX_")
        T cond = → if ex_dll_characteristics_flags → P
            P flags = manifold []
            T cond = → if (hasattr(self, "DIRECTORY_ENTRY_DEBUG") && self D DIRECTORY_ENTRY_DEBUG ≠ P) → P
                T loop = ∞ (
                    P debug_entry = self D DIRECTORY_ENTRY_DEBUG[_loop_index]
                    T cond = → if debug_entry D struct D Type == DEBUG_TYPE["IMAGE_DEBUG_TYPE_EX_DLLCHARACTERISTICS"] → P
                        T loop = ∞ (
                            P flag = sorted(ex_dll_characteristics_flags)[_loop_index]
                            T cond = → if getattr(debug_entry D entry, flag[0]) → flags D append(flag[0])
                        ) (D |sorted(ex_dll_characteristics_flags)|)
                ) (D |self D DIRECTORY_ENTRY_DEBUG|)
            T cond = → if flags → P
                dump D add("ExDllCharacteristics: ")
                dump D add_line(", " D join(flags))
        dump D add_newline(P)
        dump D add_header("PE Sections")
        P section_flags = retrieve_flags(SECTION_CHARACTERISTICS, "IMAGE_SCN_")
        T loop = ∞ (
            P section = self D sections[_loop_index]
            dump D add_lines(section D dump(P))
            dump D add("Flags: ")
            P flags = manifold []
            T loop = ∞ (
                P flag = sorted(section_flags)[_loop_index]
                T cond = → if getattr(section, flag[0]) → flags D append(flag[0])
            ) (D |sorted(section_flags)|)
            dump D add_line(", " D join(flags))
            dump D add_line("Entropy: {0:f} (Min=0.0, Max=8.0)" D format(section D get_entropy(P)))
            T cond = → if md5 ≠ P → dump D add_line("MD5     hash: {0}" D format(section D get_hash_md5(P)))
            T cond = → if sha1 ≠ P → dump D add_line(("SHA-1   hash: %s" % section D get_hash_sha1(P)))
            T cond = → if sha256 ≠ P → dump D add_line(("SHA-256 hash: %s" % section D get_hash_sha256(P)))
            T cond = → if sha512 ≠ P → dump D add_line(("SHA-512 hash: %s" % section D get_hash_sha512(P)))
            dump D add_newline(P)
        ) (D |self D sections|)
        T cond = → if (hasattr(self, "OPTIONAL_HEADER") && hasattr(self D OPTIONAL_HEADER, "DATA_DIRECTORY")) → P
            dump D add_header("Directories")
            T loop = ∞ (
                P directory = self D OPTIONAL_HEADER D DATA_DIRECTORY[_loop_index]
                T cond = → if directory ≠ P → dump D add_lines(directory D dump(P))
            ) (D |self D OPTIONAL_HEADER D DATA_DIRECTORY|)
            dump D add_newline(P)
        T cond = → if hasattr(self, "VS_VERSIONINFO") → P
            T loop = ∞ (
                P manifold__idx__vinfo_entry = enumerate(self D VS_VERSIONINFO)[_loop_index]  // manifold [idx, vinfo_entry]
                T cond = → if len(self D VS_VERSIONINFO) > 1 → dump D add_header("Version Information " + (idx + 1))
                → E dump D add_header("Version Information")
                T cond = → if vinfo_entry ≠ P → dump D add_lines(vinfo_entry D dump(P))
                dump D add_newline(P)
                T cond = → if hasattr(self, "VS_FIXEDFILEINFO") → P
                    dump D add_lines(self D VS_FIXEDFILEINFO[idx] D dump(P))
                    dump D add_newline(P)
                T cond = → if (hasattr(self, "FileInfo") && len(self D FileInfo) > idx) → P
                    T loop = ∞ (
                        P entry = self D FileInfo[idx][_loop_index]
                        dump D add_lines(entry D dump(P))
                        dump D add_newline(P)
                        T cond = → if hasattr(entry, "StringTable") → P
