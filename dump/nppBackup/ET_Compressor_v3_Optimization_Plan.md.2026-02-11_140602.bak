                future = pool.submit(_smart_compress, block)
                futures.append((future, len(block)))
            
            for idx, (future, block_len) in enumerate(futures):
                strategy, compressed = future.result()
                # Write to archive...
    else:
        # Fallback to sequential (same as v2.1)
        ...
```

