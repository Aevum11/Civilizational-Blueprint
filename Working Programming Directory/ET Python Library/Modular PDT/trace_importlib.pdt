    T cond = → if name D startswith(".") → P
        T cond = → if (!package) → → E TypeError("the 'package' argument is required to perform a relative import for " + name)
        T loop = ∞ (
            P character = name[_loop_index]
            T cond = → if character ≠ "." → P  // pass
            P level = level + 1
        ) (D |name|)
    → _bootstrap D _gcd_import(name[level:Ω], package, level)
}
