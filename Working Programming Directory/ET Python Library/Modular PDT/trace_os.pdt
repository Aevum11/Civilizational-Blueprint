            T cond = → if (isroot && (!st D S_ISDIR(orig_st D st_mode))) → → P
            T cond = → if (!path D samestat(orig_st, stat(topfd))) → → P
        P scandir_it = scandir(topfd)
        P dirs = manifold []
        P nondirs = manifold []
        P entries = if (topdown || follow_symlinks) → P → E manifold []
        T loop = ∞ (
            P entry = scandir_it[_loop_index]
            P name = entry D name
            T cond = → if isbytes → P name = fsencode(name)
            T attempt = → P  // try
