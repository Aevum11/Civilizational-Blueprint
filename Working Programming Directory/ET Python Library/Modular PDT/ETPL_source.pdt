    P INDETERMINATE = auto(P)
    P MANIFOLD = auto(P)
    P IF = auto(P)
    P SOVEREIGN_PRINT = auto(P)
    P SOVEREIGN_IMPORT = auto(P)
    P SOVEREIGN_SLEEP = auto(P)
    P MAP = auto(P)
    P FILTER = auto(P)
    P HARDWARE_ACCESS = auto(P)
    P NEWLINE = auto(P)
    P EOF = auto(P)
D Token = λ . P  // class
    P type = P
    P value = P
    P line = 0
    P col = 0
D ETPLTokenizer = λ . P  // class
    // ETPL Tokenizer: Variance-based boundary detection (Eq 123).     Handles Unicode math symbols, multi-char operators, comm
    P MULTI_OPS = manifold [manifold ["&&", TokenType D LOGICAL_AND], manifold ["||", TokenType D LOGICAL_OR], manifold ["<<", TokenType D LSHIFT], manifold [">>", TokenType D RSHIFT], manifold ["<=", TokenType D LE], manifold [">=", TokenType D GE], manifold ["==", TokenType D EQ], manifold ["!=", TokenType D NE], manifold ["~=", TokenType D APPROX], manifold ["**", TokenType D DOUBLE_STAR], manifold ["∘∘", TokenType D DOUBLE_COMPOSE], manifold ["->", TokenType D ARROW], manifold ["::", TokenType D COMPOSE], manifold ["[0/0]", TokenType D INDETERMINATE]]
    P SINGLE_SYMBOLS = manifold [manifold ["∘", TokenType D COMPOSE], manifold ["λ", TokenType D LAMBDA], manifold ["→", TokenType D ARROW], manifold [".", TokenType D DOT], manifold ["=", TokenType D EQUALS], manifold ["|", TokenType D PIPE], manifold ["(", TokenType D LPAREN], manifold [")", TokenType D RPAREN], manifold ["[", TokenType D LBRACKET], manifold ["]", TokenType D RBRACKET], manifold ["{", TokenType D LBRACE], manifold ["}", TokenType D RBRACE], manifold [",", TokenType D COMMA], manifold [":", TokenType D COLON], manifold ["+", TokenType D PLUS], manifold ["-", TokenType D MINUS], manifold ["*", TokenType D STAR], manifold ["/", TokenType D SLASH], manifold ["^", TokenType D CARET], manifold ["<", TokenType D LT], manifold [">", TokenType D GT], manifold ["%", TokenType D MODULO], manifold ["!", TokenType D LOGICAL_NOT], manifold ["&", TokenType D BITWISE_AND], manifold ["÷", TokenType D FLOOR_DIV], manifold ["∞", TokenType D INFINITY], manifold ["Ω", TokenType D OMEGA], manifold ["ℵ", TokenType D ALEPH], manifold ["ψ", TokenType D PSI], manifold ["∇", TokenType D NABLA], manifold ["∑", TokenType D SIGMA], manifold ["∏", TokenType D PI_PROD], manifold ["∫", TokenType D INTEGRAL], manifold ["√", TokenType D SQRT], manifold ["≤", TokenType D LE], manifold ["≥", TokenType D GE], manifold ["≈", TokenType D APPROX], manifold ["≠", TokenType D NE]]
    P KEYWORDS = manifold [manifold ["P", TokenType D P], manifold ["D", TokenType D D], manifold ["T", TokenType D T], manifold ["E", TokenType D E], manifold ["lambda", TokenType D LAMBDA], manifold ["inf", TokenType D INFINITY], manifold ["Infinity", TokenType D INFINITY], manifold ["Omega", TokenType D OMEGA], manifold ["aleph", TokenType D ALEPH], manifold ["compose", TokenType D COMPOSE], manifold ["psi", TokenType D PSI], manifold ["nabla", TokenType D NABLA], manifold ["grad", TokenType D NABLA], manifold ["sum", TokenType D SIGMA], manifold ["prod", TokenType D PI_PROD], manifold ["sin", TokenType D SIN], manifold ["cos", TokenType D COS], manifold ["tan", TokenType D TAN], manifold ["log", TokenType D LOG], manifold ["lim", TokenType D LIM], manifold ["abs", TokenType D ABS], manifold ["sqrt", TokenType D SQRT], manifold ["manifold", TokenType D MANIFOLD], manifold ["if", TokenType D IF], manifold ["sovereign_print", TokenType D SOVEREIGN_PRINT], manifold ["sovereign_import", TokenType D SOVEREIGN_IMPORT], manifold ["sovereign_sleep", TokenType D SOVEREIGN_SLEEP], manifold ["map", TokenType D MAP], manifold ["filter", TokenType D FILTER], manifold ["hardware_access", TokenType D HARDWARE_ACCESS], manifold ["and", TokenType D LOGICAL_AND], manifold ["or", TokenType D LOGICAL_OR], manifold ["not", TokenType D LOGICAL_NOT]]
    D ETPLTokenizer____init = λ self . {
        D self_D_code = ""  // self D code := ""
        D self_D_pos = 0  // self D pos := 0
        D self_D_line = 1  // self D line := 1
        D self_D_col = 1  // self D col := 1
        D self_D_tokens = manifold []  // self D tokens := manifold []
    }
    D ETPLTokenizer__tokenize = λ self, code . {
        // Tokenize ETPL source code into token stream.
        D self_D_code = code  // self D code := code
        D self_D_pos = 0  // self D pos := 0
        D self_D_line = 1  // self D line := 1
        D self_D_col = 1  // self D col := 1
        D self_D_tokens = manifold []  // self D tokens := manifold []
        T while_loop = ∞ (
            T check = → if self D pos < len(self D code) → P  // while body follows
                T cond = → if self D code[self D pos] == "\n" → P
                    D self_D_line = self_D_line + 1  // self D line += 1
                    D self_D_col = 1  // self D col := 1
                    D self_D_pos = self_D_pos + 1  // self D pos += 1
                    // continue
                T cond = → if self D code[self D pos] == " \t\r" → P
                    D self_D_pos = self_D_pos + 1  // self D pos += 1
                    D self_D_col = self_D_col + 1  // self D col += 1
                    // continue
                T cond = → if ((self D pos + 1) < len(self D code) && self D code[self D pos:(self D pos + 2)] == "//") → self D _skip_line_comment(P)
                T cond = → if ((self D pos + 1) < len(self D code) && self D code[self D pos:(self D pos + 2)] == "/*") → self D _skip_block_comment(P)
                T cond = → if self D code[self D pos:(self D pos + 5)] == "[0/0]" → P
                    self D tokens D append(Token(TokenType D INDETERMINATE, "[0/0]", self D line, self D col))
                    D self_D_pos = self_D_pos + 5  // self D pos += 5
                    D self_D_col = self_D_col + 5  // self D col += 5
                    // continue
                P matched = 0
                T loop = ∞ (
                    P manifold__op_str__op_type = self D MULTI_OPS[_loop_index]  // manifold [op_str, op_type]
                    T cond = → if op_type == P → P  // pass
                    T cond = → if self D code D startswith(op_str, self D pos) → P
                        self D tokens D append(Token(op_type, op_str, self D line, self D col))
                        D self_D_pos = self_D_pos + len(op_str)  // self D pos += len(op_str)
                        D self_D_col = self_D_col + len(op_str)  // self D col += len(op_str)
                        P matched = 1
                        // break
                ) (D |self D MULTI_OPS|)
                T cond = → if matched → P  // pass
                P ch = self D code[self D pos]
                T cond = → if (ch == manifold ["b", "B"] && (self D pos + 1) < len(self D code) && self D code[(self D pos + 1)] == manifold ["'", "\""]) → P
                    P quote = self D code[(self D pos + 1)]
                    D self_D_pos = self_D_pos + 1  // self D pos += 1
                    D self_D_col = self_D_col + 1  // self D col += 1
                    self D _read_string(quote, manifold ["bytes_prefix", 1])
                    // continue
                T cond = → if (ch == "\"" || ch == "'") → self D _read_string(ch)
                T cond = → if ch D isdigit(P) → self D _read_number(P)
                T cond = → if ch == self D SINGLE_SYMBOLS → P
                    self D tokens D append(Token(self D SINGLE_SYMBOLS[ch], ch, self D line, self D col))
                    D self_D_pos = self_D_pos + 1  // self D pos += 1
                    D self_D_col = self_D_col + 1  // self D col += 1
                    // continue
                T cond = → if (ch D isalpha(P) || ch == "_") → self D _read_identifier(P)
                D self_D_pos = self_D_pos + 1  // self D pos += 1
                D self_D_col = self_D_col + 1  // self D col += 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        self D tokens D append(Token(TokenType D EOF, "", self D line, self D col))
        → self D tokens
    }
    D ETPLTokenizer___skip_line_comment = λ self . {
        // Skip // comment to end of line.
        D self_D_pos = self_D_pos + 2  // self D pos += 2
        T while_loop = ∞ (
            T check = → if (self D pos < len(self D code) && self D code[self D pos] ≠ "\n") → P  // while body follows
                D self_D_pos = self_D_pos + 1  // self D pos += 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    }
    D ETPLTokenizer___skip_block_comment = λ self . {
        // Skip /* ... */ block comment.
        D self_D_pos = self_D_pos + 2  // self D pos += 2
        T while_loop = ∞ (
            T check = → if (self D pos + 1) < len(self D code) → P  // while body follows
                T cond = → if self D code[self D pos:(self D pos + 2)] == "*/" → P
                    D self_D_pos = self_D_pos + 2  // self D pos += 2
                    → P
                T cond = → if self D code[self D pos] == "\n" → P
                    D self_D_line = self_D_line + 1  // self D line += 1
                    D self_D_col = 1  // self D col := 1
                D self_D_pos = self_D_pos + 1  // self D pos += 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        D self_D_pos = len(self D code)  // self D pos := len(self D code)
    }
    D ETPLTokenizer___read_string = λ self, quote, bytes_prefix . {
        // Read a string literal (or bytes literal if bytes_prefix=True).         FIX v1.1.0: Added bounds check after escape-char 
        P start = self D pos
        D self_D_pos = self_D_pos + 1  // self D pos += 1
        P last_nl_pos = (-1)
        T while_loop = ∞ (
            T check = → if (self D pos < len(self D code) && self D code[self D pos] ≠ quote) → P  // while body follows
                T cond = → if self D code[self D pos] == "\\" → P
                    D self_D_pos = self_D_pos + 1  // self D pos += 1
                    T cond = → if self D pos ≥ len(self D code) → P  // pass
                T cond = → if self D code[self D pos] == "\n" → P
                    D self_D_line = self_D_line + 1  // self D line += 1
                    P last_nl_pos = self D pos
                D self_D_pos = self_D_pos + 1  // self D pos += 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if self D pos < len(self D code) → D self_D_pos = self_D_pos + 1  // self D pos += 1
        P raw = self D code[start:self D pos]
        P inner = if len(raw) ≥ 2 → raw[1:(-1)] → E raw
        P inner = inner D replace("\\n", "\n") D replace("\\t", "\t") D replace("\\\\", "\\")
        P inner = inner D replace("\\" + quote, quote)
        T cond = → if bytes_prefix → self D tokens D append(Token(TokenType D STRING, "␀BYTES␀" + inner, self D line, self D col))
        → E self D tokens D append(Token(TokenType D STRING, inner, self D line, self D col))
        T cond = → if last_nl_pos ≥ 0 → D self_D_col = (self D pos - last_nl_pos)  // self D col := (self D pos - last_nl_pos)
        → E D self_D_col = self_D_col + (len(raw) + if bytes_prefix → 1 → E 0)  // self D col += (len(raw) + if bytes_prefix → 1 → E 0)
    }
    D ETPLTokenizer___read_number = λ self . {
        // Read integer or float literal.
        P start = self D pos
        P has_dot = 0
        P has_e = 0
        T while_loop = ∞ (
            T check = → if self D pos < len(self D code) → P  // while body follows
                P ch = self D code[self D pos]
                T cond = → if ch D isdigit(P) → D self_D_pos = self_D_pos + 1  // self D pos += 1
                → E P
                    T cond = → if (ch == "." && (!has_dot) && (!has_e)) → P
                        T cond = → if ((self D pos + 1) < len(self D code) && self D code[(self D pos + 1)] D isdigit(P)) → P
                            P has_dot = 1
                            D self_D_pos = self_D_pos + 1  // self D pos += 1
                        → E P  // else pass
                    → E P
                        T cond = → if (ch == manifold ["e", "E"] && (!has_e)) → P
                            P has_e = 1
                            D self_D_pos = self_D_pos + 1  // self D pos += 1
                            T cond = → if (self D pos < len(self D code) && self D code[self D pos] == manifold ["+", "-"]) → D self_D_pos = self_D_pos + 1  // self D pos += 1
                        → E P
                            T cond = → if ch == "_" → D self_D_pos = self_D_pos + 1  // self D pos += 1
                            → E P  // else pass
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        P num_str = self D code[start:self D pos] D replace("_", "")
        T cond = → if (has_dot || has_e) → self D tokens D append(Token(TokenType D FLOAT, num_str, self D line, self D col))
        → E self D tokens D append(Token(TokenType D INTEGER, num_str, self D line, self D col))
        D self_D_col = self_D_col + (self D pos - start)  // self D col += (self D pos - start)
    }
    D ETPLTokenizer___read_identifier = λ self . {
        // Read identifier or keyword.
        P start = self D pos
        T while_loop = ∞ (
            T check = → if (self D pos < len(self D code) && (self D code[self D pos] D isalnum(P) || self D code[self D pos] == "_")) → P  // while body follows
                D self_D_pos = self_D_pos + 1  // self D pos += 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        P word = self D code[start:self D pos]
        T cond = → if (word == "sovereign" && self D pos < len(self D code) && self D code[self D pos] == "_") → P
            P rest_start = self D pos
            D self_D_pos = self_D_pos + 1  // self D pos += 1
            T while_loop = ∞ (
                T check = → if (self D pos < len(self D code) && (self D code[self D pos] D isalnum(P) || self D code[self D pos] == "_")) → P  // while body follows
                    D self_D_pos = self_D_pos + 1  // self D pos += 1
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            P compound = self D code[start:self D pos]
            T cond = → if compound == self D KEYWORDS → P
                self D tokens D append(Token(self D KEYWORDS[compound], compound, self D line, self D col))
                D self_D_col = self_D_col + (self D pos - start)  // self D col += (self D pos - start)
                → P
            → E D self_D_pos = rest_start  // self D pos := rest_start
        T cond = → if word == self D KEYWORDS → self D tokens D append(Token(self D KEYWORDS[word], word, self D line, self D col))
        → E self D tokens D append(Token(TokenType D IDENTIFIER, word, self D line, self D col))
        D self_D_col = self_D_col + (self D pos - start)  // self D col += (self D pos - start)
    }
D ETPLParser = λ . P  // class
    // ETPL Parser: Converts token stream → AST.     - P: Code string as infinite substrate (Eq 161).     - D: Tokens as finite
    D ETPLParser____init = λ self . {
        D self_D_tokens = manifold []  // self D tokens := manifold []
        D self_D_pos = 0  // self D pos := 0
        D self_D__path_depth = 0  // self D _path_depth := 0
        D self_D__abs_depth = 0  // self D _abs_depth := 0
    }
    D ETPLParser__parse = λ self, code . {
        // Parse ETPL source code into AST.
        P tokenizer = ETPLTokenizer(P)
        D self_D_tokens = tokenizer D tokenize(code)  // self D tokens := tokenizer D tokenize(code)
        D self_D_pos = 0  // self D pos := 0
        → self D _parse_program(P)
    }
    D ETPLParser__parse_file = λ self, filepath . {
        // Parse .pdt file into AST.
        T cond = → if (!filepath D endswith(".pdt")) → → E ValueError(ETMathV2Descriptor D descriptor_binding_error("Invalid file extension '" + filepath + "'; must be .pdt"))
        T scope_f = → open(filepath, "r", manifold ["encoding", "utf-8"])
        P f = scope_f  // context var
            P code = f D read(P)
        → self D parse(code)
    }
    D ETPLParser___peek = λ self . {
        T cond = → if self D pos < len(self D tokens) → → self D tokens[self D pos]
        → Token(TokenType D EOF, "", 0, 0)
    }
    D ETPLParser___advance = λ self . {
        P tok = self D _peek(P)
        T cond = → if tok D type ≠ TokenType D EOF → D self_D_pos = self_D_pos + 1  // self D pos += 1
        → tok
    }
    D ETPLParser___expect = λ self, ttype . {
        P tok = self D _peek(P)
        T cond = → if tok D type ≠ ttype → → E SyntaxError("ETPL Parse Error at line " + tok D line + ":" + tok D col + ": Expected " + ttype D name + ", got " + tok D type D name + " ('" + tok D value + "')")
        → self D _advance(P)
    }
    P _CONTEXTUAL_NAME_TOKENS = manifold [TokenType D SQRT, TokenType D SIN, TokenType D COS, TokenType D TAN, TokenType D LOG, TokenType D LIM, TokenType D ABS, TokenType D MAP, TokenType D FILTER, TokenType D IF, TokenType D INFINITY, TokenType D OMEGA, TokenType D ALEPH, TokenType D PSI, TokenType D NABLA, TokenType D SIGMA, TokenType D PI_PROD, TokenType D COMPOSE, TokenType D LOGICAL_AND, TokenType D LOGICAL_OR, TokenType D LOGICAL_NOT, TokenType D INTEGRAL]
    D ETPLParser___expect_name = λ self . {
        // Accept IDENTIFIER or any contextual-keyword token as a declaration name.
        P tok = self D _peek(P)
        T cond = → if (tok D type == TokenType D IDENTIFIER || tok D type == self D _CONTEXTUAL_NAME_TOKENS) → P
            P t = self D _advance(P)
            T cond = → if t D type ≠ TokenType D IDENTIFIER → → Token(TokenType D IDENTIFIER, t D value, t D line, t D col)
            → t
        → E SyntaxError("ETPL Parse Error at line " + tok D line + ":" + tok D col + ": Expected identifier (name), got " + tok D type D name + " ('" + tok D value + "')")
    }
    D ETPLParser___match = λ self . {
        P tok = self D _peek(P)
        T cond = → if tok D type == ttypes → → self D _advance(P)
        → P
    }
    D ETPLParser___at = λ self . → self D _peek(P) D type == ttypes
    D ETPLParser___parse_program = λ self . {
        // <program> ::= <statement>*
        P program = ASTNode(ASTNodeType D PROGRAM, manifold ["name", "program_root"])
        T while_loop = ∞ (
            T check = → if (!self D _at(TokenType D EOF)) → P  // while body follows
                P stmt = self D _parse_statement(P)
                T cond = → if stmt ≠ P → program D children D append(stmt)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → program
    }
    D ETPLParser___parse_statement = λ self . {
        // <statement> ::= <point_decl> | <descriptor_decl> | <traverser_decl>                        | <loop> | <indeterminate> | 
        P tok = self D _peek(P)
        T cond = → if tok D type == TokenType D P → P
            T cond = → if (self D pos + 1) < len(self D tokens) → P
                P nxt = self D tokens[(self D pos + 1)]
                T cond = → if (nxt D type == TokenType D IDENTIFIER || nxt D type == self D _CONTEXTUAL_NAME_TOKENS) → → self D _parse_point_decl(P)
            → self D _parse_expression(P)
        → E P
            T cond = → if tok D type == TokenType D D → P
                T cond = → if (self D pos + 1) < len(self D tokens) → P
                    P nxt = self D tokens[(self D pos + 1)]
                    T cond = → if (nxt D type == TokenType D IDENTIFIER || nxt D type == self D _CONTEXTUAL_NAME_TOKENS) → → self D _parse_descriptor_decl(P)
                → self D _parse_expression(P)
            → E P
                T cond = → if tok D type == TokenType D T → P
                    T cond = → if (self D pos + 1) < len(self D tokens) → P
                        P nxt = self D tokens[(self D pos + 1)]
                        T cond = → if (nxt D type == TokenType D IDENTIFIER || nxt D type == self D _CONTEXTUAL_NAME_TOKENS) → → self D _parse_traverser_decl(P)
                    → self D _parse_expression(P)
                → E P
                    T cond = → if tok D type == TokenType D SOVEREIGN_PRINT → → self D _parse_sovereign_print(P)
                    → E P
                        T cond = → if tok D type == TokenType D INFINITY → → self D _parse_loop(P)
                        → E P
                            T cond = → if tok D type == TokenType D INDETERMINATE → → self D _parse_indeterminate(P)
                            → E P
                                T cond = → if tok D type == TokenType D ARROW → → self D _parse_path(P)
                                → E P
                                    T cond = → if tok D type == TokenType D IF → → self D _parse_if_path(P)
                                    → E P
                                        T cond = → if tok D type == TokenType D SOVEREIGN_IMPORT → P
                                            self D _advance(P)
                                            T cond = → if self D _match(TokenType D COMPOSE) → P  // pass
                                            P module = self D _parse_expression(P)
                                            → ASTNode(ASTNodeType D SOVEREIGN_CALL, manifold ["name", "sovereign_import"], manifold ["body", module])
                                        → E P
                                            T cond = → if tok D type == TokenType D SOVEREIGN_SLEEP → P
                                                self D _advance(P)
                                                T cond = → if self D _match(TokenType D COMPOSE) → P  // pass
                                                P duration = self D _parse_expression(P)
                                                → ASTNode(ASTNodeType D SOVEREIGN_CALL, manifold ["name", "sovereign_sleep"], manifold ["body", duration])
                                            → E P
                                                T cond = → if tok D type == TokenType D EOF → → P
                                                → E → self D _parse_expression(P)
    }
    D ETPLParser___parse_point_decl = λ self . {
        // P <id> = <expr>
        self D _expect(TokenType D P)
        P name_tok = self D _expect_name(P)
        self D _expect(TokenType D EQUALS)
        P value = self D _parse_expression(P)
        → ASTNode(ASTNodeType D POINT_DECL, manifold ["name", name_tok D value], manifold ["body", value], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
    }
    D ETPLParser___parse_descriptor_decl = λ self . {
        // D <id> = λ <params> . <expr>  OR  D <id> = <expr>
        self D _expect(TokenType D D)
        P name_tok = self D _expect_name(P)
        self D _expect(TokenType D EQUALS)
        T cond = → if self D _at(TokenType D LAMBDA) → P
            self D _advance(P)
            P params = manifold []
            P _PARAM_TYPES = (manifold [TokenType D IDENTIFIER, TokenType D P, TokenType D D, TokenType D T, TokenType D E, TokenType D MANIFOLD, TokenType D SOVEREIGN_PRINT, TokenType D SOVEREIGN_IMPORT, TokenType D SOVEREIGN_SLEEP, TokenType D HARDWARE_ACCESS] | self D _CONTEXTUAL_NAME_TOKENS)
            T while_loop = ∞ (
                T check = → if self D _peek(P) D type == _PARAM_TYPES → P  // while body follows
                    params D append(self D _advance(P) D value)
                    self D _match(TokenType D COMMA)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            self D _expect(TokenType D DOT)
            P body = self D _parse_block_body(P)
            → ASTNode(ASTNodeType D DESCRIPTOR_DECL, manifold ["name", name_tok D value], manifold ["params", params], manifold ["body", body], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
        → E P
            P value = self D _parse_expression(P)
            → ASTNode(ASTNodeType D DESCRIPTOR_DECL, manifold ["name", name_tok D value], manifold ["body", value], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
    }
    D ETPLParser___parse_traverser_decl = λ self . {
        // T <id> = <path> | <loop> | <indeterminate> | <expr>
        self D _expect(TokenType D T)
        P name_tok = self D _expect_name(P)
        self D _expect(TokenType D EQUALS)
        P tok = self D _peek(P)
        T cond = → if tok D type == TokenType D ARROW → P
            P path = self D _parse_path(P)
            → ASTNode(ASTNodeType D TRAVERSER_DECL, manifold ["name", name_tok D value], manifold ["body", path], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
        T cond = → if tok D type == TokenType D INFINITY → P
            P loop = self D _parse_loop(P)
            → ASTNode(ASTNodeType D TRAVERSER_DECL, manifold ["name", name_tok D value], manifold ["body", loop], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
        T cond = → if tok D type == TokenType D INDETERMINATE → P
            P indet = self D _parse_indeterminate(P)
            → ASTNode(ASTNodeType D TRAVERSER_DECL, manifold ["name", name_tok D value], manifold ["body", indet], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
        P expr = self D _parse_expression(P)
        → ASTNode(ASTNodeType D TRAVERSER_DECL, manifold ["name", name_tok D value], manifold ["body", expr], manifold ["line", name_tok D line], manifold ["col", name_tok D col])
    }
    D ETPLParser___parse_path = λ self . {
        // → <expr> [→ E <handler>]  OR  → if <cond> → <then> → E <else>            OR  → E <exception_value>  (direct exception gr
        self D _expect(TokenType D ARROW)
        T cond = → if self D _at(TokenType D IF) → → self D _parse_if_path(P)
        T cond = → if self D _at(TokenType D E) → P
            self D _advance(P)
            P peek = self D _peek(P)
            T cond = → if peek D type ≠ manifold [TokenType D NEWLINE, TokenType D EOF, TokenType D RPAREN, TokenType D RBRACE, TokenType D RBRACKET] → P
                D self_D__path_depth = self_D__path_depth + 1  // self D _path_depth += 1
                T attempt = → P  // try
                    P exc_val = self D _parse_expression(P)
                // finally:
                    D self_D__path_depth = self_D__path_depth - 1  // self D _path_depth -= 1
                → ASTNode(ASTNodeType D EXCEPTION_PATH, manifold ["body", ASTNode(ASTNodeType D IDENTIFIER, manifold ["value", "E"], manifold ["name", "E"])], manifold ["handler", exc_val])
            → ASTNode(ASTNodeType D EXCEPTION_PATH, manifold ["body", ASTNode(ASTNodeType D IDENTIFIER, manifold ["value", "E"], manifold ["name", "E"])], manifold ["handler", ASTNode(ASTNodeType D LITERAL_INT, manifold ["value", P])])
        D self_D__path_depth = self_D__path_depth + 1  // self D _path_depth += 1
        T attempt = → P  // try
            P expr = self D _parse_expression(P)
        // finally:
            D self_D__path_depth = self_D__path_depth - 1  // self D _path_depth -= 1
        T cond = → if self D _at(TokenType D ARROW) → P
            P save = self D pos
            self D _advance(P)
            T cond = → if self D _at(TokenType D E) → P
                self D _advance(P)
                P handler = self D _parse_expression(P)
                → ASTNode(ASTNodeType D EXCEPTION_PATH, manifold ["body", expr], manifold ["handler", handler])
            D self_D_pos = save  // self D pos := save
        → ASTNode(ASTNodeType D PATH, manifold ["body", expr])
    }
    D ETPLParser___parse_if_path = λ self . {
        // if <cond> → <then> [→ E <else>]
        self D _expect(TokenType D IF)
        P condition = self D _parse_expression(P)
        self D _expect(TokenType D ARROW)
        P then_branch = self D _parse_expression(P)
        P else_branch = P
        T cond = → if self D _at(TokenType D ARROW) → P
            P save = self D pos
            self D _advance(P)
            T cond = → if self D _at(TokenType D E) → P
                self D _advance(P)
                P else_branch = self D _parse_expression(P)
            → E D self_D_pos = save  // self D pos := save
        → ASTNode(ASTNodeType D IF_EXPR, manifold ["condition", condition], manifold ["then_branch", then_branch], manifold ["else_branch", else_branch])
    }
    D ETPLParser___parse_loop = λ self . {
        // ∞ (<statements>) (D <n>)
        self D _expect(TokenType D INFINITY)
        self D _expect(TokenType D LPAREN)
        P stmts = manifold []
        T while_loop = ∞ (
            T check = → if ((!self D _at(TokenType D RPAREN)) && (!self D _at(TokenType D EOF))) → P  // while body follows
                P stmt = self D _parse_statement(P)
                T cond = → if stmt ≠ P → stmts D append(stmt)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        self D _expect(TokenType D RPAREN)
        self D _expect(TokenType D LPAREN)
        self D _expect(TokenType D D)
        P bound = self D _parse_expression(P)
        self D _expect(TokenType D RPAREN)
        T cond = → if len(stmts) == 1 → P action = stmts[0]
        → E P action = ASTNode(ASTNodeType D PROGRAM, manifold ["children", stmts])
        → ASTNode(ASTNodeType D LOOP, manifold ["body", action], manifold ["bound", bound])
    }
    D ETPLParser___parse_indeterminate = λ self . {
        // [0/0] <expr> [| <expr>]*
        self D _expect(TokenType D INDETERMINATE)
        P choices = manifold [self D _parse_expression(P)]
        T while_loop = ∞ (
            T check = → if self D _match(TokenType D PIPE) → P  // while body follows
                T cond = → if self D _at(TokenType D E) → P
                    self D _advance(P)
                    choices D append(ASTNode(ASTNodeType D EXCEPTION_PATH, manifold ["body", self D _parse_expression(P)]))
                → E choices D append(self D _parse_expression(P))
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → ASTNode(ASTNodeType D INDETERMINATE, manifold ["children", choices])
    }
    D ETPLParser___parse_sovereign_print = λ self . {
        // sovereign_print ∘ <expr>
        P tok = self D _advance(P)
        T cond = → if self D _match(TokenType D COMPOSE) → P  // pass
        P expr = self D _parse_expression(P)
        → ASTNode(ASTNodeType D SOVEREIGN_CALL, manifold ["name", "sovereign_print"], manifold ["body", expr], manifold ["line", tok D line], manifold ["col", tok D col])
    }
    D ETPLParser___parse_expression = λ self . {
        // Entry point for expression parsing with precedence.
        → self D _parse_logical_or(P)
    }
    D ETPLParser___parse_logical_or = λ self . {
        // <expr> || <expr> — ET M-state union (lowest precedence above compose).         Eq (ET): OR(a,b) = min(1, a+b) derived vi
        P left = self D _parse_logical_and(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D LOGICAL_OR) → P  // while body follows
                self D _advance(P)
                P right = self D _parse_logical_and(P)
                P left = ASTNode(ASTNodeType D LOGICAL_OP, manifold ["op", "||"], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_logical_and = λ self . {
        // <expr> && <expr> — ET M-state intersection.         Eq (ET): AND(a,b) = a*b derived via ETMathV2.logical_and.
        P left = self D _parse_compose(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D LOGICAL_AND) → P  // while body follows
                self D _advance(P)
                P right = self D _parse_compose(P)
                P left = ASTNode(ASTNodeType D LOGICAL_OP, manifold ["op", "&&"], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_compose = λ self . {
        // <expr> ∘ <expr> — Binding/application.
        P left = self D _parse_bitwise_or(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D COMPOSE) → P  // while body follows
                self D _advance(P)
                P right = self D _parse_bitwise_or(P)
                P left = ASTNode(ASTNodeType D CALL, manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_bitwise_or = λ self . {
        // <expr> | <expr> — ET bitwise OR / platform flag union.         ET derivation: Bitwise OR is T-traversal union on D-bit-f
        P left = self D _parse_bitwise_and(P)
        T while_loop = ∞ (
            T check = → if (self D _at(TokenType D PIPE) && self D _abs_depth == 0) → P  // while body follows
                self D _advance(P)
                P right = self D _parse_bitwise_and(P)
                P left = ASTNode(ASTNodeType D BINARY_OP, manifold ["op", "|"], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_bitwise_and = λ self . {
        // <expr> & <expr> — ET bitwise AND / D-mask intersection.         ET derivation: Bitwise AND is D-constraint intersection 
        P left = self D _parse_comparison(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D BITWISE_AND) → P  // while body follows
                self D _advance(P)
                P right = self D _parse_comparison(P)
                P left = ASTNode(ASTNodeType D BINARY_OP, manifold ["op", "&"], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_comparison = λ self . {
        // <expr> (< | > | <= | >= | == | != | ≈) <expr>
        P left = self D _parse_shift(P)
        P comp_ops = manifold [manifold [TokenType D LT, "<"], manifold [TokenType D GT, ">"], manifold [TokenType D LE, "<="], manifold [TokenType D GE, ">="], manifold [TokenType D EQ, "=="], manifold [TokenType D NE, "!="], manifold [TokenType D APPROX, "≈"], manifold [TokenType D EQUALS, "="]]
        T while_loop = ∞ (
            T check = → if self D _peek(P) D type == comp_ops → P  // while body follows
                P op_tok = self D _advance(P)
                P right = self D _parse_shift(P)
                P left = ASTNode(ASTNodeType D COMPARISON, manifold ["op", comp_ops[op_tok D type]], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_shift = λ self . {
        // <expr> (<< | >>) <expr> — ET bit-shift / D-scaling operator.         ET derivation: Left shift = P-field scaling by powe
        P left = self D _parse_additive(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D LSHIFT, TokenType D RSHIFT) → P  // while body follows
                P op_tok = self D _advance(P)
                P op = if op_tok D type == TokenType D LSHIFT → "<<" → E ">>"
                P right = self D _parse_additive(P)
                P left = ASTNode(ASTNodeType D BINARY_OP, manifold ["op", op], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_additive = λ self . {
        // <expr> (+ | -) <expr>
        P left = self D _parse_multiplicative(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D PLUS, TokenType D MINUS) → P  // while body follows
                P op_tok = self D _advance(P)
                P right = self D _parse_multiplicative(P)
                P left = ASTNode(ASTNodeType D MATH_OP, manifold ["op", op_tok D value], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_multiplicative = λ self . {
        // <expr> (* | / | % | ÷) <expr>         FIX v1.1.0: Added MODULO '%'; removed dead DOUBLE_SLASH entry.         ADD v1.4.5:
        P left = self D _parse_power(P)
        T while_loop = ∞ (
            T check = → if self D _at(TokenType D STAR, TokenType D SLASH, TokenType D MODULO, TokenType D FLOOR_DIV) → P  // while body follows
                P op_tok = self D _advance(P)
                P right = self D _parse_power(P)
                P op = if op_tok D type == TokenType D FLOOR_DIV → "//" → E op_tok D value
                P left = ASTNode(ASTNodeType D MATH_OP, manifold ["op", op], manifold ["left", left], manifold ["right", right])
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → left
    }
    D ETPLParser___parse_power = λ self . {
        // <expr> ^ <expr> (right associative)
        P left = self D _parse_unary(P)
        T cond = → if self D _at(TokenType D CARET, TokenType D DOUBLE_STAR) → P
            P op_tok = self D _advance(P)
            P right = self D _parse_power(P)
            P left = ASTNode(ASTNodeType D MATH_OP, manifold ["op", "^"], manifold ["left", left], manifold ["right", right])
        → left
    }
    D ETPLParser___parse_unary = λ self . {
        // Unary: - <expr>, √ <expr>, ∑ <expr>, ∏ <expr>, ∫ <expr>, ∇ <expr>,                   ! <expr> (logical not), | <expr> | 
        P tok = self D _peek(P)
        T cond = → if tok D type == TokenType D MINUS → P
            self D _advance(P)
            P operand = self D _parse_unary(P)
            → ASTNode(ASTNodeType D UNARY_OP, manifold ["op", "-"], manifold ["body", operand])
        T cond = → if tok D type == TokenType D LOGICAL_NOT → P
            self D _advance(P)
            P operand = self D _parse_unary(P)
            → ASTNode(ASTNodeType D LOGICAL_OP, manifold ["op", "!"], manifold ["body", operand])
        P unary_ops = manifold [manifold [TokenType D SQRT, "√"], manifold [TokenType D SIGMA, "∑"], manifold [TokenType D PI_PROD, "∏"], manifold [TokenType D INTEGRAL, "∫"], manifold [TokenType D NABLA, "∇"], manifold [TokenType D SIN, "sin"], manifold [TokenType D COS, "cos"], manifold [TokenType D TAN, "tan"], manifold [TokenType D LOG, "log"], manifold [TokenType D ABS, "abs"]]
        T cond = → if tok D type == unary_ops → P
            self D _advance(P)
            P operand = self D _parse_unary(P)
            → ASTNode(ASTNodeType D UNARY_OP, manifold ["op", unary_ops[tok D type]], manifold ["body", operand])
        T cond = → if tok D type == TokenType D PIPE → P
            self D _advance(P)
            D self_D__abs_depth = self_D__abs_depth + 1  // self D _abs_depth += 1
            T attempt = → P  // try
                P operand = self D _parse_expression(P)
            // finally:
                D self_D__abs_depth = self_D__abs_depth - 1  // self D _abs_depth -= 1
            self D _expect(TokenType D PIPE)
            → ASTNode(ASTNodeType D UNARY_OP, manifold ["op", "|...|"], manifold ["body", operand])
        → self D _parse_postfix(P)
    }
    D ETPLParser___parse_postfix = λ self . {
        // Postfix: <atom>(args), <atom>[<idx>], <atom> D <member>
        P node = self D _parse_atom(P)
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                T cond = → if self D _at(TokenType D LPAREN) → P
                    T cond = → if node D node_type == manifold [ASTNodeType D IDENTIFIER, ASTNodeType D CALL, ASTNodeType D MEMBER_ACCESS, ASTNodeType D LAMBDA, ASTNodeType D INDEX] → P
                        self D _advance(P)
                        P args = manifold []
                        T cond = → if (!self D _at(TokenType D RPAREN)) → P
                            args D append(self D _parse_expression(P))
                            T while_loop = ∞ (
                                T check = → if self D _match(TokenType D COMMA) → P  // while body follows
                                    args D append(self D _parse_expression(P))
                            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                        self D _expect(TokenType D RPAREN)
                        T loop = ∞ (
                            P arg = args[_loop_index]
                            P node = ASTNode(ASTNodeType D CALL, manifold ["left", node], manifold ["right", arg])
                        ) (D |args|)
                        T cond = → if (!args) → P node = ASTNode(ASTNodeType D CALL, manifold ["left", node], manifold ["right", ASTNode(ASTNodeType D LITERAL_INT, manifold ["value", 0])])
                        // continue
                T cond = → if self D _at(TokenType D LBRACKET) → P
                    self D _advance(P)
                    T cond = → if self D _at(TokenType D RBRACKET) → P
                        self D _advance(P)
                        P node = ASTNode(ASTNodeType D INDEX, manifold ["left", node], manifold ["right", ASTNode(ASTNodeType D LITERAL_INT, manifold ["value", 0])])
                    → E P
                        P idx = self D _parse_expression(P)
                        T cond = → if self D _at(TokenType D COLON) → P
                            self D _advance(P)
                            P end = self D _parse_expression(P)
                            self D _expect(TokenType D RBRACKET)
                            P node = ASTNode(ASTNodeType D INDEX, manifold ["left", node], manifold ["right", ASTNode(ASTNodeType D BINDING, manifold ["left", idx], manifold ["right", end])])
                        → E P
                            self D _expect(TokenType D RBRACKET)
                            P node = ASTNode(ASTNodeType D INDEX, manifold ["left", node], manifold ["right", idx])
                → E P
                    T cond = → if self D _at(TokenType D D) → P
                        P save_pos = self D pos
                        self D _advance(P)
                        P peek = self D _peek(P)
                        P _MEMBER_NAME_TYPES = (manifold [TokenType D IDENTIFIER, TokenType D P, TokenType D D, TokenType D T, TokenType D E, TokenType D MANIFOLD, TokenType D LAMBDA, TokenType D SOVEREIGN_PRINT, TokenType D SOVEREIGN_IMPORT, TokenType D SOVEREIGN_SLEEP, TokenType D HARDWARE_ACCESS] | self D _CONTEXTUAL_NAME_TOKENS)
                        T cond = → if peek D type == _MEMBER_NAME_TYPES → P
                            P save_pos2 = self D pos
                            self D _advance(P)
                            T cond = → if self D _at(TokenType D EQUALS) → D self_D_pos = save_pos  // self D pos := save_pos
                            → E P
                                P member_name = self D tokens[save_pos2] D value
                                P node = ASTNode(ASTNodeType D MEMBER_ACCESS, manifold ["left", node], manifold ["name", member_name])
                        → E D self_D_pos = save_pos  // self D pos := save_pos
                    → E P  // else pass
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → node
    }
    D ETPLParser___parse_atom = λ self . {
        // Parse atomic expressions.
        P tok = self D _peek(P)
        T cond = → if tok D type == TokenType D LBRACE → → self D _parse_brace_block(P)
        T cond = → if tok D type == TokenType D LPAREN → P
            self D _advance(P)
            P expr = self D _parse_expression(P)
            self D _expect(TokenType D RPAREN)
            → expr
        T cond = → if tok D type == TokenType D INTEGER → P
            self D _advance(P)
            → ASTNode(ASTNodeType D LITERAL_INT, manifold ["value", int(tok D value)], manifold ["line", tok D line], manifold ["col", tok D col])
        T cond = → if tok D type == TokenType D FLOAT → P
            self D _advance(P)
            → ASTNode(ASTNodeType D LITERAL_FLOAT, manifold ["value", float(tok D value)], manifold ["line", tok D line], manifold ["col", tok D col])
        T cond = → if tok D type == TokenType D STRING → P
            self D _advance(P)
            T cond = → if tok D value D startswith("␀BYTES␀") → P
                P raw = tok D value[7:Ω]
                → ASTNode(ASTNodeType D LITERAL_STRING, manifold ["value", manifold ["__bytes__", raw]], manifold ["line", tok D line], manifold ["col", tok D col])
            → ASTNode(ASTNodeType D LITERAL_STRING, manifold ["value", tok D value], manifold ["line", tok D line], manifold ["col", tok D col])
        T cond = → if tok D type == TokenType D INFINITY → P
            T cond = → if ((self D pos + 1) < len(self D tokens) && self D tokens[(self D pos + 1)] D type == TokenType D LPAREN) → → self D _parse_loop(P)
            self D _advance(P)
            → ASTNode(ASTNodeType D LITERAL_INFINITY, manifold ["value", float("inf")])
        T cond = → if tok D type == TokenType D OMEGA → P
            self D _advance(P)
            → ASTNode(ASTNodeType D LITERAL_OMEGA, manifold ["value", float("inf")])
        T cond = → if tok D type == TokenType D ALEPH → P
            self D _advance(P)
            → ASTNode(ASTNodeType D LITERAL_OMEGA, manifold ["value", float("inf")])
        T cond = → if tok D type == TokenType D MANIFOLD → → self D _parse_manifold(P)
        T cond = → if tok D type == TokenType D PSI → → self D _parse_quantum_wave(P)
        T cond = → if tok D type == TokenType D LAMBDA → → self D _parse_lambda(P)
        T cond = → if tok D type == TokenType D IF → → self D _parse_if_path(P)
        T cond = → if tok D type == TokenType D IDENTIFIER → P
            self D _advance(P)
            → ASTNode(ASTNodeType D IDENTIFIER, manifold ["value", tok D value], manifold ["name", tok D value], manifold ["line", tok D line], manifold ["col", tok D col])
        T cond = → if tok D type == TokenType D SOVEREIGN_PRINT → → self D _parse_sovereign_print(P)
        T cond = → if tok D type == TokenType D SOVEREIGN_IMPORT → P
            self D _advance(P)
            T cond = → if self D _match(TokenType D COMPOSE) → P  // pass
            P module = self D _parse_expression(P)
            → ASTNode(ASTNodeType D SOVEREIGN_CALL, manifold ["name", "sovereign_import"], manifold ["body", module])
        T cond = → if tok D type == TokenType D SOVEREIGN_SLEEP → P
            self D _advance(P)
            T cond = → if self D _match(TokenType D COMPOSE) → P  // pass
            P duration = self D _parse_expression(P)
            → ASTNode(ASTNodeType D SOVEREIGN_CALL, manifold ["name", "sovereign_sleep"], manifold ["body", duration])
        T cond = → if tok D type == manifold [TokenType D MAP, TokenType D FILTER] → P
            self D _advance(P)
            → ASTNode(ASTNodeType D IDENTIFIER, manifold ["value", tok D value], manifold ["name", tok D value])
        T cond = → if tok D type == manifold [TokenType D P, TokenType D D, TokenType D T, TokenType D E] → P
            self D _advance(P)
            → ASTNode(ASTNodeType D IDENTIFIER, manifold ["value", tok D value], manifold ["name", tok D value])
        T cond = → if tok D type == TokenType D INDETERMINATE → → self D _parse_indeterminate(P)
        T cond = → if tok D type == TokenType D ARROW → P
            T cond = → if self D _path_depth == 0 → → self D _parse_path(P)
            P arrow_count = 0
            T while_loop = ∞ (
                T check = → if self D _at(TokenType D ARROW) → P  // while body follows
                    self D _advance(P)
                    P arrow_count = arrow_count + 1
                    T cond = → if self D _at(TokenType D IF) → P  // pass
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            T cond = → if self D _at(TokenType D IF) → P inner = self D _parse_if_path(P)
            → E P inner = self D _parse_expression(P)
            T cond = → if self D _at(TokenType D ARROW) → P
                P save_pos = self D pos
                self D _advance(P)
                T cond = → if self D _at(TokenType D E) → P
                    self D _advance(P)
                    D self_D__path_depth = self_D__path_depth + 1  // self D _path_depth += 1
                    T attempt = → P  // try
                        P handler = self D _parse_expression(P)
                    // finally:
                        D self_D__path_depth = self_D__path_depth - 1  // self D _path_depth -= 1
                    P inner = ASTNode(ASTNodeType D EXCEPTION_PATH, manifold ["body", inner], manifold ["handler", handler])
                → E D self_D_pos = save_pos  // self D pos := save_pos
            P result = inner
            T loop = ∞ (
                P _ = range(arrow_count)[_loop_index]
                P result = ASTNode(ASTNodeType D PATH, manifold ["body", result])
            ) (D |range(arrow_count)|)
            → result
        T cond = → if tok D type == TokenType D LIM → P
            self D _advance(P)
            P operand = self D _parse_expression(P)
            → ASTNode(ASTNodeType D UNARY_OP, manifold ["op", "lim"], manifold ["body", operand])
        T cond = → if tok D type == TokenType D HARDWARE_ACCESS → P
            self D _advance(P)
            T cond = → if self D _match(TokenType D COMPOSE) → P
                P addr = self D _parse_expression(P)
                → ASTNode(ASTNodeType D HARDWARE_ACCESS, manifold ["body", addr])
            → ASTNode(ASTNodeType D HARDWARE_ACCESS, manifold ["body", P])
        → E SyntaxError("ETPL Parse Error at line " + tok D line + ":" + tok D col + ": Unexpected token " + tok D type D name + " ('" + tok D value + "')")
    }
    D ETPLParser___parse_brace_block = λ self . {
        // { <statement>* } — brace-delimited multi-statement block.         FIX v1.1.0: LBRACE/RBRACE now active in grammar for bl
        self D _expect(TokenType D LBRACE)
        P stmts = manifold []
        T while_loop = ∞ (
            T check = → if ((!self D _at(TokenType D RBRACE)) && (!self D _at(TokenType D EOF))) → P  // while body follows
                P stmt = self D _parse_statement(P)
                T cond = → if stmt ≠ P → stmts D append(stmt)
                T while_loop = ∞ (
                    T check = → if self D _at(TokenType D COMMA) → P  // while body follows
                        self D _advance(P)
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        self D _expect(TokenType D RBRACE)
        T cond = → if len(stmts) == 1 → → stmts[0]
        → ASTNode(ASTNodeType D PROGRAM, manifold ["children", stmts])
    }
    D ETPLParser___parse_manifold = λ self . {
        // manifold [expr, expr, ...]
        self D _expect(TokenType D MANIFOLD)
        self D _expect(TokenType D LBRACKET)
        P elements = manifold []
        T cond = → if (!self D _at(TokenType D RBRACKET)) → P
            elements D append(self D _parse_expression(P))
            T while_loop = ∞ (
                T check = → if self D _match(TokenType D COMMA) → P  // while body follows
                    elements D append(self D _parse_expression(P))
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        self D _expect(TokenType D RBRACKET)
        → ASTNode(ASTNodeType D MANIFOLD, manifold ["children", elements])
    }
    D ETPLParser___parse_block_body = λ self . {
        // Parse a D-function body. Supports:           1. Brace block: { stmt; stmt; ... } — explicit multi-statement           2.
        T cond = → if self D _at(TokenType D LBRACE) → → self D _parse_brace_block(P)
        → self D _parse_expression(P)
    }
    D ETPLParser___parse_quantum_wave = λ self . {
        // ψ(expr, expr, ...) OR ψ <params> . <body>
        self D _expect(TokenType D PSI)
        T cond = → if self D _at(TokenType D LPAREN) → P
            self D _advance(P)
            P params = manifold []
            T cond = → if (!self D _at(TokenType D RPAREN)) → P
                params D append(self D _parse_expression(P))
                T while_loop = ∞ (
                    T check = → if self D _match(TokenType D COMMA) → P  // while body follows
                        params D append(self D _parse_expression(P))
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            self D _expect(TokenType D RPAREN)
            → ASTNode(ASTNodeType D QUANTUM_WAVE, manifold ["children", params], manifold ["body", ASTNode(ASTNodeType D LITERAL_INT, manifold ["value", 0])])
        P params = manifold []
        T while_loop = ∞ (
            T check = → if ((!self D _at(TokenType D DOT)) && (!self D _at(TokenType D EOF))) → P  // while body follows
                params D append(self D _parse_atom(P))
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if self D _at(TokenType D DOT) → self D _advance(P)
        P body = self D _parse_expression(P)
        → ASTNode(ASTNodeType D QUANTUM_WAVE, manifold ["children", params], manifold ["body", body])
    }
    D ETPLParser___parse_lambda = λ self . {
        // λ <params> . <body>
        self D _expect(TokenType D LAMBDA)
        P params = manifold []
        P _PARAM_TYPES = (manifold [TokenType D IDENTIFIER, TokenType D P, TokenType D D, TokenType D T, TokenType D E, TokenType D MANIFOLD, TokenType D SOVEREIGN_PRINT, TokenType D SOVEREIGN_IMPORT, TokenType D SOVEREIGN_SLEEP, TokenType D HARDWARE_ACCESS] | self D _CONTEXTUAL_NAME_TOKENS)
        T while_loop = ∞ (
            T check = → if self D _peek(P) D type == _PARAM_TYPES → P  // while body follows
                params D append(self D _advance(P) D value)
                self D _match(TokenType D COMMA)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        self D _expect(TokenType D DOT)
        P body = self D _parse_block_body(P)
        → ASTNode(ASTNodeType D LAMBDA, manifold ["params", params], manifold ["body", body])
    }
