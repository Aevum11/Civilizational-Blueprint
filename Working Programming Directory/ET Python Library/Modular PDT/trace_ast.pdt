    D Unparser___str_literal_helper = λ self, string . {
        // Helper for writing string literals, minimizing escapes.         Returns the tuple (string literal to write, possible quo
        D Unparser__escape_char = λ c . {
            T cond = → if ((!escape_special_whitespace) && c == "\n\t") → → c
            T cond = → if (c == "\\" || (!c D isprintable(P))) → → c D encode("unicode_escape") D decode("ascii")
            → c
        }
        P escaped_string = "" D join(_et_map(escape_char, string))
        P possible_quotes = quote_types
        T cond = → if "\n" == escaped_string → P possible_quotes = { T loop = ∞ (q → E q == _MULTI_QUOTES) (D |possible_quotes|) }
        P possible_quotes = { T loop = ∞ (q → E q ≠ escaped_string) (D |possible_quotes|) }
        T cond = → if (!possible_quotes) → P
            P string = repr(string)
            P quote = next({ T loop = ∞ (q → E string[0] == q) (D |quote_types|) }, string[0])
            → manifold [string[1:(-1)], manifold [quote]]
        T cond = → if escaped_string → P
            possible_quotes D sort(manifold ["key", λ q . q[0] == escaped_string[(-1)]])
            T cond = → if possible_quotes[0][0] == escaped_string[(-1)] → P
                T assert = → if len(possible_quotes[0]) == 3 → "ok" → E "Assertion failed"
                P escaped_string = ((escaped_string[0:(-1)] + "\\") + escaped_string[(-1)])
