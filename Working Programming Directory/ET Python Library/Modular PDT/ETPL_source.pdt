D et_arctan_series = λ x, n . {
    // Leibniz T-series: arctan(x) = Σ(-1)^k x^(2k+1)/(2k+1). |x|≤1.
    P result = 0.0
    P x_pow = x
    P x_sq = (x * x)
    P sign = 1.0
    T loop = ∞ (
        P k = range(n)[_loop_index]
        P result = result + ((sign * x_pow) / ((2.0 * k) + 1.0))
        P x_pow = x_pow * x_sq
        P sign = (-sign)
    ) (D |range(n)|)
    → result
}
D et_arctanh_series = λ x, n . {
    // arctanh T-series: arctanh(x) = Σ x^(2k+1)/(2k+1).
    P result = 0.0
    P x_pow = x
    P x_sq = (x * x)
    T loop = ∞ (
        P k = range(n)[_loop_index]
        P result = result + (x_pow / ((2.0 * k) + 1.0))
        P x_pow = x_pow * x_sq
    ) (D |range(n)|)
    → result
}
