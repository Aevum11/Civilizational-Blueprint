@echo off
setlocal
title Exception Theory Universal Astronomer Dependency Installer

echo ========================================================
echo  Exception Theory Universal Astronomer v7.5 Installer
echo ========================================================
echo.

:: 1. Check for Python Installation
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Python is not detected. Please install Python and add it to your PATH.
    pause
    exit /b 1
)

:: 2. Install Core Dependencies from requirements.txt
if exist requirements.txt (
    echo [INFO] Installing core dependencies from requirements.txt...
    python -m pip install -r requirements.txt
    if %errorlevel% neq 0 goto :error
) else (
    echo [ERROR] requirements.txt not found in current directory!
    pause
    exit /b 1
)

:: 3. Install Optional Dependencies
:: According to the document, fitsio and joblib are optional but recommended.
:: We install them explicitly here since they are commented out in the txt file.
echo.
echo [INFO] Installing optional recommended dependencies...
python -m pip install fitsio>=1.1.0 joblib>=1.0.0
if %errorlevel% neq 0 goto :error

:: 4. Verification Step
echo.
echo [INFO] Verifying all installations...
:: We verify core packages, optional packages, and the system-level tkinter.
python -c "import numpy; import scipy; import matplotlib; import astropy; import netCDF4; import h5py; import fitsio; import joblib; import tkinter; print('\n[SUCCESS] All modules imported successfully.')"

if %errorlevel% neq 0 (
    echo.
    echo [WARNING] Verification failed. Some packages (or Tkinter) may be missing.
    echo Please check the error messages above.
    goto :end
)

echo.
echo ========================================================
echo  Installation Complete. You are ready to proceed.
echo ========================================================
goto :end

:error
echo.
echo [ERROR] An error occurred during installation.
pause
exit /b %errorlevel%

:end
pause