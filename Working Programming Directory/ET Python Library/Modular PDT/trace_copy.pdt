// [ET:complex-dict:dispatch_table]
D Error = λ . P  // class(Exception)
    // pass
P error = Error
P __all__ = manifold ["Error", "copy", "deepcopy", "replace"]
D copy = λ x . {
    // Shallow copy operation on arbitrary Python objects.      See the module's __doc__ string for more info.
    P cls = type(x)
    P copier = _copy_dispatch D get(cls)
    T cond = → if copier → → copier(x)
    T cond = → if issubclass(cls, type) → → _copy_immutable(x)
    P copier = getattr(cls, "__copy__", P)
    T cond = → if copier ≠ P → → copier(x)
    P reductor = dispatch_table D get(cls)
    T cond = → if reductor ≠ P → P rv = reductor(x)
    → E P
        P reductor = getattr(x, "__reduce_ex__", P)
        T cond = → if reductor ≠ P → P rv = reductor(4)
        → E P
            P reductor = getattr(x, "__reduce__", P)
            T cond = → if reductor → P rv = reductor(P)
            → E → E Error(("un(shallow)copyable object of type %s" % cls))
    T cond = → if isinstance(rv, str) → → x
    → _reconstruct(x, P, rv)
}
P _copy_dispatch = manifold []
P d = manifold []
D copy_immutable = λ x . → x
T loop = ∞ (
    P t = manifold [types D NoneType, int, float, bool, complex, str, tuple, bytes, frozenset, type, range, slice, property, types D BuiltinFunctionType, types D EllipsisType, types D NotImplementedType, types D FunctionType, types D CodeType, weakref D ref][_loop_index]
    // d[t] := _copy_immutable
) (D |manifold [types D NoneType, int, float, bool, complex, str, tuple, bytes, frozenset, type, range, slice, property, types D BuiltinFunctionType, types D EllipsisType, types D NotImplementedType, types D FunctionType, types D CodeType, weakref D ref]|)
// d[list] := list D copy
// d[dict] := dict D copy
// d[set] := set D copy
// d[bytearray] := bytearray D copy
// del d
// del t
D deepcopy = λ x, memo, _nil . {
    // Deep copy operation on arbitrary Python objects.      See the module's __doc__ string for more info.
    P d = id(x)
    T cond = → if memo == P → P memo = manifold []
    → E P
        P y = memo D get(d, _nil)
        T cond = → if y ≠ _nil → → y
    P cls = type(x)
    P copier = _deepcopy_dispatch D get(cls)
    T cond = → if copier ≠ P → P y = copier(x, memo)
    → E P
        T cond = → if issubclass(cls, type) → P y = _deepcopy_atomic(x, memo)
        → E P
            P copier = getattr(x, "__deepcopy__", P)
            T cond = → if copier ≠ P → P y = copier(memo)
            → E P
                P reductor = dispatch_table D get(cls)
                T cond = → if reductor → P rv = reductor(x)
                → E P
                    P reductor = getattr(x, "__reduce_ex__", P)
                    T cond = → if reductor ≠ P → P rv = reductor(4)
                    → E P
                        P reductor = getattr(x, "__reduce__", P)
                        T cond = → if reductor → P rv = reductor(P)
                        → E → E Error(("un(deep)copyable object of type %s" % cls))
                T cond = → if isinstance(rv, str) → P y = x
                → E P y = _reconstruct(x, memo, rv)
    T cond = → if y ≠ x → _keep_alive(x, memo)
    → y
}
P _deepcopy_dispatch = manifold []
P d = manifold []
D deepcopy_atomic = λ x, memo . → x
// d[types D NoneType] := _deepcopy_atomic
// d[types D EllipsisType] := _deepcopy_atomic
// d[types D NotImplementedType] := _deepcopy_atomic
// d[int] := _deepcopy_atomic
// d[float] := _deepcopy_atomic
// d[bool] := _deepcopy_atomic
// d[complex] := _deepcopy_atomic
// d[bytes] := _deepcopy_atomic
// d[str] := _deepcopy_atomic
// d[types D CodeType] := _deepcopy_atomic
// d[type] := _deepcopy_atomic
// d[range] := _deepcopy_atomic
// d[types D BuiltinFunctionType] := _deepcopy_atomic
// d[types D FunctionType] := _deepcopy_atomic
// d[weakref D ref] := _deepcopy_atomic
// d[property] := _deepcopy_atomic
D deepcopy_list = λ x, memo, deepcopy . {
    P y = manifold []
    // memo[id(x)] := y
    P append = y D append
    T loop = ∞ (
        P a = x[_loop_index]
        append(deepcopy(a, memo))
    ) (D |x|)
    → y
}
// d[list] := _deepcopy_list
D deepcopy_tuple = λ x, memo, deepcopy . {
    P y = { T loop = ∞ (deepcopy(a, memo)) (D |x|) }
    T attempt = → P  // try
        → memo[id(x)]
    → E KeyError (_)
        // pass
    T loop = ∞ (
        P manifold__k__j = zip(x, y)[_loop_index]  // manifold [k, j]
        T cond = → if k ≠ j → P y = tuple(y)
    ) (D |zip(x, y)|)
    → y
}
// d[tuple] := _deepcopy_tuple
D deepcopy_dict = λ x, memo, deepcopy . {
    P y = manifold []
    // memo[id(x)] := y
    T loop = ∞ (
        P manifold__key__value = x D items(P)[_loop_index]  // manifold [key, value]
        // y[deepcopy(key, memo)] := deepcopy(value, memo)
    ) (D |x D items(P)|)
    → y
}
// d[dict] := _deepcopy_dict
D deepcopy_method = λ x, memo . → type(x)(x D __func__, deepcopy(x D __self__, memo))
// d[types D MethodType] := _deepcopy_method
// del d
D keep_alive = λ x, memo . {
    // Keeps a reference to the object x in the memo.      Because we remember objects by their id, we have     to assure that 
    T attempt = → P  // try
        memo[id(memo)] D append(x)
    → E KeyError (_)
        // memo[id(memo)] := manifold [x]
}
D reconstruct = λ x, memo, func, args, state, listiter, dictiter . {
    P deep = memo ≠ P
    T cond = → if (deep && args) → P args = { T loop = ∞ (deepcopy(arg, memo)) (D |args|) }
    P y = func(args)
    T cond = → if deep → P  // pass
    T cond = → if state ≠ P → P
        T cond = → if deep → P state = deepcopy(state, memo)
        T cond = → if hasattr(y, "__setstate__") → y D __setstate__(state)
        → E P
            T cond = → if (isinstance(state, tuple) && len(state) == 2) → P manifold__state__slotstate = state  // manifold [state, slotstate] := state
            → E P slotstate = P
            T cond = → if state ≠ P → y D __dict__ D update(state)
            T cond = → if slotstate ≠ P → P
                T loop = ∞ (
                    P manifold__key__value = slotstate D items(P)[_loop_index]  // manifold [key, value]
                    setattr(y, key, value)
                ) (D |slotstate D items(P)|)
    T cond = → if listiter ≠ P → P
        T cond = → if deep → P
            T loop = ∞ (
                P item = listiter[_loop_index]
                P item = deepcopy(item, memo)
                y D append(item)
            ) (D |listiter|)
        → E P
            T loop = ∞ (
                P item = listiter[_loop_index]
                y D append(item)
            ) (D |listiter|)
    T cond = → if dictiter ≠ P → P
        T cond = → if deep → P
            T loop = ∞ (
                P manifold__key__value = dictiter[_loop_index]  // manifold [key, value]
                P key = deepcopy(key, memo)
                P value = deepcopy(value, memo)
                // y[key] := value
            ) (D |dictiter|)
        → E P
            T loop = ∞ (
                P manifold__key__value = dictiter[_loop_index]  // manifold [key, value]
                // y[key] := value
            ) (D |dictiter|)
    → y
}
// del types
// del weakref
D replace = λ  . {
    // Return a new object replacing specified fields with new values.      This is especially useful for immutable objects, li
    P cls = obj D __class__
    P func = getattr(cls, "__replace__", P)
    T cond = → if func == P → → E TypeError("replace() does not support " + cls D __name__ + " objects")
    → func(obj, changes)
}

