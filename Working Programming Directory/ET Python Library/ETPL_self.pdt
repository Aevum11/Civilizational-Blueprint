    D Process__wait = λ self, timeout . {
        // Wait for process to terminate and, if process is a children         of os.getpid(), also return its exit code, else None
        T cond = → if (timeout ≠ P && (!timeout ≥ 0)) → P
            P msg = "timeout must be a positive integer"
            → E ValueError(msg)
