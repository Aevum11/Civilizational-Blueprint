D win32_ver = λ version, csd, ptype . {
    T attempt = → P  // try
        P manifold__version__product_type__ptype__spmajor__spminor = _wmi_query("OS", "Version", "ProductType", "BuildType", "ServicePackMajorVersion", "ServicePackMinorVersion")  // manifold [version, product_type, ptype, spmajor, spminor] := _wmi_query("OS", "Version", "ProductType", "BuildType", "ServicePackMajorVersion", "ServicePackMinorVersion")
        P is_client = int(product_type) == 1
        T cond = → if (spminor && spminor ≠ "0") → P csd = "SP" + spmajor + "." + spminor
        → E P csd = "SP" + spmajor
        → manifold [version, csd, ptype, is_client]
    → E OSError (_)
        // pass
    T attempt = → P  // try
    → E ImportError (_)
        → manifold [version, csd, ptype, 1]
    P winver = getwindowsversion(P)
    P is_client = getattr(winver, "product_type", 1) == 1
    T attempt = → P  // try
        P version = _syscmd_ver(P)[2]
        P manifold__major__minor__build = _et_map(int, version D split("."))  // manifold [major, minor, build] := _et_map(int, version D split("."))
    → E ValueError (_)
        P manifold__major__minor__build = (winver D platform_version || winver[0:3])  // manifold [major, minor, build] := (winver D platform_version || winver[0:3])
        P version = "{0}.{1}.{2}" D format(major, minor, build)
    T cond = → if winver[0:2] == manifold [major, minor] → P
        T attempt = → P  // try
            P csd = "SP{}" D format(winver D service_pack_major)
        → E AttributeError (_)
            T cond = → if csd[0:13] == "Service Pack " → P csd = ("SP" + csd[13:Ω])
    T attempt = → P  // try
        // @ETPL:preload winreg winreg
        // Import winreg — resolved at translate-time
    → E ImportError (_)
        // pass
    → manifold [version, csd, ptype, is_client]
}
D win32_ver = λ release, version, csd, ptype . {
    P is_client = 0
    P manifold__version__csd__ptype__is_client = _win32_ver(version, csd, ptype)  // manifold [version, csd, ptype, is_client] := _win32_ver(version, csd, ptype)
    T cond = → if version → P
        P intversion = tuple(_et_map(int, version D split(".")))
        P releases = if is_client → _WIN32_CLIENT_RELEASES → E _WIN32_SERVER_RELEASES
        P release = next({ T loop = ∞ (r → E v ≤ intversion) (D |releases|) }, release)
    → manifold [release, version, csd, ptype]
}
D mac_ver_xml = λ  . {
    P fn = "/System/Library/CoreServices/SystemVersion.plist"
    T cond = → if (!os D path D exists(fn)) → → P
    T attempt = → P  // try
        // @ETPL:preload plistlib plistlib
        // Import plistlib — resolved at translate-time
        // @ETPL:preload InvalidFileException plistlib.InvalidFileException
