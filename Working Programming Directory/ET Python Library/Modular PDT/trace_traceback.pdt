        T cond = → if _seen == P → P _seen = set(P)
        _seen D add(id(exc_value))
        D self_D_max_group_width = max_group_width  // self D max_group_width := max_group_width
        D self_D_max_group_depth = max_group_depth  // self D max_group_depth := max_group_depth
        D self_D_stack = StackSummary D _extract_from_extended_frame_gen(_walk_tb_with_full_positions(exc_traceback), manifold ["limit", limit], manifold ["lookup_lines", lookup_lines], manifold ["capture_locals", capture_locals])  // self D stack := StackSummary D _extract_from_extended_frame_gen(_walk_tb_with_full_positions(exc_traceback), manifold ["limit", limit], manifold ["lookup_lines", lookup_lines], manifold ["capture_locals", capture_locals])
        D self_D__exc_type = if save_exc_type → exc_type → E P  // self D _exc_type := if save_exc_type → exc_type → E P
        D self_D__str = _safe_string(exc_value, "exception")  // self D _str := _safe_string(exc_value, "exception")
