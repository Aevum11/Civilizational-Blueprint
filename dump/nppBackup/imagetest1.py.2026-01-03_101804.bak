import tkinter as tk
from tkinter import filedialog, messagebox
import threading
import sys
import math

try:
    from PIL import Image, ImageTk, ImageDraw, ImageFilter
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: CHROMATIC PROTECTION (LUMINANCE UNBINDING)
# ==============================================================================

class ET_Luma_Engine:
    def lift_layer_luma(self, img_pil, mask_pil, weave_sz, strength, gamma, status_cb):
        """
        Operates strictly in YCbCr space to protect Skin Tones (Chroma).
        weave_sz: Size of the texture to remove (Median Kernel).
        strength: How much texture to subtract.
        gamma: Deep signal amplification (Luminance only).
        """
        width, height = img_pil.size
        
        # 1. CONVERT MANIFOLD TO YCbCr
        # Y = Luminance (Light/Texture) -> We edit this.
        # Cb, Cr = Chrominance (Color/Skin) -> We PROTECT this.
        status_cb("Converting Manifold to YCbCr (Isolating Chroma)...")
        img_ycbcr = img_pil.convert("YCbCr")
        y_channel, cb_channel, cr_channel = img_ycbcr.split()
        
        # 2. GENERATE DENSITY MAP (On Y Channel Only)
        # We use Median Filter on Y to find the "Smooth Shape" underneath the weave.
        k_size = int(weave_sz)
        if k_size % 2 == 0: k_size += 1
        
        y_base = y_channel.filter(ImageFilter.MedianFilter(size=k_size))
        
        # Accessors
        y_pix = y_channel.load()
        base_pix = y_base.load()
        mask = mask_pil.load()
        
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        min_x, min_y, max_x, max_y = bbox
        
        updates = []
        
        # Factors
        rem_factor = strength / 100.0
        
        # 3. LUMINANCE UNBINDING LOOP
        for py in range(min_y, max_y):
            for px in range(min_x, max_x):
                if mask[px, py] == 0: continue
                
                # Raw Luminance (P)
                raw_l = y_pix[px, py]
                # Base Luminance (B) - The smooth skin/shape
                base_l = base_pix[px, py]
                
                # Texture = Raw - Base
                tex = raw_l - base_l
                
                # UNBINDING: Remove texture from Raw
                # New_L = P - (Texture * Strength)
                new_l = raw_l - (tex * rem_factor)
                
                # AMPLIFICATION (Gamma on Luminance)
                # We boost the darks to see through the shadow of the cloth
                if gamma != 1.0:
                    # Normalize 0-1
                    norm = max(0, min(255, new_l)) / 255.0
                    # Gamma Pow (Safe)
                    boosted = math.pow(norm, 1.0/gamma)
                    new_l = boosted * 255.0
                
                updates.append((px, py, int(new_l)))
                
        # Apply updates to Y channel
        for ux, uy, uval in updates:
            y_pix[ux, uy] = uval
            
        # 4. RECOMBINE MANIFOLD
        # Merge modified Y with ORIGINAL Cb/Cr (Color Protected)
        status_cb("Recombining Manifold (Restoring Color)...")
        new_img = Image.merge("YCbCr", (y_channel, cb_channel, cr_channel))
        
        # Convert back to RGB for display
        return new_img.convert("RGB")

# ==============================================================================
# GUI
# ==============================================================================

class ET_V16_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V16: CHROMATIC PROTECTION (SKIN TONE PRESERVER)")
        self.root.geometry("1200x900")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Luma_Engine()
        self.pil_img = None
        self.mask_img = None
        self.backup_img = None
        
        self._layout()

    def _layout(self):
        t = tk.Frame(self.root, bg="#101010", pady=5)
        t.pack(fill=tk.X)
        
        self.btn(t, "LOAD IMAGE", self.load, "#004488")
        self.btn(t, "RESET", self.reset, "#882200")
        self.btn(t, "LUMA UNBIND", self.run, "#228822")
        
        # 1. WEAVE SIZE (Texture Frequency)
        tk.Label(t, text="WEAVE SIZE:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.sz_scale = tk.Scale(t, from_=1, to=9, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.sz_scale.set(3)
        self.sz_scale.pack(side=tk.LEFT)
        
        # 2. TEXTURE REMOVE (Strength)
        tk.Label(t, text="TEXTURE REMOVE:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.rem_scale = tk.Scale(t, from_=0, to=150, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.rem_scale.set(100)
        self.rem_scale.pack(side=tk.LEFT)
        
        # 3. GAMMA (Depth) - Replaces "Signal Gain"
        tk.Label(t, text="DEPTH GAMMA:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.gam_scale = tk.Scale(t, from_=10, to=30, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.gam_scale.set(10) # 1.0 (Neutral)
        self.gam_scale.pack(side=tk.LEFT)

        self.stat = tk.Label(t, text="Ready.", fg="#888", bg="#101010")
        self.stat.pack(side=tk.RIGHT, padx=20)
        
        container = tk.Frame(self.root)
        container.pack(fill=tk.BOTH, expand=True)
        self.cv = tk.Canvas(container, bg="#080808", cursor="crosshair")
        vs = tk.Scrollbar(container, orient="vertical", command=self.cv.yview)
        hs = tk.Scrollbar(container, orient="horizontal", command=self.cv.xview)
        self.cv.config(yscrollcommand=vs.set, xscrollcommand=hs.set)
        
        vs.pack(side=tk.RIGHT, fill=tk.Y)
        hs.pack(side=tk.BOTTOM, fill=tk.X)
        self.cv.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.cv.bind("<Button-1>", self.down)
        self.cv.bind("<B1-Motion>", self.drag)
        self.cv.bind("<ButtonRelease-1>", self.up)
        
        self.drawing=False; self.brush=30

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", relief="flat", padx=10).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            self.pil_img = Image.open(path).convert("RGB")
            self.backup_img = self.pil_img.copy()
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            self.cv.config(scrollregion=(0,0,self.pil_img.width,self.pil_img.height))
            self.update_view()
            self.stat.config(text=f"Loaded: {self.pil_img.size}")
        except: pass

    def update_view(self):
        if not self.pil_img: return
        d = self.pil_img.copy()
        if self.mask_img.getbbox():
            r = Image.new("RGB", self.pil_img.size, (0,255,255)) # Cyan mask
            d = Image.composite(r, d, self.mask_img)
        self.tk = ImageTk.PhotoImage(d)
        self.cv.create_image(0,0, image=self.tk, anchor=tk.NW)

    def down(self,e): 
        x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
        self.drawing=True; self.lp=(x,y)
        
    def drag(self,e):
        if self.drawing and self.mask_img:
            x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
            d = ImageDraw.Draw(self.mask_img)
            d.line([self.lp, (x,y)], fill=128, width=self.brush)
            d.ellipse([x-15,y-15,x+15,y+15], fill=128)
            self.lp=(x,y); 
            self.cv.create_line(self.lp[0],self.lp[1],x,y,fill="cyan",width=self.brush,tags="t")

    def up(self,e): self.drawing=False; self.cv.delete("t"); self.update_view()
    
    def reset(self):
        if self.backup_img:
            self.pil_img = self.backup_img.copy()
            if self.mask_img: self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
            self.update_view()
            self.stat.config(text="Reset.")

    def run(self):
        if not self.pil_img: return
        self.stat.config(text="Unbinding Luminance Layer...")
        sz = self.sz_scale.get()
        rem = self.rem_scale.get()
        gm = self.gam_scale.get() / 10.0
        threading.Thread(target=self._w, args=(sz,rem,gm)).start()

    def _w(self, s, r, g):
        res = self.engine.lift_layer_luma(self.pil_img, self.mask_img, s, r, g, self.log)
        self.pil_img = res
        self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
        self.root.after(0, self.update_view)
        self.root.after(0, lambda: self.stat.config(text="Chromatic Integrity Maintained."))

    def log(self, m): self.stat.config(text=m)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_V16_GUI(root)
    root.mainloop()