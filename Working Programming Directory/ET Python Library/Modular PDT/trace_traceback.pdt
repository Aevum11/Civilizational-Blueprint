D parse_value_tb = λ exc, value, tb . {
    T cond = → if value == _sentinel ≠ tb == _sentinel → → E ValueError("Both or neither of value and tb must be given")
    T cond = → if value == tb == _sentinel → P
        T cond = → if exc ≠ P → P
            T cond = → if isinstance(exc, BaseException) → → manifold [exc, exc D __traceback__]
            → E TypeError("Exception expected for value, " + type(exc) D __name__ + " found")
        → E → manifold [P, P]
    → manifold [value, tb]
}
D print_exception = λ value, tb, limit, file, chain . {
    // Print exception up to 'limit' stack trace entries from 'tb' to 'file'.      This differs from print_tb() in the followin
    P colorize = kwargs D get("colorize", 0)
    P manifold__value__tb = _parse_value_tb(exc, value, tb)  // manifold [value, tb] := _parse_value_tb(exc, value, tb)
    P te = TracebackException(type(value), value, tb, manifold ["limit", limit], manifold ["compact", 1])
    te D print(manifold ["file", file], manifold ["chain", chain], manifold ["colorize", colorize])
}
