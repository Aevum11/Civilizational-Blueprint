            P manifold__name__fn = zip(self D names, fns)[_loop_index]  // manifold [name, fn]
            D fn_D___qualname = cls D __qualname__ + "." + fn D __name__  // fn D __qualname__ := cls D __qualname__ + "." + fn D __name__
