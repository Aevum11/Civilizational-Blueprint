package com.et.physics.toolbox

import android.Manifest
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.content.ServiceConnection
import android.content.pm.PackageManager
import android.graphics.Color
import android.net.Uri
import android.os.Bundle
import android.os.Handler
import android.os.IBinder
import android.os.Looper
import android.widget.Button
import android.widget.ImageView
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.core.app.ActivityCompat
import androidx.core.content.ContextCompat
import androidx.core.content.FileProvider
import java.io.File
import java.io.FileOutputStream

class MainActivity : AppCompatActivity() {

    private var serviceBinder: OmniMeasureService? = null
    private var isBound = false

    // UI Elements
    private lateinit var statusIcon: ImageView
    private lateinit var txtValues: TextView
    private lateinit var txtState: TextView
    private lateinit var txtTTF: TextView
    private lateinit var txtSPL: TextView
    private lateinit var btnStart: Button
    private lateinit var btnStop: Button
    private lateinit var btnExport: Button
    private lateinit var btnReset: Button
    private lateinit var btnAbout: Button

    private val handler = Handler(Looper.getMainLooper())
    private val updateRunnable = object : Runnable {
        override fun run() {
            updateUI()
            handler.postDelayed(this, 250) // 4Hz UI Refresh
        }
    }

    private val connection = object : ServiceConnection {
        override fun onServiceConnected(className: ComponentName, service: IBinder) {
            val binder = service as OmniMeasureService.LocalBinder
            serviceBinder = binder.getService()
            isBound = true
        }

        override fun onServiceDisconnected(arg0: ComponentName) {
            isBound = false
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // Setup UI
        statusIcon = findViewById(R.id.statusIcon)
        txtValues = findViewById(R.id.txtValues)
        txtState = findViewById(R.id.txtState)
        txtTTF = findViewById(R.id.txtTTF)
        txtSPL = findViewById(R.id.txtSPL)
        btnStart = findViewById(R.id.btnStart)
        btnStop = findViewById(R.id.btnStop)
        btnExport = findViewById(R.id.btnExport)
        btnReset = findViewById(R.id.btnReset)
        btnAbout = findViewById(R.id.btnAbout)

        checkPermissions()

        btnStart.setOnClickListener {
            val intent = Intent(this, OmniMeasureService::class.java)
            startService(intent)
            bindService(intent, connection, Context.BIND_AUTO_CREATE)
            handler.post(updateRunnable)
        }

        btnStop.setOnClickListener {
            if (isBound) {
                unbindService(connection)
                isBound = false
            }
            val intent = Intent(this, OmniMeasureService::class.java)
            intent.action = "STOP_SERVICE"
            startService(intent)
            handler.removeCallbacks(updateRunnable)
        }

        btnExport.setOnClickListener { exportCsv() }
        btnReset.setOnClickListener { serviceBinder?.resetSession() }
        btnAbout.setOnClickListener { showAboutDialog() }
    }

    private fun updateUI() {
        if (!isBound || serviceBinder == null) return
        val result = serviceBinder?.lastResult ?: return

        // Update Text
        txtValues.text = "Shimmer: %.4f | Grad: %.4f\nTilt: %.2f°\nBind: %.1f%% | Indet: %d".format(
            result.shimmerIndex, result.descriptorGradient, result.preciseTilt[0], result.bindingStrength, result.indeterminateForms
        )

        txtState.text = "State: ${result.etState}\nD_time: %.1fs | T_time: %.1fs".format(result.dTime, result.tTime)

        txtSPL.text = "SPL: %.1f dB(A)".format(result.correctedSPL)
        
        // TTF Logic
        if (result.ttfPrediction == Double.POSITIVE_INFINITY) {
            txtTTF.text = "TTF: STABLE"
            txtTTF.setTextColor(Color.GREEN)
        } else {
            txtTTF.text = "TTF: %.1f Hours".format(result.ttfPrediction)
            txtTTF.setTextColor(Color.YELLOW)
        }

        // Severity Icons/Colors
        when (result.faultSeverity) {
            0 -> {
                statusIcon.setColorFilter(Color.GREEN)
            }
            1 -> {
                statusIcon.setColorFilter(Color.YELLOW)
            }
            2 -> {
                statusIcon.setColorFilter(Color.RED)
            }
        }
    }

    private fun exportCsv() {
        if (!isBound) return
        val csvData = serviceBinder?.getLogCsv() ?: return
        
        try {
            val file = File(cacheDir, "et_scan_log_v5.csv")
            FileOutputStream(file).use { it.write(csvData.toByteArray()) }
            
            val uri = FileProvider.getUriForFile(this, "${packageName}.provider", file)
            val intent = Intent(Intent.ACTION_SEND)
            intent.type = "text/csv"
            intent.putExtra(Intent.EXTRA_STREAM, uri)
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            startActivity(Intent.createChooser(intent, "Share ET Log"))
        } catch (e: Exception) {
            Toast.makeText(this, "Export failed: ${e.message}", Toast.LENGTH_SHORT).show()
        }
    }

    private fun showAboutDialog() {
        AlertDialog.Builder(this)
            .setTitle("ET Scanner v5.0 - Watcher")
            .setMessage("Universal Proof System\n\nDerived from Exception Theory by M.J.M.\n\n" +
                    "Features:\n- Dual Time (D_time/T_time)\n- Indeterminate Form Counter\n- Manifold Resonance Metrics\n- Predictive Maintenance (TTF)\n\n" +
                    "Privacy: Local P-D-T Calculation Only.")
            .setPositiveButton("OK", null)
            .show()
    }

    private fun checkPermissions() {
        val perms = arrayOf(Manifest.permission.RECORD_AUDIO, Manifest.permission.FOREGROUND_SERVICE)
        if (ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
            ActivityCompat.requestPermissions(this, perms, 1)
        }
    }
}