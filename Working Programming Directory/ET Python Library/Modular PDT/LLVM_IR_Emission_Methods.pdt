    L("  %cnt_ee = load i32, i32* %cnt_ptr")
    L("  call void @etpl_tok_set(%ETToken* %toks, i32 %cnt_ee, i32 64, i8* %eqeq_s)")
    L("  %cnt_ee2 = add i32 %cnt_ee, 1")
    L("  store i32 %cnt_ee2, i32* %cnt_ptr")
