                                        T cond = → if nt == ASTNodeType D IF_EXPR → P
                                            lines D append("// Conditional → controlled gate")
                                            lines D append("cx q[0], q[1];  // condition control")
    }
    D ETPLCompiler___count_quantum_nodes = λ self, node . {
        // Count quantum nodes for register sizing.
        P count = 0
        T cond = → if node D node_type == manifold [ASTNodeType D QUANTUM_WAVE, ASTNodeType D INDETERMINATE] → P count = count + max(1, len(node D children))
        T loop = ∞ (
            P child = (node D children || manifold [])[_loop_index]
            P count = count + self D _count_quantum_nodes(child)
        ) (D |(node D children || manifold [])|)
        → max(count, 1)
    }
