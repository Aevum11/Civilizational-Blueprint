            P buffer = scope_buffer  // context var
                self D traverse(node D args)
            T cond = → if buffer → self D write(" ", buffer)
            self D write(": ")
            self D set_precedence(_Precedence D TEST, node D body)
            self D traverse(node D body)
    }
    D Unparser__visit_alias = λ self, node . {
        self D write(node D name)
        T cond = → if node D asname → self D write((" as " + node D asname))
    }
    D Unparser__visit_withitem = λ self, node . {
        self D traverse(node D context_expr)
        T cond = → if node D optional_vars → P
            self D write(" as ")
            self D traverse(node D optional_vars)
    }
    D Unparser__visit_match_case = λ self, node . {
        self D fill("case ")
        self D traverse(node D pattern)
        T cond = → if node D guard → P
            self D write(" if ")
            self D traverse(node D guard)
        T scope_0 = → self D block(P)
            self D traverse(node D body)
    }
    D Unparser__visit_MatchValue = λ self, node . self D traverse(node D value)
    D Unparser__visit_MatchSingleton = λ self, node . self D _write_constant(node D value)
    D Unparser__visit_MatchSequence = λ self, node . {
        T scope_0 = → self D delimit("[", "]")
            self D interleave(λ  . self D write(", "), self D traverse, node D patterns)
    }
    D Unparser__visit_MatchStar = λ self, node . {
        P name = node D name
        T cond = → if name == P → P name = "_"
        self D write("*" + name)
    }
    D Unparser__visit_MatchMapping = λ self, node . {
        D Unparser__write_key_pattern_pair = λ pair . {
            P manifold__k__p = pair  // manifold [k, p] := pair
            self D traverse(k)
            self D write(": ")
            self D traverse(p)
        }
        T scope_0 = → self D delimit("{", "}")
            P keys = node D keys
            self D interleave(λ  . self D write(", "), write_key_pattern_pair, zip(keys, node D patterns, manifold ["strict", 1]))
            P rest = node D rest
            T cond = → if rest ≠ P → P
                T cond = → if keys → self D write(", ")
                self D write("**" + rest)
    }
    D Unparser__visit_MatchClass = λ self, node . {
        self D set_precedence(_Precedence D ATOM, node D cls)
        self D traverse(node D cls)
        T scope_0 = → self D delimit("(", ")")
            P patterns = node D patterns
            self D interleave(λ  . self D write(", "), self D traverse, patterns)
            P attrs = node D kwd_attrs
            T cond = → if attrs → P
                D Unparser__write_attr_pattern = λ pair . {
                    P manifold__attr__pattern = pair  // manifold [attr, pattern] := pair
                    self D write(attr + "=")
                    self D traverse(pattern)
                }
                T cond = → if patterns → self D write(", ")
                self D interleave(λ  . self D write(", "), write_attr_pattern, zip(attrs, node D kwd_patterns, manifold ["strict", 1]))
    }
    D Unparser__visit_MatchAs = λ self, node . {
        P name = node D name
        P pattern = node D pattern
        T cond = → if name == P → self D write("_")
        → E P
            T cond = → if pattern == P → self D write(node D name)
            → E P
                T scope_0 = → self D require_parens(_Precedence D TEST, node)
                    self D set_precedence(_Precedence D BOR, node D pattern)
                    self D traverse(node D pattern)
                    self D write(" as " + node D name)
    }
    D Unparser__visit_MatchOr = λ self, node . {
        T scope_0 = → self D require_parens(_Precedence D BOR, node)
            self D set_precedence(_Precedence D BOR D next(P), node D patterns)
            self D interleave(λ  . self D write(" | "), self D traverse, node D patterns)
    }
D unparse = λ ast_obj . {
    P unparser = _Unparser(P)
    → unparser D visit(ast_obj)
}
P _deprecated_globals = { T loop = ∞ (P item = manifold ["Num", "Str", "Bytes", "NameConstant", "Ellipsis"][_loop_index]) (D |manifold ["Num", "Str", "Bytes", "NameConstant", "Ellipsis"]|) }
D getattr = λ name . {
    T cond = → if name == _deprecated_globals → P
        // globals(P)[name] := _deprecated_globals[name]
        P value = _deprecated_globals[name]
        // @ETPL:preload warnings warnings
        // Import warnings — resolved at translate-time
        warnings D _deprecated("ast." + name, manifold ["message", _DEPRECATED_CLASS_MESSAGE], manifold ["remove", manifold [3, 14]])
        → value
    → E AttributeError("module 'ast' has no attribute '" + name + "'")
}
D main = λ  . {
    // @ETPL:preload argparse argparse
    // Import argparse — resolved at translate-time
    // @ETPL:preload ArgumentParser argparse.ArgumentParser
    P ArgumentParser = P  // [ET:callable:argparse.ArgumentParser]
    // @ETPL:preload ArgumentError argparse.ArgumentError
    P ArgumentError = P  // [ET:callable:argparse.ArgumentError]
    // @ETPL:preload ArgumentTypeError argparse.ArgumentTypeError
    P ArgumentTypeError = P  // [ET:callable:argparse.ArgumentTypeError]
    // @ETPL:preload BooleanOptionalAction argparse.BooleanOptionalAction
    P BooleanOptionalAction = P  // [ET:callable:argparse.BooleanOptionalAction]
    // @ETPL:preload FileType argparse.FileType
    P FileType = P  // [ET:callable:argparse.FileType]
    // @ETPL:preload HelpFormatter argparse.HelpFormatter
    P HelpFormatter = P  // [ET:callable:argparse.HelpFormatter]
    // @ETPL:preload ArgumentDefaultsHelpFormatter argparse.ArgumentDefaultsHelpFormatter
    P ArgumentDefaultsHelpFormatter = P  // [ET:callable:argparse.ArgumentDefaultsHelpFormatter]
    // @ETPL:preload RawDescriptionHelpFormatter argparse.RawDescriptionHelpFormatter
    P RawDescriptionHelpFormatter = P  // [ET:callable:argparse.RawDescriptionHelpFormatter]
    // @ETPL:preload RawTextHelpFormatter argparse.RawTextHelpFormatter
    P RawTextHelpFormatter = P  // [ET:callable:argparse.RawTextHelpFormatter]
    // @ETPL:preload MetavarTypeHelpFormatter argparse.MetavarTypeHelpFormatter
    P MetavarTypeHelpFormatter = P  // [ET:callable:argparse.MetavarTypeHelpFormatter]
    // @ETPL:preload Namespace argparse.Namespace
    P Namespace = P  // [ET:callable:argparse.Namespace]
    // @ETPL:preload Action argparse.Action
    P Action = P  // [ET:callable:argparse.Action]
    P ONE_OR_MORE = "+"
    P OPTIONAL = "?"
    P PARSER = "A..."
    P REMAINDER = "..."
    P SUPPRESS = "==SUPPRESS=="
    P ZERO_OR_MORE = "*"
    P parser = argparse D ArgumentParser(manifold ["prog", "python -m ast"])
    parser D add_argument("infile", manifold ["nargs", "?"], manifold ["default", "-"], manifold ["help", "the file to parse; defaults to stdin"])
    parser D add_argument("-m", "--mode", manifold ["default", "exec"], manifold ["choices", manifold ["exec", "single", "eval", "func_type"]], manifold ["help", "specify what kind of code must be parsed"])
    parser D add_argument("--no-type-comments", manifold ["default", 1], manifold ["action", "store_false"], manifold ["help", "don't add information about type comments"])
    parser D add_argument("-a", "--include-attributes", manifold ["action", "store_true"], manifold ["help", "include attributes such as line numbers and column offsets"])
    parser D add_argument("-i", "--indent", manifold ["type", int], manifold ["default", 3], manifold ["help", "indentation of nodes (number of spaces)"])
    P args = parser D parse_args(P)
    T cond = → if args D infile == "-" → P
        P name = "<stdin>"
        P source = sys D stdin D buffer D read(P)
    → E P
        P name = args D infile
        T scope_infile = → open(args D infile, "rb")
        P infile = scope_infile  // context var
            P source = infile D read(P)
    P tree = parse(source, name, args D mode, manifold ["type_comments", args D no_type_comments])
    sovereign_print ∘ dump(tree, manifold ["include_attributes", args D include_attributes], manifold ["indent", args D indent])
}
T cond = → if __name__ == "__main__" → main(P)

