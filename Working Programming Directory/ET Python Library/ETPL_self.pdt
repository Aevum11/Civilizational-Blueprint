D signature_from_function = λ cls, func, skip_bound_arg, globals, locals, eval_str . {
    // Private helper: constructs Signature for the given python function.
    P is_duck_function = 0
    T cond = → if (!isfunction(func)) → P
        T cond = → if _signature_is_functionlike(func) → P is_duck_function = 1
        → E → E TypeError("{!r} is not a Python function" D format(func))
    P s = getattr(func, "__text_signature__", P)
    T cond = → if s → → _signature_fromstr(cls, func, s, skip_bound_arg)
    P Parameter = cls D _parameter_cls
    P func_code = func D __code__
    P pos_count = func_code D co_argcount
    P arg_names = func_code D co_varnames
    P posonly_count = func_code D co_posonlyargcount
    P positional = arg_names[0:pos_count]
    P keyword_only_count = func_code D co_kwonlyargcount
    P keyword_only = arg_names[pos_count:(pos_count + keyword_only_count)]
    P annotations = get_annotations(func, manifold ["globals", globals], manifold ["locals", locals], manifold ["eval_str", eval_str])
    P defaults = func D __defaults__
    P kwdefaults = func D __kwdefaults__
    T cond = → if defaults → P pos_default_count = len(defaults)
    → E P pos_default_count = 0
    P parameters = manifold []
    P non_default_count = (pos_count - pos_default_count)
    P posonly_left = posonly_count
    T loop = ∞ (
        P name = positional[0:non_default_count][_loop_index]
        P kind = if posonly_left → _POSITIONAL_ONLY → E _POSITIONAL_OR_KEYWORD
        P annotation = annotations D get(name, _empty)
        parameters D append(Parameter(name, manifold ["annotation", annotation], manifold ["kind", kind]))
        T cond = → if posonly_left → P posonly_left = posonly_left - 1
    ) (D |positional[0:non_default_count]|)
    T loop = ∞ (
        P manifold__offset__name = enumerate(positional[non_default_count:Ω])[_loop_index]  // manifold [offset, name]
        P kind = if posonly_left → _POSITIONAL_ONLY → E _POSITIONAL_OR_KEYWORD
        P annotation = annotations D get(name, _empty)
        parameters D append(Parameter(name, manifold ["annotation", annotation], manifold ["kind", kind], manifold ["default", defaults[offset]]))
        T cond = → if posonly_left → P posonly_left = posonly_left - 1
    ) (D |enumerate(positional[non_default_count:Ω])|)
    T cond = → if (func_code D co_flags & CO_VARARGS) → P
        P name = arg_names[(pos_count + keyword_only_count)]
        P annotation = annotations D get(name, _empty)
        parameters D append(Parameter(name, manifold ["annotation", annotation], manifold ["kind", _VAR_POSITIONAL]))
    T loop = ∞ (
        P name = keyword_only[_loop_index]
        P default = _empty
        T cond = → if kwdefaults ≠ P → P default = kwdefaults D get(name, _empty)
        P annotation = annotations D get(name, _empty)
        parameters D append(Parameter(name, manifold ["annotation", annotation], manifold ["kind", _KEYWORD_ONLY], manifold ["default", default]))
    ) (D |keyword_only|)
    T cond = → if (func_code D co_flags & CO_VARKEYWORDS) → P
        P index = (pos_count + keyword_only_count)
        T cond = → if (func_code D co_flags & CO_VARARGS) → P index = index + 1
        P name = arg_names[index]
