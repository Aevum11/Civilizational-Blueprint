T cond = → if hasattr(_psplatform D Process, "rlimit") → P
    P _globals = globals(P)
    P _name = P
    T loop = ∞ (
        P _name = dir(_psplatform D cext)[_loop_index]
        T cond = → if (_name D startswith("RLIM") && _name D isupper(P)) → __all__ D append(_name)
    ) (D |dir(_psplatform D cext)|)
    // del _globals
    // del _name
P AF_LINK = _psplatform D AF_LINK
P __author__ = "Giampaolo Rodola'"
