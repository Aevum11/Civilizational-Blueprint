// @ETPL:trace-stdlib hashlib.py  // module=hashlib
P __doc__ = "hashlib module - A common interface to many hash functions.\n\nnew(name, data=b'', **kwargs) - returns a new hash object implementing the\n                                given hash function; initializing the hash\n                                using the given binary data.\n\nNamed constructor functions are also available, these are faster\nthan using new(name):\n\nmd5(), sha1(), sha224(), sha256(), sha384(), sha512(), blake2b(), blake2s(),\nsha3_224, sha3_256, sha3_384, sha3_512, shake_128, and shake_256.\n\nMore algorithms may be available on your platform but the above are guaranteed\nto exist.  See the algorithms_guaranteed and algorithms_available attributes\nto find out what algorithm names can be passed to new().\n\nNOTE: If you want the adler32 or crc32 hash functions they are available in\nthe zlib module.\n\nChoose your hash function wisely.  Some have known collision weaknesses.\nsha384 and sha512 will be slow on 32 bit platforms.\n\nHash objects have these methods:\n - update(data): Update the hash object with the bytes in data. Repeated calls\n                 are equivalent to a single call with the concatenation of all\n                 the arguments.\n - digest():     Return the digest of the bytes passed to the update() method\n                 so far as a bytes object.\n - hexdigest():  Like digest() except the digest is returned as a string\n                 of double length, containing only hexadecimal digits.\n - copy():       Return a copy (clone) of the hash object. This can be used to\n                 efficiently compute the digests of datas that share a common\n                 initial substring.\n\nFor example, to obtain the digest of the byte string 'Nobody inspects the\nspammish repetition':\n\n    >>> import hashlib\n    >>> m = hashlib.md5()\n    >>> m.update(b\"Nobody inspects\")\n    >>> m.update(b\" the spammish repetition\")\n    >>> m.digest()\n    b'\\xbbd\\x9c\\x83\\xdd\\x1e\\xa5\\xc9\\xd9\\xde\\xc9\\xa1\\x8d\\xf0\\xff\\xe9'\n\nMore condensed:\n\n    >>> hashlib.sha224(b\"Nobody inspects the spammish repetition\").hexdigest()\n    'a4337bc45a8fc544c03f52dc550cd6e1e87021bc896588bd79e901e2'\n\n"
P __always_supported = manifold ["md5", "sha1", "sha224", "sha256", "sha384", "sha512", "blake2b", "blake2s", "sha3_224", "sha3_256", "sha3_384", "sha3_512", "shake_128", "shake_256"]
P algorithms_guaranteed = set(__always_supported)
P algorithms_available = set(__always_supported)
P __all__ = (__always_supported + manifold ["new", "algorithms_guaranteed", "algorithms_available", "file_digest"])
P __builtin_constructor_cache = manifold []
P __block_openssl_constructor = manifold ["blake2b", "blake2s"]
D get_builtin_constructor = λ name . {
    P cache = __builtin_constructor_cache
    P constructor = cache D get(name)
    T cond = → if constructor ≠ P → → constructor
    T attempt = → P  // try
        T cond = → if name == manifold ["SHA1", "sha1"] → P
            // @ETPL:preload _sha1 _sha1
            // Import _sha1 — resolved at translate-time
            // @ETPL:preload SHA1Type _sha1.SHA1Type
            P SHA1Type = P  // [ET:callable:_sha1.SHA1Type]
            // @ETPL:preload sha1 _sha1.sha1
            P sha1 = P  // [ET:callable:_sha1.sha1]
            // cache["SHA1"] := _sha1 D sha1
            // cache["sha1"] := _sha1 D sha1
        → E P
            T cond = → if name == manifold ["MD5", "md5"] → P
                // @ETPL:preload _md5 _md5
                // Import _md5 — resolved at translate-time
                // @ETPL:preload MD5Type _md5.MD5Type
                P MD5Type = P  // [ET:callable:_md5.MD5Type]
                // @ETPL:preload md5 _md5.md5
                P md5 = P  // [ET:callable:_md5.md5]
                // cache["MD5"] := _md5 D md5
                // cache["md5"] := _md5 D md5
            → E P
                T cond = → if name == manifold ["SHA256", "sha256", "SHA224", "sha224"] → P
                    // @ETPL:preload _sha2 _sha2
                    // Import _sha2 — resolved at translate-time
                    // @ETPL:preload SHA224Type _sha2.SHA224Type
                    P SHA224Type = P  // [ET:callable:_sha2.SHA224Type]
                    // @ETPL:preload SHA256Type _sha2.SHA256Type
                    P SHA256Type = P  // [ET:callable:_sha2.SHA256Type]
                    // @ETPL:preload SHA384Type _sha2.SHA384Type
                    P SHA384Type = P  // [ET:callable:_sha2.SHA384Type]
                    // @ETPL:preload SHA512Type _sha2.SHA512Type
                    P SHA512Type = P  // [ET:callable:_sha2.SHA512Type]
                    // @ETPL:preload sha224 _sha2.sha224
                    P sha224 = P  // [ET:callable:_sha2.sha224]
                    // @ETPL:preload sha256 _sha2.sha256
                    P sha256 = P  // [ET:callable:_sha2.sha256]
                    // @ETPL:preload sha384 _sha2.sha384
                    P sha384 = P  // [ET:callable:_sha2.sha384]
                    // @ETPL:preload sha512 _sha2.sha512
                    P sha512 = P  // [ET:callable:_sha2.sha512]
                    // cache["SHA224"] := _sha2 D sha224
                    // cache["sha224"] := _sha2 D sha224
                    // cache["SHA256"] := _sha2 D sha256
                    // cache["sha256"] := _sha2 D sha256
                → E T cond = → if name == manifold ["SHA512", "sha512", "SHA384", "sha384"] → P  // pass
    → E ImportError (_)
        // pass
    P constructor = cache D get(name)
    T cond = → if constructor ≠ P → → constructor
    → E ValueError(("unsupported hash type " + name))
}
D get_openssl_constructor = λ name . {
    T cond = → if name == __block_openssl_constructor → → __get_builtin_constructor(name)
    T attempt = → P  // try
        P f = getattr(_hashlib, ("openssl_" + name))
        f(manifold ["usedforsecurity", 0])
        → f
    → E manifold [AttributeError, ValueError] (_)
        → __get_builtin_constructor(name)
}
D py_new = λ name . {
