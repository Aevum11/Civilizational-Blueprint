<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ET Scanner v5.0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The Watcher Update"
        android:textSize="14sp"
        android:textStyle="italic"
        android:layout_marginBottom="20dp"/>

    <ImageView
        android:id="@+id/statusIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_lock_idle_alarm"
        android:tint="#CCCCCC"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txtState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="State: WAITING..."
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:id="@+id/txtValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initializing T-Nav..."
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txtSPL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SPL: --.- dB"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txtTTF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TTF: CALCULATING..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Scan" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Session / Recalibrate"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export Log (CSV)"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About / Privacy"
        android:layout_marginTop="10dp"/>

</LinearLayout>