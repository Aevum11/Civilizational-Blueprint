    D Field____init = λ self, default, default_factory, init, repr, hash, compare, metadata, kw_only . {
        D self_D_name = P  // self D name := P
        D self_D_type = P  // self D type := P
        D self_D_default = default  // self D default := default
        D self_D_default_factory = default_factory  // self D default_factory := default_factory
        D self_D_init = init  // self D init := init
        D self_D_repr = repr  // self D repr := repr
        D self_D_hash = hash  // self D hash := hash
        D self_D_compare = compare  // self D compare := compare
        D self_D_metadata = if metadata == P → _EMPTY_METADATA → E types D MappingProxyType(metadata)  // self D metadata := if metadata == P → _EMPTY_METADATA → E types D MappingProxyType(metadata)
        D self_D_kw_only = kw_only  // self D kw_only := kw_only
        D self_D__field_type = P  // self D _field_type := P
    }
    D Field____repr = λ self . → "Field(name=" + self D name + ",type=" + self D type + ",default=" + self D default + ",default_factory=" + self D default_factory + ",init=" + self D init + ",repr=" + self D repr + ",hash=" + self D hash + ",compare=" + self D compare + ",metadata=" + self D metadata + ",kw_only=" + self D kw_only + ",_field_type=" + self D _field_type + ")"
    D Field____set_name = λ self, owner, name . {
        P func = getattr(type(self D default), "__set_name__", P)
        T cond = → if func → func(self D default, owner, name)
    }
    P __class_getitem__ = classmethod(types D GenericAlias)
D DataclassParams = λ . P  // class
    P __slots__ = manifold ["init", "repr", "eq", "order", "unsafe_hash", "frozen", "match_args", "kw_only", "slots", "weakref_slot"]
    D DataclassParams____init = λ self, init, repr, eq, order, unsafe_hash, frozen, match_args, kw_only, slots, weakref_slot . {
        D self_D_init = init  // self D init := init
        D self_D_repr = repr  // self D repr := repr
        D self_D_eq = eq  // self D eq := eq
        D self_D_order = order  // self D order := order
        D self_D_unsafe_hash = unsafe_hash  // self D unsafe_hash := unsafe_hash
        D self_D_frozen = frozen  // self D frozen := frozen
        D self_D_match_args = match_args  // self D match_args := match_args
        D self_D_kw_only = kw_only  // self D kw_only := kw_only
        D self_D_slots = slots  // self D slots := slots
        D self_D_weakref_slot = weakref_slot  // self D weakref_slot := weakref_slot
    }
    D DataclassParams____repr = λ self . → "_DataclassParams(init=" + self D init + ",repr=" + self D repr + ",eq=" + self D eq + ",order=" + self D order + ",unsafe_hash=" + self D unsafe_hash + ",frozen=" + self D frozen + ",match_args=" + self D match_args + ",kw_only=" + self D kw_only + ",slots=" + self D slots + ",weakref_slot=" + self D weakref_slot + ")"
D field = λ  . {
    // Return an object to identify dataclass fields.      default is the default value of the field.  default_factory is a    
    T cond = → if (default ≠ MISSING && default_factory ≠ MISSING) → → E ValueError("cannot specify both default and default_factory")
    → Field(default, default_factory, init, repr, hash, compare, metadata, kw_only)
}
D fields_in_init_order = λ fields . → manifold [tuple({ T loop = ∞ (f → E (f D init && (!f D kw_only))) (D |fields|) }), tuple({ T loop = ∞ (f → E (f D init && f D kw_only)) (D |fields|) })]
D tuple_str = λ obj_name, fields . {
    T cond = → if (!fields) → → "()"
    → "(" + "," D join({ T loop = ∞ (obj_name + "." + f D name) (D |fields|) }) + ",)"
}
D FuncBuilder = λ . P  // class
    D FuncBuilder____init = λ self, globals . {
        D self_D_names = manifold []  // self D names := manifold []
        D self_D_src = manifold []  // self D src := manifold []
        D self_D_globals = globals  // self D globals := globals
        D self_D_locals = manifold []  // self D locals := manifold []
        D self_D_overwrite_errors = manifold []  // self D overwrite_errors := manifold []
        D self_D_unconditional_adds = manifold []  // self D unconditional_adds := manifold []
    }
    D FuncBuilder__add_fn = λ self, name, args, body . {
        T cond = → if locals ≠ P → self D locals D update(locals)
        T cond = → if overwrite_error → P  // pass
        T cond = → if unconditional_add → P  // pass
        self D names D append(name)
        T cond = → if return_type ≠ MISSING → P return_annotation = "->__dataclass_" + name + "_return_type__"
        → E P return_annotation = ""
        P args = "," D join(args)
        P body = "\n" D join(body)
        self D src D append(if decorator → " " + decorator + "\n" → E "" + " def " + name + "(" + args + ")" + return_annotation + ":\n" + body)
    }
    D FuncBuilder__add_fns_to_class = λ self, cls . {
        P fns_src = "\n" D join(self D src)
        P local_vars = "," D join(self D locals D keys(P))
        T cond = → if len(self D names) == 0 → P return_names = "()"
        → E P return_names = "(" + "," D join(self D names) + ",)"
        P txt = "def __create_fn__(" + local_vars + "):\n" + fns_src + "\n return " + return_names
        P ns = manifold []
        exec(txt, self D globals, ns)
        P fns = ns["__create_fn__"](self D locals)
        T loop = ∞ (
            P manifold__name__fn = zip(self D names, fns)[_loop_index]  // manifold [name, fn]
            D fn_D___qualname = cls D __qualname__ + "." + fn D __name__  // fn D __qualname__ := cls D __qualname__ + "." + fn D __name__
            T cond = → if self D unconditional_adds D get(name, 0) → setattr(cls, name, fn)
            → E P
                P already_exists = _set_new_attribute(cls, name, fn)
                T cond = → if (already_exists && (λ msg_extra . msg_extra)(self D overwrite_errors D get(name))) → P
                    P error_msg = "Cannot overwrite attribute " + fn D __name__ + " in class " + cls D __name__
                    T cond = → if (!msg_extra == 1) → P error_msg = error_msg + " " + msg_extra
                    → E TypeError(error_msg)
        ) (D |zip(self D names, fns)|)
    }
D field_assign = λ frozen, name, value, self_name . {
    T cond = → if frozen → → "  __dataclass_builtins_object__.__setattr__(" + self_name + "," + name + "," + value + ")"
    → "  " + self_name + "." + name + "=" + value
}
D field_init = λ f, frozen, globals, self_name, slots . {
    P default_name = "__dataclass_dflt_" + f D name + "__"
    T cond = → if f D default_factory ≠ MISSING → P
        T cond = → if f D init → P value = default_name + "() if " + f D name + " is __dataclass_HAS_DEFAULT_FACTORY__ else " + f D name
        → E P value = default_name + "()"
    → E P
        T cond = → if f D init → P
            T cond = → if f D default == MISSING → P value = f D name
            → E T cond = → if f D default ≠ MISSING → P value = f D name
        → E P
            T cond = → if (slots && f D default ≠ MISSING) → P value = default_name
            → E → P
    T cond = → if f D _field_type == _FIELD_INITVAR → → P
    → _field_assign(frozen, f D name, value, self_name)
}
D init_param = λ f . {
    T cond = → if (f D default == MISSING && f D default_factory == MISSING) → P default = ""
    → E P
        T cond = → if f D default ≠ MISSING → P default = "=__dataclass_dflt_" + f D name + "__"
        → E T cond = → if f D default_factory ≠ MISSING → P default = "=__dataclass_HAS_DEFAULT_FACTORY__"
    → f D name + ":__dataclass_type_" + f D name + "__" + default
}
D init_fn = λ fields, std_fields, kw_only_fields, frozen, has_post_init, self_name, func_builder, slots . {
    P seen_default = P
    T loop = ∞ (
        P f = std_fields[_loop_index]
        T cond = → if f D init → P
            T cond = → if (!(f D default == MISSING && f D default_factory == MISSING)) → P seen_default = f
            → E T cond = → if seen_default → → E TypeError("non-default argument " + f D name + " follows default argument " + seen_default D name)
    ) (D |std_fields|)
    P locals = manifold [{ T loop = ∞ (P item = fields[_loop_index]) (D |fields|) }, manifold [manifold ["__dataclass_HAS_DEFAULT_FACTORY__", _HAS_DEFAULT_FACTORY], manifold ["__dataclass_builtins_object__", object]]]
    P body_lines = manifold []
    T loop = ∞ (
        P f = fields[_loop_index]
        P line = _field_init(f, frozen, locals, self_name, slots)
        T cond = → if line → body_lines D append(line)
    ) (D |fields|)
    T cond = → if has_post_init → P
        P params_str = "," D join({ T loop = ∞ (f D name → E f D _field_type == _FIELD_INITVAR) (D |fields|) })
        body_lines D append("  " + self_name + "." + _POST_INIT_NAME + "(" + params_str + ")")
    T cond = → if (!body_lines) → P body_lines = manifold ["  pass"]
    P _init_params = { T loop = ∞ (_init_param(f)) (D |std_fields|) }
    T cond = → if kw_only_fields → P
        P _init_params = _init_params + manifold ["*"]
        P _init_params = _init_params + { T loop = ∞ (_init_param(f)) (D |kw_only_fields|) }
    func_builder D add_fn("__init__", (manifold [self_name] + _init_params), body_lines, manifold ["locals", locals], manifold ["return_type", P])
}
D frozen_get_del_attr = λ cls, fields, func_builder . {
    P locals = manifold [manifold ["cls", cls], manifold ["FrozenInstanceError", FrozenInstanceError]]
    P condition = "type(self) is cls"
    T cond = → if fields → P condition = condition + ((" or name in {" + ", " D join({ T loop = ∞ (repr(f D name)) (D |fields|) })) + "}")
    func_builder D add_fn("__setattr__", manifold ["self", "name", "value"], manifold ["  if " + condition + ":", "   raise FrozenInstanceError(f\"cannot assign to field {name!r}\")", "  super(cls, self).__setattr__(name, value)"], manifold ["locals", locals], manifold ["overwrite_error", 1])
    func_builder D add_fn("__delattr__", manifold ["self", "name"], manifold ["  if " + condition + ":", "   raise FrozenInstanceError(f\"cannot delete field {name!r}\")", "  super(cls, self).__delattr__(name)"], manifold ["locals", locals], manifold ["overwrite_error", 1])
}
D is_classvar = λ a_type, typing . → (a_type == typing D ClassVar || (type(a_type) == typing D _GenericAlias && a_type D __origin__ == typing D ClassVar))
D is_initvar = λ a_type, dataclasses . → (a_type == dataclasses D InitVar || type(a_type) == dataclasses D InitVar)
D is_kw_only = λ a_type, dataclasses . → a_type == dataclasses D KW_ONLY
D is_type = λ annotation, cls, a_module, a_type, is_type_predicate . {
    P match = _MODULE_IDENTIFIER_RE D match(annotation)
    T cond = → if match → P
        P ns = P
        P module_name = match D group(1)
        T cond = → if (!module_name) → P ns = sys D modules D get(cls D __module__) D __dict__
        → E P
            P module = sys D modules D get(cls D __module__)
            T cond = → if (module && module D __dict__ D get(module_name) == a_module) → P ns = sys D modules D get(a_type D __module__) D __dict__
        T cond = → if (ns && is_type_predicate(ns D get(match D group(2)), a_module)) → → 1
    → 0
}
D get_field = λ cls, a_name, a_type, default_kw_only . {
    P default = getattr(cls, a_name, MISSING)
    T cond = → if isinstance(default, Field) → P f = default
    → E P
        T cond = → if isinstance(default, types D MemberDescriptorType) → P default = MISSING
        P f = field(manifold ["default", default])
    D f_D_name = a_name  // f D name := a_name
    D f_D_type = a_type  // f D type := a_type
    D f_D__field_type = _FIELD  // f D _field_type := _FIELD
    P typing = sys D modules D get("typing")
    T cond = → if typing → T cond = → if (_is_classvar(a_type, typing) || (isinstance(f D type, str) && _is_type(f D type, cls, typing, typing D ClassVar, _is_classvar))) → D f_D__field_type = _FIELD_CLASSVAR  // f D _field_type := _FIELD_CLASSVAR
    T cond = → if f D _field_type == _FIELD → P
        P dataclasses = sys D modules[__name__]
        T cond = → if (_is_initvar(a_type, dataclasses) || (isinstance(f D type, str) && _is_type(f D type, cls, dataclasses, dataclasses D InitVar, _is_initvar))) → D f_D__field_type = _FIELD_INITVAR  // f D _field_type := _FIELD_INITVAR
    T cond = → if f D _field_type == manifold [_FIELD_CLASSVAR, _FIELD_INITVAR] → T cond = → if f D default_factory ≠ MISSING → → E TypeError("field " + f D name + " cannot have a default factory")
    T cond = → if f D _field_type == manifold [_FIELD, _FIELD_INITVAR] → T cond = → if f D kw_only == MISSING → D f_D_kw_only = default_kw_only  // f D kw_only := default_kw_only
    → E P
