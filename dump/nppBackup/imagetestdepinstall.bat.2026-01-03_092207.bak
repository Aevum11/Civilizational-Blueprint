@echo off
TITLE ET SUBSTRATE BINDER [FORCE MODE]
COLOR 0A

:: =======================================================
:: ET DEPENDENCY INSTALLER - ROBUST MODE
:: =======================================================

echo [ET] DIAGNOSING SUBSTRATE (SYSTEM CHECK)...
echo.

:: 1. DETECT INTERPRETER
:: We check if 'python' exists. If not, we try 'py' (Windows Launcher).
set PYTHON_CMD=python

%PYTHON_CMD% --version >nul 2>&1
IF %ERRORLEVEL% NEQ 0 (
    echo [!] 'python' command not found. Checking for 'py' launcher...
    set PYTHON_CMD=py
    py --version >nul 2>&1
    IF %ERRORLEVEL% NEQ 0 (
        COLOR 0C
        echo.
        echo [CRITICAL FAILURE] NO PYTHON SUBSTRATE DETECTED.
        echo ---------------------------------------------------------
        echo Python is not installed or not added to your SYSTEM PATH.
        echo Please install Python from python.org and check "Add to PATH".
        echo ---------------------------------------------------------
        echo.
        echo Press any key to exit...
        pause >nul
        exit /b
    )
)

echo [OK] INTERPRETER DETECTED: %PYTHON_CMD%
%PYTHON_CMD% --version

echo.
echo [ET] INITIATING BINDING SEQUENCE...
echo ---------------------------------------

:: 2. UPGRADE PIP (The Binder)
echo [1/3] Upgrading PIP...
"%PYTHON_CMD%" -m pip install --upgrade pip
IF %ERRORLEVEL% NEQ 0 (
    echo [!] Warning: PIP upgrade failed. Continuing with existing version...
)

:: 3. INSTALL DESCRIPTORS (The Libraries)
echo.
echo [2/3] Installing NumPy, OpenCV, Pillow...
"%PYTHON_CMD%" -m pip install numpy opencv-python pillow
IF %ERRORLEVEL% NEQ 0 (
    COLOR 0C
    echo.
    echo [FAILURE] COULD NOT INSTALL LIBRARIES.
    echo Check your internet connection or permissions.
    echo.
    pause
    exit /b
)

:: 4. VERIFY BINDING
echo.
echo [3/3] Verifying Integrity...
"%PYTHON_CMD%" -c "import numpy; print('  - Numpy Bound'); import cv2; print('  - OpenCV Bound'); import PIL; print('  - Pillow Bound');"

IF %ERRORLEVEL% NEQ 0 (
    COLOR 0C
    echo.
    echo [ERROR] Verification failed. The libraries installed but cannot be imported.
    pause
    exit /b
)

echo.
echo ===========================================
echo [SUCCESS] ALL DESCRIPTORS BOUND.
echo You may now run the Python script.
echo ===========================================
echo.
echo Press any key to close...
pause >nul