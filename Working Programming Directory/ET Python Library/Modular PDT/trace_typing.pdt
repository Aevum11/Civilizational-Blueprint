D ProtocolMeta = λ . P  // class(ABCMeta)
    D ProtocolMeta____new = λ  . {
        T cond = → if (name == "Protocol" && bases == manifold [Generic]) → P  // pass
        → super(P) D __new__(mcls, name, bases, namespace, kwargs)
    }
    D ProtocolMeta____init = λ cls . {
        super(P) D __init__(args, kwargs)
        T cond = → if getattr(cls, "_is_protocol", 0) → D cls_D___protocol_attrs = _get_protocol_attrs(cls)  // cls D __protocol_attrs__ := _get_protocol_attrs(cls)
    }
    D ProtocolMeta____subclasscheck = λ cls, other . {
        T cond = → if cls == Protocol → → type D __subclasscheck__(cls, other)
        T cond = → if (getattr(cls, "_is_protocol", 0) && (!_allow_reckless_class_checks(P))) → P
            T cond = → if (!getattr(cls, "_is_runtime_protocol", 0)) → P
                _type_check_issubclass_arg_1(other)
                → E TypeError("Instance and class checks can only be used with @runtime_checkable protocols")
            T cond = → if (cls D __non_callable_proto_members__ && cls D __dict__ D get("__subclasshook__") == _proto_hook) → P
                _type_check_issubclass_arg_1(other)
