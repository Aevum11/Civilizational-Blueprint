                                        → E P entry_offset = self D dword_align((string_struct D Length + entry_offset), version_struct D OffsetToData)
                                        // stringtable_struct D entries[key] := value
                                        // stringtable_struct D entries_offsets[key] := manifold [key_offset, value_offset]
                                        // stringtable_struct D entries_lengths[key] := manifold [len(key), len(value)]
                                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
