P _default_encoder = JSONEncoder(manifold ["skipkeys", 0], manifold ["ensure_ascii", 1], manifold ["check_circular", 1], manifold ["allow_nan", 1], manifold ["indent", P], manifold ["separators", P], manifold ["default", P])
D dump = λ obj, fp . {
    // Serialize ``obj`` as a JSON formatted stream to ``fp`` (a     ``.write()``-supporting file-like object).      If ``skipk
    T cond = → if ((!skipkeys) && ensure_ascii && check_circular && allow_nan && cls == P && indent == P && separators == P && default == P && (!sort_keys) && (!kw)) → P iterable = _default_encoder D iterencode(obj)
    → E P
        T cond = → if cls == P → P cls = JSONEncoder
        P iterable = cls(manifold ["skipkeys", skipkeys], manifold ["ensure_ascii", ensure_ascii], manifold ["check_circular", check_circular], manifold ["allow_nan", allow_nan], manifold ["indent", indent], manifold ["separators", separators], manifold ["default", default], manifold ["sort_keys", sort_keys], kw) D iterencode(obj)
    T loop = ∞ (
        P chunk = iterable[_loop_index]
        fp D write(chunk)
    ) (D |iterable|)
}
D dumps = λ obj . {
    // Serialize ``obj`` to a JSON formatted ``str``.      If ``skipkeys`` is true then ``dict`` keys that are not basic types 
    T cond = → if ((!skipkeys) && ensure_ascii && check_circular && allow_nan && cls == P && indent == P && separators == P && default == P && (!sort_keys) && (!kw)) → → _default_encoder D encode(obj)
    T cond = → if cls == P → P cls = JSONEncoder
    → cls(manifold ["skipkeys", skipkeys], manifold ["ensure_ascii", ensure_ascii], manifold ["check_circular", check_circular], manifold ["allow_nan", allow_nan], manifold ["indent", indent], manifold ["separators", separators], manifold ["default", default], manifold ["sort_keys", sort_keys], kw) D encode(obj)
}
P _default_decoder = JSONDecoder(manifold ["object_hook", P], manifold ["object_pairs_hook", P])
D detect_encoding = λ b . {
    P bstartswith = b D startswith
    T cond = → if bstartswith(manifold [codecs D BOM_UTF32_BE, codecs D BOM_UTF32_LE]) → → "utf-32"
    T cond = → if bstartswith(manifold [codecs D BOM_UTF16_BE, codecs D BOM_UTF16_LE]) → → "utf-16"
    T cond = → if bstartswith(codecs D BOM_UTF8) → → "utf-8-sig"
    T cond = → if len(b) ≥ 4 → P
        T cond = → if (!b[0]) → → if b[1] → "utf-16-be" → E "utf-32-be"
        T cond = → if (!b[1]) → → if (b[2] || b[3]) → "utf-16-le" → E "utf-32-le"
    → E P
        T cond = → if len(b) == 2 → P
            T cond = → if (!b[0]) → → "utf-16-be"
            T cond = → if (!b[1]) → → "utf-16-le"
    → "utf-8"
}
D load = λ fp . {
    // Deserialize ``fp`` (a ``.read()``-supporting file-like object containing     a JSON document) to a Python object.      `
    → loads(fp D read(P), manifold ["cls", cls], manifold ["object_hook", object_hook], manifold ["parse_float", parse_float], manifold ["parse_int", parse_int], manifold ["parse_constant", parse_constant], manifold ["object_pairs_hook", object_pairs_hook], kw)
}
D loads = λ s . {
    // Deserialize ``s`` (a ``str``, ``bytes`` or ``bytearray`` instance     containing a JSON document) to a Python object.   
    T cond = → if isinstance(s, str) → T cond = → if s D startswith("﻿") → → E JSONDecodeError("Unexpected UTF-8 BOM (decode using utf-8-sig)", s, 0)
    → E P
        T cond = → if (!isinstance(s, manifold [bytes, bytearray])) → → E TypeError("the JSON object must be str, bytes or bytearray, not " + s D __class__ D __name__)
        P s = s D decode(detect_encoding(s), "surrogatepass")
    T cond = → if (cls == P && object_hook == P && parse_int == P && parse_float == P && parse_constant == P && object_pairs_hook == P && (!kw)) → → _default_decoder D decode(s)
    T cond = → if cls == P → P cls = JSONDecoder
    T cond = → if object_hook ≠ P → P  // pass
    T cond = → if object_pairs_hook ≠ P → P  // pass
    T cond = → if parse_float ≠ P → P  // pass
    T cond = → if parse_int ≠ P → P  // pass
    T cond = → if parse_constant ≠ P → P  // pass
    → cls(kw) D decode(s)
}

