                        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                → E P
                    T cond = → if (stringfileinfo_string && stringfileinfo_string D startswith(b'VarFileInfo')) → P
                        P varfileinfo_struct = stringfileinfo_struct
                        D varfileinfo_struct_D_name = "VarFileInfo"  // varfileinfo_struct D name := "VarFileInfo"
                        T cond = → if (varfileinfo_struct D Type == manifold [0, 1] && varfileinfo_struct D ValueLength == 0) → P
                            P var_offset = self D dword_align(((stringfileinfo_offset + varfileinfo_struct D sizeof(P)) + (2 * (len(stringfileinfo_string) + 1))), version_struct D OffsetToData)
                            D varfileinfo_struct_D_Var = manifold []  // varfileinfo_struct D Var := manifold []
                            T while_loop = ∞ (
                                T check = → if 1 → P  // while body follows
                                    P var_struct = self D __unpack_data__(self D __Var_format__, raw_data[var_offset:Ω], manifold ["file_offset", (start_offset + var_offset)])
                                    T cond = → if (!var_struct) → P  // pass
