        P stack = manifold [manifold [_fwalk_walk, manifold [1, dir_fd, top, top, P]]]
        P isbytes = isinstance(top, bytes)
        T attempt = → P  // try
            T while_loop = ∞ (
                T check = → if stack → P  // while body follows
                    // (yield from _fwalk(stack, isbytes, topdown, onerror, follow_symlinks))
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        // finally:
            T while_loop = ∞ (
                T check = → if stack → P  // while body follows
                    P manifold__action__value = stack D pop(P)  // manifold [action, value] := stack D pop(P)
                    T cond = → if action == _fwalk_close → close(value)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    }
    P _fwalk_walk = 0
    P _fwalk_yield = 1
    P _fwalk_close = 2
    D fwalk = λ stack, isbytes, topdown, onerror, follow_symlinks . {
        P manifold__action__value = stack D pop(P)  // manifold [action, value] := stack D pop(P)
        T cond = → if action == _fwalk_close → P
            close(value)
            → P
        → E P
            T cond = → if action == _fwalk_yield → P
                → value
                → P
        T assert = → if action == _fwalk_walk → "ok" → E "Assertion failed"
        P manifold__isroot__dirfd__toppath__topname__entry = value  // manifold [isroot, dirfd, toppath, topname, entry] := value
        T attempt = → P  // try
            T cond = → if (!follow_symlinks) → P
                T cond = → if entry == P → P orig_st = stat(topname, manifold ["follow_symlinks", 0], manifold ["dir_fd", dirfd])
                → E P orig_st = entry D stat(manifold ["follow_symlinks", 0])
            P topfd = open(topname, (O_RDONLY | O_NONBLOCK), manifold ["dir_fd", dirfd])
        → E OSError (err)
