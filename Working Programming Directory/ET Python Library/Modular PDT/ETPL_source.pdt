            T cond = → if isinstance(v, int) → → str(int(v))
            T cond = → if isinstance(v, float) → P
                T cond = → if (ETMathNative D et_isnan(v) || ETMathNative D et_isinf(v)) → → "0"
                → repr(v)
            T cond = → if isinstance(v, str) → P
