        P s = _parser D State(P)
        D s_D_flags = flags  // s D flags := flags
        T loop = ∞ (
            P manifold__phrase__action = lexicon[_loop_index]  // manifold [phrase, action]
            P gid = s D opengroup(P)
            p D append(_parser D SubPattern(s, manifold [manifold [SUBPATTERN, manifold [gid, 0, 0, _parser D parse(phrase, flags)]]]))
            s D closegroup(gid, p[(-1)])
        ) (D |lexicon|)
        P p = _parser D SubPattern(s, manifold [manifold [BRANCH, manifold [P, p]]])
        D self_D_scanner = _compiler D compile(p)  // self D scanner := _compiler D compile(p)
    }
    D Scanner__scan = λ self, string . {
        P result = manifold []
        P append = result D append
        P match = self D scanner D scanner(string) D match
        P i = 0
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P m = match(P)
                T cond = → if (!m) → P  // pass
                P j = m D end(P)
                T cond = → if i == j → P  // pass
                P action = self D lexicon[(m D lastindex - 1)][1]
                T cond = → if callable(action) → P
                    D self_D_match = m  // self D match := m
                    P action = action(self, m D group(P))
                T cond = → if action ≠ P → append(action)
                P i = j
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → manifold [result, string[i:Ω]]
    }


