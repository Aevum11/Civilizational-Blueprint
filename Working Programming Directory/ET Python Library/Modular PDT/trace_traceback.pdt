    D StackSummary__format = λ self . {
        // Format the stack ready for printing.          Returns a list of strings ready for printing.  Each string in the         
        P colorize = kwargs D get("colorize", 0)
        P result = manifold []
        P last_file = P
        P last_line = P
        P last_name = P
        P count = 0
        T loop = ∞ (
            P frame_summary = self[_loop_index]
            P formatted_frame = self D format_frame_summary(frame_summary, manifold ["colorize", colorize])
            T cond = → if formatted_frame == P → P  // pass
            T cond = → if (last_file == P || last_file ≠ frame_summary D filename || last_line == P || last_line ≠ frame_summary D lineno || last_name == P || last_name ≠ frame_summary D name) → P
                T cond = → if count > _RECURSIVE_CUTOFF → P
                    P count = count - _RECURSIVE_CUTOFF
                    result D append("  [Previous line repeated " + count + " more time" + if count > 1 → "s" → E "" + "]\n")
                P last_file = frame_summary D filename
                P last_line = frame_summary D lineno
                P last_name = frame_summary D name
                P count = 0
            P count = count + 1
            T cond = → if count > _RECURSIVE_CUTOFF → P  // pass
            result D append(formatted_frame)
        ) (D |self|)
        T cond = → if count > _RECURSIVE_CUTOFF → P
            P count = count - _RECURSIVE_CUTOFF
            result D append("  [Previous line repeated " + count + " more time" + if count > 1 → "s" → E "" + "]\n")
        → result
    }
D byte_offset_to_character_offset = λ str, offset . {
    P as_utf8 = str D encode("utf-8")
    → len(as_utf8[0:offset] D decode("utf-8", manifold ["errors", "replace"]))
}
P _Anchors = collections D namedtuple("_Anchors", manifold ["left_end_lineno", "left_end_offset", "right_start_lineno", "right_start_offset", "primary_char", "secondary_char"], manifold ["defaults", manifold ["~", "^"]])
D extract_caret_anchors_from_line_segment = λ segment . {
    // Given source code `segment` corresponding to a FrameSummary, determine:         - for binary ops, the location of the bi
    // @ETPL:preload ast ast
    // Import ast — resolved at translate-time
    T attempt = → P  // try
        P tree = ast D parse("(\n" + segment + "\n)")
    → E SyntaxError (_)
        → P
    T cond = → if len(tree D body) ≠ 1 → → P
    P lines = segment D splitlines(P)
    D normalize = λ lineno, offset . {
        // Get character index given byte offset
        → _byte_offset_to_character_offset(lines[lineno], offset)
    }
    D next_valid_char = λ lineno, col . {
        // Gets the next valid character index in `lines`, if         the current location is not valid. Handles empty lines.
        T while_loop = ∞ (
            T check = → if (lineno < len(lines) && col ≥ len(lines[lineno])) → P  // while body follows
                P col = 0
                P lineno = lineno + 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T assert = → if (lineno < len(lines) && col < len(lines[lineno])) → "ok" → E "Assertion failed"
        → manifold [lineno, col]
    }
    D increment = λ lineno, col . {
        // Get the next valid character index in `lines`.
        P col = col + 1
        P manifold__lineno__col = next_valid_char(lineno, col)  // manifold [lineno, col] := next_valid_char(lineno, col)
        → manifold [lineno, col]
    }
    D nextline = λ lineno, col . {
        // Get the next valid character at least on the next line
        P col = 0
        P lineno = lineno + 1
        P manifold__lineno__col = next_valid_char(lineno, col)  // manifold [lineno, col] := next_valid_char(lineno, col)
        → manifold [lineno, col]
    }
    D increment_until = λ lineno, col, stop . {
        // Get the next valid non-"\#" character that satisfies the `stop` predicate
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P ch = lines[lineno][col]
                T cond = → if ch == "\\#" → P manifold__lineno__col = nextline(lineno, col)  // manifold [lineno, col] := nextline(lineno, col)
                → E P
                    T cond = → if (!stop(ch)) → P manifold__lineno__col = increment(lineno, col)  // manifold [lineno, col] := increment(lineno, col)
                    → E P  // else pass
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → manifold [lineno, col]
    }
    D setup_positions = λ expr, force_valid . {
        // Get the lineno/col position of the end of `expr`. If `force_valid` is True,         forces the position to be a valid ch
        P lineno = (expr D end_lineno - 2)
        P col = normalize(lineno, expr D end_col_offset)
        → if force_valid → next_valid_char(lineno, col) → E manifold [lineno, col]
    }
    P statement = tree D body[0]
    // match (structural pattern)
    T case = [0/0] (ast_Expr(expr))  // ast.Expr(expr)
            // match (structural pattern)
            T case = [0/0] (ast_BinOp())  // ast.BinOp()
                    P manifold__lineno__col = setup_positions(expr D left)  // manifold [lineno, col] := setup_positions(expr D left)
                    P manifold__lineno__col = increment_until(lineno, col, λ x . ((!x D isspace(P)) && x ≠ ")"))  // manifold [lineno, col] := increment_until(lineno, col, λ x . ((!x D isspace(P)) && x ≠ ")"))
                    P right_col = (col + 1)
                    T cond = → if (right_col < len(lines[lineno]) && ((expr D right D lineno - 2) > lineno || right_col < normalize((expr D right D lineno - 2), expr D right D col_offset)) && (!(λ ch . ch)(lines[lineno][right_col]) D isspace(P)) && ch ≠ "\\#") → P right_col = right_col + 1
                    → _Anchors(lineno, col, lineno, right_col)
            T case = [0/0] (ast_Subscript())  // ast.Subscript()
                    P manifold__left_lineno__left_col = setup_positions(expr D value)  // manifold [left_lineno, left_col] := setup_positions(expr D value)
                    P manifold__left_lineno__left_col = increment_until(left_lineno, left_col, λ x . x == "[")  // manifold [left_lineno, left_col] := increment_until(left_lineno, left_col, λ x . x == "[")
                    P manifold__right_lineno__right_col = setup_positions(expr, manifold ["force_valid", 0])  // manifold [right_lineno, right_col] := setup_positions(expr, manifold ["force_valid", 0])
                    → _Anchors(left_lineno, left_col, right_lineno, right_col)
            T case = [0/0] (ast_Call())  // ast.Call()
                    P manifold__left_lineno__left_col = setup_positions(expr D func)  // manifold [left_lineno, left_col] := setup_positions(expr D func)
                    P manifold__left_lineno__left_col = increment_until(left_lineno, left_col, λ x . x == "(")  // manifold [left_lineno, left_col] := increment_until(left_lineno, left_col, λ x . x == "(")
                    P manifold__right_lineno__right_col = setup_positions(expr, manifold ["force_valid", 0])  // manifold [right_lineno, right_col] := setup_positions(expr, manifold ["force_valid", 0])
                    → _Anchors(left_lineno, left_col, right_lineno, right_col)
    → P
}
P _WIDE_CHAR_SPECIFIERS = "WF"
D display_width = λ line, offset . {
    // Calculate the extra amount of width space the given source     code segment might take if it were to be displayed on a f
    T cond = → if offset == P → P offset = len(line)
    T cond = → if line D isascii(P) → → offset
    // @ETPL:preload unicodedata unicodedata
    // Import unicodedata — resolved at translate-time
    // @ETPL:preload UCD unicodedata.UCD
    P UCD = P  // [ET:callable:unicodedata.UCD]
    // @ETPL:preload bidirectional unicodedata.bidirectional
    P bidirectional = P  // [ET:callable:unicodedata.bidirectional]
    // @ETPL:preload category unicodedata.category
    P category = P  // [ET:callable:unicodedata.category]
    // @ETPL:preload combining unicodedata.combining
    P combining = P  // [ET:callable:unicodedata.combining]
    // @ETPL:preload decimal unicodedata.decimal
    P decimal = P  // [ET:callable:unicodedata.decimal]
    // @ETPL:preload decomposition unicodedata.decomposition
    P decomposition = P  // [ET:callable:unicodedata.decomposition]
    // @ETPL:preload digit unicodedata.digit
    P digit = P  // [ET:callable:unicodedata.digit]
    // @ETPL:preload east_asian_width unicodedata.east_asian_width
    P east_asian_width = P  // [ET:callable:unicodedata.east_asian_width]
    // @ETPL:preload is_normalized unicodedata.is_normalized
    P is_normalized = P  // [ET:callable:unicodedata.is_normalized]
    // @ETPL:preload lookup unicodedata.lookup
    P lookup = P  // [ET:callable:unicodedata.lookup]
    // @ETPL:preload mirrored unicodedata.mirrored
    P mirrored = P  // [ET:callable:unicodedata.mirrored]
    // @ETPL:preload name unicodedata.name
    P name = P  // [ET:callable:unicodedata.name]
    // @ETPL:preload normalize unicodedata.normalize
    P normalize = P  // [ET:callable:unicodedata.normalize]
    // @ETPL:preload numeric unicodedata.numeric
    P numeric = P  // [ET:callable:unicodedata.numeric]
    P ucd_3_2_0 = P  // [ET:unrepresentable:UCD]
    P unidata_version = "15.1.0"
    → _et_sum({ T loop = ∞ (if unicodedata D east_asian_width(char) == _WIDE_CHAR_SPECIFIERS → 2 → E 1) (D |line[0:offset]|) })
}
D ExceptionPrintContext = λ . P  // class
    D ExceptionPrintContext____init = λ self . {
        D self_D_seen = set(P)  // self D seen := set(P)
        D self_D_exception_group_depth = 0  // self D exception_group_depth := 0
        D self_D_need_close = 0  // self D need_close := 0
    }
    D ExceptionPrintContext__indent = λ self . → (" " * (2 * self D exception_group_depth))
    D ExceptionPrintContext__emit = λ self, text_gen, margin_char . {
        T cond = → if margin_char == P → P margin_char = "|"
        P indent_str = self D indent(P)
        T cond = → if self D exception_group_depth → P indent_str = indent_str + (margin_char + " ")
        T cond = → if isinstance(text_gen, str) → → textwrap D indent(text_gen, indent_str, λ line . 1)
        → E P
            T loop = ∞ (
                P text = text_gen[_loop_index]
                → textwrap D indent(text, indent_str, λ line . 1)
            ) (D |text_gen|)
    }
D TracebackException = λ . P  // class
    // An exception ready for rendering.      The traceback module captures enough attributes from the original exception     t
    D TracebackException____init = λ self, exc_type, exc_value, exc_traceback . {
