D pprint_secs = λ secs . {
    // Format seconds in a human readable form.
    P now = time D time(P)
    P secs_ago = int((now - secs))
    P fmt = if secs_ago < ((60 * 60) * 24) → "%H:%M:%S" → E "%Y-%m-%d %H:%M:%S"
    → datetime D datetime D fromtimestamp(secs) D strftime(fmt)
}
