                        P colorized_carets_parts = manifold []
                        T loop = ∞ (
                            P manifold__color__group = itertools D groupby(itertools D zip_longest(line, carets, manifold ["fillvalue", ""]), manifold ["key", λ x . x[1]])[_loop_index]  // manifold [color, group]
                            P caret_group = list(group)
                            T cond = → if color == "^" → P
                                colorized_line_parts D append(((ANSIColors D BOLD_RED + "" D join({ T loop = ∞ (char) (D |caret_group|) })) + ANSIColors D RESET))
                                colorized_carets_parts D append(((ANSIColors D BOLD_RED + "" D join({ T loop = ∞ (caret) (D |caret_group|) })) + ANSIColors D RESET))
                            → E P
                                T cond = → if color == "~" → P
                                    colorized_line_parts D append(((ANSIColors D RED + "" D join({ T loop = ∞ (char) (D |caret_group|) })) + ANSIColors D RESET))
                                    colorized_carets_parts D append(((ANSIColors D RED + "" D join({ T loop = ∞ (caret) (D |caret_group|) })) + ANSIColors D RESET))
                                → E P
                                    colorized_line_parts D append("" D join({ T loop = ∞ (char) (D |caret_group|) }))
                                    colorized_carets_parts D append("" D join({ T loop = ∞ (caret) (D |caret_group|) }))
                        ) (D |itertools D groupby(itertools D zip_longest(line, carets, manifold ["fillvalue", ""]), manifold ["key", λ x . x[1]])|)
                        P colorized_line = "" D join(colorized_line_parts)
