            D self_D_exc_type_module = exc_type D __module__  // self D exc_type_module := exc_type D __module__
        → E P
            D self_D_exc_type_qualname = P  // self D exc_type_qualname := P
            D self_D_exc_type_module = P  // self D exc_type_module := P
