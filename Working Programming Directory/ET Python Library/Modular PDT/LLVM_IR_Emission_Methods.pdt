    L("  store i64 %cpos3, i64* %pos_ptr")
    L("  br label %skip_to_eol")
    L("emit_slash:")
    L("  ; Single slash = SLASH token")
    L("  %slash_s = " + G(empty_str_n, empty_str_nb))
    L("  %cnt_sl = load i32, i32* %cnt_ptr")
    L("  call void @etpl_tok_set(%ETToken* %toks, i32 %cnt_sl, i32 22, i8* %slash_s)")
    L("  %cnt_sl2 = add i32 %cnt_sl, 1")
    L("  store i32 %cnt_sl2, i32* %cnt_ptr")
    L("  %pos_sl = add i64 %pos, 1")
    L("  store i64 %pos_sl, i64* %pos_ptr")
