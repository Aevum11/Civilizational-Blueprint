@echo off
setlocal

:: ----------------------------------------------------
:: Exception Theory v7.5 - Final Installer
:: ----------------------------------------------------

echo [1/5] Checking Python...
python --version
if %errorlevel% neq 0 (
    echo ERROR: Python is not installed or not in PATH.
    pause
    exit /b 1
)

echo.
echo [2/5] Installing Core Math...
python -m pip install numpy>=1.20.0 scipy>=1.7.0
if %errorlevel% neq 0 goto :fail

echo.
echo [3/5] Installing Visualization and Astronomy...
python -m pip install matplotlib>=3.4.0 astropy>=5.0
if %errorlevel% neq 0 goto :fail

echo.
echo [4/5] Installing Data Handlers and Optionals...
python -m pip install netCDF4>=1.5.0 h5py>=3.0.0 fitsio>=1.1.0 joblib>=1.0.0
if %errorlevel% neq 0 goto :fail

echo.
echo [5/5] Verifying Installation...
python -c "import numpy; import scipy; import matplotlib; import astropy; import netCDF4; import h5py; import fitsio; import joblib; import tkinter; print('SUCCESS: All libraries verified.')"
if %errorlevel% neq 0 goto :fail

echo.
echo ----------------------------------------------------
echo INSTALLATION COMPLETE.
echo ----------------------------------------------------
pause
exit /b 0

:fail
echo.
echo !!!!!!! ERROR !!!!!!!
echo Installation failed.
pause
exit /b 1