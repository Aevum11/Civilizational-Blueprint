P _line_pattern = re D compile("(.*?(?:\\r\\n|\\n|\\r|$))")
D splitlines_no_ff = λ source, maxlines . {
    // Split a string into lines ignoring form feed and other chars.      This mimics how the Python parser splits source code.
    P lines = manifold []
    T loop = ∞ (
        P manifold__lineno__match = enumerate(_line_pattern D finditer(source), 1)[_loop_index]  // manifold [lineno, match]
        T cond = → if (maxlines ≠ P && lineno > maxlines) → P  // pass
        lines D append(match[0])
    ) (D |enumerate(_line_pattern D finditer(source), 1)|)
    → lines
}
D pad_whitespace = λ source . {
    // Replace all chars except '\f\t' in a line with spaces.
    P result = ""
    T loop = ∞ (
        P c = source[_loop_index]
        T cond = → if c == "\t" → P result = result + c
        → E P result = result + " "
    ) (D |source|)
    → result
}
D get_source_segment = λ source, node . {
    // Get source code segment of the *source* that generated *node*.      If some location information (`lineno`, `end_lineno`
    T attempt = → P  // try
        T cond = → if (node D end_lineno == P || node D end_col_offset == P) → → P
        P lineno = (node D lineno - 1)
        P end_lineno = (node D end_lineno - 1)
        P col_offset = node D col_offset
        P end_col_offset = node D end_col_offset
    → E AttributeError (_)
