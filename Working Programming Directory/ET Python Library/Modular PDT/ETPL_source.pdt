    }
    D ETPLCompiler___gen_sovereign_expr = λ self, node . {
        // Transpile ETPL AST expression to Python expression string.          ET Division (Eq 201): a/0 -> infinity (P-substrate d
        T cond = → if node == P → → "0"
        P nt = node D node_type
        T cond = → if nt == ASTNodeType D LITERAL_INT → → str(node D value)
        T cond = → if nt == ASTNodeType D LITERAL_FLOAT → → repr(node D value)
        T cond = → if nt == ASTNodeType D LITERAL_STRING → P
