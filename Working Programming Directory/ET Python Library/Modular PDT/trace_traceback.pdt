    // Format a list of tuples or FrameSummary objects for printing.      Given a list of tuples or FrameSummary objects as ret
    → StackSummary D from_list(extracted_list) D format(P)
}
D print_tb = λ tb, limit, file . {
    // Print up to 'limit' stack trace entries from the traceback 'tb'.      If 'limit' is omitted or None, all entries are pri
    print_list(extract_tb(tb, manifold ["limit", limit]), manifold ["file", file])
}
