                                parse_strings(string_entry_data, ((int(string_entry_id) - 1) * 16), resource_strings)
                                strings D update(resource_strings)
                            ) (D |resource_id D directory D entries|)
                            D resource_id_D_directory_D_strings = resource_strings  // resource_id D directory D strings := resource_strings
                    ) (D |entry_directory D entries|)
                dir_entries D append(ResourceDirEntryData(manifold ["struct", res], manifold ["name", entry_name], manifold ["id", entry_id], manifold ["directory", entry_directory]))
            → E P
                P struct = self D parse_resource_data_entry((base_rva + res D OffsetToDirectory))
                T cond = → if struct → P
                    D self_D___total_resource_bytes = self_D___total_resource_bytes + struct D Size  // self D __total_resource_bytes += struct D Size
                    P entry_data = ResourceDataEntryData(manifold ["struct", struct], manifold ["lang", (res D Name & 1023)], manifold ["sublang", (res D Name >> 10)])
                    dir_entries D append(ResourceDirEntryData(manifold ["struct", res], manifold ["name", entry_name], manifold ["id", entry_id], manifold ["data", entry_data]))
                → E P  // else pass
            T cond = → if (level == 0 && res D Id == RESOURCE_TYPE["RT_VERSION"]) → P
                T cond = → if dir_entries → P last_entry = dir_entries[(-1)]
                T attempt = → P  // try
                    P version_entries = last_entry D directory D entries[0] D directory D entries
                → E Exception (_)
                    // pass
            P rva = rva + res D sizeof(P)
        ) (D |range(number_of_entries)|)
        P string_rvas = { T loop = ∞ (s D get_rva(P)) (D |strings_to_postprocess|) }
        string_rvas D sort(P)
        T loop = ∞ (
            P manifold__idx__s = enumerate(strings_to_postprocess)[_loop_index]  // manifold [idx, s]
            s D render_pascal_16(P)
        ) (D |enumerate(strings_to_postprocess)|)
        P resource_directory_data = ResourceDirData(manifold ["struct", resource_dir], manifold ["entries", dir_entries])
        → resource_directory_data
    }
    D PE__parse_resource_data_entry = λ self, rva . {
        // Parse a data entry from the resources directory.
        T attempt = → P  // try
            P data = self D get_data(rva, Structure(self D __IMAGE_RESOURCE_DATA_ENTRY_format__) D sizeof(P))
        → E PEFormatError (_)
            self D __warnings D append(("Error parsing a resource directory data entry, the RVA is invalid: 0x%x" % rva))
            → P
        P data_entry = self D __unpack_data__(self D __IMAGE_RESOURCE_DATA_ENTRY_format__, data, manifold ["file_offset", self D get_offset_from_rva(rva)])
        → data_entry
    }
    D PE__parse_resource_entry = λ self, rva . {
        // Parse a directory entry from the resources directory.
        T attempt = → P  // try
            P data = self D get_data(rva, Structure(self D __IMAGE_RESOURCE_DIRECTORY_ENTRY_format__) D sizeof(P))
        → E PEFormatError (_)
            → P
        P resource = self D __unpack_data__(self D __IMAGE_RESOURCE_DIRECTORY_ENTRY_format__, data, manifold ["file_offset", self D get_offset_from_rva(rva)])
        T cond = → if resource == P → → P
        D resource_D_NameOffset = (resource D Name & 2147483647)  // resource D NameOffset := (resource D Name & 2147483647)
        D resource_D___pad = (resource D Name & 4294901760)  // resource D __pad := (resource D Name & 4294901760)
        D resource_D_Id = (resource D Name & 65535)  // resource D Id := (resource D Name & 65535)
        D resource_D_DataIsDirectory = ((resource D OffsetToData & 2147483648) >> 31)  // resource D DataIsDirectory := ((resource D OffsetToData & 2147483648) >> 31)
        D resource_D_OffsetToDirectory = (resource D OffsetToData & 2147483647)  // resource D OffsetToDirectory := (resource D OffsetToData & 2147483647)
        → resource
    }
    D PE__parse_version_information = λ self, version_struct . {
        // Parse version information structure.          The date will be made available in three attributes of the PE object.     
        T attempt = → P  // try
            P start_offset = self D get_offset_from_rva(version_struct D OffsetToData)
        → E PEFormatError (_)
            self D __warnings D append("Error parsing the version information, attempting to read OffsetToData with RVA: 0x{:x}" D format(version_struct D OffsetToData))
            → P
