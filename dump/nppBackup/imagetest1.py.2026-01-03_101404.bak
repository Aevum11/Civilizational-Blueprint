import tkinter as tk
from tkinter import filedialog, messagebox
import threading
import sys
import math

try:
    from PIL import Image, ImageTk, ImageDraw, ImageFilter, ImageEnhance, ImageChops
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: DENSITY SELECTION (MEDIAN UNBINDING)
# ==============================================================================

class ET_Median_Engine:
    def lift_layer_median(self, img_pil, mask_pil, texture_size, unbind_str, signal_gain, status_cb):
        """
        texture_size: Size of the Median Kernel (The 'Weave' size).
        unbind_str: How strictly to subtract the texture.
        signal_gain: Contrast boost for the deep layer.
        """
        width, height = img_pil.size
        
        # 1. GENERATE DENSITY MAP (The 'Clean' Base)
        # Median Filter replaces a pixel with the median of its neighbors.
        # This kills noise/texture but PRESERVES EDGES.
        # This is the key fix over V12's Gaussian Blur.
        
        status_cb("Calculating Descriptor Density (Median Separation)...")
        
        # Ensure odd size for kernel
        k_size = int(texture_size)
        if k_size % 2 == 0: k_size += 1
        
        # The Median Base (The Image WITHOUT the Texture)
        base_layer = img_pil.filter(ImageFilter.MedianFilter(size=k_size))
        
        # 2. ISOLATE THE VEIL (High Frequency)
        # Texture = Raw - Base
        # We calculate this difference to know exactly what to subtract.
        
        pixels = img_pil.load()
        base_pix = base_layer.load()
        mask = mask_pil.load()
        
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        min_x, min_y, max_x, max_y = bbox
        
        updates = []
        
        # Factors
        remove_factor = unbind_str / 100.0
        gain_factor = 1.0 + (signal_gain / 50.0)
        
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                if mask[x, y] == 0: continue
                
                # Raw (P)
                p = pixels[x, y]
                # Base (B) - The smooth shape
                b = base_pix[x, y]
                
                # Calculate the Texture (The Difference)
                # T = P - B
                tex_r = p[0] - b[0]
                tex_g = p[1] - b[1]
                tex_b = p[2] - b[2]
                
                # --- ET LOGIC: UNBINDING ---
                # We want to remove T from P.
                # If we just use B, it looks painted.
                # We want P - (T * Strength).
                
                # Subtract texture
                new_r = p[0] - (tex_r * remove_factor)
                new_g = p[1] - (tex_g * remove_factor)
                new_b = p[2] - (tex_b * remove_factor)
                
                # --- ET LOGIC: SIGNAL AMPLIFICATION ---
                # Now we boost the contrast of the result to see "through" the haze.
                # We center the boost around the Base (B) luminance to keep color accuracy.
                
                # Calculate local luminance of the base
                lum = (b[0] + b[1] + b[2]) / 3.0
                
                # Contrast Stretch centered on Lum
                final_r = (new_r - lum) * gain_factor + lum
                final_g = (new_g - lum) * gain_factor + lum
                final_b = (new_b - lum) * gain_factor + lum
                
                updates.append((x, y, (
                    int(max(0, min(255, final_r))),
                    int(max(0, min(255, final_g))),
                    int(max(0, min(255, final_b)))
                )))
        
        for ux, uy, uval in updates:
            pixels[ux, uy] = uval
            
        return img_pil

# ==============================================================================
# GUI
# ==============================================================================

class ET_V15_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V15: MEDIAN UNBINDER (DETAIL PRESERVER)")
        self.root.geometry("1200x900")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Median_Engine()
        self.pil_img = None
        self.mask_img = None
        self.backup_img = None
        
        self._layout()

    def _layout(self):
        t = tk.Frame(self.root, bg="#101010", pady=5)
        t.pack(fill=tk.X)
        
        self.btn(t, "LOAD IMAGE", self.load, "#004488")
        self.btn(t, "RESET", self.reset, "#882200")
        self.btn(t, "UNBIND TEXTURE", self.run, "#228822")
        
        # 1. TEXTURE SIZE (Kernel): Size of the weave/noise to remove
        tk.Label(t, text="WEAVE SIZE:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.sz_scale = tk.Scale(t, from_=1, to=15, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.sz_scale.set(3) # Default 3x3 kernel (Standard fabric weave)
        self.sz_scale.pack(side=tk.LEFT)
        
        # 2. UNBIND STRENGTH: How much texture to delete
        tk.Label(t, text="REMOVAL FORCE:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.rem_scale = tk.Scale(t, from_=0, to=150, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.rem_scale.set(100)
        self.rem_scale.pack(side=tk.LEFT)
        
        # 3. SIGNAL GAIN: Pop the details
        tk.Label(t, text="DEEP SIGNAL:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.gain_scale = tk.Scale(t, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.gain_scale.set(20)
        self.gain_scale.pack(side=tk.LEFT)

        self.stat = tk.Label(t, text="Ready.", fg="#888", bg="#101010")
        self.stat.pack(side=tk.RIGHT, padx=20)
        
        container = tk.Frame(self.root)
        container.pack(fill=tk.BOTH, expand=True)
        self.cv = tk.Canvas(container, bg="#080808", cursor="crosshair")
        vs = tk.Scrollbar(container, orient="vertical", command=self.cv.yview)
        hs = tk.Scrollbar(container, orient="horizontal", command=self.cv.xview)
        self.cv.config(yscrollcommand=vs.set, xscrollcommand=hs.set)
        
        vs.pack(side=tk.RIGHT, fill=tk.Y)
        hs.pack(side=tk.BOTTOM, fill=tk.X)
        self.cv.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.cv.bind("<Button-1>", self.down)
        self.cv.bind("<B1-Motion>", self.drag)
        self.cv.bind("<ButtonRelease-1>", self.up)
        
        self.drawing=False; self.brush=30

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", relief="flat", padx=10).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            self.pil_img = Image.open(path).convert("RGB")
            self.backup_img = self.pil_img.copy()
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            self.cv.config(scrollregion=(0,0,self.pil_img.width,self.pil_img.height))
            self.update_view()
            self.stat.config(text=f"Loaded: {self.pil_img.size}")
        except: pass

    def update_view(self):
        if not self.pil_img: return
        d = self.pil_img.copy()
        if self.mask_img.getbbox():
            r = Image.new("RGB", self.pil_img.size, (255,100,0)) # Orange mask
            d = Image.composite(r, d, self.mask_img)
        self.tk = ImageTk.PhotoImage(d)
        self.cv.create_image(0,0, image=self.tk, anchor=tk.NW)

    def down(self,e): 
        x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
        self.drawing=True; self.lp=(x,y)
        
    def drag(self,e):
        if self.drawing and self.mask_img:
            x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
            d = ImageDraw.Draw(self.mask_img)
            d.line([self.lp, (x,y)], fill=128, width=self.brush)
            d.ellipse([x-15,y-15,x+15,y+15], fill=128)
            self.lp=(x,y); 
            self.cv.create_line(self.lp[0],self.lp[1],x,y,fill="orange",width=self.brush,tags="t")

    def up(self,e): self.drawing=False; self.cv.delete("t"); self.update_view()
    
    def reset(self):
        if self.backup_img:
            self.pil_img = self.backup_img.copy()
            if self.mask_img: self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
            self.update_view()
            self.stat.config(text="Reset.")

    def run(self):
        if not self.pil_img: return
        self.stat.config(text="Processing Median Manifold...")
        sz = self.sz_scale.get()
        rem = self.rem_scale.get()
        gain = self.gain_scale.get()
        threading.Thread(target=self._w, args=(sz,rem,gain)).start()

    def _w(self, s, r, g):
        res = self.engine.lift_layer_median(self.pil_img, self.mask_img, s, r, g, self.log)
        self.pil_img = res
        self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
        self.root.after(0, self.update_view)
        self.root.after(0, lambda: self.stat.config(text="Unbinding Complete."))

    def log(self, m): self.stat.config(text=m)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_V15_GUI(root)
    root.mainloop()