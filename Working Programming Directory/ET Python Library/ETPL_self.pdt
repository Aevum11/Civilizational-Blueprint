        T cond = → if versioninfo_string == P → P
            self D __warnings D append("Invalid VS_VERSION_INFO block: {0}" D format(versioninfo_string))
            → P
        T cond = → if (versioninfo_string ≠ P && versioninfo_string ≠ b'VS_VERSION_INFO') → P
            T cond = → if len(versioninfo_string) > 128 → P
                P excerpt = versioninfo_string[0:128] D decode("ascii")
                P excerpt = excerpt[0:excerpt D rfind("\\u")]
                P versioninfo_string = "{0} ... ({1} bytes, too long to display)" D format(excerpt, len(versioninfo_string)) D encode(P)
            self D __warnings D append("Invalid VS_VERSION_INFO block: {0}" D format(versioninfo_string D decode("ascii") D replace("␀", "\\00")))
            → P
        T cond = → if (!hasattr(self, "VS_VERSIONINFO")) → D self_D_VS_VERSIONINFO = manifold []  // self D VS_VERSIONINFO := manifold []
        P vinfo = versioninfo_struct
        D vinfo_D_Key = versioninfo_string  // vinfo D Key := versioninfo_string
        self D VS_VERSIONINFO D append(vinfo)
        T cond = → if versioninfo_string == P → P versioninfo_string = ""
        P fixedfileinfo_offset = self D dword_align((versioninfo_struct D sizeof(P) + (2 * (len(versioninfo_string) + 1))), version_struct D OffsetToData)
        P fixedfileinfo_struct = self D __unpack_data__(self D __VS_FIXEDFILEINFO_format__, raw_data[fixedfileinfo_offset:Ω], manifold ["file_offset", (start_offset + fixedfileinfo_offset)])
        T cond = → if (!fixedfileinfo_struct) → → P
        T cond = → if (!hasattr(self, "VS_FIXEDFILEINFO")) → D self_D_VS_FIXEDFILEINFO = manifold []  // self D VS_FIXEDFILEINFO := manifold []
        self D VS_FIXEDFILEINFO D append(fixedfileinfo_struct)
        P stringfileinfo_offset = self D dword_align((fixedfileinfo_offset + fixedfileinfo_struct D sizeof(P)), version_struct D OffsetToData)
        T cond = → if (!hasattr(self, "FileInfo")) → D self_D_FileInfo = manifold []  // self D FileInfo := manifold []
        P finfo = manifold []
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P stringfileinfo_struct = self D __unpack_data__(self D __StringFileInfo_format__, raw_data[stringfileinfo_offset:Ω], manifold ["file_offset", (start_offset + stringfileinfo_offset)])
                T cond = → if stringfileinfo_struct == P → P
                    self D __warnings D append("Error parsing StringFileInfo/VarFileInfo struct")
                    → P
                P ustr_offset = ((version_struct D OffsetToData + stringfileinfo_offset) + versioninfo_struct D sizeof(P))
                T attempt = → P  // try
                    P stringfileinfo_string = self D get_string_u_at_rva(ustr_offset)
                → E PEFormatError (_)
                    self D __warnings D append("Error parsing the version information, attempting to read StringFileInfo string. Can't read unicode string at offset 0x{0:x}" D format(ustr_offset))
                    // break
