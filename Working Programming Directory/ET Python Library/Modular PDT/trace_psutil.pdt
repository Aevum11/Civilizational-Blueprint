    D Process__send_signal = λ self, sig . {
        // Send a signal *sig* to process pre-emptively checking         whether PID has been reused (see signal module constants) 
        T cond = → if POSIX → self D _send_signal(sig)
        → E P
            self D _raise_if_pid_reused(P)
