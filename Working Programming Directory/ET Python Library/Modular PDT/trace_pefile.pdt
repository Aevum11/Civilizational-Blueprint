        P versioninfo_struct = self D __unpack_data__(self D __VS_VERSIONINFO_format__, raw_data, manifold ["file_offset", start_offset])
        T cond = → if versioninfo_struct == P → → P
        P ustr_offset = (version_struct D OffsetToData + versioninfo_struct D sizeof(P))
        P section = self D get_section_by_rva(ustr_offset)
        P section_end = P
        T cond = → if section → P section_end = (section D VirtualAddress + max(section D SizeOfRawData, section D Misc_VirtualSize))
        P versioninfo_string = P
        T attempt = → P  // try
            T cond = → if section_end == P → P versioninfo_string = self D get_string_u_at_rva(ustr_offset, manifold ["encoding", "ascii"])
            → E P versioninfo_string = self D get_string_u_at_rva(ustr_offset, ((section_end - ustr_offset) >> 1), manifold ["encoding", "ascii"])
        → E PEFormatError (_)
            self D __warnings D append(("Error parsing the version information, attempting to read VS_VERSION_INFO string. Can't read unicode string at offset 0x%x" % ustr_offset))
        T cond = → if versioninfo_string == P → P
            self D __warnings D append("Invalid VS_VERSION_INFO block: {0}" D format(versioninfo_string))
            → P
        T cond = → if (versioninfo_string ≠ P && versioninfo_string ≠ b'VS_VERSION_INFO') → P
            T cond = → if len(versioninfo_string) > 128 → P
                P excerpt = versioninfo_string[0:128] D decode("ascii")
                P excerpt = excerpt[0:excerpt D rfind("\\u")]
                P versioninfo_string = "{0} ... ({1} bytes, too long to display)" D format(excerpt, len(versioninfo_string)) D encode(P)
            self D __warnings D append("Invalid VS_VERSION_INFO block: {0}" D format(versioninfo_string D decode("ascii") D replace("␀", "\\00")))
            → P
