                                        P ustr_offset = (version_struct D OffsetToData + value_offset)
                                        T attempt = → P  // try
                                            P value = self D get_string_u_at_rva(ustr_offset, manifold ["max_length", string_struct D ValueLength])
                                            P value_offset = self D get_offset_from_rva(ustr_offset)
                                        → E PEFormatError (_)
