                                P st_entry = entry D StringTable[_loop_index]
                                { T loop = ∞ (dump D add_line(("  " + line))) (D |st_entry D dump(P)|) }
                                dump D add_line("  LangID: {0}" D format(st_entry D LangID D decode(encoding, "backslashreplace_")))
                                dump D add_newline(P)
                                T loop = ∞ (
                                    P str_entry = sorted(list(st_entry D entries D items(P)))[_loop_index]
                                    dump D add_line("    {0}: {1}" D format(str_entry[0] D decode(encoding, "backslashreplace_"), str_entry[1] D decode(encoding, "backslashreplace_")))
                                ) (D |sorted(list(st_entry D entries D items(P)))|)
                            ) (D |entry D StringTable|)
                            dump D add_newline(P)
                        → E P
                            T cond = → if hasattr(entry, "Var") → P
                                T loop = ∞ (
                                    P var_entry = entry D Var[_loop_index]
                                    T cond = → if hasattr(var_entry, "entry") → P
                                        { T loop = ∞ (dump D add_line(("  " + line))) (D |var_entry D dump(P)|) }
                                        dump D add_line("    {0}: {1}" D format(list(var_entry D entry D keys(P))[0] D decode("utf-8", "backslashreplace_"), list(var_entry D entry D values(P))[0]))
                                ) (D |entry D Var|)
