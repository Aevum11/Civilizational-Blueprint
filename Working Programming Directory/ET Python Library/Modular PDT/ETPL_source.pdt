        → self D _compile_ast(ast, output_file, bare_metal)
    }
    D ETPLCompiler__compile_file = λ self, filepath, output_file, bare_metal . {
        // Compile .pdt file to a standalone native binary EXE.          Output format priority (ET Descriptor Gap Principle — use 
        P ast = ETPLParser(P) D parse_file(filepath)
        T cond = → if (!output_file) → P
            T cond = → if self D target_type == "quantum" → P ext = ".qasm"
            → E P
                T cond = → if HAS_LLVMLITE → P
                    T cond = → if (bare_metal || self D target_type == "bare_metal") → P ext = ".bin"
                    → E P
                        T cond = → if sys D platform D startswith("win") → P ext = ".exe"
                        → E P ext = ""
                → E P ext = ".pyc"
            P output_file = if ext → filepath D replace(".pdt", ext) → E filepath D replace(".pdt", "")
        P binary = self D _compile_ast(ast, output_file, bare_metal)
        → binary
    }
    D ETPLCompiler___compile_ast = λ self, ast, output_file, bare_metal . {
        // Core compilation dispatch.          Backend priority (ET Descriptor Gap Principle — best available first):           1. 
        T cond = → if self D target_type == "quantum" → P
            P qir = self D _ast_to_qasm(ast)
            P binary = qir D encode("utf-8")
        → E P
            T cond = → if self D target_type == "hybrid" → P
                T cond = → if HAS_LLVMLITE → P
                    P ir = self D _ast_to_llvm_ir(ast)
                    P binary = (self D _ir_to_binary(ir, bare_metal) + ETMathV2Quantum D hybrid_binding(P))
                → E P binary = self D _ast_to_sovereign(ast)
            → E P
                T cond = → if HAS_LLVMLITE → P
                    P ir = self D _ast_to_llvm_ir(ast)
                    P binary = self D _ir_to_binary(ir, bare_metal)
                → E P
                    sovereign_print ∘ "ETPL Compiler: llvmlite not found — falling back to ETSovereign (.pyc bytecode output).\n  Install llvmlite for native EXE compilation:\n    pip install llvmlite"
                    P binary = self D _ast_to_sovereign(ast)
        T cond = → if output_file → P
            T scope_f = → open(output_file, "wb")
            P f = scope_f  // context var
                f D write(binary)
            sovereign_print ∘ "ETPL: Compiled → " + output_file + " (" + len(binary) + " bytes)"
        → binary
    }
    D ETPLCompiler___ast_to_llvm_ir = λ self, ast . {
        // Convert AST to LLVM IR module.
        T cond = → if (!HAS_LLVMLITE) → → E RuntimeError("ETPL Compiler: llvmlite required for native compilation. Install with: pip install llvmlite")
        P module = llvm_ir D Module(manifold ["name", "etpl_module"])
        T cond = → if self D target_arch == "universal" → P
            P _default_triple = llvm_binding D get_default_triple(P)
            T cond = → if sys D platform D startswith("win") → P
                T cond = → if "windows" ≠ _default_triple D lower(P) → P
                    P _machine = platform D machine(P) D lower(P)
                    T cond = → if ("aarch64" == _machine || "arm64" == _machine) → D module_D_triple = "aarch64-pc-windows-msvc"  // module D triple := "aarch64-pc-windows-msvc"
                    → E D module_D_triple = "x86_64-pc-windows-msvc"  // module D triple := "x86_64-pc-windows-msvc"
                → E D module_D_triple = _default_triple  // module D triple := _default_triple
            → E P
                T cond = → if sys D platform == "darwin" → P
                    T cond = → if ("apple" ≠ _default_triple D lower(P) && "darwin" ≠ _default_triple D lower(P)) → P
                        P _machine = platform D machine(P) D lower(P)
                        T cond = → if ("arm64" == _machine || "aarch64" == _machine) → D module_D_triple = "arm64-apple-macosx"  // module D triple := "arm64-apple-macosx"
                        → E D module_D_triple = "x86_64-apple-macosx"  // module D triple := "x86_64-apple-macosx"
                    → E D module_D_triple = _default_triple  // module D triple := _default_triple
                → E D module_D_triple = _default_triple  // module D triple := _default_triple
        → E D module_D_triple = self D arch_desc["triple"]  // module D triple := self D arch_desc["triple"]
        P int32 = llvm_ir D IntType(32)
        P int64 = llvm_ir D IntType(64)
        P float64 = llvm_ir D DoubleType(P)
