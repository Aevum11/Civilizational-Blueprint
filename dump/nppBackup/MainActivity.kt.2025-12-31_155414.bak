import java.util.Date
import java.util.Locale
import java.util.concurrent.ExecutorService
import java.util.concurrent.Executors
import android.content.ContentValues

class MainActivity : AppCompatActivity() {

    private var serviceBinder: OmniMeasureService? = null
    private var isBound = false
    private lateinit var prefs: SharedPreferences
    private lateinit var securePrefs: SharedPreferences

    private lateinit var visualizer: VisualizerView
    private lateinit var spinnerMode: Spinner
    private lateinit var txtModeHelp: TextView
    private lateinit var txtValues: TextView
    private lateinit var txtStats: TextView
    private lateinit var txtBattery: TextView
    private lateinit var txtOffline: TextView
    private lateinit var btnStart: Button
    private lateinit var btnStop: Button
    private lateinit var btnCalibrate: Button
    private lateinit var btnReport: Button
    private lateinit var btnAbout: Button
    private lateinit var btnGpsToggle: ToggleButton
    private lateinit var btnGraphToggle: ToggleButton
    private lateinit var btnRecToggle: ToggleButton
    private lateinit var btnBaseline: Button
    private lateinit var btnAlarms: Button
    private lateinit var btnSpectrogram: ToggleButton // New
    private lateinit var progressBar: ProgressBar
    
    // Camera
    private lateinit var viewFinder: PreviewView
    private lateinit var btnCameraToggle: Button
    private lateinit var btnCapture: Button
    private lateinit var cameraContainer: FrameLayout
    private var imageCapture: ImageCapture? = null
    private lateinit var cameraExecutor: ExecutorService
    private var isCameraActive = false

    private val BUILD_DATE = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
    private val APP_VERSION = "16.0-Universal"

    private val handler = Handler(Looper.getMainLooper())
    private val updateRunnable = object : Runnable {
        override fun run() { updateUI(); handler.postDelayed(this, 100) }
    }

    private val connection = object : ServiceConnection {
        override fun onServiceConnected(className: ComponentName, service: IBinder) {
            val binder = service as OmniMeasureService.LocalBinder
            serviceBinder = binder.getService()
            isBound = true
            if (serviceBinder?.currentMode != null) spinnerMode.setSelection(serviceBinder!!.currentMode.ordinal)
            btnGpsToggle.isChecked = serviceBinder?.isGpsEnabled ?: false
            btnRecToggle.isChecked = serviceBinder?.isRecordingAudio ?: false
            if (serviceBinder?.hasBaseline == true) btnBaseline.text = "Reset Base" else btnBaseline.text = "Set Baseline"
        }
        override fun onServiceDisconnected(arg0: ComponentName) { isBound = false; serviceBinder = null }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)
        prefs = getSharedPreferences("ET_Prefs", Context.MODE_PRIVATE)
        try {
            val masterKey = MasterKey.Builder(this).setKeyScheme(MasterKey.KeyScheme.AES256_GCM).build()
            securePrefs = EncryptedSharedPreferences.create(this, "ET_Secure_Prefs", masterKey, EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV, EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM)
        } catch (e: Exception) { securePrefs = getSharedPreferences("ET_Secure_Prefs_Fallback", Context.MODE_PRIVATE) }

        visualizer = findViewById(R.id.visualizer)
        spinnerMode = findViewById(R.id.spinnerMode)
        txtModeHelp = findViewById(R.id.txtModeHelp)
        txtValues = findViewById(R.id.txtValues)
        txtStats = findViewById(R.id.txtStats)
        txtBattery = findViewById(R.id.txtBattery)
        txtOffline = findViewById(R.id.txtOffline)
        btnStart = findViewById(R.id.btnStart)
        btnStop = findViewById(R.id.btnStop)
        btnCalibrate = findViewById(R.id.btnCalibrate)
        btnReport = findViewById(R.id.btnReport)
        btnAbout = findViewById(R.id.btnAbout)
        btnGpsToggle = findViewById(R.id.btnGpsToggle)
        btnGraphToggle = findViewById(R.id.btnGraphToggle)
        btnRecToggle = findViewById(R.id.btnRecToggle)
        btnBaseline = findViewById(R.id.btnBaseline)
        btnAlarms = findViewById(R.id.btnAlarms)
        btnSpectrogram = findViewById(R.id.btnSpectrogram) // Bind
        progressBar = findViewById(R.id.progressBar)
        
        // Camera
        viewFinder = findViewById(R.id.viewFinder)
        cameraContainer = findViewById(R.id.cameraContainer)
        btnCameraToggle = findViewById(R.id.btnCameraToggle)
        btnCapture = findViewById(R.id.btnCapture)
        cameraExecutor = Executors.newSingleThreadExecutor()

        setupSpinner(); checkPermissions(); checkBatteryOptimization(); setupNetworkMonitor()

        btnStart.setOnClickListener { val mode = OmniMeasureService.ScanMode.values()[spinnerMode.selectedItemPosition]; val intent = Intent(this, OmniMeasureService::class.java); startService(intent); bindService(intent, connection, Context.BIND_AUTO_CREATE); if(isBound) serviceBinder?.startMeasurement(mode) }
        btnStop.setOnClickListener { serviceBinder?.stopMeasurement(); if (isBound) { unbindService(connection); isBound = false; serviceBinder = null }; handler.removeCallbacks(updateRunnable) }
        btnCalibrate.setOnClickListener { showCalibrationDialog() }
        btnCalibrate.setOnLongClickListener { serviceBinder?.tareAltitude(); Toast.makeText(this, "Altitude Tared", Toast.LENGTH_SHORT).show(); true }
        btnReport.setOnClickListener { checkPrivacyAndShowReport() }
        btnAbout.setOnClickListener { showAboutDialog() }
        btnGpsToggle.setOnClickListener { if (btnGpsToggle.isChecked) { btnGpsToggle.isChecked = false; showGpsConsentDialog() } else { serviceBinder?.setGpsEnabled(false) } }
        
        btnGraphToggle.setOnClickListener { 
            if (btnGraphToggle.isChecked) { 
                btnSpectrogram.isChecked = false // Mutually exclusive
                val trend = serviceBinder?.getTrendHistory(); if (trend != null && trend.isNotEmpty()) visualizer.setTrendData(trend) else { Toast.makeText(this, "No trend data yet.", Toast.LENGTH_SHORT).show(); btnGraphToggle.isChecked = false } 
            } else { visualizer.setLiveMode() } 
        }
        
        btnSpectrogram.setOnClickListener {
            if (btnSpectrogram.isChecked) {
                btnGraphToggle.isChecked = false
                visualizer.setSpectrumMode()
            } else {
                visualizer.setLiveMode()
            }
        }
        
        btnRecToggle.setOnClickListener { serviceBinder?.setAudioRecordingEnabled(btnRecToggle.isChecked); if (btnRecToggle.isChecked) Toast.makeText(this, "Recording Audio (WAV)...", Toast.LENGTH_SHORT).show() }
        btnBaseline.setOnClickListener { if (serviceBinder?.hasBaseline == true) { serviceBinder?.clearBaseline(); btnBaseline.text = "Set Baseline"; Toast.makeText(this, "Baseline Cleared", Toast.LENGTH_SHORT).show() } else { serviceBinder?.captureBaseline(); btnBaseline.text = "Reset Base"; Toast.makeText(this, "Baseline Captured", Toast.LENGTH_SHORT).show() } }
        btnAlarms.setOnClickListener { showAlarmDialog() }
        
        btnCameraToggle.setOnClickListener { if (isCameraActive) stopCamera() else startCamera() }
        btnCapture.setOnClickListener { takePhoto() }
        
        handler.post(updateRunnable)
    }
    
    // --- CAMERA LOGIC ---
    private fun startCamera() {
        if (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) { ActivityCompat.requestPermissions(this, arrayOf(Manifest.permission.CAMERA), 101); return }
        cameraContainer.visibility = View.VISIBLE; visualizer.visibility = View.GONE; isCameraActive = true; btnCameraToggle.text = "Hide Cam"
        val cameraProviderFuture = ProcessCameraProvider.getInstance(this)
        cameraProviderFuture.addListener({
            val cameraProvider = cameraProviderFuture.get(); val preview = Preview.Builder().build().also { it.setSurfaceProvider(viewFinder.surfaceProvider) }; imageCapture = ImageCapture.Builder().build(); val cameraSelector = CameraSelector.DEFAULT_BACK_CAMERA
            try { cameraProvider.unbindAll(); cameraProvider.bindToLifecycle(this, cameraSelector, preview, imageCapture) } catch(exc: Exception) {}
        }, ContextCompat.getMainExecutor(this))
    }
    private fun stopCamera() { cameraContainer.visibility = View.GONE; visualizer.visibility = View.VISIBLE; isCameraActive = false; btnCameraToggle.text = "Camera"; val cameraProviderFuture = ProcessCameraProvider.getInstance(this); cameraProviderFuture.addListener({ cameraProviderFuture.get().unbindAll() }, ContextCompat.getMainExecutor(this)) }
    private fun takePhoto() {
        val imageCapture = imageCapture ?: return
        val photoFile = File(externalCacheDir, "ET_Temp_${System.currentTimeMillis()}.jpg")
        val outputOptions = ImageCapture.OutputFileOptions.Builder(photoFile).build()
        imageCapture.takePicture(outputOptions, ContextCompat.getMainExecutor(this), object : ImageCapture.OnImageSavedCallback { override fun onError(exc: ImageCaptureException) { Toast.makeText(baseContext, "Photo Failed", Toast.LENGTH_SHORT).show() }; override fun onImageSaved(output: ImageCapture.OutputFileResults) { processAndSaveImage(photoFile) } })
    }
    private fun processAndSaveImage(tempFile: File) {
        thread {
            try {
                val originalBitmap = BitmapFactory.decodeFile(tempFile.absolutePath); val overlayBitmap = originalBitmap.copy(Bitmap.Config.ARGB_8888, true); val canvas = Canvas(overlayBitmap); val paint = Paint()
                paint.color = Color.parseColor("#99000000"); paint.style = Paint.Style.FILL; val h = overlayBitmap.height; val w = overlayBitmap.width; canvas.drawRect(0f, h * 0.75f, w.toFloat(), h.toFloat(), paint)
                paint.color = Color.GREEN; paint.textSize = h * 0.03f; paint.isAntiAlias = true; paint.typeface = Typeface.MONOSPACE
                val result = serviceBinder?.lastResult; val dateStr = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date())
                val line1 = "ET EVIDENCE CAM | $dateStr"; var line2 = "Waiting..."; var line3 = "..."
                if (result != null) { line2 = "SPL: %.1fdB | Vib: %.3f | Lux: %.0f".format(result.correctedSPL, result.rmsVibration, result.illuminanceLux); line3 = "Loc: ${result.isoZone} | Hz: %.1f | P: %.1fhPa".format(result.realHz, result.pressureHpa) }
                val x = w * 0.05f; var y = h * 0.79f; canvas.drawText(line1, x, y, paint); y += paint.textSize * 1.5f; canvas.drawText(line2, x, y, paint); y += paint.textSize * 1.5f; canvas.drawText(line3, x, y, paint)
                val filename = "ET_Evid_${System.currentTimeMillis()}.jpg"; val contentValues = ContentValues().apply { put(MediaStore.MediaColumns.DISPLAY_NAME, filename); put(MediaStore.MediaColumns.MIME_TYPE, "image/jpeg"); if (Build.VERSION.SDK_INT > Build.VERSION_CODES.P) put(MediaStore.Images.Media.RELATIVE_PATH, "Pictures/ET_Evidence") }
                val uri = contentResolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, contentValues)
                if (uri != null) { val outStream = contentResolver.openOutputStream(uri); overlayBitmap.compress(Bitmap.CompressFormat.JPEG, 95, outStream!!); outStream.close(); runOnUiThread { Toast.makeText(this, "Saved: $filename", Toast.LENGTH_LONG).show() } }
                tempFile.delete(); originalBitmap.recycle(); overlayBitmap.recycle()
            } catch (e: Exception) { e.printStackTrace() }
        }
    }

    // --- ALARMS ---
    private fun showAlarmDialog() {
        val layout = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(50, 40, 50, 10) }
        val inVib = EditText(this).apply { hint = "Max Vib (mm/s)"; inputType = 8194 }; val inSpl = EditText(this).apply { hint = "Max SPL (dB)"; inputType = 8194 }; val inTemp = EditText(this).apply { hint = "Max Temp (°C)"; inputType = 8194 }
        val curr = serviceBinder?.activeAlarmConfig
        if (curr != null) { if (curr.maxVelocity != null) inVib.setText(curr.maxVelocity.toString()); if (curr.maxSpl != null) inSpl.setText(curr.maxSpl.toString()); if (curr.maxTemp != null) inTemp.setText(curr.maxTemp.toString()) }
        layout.addView(inVib); layout.addView(inSpl); layout.addView(inTemp)
        AlertDialog.Builder(this).setTitle("Set Sentinel Alarms").setView(layout)
            .setPositiveButton("Set") { _, _ -> serviceBinder?.setAlarmConfig(OmniTraverserEngine.AlarmConfig(maxVelocity = inVib.text.toString().toDoubleOrNull(), maxSpl = inSpl.text.toString().toDoubleOrNull(), maxTemp = inTemp.text.toString().toDoubleOrNull())); Toast.makeText(this, "Alarms Active", Toast.LENGTH_SHORT).show() }
            .setNeutralButton("Clear") { _, _ -> serviceBinder?.setAlarmConfig(null); Toast.makeText(this, "Alarms Cleared", Toast.LENGTH_SHORT).show() }.setNegativeButton("Cancel", null).show()
    }
    
    // --- EXPORT ---
    private fun showReportDialog() {
        val layout = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(50, 40, 50, 10) }
        val inputIp = EditText(this).apply { hint = "Server URL (https://...)"; setText(prefs.getString("server_ip", "")) }
        val inputKey = EditText(this).apply { hint = "API Token"; setText(securePrefs.getString("api_key", "")) }
        val inputDesc = EditText(this).apply { hint = "Description..."; minLines = 3 }
        layout.addView(inputIp); layout.addView(inputKey); layout.addView(inputDesc)
        AlertDialog.Builder(this).setTitle("Export Data").setView(layout)
            .setPositiveButton("PDF Report") { _, _ -> val pdf = serviceBinder?.generatePdfReport(this); if (pdf != null) { val uri = FileProvider.getUriForFile(this, "${packageName}.provider", pdf); startActivity(Intent(Intent.ACTION_SEND).apply { type = "application/pdf"; putExtra(Intent.EXTRA_STREAM, uri); addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION) }) } }
            .setNeutralButton("Upload ZIP") { _, _ -> prefs.edit().putString("server_ip", inputIp.text.toString()).apply(); securePrefs.edit().putString("api_key", inputKey.text.toString()).apply(); val zipFile = serviceBinder?.getLogZip(this); if (zipFile != null) queueZipReport(zipFile, inputDesc.text.toString()) }
            .setNegativeButton("Share CSV") { _, _ -> val csvFile = serviceBinder?.getLogCsv(this); if (csvFile != null) { val uri = FileProvider.getUriForFile(this, "${packageName}.provider", csvFile); startActivity(Intent(Intent.ACTION_SEND).apply { type = "text/csv"; putExtra(Intent.EXTRA_STREAM, uri); addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION) }) } }.show()
    }

    private fun showGpsConsentDialog() { AlertDialog.Builder(this).setTitle("Enable GPS?").setMessage("Local storage only.").setPositiveButton("Enable") { _, _ -> if (ContextCompat.checkSelfPermission(this, Manifest.permission.ACCESS_FINE_LOCATION) != PackageManager.PERMISSION_GRANTED) ActivityCompat.requestPermissions(this, arrayOf(Manifest.permission.ACCESS_FINE_LOCATION), 102) else { serviceBinder?.setGpsEnabled(true); btnGpsToggle.isChecked = true } }.setNegativeButton("Cancel", null).show() }
    override fun onRequestPermissionsResult(requestCode: Int, permissions: Array<out String>, grantResults: IntArray) { super.onRequestPermissionsResult(requestCode, permissions, grantResults); if (requestCode == 102 && grantResults.isNotEmpty() && grantResults[0] == PackageManager.PERMISSION_GRANTED) { serviceBinder?.setGpsEnabled(true); btnGpsToggle.isChecked = true } }
    override fun onStart() { super.onStart(); val intent = Intent(this, OmniMeasureService::class.java); bindService(intent, connection, Context.BIND_AUTO_CREATE) }
    override fun onStop() { super.onStop(); if (isBound) { unbindService(connection); isBound = false }; if (isCameraActive) stopCamera(); cameraExecutor.shutdown() }
    private fun checkBatteryOptimization() { val pm = getSystemService(Context.POWER_SERVICE) as PowerManager; if (!pm.isIgnoringBatteryOptimizations(packageName) && !prefs.getBoolean("ignore_battery_warning", false)) AlertDialog.Builder(this).setTitle("Battery Opt").setMessage("Disable for background?").setPositiveButton("Settings") { _, _ -> try{startActivity(Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS).apply{data=Uri.parse("package:$packageName")})}catch(e:Exception){} }.setNegativeButton("Ignore"){_,_->prefs.edit().putBoolean("ignore_battery_warning",true).apply()}.show() }
    private fun setupSpinner() { val modes = OmniMeasureService.ScanMode.values().map { it.name.replace("_", " ") }; val adapter = ArrayAdapter(this, android.R.layout.simple_spinner_item, modes); adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item); spinnerMode.adapter = adapter }
    private val sbValues = StringBuilder(); private val sbStats = StringBuilder()
    
    private fun updateUI() {
        if (isBound && serviceBinder != null) {
             val result = serviceBinder?.lastResult
             // Modes
             visualizer.setBaselines(serviceBinder?.baselineVib, serviceBinder?.baselineSpl)
             if (visualizer.showTrendMode && System.currentTimeMillis() % 1000 < 200) { val trend = serviceBinder?.getTrendHistory(); if(trend != null) visualizer.setTrendData(trend) }

             if (result != null) {
                sbValues.setLength(0)
                if (result.gpsLat != null) sbValues.append("GPS: ").append(String.format("%.5f, %.5f", result.gpsLat, result.gpsLon)).append("\n")
                else sbValues.append("Hdg: ").append(String.format("%.0f°", result.azimuth)).append("\n")
                
                if (result.alarmBreached) { txtValues.setBackgroundColor(Color.RED); txtValues.setTextColor(Color.WHITE) } else { txtValues.setBackgroundColor(Color.TRANSPARENT); txtValues.setTextColor(Color.parseColor("#00FF00")) }
                sbValues.append("Vel: ").append(String.format("%.2f", result.velocityRms)).append(" mm/s | SPL: ").append(String.format("%.1f", result.correctedSPL))
                txtValues.text = sbValues.toString()

                sbStats.setLength(0)
                sbStats.append("Diag: ").append(result.mechSource).append(" (Conf: ").append(String.format("%.0f%%", result.diagnosisConfidence * 100)).append(")\n")
                val tempStr = if (result.ambientTempC != null) String.format("%.1f°C", result.ambientTempC) else "N/A"
                sbStats.append("Amb: ").append(tempStr).append(" (").append(result.thermalState).append(") | Pk: ").append(String.format("%.0f", result.dominantFreq)).append("Hz ").append(result.freqLabel).append("\n")
                sbStats.append("Lux: ").append(String.format("%.0f", result.illuminanceLux)).append(" (").append(result.lightSource).append(")")
                if(btnRecToggle.isChecked) sbStats.append(" [REC]")
                txtStats.text = sbStats.toString()

                if (visualizer.currentMode != VisualizerView.ViewMode.TREND) {
                    visualizer.update(result.preciseTilt[0], result.preciseTilt[1], result.rmsVibration, result.correctedSPL, result.illuminanceLux, result.azimuth, result.pressureHpa, result.ambientTempC, result.fftMagnitudes)
                }
                
                val drain = serviceBinder?.batteryDrainRate ?: 0.0
                val dur = serviceBinder?.getDurationString() ?: "00:00"
                txtBattery.text = "$dur | -%.2f%%/hr".format(drain)
             }
        }
    }

    private fun checkPrivacyAndShowReport() { if (!prefs.getBoolean("privacy_opt_in", false)) showPrivacyConsentDialog() else showReportDialog() }
    private fun showPrivacyConsentDialog() { AlertDialog.Builder(this).setTitle("Privacy").setMessage("Upload? (Opt-In)").setPositiveButton("Enable") { _, _ -> prefs.edit().putBoolean("privacy_opt_in", true).apply(); showReportDialog() }.setNegativeButton("Cancel", null).show() }
    private fun queueZipReport(zipFile: File, description: String) { serviceBinder?.flushPendingReports(this) }
    private fun setupNetworkMonitor() {} 
    private fun showAboutDialog() { AlertDialog.Builder(this).setTitle("ET Physics Toolbox").setMessage("v$APP_VERSION ($BUILD_DATE)\nEngine: OmniTraverser v16.0\nDevice: ${android.os.Build.MODEL}").setPositiveButton("OK", null).show() }
    private fun showCalibrationDialog() { AlertDialog.Builder(this).setTitle("Calibrate").setPositiveButton("OK") { _, _ -> serviceBinder?.runCalibration() }.show() }
    private fun checkPermissions() { ActivityCompat.requestPermissions(this, arrayOf(Manifest.permission.RECORD_AUDIO, Manifest.permission.FOREGROUND_SERVICE, Manifest.permission.INTERNET, Manifest.permission.ACCESS_NETWORK_STATE, Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.CAMERA, Manifest.permission.WRITE_EXTERNAL_STORAGE), 1) }
}