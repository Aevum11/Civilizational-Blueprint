    L("  store i64 %pos_ee, i64* %pos_ptr")
    L("  br label %scan_loop")
    L("")
    L("chk_ne:")
    L("  %is_bang = icmp eq i8 %ch, 33")
    L("  %is_ne = and i1 %is_bang, %is_eq2")
    L("  br i1 %is_ne, label %emit_ne, label %chk_le")
    L("emit_ne:")
