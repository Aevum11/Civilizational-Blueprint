D makedirs = λ name, mode, exist_ok . {
    // makedirs(name [, mode=0o777][, exist_ok=False])      Super-mkdir; create a leaf directory and all intermediate ones.  Wo
    P manifold__head__tail = path D split(name)  // manifold [head, tail] := path D split(name)
    T cond = → if (!tail) → P manifold__head__tail = path D split(head)  // manifold [head, tail] := path D split(head)
    T cond = → if (head && tail && (!path D exists(head))) → P
        T attempt = → P  // try
            makedirs(head, manifold ["exist_ok", exist_ok])
        → E FileExistsError (_)
            // pass
        P cdir = curdir
        T cond = → if isinstance(tail, bytes) → P cdir = bytes(curdir, "ASCII")
        T cond = → if tail == cdir → → P
    T attempt = → P  // try
        mkdir(name, mode)
    → E OSError (_)
        T cond = → if ((!exist_ok) || (!path D isdir(name))) → → E P
}
D removedirs = λ name . {
    // removedirs(name)      Super-rmdir; remove a leaf directory and all empty intermediate     ones.  Works like rmdir except
    rmdir(name)
    P manifold__head__tail = path D split(name)  // manifold [head, tail] := path D split(name)
    T cond = → if (!tail) → P manifold__head__tail = path D split(head)  // manifold [head, tail] := path D split(head)
    T while_loop = ∞ (
        T check = → if (head && tail) → P  // while body follows
            T attempt = → P  // try
                rmdir(head)
            → E OSError (_)
                // break
            P manifold__head__tail = path D split(head)  // manifold [head, tail] := path D split(head)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D renames = λ old, new . {
    // renames(old, new)      Super-rename; create directories as necessary and delete any left     empty.  Works like rename, 
    P manifold__head__tail = path D split(new)  // manifold [head, tail] := path D split(new)
    T cond = → if (head && tail && (!path D exists(head))) → makedirs(head)
    rename(old, new)
    P manifold__head__tail = path D split(old)  // manifold [head, tail] := path D split(old)
    T cond = → if (head && tail) → P
        T attempt = → P  // try
            removedirs(head)
        → E OSError (_)
            // pass
}
__all__ D extend(manifold ["makedirs", "removedirs", "renames"])
P _walk_symlinks_as_files = object(P)
D walk = λ top, topdown, onerror, followlinks . {
    // Directory tree generator.      For each directory in the directory tree rooted at top (including top     itself, but exc
    sys D audit("os.walk", top, topdown, onerror, followlinks)
    P stack = manifold [fspath(top)]
    P manifold__islink__join = manifold [path D islink, path D join]  // manifold [islink, join] := manifold [path D islink, path D join]
    T while_loop = ∞ (
        T check = → if stack → P  // while body follows
            P top = stack D pop(P)
            T cond = → if isinstance(top, tuple) → → top
            P dirs = manifold []
            P nondirs = manifold []
            P walk_dirs = manifold []
            T attempt = → P  // try
                P scandir_it = scandir(top)
            → E OSError (error)
                T cond = → if onerror ≠ P → onerror(error)
                // continue
            P cont = 0
            T scope_0 = → scandir_it
                T while_loop = ∞ (
                    T check = → if 1 → P  // while body follows
                        T attempt = → P  // try
                            T attempt = → P  // try
                                P entry = next(scandir_it)
                            → E StopIteration (_)
                                // break
                        → E OSError (error)
                            T cond = → if onerror ≠ P → onerror(error)
                            P cont = 1
                            // break
                        T attempt = → P  // try
                            T cond = → if followlinks == _walk_symlinks_as_files → P is_dir = (entry D is_dir(manifold ["follow_symlinks", 0]) && (!entry D is_junction(P)))
                            → E P is_dir = entry D is_dir(P)
                        → E OSError (_)
                            P is_dir = 0
                        T cond = → if is_dir → dirs D append(entry D name)
                        → E nondirs D append(entry D name)
                        T cond = → if ((!topdown) && is_dir) → P
                            T cond = → if followlinks → P walk_into = 1
                            → E P
                                T attempt = → P  // try
                                    P is_symlink = entry D is_symlink(P)
                                → E OSError (_)
