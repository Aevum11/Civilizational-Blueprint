            P escaped = str(val) D replace("\\\\", "\\\\\\\\") D replace("'", "\\'")
            → "'" + escaped + "'"
        T cond = → if nt == manifold [ASTNodeType D LITERAL_INFINITY, ASTNodeType D LITERAL_OMEGA] → → "float(\"inf\")"
        T cond = → if nt == ASTNodeType D IDENTIFIER → P
            P name = (node D value || node D name)
            → str(name)
        T cond = → if nt == ASTNodeType D MATH_OP → P
            P left = self D _gen_sovereign_expr(node D left)
            P right = self D _gen_sovereign_expr(node D right)
            P op = node D op
            T cond = → if op == "/" → → "((" + left + " / " + right + ") if " + right + " != 0 else (0.0 if " + left + " == 0 else float(\"inf\") * (1 if " + left + " > 0 else -1)))"
            T cond = → if op == "%" → → "((" + left + " % " + right + ") if " + right + " != 0 else 0)"
            T cond = → if op == "//" → → "(int(" + left + ") // int(" + right + ") if " + right + " != 0 else 0)"
            T cond = → if op == "^" → → "(" + left + " ** " + right + ")"
            → "(" + left + " " + op + " " + right + ")"
        T cond = → if nt == ASTNodeType D UNARY_OP → P
            P operand = self D _gen_sovereign_expr(node D body)
            P op = node D op
            T cond = → if op == "-" → → "(-" + operand + ")"
            T cond = → if op == "√" → → "_et_sqrt(" + operand + ")"
            T cond = → if op == manifold ["sin", "cos", "tan", "log", "exp"] → → "_et_" + op + "(" + operand + ")"
            T cond = → if op == manifold ["abs", "|...|"] → → "abs(" + operand + ")"
            T cond = → if op == manifold ["∑", "∏"] → → operand
            → operand
        T cond = → if nt == ASTNodeType D COMPARISON → P
            P left = self D _gen_sovereign_expr(node D left)
            P right = self D _gen_sovereign_expr(node D right)
            P op_map = manifold [manifold ["<", "<"], manifold [">", ">"], manifold ["<=", "<="], manifold [">=", ">="], manifold ["==", "=="], manifold ["=", "=="], manifold ["!=", "!="], manifold ["≤", "<="], manifold ["≥", ">="], manifold ["≠", "!="], manifold ["≈", "=="]]
            P py_op = op_map D get(node D op, "==")
            → "(" + left + " " + py_op + " " + right + ")"
        T cond = → if nt == ASTNodeType D LOGICAL_OP → P
            T cond = → if node D op == "!" → P
