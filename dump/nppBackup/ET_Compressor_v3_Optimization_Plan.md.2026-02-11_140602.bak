### 4.3 — Section 7: LZ77 with memoryview Match Extension

**Requires: Eq 236 (Sovereign Match Extension Velocity)**

Key changes:
1. Use `memoryview` for zero-copy match comparison
2. Use `data.find()` (C-backed) for initial trigram matching instead of Python dict
3. Extend matches in 8-byte chunks using `struct.unpack` comparison before falling back to byte-by-byte

```python
def _lz77_compress_v3(data: bytes) -> bytes:
    """Eq 236: Sovereign-accelerated LZ77 with memoryview match extension."""
    if not data:
        return b""
    
    mv = memoryview(data)
    output = bytearray()
    pos = 0
    length = len(data)
    hash_table: Dict[int, deque] = defaultdict(lambda: deque(maxlen=32))
    
    while pos < length:
        best_offset = 0
        best_length = 0
        
        if pos + 2 < length:
            h = (data[pos] << 16) | (data[pos + 1] << 8) | data[pos + 2]
            candidates = hash_table.get(h)
            
            if candidates is not None:
                for cand_pos in reversed(candidates):
                    offset = pos - cand_pos
                    if offset > WINDOW_SIZE or offset <= 0:
                        continue
                    # Fast match extension using memoryview slice comparison
                    max_check = min(MAX_MATCH_LEN, length - pos, length - cand_pos)
                    match_len = 0
                    # Compare 8 bytes at a time (Eq 236: chunk comparison)
                    while match_len + 8 <= max_check:
                        if mv[cand_pos + match_len:cand_pos + match_len + 8].tobytes() != \
                           mv[pos + match_len:pos + match_len + 8].tobytes():
                            break
                        match_len += 8
                    # Finish byte-by-byte
                    while match_len < max_check and data[cand_pos + match_len] == data[pos + match_len]:
                        match_len += 1
                    
                    if match_len > best_length:
                        best_length = match_len
                        best_offset = offset
                        if match_len >= MAX_MATCH_LEN:
                            break
            
            hash_table[h].append(pos)
        
        if best_length >= MIN_MATCH_LEN:
            output.append(0x01)
            output.extend(struct.pack("<HB", best_offset, min(best_length, MAX_MATCH_LEN)))
            pos += best_length
        else:
            output.append(0x00)
            output.append(data[pos])
            pos += 1
    
    return bytes(output)
```

