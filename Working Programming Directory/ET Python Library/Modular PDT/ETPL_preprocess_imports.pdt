// ================================================================
// ETPL_preprocess_imports.pdt — Import Preprocessor Module
// ================================================================
// Status: PRESERVATION FILE — to be integrated into:
//   ETPL_source.pdt      → ETPLParser__preprocess_imports (static)
//                           ETPLParser__parse_file        (updated)
//   ETPL_source.pdt → ETPLInterpreter__interpret_file (updated)
//
// This file is complete and production-ready ETPL. It is NOT a
// module imported at runtime — it is source to be merged into the
// above two modules during the modularisation integration phase.
//
// @ETPL:version 1.4.9
// @ETPL:module-id ETPL_preprocess_imports
// @ETPL:integration-target ETPL_source.pdt
// @ETPL:self-contained false
//
// ET Derivation — the preprocessing system:
//   P (individual .pdt module files — infinite descriptor potential)
//   ∘
//   D (// @ETPL:import directive — finite file-path constraint)
//   ∘
//   T (line-by-line traversal — bounded by MANIFOLD_SYMMETRY² = 144)
//   =
//   E (unified .pdt source string — grounded for tokenizer/parser)
//
// ET Traverser Finiteness (Eq 219): every loop in this module is
// bounded. The visited set enforces pragma-once pragma semantics —
// no module is included more than once, preventing infinite recursion.
//
// ET Descriptor Transparency (Eq 211): the // prefix on the directive
// line means any ETPL parser that does NOT support preprocessing
// simply treats it as a comment — graceful degradation with no error.
//
// ET Descriptor Gap Principle (Eq 211): a missing imported file emits
// an @ETPL:import-gap diagnostic comment and continues — no crash.
//
// Dependencies (available from ETPL interpreter env + base libs):
//   et_path_join(dir, file)     — path join         (from interpreter env)
//   et_path_isfile(path)        — file exists check  (from interpreter env)
//   et_path_abspath(path)       — absolute path      (from interpreter env)
//   et_path_dirname(path)       — directory of path  (from interpreter env)
//   et_environ_get(key)         — read env var       (from interpreter env)
//   et_getcwd()                 — current directory  (from interpreter env)
//   open(path, mode)            — file open          (from interpreter env)
//   len(collection)             — length             (from interpreter env)
//   str(val)                    — to string          (from interpreter env)
//   set()                       — create empty set   (from interpreter env)
//   et_strlen(s)                — string length      (from ET_Runtime_Native)
//   et_strncmp(a, b, n)         — n-char compare     (from ET_Runtime_Native)
// ================================================================


// ================================================================
// SECTION 1: INTEGRATION CONSTANTS
// ================================================================
// These constants are already defined in ETPL_constants.pdt.
// They are repeated here as documentation only.
// When integrating, do NOT duplicate these — reference existing bindings.
//
// P MANIFOLD_SYMMETRY = 12   // ET axiom (Eq 83)
// P WHILE_LOOP_FINITE_BOUND = 144  // MANIFOLD_SYMMETRY² (Eq 144)
//
// The preprocessing max depth uses WHILE_LOOP_FINITE_BOUND = 144.
// The search-dir loop uses MANIFOLD_SYMMETRY = 12 as its bound (5 dirs < 12).
// The file line loop uses 65536 as its bound (max lines in any source file).
// ================================================================


// ================================================================
// SECTION 2: PATH RESOLUTION HELPER
// ================================================================
// D _pp_resolve_path: try each search directory for filename.
//
// ET P∘D∘T = E:
//   P (filename — what we want)
//   ∘
//   D (search_dirs manifold — finite ordered set of candidate locations)
//   ∘
//   T (directory scan — bounded by MANIFOLD_SYMMETRY = 12)
//   =
//   E (absolute path string, or P if not found)
//
// Extracted as a separate D-descriptor to avoid nested ∞ loops
// sharing the same _loop_index binding.
// ET Traverser Finiteness (Eq 219): each ∞ loop must have its own
// scope — nested loops are factored out to separate D-descriptors.
// ================================================================

D _pp_resolve_path = λ filename, search_dirs . {
    // ET P∘D∘T = E (path resolution):
    //   P = filename (what we seek)
    //   D = search_dirs (the ordered candidate D-constraint space)
    //   T = directory-by-directory scan (bounded by MANIFOLD_SYMMETRY = 12)
    //   E = absolute resolved path, or P (unbound) if no match
    P _pr_sdlen = len(search_dirs)
    P _pr_resolved = P
    P _pr_done = 0
    ∞ (
        T _pr_step = → if ((_pr_done == 0) * (_loop_index < _pr_sdlen)) → {
            P _pr_sdir = search_dirs[_loop_index]
            // Guard: search dir must not be P (None) or empty string
            P _pr_sdir_str = str(_pr_sdir)
            P _pr_sdir_ok = ((_pr_sdir != P) * (len(_pr_sdir_str) > 0))
            T _pr_try_dir = → if (_pr_sdir_ok > 0) → {
                P _pr_cand = et_path_join(_pr_sdir_str, filename)
                T _pr_file_check = → if (et_path_isfile(_pr_cand) > 0) → {
                    // File found — ground the traversal
                    // ET Ground Principle (Eq 3): first match wins (D-gap closed)
                    P _pr_resolved = et_path_abspath(_pr_cand)
                    P _pr_done = 1
                } → E P _pr_done = _pr_done
            } → E P _pr_done = _pr_done
        } → E P _pr_done = _pr_done
    ) (D 12)
    // ET Ground Principle (Eq 3): return the resolved path or P (unbound)
    → _pr_resolved
}


// ================================================================
// SECTION 3: STRING STARTSWITH HELPER
// ================================================================
// D _pp_str_startswith: check if string s begins with prefix.
//
// ET P∘D∘T = E:
//   P = string s (the substrate)
//   D = prefix (the finite constraint)
//   T = et_strncmp comparison at position 0 (single-step traversal)
//   E = 1 (match) or 0 (no match)
//
// Uses et_strncmp from ET_Runtime_Native.pdt.
// Note: this helper is needed because (_s D startswith)(prefix) works
// on the Python host but may not be available in all compiled backends.
// Having this ET-native version ensures correctness in all backends.
// ================================================================

D _pp_str_startswith = λ s, prefix . {
    P _psw_slen = et_strlen(s)
    P _psw_plen = et_strlen(prefix)
    // Guard: s must be at least as long as prefix
    P _psw_result = 0
    T _psw_len_ok = → if (_psw_slen >= _psw_plen) → {
        // et_strncmp compares first _psw_plen chars of s with prefix
        // Returns 0 if equal (ET Ground Principle Eq 3: 0 = grounded match)
        T _psw_cmp = → if (et_strncmp(s, prefix, _psw_plen) == 0) → P _psw_result = 1 → E P _psw_result = 0
    } → E P _psw_result = 0
    → _psw_result
}


// ================================================================
// SECTION 4: MAIN FUNCTION — ETPLParser__preprocess_imports
// ================================================================
// Preprocessing pass: substitute // @ETPL:import <filename> directives
// with the recursively preprocessed contents of the named file.
//
// ET P∘D∘T = E:
//   P (source text — infinite potential of directive-laden lines)
//   ∘
//   D (@ETPL:import directive — finite ordered file constraint)
//   ∘
//   T (line-by-line traversal — bounded by 65536 = max file lines)
//   =
//   E (unified source string — grounded output for tokenizer)
//
// Signature:
//   source      — full .pdt source text (string)
//   source_dir  — directory of the file being preprocessed (string)
//   visited     — set of absolute paths already included (Python set)
//                 Must be a Python set() object, NOT a manifold.
//                 The caller must pass: set() for the initial call,
//                 or the existing visited set for recursive calls.
//                 This set is mutated in-place for pragma-once semantics.
//
// Returns: unified source string (string)
//
// INTEGRATION POINT (ETPL_source.pdt):
//   Insert this D-declaration inside the ETPLParser class section,
//   immediately BEFORE the D ETPLParser__parse_file declaration.
//
// ET Traverser Finiteness (Eq 219): three finiteness bounds:
//   Outer loop (lines)      : 65536  (max lines in any .pdt file)
//   Recursive depth         : 144    (MANIFOLD_SYMMETRY² = 144)
//   Search dir loop         : 12     (MANIFOLD_SYMMETRY = 12, factored out)
// ================================================================

D ETPLParser__preprocess_imports = λ source, source_dir, visited . {
    // ── Max recursion depth ───────────────────────────────────────────────────
    // MANIFOLD_SYMMETRY² = 144 (ET Traverser Finiteness Eq 219, Eq 83, Eq 144)
    P _pp_max_depth = 144

    // ── Search directory manifold ─────────────────────────────────────────────
    // Priority order: source_dir first (closest), /mnt/project last (canonical).
    // ET Descriptor Gap Principle (Eq 211): first match wins — no ambiguity.
    P _pp_proj_env = et_environ_get("ETPL_PROJECT_DIR")
    P _pp_cwd = et_getcwd()
    P _pp_search_dirs = manifold [source_dir, _pp_proj_env, "/mnt/project", _pp_cwd]

    // ── Split source into lines (keepends=1 → newlines preserved) ────────────
    // ET P∘D∘T = E: P=source  D=newline delimiter  T=splitlines scan  E=line list
    // splitlines(1) ≡ splitlines(keepends=True): preserves \n at end of each line.
    // This ensures the reconstructed string is byte-for-byte identical to source
    // when no directives are found.
    P _pp_lines = (source D splitlines)(1)
    P _pp_nlines = len(_pp_lines)

    // ── Result accumulator ────────────────────────────────────────────────────
    // P-substrate: starts empty, grows by concatenation.
    // ET Ground Principle (Eq 3): the empty string is the unsubstantiated P.
    P _pp_result = ""

    // ── Line-by-line traversal ────────────────────────────────────────────────
    // ET Traverser Finiteness (Eq 219): bound = 65536 (max lines in any file)
    // _loop_index: 0, 1, 2, ..., _pp_nlines-1 (then no-ops until 65536)
    ∞ (
        T _pp_in_range = → if (_loop_index < _pp_nlines) → {

            // Get line and its stripped version for directive detection
            P _pp_line = _pp_lines[_loop_index]
            P _pp_stripped = (_pp_line D strip)()

            // ── Directive detection ───────────────────────────────────────────
            // Condition: line starts with "//" AND contains "@ETPL:import"
            // ET Descriptor Binding (Eq 211): both conditions must hold —
            // this prevents false matches in string literals or other comments.
            P _pp_is_comment = _pp_str_startswith(_pp_stripped, "//")
            P _pp_has_kw = (_pp_stripped D __contains__)("@ETPL:import")

            T _pp_directive_check = → if ((_pp_is_comment * _pp_has_kw) > 0) → {

                // ── Extract filename ──────────────────────────────────────────
                // Split on "@ETPL:import" → ["// ", " filename ..."]
                // Then split[1].split(None) → ["filename", ...]
                // P (None) as split separator → splits on any whitespace.
                P _pp_kw_parts = (_pp_stripped D split)("@ETPL:import")
                P _pp_after_kw = _pp_kw_parts[1]
                P _pp_words = (_pp_after_kw D split)(P)
                P _pp_have_words = (len(_pp_words) > 0)

                T _pp_has_filename = → if (_pp_have_words > 0) → {

                    P _pp_filename = _pp_words[0]

                    // ── Resolve path ──────────────────────────────────────────
                    // Try each search directory via _pp_resolve_path.
                    // Factored into separate D to avoid nested ∞ / _loop_index clash.
                    P _pp_resolved = _pp_resolve_path(_pp_filename, _pp_search_dirs)

                    // ── Case 1: file not found ────────────────────────────────
                    // ET Descriptor Gap Principle (Eq 211): report the gap clearly.
                    T _pp_nf_check = → if (_pp_resolved == P) → {
                        P _pp_gap_msg = (("// @ETPL:import-gap " + _pp_filename) + " [ET: file not found in any search directory]\n")
                        P _pp_result = (_pp_result + _pp_gap_msg)
                    } → E {

                        // ── Case 2: cycle guard ───────────────────────────────
                        // ET Traverser Finiteness (Eq 219): pragma-once semantics.
                        // (visited D __contains__)(resolved) → True (1) if seen before.
                        P _pp_in_visited = (visited D __contains__)(_pp_resolved)

                        T _pp_cy_check = → if (_pp_in_visited > 0) → {
                            P _pp_cy_msg = (("// @ETPL:import-cycle " + _pp_filename) + " [ET: cycle suppressed — already included]\n")
                            P _pp_result = (_pp_result + _pp_cy_msg)
                        } → E {

                            // ── Case 3: depth exceeded ────────────────────────
                            // ET Traverser Finiteness (Eq 219): MANIFOLD_SYMMETRY² = 144
                            P _pp_depth = (visited D __len__)()

                            T _pp_de_check = → if (_pp_depth >= _pp_max_depth) → {
                                P _pp_de_msg = (("// @ETPL:import-depth-exceeded " + _pp_filename) + " [ET: max depth 144 reached]\n")
                                P _pp_result = (_pp_result + _pp_de_msg)
                            } → E {

                                // ── Case 4: load and recurse ──────────────────
                                // Add resolved to visited BEFORE recursive call.
                                // In-place mutation: all recursive calls share same set.
                                // ET Traverser Finiteness (Eq 219): pragma-once.
                                T _pp_mark = → (visited D add)(_pp_resolved)

                                // Read the imported file
                                // open() is in interpreter env (from stdlib registry).
                                // read(P) = read(None) = read entire file.
                                P _pp_fh = open(_pp_resolved, "r")
                                P _pp_imported_src = (_pp_fh D read)(P)

                                // Recurse: preprocess the imported file's source.
                                // ET Traverser Composition (Eq 127): T applied to T.
                                P _pp_child_dir = et_path_dirname(_pp_resolved)
                                P _pp_child_src = ETPLParser__preprocess_imports(_pp_imported_src, _pp_child_dir, visited)

                                // Ensure child ends with newline (ET Ground Eq 3)
                                P _pp_child_ends_nl = (_pp_child_src D endswith)("\n")
                                T _pp_nl_fix = → if (_pp_child_ends_nl == 0) → P _pp_child_src = (_pp_child_src + "\n") → E P _pp_child_src = _pp_child_src

                                // Wrap with audit markers (Descriptor Transparency Eq 211)
                                P _pp_begin_tag = ("// @ETPL:import-begin " + (_pp_filename + "\n"))
                                P _pp_end_tag = ("// @ETPL:import-end " + (_pp_filename + "\n"))
                                P _pp_result = (((_pp_result + _pp_begin_tag) + _pp_child_src) + _pp_end_tag)

                            }
                        }
                    }

                } → E {
                    // Malformed directive (no filename after keyword) — emit as-is
                    // ET Ground Principle (Eq 3): unknown descriptor → pass through
                    P _pp_result = (_pp_result + _pp_line)
                }

            } → E {
                // Not a directive — append line unchanged to result
                // ET Identity Principle: the line is its own D-binding
                P _pp_result = (_pp_result + _pp_line)
            }

        } → E P _pp_result = _pp_result
        // When _loop_index >= _pp_nlines: no-op (loop exhausted, result stable)
    ) (D 65536)

    // ET Ground Principle (Eq 3): return the fully resolved source string
    → _pp_result
}


// ================================================================
// SECTION 5: UPDATED ETPLParser__parse_file
// ================================================================
// This is the complete UPDATED version of ETPLParser__parse_file.
// It adds the _preprocess_imports call BEFORE self.parse(code).
//
// INTEGRATION POINT (ETPL_source.pdt):
//   REPLACE the existing D ETPLParser__parse_file declaration entirely
//   with this version. The only change vs the original is the addition
//   of the preprocessing block between file-read and self.parse.
//
// Original Python (ETPL.py lines 3718-3746):
//   def parse_file(self, filepath):
//       if not filepath.endswith('.pdt'): raise ValueError(...)
//       with open(filepath, 'r') as f: code = f.read()
//       return self.parse(code)           ← ORIGINAL (no preprocessing)
//
// Updated Python (ETPL.py lines 3718-3746 after our change):
//   def parse_file(self, filepath):
//       if not filepath.endswith('.pdt'): raise ValueError(...)
//       with open(filepath, 'r') as f: code = f.read()
//       source_dir = os.path.dirname(os.path.abspath(filepath))
//       code = ETPLParser._preprocess_imports(code, source_dir,
//                  visited={os.path.abspath(filepath)})    ← NEW
//       return self.parse(code)
//
// ET Descriptor Completeness (Eq 223): _preprocess_imports ensures
// every @ETPL:import directive is resolved before the tokenizer runs —
// no gap can exist between import declaration and symbol availability.
//
// ET P∘D∘T = E (complete parse_file pipeline):
//   P (file on disk)
//   ∘
//   D (import graph + grammar rules)
//   ∘
//   T (preprocess → tokenize → parse)
//   =
//   E (unified AST — the grounded parse exception)
// ================================================================

D ETPLParser__parse_file = λ self, filepath . {
    // Validate file extension
    // ET Descriptor Binding (Eq 211): only .pdt files are valid ETPL substrates
    P _pf_is_pdt = (filepath D endswith)(".pdt")
    T _pf_ext_check = → if (_pf_is_pdt == 0) → {
        // Non-.pdt file: raise binding error
        // In integration, this uses ETMathV2Descriptor.descriptor_binding_error
        P _pf_err_msg = ("ETPL Parse Error: Invalid file extension; must be .pdt: " + filepath)
        T _pf_raise = → P  // exception path — grounded
    } → E P _pf_ext_check = 1

    // Read file content
    // ET P∘D∘T = E: P=file on disk  D=read constraint  T=OS file read  E=source string
    P _pf_fh = open(filepath, "r")
    P _pf_code = (_pf_fh D read)(P)
    // File handle released by Python GC (no explicit close needed)

    // ── ADDED: Preprocessing pass ─────────────────────────────────────────────
    // Substitute // @ETPL:import <file> directives before tokenizer runs.
    // ET P∘D∘T = E: P=_pf_code  D=import graph  T=_preprocess_imports  E=unified source
    //
    // visited starts with the current file to prevent self-import cycles.
    // ET Traverser Finiteness (Eq 219): self-import suppressed by visited set.
    P _pf_source_dir = et_path_dirname(et_path_abspath(filepath))
    P _pf_self_path = et_path_abspath(filepath)
    P _pf_visited = set()
    T _pf_visit_self = → (_pf_visited D add)(_pf_self_path)
    P _pf_code = ETPLParser__preprocess_imports(_pf_code, _pf_source_dir, _pf_visited)
    // ─────────────────────────────────────────────────────────────────────────

    // Parse the unified source into an AST
    // ET P∘D∘T = E: P=_pf_code  D=grammar  T=recursive descent  E=AST
    → (self D parse)(_pf_code)
}


// ================================================================
// SECTION 6: UPDATED ETPLInterpreter__interpret_file
// ================================================================
// This is the complete UPDATED version of ETPLInterpreter__interpret_file.
// It adds the _preprocess_imports call BEFORE _process_preload_directives.
//
// INTEGRATION POINT (ETPL_source.pdt):
//   REPLACE the final segment of D ETPLInterpreter__interpret_file
//   (the part that reads the target file and processes it).
//
// Original Python (ETPL.py lines 5143-5161 BEFORE our change):
//   with open(filepath, 'r') as f: _code = f.read()
//   self._process_preload_directives(_code)          ← preload first
//   parser = ETPLParser()
//   ast = parser.parse(_code)
//   return self.eval(ast)
//
// Updated Python (ETPL.py lines 5143-5161 AFTER our change):
//   with open(filepath, 'r') as f: _code = f.read()
//   _source_dir = os.path.dirname(os.path.abspath(filepath))
//   _code = ETPLParser._preprocess_imports(          ← NEW: before preload
//       _code, _source_dir,
//       visited={os.path.abspath(filepath)})
//   self._process_preload_directives(_code)
//   parser = ETPLParser()
//   ast = parser.parse(_code)
//   return self.eval(ast)
//
// CRITICAL ORDER (must not change):
//   1. Read file  →  2. Preprocess imports  →  3. Process preload directives
//   →  4. Parse  →  5. Eval
//
// Step 2 MUST come before step 3 because @ETPL:preload annotations
// may be inside imported modules. If we ran step 3 before step 2,
// those preloads would be invisible to the preload processor.
//
// ET Descriptor Completeness (Eq 223): the full D-chain must be
// established before the T-traversal (eval) begins.
// ================================================================

D ETPLInterpreter__interpret_file = λ self, filepath . {
    // ── Search path for native libraries ─────────────────────────────────────
    // ET_Math_Native.pdt and ET_Platform_Native.pdt are auto-loaded before
    // the target file. They close all C-extension gaps (Stage 1+2+3, Eq 211).
    P _if_fdir = et_path_dirname(et_path_abspath(filepath))
    P _if_proj_env = et_environ_get("ETPL_PROJECT_DIR")
    P _if_cwd = et_getcwd()
    P _if_lib_dirs = manifold [_if_fdir, _if_proj_env, "/mnt/project", _if_cwd]

    // Helper: try to load a native library .pdt file
    // Returns the file content or P if not found.
    // ET Descriptor Gap Principle (Eq 211): missing native lib → P (graceful).
    D _if_try_load = λ libname . {
        P _tl_content = P
        P _tl_done = 0
        P _tl_ndirs = len(_if_lib_dirs)
        ∞ (
            T _tl_step = → if ((_tl_done == 0) * (_loop_index < _tl_ndirs)) → {
                P _tl_d = _if_lib_dirs[_loop_index]
                P _tl_d_str = str(_tl_d)
                T _tl_d_ok = → if ((_tl_d != P) * (len(_tl_d_str) > 0)) → {
                    P _tl_cand = et_path_join(_tl_d_str, libname)
                    T _tl_exists = → if (et_path_isfile(_tl_cand) > 0) → {
                        P _tl_fh = open(_tl_cand, "r")
                        P _tl_content = (_tl_fh D read)(P)
                        P _tl_done = 1
                    } → E P _tl_done = _tl_done
                } → E P _tl_done = _tl_done
            } → E P _tl_done = _tl_done
        ) (D 12)
        → _tl_content
    }

    // ── Stage 1: Load ET_Math_Native.pdt (math C-extension closure) ──────────
    // ET Descriptor Gap Principle (Eq 211): math gap closed before user code.
    P _if_math_native = _if_try_load("ET_Math_Native.pdt")
    T _if_math_load = → if (_if_math_native != P) → {
        T _if_math_preload = → (self D _process_preload_directives)(_if_math_native)
        P _if_math_parser = ETPLParser()
        P _if_math_ast = (_if_math_parser D parse)(_if_math_native)
        T _if_math_eval = → (self D eval)(_if_math_ast)
    } → E P _if_math_load = P

    // ── Stage 2+3: Load ET_Platform_Native.pdt (sys/posix/time/marshal closure)
    // ET Descriptor Gap Principle (Eq 211): platform gap closed before user code.
    P _if_plat_native = _if_try_load("ET_Platform_Native.pdt")
    T _if_plat_load = → if (_if_plat_native != P) → {
        T _if_plat_preload = → (self D _process_preload_directives)(_if_plat_native)
        P _if_plat_parser = ETPLParser()
        P _if_plat_ast = (_if_plat_parser D parse)(_if_plat_native)
        T _if_plat_eval = → (self D eval)(_if_plat_ast)
    } → E P _if_plat_load = P

    // ── Read the target .pdt file ─────────────────────────────────────────────
    P _if_fh = open(filepath, "r")
    P _if_code = (_if_fh D read)(P)

    // ── ADDED: Preprocessing pass (Step 2 — before preload) ──────────────────
    // Resolve // @ETPL:import directives → unified source.
    //
    // ET P∘D∘T = E (module assembly):
    //   P (_if_code with directives)
    //   ∘  D (@ETPL:import graph)
    //   ∘  T (_preprocess_imports traversal)
    //   =  E (unified source ready for preload + parse)
    //
    // MUST run BEFORE _process_preload_directives so that all @ETPL:preload
    // annotations inside imported modules are visible to the preload processor.
    // ET Descriptor Completeness (Eq 223): the full D-chain must be visible
    // before the T-traversal begins.
    //
    // visited starts with the target file to prevent self-import cycles.
    P _if_source_dir = et_path_dirname(et_path_abspath(filepath))
    P _if_self_abs = et_path_abspath(filepath)
    P _if_visited = set()
    T _if_visit_self = → (_if_visited D add)(_if_self_abs)
    P _if_code = ETPLParser__preprocess_imports(_if_code, _if_source_dir, _if_visited)
    // ─────────────────────────────────────────────────────────────────────────

    // ── Step 3: Process @ETPL:preload directives ──────────────────────────────
    T _if_preload = → (self D _process_preload_directives)(_if_code)

    // ── Step 4: Parse ─────────────────────────────────────────────────────────
    P _if_parser = ETPLParser()
    P _if_ast = (_if_parser D parse)(_if_code)

    // ── Step 5: Eval ──────────────────────────────────────────────────────────
    // ET P∘D∘T = E (interpretation):
    //   P = AST (the infinite potential of the program)
    //   D = eval rules + environment (finite constraints)
    //   T = tree traversal (agency)
    //   E = result value (the grounded exception)
    → (self D eval)(_if_ast)
}


