        → E P
            T cond = → if isinstance(value, bool) → lines D append(prefix + "P " + safe_name + " = " + if value → 1 → E 0)
            → E P
                T cond = → if isinstance(value, int) → lines D append(prefix + "P " + safe_name + " = " + int(value))
                → E P
                    T cond = → if isinstance(value, float) → P
                        T cond = → if (ETMathNative D et_isnan(value) || ETMathNative D et_isinf(value)) → lines D append(prefix + "P " + safe_name + " = 0  // " + repr(value))
                        → E lines D append(prefix + "P " + safe_name + " = " + value)
                    → E P
                        T cond = → if isinstance(value, str) → P
                            P capped = value[0:500]
                            P escaped = capped D replace("\\", "\\\\") D replace("\"", "\\\"") D replace("\n", "\\n") D replace("\r", "\\r") D replace("\t", "\\t")
                            lines D append(prefix + "P " + safe_name + " = \"" + escaped + "\"")
                        → E P
                            T cond = → if isinstance(value, bytes) → lines D append(prefix + "P " + safe_name + " = \"" + value[0:256] D hex(P) + "\"  // bytes")
                            → E P
                                T cond = → if isinstance(value, manifold [list, tuple]) → P
                                    P elems = { T loop = ∞ (_scalar_elem(elem)) (D |list(value)[0:50]|) }
                                    lines D append(prefix + "P " + safe_name + " = manifold [" + ", " D join(elems) + "]")
                                → E P
                                    T cond = → if isinstance(value, manifold [frozenset, set]) → P
                                        T attempt = → P  // try
                                            P sorted_elems = sorted(value)
                                        → E TypeError (_)
                                            P sorted_elems = list(value)
                                        P elems = { T loop = ∞ (_scalar_elem(elem)) (D |sorted_elems[0:50]|) }
                                        lines D append(prefix + "P " + safe_name + " = manifold [" + ", " D join(elems) + "]  // " + type(value) D __name__)
                                    → E P
                                        T cond = → if isinstance(value, dict) → P
                                            D ETPLTranslator___is_scalar = λ v . → (v == P || isinstance(v, manifold [bool, int, float, str]))
                                            P items = { T loop = ∞ (manifold [k, v] → E isinstance(k, str)) (D |list(value D items(P))[0:20]|) }
                                            P all_scalar = all({ T loop = ∞ (_is_scalar(v)) (D |items|) })
                                            T cond = → if (all_scalar && items) → P
                                                P pairs = manifold []
                                                T loop = ∞ (
                                                    P manifold__k__v = items[_loop_index]  // manifold [k, v]
                                                    P ke = (("\"" + k[0:100] D replace("\\", "\\\\") D replace("\"", "\\\"") D replace("\n", "\\n") D replace("\r", "\\r") D replace("\t", "\\t")) + "\"")
                                                    P ve = _scalar_elem(v)
                                                    pairs D append("manifold [" + ke + ", " + ve + "]")
                                                ) (D |items|)
                                                lines D append(prefix + "P " + safe_name + " = manifold [" + ", " D join(pairs) + "]")
                                            → E P
                                                P eff_qname = (qname || safe_name)
                                                lines D append(prefix + "// @ETPL:preload " + safe_name + " " + eff_qname)
                                                lines D append(prefix + "// [ET:complex-dict:" + safe_name + "]")
                                        → E P
                                            T cond = → if (callable(value) || isinstance(value, type)) → P
                                                P eff_qname = (qname || getattr(value, "__qualname__", safe_name))
                                                lines D append(prefix + "// @ETPL:preload " + safe_name + " " + eff_qname)
                                                lines D append(prefix + "P " + safe_name + " = P  // [ET:callable:" + eff_qname + "]")
                                            → E P
                                                T cond = → if (hasattr(value, "__dict__") && hasattr(value, "__name__")) → P
                                                    P eff_qname = (qname || getattr(value, "__name__", safe_name))
                                                    lines D append(prefix + "// @ETPL:preload " + safe_name + " " + eff_qname)
                                                → E lines D append(prefix + "P " + safe_name + " = P  // [ET:unrepresentable:" + type(value) D __name__ + "]")
        → lines
    }
    D ETPLTranslator___expand_module_exports = λ self, mod, modname, names, prefix . {
        // Expand a module's exported symbols to fully self-contained ETPL bindings.          ET Descriptor Completeness (Eq 223): 
        P lines = manifold []
        T cond = → if mod == P → → lines
        T cond = → if names == P → P
            T cond = → if hasattr(mod, "__all__") → P names = list(mod D __all__)
            → E P names = { T loop = ∞ (n → E (!n D startswith("_"))) (D |dir(mod)|) }
        lines D append(prefix + "// @ETPL:module-start " + modname)
        T loop = ∞ (
            P name = names[_loop_index]
            T attempt = → P  // try
                P value = getattr(mod, name, P)
            → E Exception (_)
                P value = P
            P safe_name = re D sub("[^a-zA-Z0-9_]", "_", name)
            P qname = modname + "." + name
            lines D extend(self D _value_to_etpl_lines(safe_name, value, qname, prefix))
        ) (D |names|)
        lines D append(prefix + "// @ETPL:module-end " + modname)
        → lines
    }
    D ETPLTranslator__translate_file = λ self, file_path, lang . {
        // Translate source file to ETPL — FULL TRACE EDITION (v1.3.2).          Produces a completely self-contained .pdt file.   
        // @ETPL:preload _os os
        // Import os — resolved at translate-time
        T scope_f = → open(file_path, "r", manifold ["encoding", "utf-8"])
        P f = scope_f  // context var
            P source = f D read(P)
        P header_lines = manifold ["// ================================================================", "// ETPL Self-Hosting Bootstrap  v" + ETPL_VERSION + "  [Full-Trace Edition]", "// Source: " + _os D path D basename(file_path), "// Language: " + lang, "// Generated by: python ETPL.py translate " + _os D path D basename(file_path) + " --lang " + lang, "// @ETPL:version " + ETPL_VERSION, "// @ETPL:self-contained true", "// @ETPL:full-trace true", "// @ETPL:entry-point verify_etpl", "// ET Master Equation: P ∘ D ∘ T = E", "// Tautological form: 3 = 3 = 3 = Σ", "// ================================================================", ""]
        P tagged_chain = self D _trace_imports(file_path, manifold ["visited", set(P)], manifold ["stdlib_visited", set(P)])
        P etpl_parts = manifold ["\n" D join(header_lines)]
        P _lib_search_dirs = manifold [_os D path D dirname(_os D path D abspath(file_path)), if "__file__" == dir(P) → _os D path D dirname(_os D path D abspath(__file__)) → E ".", _os D environ D get("ETPL_PROJECT_DIR", ""), "/mnt/project", "/home/claude", _os D getcwd(P)]
        D ETPLTranslator___load_et_library = λ libname . {
            // Load an ET native library .pdt file from the search path.             Returns the file content or a gap comment if not f
            T loop = ∞ (
                P d = _lib_search_dirs[_loop_index]
                T cond = → if (!d) → P  // pass
                P candidate = _os D path D join(d, libname)
                T cond = → if _os D path D isfile(candidate) → P
                    T attempt = → P  // try
                        T scope__lf = → open(candidate, "r", manifold ["encoding", "utf-8"])
                        P _lf = scope__lf  // context var
                            P content = _lf D read(P)
                        → (("// @ETPL:native-library " + libname + " [" + candidate + "]\n" + content) + "\n// @ETPL:native-library-end " + libname + "\n")
                    → E Exception (_le)
                        → "// @ETPL:native-library-error " + libname + ": " + _le
            ) (D |_lib_search_dirs|)
            → "// @ETPL:native-library-not-found " + libname + "\n// [ET: place " + libname + " in the source directory, project dir, or /mnt/project/]"
        }
        P math_lib = _load_et_library("ET_Math_Native.pdt")
        etpl_parts D append(("// ============================================================\n// @ETPL:stage1 ET_Math_Native.pdt — math C-extension closure\n// ============================================================\n" + math_lib))
        P platform_lib = _load_et_library("ET_Platform_Native.pdt")
        etpl_parts D append(("// ============================================================\n// @ETPL:stage2 ET_Platform_Native.pdt — sys/posix/time/marshal closure\n// ============================================================\n" + platform_lib))
        P _translated_paths = set(P)
        P _expanded_mods = set(P)
        P stdlib_count = 0
        P user_count = 0
        P cext_count = 0
        T loop = ∞ (
            P manifold__fp__modname__is_stdlib = tagged_chain[_loop_index]  // manifold [fp, modname, is_stdlib]
            T cond = → if fp == _translated_paths → P  // pass
            P has_py_source = 0
            P fp_source = ""
            T cond = → if (fp && _os D path D isfile(fp) && fp D endswith(".py")) → P
                T attempt = → P  // try
                    T scope_f_dep = → open(fp, "r", manifold ["encoding", "utf-8"])
                    P f_dep = scope_f_dep  // context var
                        P fp_source = f_dep D read(P)
                    P has_py_source = 1
                → E Exception (_)
                    P has_py_source = 0
            T cond = → if has_py_source → P
                _translated_paths D add(fp)
                P tag = if is_stdlib → "stdlib" → E "user"
                P section = self D _convert_source(fp_source, lang)
                T cond = → if section → P
                    P header = "// @ETPL:trace-" + tag + " " + _os D path D basename(fp) + "  // module=" + modname
                    etpl_parts D append(((header + "\n") + section))
                T cond = → if is_stdlib → P stdlib_count = stdlib_count + 1
                → E P user_count = user_count + 1
            → E P
                T cond = → if modname == _expanded_mods → P  // pass
                _expanded_mods D add(modname)
                T cond = → if fp → _translated_paths D add(fp)
                P mod = self D _resolve_module(modname)
                T cond = → if mod ≠ P → P
                    P section_lines = manifold ["", "// @ETPL:trace-c-extension " + modname, "// C extension module \"" + modname + "\" — no Python source available.", "// Interface (constants, flags, type stubs) inlined as P/D bindings.", "// Callable implementations are native C — cannot be source-translated.", "// @ETPL:c-extension-caveat callables bound as P stubs (C ABI required)"]
                    section_lines D extend(self D _expand_module_exports(mod, modname, manifold ["prefix", ""]))
                    section_lines D append("// @ETPL:trace-c-extension-end " + modname)
                    etpl_parts D append("\n" D join(section_lines))
                    P cext_count = cext_count + 1
                → E etpl_parts D append("// @ETPL:trace-gap " + modname + " [ET: not importable and no source found]")
        ) (D |tagged_chain|)
        P main_etpl = self D _convert_source(source, lang)
        T cond = → if main_etpl → etpl_parts D append(("// @ETPL:entry-source " + _os D path D basename(file_path) + "\n" + main_etpl))
        P bound_etpl = "\n\n" D join({ T loop = ∞ (part → E part) (D |etpl_parts|) })
        P density = ETMathV2Descriptor D t_master_density_applier(bound_etpl)
        sovereign_print ∘ "ETPL Translator: T-density = " + density + "%  [" + len(tagged_chain) + " deps traced | " + stdlib_count + " stdlib source-translated | " + user_count + " user source-translated | " + cext_count + " C-extension interface-inlined]"
        → bound_etpl
    }
    D ETPLTranslator__translate_binary = λ self, file_path . {
        // Translate binary/PE to ETPL (requires capstone + pefile).
        T cond = → if (!HAS_PEFILE) → → E RuntimeError("ETPL: pefile required for binary translation. pip install pefile")
        T cond = → if (!HAS_CAPSTONE) → → E RuntimeError("ETPL: capstone required for binary translation. pip install capstone")
        P pe = pefile D PE(file_path)
        P binary = pe D get_memory_mapped_image(P)
        P md = capstone D Cs(capstone D CS_ARCH_X86, capstone D CS_MODE_64)
        P instructions = list(md D disasm(binary, 4096))
        P etpl_lines = manifold ["// ETPL Translation of " + os D path D basename(file_path), "// " + len(instructions) + " instructions disassembled", ""]
        T loop = ∞ (
            P instr = instructions[_loop_index]
            etpl_lines D append("T instr_" + instr D address + " = → " + instr D mnemonic + " ∘ " + instr D op_str)
        ) (D |instructions|)
        T cond = → if hasattr(pe, "DIRECTORY_ENTRY_IMPORT") → P
            etpl_lines D append("")
            etpl_lines D append("// Dependencies")
            T loop = ∞ (
                P entry = pe D DIRECTORY_ENTRY_IMPORT[_loop_index]
                P dll_name = entry D dll D decode("utf-8", manifold ["errors", "replace"])
                P safe_name = dll_name D replace(".", "_")
                etpl_lines D append("// @ETPL:preload " + safe_name + " " + dll_name)
            ) (D |pe D DIRECTORY_ENTRY_IMPORT|)
        → "\n" D join(etpl_lines)
    }
    D ETPLTranslator___is_stdlib_or_site_packages = λ filepath . {
        // Return True if filepath is a Python stdlib or site-packages file.          Used ONLY to TAG nodes in the import chain (v
        // @ETPL:preload _os os
        // Import os — resolved at translate-time
        P fp = _os D path D normcase(_os D path D abspath(filepath))
        T cond = → if hasattr(sys, "stdlib_module_names") → P
            P base = _os D path D basename(filepath)
            P modname = if base D endswith(".py") → base[0:(-3)] → E base
            T cond = → if modname == sys D stdlib_module_names → → 1
        T attempt = → P  // try
            // @ETPL:preload _os2 os
            // Import os — resolved at translate-time
            P stdlib_dir = _os2 D path D normcase(_os2 D path D abspath(_os2 D path D dirname(_os2 D __file__)))
            T cond = → if (fp D startswith((stdlib_dir + _os2 D sep)) || fp == stdlib_dir D rstrip(_os2 D sep)) → → 1
        → E Exception (_)
            // pass
        T cond = → if ("site-packages" == fp || "dist-packages" == fp || (("lib" + os D sep) + "python") == fp D replace("\\", os D sep)) → → 1
        → 0
    }
    D ETPLTranslator___filepath_to_modname = λ filepath . {
        // Convert a filesystem path to a dotted Python module name.          ET Identity Principle: each filepath is a P-substrate
        // @ETPL:preload _os os
        // Import os — resolved at translate-time
        P fp = _os D path D normcase(_os D path D abspath(filepath))
        T cond = → if fp D endswith(".py") → P fp = fp[0:(-3)]
        T cond = → if fp D endswith((_os D sep + "__init__")) → P fp = fp[0:(-(len("__init__") + 1))]
        P best_prefix = ""
        T loop = ∞ (
            P entry = sys D path[_loop_index]
            T cond = → if (!entry) → P  // pass
            P norm_entry = _os D path D normcase(_os D path D abspath(entry))
            T cond = → if (fp D startswith((norm_entry + _os D sep)) && len(norm_entry) > len(best_prefix)) → P best_prefix = norm_entry
        ) (D |sys D path|)
        T cond = → if best_prefix → P
            P relative = fp[(len(best_prefix) + 1):Ω]
            → relative D replace(_os D sep, ".")
        → _os D path D basename(filepath) D replace(".py", "")
    }
    D ETPLTranslator___trace_imports = λ self, file_path, visited, stdlib_visited, _recurse_into_stdlib . {
        // Trace import chain and return ALL nodes — stdlib and user alike.          v1.3.0: stdlib skip REMOVED.  Every import-cha
        T cond = → if file_path == visited → → manifold []
        visited D add(file_path)
        P result = manifold []
        T attempt = → P  // try
            T scope_f = → open(file_path, "r", manifold ["encoding", "utf-8"])
            P f = scope_f  // context var
                P source = f D read(P)
            P tree = python_ast D parse(source)
        → E Exception (_)
            P modname = self D _filepath_to_modname(file_path)
            P is_stdlib = self D _is_stdlib_or_site_packages(file_path)
            result D append(manifold [file_path, modname, is_stdlib])
            → result
        T loop = ∞ (
            P node = python_ast D walk(tree)[_loop_index]
            T cond = → if (!isinstance(node, manifold [python_ast D Import, python_ast D ImportFrom])) → P  // pass
            T cond = → if isinstance(node, python_ast D ImportFrom) → P
                P candidate_names = manifold []
                T cond = → if node D module → candidate_names D append(node D module)
                T loop = ∞ (
                    P alias = node D names[_loop_index]
                    T cond = → if (alias D name ≠ "*" && node D module) → P
                        P dotted = ((node D module + ".") + alias D name)
                        candidate_names D insert(0, dotted)
                ) (D |node D names|)
            → E P candidate_names = { T loop = ∞ (alias D name) (D |node D names|) }
            T loop = ∞ (
                P modname = candidate_names[_loop_index]
                T cond = → if (!modname) → P  // pass
                P imp_path = self D _find_import_path(modname)
                T cond = → if imp_path == P → P
                    P canonical = modname D split(".")[0]
                    T cond = → if canonical ≠ stdlib_visited → P
                        stdlib_visited D add(canonical)
                        P mod = self D _resolve_module(canonical)
                        T cond = → if mod ≠ P → result D append(manifold [(getattr(mod, "__file__", (imp_path || canonical)) || canonical), canonical, 1])
                    // continue
                P is_stdlib = self D _is_stdlib_or_site_packages(imp_path)
                P actual_modname = self D _filepath_to_modname(imp_path)
                T cond = → if is_stdlib → P
                    P canonical = modname D split(".")[0]
                    T cond = → if canonical ≠ stdlib_visited → P
                        stdlib_visited D add(canonical)
                        P top_path = (self D _find_import_path(canonical) || imp_path)
                        result D append(manifold [top_path, canonical, 1])
                    T cond = → if (_recurse_into_stdlib && imp_path ≠ visited) → result D extend(self D _trace_imports(imp_path, visited, stdlib_visited, manifold ["_recurse_into_stdlib", 1]))
                → E P
                    T cond = → if imp_path ≠ visited → P
                        P sub = self D _trace_imports(imp_path, visited, stdlib_visited, manifold ["_recurse_into_stdlib", _recurse_into_stdlib])
                        result D extend(sub)
                    T cond = → if imp_path ≠ visited → P
                        visited D add(imp_path)
                        result D append(manifold [imp_path, actual_modname, 0])
            ) (D |candidate_names|)
        ) (D |python_ast D walk(tree)|)
        → result
    }
    D ETPLTranslator___find_import_path = λ self, mod . {
        // Find filesystem path for a dotted module name.          ET Identity Principle (Eq 211): the module name (D-descriptor) m
        // @ETPL:preload _os os
        // Import os — resolved at translate-time
        P parts = mod D replace(".", _os D sep)
        T loop = ∞ (
            P path = sys D path[_loop_index]
            T cond = → if (!path) → P  // pass
            P fp = _os D path D join(path, (parts + ".py"))
            T cond = → if _os D path D isfile(fp) → → fp
            P fp = _os D path D join(path, parts, "__init__.py")
            T cond = → if _os D path D isfile(fp) → → fp
        ) (D |sys D path|)
        T attempt = → P  // try
            // @ETPL:preload _ilu importlib.util
            // Import importlib.util — resolved at translate-time
            P spec = _ilu D find_spec(mod)
            T cond = → if (spec ≠ P && spec D origin && spec D origin D endswith(".py")) → T cond = → if os D path D isfile(spec D origin) → → spec D origin
        → E Exception (_)
            // pass
        T cond = → if "." == mod → P
            P top = mod D split(".")[0]
            → self D _find_import_path(top)
        → P
    }
    D ETPLTranslator___convert_source = λ self, source, lang . {
        // Convert source to ETPL using exhaustive AST walking.
        T cond = → if lang == manifold ["python", "py"] → → self D _convert_python(source)
        → E P
            T cond = → if lang == manifold ["c", "c_header", "h"] → → self D _convert_c_header(source)
            → E T cond = → if lang == manifold ["javascript", "js"] → → self D _convert_javascript(source)
        → "// Unsupported language: " + lang
    }
    D ETPLTranslator___convert_python = λ self, source . {
        // Convert Python source to ETPL via exhaustive AST conversion.
        D self_D__emitted_names = set(P)  // self D _emitted_names := set(P)
        T attempt = → P  // try
            P tree = python_ast D parse(source)
        → E SyntaxError (_)
            → "// ETPL: Could not parse Python source"
        P lines = manifold []
        self D _convert_py_node(tree, lines, manifold ["indent", 0])
        → "\n" D join(lines)
    }
    D ETPLTranslator___convert_py_node = λ self, node, lines, indent, class_name . {
        // Exhaustive Python AST → ETPL conversion.          Parameters         ----------         node       : Python AST node to 
        P prefix = ("    " * indent)
        T cond = → if isinstance(node, python_ast D Module) → P
            T loop = ∞ (
                P child = node D body[_loop_index]
                self D _convert_py_node(child, lines, indent, manifold ["class_name", class_name])
            ) (D |node D body|)
        → E P
            T cond = → if isinstance(node, python_ast D FunctionDef) → P
                P params = ", " D join({ T loop = ∞ (if arg D arg == self D _ETPL_NAME_CONFLICTS → "_et_" + arg D arg → E arg D arg) (D |node D args D args|) })
                P raw_name = node D name
                P etpl_name = if class_name → class_name + "__" + raw_name → E raw_name
                P etpl_name = (re D sub("[^a-zA-Z0-9_]", "_", etpl_name) D strip("_") || "_fn")
                P body_lines = manifold []
                T loop = ∞ (
                    P child = node D body[_loop_index]
                    self D _convert_py_node(child, body_lines, (indent + 1), manifold ["class_name", class_name])
                ) (D |node D body|)
                P real_body_lines = { T loop = ∞ (ln → E (ln D strip(P) && (!ln D strip(P) D startswith("//")))) (D |body_lines|) }
                T cond = → if (!real_body_lines) → lines D append(prefix + "D " + etpl_name + " = λ " + params + " . P  // empty body")
                → E P
                    T cond = → if len(body_lines) == 1 → P
                        P body_expr = body_lines[0] D strip(P)
                        lines D append(prefix + "D " + etpl_name + " = λ " + params + " . " + body_expr)
                    → E P
                        lines D append(prefix + "D " + etpl_name + " = λ " + params + " . {")
                        lines D extend(body_lines)
                        lines D append(prefix + "}")
            → E P
                T cond = → if isinstance(node, python_ast D AsyncFunctionDef) → P
                    P params = ", " D join({ T loop = ∞ (if arg D arg == self D _ETPL_NAME_CONFLICTS → "_et_" + arg D arg → E arg D arg) (D |node D args D args|) })
                    P raw_name = node D name
                    P etpl_name = if class_name → class_name + "__" + raw_name → E raw_name
                    P etpl_name = (re D sub("[^a-zA-Z0-9_]", "_", etpl_name) D strip("_") || "_afn")
                    P body_lines = manifold []
                    T loop = ∞ (
                        P child = node D body[_loop_index]
                        self D _convert_py_node(child, body_lines, (indent + 1), manifold ["class_name", class_name])
                    ) (D |node D body|)
                    P real_body_lines = { T loop = ∞ (ln → E (ln D strip(P) && (!ln D strip(P) D startswith("//")))) (D |body_lines|) }
                    T cond = → if (!real_body_lines) → lines D append(prefix + "D " + etpl_name + " = λ " + params + " . P  // empty async body")
                    → E P
                        T cond = → if len(body_lines) == 1 → P
                            P body_expr = body_lines[0] D strip(P)
                            lines D append(prefix + "D " + etpl_name + " = λ " + params + " . " + body_expr + "  // async")
                        → E P
                            lines D append(prefix + "D " + etpl_name + " = λ " + params + " . {  // async")
                            lines D extend(body_lines)
                            lines D append(prefix + "}")
                → E P
                    T cond = → if isinstance(node, python_ast D ClassDef) → P
                        T cond = → if node D bases → P bases = ", " D join({ T loop = ∞ (self D _convert_py_expr(b)) (D |node D bases|) })
                        → E P bases = ""
                        P bases_comment = if bases → "  // class(" + bases + ")" → E "  // class"
                        P safe_class = (re D sub("[^a-zA-Z0-9_]", "_", node D name) D strip("_") || "_cls")
                        lines D append(prefix + "D " + safe_class + " = λ . P" + bases_comment)
                        T loop = ∞ (
                            P child = node D body[_loop_index]
                            self D _convert_py_node(child, lines, (indent + 1), manifold ["class_name", safe_class])
                        ) (D |node D body|)
                    → E P
                        T cond = → if isinstance(node, python_ast D Return) → P
                            P val = if node D value → self D _convert_py_expr(node D value) → E "P"
                            lines D append(prefix + "→ " + val)
                        → E P
                            T cond = → if isinstance(node, python_ast D Assign) → P
                                T loop = ∞ (
                                    P target = node D targets[_loop_index]
                                    P val = self D _convert_py_expr(node D value)
                                    T cond = → if isinstance(target, python_ast D Attribute) → P
                                        P obj = self D _convert_py_expr(target D value)
                                        P attr = target D attr
                                        P etpl_form = obj + " D " + attr
                                        P safe_id = (re D sub("[^a-zA-Z0-9_]", "_", etpl_form) D strip("_") || "_attr")
                                        lines D append(prefix + "D " + safe_id + " = " + val + "  // " + etpl_form + " := " + val)
                                    → E P
                                        T cond = → if isinstance(target, python_ast D Subscript) → P
                                            P obj = self D _convert_py_expr(target D value)
                                            P idx = self D _convert_py_expr(target D slice)
                                            lines D append(prefix + "// " + obj + "[" + idx + "] := " + val)
                                        → E P
                                            T cond = → if isinstance(target, python_ast D Starred) → P
                                                P inner = self D _convert_py_expr(target D value)
                                                lines D append(prefix + "// *" + inner + " := " + val)
                                            → E P
                                                P var = self D _convert_py_expr(target)
                                                T cond = → if (!re D match("^[a-zA-Z_][a-zA-Z0-9_]*$", var)) → P
                                                    P safe_id = (re D sub("[^a-zA-Z0-9_]", "_", var) D strip("_") || "_unpack")
                                                    lines D append(prefix + "P " + safe_id + " = " + val + "  // " + var + " := " + val)
                                                → E lines D append(prefix + "P " + var + " = " + val)
                                ) (D |node D targets|)
                            → E P
                                T cond = → if isinstance(node, python_ast D AugAssign) → P
                                    P op = self D _py_op_to_etpl(node D op)
                                    P val = self D _convert_py_expr(node D value)
                                    T cond = → if isinstance(node D target, python_ast D Attribute) → P
                                        P obj = self D _convert_py_expr(node D target D value)
                                        P attr = node D target D attr
                                        P etpl_form = obj + " D " + attr
                                        P safe_id = (re D sub("[^a-zA-Z0-9_]", "_", etpl_form) D strip("_") || "_attr")
                                        lines D append(prefix + "D " + safe_id + " = " + safe_id + " " + op + " " + val + "  // " + etpl_form + " " + op + "= " + val)
                                    → E P
                                        T cond = → if isinstance(node D target, python_ast D Subscript) → P
                                            P obj = self D _convert_py_expr(node D target D value)
                                            P idx = self D _convert_py_expr(node D target D slice)
                                            lines D append(prefix + "// " + obj + "[" + idx + "] " + op + "= " + val)
                                        → E P
                                            P var = self D _convert_py_expr(node D target)
                                            lines D append(prefix + "P " + var + " = " + var + " " + op + " " + val)
                                → E P
                                    T cond = → if isinstance(node, python_ast D AnnAssign) → P
                                        P val = if node D value → self D _convert_py_expr(node D value) → E "P"
                                        T cond = → if isinstance(node D target, python_ast D Attribute) → P
                                            P obj = self D _convert_py_expr(node D target D value)
                                            P attr = node D target D attr
                                            P etpl_form = obj + " D " + attr
                                            P safe_id = (re D sub("[^a-zA-Z0-9_]", "_", etpl_form) D strip("_") || "_attr")
                                            lines D append(prefix + "D " + safe_id + " = " + val + "  // " + etpl_form + " := " + val)
                                        → E P
                                            P var = self D _convert_py_expr(node D target)
                                            lines D append(prefix + "P " + var + " = " + val)
                                    → E P
                                        T cond = → if isinstance(node, python_ast D For) → P
                                            T cond = → if isinstance(node D target, python_ast D Name) → P
                                                P var = node D target D id
                                                T cond = → if var == self D _ETPL_NAME_CONFLICTS → P var = "_et_" + var
                                                P var_comment = ""
                                            → E P
                                                P target_etpl = self D _convert_py_expr(node D target)
                                                P var = (re D sub("[^a-zA-Z0-9_]", "_", target_etpl) D strip("_") || "_loop_item")
                                                T cond = → if var[0] D isdigit(P) → P var = ("_" + var)
                                                P var_comment = "  // " + target_etpl
                                            P iter_expr = self D _convert_py_expr(node D iter)
                                            lines D append(prefix + "T loop = ∞ (")
                                            lines D append(prefix + "    P " + var + " = " + iter_expr + "[_loop_index]" + var_comment)
                                            T loop = ∞ (
                                                P child = node D body[_loop_index]
                                                self D _convert_py_node(child, lines, (indent + 1), manifold ["class_name", class_name])
                                            ) (D |node D body|)
                                            lines D append(prefix + ") (D |" + iter_expr + "|)")
                                        → E P
                                            T cond = → if isinstance(node, python_ast D While) → P
                                                P cond = self D _convert_py_expr(node D test)
                                                lines D append(prefix + "T while_loop = ∞ (")
                                                lines D append(prefix + "    T check = → if " + cond + " → P  // while body follows")
                                                T loop = ∞ (
                                                    P child = node D body[_loop_index]
                                                    self D _convert_py_node(child, lines, (indent + 2), manifold ["class_name", class_name])
                                                ) (D |node D body|)
                                                lines D append(prefix + ") (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144")
                                            → E P
                                                T cond = → if isinstance(node, python_ast D If) → P
                                                    P cond = self D _convert_py_expr(node D test)
                                                    P body_lines = manifold []
                                                    T loop = ∞ (
                                                        P child = node D body[_loop_index]
                                                        self D _convert_py_node(child, body_lines, (indent + 1), manifold ["class_name", class_name])
                                                    ) (D |node D body|)
                                                    P real_body = { T loop = ∞ (ln → E (ln D strip(P) && (!ln D strip(P) D startswith("//")))) (D |body_lines|) }
                                                    P then_sentinel = if len(real_body) == 1 → real_body[0] D strip(P) → E "P"
                                                    T cond = → if (!real_body) → P
                                                        lines D append(prefix + "T cond = → if " + cond + " → P  // pass")
                                                        → P
                                                    lines D append(prefix + "T cond = → if " + cond + " → " + then_sentinel)
                                                    T cond = → if len(real_body) > 1 → lines D extend(body_lines)
                                                    T cond = → if node D orelse → P
                                                        P else_lines = manifold []
                                                        T loop = ∞ (
                                                            P child = node D orelse[_loop_index]
                                                            self D _convert_py_node(child, else_lines, (indent + 1), manifold ["class_name", class_name])
                                                        ) (D |node D orelse|)
                                                        P real_else = { T loop = ∞ (ln → E (ln D strip(P) && (!ln D strip(P) D startswith("//")))) (D |else_lines|) }
                                                        P else_sentinel = if len(real_else) == 1 → real_else[0] D strip(P) → E "P"
                                                        T cond = → if (!real_else) → lines D append(prefix + "→ E P  // else pass")
                                                        → E P
                                                            lines D append(prefix + "→ E " + else_sentinel)
                                                            T cond = → if len(real_else) > 1 → lines D extend(else_lines)
                                                → E P
                                                    T cond = → if isinstance(node, python_ast D With) → P
                                                        P items = node D items
                                                        T loop = ∞ (
                                                            P manifold__idx__item = enumerate(items)[_loop_index]  // manifold [idx, item]
                                                            P ctx = self D _convert_py_expr(item D context_expr)
                                                            P is_last = idx == (len(items) - 1)
                                                            T cond = → if item D optional_vars ≠ P → P
                                                                P bind_var = self D _convert_py_expr(item D optional_vars)
                                                                T cond = → if isinstance(item D optional_vars, python_ast D Name) → P bind_name = item D optional_vars D id
                                                                → E P bind_name = (re D sub("[^a-zA-Z0-9_]", "_", bind_var) D strip("_") || "_ctx")
                                                                lines D append(prefix + "T scope_" + bind_name + " = → " + ctx)
                                                                lines D append(prefix + "P " + bind_name + " = scope_" + bind_name + "  // context var")
                                                            → E P
                                                                P scope_id = "scope_" + idx
                                                                lines D append(prefix + "T " + scope_id + " = → " + ctx)
                                                            T cond = → if is_last → P
                                                                T loop = ∞ (
                                                                    P child = node D body[_loop_index]
                                                                    self D _convert_py_node(child, lines, (indent + 1), manifold ["class_name", class_name])
                                                                ) (D |node D body|)
                                                        ) (D |enumerate(items)|)
                                                    → E P
                                                        T cond = → if isinstance(node, python_ast D Try) → P
                                                            lines D append(prefix + "T attempt = → P  // try")
                                                            T loop = ∞ (
                                                                P child = node D body[_loop_index]
                                                                self D _convert_py_node(child, lines, (indent + 1), manifold ["class_name", class_name])
                                                            ) (D |node D body|)
                                                            T loop = ∞ (
                                                                P handler = node D handlers[_loop_index]
                                                                T cond = → if handler D type == P → P exc_type = "Exception"
                                                                → E P exc_type = self D _convert_py_expr(handler D type)
                                                                P exc_name = (handler D name || "_")
                                                                lines D append(prefix + "→ E " + exc_type + " (" + exc_name + ")")
                                                                T loop = ∞ (
                                                                    P child = handler D body[_loop_index]
                                                                    self D _convert_py_node(child, lines, (indent + 1), manifold ["class_name", class_name])
                                                                ) (D |handler D body|)
                                                            ) (D |node D handlers|)
                                                            T cond = → if node D finalbody → P
                                                                lines D append(prefix + "// finally:")
                                                                T loop = ∞ (
                                                                    P child = node D finalbody[_loop_index]
                                                                    self D _convert_py_node(child, lines, (indent + 1), manifold ["class_name", class_name])
                                                                ) (D |node D finalbody|)
                                                        → E P
                                                            T cond = → if isinstance(node, python_ast D Import) → P
                                                                T loop = ∞ (
                                                                    P alias = node D names[_loop_index]
                                                                    P modname = alias D name
                                                                    P local_name = (alias D asname || modname D replace(".", "_"))
                                                                    P safe_name = re D sub("[^a-zA-Z0-9_]", "_", local_name)
                                                                    P mod = self D _resolve_module(modname)
                                                                    T cond = → if mod ≠ P → P
                                                                        lines D append(prefix + "// @ETPL:preload " + safe_name + " " + modname)
                                                                        lines D append(prefix + "// Import " + modname + " — resolved at translate-time")
                                                                        P export_names = if hasattr(mod, "__all__") → list(mod D __all__) → E { T loop = ∞ (n → E (!n D startswith("_"))) (D |dir(mod)|) }
                                                                        T loop = ∞ (
                                                                            P ename = export_names[_loop_index]
                                                                            T attempt = → P  // try
                                                                                P value = getattr(mod, ename, P)
                                                                            → E Exception (_)
                                                                                P value = P
                                                                            P attr_safe = re D sub("[^a-zA-Z0-9_]", "_", ename)
                                                                            T loop = ∞ (
                                                                                P ln = self D _value_to_etpl_lines(attr_safe, value, modname + "." + ename, prefix)[_loop_index]
                                                                                lines D append(ln)
                                                                            ) (D |self D _value_to_etpl_lines(attr_safe, value, modname + "." + ename, prefix)|)
                                                                        ) (D |export_names|)
                                                                    → E lines D append(prefix + "// @ETPL:unresolvable " + modname)
                                                                ) (D |node D names|)
                                                            → E P
                                                                T cond = → if isinstance(node, python_ast D ImportFrom) → P
                                                                    P mod = (node D module || "")
                                                                    P resolved_mod = if mod → self D _resolve_module(mod) → E P
                                                                    T loop = ∞ (
                                                                        P alias = node D names[_loop_index]
                                                                        T cond = → if alias D name == "*" → P
                                                                            lines D append(prefix + "// @ETPL:wildcard-start " + mod)
                                                                            T cond = → if resolved_mod ≠ P → P
                                                                                T loop = ∞ (
                                                                                    P ln = self D _expand_module_exports(resolved_mod, mod, manifold ["prefix", prefix])[_loop_index]
                                                                                    lines D append(ln)
                                                                                ) (D |self D _expand_module_exports(resolved_mod, mod, manifold ["prefix", prefix])|)
                                                                            → E lines D append(prefix + "// @ETPL:unresolvable-wildcard " + (mod || "(relative)"))
                                                                            lines D append(prefix + "// @ETPL:wildcard-end " + mod)
                                                                        → E P
                                                                            P local_name = (alias D asname || alias D name)
                                                                            P safe_name = re D sub("[^a-zA-Z0-9_]", "_", local_name)
                                                                            T cond = → if resolved_mod ≠ P → P
                                                                                T attempt = → P  // try
                                                                                    P value = getattr(resolved_mod, alias D name, P)
                                                                                → E Exception (_)
                                                                                    P value = P
                                                                                T loop = ∞ (
                                                                                    P ln = self D _value_to_etpl_lines(safe_name, value, mod + "." + alias D name, prefix)[_loop_index]
                                                                                    lines D append(ln)
                                                                                ) (D |self D _value_to_etpl_lines(safe_name, value, mod + "." + alias D name, prefix)|)
                                                                            → E lines D append(prefix + "// @ETPL:unresolvable " + mod + "." + alias D name)
                                                                    ) (D |node D names|)
                                                                → E P
                                                                    T cond = → if isinstance(node, python_ast D Expr) → P
                                                                        T cond = → if (isinstance(node D value, python_ast D Constant) && isinstance(node D value D value, str)) → P
                                                                            P doc = node D value D value D replace("\n", " ") D replace("\r", "") D strip(P)
                                                                            T cond = → if doc → lines D append(prefix + "// " + doc[0:120])
                                                                            → P
                                                                        T cond = → if isinstance(node D value, python_ast D Call) → P
                                                                            P func_name = self D _convert_py_expr(node D value D func)
                                                                            T cond = → if func_name == "print" → P
                                                                                P conv_args = { T loop = ∞ (self D _convert_py_expr(a)) (D |node D value D args|) }
                                                                                T cond = → if (!conv_args) → P args = "P"
                                                                                → E P
                                                                                    T cond = → if len(conv_args) == 1 → P args = conv_args[0]
                                                                                    → E P args = " + \" \" + " D join(conv_args)
                                                                                lines D append(prefix + "sovereign_print ∘ " + args)
                                                                                → P
                                                                        P val = self D _convert_py_expr(node D value)
                                                                        T cond = → if val D strip(P) → lines D append(prefix + val)
                                                                    → E P
                                                                        T cond = → if isinstance(node, python_ast D Pass) → lines D append(prefix + "// pass")
                                                                        → E P
                                                                            T cond = → if isinstance(node, python_ast D Break) → lines D append(prefix + "// break")
                                                                            → E P
                                                                                T cond = → if isinstance(node, python_ast D Continue) → lines D append(prefix + "// continue")
                                                                                → E P
                                                                                    T cond = → if isinstance(node, python_ast D Raise) → P
                                                                                        P exc = if node D exc → self D _convert_py_expr(node D exc) → E "P"
                                                                                        lines D append(prefix + "→ E " + exc)
                                                                                    → E P
                                                                                        T cond = → if isinstance(node, python_ast D Assert) → P
                                                                                            P test = self D _convert_py_expr(node D test)
                                                                                            lines D append(prefix + "T assert = → if " + test + " → \"ok\" → E \"Assertion failed\"")
                                                                                        → E P
                                                                                            T cond = → if isinstance(node, python_ast D Global) → P
                                                                                                T loop = ∞ (
                                                                                                    P name = node D names[_loop_index]
                                                                                                    lines D append(prefix + "// global " + name)
                                                                                                ) (D |node D names|)
                                                                                            → E P
                                                                                                T cond = → if isinstance(node, python_ast D Nonlocal) → P
                                                                                                    T loop = ∞ (
                                                                                                        P name = node D names[_loop_index]
                                                                                                        lines D append(prefix + "// nonlocal " + name)
                                                                                                    ) (D |node D names|)
                                                                                                → E P
                                                                                                    T cond = → if isinstance(node, python_ast D Delete) → P
                                                                                                        T loop = ∞ (
                                                                                                            P target = node D targets[_loop_index]
                                                                                                            lines D append(prefix + "// del " + python_ast D unparse(target))
                                                                                                        ) (D |node D targets|)
                                                                                                    → E P
                                                                                                        T cond = → if isinstance(node, python_ast D Yield) → P
                                                                                                            P val = if node D value → self D _convert_py_expr(node D value) → E "P"
                                                                                                            lines D append(prefix + "→ " + val + "  // yield")
                                                                                                        → E P
                                                                                                            T cond = → if isinstance(node, python_ast D YieldFrom) → P
                                                                                                                P val = self D _convert_py_expr(node D value)
                                                                                                                lines D append(prefix + "→ " + val + "  // yield from")
                                                                                                            → E P
                                                                                                                T cond = → if if hasattr(python_ast, "Match") → isinstance(node, python_ast D Match) → E 0 → P
                                                                                                                    lines D append(prefix + "// match (structural pattern)")
                                                                                                                    T loop = ∞ (
                                                                                                                        P case = node D cases[_loop_index]
                                                                                                                        T attempt = → P  // try
                                                                                                                            P pattern_raw = python_ast D unparse(case D pattern)
                                                                                                                        → E Exception (_)
                                                                                                                            P pattern_raw = "_pattern"
                                                                                                                        P pattern_safe = pattern_raw D replace(".", "_")
                                                                                                                        lines D append(prefix + "T case = [0/0] (" + pattern_safe + ")  // " + pattern_raw)
                                                                                                                        T loop = ∞ (
                                                                                                                            P child = case D body[_loop_index]
                                                                                                                            self D _convert_py_node(child, lines, (indent + 2), manifold ["class_name", class_name])
                                                                                                                        ) (D |case D body|)
                                                                                                                    ) (D |node D cases|)
                                                                                                                → E P
                                                                                                                    T attempt = → P  // try
                                                                                                                        P raw = python_ast D unparse(node)
                                                                                                                        T cond = → if raw D strip(P) → lines D append(prefix + "// " + raw)
                                                                                                                    → E Exception (_)
                                                                                                                        // pass
    }
    D ETPLTranslator___py_op_to_etpl = λ self, op . {
        // Convert Python operator to ETPL.
        P op_map = manifold [manifold [python_ast D Add, "+"], manifold [python_ast D Sub, "-"], manifold [python_ast D Mult, "*"], manifold [python_ast D Div, "/"], manifold [python_ast D FloorDiv, "÷"], manifold [python_ast D Mod, "%"], manifold [python_ast D Pow, "^"], manifold [python_ast D LShift, "<<"], manifold [python_ast D RShift, ">>"], manifold [python_ast D BitOr, "|"], manifold [python_ast D BitAnd, "&"], manifold [python_ast D BitXor, "^"]]
        → op_map D get(type(op), "+")
    }
    D ETPLTranslator___convert_py_expr = λ self, node . {
        // Convert Python expression AST node to ETPL syntax.         Replaces python_ast.unparse() for all expression nodes so out
        T cond = → if node == P → → "P"
        T cond = → if isinstance(node, python_ast D Attribute) → P
            P obj = self D _convert_py_expr(node D value)
            → obj + " D " + node D attr
        T cond = → if isinstance(node, python_ast D Name) → P
            P name = node D id
            T cond = → if name == self D _ETPL_NAME_CONFLICTS → → "_et_" + name
            → name
        T cond = → if isinstance(node, python_ast D Constant) → P
            T cond = → if node D value == P → → "P"
            T cond = → if isinstance(node D value, bool) → → if node D value → "1" → E "0"
            T cond = → if isinstance(node D value, str) → P
                P escaped = str(node D value) D replace("\\", "\\\\") D replace("\"", "\\\"") D replace("\n", "\\n") D replace("\r", "\\r") D replace("\t", "\\t")
                → "\"" + escaped + "\""
            → str(node D value)
        T cond = → if isinstance(node, python_ast D JoinedStr) → P
            P parts = manifold []
            T loop = ∞ (
                P v = node D values[_loop_index]
                T cond = → if isinstance(v, python_ast D Constant) → P
                    P escaped = str(v D value) D replace("\\", "\\\\") D replace("\"", "\\\"") D replace("\n", "\\n") D replace("\r", "\\r") D replace("\t", "\\t")
                    parts D append("\"" + escaped + "\"")
                → E P
                    T cond = → if isinstance(v, python_ast D FormattedValue) → parts D append(self D _convert_py_expr(v D value))
                    → E parts D append(self D _convert_py_expr(v))
            ) (D |node D values|)
            → if parts → " + " D join(parts) → E "\"\""
        T cond = → if isinstance(node, python_ast D BinOp) → P
            P left = self D _convert_py_expr(node D left)
            P right = self D _convert_py_expr(node D right)
            P op = self D _py_op_to_etpl(node D op)
            → "(" + left + " " + op + " " + right + ")"
        T cond = → if isinstance(node, python_ast D UnaryOp) → P
            P operand = self D _convert_py_expr(node D operand)
            T cond = → if isinstance(node D op, python_ast D USub) → → "(-" + operand + ")"
            T cond = → if isinstance(node D op, python_ast D Not) → → "(!" + operand + ")"
            T cond = → if isinstance(node D op, python_ast D Invert) → → "(-" + operand + " - 1)"
            → operand
        T cond = → if isinstance(node, python_ast D BoolOp) → P
            P op = if isinstance(node D op, python_ast D Or) → "||" → E "&&"
            P parts = { T loop = ∞ (self D _convert_py_expr(v)) (D |node D values|) }
            → "(" + " " + op + " " D join(parts) + ")"
        T cond = → if isinstance(node, python_ast D Compare) → P
            P left = self D _convert_py_expr(node D left)
            P parts = manifold [left]
            P cmp_map = manifold [manifold [python_ast D Eq, "=="], manifold [python_ast D NotEq, "≠"], manifold [python_ast D Lt, "<"], manifold [python_ast D LtE, "≤"], manifold [python_ast D Gt, ">"], manifold [python_ast D GtE, "≥"], manifold [python_ast D Is, "=="], manifold [python_ast D IsNot, "≠"], manifold [python_ast D In, "=="], manifold [python_ast D NotIn, "≠"]]
            T loop = ∞ (
                P manifold__op__comp = zip(node D ops, node D comparators)[_loop_index]  // manifold [op, comp]
                parts D append(cmp_map D get(type(op), "=="))
                parts D append(self D _convert_py_expr(comp))
            ) (D |zip(node D ops, node D comparators)|)
            → " " D join(parts)
        T cond = → if isinstance(node, python_ast D Subscript) → P
            P obj = self D _convert_py_expr(node D value)
            P idx = self D _convert_py_expr(node D slice)
            → obj + "[" + idx + "]"
        T cond = → if isinstance(node, python_ast D Slice) → P
            P lower = if node D lower → self D _convert_py_expr(node D lower) → E "0"
            P upper = if node D upper → self D _convert_py_expr(node D upper) → E "Ω"
            → lower + ":" + upper
        T cond = → if isinstance(node, python_ast D Call) → P
            P func = self D _convert_py_expr(node D func)
            P pos_parts = { T loop = ∞ (self D _convert_py_expr(a)) (D |node D args|) }
            P kw_parts = manifold []
            T loop = ∞ (
                P kw = (node D keywords || manifold [])[_loop_index]
                P kv = self D _convert_py_expr(kw D value)
                T cond = → if kw D arg → kw_parts D append("manifold [\"" + kw D arg + "\", " + kv + "]")
                → E kw_parts D append(kv)
            ) (D |(node D keywords || manifold [])|)
            P all_parts = (pos_parts + kw_parts)
            T cond = → if (!all_parts) → → func + "(P)"
            → func + "(" + ", " D join(all_parts) + ")"
        T cond = → if isinstance(node, python_ast D List) → P
            P elts = ", " D join({ T loop = ∞ (self D _convert_py_expr(e)) (D |node D elts|) })
            → "manifold [" + elts + "]"
        T cond = → if isinstance(node, python_ast D Tuple) → P
            P elts = ", " D join({ T loop = ∞ (self D _convert_py_expr(e)) (D |node D elts|) })
            → "manifold [" + elts + "]"
        T cond = → if isinstance(node, python_ast D Dict) → P
            P pairs = manifold []
            T loop = ∞ (
                P manifold__k__v = zip(node D keys, node D values)[_loop_index]  // manifold [k, v]
                T cond = → if k == P → pairs D append(self D _convert_py_expr(v))
                → E P
                    P kexpr = self D _convert_py_expr(k)
                    P vexpr = self D _convert_py_expr(v)
                    pairs D append("manifold [" + kexpr + ", " + vexpr + "]")
            ) (D |zip(node D keys, node D values)|)
            → "manifold [" + ", " D join(pairs) + "]"
        T cond = → if isinstance(node, python_ast D Set) → P
            P elts = ", " D join({ T loop = ∞ (self D _convert_py_expr(e)) (D |node D elts|) })
            → "manifold [" + elts + "]"
        T cond = → if isinstance(node, python_ast D ListComp) → P
            T cond = → if node D generators → P
                P gen = node D generators[0]
                P target = self D _convert_py_expr(gen D target)
                P iter_expr = self D _convert_py_expr(gen D iter)
                P elt = self D _convert_py_expr(node D elt)
                P conds = manifold []
                T loop = ∞ (
                    P g = node D generators[_loop_index]
                    T loop = ∞ (
                        P if_clause = g D ifs[_loop_index]
                        conds D append(self D _convert_py_expr(if_clause))
                    ) (D |g D ifs|)
                ) (D |node D generators|)
                P cond_suffix = if conds → (" → E " + " && " D join(conds)) → E ""
                → "{ T loop = ∞ (" + elt + cond_suffix + ") (D |" + iter_expr + "|) }"
            → "manifold []"
        T cond = → if isinstance(node, manifold [python_ast D GeneratorExp, python_ast D SetComp]) → P
            T cond = → if node D generators → P
                P gen = node D generators[0]
                P elt = self D _convert_py_expr(node D elt)
                P iter_expr = self D _convert_py_expr(gen D iter)
                P conds = manifold []
                T loop = ∞ (
                    P g = node D generators[_loop_index]
                    T loop = ∞ (
                        P if_clause = g D ifs[_loop_index]
                        conds D append(self D _convert_py_expr(if_clause))
                    ) (D |g D ifs|)
                ) (D |node D generators|)
                P cond_suffix = if conds → (" → E " + " && " D join(conds)) → E ""
                → "{ T loop = ∞ (" + elt + cond_suffix + ") (D |" + iter_expr + "|) }"
            → "manifold []"
        T cond = → if isinstance(node, python_ast D DictComp) → P
            T cond = → if node D generators → P iter_expr = self D _convert_py_expr(node D generators[0] D iter)
            → E P iter_expr = "0"
            → "{ T loop = ∞ (P item = " + iter_expr + "[_loop_index]) (D |" + iter_expr + "|) }"
        T cond = → if isinstance(node, python_ast D IfExp) → P
            P cond = self D _convert_py_expr(node D test)
            P body = self D _convert_py_expr(node D body)
            P orelse = self D _convert_py_expr(node D orelse)
            → "if " + cond + " → " + body + " → E " + orelse
        T cond = → if isinstance(node, python_ast D Lambda) → P
            P params = ", " D join({ T loop = ∞ (if arg D arg == self D _ETPL_NAME_CONFLICTS → "_et_" + arg D arg → E arg D arg) (D |node D args D args|) })
            P body = self D _convert_py_expr(node D body)
            → "λ " + params + " . " + body
        T cond = → if isinstance(node, python_ast D Starred) → → self D _convert_py_expr(node D value)
        T cond = → if isinstance(node, python_ast D NamedExpr) → P
            P val = self D _convert_py_expr(node D value)
            P name = node D target D id
            T cond = → if name == self D _ETPL_NAME_CONFLICTS → P name = "_et_" + name
            → "(λ " + name + " . " + name + ")(" + val + ")"
        T cond = → if isinstance(node, python_ast D Await) → → self D _convert_py_expr(node D value)
        T cond = → if isinstance(node, python_ast D Yield) → P
            P val = if node D value → self D _convert_py_expr(node D value) → E "P"
            → "→ " + val
        T attempt = → P  // try
            P raw = python_ast D unparse(node)
            → "// " + raw
        → E Exception (_)
            → "// P"
    }
    D ETPLTranslator___convert_c_header = λ self, source . {
        // Convert C/C++ header to ETPL.
        P lines = manifold []
        T loop = ∞ (
            P match = re D finditer("#define\\s+(\\w+)\\s+(.*)", source)[_loop_index]
            P manifold__name__val = match D groups(P)  // manifold [name, val] := match D groups(P)
            lines D append("D " + name + " = " + val D strip(P))
        ) (D |re D finditer("#define\\s+(\\w+)\\s+(.*)", source)|)
        T loop = ∞ (
            P match = re D finditer("#include\\s+[<\"](.+?)[>\"]", source)[_loop_index]
            P header = match D group(1) D replace(".", "_") D replace("/", "_")
            lines D append("// @ETPL:preload " + header + " " + match D group(1))
        ) (D |re D finditer("#include\\s+[<\"](.+?)[>\"]", source)|)
        T loop = ∞ (
            P match = re D finditer("typedef\\s+struct\\s+\\w*\\s*\\{([^}]*)\\}\\s*(\\w+)", source, re D DOTALL)[_loop_index]
            P manifold__body__name = match D groups(P)  // manifold [body, name] := match D groups(P)
            lines D append("D " + name + " = λ .  // struct")
            T loop = ∞ (
                P field = re D finditer("(\\w+)\\s+(\\w+)\\s*;", body)[_loop_index]
                P manifold__ftype__fname = field D groups(P)  // manifold [ftype, fname] := field D groups(P)
                lines D append("    P " + fname + " = 0  // " + ftype)
            ) (D |re D finditer("(\\w+)\\s+(\\w+)\\s*;", body)|)
        ) (D |re D finditer("typedef\\s+struct\\s+\\w*\\s*\\{([^}]*)\\}\\s*(\\w+)", source, re D DOTALL)|)
        T loop = ∞ (
            P match = re D finditer("(\\w+)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*;", source)[_loop_index]
            P manifold__ret__name__params = match D groups(P)  // manifold [ret, name, params] := match D groups(P)
            P param_list = ", " D join({ T loop = ∞ (p D strip(P) D split(P)[(-1)] → E p D strip(P)) (D |params D split(",")|) })
            lines D append("D " + name + " = λ " + param_list + " .  // → " + ret)
        ) (D |re D finditer("(\\w+)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*;", source)|)
        → "\n" D join(lines)
    }
    D ETPLTranslator___convert_javascript = λ self, source . {
        // Convert JavaScript to ETPL via regex patterns.
        P lines = manifold []
        T loop = ∞ (
            P match = re D finditer("function\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*\\{", source)[_loop_index]
            P manifold__name__params = match D groups(P)  // manifold [name, params] := match D groups(P)
            lines D append("D " + name + " = λ " + params + " .")
        ) (D |re D finditer("function\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*\\{", source)|)
        T loop = ∞ (
            P match = re D finditer("(?:const|let|var)\\s+(\\w+)\\s*=\\s*\\(([^)]*)\\)\\s*=>", source)[_loop_index]
            P manifold__name__params = match D groups(P)  // manifold [name, params] := match D groups(P)
            lines D append("D " + name + " = λ " + params + " .")
        ) (D |re D finditer("(?:const|let|var)\\s+(\\w+)\\s*=\\s*\\(([^)]*)\\)\\s*=>", source)|)
        T loop = ∞ (
            P match = re D finditer("(?:const|let|var)\\s+(\\w+)\\s*=\\s*([^;]+)", source)[_loop_index]
            P manifold__name__val = match D groups(P)  // manifold [name, val] := match D groups(P)
            T cond = → if ("=>" ≠ val && "function" ≠ val) → lines D append("P " + name + " = " + val D strip(P))
        ) (D |re D finditer("(?:const|let|var)\\s+(\\w+)\\s*=\\s*([^;]+)", source)|)
        T loop = ∞ (
            P match = re D finditer("console\\.log\\((.+?)\\)", source)[_loop_index]
            lines D append("sovereign_print ∘ " + match D group(1))
        ) (D |re D finditer("console\\.log\\((.+?)\\)", source)|)
        T loop = ∞ (
            P match = re D finditer("class\\s+(\\w+)\\s*(?:extends\\s+(\\w+))?\\s*\\{", source)[_loop_index]
            P manifold__name__base = match D groups(P)  // manifold [name, base] := match D groups(P)
            P bases = if base → "  // extends " + base → E ""
            lines D append("D " + name + " = λ ." + bases)
        ) (D |re D finditer("class\\s+(\\w+)\\s*(?:extends\\s+(\\w+))?\\s*\\{", source)|)
        → "\n" D join(lines)
    }
D verify_etpl = λ  . {
    // Run comprehensive ETPL self-verification suite.
    sovereign_print ∘ ("=" * 70)
    sovereign_print ∘ "  ETPL Self-Verification Suite"
    sovereign_print ∘ "  Version: " + ETPL_VERSION + " | Build: " + ETPL_BUILD
    sovereign_print ∘ "  Platform: " + platform D system(P) + " " + platform D machine(P)
    sovereign_print ∘ ("=" * 70)
    P tests_passed = 0
    P tests_failed = 0
    D check = λ name, condition . {
        // nonlocal tests_passed
        // nonlocal tests_failed
        T cond = → if condition → P
            P tests_passed = tests_passed + 1
            sovereign_print ∘ "  ✓ " + name
        → E P
            P tests_failed = tests_failed + 1
            sovereign_print ∘ "  ✗ " + name
    }
    sovereign_print ∘ "\n[1] ET Constants Verification"
    check("MANIFOLD_SYMMETRY = 12", MANIFOLD_SYMMETRY == 12)
    check("BASE_VARIANCE = 1/12", _et_abs((BASE_VARIANCE - (1.0 / 12.0))) < 1e-15)
    check("KOIDE_RATIO = 2/3", _et_abs((KOIDE_RATIO - (2.0 / 3.0))) < 1e-15)
    check("Cosmological ratios sum to 1.0", _et_abs((((DARK_ENERGY_RATIO + DARK_MATTER_RATIO) + ORDINARY_MATTER_RATIO) - 1.0)) < 0.01)
    sovereign_print ∘ "\n[2] ET Primitives"
    P p = Point(manifold ["location", "test"], manifold ["state", 42])
    check("Point creation", (p D location == "test" && p D state == 42))
    P d = Descriptor(manifold ["name", "square"], manifold ["constraint", λ x . (x ^ 2)])
    check("Descriptor creation", (d D name == "square" && d D constraint(5) == 25))
    P t = Traverser(manifold ["identity", "agent"])
    check("Traverser creation", t D identity == "agent")
    P e = bind_pdt(p, d, t)
    check("bind_pdt (P∘D∘T=E)", isinstance(e, ETException))
    sovereign_print ∘ "\n[3] Tokenizer"
    P tokenizer = ETPLTokenizer(P)
    P toks = tokenizer D tokenize("P x = 42")
    check("Simple tokenize", len(toks) == 5)
    P toks = tokenizer D tokenize("D add = λ a, b . a + b")
    check("Lambda with commas tokenize", (any({ T loop = ∞ (t D type == TokenType D LAMBDA) (D |toks|) }) && any({ T loop = ∞ (t D type == TokenType D COMMA) (D |toks|) })))
    P toks = tokenizer D tokenize("// comment\nP x = 1")
    check("Comment skipping", (!any({ T loop = ∞ (t D value == "comment") (D |toks|) })))
    P toks = tokenizer D tokenize("T c = [0/0] \"a\" | \"b\"")
    check("Indeterminate tokenize", any({ T loop = ∞ (t D type == TokenType D INDETERMINATE) (D |toks|) }))
    P toks = tokenizer D tokenize("P pi = 3.14159")
    check("Float tokenize", any({ T loop = ∞ (t D type == TokenType D FLOAT) (D |toks|) }))
    P toks = tokenizer D tokenize("P msg = \"Hello, ETPL!\"")
    check("String tokenize", any({ T loop = ∞ (t D type == TokenType D STRING) (D |toks|) }))
    P toks = tokenizer D tokenize("ψ(1, 0, 0)")
    check("Quantum ψ tokenize", any({ T loop = ∞ (t D type == TokenType D PSI) (D |toks|) }))
    P toks = tokenizer D tokenize("∑ ∏ ∫ ∇ √")
    check("Math symbol tokenize", (any({ T loop = ∞ (t D type == TokenType D SIGMA) (D |toks|) }) && any({ T loop = ∞ (t D type == TokenType D SQRT) (D |toks|) })))
    P toks = tokenizer D tokenize("P r = 10 % 3")
    check("Modulo tokenize (%)", any({ T loop = ∞ (t D type == TokenType D MODULO) (D |toks|) }))
    P toks = tokenizer D tokenize("P a = 1 && 0")
    check("Logical AND tokenize (&&)", any({ T loop = ∞ (t D type == TokenType D LOGICAL_AND) (D |toks|) }))
    P toks = tokenizer D tokenize("P b = 1 || 0")
    check("Logical OR tokenize (||)", any({ T loop = ∞ (t D type == TokenType D LOGICAL_OR) (D |toks|) }))
    P toks = tokenizer D tokenize("P c = !0")
    check("Logical NOT tokenize (!)", any({ T loop = ∞ (t D type == TokenType D LOGICAL_NOT) (D |toks|) }))
    P toks = tokenizer D tokenize("P x = 1 and 0")
    check("Keyword 'and' -> LOGICAL_AND", any({ T loop = ∞ (t D type == TokenType D LOGICAL_AND) (D |toks|) }))
    P toks = tokenizer D tokenize("P x = 0 or 1")
    check("Keyword 'or' -> LOGICAL_OR", any({ T loop = ∞ (t D type == TokenType D LOGICAL_OR) (D |toks|) }))
    P toks = tokenizer D tokenize("P x = not 1")
    check("Keyword 'not' -> LOGICAL_NOT", any({ T loop = ∞ (t D type == TokenType D LOGICAL_NOT) (D |toks|) }))
    sovereign_print ∘ "\n[4] Parser"
    P parser = ETPLParser(P)
    P ast = parser D parse("P x = 42")
    check("Parse P declaration", ast D children[0] D node_type == ASTNodeType D POINT_DECL)
    P ast = parser D parse("D add = λ a, b . a + b")
    check("Parse D lambda (comma params)", ast D children[0] D params == manifold ["a", "b"])
    P ast = parser D parse("P items = manifold [1, 2, 3]")
    check("Parse manifold", ast D children[0] D body D node_type == ASTNodeType D MANIFOLD)
    P ast = parser D parse("T loop = ∞ (P x = 1) (D 3)")
    check("Parse loop", ast D children[0] D body D node_type == ASTNodeType D LOOP)
    P ast = parser D parse("P wave = ψ(1, 0, 0)")
    check("Parse ψ(n,l,m)", ast D children[0] D body D node_type == ASTNodeType D QUANTUM_WAVE)
    P ast = parser D parse("D add = λ a, b . a + b\nD sub = λ a, b . a - b")
    check("Parse multi D (no D-as-member collision)", (len(ast D children) == 2 && ast D children[1] D name == "sub"))
    P ast = parser D parse("add(3, 7)")
    check("Parse parenthesized call", ast D children[0] D node_type == ASTNodeType D CALL)
    P ast = parser D parse("if x > 0 → 1 → E 0")
    check("Parse if-else", ast D children[0] D node_type == ASTNodeType D IF_EXPR)
    P ast = parser D parse("P r = 10 % 3")
    check("Parse modulo (%)", ast D children[0] D body D op == "%")
    P ast = parser D parse("P a = x && y")
    check("Parse logical AND", (ast D children[0] D body D node_type == ASTNodeType D LOGICAL_OP && ast D children[0] D body D op == "&&"))
    P ast = parser D parse("P b = x || y")
    check("Parse logical OR", (ast D children[0] D body D node_type == ASTNodeType D LOGICAL_OP && ast D children[0] D body D op == "||"))
    P ast = parser D parse("P c = !x")
    check("Parse logical NOT", (ast D children[0] D body D node_type == ASTNodeType D LOGICAL_OP && ast D children[0] D body D op == "!"))
    P ast = parser D parse("D f = λ x . { P r = x + 1 }")
    check("Parse brace block body (lambda)", ast D children[0] D node_type == ASTNodeType D DESCRIPTOR_DECL)
    sovereign_print ∘ "\n[5] Interpreter — Core"
    P interp = ETPLInterpreter(P)
    interp D interpret("P x = 42")
    check("Interpret P", interp D env D get("x") == 42)
    interp D interpret("P pi = 3.14159")
    check("Interpret float", _et_abs((interp D env D get("pi", 0) - 3.14159)) < 1e-05)
    interp D interpret("P msg = \"Hello\"")
    check("Interpret string", interp D env D get("msg") == "Hello")
    interp D interpret("P items = manifold [10, 20, 30]")
    check("Interpret manifold", interp D env D get("items") == manifold [10, 20, 30])
    interp D interpret("P total = 5 + 3")
    check("Interpret addition", interp D env D get("total") == 8)
    interp D interpret("P safe = 1 / 0")
    check("Division by zero → ∞", interp D env D get("safe") == float("inf"))
    interp D interpret("P zz = 0 / 0")
    check("0/0 → 0 (indeterminate resolved)", interp D env D get("zz") == 0)
    sovereign_print ∘ "\n[6] Interpreter — Functions & Recursion"
    P i2 = ETPLInterpreter(P)
    P r = i2 D interpret("D add = λ a, b . a + b\nadd ∘ 3 ∘ 7")
    check("Multi-arg D (compose chain)", r == 10)
    P i3 = ETPLInterpreter(P)
    P r = i3 D interpret("D mul = λ x, y . x * y\nmul(3, 7)")
    check("Parenthesized call D(a,b)", r == 21)
    P i4 = ETPLInterpreter(P)
    P r = i4 D interpret("D fact = λ n . if n > 1 → n * (fact ∘ (n - 1)) → E 1\nfact ∘ 5")
    check("Recursive factorial", r == 120)
    P i5 = ETPLInterpreter(P)
    P r = i5 D interpret("D fib = λ n . if n < 2 → n → E (fib ∘ (n - 1)) + (fib ∘ (n - 2))\nfib ∘ 10")
    check("Recursive fibonacci", r == 55)
    P i6 = ETPLInterpreter(P)
    P r = i6 D interpret("D add = λ a, b . a + b\nD add5 = add ∘ 5\nadd5 ∘ 3")
    check("Currying (partial application)", r == 8)
    P i7 = ETPLInterpreter(P)
    P r = i7 D interpret("D apply = λ f, x . f ∘ x\nD dbl = λ n . n * 2\napply(dbl, 5)")
    check("Higher-order functions", r == 10)
    sovereign_print ∘ "\n[7] Interpreter — Control Flow"
    P i8 = ETPLInterpreter(P)
    P r = i8 D interpret("P x = 42\nif x > 10 → \"big\" → E \"small\"")
    check("If-else expression", r == "big")
    P i9 = ETPLInterpreter(P)
    P r = i9 D interpret("P total = 0\nT loop = ∞ (P total = total + _loop_index) (D 10)\ntotal")
    check("Loop accumulation", r == 45)
    P i10 = ETPLInterpreter(P)
    P r = i10 D interpret("T res = → undefined_var → E 42")
    check("Exception path handler", r == 42)
    P i11 = ETPLInterpreter(P)
    P r = i11 D interpret("P wave = ψ(1, 0, 0)")
    check("Quantum ψ(n,l,m)", (isinstance(r, manifold [int, float]) && r ≠ 0))
    P i12 = ETPLInterpreter(P)
    P r = i12 D interpret("P m = manifold [1, 2, 3, 4, 5]\n∑ m")
    check("Manifold ∑ sum", r == 15)
    P i13 = ETPLInterpreter(P)
    P r = i13 D interpret("P m = manifold [2, 3, 4]\n∏ m")
    check("Manifold ∏ product", r == 24)
    sovereign_print ∘ "\n[7b] Interpreter — v1.1.0 Features"
    P i14 = ETPLInterpreter(P)
    P r = i14 D interpret("P r = 10 % 3")
    check("Modulo: 10 % 3 = 1", r == 1)
    P i15 = ETPLInterpreter(P)
    P r = i15 D interpret("P r = 7 % 3")
    check("Modulo: 7 % 3 = 1", r == 1)
    P i16 = ETPLInterpreter(P)
    P r = i16 D interpret("P r = 5 % 0")
    check("Modulo by zero -> 0 (ET ground)", r == 0)
    P i17 = ETPLInterpreter(P)
    P r = i17 D interpret("P r = 1 && 1")
    check("Logical AND: 1 && 1 = 1", r == 1)
    P i18 = ETPLInterpreter(P)
    P r = i18 D interpret("P r = 1 && 0")
    check("Logical AND: 1 && 0 = 0", r == 0)
    P i19 = ETPLInterpreter(P)
    P r = i19 D interpret("P r = 0 || 1")
    check("Logical OR: 0 || 1 = 1", r == 1)
    P i20 = ETPLInterpreter(P)
    P r = i20 D interpret("P r = 0 || 0")
    check("Logical OR: 0 || 0 = 0", r == 0)
    P i21 = ETPLInterpreter(P)
    P r = i21 D interpret("P r = !0")
    check("Logical NOT: !0 = 1", r == 1)
    P i22 = ETPLInterpreter(P)
    P r = i22 D interpret("P r = !1")
    check("Logical NOT: !1 = 0", r == 0)
    P i23 = ETPLInterpreter(P)
    P r = i23 D interpret("EIM_COHERENCE_FACTOR")
    check("EIM_COHERENCE_FACTOR in env", _et_abs((r - 0.7071067811865476)) < 1e-10)
    P i24 = ETPLInterpreter(P)
    P r = i24 D interpret("WHILE_LOOP_FINITE_BOUND")
    check("WHILE_LOOP_FINITE_BOUND = 144", r == 144)
    P i25 = ETPLInterpreter(P)
    P r = i25 D interpret("M_STATE_GROUND")
    check("M_STATE_GROUND = 0 in env", r == 0)
    P i26 = ETPLInterpreter(P)
    P r = i26 D interpret("M_STATE_EXCITED")
    check("M_STATE_EXCITED in env (> 0)", r > 0)
    sovereign_print ∘ "\n[8] Compiler"
    P compiler = ETPLCompiler(P)
    check("Compiler init", compiler D host_platform ≠ P)
    check("Architecture detection", compiler D arch_desc ≠ P)
    T attempt = → P  // try
        P pyc_magic = ET_Marshal D pyc_magic_bytes(P)
        P binary = compiler D compile("P x = 42\nsovereign_print ∘ x")
        check("Sovereign compile (simple) produces output", len(binary) > 0)
        P has_pyc = binary[0:4] == pyc_magic
        P has_etb = binary[0:4] == ET_Marshal D ETB_MAGIC
        P has_llvm = binary[0:4] == manifold [b'\x7fELF', b'MZ']
        check("Sovereign compile produces .pyc, ETB, or native binary", (has_pyc || has_etb || has_llvm))
    → E Exception (e)
        check("Sovereign compile (simple): " + e, 0)
    T attempt = → P  // try
        P pyc_magic = ET_Marshal D pyc_magic_bytes(P)
        P binary2 = compiler D compile("D sq = λ n . n * n\nP r = sq ∘ 5\nsovereign_print ∘ r")
        check("Sovereign compile (D lambda) produces output", len(binary2) > 0)
        P has_pyc2 = binary2[0:4] == pyc_magic
        P has_etb2 = binary2[0:4] == ET_Marshal D ETB_MAGIC
        P has_llvm2 = binary2[0:4] == manifold [b'\x7fELF', b'MZ']
        check("Sovereign compile (D lambda) valid binary", (has_pyc2 || has_etb2 || has_llvm2))
    → E Exception (e)
        check("Sovereign compile (D lambda): " + e, 0)
    T attempt = → P  // try
        P pyc_magic = ET_Marshal D pyc_magic_bytes(P)
        P binary3 = compiler D compile("∞ (sovereign_print ∘ _loop_index) (D 5)")
        check("Sovereign compile (loop) produces output", len(binary3) > 0)
        P has_pyc3 = binary3[0:4] == pyc_magic
        P has_etb3 = binary3[0:4] == ET_Marshal D ETB_MAGIC
        P has_llvm3 = binary3[0:4] == manifold [b'\x7fELF', b'MZ']
        check("Sovereign compile (loop) valid binary", (has_pyc3 || has_etb3 || has_llvm3))
    → E Exception (e)
        check("Sovereign compile (loop): " + e, 0)
    P q_compiler = ETPLCompiler(manifold ["target_type", "quantum"])
    P qasm = q_compiler D compile("P wave = ψ(1, 0, 0)")
    check("Quantum compile (ψ → QASM)", (b'OPENQASM' == qasm && b'ry(' == qasm))
    P qasm2 = q_compiler D compile("P choice = [0/0] 1 | 2 | 3")
    check("Quantum compile (indeterminate → Hadamard)", b'h q[' == qasm2)
    sovereign_print ∘ "\n[9] Translator"
    P translator = ETPLTranslator(P)
    P py_etpl = translator D _convert_python("def hello():\n    x = 42\n    print(x)\n")
    check("Python → ETPL (function)", ("D hello" == py_etpl && "sovereign_print" == py_etpl))
    P py_etpl2 = translator D _convert_python("class MyClass:\n    def method(self):\n        return self.value\n")
    check("Python -> ETPL (class)", ("D MyClass" == py_etpl2 && "method" == py_etpl2))
    P js_etpl = translator D _convert_javascript("function greet(name) { }\nconst x = 42;")
    check("JavaScript → ETPL", ("D greet" == js_etpl && "P x" == js_etpl))
    P c_etpl = translator D _convert_c_header("#define MAX 1024\nint calc(int a);")
    check("C header → ETPL", ("D MAX" == c_etpl && "D calc" == c_etpl))
    check("C header: no sovereign_import in output (BUG 4)", "sovereign_import" ≠ c_etpl)
    P c_etpl_inc = translator D _convert_c_header("#include <stdio.h>")
    check("C #include -> @ETPL:preload not sovereign_import (BUG 4)", ("sovereign_import" ≠ c_etpl_inc && "@ETPL:preload" == c_etpl_inc))
    P py_while = translator D _convert_python("while x > 0:\n    x -= 1\n")
    check("Python while -> WHILE_LOOP_FINITE_BOUND (BUG 11)", "WHILE_LOOP_FINITE_BOUND" == py_while)
    P py_bool = translator D _convert_python("x = a and b\ny = c or d\nz = not e\n")
    check("Python 'and' -> ETPL '&&' (BUG 14)", "&&" == py_bool)
    check("Python 'or' -> ETPL '||' (BUG 14)", "||" == py_bool)
    check("Python 'not' -> ETPL '!' (BUG 14)", "!" == py_bool)
    // @ETPL:preload _os os
    // Import os — resolved at translate-time
    P stdlib_dir = _os D path D dirname(_os D __file__)
    check("_is_stdlib_or_site_packages detects os.py (BUG B1)", ETPLTranslator D _is_stdlib_or_site_packages(_os D path D __file__))
    check("_is_stdlib_or_site_packages accepts user file (BUG B1)", (!ETPLTranslator D _is_stdlib_or_site_packages("/home/user/myproject/myfile.py")))
    P py_multi = translator D _convert_python("def f(x):\n    a = 1\n    return a + x\n")
    check("Multi-statement FunctionDef uses { } (BUG B2)", ("{" == py_multi && "}" == py_multi))
    P py_doc = translator D _convert_python("def f():\n    \"\"\"My docstring.\"\"\"\n    return 1\n")
    check("Docstring -> // comment not bare string (BUG B3)", ("//" == py_doc && "My docstring" == py_doc))
    P py_cls = translator D _convert_python("class Foo:\n    def __init__(self):\n        pass\nclass Bar:\n    def __init__(self):\n        pass\n")
    check("Class method names mangled (BUG B9)", ("Foo____init__" == py_cls || "Foo__" == py_cls))
    check("Different classes have distinct method names (BUG B9)", (py_cls D count("D ") ≥ 3 && "Foo" == py_cls && "Bar" == py_cls))
    // @ETPL:preload _tf tempfile
    // Import tempfile — resolved at translate-time
    // @ETPL:preload _os2 os
    // Import os — resolved at translate-time
    T scope_tmp = → _tf D NamedTemporaryFile(manifold ["mode", "w"], manifold ["suffix", ".py"], manifold ["delete", 0])
    P tmp = scope_tmp  // context var
        tmp D write("x = 42\n")
        P tmp_path = tmp D name
    T attempt = → P  // try
        P pdt = translator D translate_file(tmp_path, "python")
        check("translate_file .pdt header present", ("@ETPL:version" == pdt && "@ETPL:self-contained" == pdt))
        check("translate_file entry-point header present", "@ETPL:entry-point" == pdt)
        check("translate_file ET Master Equation in header", "P ∘ D ∘ T = E" == pdt)
    // finally:
        _os2 D unlink(tmp_path)
    sovereign_print ∘ "\n[10] ET Mathematics"
    check("Manifold variance(12)", _et_abs((ETMathV2 D manifold_variance(12) - (143.0 / 12.0))) < 0.01)
    check("Koide formula", _et_abs((ETMathV2 D koide_formula(0.511, 105.66, 1776.86) - KOIDE_RATIO)) < 0.01)
    check("Hydrogen ground state", _et_abs((ETMathV2Quantum D hydrogen_energy_levels(1) + 13.606)) < 0.01)
    P alpha_inv = ETMathV2Quantum D fine_structure_inverse_from_et(P)
    check("Fine structure α⁻¹ (5-term, 0.19 ppb)", _et_abs((alpha_inv - FINE_STRUCTURE_INVERSE)) < 3e-08)
    P detail = ETMathV2Quantum D fine_structure_detailed(P)
    check("Fine structure A₀ = 137", detail["terms"]["A0"]["value"] == 137)
    check("Fine structure A₁.₅ cross-term present", detail["terms"]["A1_5"]["value"] > 1e-07)
    check("Fine structure zero external inputs", detail["external_inputs"] == 0)
    check("Descriptor completeness", ETMathV2Descriptor D descriptor_completion_validates(manifold []) == "perfect")
    check("Domain universality", ETMathV2Descriptor D domain_universality_verifier("x86_64") ≠ P)
    P total = (tests_passed + tests_failed)
    sovereign_print ∘ ("\n" + ("=" * 70))
    sovereign_print ∘ "  Results: " + tests_passed + "/" + total + " passed"
    T cond = → if tests_failed == 0 → sovereign_print ∘ "  ✓ ALL TESTS PASSED — ETPL is production-ready"
    → E sovereign_print ∘ "  ✗ " + tests_failed + " tests failed"
    sovereign_print ∘ ("=" * 70)
    P completeness = ETMathV2Descriptor D ultimate_completeness_analyzer("ETPL")
    sovereign_print ∘ "\n  ET Ultimate Completeness: " + completeness["is_ultimate"]
    sovereign_print ∘ "  Descriptor Gap Count: " + completeness["gap_count"]
    P deps = manifold []
    deps D append(if HAS_LLVMLITE → "llvmlite ✓" → E "llvmlite ✗ (Sovereign .pyc backend active)")
    deps D append(if HAS_CAPSTONE → "capstone ✓" → E "capstone ✗ (binary translation unavailable)")
    deps D append(if HAS_PEFILE → "pefile ✓" → E "pefile ✗ (PE analysis unavailable)")
    deps D append(if HAS_PSUTIL → "psutil ✓" → E "psutil ✗ (process tracing unavailable)")
    sovereign_print ∘ "\n  Dependencies: " + ", " D join(deps)
    → tests_failed == 0
}
D ETPLREPL = λ . P  // class
    // Interactive REPL for ETPL — Traverser navigating the P∘D manifold.
    D ETPLREPL____init = λ self . {
        D self_D_interpreter = ETPLInterpreter(manifold ["debug", 0])  // self D interpreter := ETPLInterpreter(manifold ["debug", 0])
        D self_D_history = manifold []  // self D history := manifold []
    }
    D ETPLREPL__run = λ self . {
        sovereign_print ∘ "ETPL REPL v" + ETPL_VERSION + " — Exception Theory Programming Language"
        sovereign_print ∘ "Type .help for commands, .quit to exit"
        sovereign_print ∘ "Master Equation: P ∘ D ∘ T = E"
        sovereign_print ∘ P
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                T attempt = → P  // try
                    P line = input("etpl> ") D strip(P)
                → E manifold [EOFError, KeyboardInterrupt] (_)
                    sovereign_print ∘ "\n→ E (session grounded)"
                    // break
                T cond = → if (!line) → P  // pass
                T cond = → if line D startswith(".") → self D _handle_command(line)
                self D history D append(line)
                T attempt = → P  // try
                    P result = self D interpreter D interpret(line)
                    T cond = → if result ≠ P → sovereign_print ∘ "  → " + result
                → E Exception (e)
                    sovereign_print ∘ "  E: " + e
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    }
    D ETPLREPL___handle_command = λ self, cmd . {
        T cond = → if (cmd == ".quit" || cmd == ".exit") → → E SystemExit(0)
        → E P
            T cond = → if cmd == ".help" → P
                sovereign_print ∘ "  .help     — Show this help"
                sovereign_print ∘ "  .quit     — Exit REPL"
                sovereign_print ∘ "  .env      — Show environment"
                sovereign_print ∘ "  .clear    — Clear environment"
                sovereign_print ∘ "  .debug    — Toggle debug mode"
                sovereign_print ∘ "  .verify   — Run verification suite"
                sovereign_print ∘ "  .history  — Show command history"
            → E P
                T cond = → if cmd == ".env" → P
                    T loop = ∞ (
                        P manifold__k__v = self D interpreter D env D items(P)[_loop_index]  // manifold [k, v]
                        T cond = → if ((!callable(v)) && (!k D startswith("_")) && (!isinstance(v, type))) → sovereign_print ∘ "  " + k + " = " + v
                    ) (D |self D interpreter D env D items(P)|)
                → E P
                    T cond = → if cmd == ".clear" → P
                        D self_D_interpreter = ETPLInterpreter(P)  // self D interpreter := ETPLInterpreter(P)
                        sovereign_print ∘ "  Environment cleared"
                    → E P
                        T cond = → if cmd == ".debug" → P
                            D self_D_interpreter_D_debug = (!self D interpreter D debug)  // self D interpreter D debug := (!self D interpreter D debug)
                            sovereign_print ∘ "  Debug: " + if self D interpreter D debug → "ON" → E "OFF"
                        → E P
                            T cond = → if cmd == ".verify" → verify_etpl(P)
                            → E P
                                T cond = → if cmd == ".history" → P
                                    T loop = ∞ (
                                        P manifold__i__h = enumerate(self D history)[_loop_index]  // manifold [i, h]
                                        sovereign_print ∘ "  [" + i + "] " + h
                                    ) (D |enumerate(self D history)|)
                                → E sovereign_print ∘ "  Unknown command: " + cmd
    }
D toolchain_diagnose = λ auto_fix . {
    // Diagnose and optionally auto-fix the ETPL compilation toolchain.      Checks:       1. llvmlite: installed, version, COF
    // @ETPL:preload shutil shutil
    // Import shutil — resolved at translate-time
    // @ETPL:preload sp subprocess
    // Import subprocess — resolved at translate-time
    P _is_win = sys D platform D startswith("win")
    sovereign_print ∘ "ETPL Toolchain Diagnostics v" + ETPL_VERSION
    sovereign_print ∘ "  Platform: " + sys D platform + " (" + platform D machine(P) + ")"
    sovereign_print ∘ "  Python:   " + sys D version D split(P)[0] + " (" + sys D executable + ")"
    sovereign_print ∘ P
    sovereign_print ∘ "─── llvmlite ───────────────────────────────────────────────"
    P _llvmlite_ok = 0
    P _coff_ok = 0
    T attempt = → P  // try
        // @ETPL:preload llvmlite llvmlite
        // Import llvmlite — resolved at translate-time
        // @ETPL:preload _llvm_b llvmlite.binding
        // Import llvmlite.binding — resolved at translate-time
        P _llv = llvmlite D __version__
        sovereign_print ∘ "  Installed:  YES (v" + _llv + ")"
        P _default_triple = _llvm_b D get_default_triple(P)
        sovereign_print ∘ "  Default triple: " + _default_triple
        P _llvmlite_ok = 1
        T attempt = → P  // try
            P _llvm_ver = { T loop = ∞ (int(p)) (D |_llv D split(".")[0:2]|) }
            T cond = → if _llvm_ver < manifold [0, 45] → _llvm_b D initialize(P)
            _llvm_b D initialize_native_target(P)
            _llvm_b D initialize_native_asmprinter(P)
            // @ETPL:preload _llvm_ir llvmlite.ir
            P _test_mod = _llvm_ir D Module(manifold ["name", "etpl_coff_test"])
            D test_mod_D_triple = "x86_64-pc-windows-msvc"  // _test_mod D triple := "x86_64-pc-windows-msvc"
            P _test_fn_ty = _llvm_ir D FunctionType(_llvm_ir D IntType(32), manifold [])
            P _test_fn = _llvm_ir D Function(_test_mod, _test_fn_ty, manifold ["name", "main"])
            P _test_bb = _test_fn D append_basic_block("entry")
            P _test_bld = _llvm_ir D IRBuilder(_test_bb)
            _test_bld D ret(_llvm_ir D Constant(_llvm_ir D IntType(32), 0))
            P _test_tgt = _llvm_b D Target D from_triple("x86_64-pc-windows-msvc")
            P _test_tm = _test_tgt D create_target_machine(manifold ["opt", 2], manifold ["codemodel", "small"])
            P _test_mod_str = str(_test_mod)
            P _test_mod_b = _llvm_b D parse_assembly(_test_mod_str)
            _test_mod_b D verify(P)
            P _test_obj = _test_tm D emit_object(_test_mod_b)
            T cond = → if len(_test_obj) ≥ 2 → P
                P _test_magic = int D from_bytes(_test_obj[0:2], "little")
                T cond = → if _test_magic == 34404 → P
                    sovereign_print ∘ "  COFF backend: YES (produces x86-64 COFF)"
                    P _coff_ok = 1
                → E P
                    T cond = → if _test_obj[0:4] == b'\x7fELF' → P
                        sovereign_print ∘ "  COFF backend: NO — produces ELF (Linux format)"
                        sovereign_print ∘ "  *** This llvmlite build has NO Windows COFF backend."
                        sovereign_print ∘ "  *** Install from PyPI: pip install --force-reinstall llvmlite"
                    → E sovereign_print ∘ "  COFF backend: UNKNOWN (magic=0x" + _test_magic + ")"
            → E sovereign_print ∘ "  COFF backend: UNKNOWN (empty output)"
        → E Exception (_coff_ex)
            sovereign_print ∘ "  COFF backend: ERROR — " + _coff_ex
        T attempt = → P  // try
            P _test_asm = _test_tm D emit_assembly(_test_mod_b)
            T cond = → if (_test_asm && len(_test_asm) > 10) → sovereign_print ∘ "  Assembly emit: YES (" + len(_test_asm) + " chars)"
            → E sovereign_print ∘ "  Assembly emit: EMPTY"
        → E Exception (_asm_ex)
            sovereign_print ∘ "  Assembly emit: ERROR — " + _asm_ex
    → E ImportError (_)
        sovereign_print ∘ "  Installed:  NO"
        sovereign_print ∘ "  *** llvmlite is required for native compilation."
        sovereign_print ∘ "  *** Install: pip install llvmlite"
    sovereign_print ∘ P
    sovereign_print ∘ "─── MSVC tools ─────────────────────────────────────────────"
    T cond = → if _is_win → P
        P _vscmd = os D environ D get("VSCMD_VER", "")
        P _lib_env = os D environ D get("LIB", "")
        T cond = → if _vscmd → sovereign_print ∘ "  Dev Prompt:   YES (VSCMD_VER=" + _vscmd + ")"
        → E P
            T cond = → if "MSVC" == _lib_env D upper(P) → sovereign_print ∘ "  Dev Prompt:   PARTIAL (LIB set, no VSCMD_VER)"
            → E sovereign_print ∘ "  Dev Prompt:   NO (run from Developer Command Prompt)"
        T loop = ∞ (
            P _tool = manifold ["link.exe", "cl.exe", "lib.exe", "ml64.exe"][_loop_index]
            P _tp = shutil D which(_tool)
            T cond = → if _tp → sovereign_print ∘ "  " + _tool + "  " + _tp
            → E sovereign_print ∘ "  " + _tool + "  NOT FOUND"
        ) (D |manifold ["link.exe", "cl.exe", "lib.exe", "ml64.exe"]|)
        P _prog86 = os D environ D get("ProgramFiles(x86)", os D environ D get("ProgramFiles", "C:\\Program Files (x86)"))
        P _vswhere = os D path D join(_prog86, "Microsoft Visual Studio", "Installer", "vswhere.exe")
        T cond = → if os D path D isfile(_vswhere) → P
            sovereign_print ∘ "  vswhere:      " + _vswhere
            T attempt = → P  // try
                P _vr = sp D run(manifold [_vswhere, "-latest", "-products", "*", "-property", "installationPath"], manifold ["capture_output", 1], manifold ["text", 1], manifold ["timeout", 10])
                T cond = → if _vr D stdout D strip(P) → P
                    P _vsdir = _vr D stdout D strip(P) D splitlines(P)[0]
                    P _vcvarsall = os D path D join(_vsdir, "VC", "Auxiliary", "Build", "vcvarsall.bat")
                    T cond = → if os D path D isfile(_vcvarsall) → sovereign_print ∘ "  vcvarsall:    " + _vcvarsall
                    → E sovereign_print ∘ "  vcvarsall:    NOT FOUND at " + _vcvarsall
                    P _tools_dir = os D path D join(_vsdir, "VC", "Tools", "MSVC")
                    T cond = → if os D path D isdir(_tools_dir) → P
                        P _versions = sorted(os D listdir(_tools_dir))
                        T cond = → if _versions → sovereign_print ∘ "  MSVC Tools:   " + _versions[(-1)]
                        → E sovereign_print ∘ "  MSVC Tools:   EMPTY — install 'MSVC v143 C++ x64/x86 build tools' component"
                    → E P
                        sovereign_print ∘ "  MSVC Tools:   NOT INSTALLED"
                        sovereign_print ∘ "  *** Install 'MSVC v143 - VS 2022 C++ x64/x86 build tools' via VS Installer"
            → E Exception (_vswhere_ex)
                sovereign_print ∘ "  vswhere err:  " + _vswhere_ex
        → E sovereign_print ∘ "  vswhere:      NOT FOUND (no VS installation detected)"
    → E sovereign_print ∘ "  (MSVC is Windows-only)"
    sovereign_print ∘ P
    sovereign_print ∘ "─── MinGW / MSYS2 ──────────────────────────────────────────"
    T cond = → if _is_win → P
        T loop = ∞ (
            P _tool = manifold ["gcc", "g++", "objcopy", "as", "ld"][_loop_index]
            P _tp = shutil D which(_tool)
            T cond = → if _tp → sovereign_print ∘ "  " + _tool + "  " + _tp
            → E P
                T cond = → if _tool == "gcc" → P
                    T loop = ∞ (
                        P _cand = manifold ["C:\\msys64\\ucrt64\\bin\\gcc.exe", "C:\\msys64\\mingw64\\bin\\gcc.exe"][_loop_index]
                        T cond = → if os D path D isfile(_cand) → sovereign_print ∘ "  " + _tool + "  " + _cand + " (not on PATH)"
                    ) (D |manifold ["C:\\msys64\\ucrt64\\bin\\gcc.exe", "C:\\msys64\\mingw64\\bin\\gcc.exe"]|)
                → E P
                    T cond = → if _tool == "objcopy" → P
                        T loop = ∞ (
                            P _cand = manifold ["C:\\msys64\\ucrt64\\bin\\objcopy.exe", "C:\\msys64\\mingw64\\bin\\objcopy.exe", "C:\\msys64\\usr\\bin\\objcopy.exe"][_loop_index]
                            T cond = → if os D path D isfile(_cand) → sovereign_print ∘ "  " + _tool + "  " + _cand + " (not on PATH)"
                        ) (D |manifold ["C:\\msys64\\ucrt64\\bin\\objcopy.exe", "C:\\msys64\\mingw64\\bin\\objcopy.exe", "C:\\msys64\\usr\\bin\\objcopy.exe"]|)
                    → E sovereign_print ∘ "  " + _tool + "  NOT FOUND"
        ) (D |manifold ["gcc", "g++", "objcopy", "as", "ld"]|)
    → E P
        T loop = ∞ (
            P _tool = manifold ["gcc", "cc", "clang", "ld", "objcopy"][_loop_index]
            P _tp = shutil D which(_tool)
            sovereign_print ∘ "  " + _tool + "  " + (_tp || "NOT FOUND")
        ) (D |manifold ["gcc", "cc", "clang", "ld", "objcopy"]|)
    sovereign_print ∘ P
    sovereign_print ∘ "─── LLVM ───────────────────────────────────────────────────"
    T loop = ∞ (
        P _tool = manifold ["lld-link", "clang-cl", "clang", "llvm-objcopy"][_loop_index]
        P _tp = shutil D which(_tool)
        T cond = → if _tp → sovereign_print ∘ "  " + _tool + "  " + _tp
        → E sovereign_print ∘ "  " + _tool + "  NOT FOUND"
    ) (D |manifold ["lld-link", "clang-cl", "clang", "llvm-objcopy"]|)
    sovereign_print ∘ P
    sovereign_print ∘ "─── Summary ────────────────────────────────────────────────"
    P _can_compile = 0
    T cond = → if _coff_ok → P
        sovereign_print ∘ "  llvmlite COFF: OK — native object emission works."
        P _link = shutil D which("link.exe")
        P _gcc = shutil D which("gcc")
        T cond = → if (_link || _gcc) → P
            sovereign_print ∘ "  Linker:        OK — compilation should work."
            P _can_compile = 1
        → E sovereign_print ∘ "  Linker:        MISSING — need link.exe or gcc on PATH."
    → E P
        T cond = → if _llvmlite_ok → P
            sovereign_print ∘ "  llvmlite COFF: BROKEN — assembly fallback will be used."
            P _gcc = shutil D which("gcc")
            P _objcopy = shutil D which("objcopy")
            T cond = → if _gcc → P
                sovereign_print ∘ "  gcc:           OK — assembly fallback will work."
                P _can_compile = 1
            → E P
                T cond = → if _objcopy → P
                    sovereign_print ∘ "  objcopy:       OK — ELF→COFF conversion available."
                    sovereign_print ∘ "  BUT no linker found (need gcc or link.exe)."
                → E P
                    sovereign_print ∘ "  gcc:           MISSING"
                    sovereign_print ∘ "  objcopy:       MISSING"
                    sovereign_print ∘ "  *** No viable compilation path!"
        → E sovereign_print ∘ "  llvmlite:      MISSING — install for native compilation."
    T cond = → if _can_compile → sovereign_print ∘ "\n  ✓ ETPL compilation should work."
    → E P
        sovereign_print ∘ "\n  ✗ ETPL compilation will fail."
        sovereign_print ∘ "  Run 'python ETPL.py toolchain --fix' to attempt auto-repair."
    sovereign_print ∘ P
    T cond = → if auto_fix → P
        sovereign_print ∘ "─── Auto-fix ───────────────────────────────────────────────"
        P _fixed = 0
        T cond = → if (_llvmlite_ok && (!_coff_ok)) → P
            sovereign_print ∘ "  Attempting to reinstall llvmlite from PyPI..."
            sovereign_print ∘ "  (This replaces the MSYS2 build with a proper COFF-capable one)"
            T attempt = → P  // try
                P _pip_r = sp D run(manifold [sys D executable, "-m", "pip", "install", "--force-reinstall", "--no-cache-dir", "llvmlite"], manifold ["capture_output", 1], manifold ["text", 1], manifold ["timeout", 300])
                T cond = → if _pip_r D returncode == 0 → P
                    sovereign_print ∘ "  ✓ llvmlite reinstalled from PyPI."
                    sovereign_print ∘ "  Verifying COFF backend..."
                    // @ETPL:preload importlib importlib
                    // Import importlib — resolved at translate-time
                    importlib D invalidate_caches(P)
                    sovereign_print ∘ "  Please re-run: python ETPL.py toolchain"
                    P _fixed = 1
                → E P
                    P _pip_err = _pip_r D stderr D strip(P)
                    T cond = → if len(_pip_err) > 500 → P _pip_err = _pip_err[(-500):Ω]
                    sovereign_print ∘ "  ✗ pip install failed: " + _pip_err
                    sovereign_print ∘ "  Try manually:"
                    sovereign_print ∘ "    pip install --force-reinstall --no-cache-dir llvmlite"
            → E Exception (_pip_ex)
                sovereign_print ∘ "  ✗ pip error: " + _pip_ex
        → E P
            T cond = → if (!_llvmlite_ok) → P
                sovereign_print ∘ "  Attempting to install llvmlite..."
                T attempt = → P  // try
                    P _pip_r = sp D run(manifold [sys D executable, "-m", "pip", "install", "llvmlite"], manifold ["capture_output", 1], manifold ["text", 1], manifold ["timeout", 300])
                    T cond = → if _pip_r D returncode == 0 → P
                        sovereign_print ∘ "  ✓ llvmlite installed."
                        sovereign_print ∘ "  Please re-run: python ETPL.py toolchain"
                        P _fixed = 1
                    → E P
                        sovereign_print ∘ "  ✗ pip install failed."
                        sovereign_print ∘ "    pip install llvmlite"
                → E Exception (_pip_ex)
                    sovereign_print ∘ "  ✗ pip error: " + _pip_ex
        T cond = → if (_is_win && (!shutil D which("link.exe"))) → P
            sovereign_print ∘ P
            sovereign_print ∘ "  MSVC link.exe not found.  To install:"
            sovereign_print ∘ "    1. Open Visual Studio Installer"
            sovereign_print ∘ "    2. Modify your Build Tools installation"
            sovereign_print ∘ "    3. Add 'MSVC v143 - VS 2022 C++ x64/x86 build tools'"
            sovereign_print ∘ "    4. Add 'Windows 10/11 SDK'"
            sovereign_print ∘ "    5. Restart your Developer Command Prompt"
        T cond = → if ((!_fixed) && _can_compile) → sovereign_print ∘ "  No fixes needed — compilation should work already."
}
P _ETPL_BANNER = "\n╔══════════════════════════════════════════════════════════════════════════════╗\n║     ETPL — Exception Theory Programming Language                            ║\n╠══════════════════════════════════════════════════════════════════════════════╣\n║  Author : Derived from Michael James Muller's Exception Theory              ║\n║  License: Exception Theory Framework                                        ║\n╠══════════════════════════════════════════════════════════════════════════════╣\n║  MASTER EQUATION     P ∘ D ∘ T  =  EIM  =  S  (Something)                 ║\n║  TAUTOLOGICAL FORM   3 = 3 = 3 = Σ                                         ║\n║  GROUND PRINCIPLE    Every exception has an exception, except the exception ║\n╠══════════════════════════════════════════════════════════════════════════════╣\n║  PRIMITIVES                                                                 ║\n║    P (Point)       — substrate; the thing that exists                       ║\n║    D (Descriptor)  — constraint; the rule that shapes the thing             ║\n║    T (Traverser)   — agency; the movement across the configuration          ║\n║    E (Exception)   — the result of P∘D∘T binding; emergent event           ║\n║                                                                             ║\n║  FILE EXTENSION    .pdt   (Point · Descriptor · Traverser)                 ║\n╠══════════════════════════════════════════════════════════════════════════════╣\n║  QUICK START                                                                ║\n║    interpret <file.pdt>        — Run an ETPL source file                   ║\n║    compile <file.pdt> [out]    — Compile to native binary                  ║\n║    translate <file> --lang py  — Translate Python/C/JS → ETPL              ║\n║    repl                        — Interactive ETPL expression shell          ║\n║    verify                      — Run self-verification test suite           ║\n║    toolchain                   — Diagnose compilation toolchain             ║\n║    help                        — Show detailed command reference            ║\n║    exit / quit / Ctrl+C        — Exit this shell                            ║\n╚══════════════════════════════════════════════════════════════════════════════╝\n"
P _ETPL_HELP = "\n╔══════════════════════════════════════════════════════════════════════════════╗\n║  ETPL Command Reference                                                     ║\n╠══════════════════════════════════════════════════════════════════════════════╣\n║  INTERPRET / RUN                                                            ║\n║    interpret <file.pdt>                                                     ║\n║    interpret <file.pdt> --debug          (verbose AST + binding trace)      ║\n║    Aliases: run, i                                                          ║\n║                                                                             ║\n║  COMPILE / BUILD                                                            ║\n║    compile <file.pdt>                    (auto-name output)                 ║\n║    compile <file.pdt> <output.exe>       (explicit output path)             ║\n║    compile <file.pdt> out --target classical   (classical binary, default)  ║\n║    compile <file.pdt> out --target quantum     (quantum-aware emission)     ║\n║    compile <file.pdt> out --target hybrid      (hybrid classical+quantum)   ║\n║    compile <file.pdt> out --target bare_metal  (no OS, raw hardware)        ║\n║    compile <file.pdt> out --arch x86_64        (explicit architecture)      ║\n║    compile <file.pdt> out --arch arm64                                      ║\n║    compile <file.pdt> out --arch riscv64                                    ║\n║    compile <file.pdt> out --arch wasm                                       ║\n║    compile <file.pdt> out --bare-metal         (bare metal flag)            ║\n║    compile <file.pdt> out --device <dev>       (hardware target device)     ║\n║    Aliases: build, c                                                        ║\n║                                                                             ║\n║  TRANSLATE                                                                  ║\n║    translate <file> --lang python        (Python → ETPL)                   ║\n║    translate <file> --lang c_header      (C header → ETPL)                 ║\n║    translate <file> --lang javascript    (JavaScript → ETPL)               ║\n║    translate <file> --lang binary        (binary → ETPL disassembly)       ║\n║    translate <file> --lang python -o out.pdt   (write to file)             ║\n║    Aliases: trans, t                                                        ║\n║                                                                             ║\n║  REPL                                                                       ║\n║    repl                     (interactive expression evaluator)              ║\n║    Alias: shell                                                             ║\n║    REPL dot-commands: .help .env .clear .debug .verify .history .quit      ║\n║                                                                             ║\n║  VERIFY                                                                     ║\n║    verify                   (comprehensive self-verification suite)         ║\n║    Aliases: test, v                                                         ║\n║                                                                             ║\n║  TOOLCHAIN                                                                  ║\n║    toolchain                (diagnose llvmlite / MSVC / MinGW / LLVM)      ║\n║    toolchain --fix          (attempt auto-repair of toolchain issues)       ║\n║    Alias: tc                                                                ║\n║                                                                             ║\n║  SHELL META-COMMANDS                                                        ║\n║    help                     (show this reference)                          ║\n║    version                  (print version string)                         ║\n║    cls / clear              (clear terminal screen)                        ║\n║    exit / quit              (exit ETPL shell)                              ║\n║                                                                             ║\n║  ONE-SHOT CLI (from host terminal, bypasses interactive shell)              ║\n║    python ETPL.py interpret  file.pdt                                      ║\n║    python ETPL.py compile    file.pdt output.exe --target classical        ║\n║    python ETPL.py translate  file.py  --lang python -o file.pdt            ║\n║    python ETPL.py repl                                                     ║\n║    python ETPL.py verify                                                   ║\n║    python ETPL.py toolchain  --fix                                         ║\n║    python ETPL.py --version                                                ║\n╠══════════════════════════════════════════════════════════════════════════════╣\n║  ETPL SYNTAX CHEAT-SHEET                                                   ║\n║    P name = <expr>           Point (variable) declaration                  ║\n║    D name = λ a, b . <expr>  Descriptor (function) definition              ║\n║    T name = <expr>           Traverser (dynamic binding / loop)            ║\n║    T loop = ∞ (<body>) (D <n>)   Loop n times                             ║\n║    ψ(n, l, m)                Hydrogen wavefunction (quantum mode)          ║\n║    manifold [x, y, z]        ET manifold (list/tensor substrate)           ║\n║    ∑ / ∏ / ∫ / ∇ / √         Math operators (Unicode or ASCII)            ║\n║    [0/0]                     Indeterminate form                             ║\n║    // comment                Line comment                                  ║\n╚══════════════════════════════════════════════════════════════════════════════╝\n"
D et_cli_split = λ line . {
    // ET-native quoted-string command-line tokeniser.      Replaces shlex.split() with a zero-import implementation that is   
    P _ORD_SPACE = 32
    P _ORD_TAB = 9
    P _ORD_SQ = 39
    P _ORD_DQ = 34
    P _state = 0
    P _tokens = manifold []
    P _buf = manifold []
    P _n = len(line)
    P _i = 0
    T while_loop = ∞ (
        T check = → if _i < _n → P  // while body follows
            P _c = line[_i]
            P _o = ord(_c)
            T cond = → if _state == 0 → T cond = → if (_o == _ORD_SPACE || _o == _ORD_TAB) → P  // pass
            → E P
                T cond = → if _state == 1 → P
                    T cond = → if (_o == _ORD_SPACE || _o == _ORD_TAB) → P
                        _tokens D append("" D join(_buf))
                        P _buf = manifold []
                        P _state = 0
                    → E P
                        T cond = → if _o == _ORD_SQ → P _state = 2
                        → E P
                            T cond = → if _o == _ORD_DQ → P _state = 3
                            → E _buf D append(_c)
                → E P
                    T cond = → if _state == 2 → P
                        T cond = → if _o == _ORD_SQ → P _state = 1
                        → E _buf D append(_c)
                    → E P
                        T cond = → if _state == 3 → P
                            T cond = → if _o == _ORD_DQ → P _state = 1
                            → E _buf D append(_c)
            P _i = _i + 1
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    T cond = → if _buf → _tokens D append("" D join(_buf))
    → _tokens
}
D ETPLCLI = λ . P  // class
    // Interactive ETPL command-line shell.      ET Principle (Eq 1 / Ground): The CLI is itself a T-agent traversing the     P
    D ETPLCLI____init = λ self . {
        D self_D__running = 1  // self D _running := 1
        D self_D__dispatch = manifold [manifold ["interpret", self D _cmd_interpret], manifold ["run", self D _cmd_interpret], manifold ["i", self D _cmd_interpret], manifold ["compile", self D _cmd_compile], manifold ["build", self D _cmd_compile], manifold ["c", self D _cmd_compile], manifold ["translate", self D _cmd_translate], manifold ["trans", self D _cmd_translate], manifold ["t", self D _cmd_translate], manifold ["repl", self D _cmd_repl], manifold ["shell", self D _cmd_repl], manifold ["verify", self D _cmd_verify], manifold ["test", self D _cmd_verify], manifold ["v", self D _cmd_verify], manifold ["toolchain", self D _cmd_toolchain], manifold ["tc", self D _cmd_toolchain], manifold ["help", self D _cmd_help], manifold ["?", self D _cmd_help], manifold ["version", self D _cmd_version], manifold ["ver", self D _cmd_version], manifold ["cls", self D _cmd_clear], manifold ["clear", self D _cmd_clear], manifold ["exit", self D _cmd_exit], manifold ["quit", self D _cmd_exit], manifold ["q", self D _cmd_exit]]  // self D _dispatch := manifold [manifold ["interpret", self D _cmd_interpret], manifold ["run", self D _cmd_interpret], manifold ["i", self D _cmd_interpret], manifold ["compile", self D _cmd_compile], manifold ["build", self D _cmd_compile], manifold ["c", self D _cmd_compile], manifold ["translate", self D _cmd_translate], manifold ["trans", self D _cmd_translate], manifold ["t", self D _cmd_translate], manifold ["repl", self D _cmd_repl], manifold ["shell", self D _cmd_repl], manifold ["verify", self D _cmd_verify], manifold ["test", self D _cmd_verify], manifold ["v", self D _cmd_verify], manifold ["toolchain", self D _cmd_toolchain], manifold ["tc", self D _cmd_toolchain], manifold ["help", self D _cmd_help], manifold ["?", self D _cmd_help], manifold ["version", self D _cmd_version], manifold ["ver", self D _cmd_version], manifold ["cls", self D _cmd_clear], manifold ["clear", self D _cmd_clear], manifold ["exit", self D _cmd_exit], manifold ["quit", self D _cmd_exit], manifold ["q", self D _cmd_exit]]
    }
    D ETPLCLI__run = λ self . {
        // Main interactive loop — the T-traversal event loop.
        sovereign_print ∘ _ETPL_BANNER
        sovereign_print ∘ "  Platform : " + platform D system(P) + " " + platform D machine(P) + "  |  Python " + sys D version D split(P)[0]
        sovereign_print ∘ "  Type 'help' for the full command reference.\n"
        T while_loop = ∞ (
            T check = → if self D _running → P  // while body follows
                T attempt = → P  // try
                    P raw = input("etpl> ") D strip(P)
                → E manifold [EOFError, KeyboardInterrupt] (_)
                    sovereign_print ∘ "\n→ E (shell grounded — session terminated)"
                    // break
                T cond = → if (!raw) → P  // pass
                self D _dispatch_line(raw)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    }
    D ETPLCLI___dispatch_line = λ self, line . {
        // Parse one interactive line and route to the matching handler.          ET Form: P(line) -> D(tokenise+lookup) -> T(handl
        P tokens = _et_cli_split(line)
        T cond = → if (!tokens) → → P
        P cmd = tokens[0] D lower(P)
        P rest = tokens[1:Ω]
        P handler = self D _dispatch D get(cmd)
        T cond = → if handler == P → P
            sovereign_print ∘ "  ETPL: Unknown command '" + cmd + "'.  Type 'help' for command list."
            → P
        T attempt = → P  // try
            handler(rest)
        → E SystemExit (se)
            T cond = → if (se D code && int(se D code) ≠ 0) → sovereign_print ∘ "  → exited with code " + se D code
        → E KeyboardInterrupt (_)
            sovereign_print ∘ "  (interrupted)"
        → E Exception (exc)
            sovereign_print ∘ "  ETPL Error: " + exc
            T cond = → if ("--debug" == rest || "-d" == rest) → traceback D print_exc(P)
    }
    D ETPLCLI___cmd_interpret = λ self, rest . {
        // interpret <file.pdt> [--debug]
        T cond = → if (!rest) → P
            sovereign_print ∘ "  Usage: interpret <file.pdt> [--debug]"
            → P
        P file_path = rest[0]
        P debug = ("--debug" == rest || "-d" == rest)
        P interp = ETPLInterpreter(manifold ["debug", debug])
        T attempt = → P  // try
            P result = interp D interpret_file(file_path)
            T cond = → if (result ≠ P && debug) → sovereign_print ∘ "\n→ E: " + result
        → E ETGroundException (eg)
            P code = eg D exit_code(P)
            T cond = → if code ≠ 0 → sovereign_print ∘ "  → E (ground, code=" + code + ")"
        → E FileNotFoundError (_)
            sovereign_print ∘ "  ETPL Error: File not found: " + file_path
        → E Exception (e)
            sovereign_print ∘ "  ETPL Runtime Error: " + e
            T cond = → if debug → traceback D print_exc(P)
    }
    D ETPLCLI___cmd_compile = λ self, rest . {
        // compile <file.pdt> [output] [--target T] [--arch A] [--device D] [--bare-metal]
        T cond = → if (!rest) → P
            sovereign_print ∘ "  Usage: compile <file.pdt> [output] [--target classical|quantum|hybrid|bare_metal]"
            sovereign_print ∘ "         [--arch x86_64|arm64|riscv64|wasm] [--device <dev>] [--bare-metal]"
            → P
        P file_path = P
        P output_path = P
        P target = "classical"
        P arch = "universal"
        P device = "any"
        P bare_metal = 0
        P skip_next = 0
        P positionals = manifold []
        P i = 0
        T while_loop = ∞ (
            T check = → if i < len(rest) → P  // while body follows
                P tok = rest[i]
                T cond = → if skip_next → P
                    P skip_next = 0
                    P i = i + 1
                    // continue
                T cond = → if (tok == manifold ["--target", "-t"] && (i + 1) < len(rest)) → P
                    P target = rest[(i + 1)]
                    P skip_next = 1
                → E P
                    T cond = → if (tok == manifold ["--arch", "-a"] && (i + 1) < len(rest)) → P
                        P arch = rest[(i + 1)]
                        P skip_next = 1
                    → E P
                        T cond = → if (tok == manifold ["--device"] && (i + 1) < len(rest)) → P
                            P device = rest[(i + 1)]
                            P skip_next = 1
                        → E P
                            T cond = → if tok == manifold ["--bare-metal", "--bare_metal"] → P bare_metal = 1
                            → E T cond = → if tok == manifold ["--debug", "-d"] → P  // pass
                P i = i + 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if len(positionals) ≥ 1 → P file_path = positionals[0]
        T cond = → if len(positionals) ≥ 2 → P output_path = positionals[1]
        T cond = → if (!file_path) → P
            sovereign_print ∘ "  ETPL Error: No source file specified."
            → P
        T cond = → if target == "bare_metal" → P bare_metal = 1
        P compiler = ETPLCompiler(manifold ["target_type", target], manifold ["target_arch", arch], manifold ["target_device", device])
        T attempt = → P  // try
            compiler D compile_file(file_path, output_path, manifold ["bare_metal", bare_metal])
        → E FileNotFoundError (_)
            sovereign_print ∘ "  ETPL Error: File not found: " + file_path
        → E Exception (e)
            sovereign_print ∘ "  ETPL Compilation Error: " + e
            traceback D print_exc(P)
    }
    D ETPLCLI___cmd_translate = λ self, rest . {
        // translate <file> [--lang python|c_header|javascript|binary] [-o output.pdt]
        T cond = → if (!rest) → P
            sovereign_print ∘ "  Usage: translate <file> [--lang python|c_header|javascript|binary] [-o output.pdt]"
            → P
        P file_path = P
        P lang = "python"
        P output_path = P
        P skip_next = 0
        P i = 0
        T while_loop = ∞ (
            T check = → if i < len(rest) → P  // while body follows
                P tok = rest[i]
                T cond = → if skip_next → P
                    P skip_next = 0
                    P i = i + 1
                    // continue
                T cond = → if (tok == manifold ["--lang", "-l"] && (i + 1) < len(rest)) → P
                    P lang = rest[(i + 1)]
                    P skip_next = 1
                → E P
                    T cond = → if (tok == manifold ["--output", "-o"] && (i + 1) < len(rest)) → P
                        P output_path = rest[(i + 1)]
                        P skip_next = 1
                    → E T cond = → if (!tok D startswith("-")) → P file_path = tok
                P i = i + 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if (!file_path) → P
            sovereign_print ∘ "  ETPL Error: No source file specified."
            → P
        P translator = ETPLTranslator(manifold ["from_lang", lang])
        T attempt = → P  // try
            T cond = → if lang == "binary" → P etpl = translator D translate_binary(file_path)
            → E P etpl = translator D translate_file(file_path, lang)
            T cond = → if output_path → P
                T scope_fh = → open(output_path, "w", manifold ["encoding", "utf-8"])
                P fh = scope_fh  // context var
                    fh D write(etpl)
                sovereign_print ∘ "  ETPL: Translated → " + output_path
            → E sovereign_print ∘ etpl
        → E FileNotFoundError (_)
            sovereign_print ∘ "  ETPL Error: File not found: " + file_path
        → E Exception (e)
            sovereign_print ∘ "  ETPL Translation Error: " + e
            traceback D print_exc(P)
    }
    D ETPLCLI___cmd_repl = λ self, rest . {
        // Launch the ETPL expression REPL (nested inside the CLI shell).
        P repl = ETPLREPL(P)
        repl D run(P)
    }
    D ETPLCLI___cmd_verify = λ self, rest . {
        // Run the ETPL self-verification suite.
        verify_etpl(P)
    }
    D ETPLCLI___cmd_toolchain = λ self, rest . {
        // Diagnose (and optionally fix) the ETPL compilation toolchain.
        P auto_fix = "--fix" == rest
        toolchain_diagnose(manifold ["auto_fix", auto_fix])
    }
    D ETPLCLI___cmd_help = λ self, rest . {
        // Print the full command reference.
        sovereign_print ∘ _ETPL_HELP
    }
    D ETPLCLI___cmd_version = λ self, rest . {
        // Print version and build string.
        sovereign_print ∘ "  ETPL " + ETPL_VERSION + "  (build: " + ETPL_BUILD + ")"
        sovereign_print ∘ "  Platform: " + platform D system(P) + " " + platform D machine(P) + "  |  Python " + sys D version D split(P)[0]
    }
    D ETPLCLI___cmd_clear = λ self, rest . {
        // Clear the terminal screen.          ET Form: P(terminal state) D(ANSI erase constraint) T(print traversal) = E(clear scr
        sovereign_print ∘ "[2J[H"
    }
    D ETPLCLI___cmd_exit = λ self, rest . {
        // Exit the ETPL interactive shell.
        sovereign_print ∘ "→ E (shell grounded)"
        D self_D__running = 0  // self D _running := 0
    }
D build_argparser = λ  . {
    // Construct the one-shot ArgumentParser for direct invocation.      ET D-Binding: each subparser is a Descriptor that cons
    P parser = argparse D ArgumentParser(manifold ["prog", "ETPL"], manifold ["description", "Exception Theory Programming Language — Complete Toolchain"], manifold ["epilog", "\"For every exception there is an exception, except the exception.\""], manifold ["formatter_class", argparse D RawDescriptionHelpFormatter])
    parser D add_argument("--version", manifold ["action", "version"], manifold ["version", "ETPL " + ETPL_VERSION])
    P subparsers = parser D add_subparsers(manifold ["dest", "command"], manifold ["help", "Available commands"])
    P p_interp = subparsers D add_parser("interpret", manifold ["aliases", manifold ["run", "i"]], manifold ["help", "Interpret an ETPL .pdt source file"])
    p_interp D add_argument("file", manifold ["help", "Path to .pdt file"])
    p_interp D add_argument("--debug", "-d", manifold ["action", "store_true"], manifold ["help", "Enable verbose AST + binding trace"])
    P p_compile = subparsers D add_parser("compile", manifold ["aliases", manifold ["build", "c"]], manifold ["help", "Compile an ETPL .pdt file to a native binary"])
    p_compile D add_argument("file", manifold ["help", "Path to .pdt source file"])
    p_compile D add_argument("output", manifold ["nargs", "?"], manifold ["default", P], manifold ["help", "Output file path (auto-named if omitted)"])
    p_compile D add_argument("--target", "-t", manifold ["default", "classical"], manifold ["choices", manifold ["classical", "quantum", "hybrid", "bare_metal"]], manifold ["help", "Compilation target (default: classical)"])
    p_compile D add_argument("--arch", "-a", manifold ["default", "universal"], manifold ["help", "Target architecture: x86_64 | arm64 | riscv64 | wasm | universal"])
    p_compile D add_argument("--device", manifold ["default", "any"], manifold ["help", "Target device identifier for hardware-access emission"])
    p_compile D add_argument("--bare-metal", manifold ["action", "store_true"], manifold ["help", "Bare-metal mode: no OS dependencies, raw entry point"])
    P p_trans = subparsers D add_parser("translate", manifold ["aliases", manifold ["trans", "t"]], manifold ["help", "Translate a foreign-language source file into ETPL .pdt"])
    p_trans D add_argument("file", manifold ["help", "Source file to translate"])
    p_trans D add_argument("--lang", "-l", manifold ["default", "python"], manifold ["choices", manifold ["python", "c_header", "javascript", "binary"]], manifold ["help", "Source language (default: python)"])
    p_trans D add_argument("--output", "-o", manifold ["default", P], manifold ["help", "Output .pdt file path (stdout if omitted)"])
    subparsers D add_parser("verify", manifold ["aliases", manifold ["test", "v"]], manifold ["help", "Run the ETPL self-verification suite"])
    subparsers D add_parser("repl", manifold ["aliases", manifold ["shell"]], manifold ["help", "Start the interactive ETPL expression REPL"])
    subparsers D add_parser("cli", manifold ["help", "Start the full interactive ETPL CLI shell (default when no args given)"])
    P p_toolchain = subparsers D add_parser("toolchain", manifold ["aliases", manifold ["tc"]], manifold ["help", "Diagnose and optionally repair the ETPL compilation toolchain"])
    p_toolchain D add_argument("--fix", manifold ["action", "store_true"], manifold ["help", "Attempt auto-repair of toolchain issues"])
    subparsers D add_parser("help", manifold ["help", "Print the full ETPL command reference"])
    → parser
}
D main = λ  . {
    // ETPL master entry point.      ET Form:  P(sys.argv) ∘ D(argparser) ∘ T(dispatcher) = E(result)      When invoked with no
    T cond = → if len(sys D argv) == 1 → P
        ETPLCLI(P) D run(P)
        → P
    P parser = _build_argparser(P)
    P args = parser D parse_args(P)
    T cond = → if args D command == manifold ["interpret", "run", "i"] → P
        P interp = ETPLInterpreter(manifold ["debug", args D debug])
        T attempt = → P  // try
            P result = interp D interpret_file(args D file)
            T cond = → if (result ≠ P && args D debug) → sovereign_print ∘ "\n→ E: " + result
        → E ETGroundException (eg)
            sys D exit(eg D exit_code(P))
        → E FileNotFoundError (_)
            sovereign_print ∘ "ETPL Error: File not found: " + args D file
            sys D exit(1)
        → E Exception (e)
            sovereign_print ∘ "ETPL Runtime Error: " + e
            T cond = → if args D debug → traceback D print_exc(P)
            sys D exit(1)
    → E P
        T cond = → if args D command == manifold ["compile", "build", "c"] → P
            P bare_metal = (args D bare_metal || args D target == "bare_metal")
            P compiler = ETPLCompiler(manifold ["target_type", args D target], manifold ["target_arch", args D arch], manifold ["target_device", args D device])
            T attempt = → P  // try
                compiler D compile_file(args D file, args D output, manifold ["bare_metal", bare_metal])
            → E FileNotFoundError (_)
                sovereign_print ∘ "ETPL Error: File not found: " + args D file
                sys D exit(1)
            → E Exception (e)
                sovereign_print ∘ "ETPL Compilation Error: " + e
                traceback D print_exc(P)
                sys D exit(1)
        → E P
            T cond = → if args D command == manifold ["translate", "trans", "t"] → P
                P translator = ETPLTranslator(manifold ["from_lang", args D lang])
                T attempt = → P  // try
                    T cond = → if args D lang == "binary" → P etpl = translator D translate_binary(args D file)
                    → E P etpl = translator D translate_file(args D file, args D lang)
                    T cond = → if args D output → P
                        T scope_fh = → open(args D output, "w", manifold ["encoding", "utf-8"])
                        P fh = scope_fh  // context var
                            fh D write(etpl)
                        sovereign_print ∘ "ETPL: Translated → " + args D output
                    → E sovereign_print ∘ etpl
                → E FileNotFoundError (_)
                    sovereign_print ∘ "ETPL Error: File not found: " + args D file
                    sys D exit(1)
                → E Exception (e)
                    sovereign_print ∘ "ETPL Translation Error: " + e
                    traceback D print_exc(P)
                    sys D exit(1)
            → E P
                T cond = → if args D command == manifold ["verify", "test", "v"] → P
                    P success = verify_etpl(P)
                    sys D exit(if success → 0 → E 1)
                → E P
                    T cond = → if args D command == manifold ["repl", "shell"] → ETPLREPL(P) D run(P)
                    → E P
                        T cond = → if args D command == "cli" → ETPLCLI(P) D run(P)
                        → E P
                            T cond = → if args D command == manifold ["toolchain", "tc"] → toolchain_diagnose(manifold ["auto_fix", args D fix])
                            → E P
                                T cond = → if args D command == "help" → sovereign_print ∘ _ETPL_HELP
                                → E ETPLCLI(P) D run(P)
}
