import tkinter as tk
from tkinter import filedialog, messagebox, colorchooser
import threading
import sys
import math

try:
    from PIL import Image, ImageTk, ImageDraw, ImageFilter, ImageChops
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: OPTICAL DE-OCCLUSION (DARK CHANNEL DESCRIPTOR)
# ==============================================================================

class ET_Optical_Engine:
    def lift_optical_layer(self, img_pil, mask_pil, veil_color, density, protect, status_cb):
        """
        Solves the Optical Equation: J = (I - A) / t + A
        veil_color (A): The RGB color of the layer we are removing.
        density (omega): How aggressively to estimate layer thickness (0.0 - 1.0).
        protect (t0): Lower bound of transmission (prevents noise explosion).
        """
        width, height = img_pil.size
        pixels = img_pil.load()
        mask = mask_pil.load()
        
        # 1. NORMALIZE VEIL COLOR (A)
        # Ensure A is not perfectly black to avoid division by zero errors logic
        ar = max(5, veil_color[0])
        ag = max(5, veil_color[1])
        ab = max(5, veil_color[2])
        
        # 2. CALCULATE DARK CHANNEL (Estimating Thickness)
        status_cb("Mapping Layer Thickness (Dark Channel Descriptor)...")
        
        # We need a 'MinFilter' to find the darkest descriptor in the local patch
        # This estimates the 'haze' amount.
        # Patch size 15 is standard for atmospheric optics
        
        # We process the image relative to the Veil Color.
        # Construct a normalized image: I / A
        
        # Optimization: We can approximate the Dark Channel using Pillow's MinFilter
        # directly on the image, then scaling.
        
        min_img = img_pil.filter(ImageFilter.MinFilter(size=15))
        min_pix = min_img.load()
        
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        min_x, min_y, max_x, max_y = bbox
        
        updates = []
        
        # Protection factor (t0) - Minimum transmission
        # If t is too small, J -> Infinity (Noise)
        t0 = protect / 100.0
        omega = density / 100.0
        
        # 3. THE DE-OCCLUSION LOOP
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                if mask[x, y] == 0: continue
                
                # I (Observed Pixel)
                pr, pg, pb = pixels[x, y]
                
                # Dark Channel Calculation (Approximated)
                # The thickness of the veil is proportional to the minimum intensity 
                # relative to the veil color.
                
                # Min intensity in local patch (from pre-calc filter)
                local_min_rgb = min_pix[x, y]
                
                # Normalize by Veil Color
                # We find the channel that has the LEAST transmission
                norm_r = local_min_rgb[0] / ar
                norm_g = local_min_rgb[1] / ag
                norm_b = local_min_rgb[2] / ab
                
                dark_channel = min(norm_r, norm_g, norm_b)
                
                # Transmission (t)
                # t = 1 - omega * dark_channel
                t = 1.0 - (omega * dark_channel)
                
                # Clamp t to t0
                t = max(t0, t)
                
                # RECOVER SCENE RADIANCE (J)
                # J = (I - A) / t + A
                
                # Red
                jr = ((pr - ar) / t) + ar
                # Green
                jg = ((pg - ag) / t) + ag
                # Blue
                jb = ((pb - ab) / t) + ab
                
                # Clamp results
                jr = max(0, min(255, int(jr)))
                jg = max(0, min(255, int(jg)))
                jb = max(0, min(255, int(jb)))
                
                updates.append((x, y, (jr, jg, jb)))
                
        # Apply Updates
        for ux, uy, uval in updates:
            pixels[ux, uy] = uval
            
        return img_pil

# ==============================================================================
# GUI
# ==============================================================================

class ET_V18_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V18: OPTICAL UNBINDER (PHYSICS DE-OCCLUSION)")
        self.root.geometry("1200x950")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Optical_Engine()
        self.pil_img = None
        self.mask_img = None
        self.backup_img = None
        
        self.veil_color = (200, 200, 200) # Default White/Grey Haze
        
        self._layout()

    def _layout(self):
        t = tk.Frame(self.root, bg="#101010", pady=10)
        t.pack(fill=tk.X)
        
        # TOP ROW
        self.btn(t, "LOAD", self.load, "#004488")
        self.btn(t, "RESET", self.reset, "#882200")
        self.btn(t, "PICK VEIL COLOR", self.pick_color, "#444444")
        self.btn(t, "OPTICAL UNBIND", self.run, "#228822")
        
        # Color Indicator
        self.col_lbl = tk.Label(t, text="   ", bg="#cccccc", relief="sunken")
        self.col_lbl.pack(side=tk.LEFT, padx=5)
        
        # CONTROLS
        # 1. LAYER DENSITY (Omega): How much haze to remove
        f1 = tk.Frame(t, bg="#101010"); f1.pack(side=tk.LEFT, padx=15)
        tk.Label(f1, text="LAYER DENSITY", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.den_scale = tk.Scale(f1, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=120)
        self.den_scale.set(85) # High default for clothes
        self.den_scale.pack()
        
        # 2. PROTECTION (t0): Prevents noise in thick areas
        f2 = tk.Frame(t, bg="#101010"); f2.pack(side=tk.LEFT, padx=15)
        tk.Label(f2, text="NOISE PROTECT", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.pro_scale = tk.Scale(f2, from_=1, to=50, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=120)
        self.pro_scale.set(10) # 0.1
        self.pro_scale.pack()

        self.stat = tk.Label(t, text="Ready.", fg="#888", bg="#101010")
        self.stat.pack(side=tk.RIGHT, padx=20)
        
        # Canvas
        container = tk.Frame(self.root)
        container.pack(fill=tk.BOTH, expand=True)
        self.cv = tk.Canvas(container, bg="#080808", cursor="crosshair")
        vs = tk.Scrollbar(container, orient="vertical", command=self.cv.yview)
        hs = tk.Scrollbar(container, orient="horizontal", command=self.cv.xview)
        self.cv.config(yscrollcommand=vs.set, xscrollcommand=hs.set)
        
        vs.pack(side=tk.RIGHT, fill=tk.Y)
        hs.pack(side=tk.BOTTOM, fill=tk.X)
        self.cv.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.cv.bind("<Button-1>", self.down)
        self.cv.bind("<B1-Motion>", self.drag)
        self.cv.bind("<ButtonRelease-1>", self.up)
        
        self.drawing=False; self.brush=30

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", relief="flat", padx=10, pady=5).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            self.pil_img = Image.open(path).convert("RGB")
            self.backup_img = self.pil_img.copy()
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            self.cv.config(scrollregion=(0,0,self.pil_img.width,self.pil_img.height))
            self.update_view()
            self.stat.config(text=f"Loaded: {self.pil_img.size}")
        except: pass

    def update_view(self):
        if not self.pil_img: return
        d = self.pil_img.copy()
        if self.mask_img.getbbox():
            r = Image.new("RGB", self.pil_img.size, (255,0,0)) 
            d = Image.composite(r, d, self.mask_img)
        self.tk = ImageTk.PhotoImage(d)
        self.cv.create_image(0,0, image=self.tk, anchor=tk.NW)

    def pick_color(self):
        c = colorchooser.askcolor(title="Select Layer Color (Veil)")[0]
        if c:
            self.veil_color = (int(c[0]), int(c[1]), int(c[2]))
            # Update indicator
            hex_c = '#%02x%02x%02x' % self.veil_color
            self.col_lbl.config(bg=hex_c)
            self.stat.config(text=f"Veil Color Set: {self.veil_color}")

    def down(self,e): 
        x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
        self.drawing=True; self.lp=(x,y)
        
    def drag(self,e):
        if self.drawing and self.mask_img:
            x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
            d = ImageDraw.Draw(self.mask_img)
            d.line([self.lp, (x,y)], fill=255, width=self.brush)
            d.ellipse([x-15,y-15,x+15,y+15], fill=255)
            self.lp=(x,y); 
            self.cv.create_line(self.lp[0],self.lp[1],x,y,fill="red",width=self.brush,tags="t")

    def up(self,e): self.drawing=False; self.cv.delete("t"); self.update_view()
    
    def reset(self):
        if self.backup_img:
            self.pil_img = self.backup_img.copy()
            if self.mask_img: self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
            self.update_view()
            self.stat.config(text="Reset.")

    def run(self):
        if not self.pil_img: return
        self.stat.config(text="Calculating Optical Thickness...")
        
        den = self.den_scale.get()
        pro = self.pro_scale.get()
        vc = self.veil_color
        
        threading.Thread(target=self._w, args=(vc, den, pro)).start()

    def _w(self, v, d, p):
        res = self.engine.lift_optical_layer(self.pil_img, self.mask_img, v, d, p, self.log)
        self.pil_img = res
        self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
        self.root.after(0, self.update_view)
        self.root.after(0, lambda: self.stat.config(text="Layer Physically Removed."))

    def log(self, m): self.stat.config(text=m)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_V18_GUI(root)
    root.mainloop()