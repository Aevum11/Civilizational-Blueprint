D walk = λ top, topdown, onerror, followlinks . {
    // Directory tree generator.      For each directory in the directory tree rooted at top (including top     itself, but exc
    sys D audit("os.walk", top, topdown, onerror, followlinks)
    P stack = manifold [fspath(top)]
    P manifold__islink__join = manifold [path D islink, path D join]  // manifold [islink, join] := manifold [path D islink, path D join]
    T while_loop = ∞ (
        T check = → if stack → P  // while body follows
            P top = stack D pop(P)
            T cond = → if isinstance(top, tuple) → → top
            P dirs = manifold []
            P nondirs = manifold []
            P walk_dirs = manifold []
            T attempt = → P  // try
                P scandir_it = scandir(top)
            → E OSError (error)
                T cond = → if onerror ≠ P → onerror(error)
                // continue
            P cont = 0
            T scope_0 = → scandir_it
                T while_loop = ∞ (
                    T check = → if 1 → P  // while body follows
                        T attempt = → P  // try
                            T attempt = → P  // try
                                P entry = next(scandir_it)
                            → E StopIteration (_)
                                // break
                        → E OSError (error)
                            T cond = → if onerror ≠ P → onerror(error)
                            P cont = 1
                            // break
                        T attempt = → P  // try
                            T cond = → if followlinks == _walk_symlinks_as_files → P is_dir = (entry D is_dir(manifold ["follow_symlinks", 0]) && (!entry D is_junction(P)))
                            → E P is_dir = entry D is_dir(P)
                        → E OSError (_)
                            P is_dir = 0
                        T cond = → if is_dir → dirs D append(entry D name)
                        → E nondirs D append(entry D name)
                        T cond = → if ((!topdown) && is_dir) → P
                            T cond = → if followlinks → P walk_into = 1
                            → E P
                                T attempt = → P  // try
                                    P is_symlink = entry D is_symlink(P)
                                → E OSError (_)
                                    P is_symlink = 0
                                P walk_into = (!is_symlink)
                            T cond = → if walk_into → walk_dirs D append(entry D path)
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            T cond = → if cont → P  // pass
            T cond = → if topdown → P
                → manifold [top, dirs, nondirs]
                T loop = ∞ (
                    P dirname = reversed(dirs)[_loop_index]
                    P new_path = join(top, dirname)
                    T cond = → if (followlinks || (!islink(new_path))) → stack D append(new_path)
                ) (D |reversed(dirs)|)
            → E P
                stack D append(manifold [top, dirs, nondirs])
                T loop = ∞ (
                    P new_path = reversed(walk_dirs)[_loop_index]
                    stack D append(new_path)
                ) (D |reversed(walk_dirs)|)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
