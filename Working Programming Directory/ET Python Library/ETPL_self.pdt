D void = λ . P  // class
    // A private marker - used in Parameter & Signature.
D empty = λ . P  // class
    // Marker object for Signature.empty and Parameter.empty.
D ParameterKind = λ . P  // class(enum D IntEnum)
    P POSITIONAL_ONLY = "positional-only"
    P POSITIONAL_OR_KEYWORD = "positional or keyword"
    P VAR_POSITIONAL = "variadic positional"
    P KEYWORD_ONLY = "keyword-only"
    P VAR_KEYWORD = "variadic keyword"
    D ParameterKind____new = λ cls, description . {
        P value = len(cls D __members__)
        P member = int D __new__(cls, value)
        D member_D__value = value  // member D _value_ := value
        D member_D_description = description  // member D description := description
        → member
    }
    D ParameterKind____str = λ self . → self D name
P _POSITIONAL_ONLY = _ParameterKind D POSITIONAL_ONLY
P _POSITIONAL_OR_KEYWORD = _ParameterKind D POSITIONAL_OR_KEYWORD
P _VAR_POSITIONAL = _ParameterKind D VAR_POSITIONAL
P _KEYWORD_ONLY = _ParameterKind D KEYWORD_ONLY
P _VAR_KEYWORD = _ParameterKind D VAR_KEYWORD
D Parameter = λ . P  // class
    // Represents a parameter in a function signature.      Has the following public attributes:      * name : str         The 
    P __slots__ = manifold ["_name", "_kind", "_default", "_annotation"]
    P POSITIONAL_ONLY = _POSITIONAL_ONLY
    P POSITIONAL_OR_KEYWORD = _POSITIONAL_OR_KEYWORD
    P VAR_POSITIONAL = _VAR_POSITIONAL
    P KEYWORD_ONLY = _KEYWORD_ONLY
    P VAR_KEYWORD = _VAR_KEYWORD
    P empty = _empty
