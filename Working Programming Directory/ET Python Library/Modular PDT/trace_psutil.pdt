    D Popen____exit = λ self . {
        T cond = → if hasattr(self D __subproc, "__exit__") → → self D __subproc D __exit__(args, kwargs)
        → E P
            T cond = → if self D stdout → self D stdout D close(P)
            T cond = → if self D stderr → self D stderr D close(P)
            T attempt = → P  // try
                T cond = → if self D stdin → self D stdin D close(P)
            // finally:
                self D wait(P)
