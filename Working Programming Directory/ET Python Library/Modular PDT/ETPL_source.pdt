    D ETPLInterpreter___setup_stdlib_registry = λ self . {
        // Pre-load common stdlib modules into the environment at interpreter startup.          ET Descriptor Completeness (Eq 223)
        // @ETPL:preload importlib importlib
        // Import importlib — resolved at translate-time
        // @ETPL:preload __import__ importlib.__import__
        P __import__ = P  // [ET:callable:importlib.__import__]
        // @ETPL:preload import_module importlib.import_module
        P import_module = P  // [ET:callable:importlib.import_module]
        // @ETPL:preload invalidate_caches importlib.invalidate_caches
        P invalidate_caches = P  // [ET:callable:importlib.invalidate_caches]
        // @ETPL:preload reload importlib.reload
        P reload = P  // [ET:callable:importlib.reload]
        P _stdlib_modules = manifold ["os", "os.path", "sys", "math", "cmath", "re", "json", "time", "io", "pathlib", "stat", "errno", "signal", "struct", "hashlib", "random", "string", "collections", "itertools", "functools", "operator", "copy", "types", "abc", "typing", "dataclasses", "enum", "decimal", "fractions", "numbers", "builtins", "platform", "subprocess"]
        T cond = → if sys D platform ≠ "win32" → _stdlib_modules D append("posix")
        → E _stdlib_modules D append("nt")
        T loop = ∞ (
            P modname = _stdlib_modules[_loop_index]
            T attempt = → P  // try
                P mod = importlib D import_module(modname)
                P safe_mod = modname D replace(".", "_")
                // self D env[safe_mod] := mod
                T cond = → if hasattr(mod, "__all__") → P export_names = list(mod D __all__)
                → E P export_names = { T loop = ∞ (n → E (!n D startswith("_"))) (D |dir(mod)|) }
                T loop = ∞ (
                    P name = export_names[_loop_index]
                    T attempt = → P  // try
                        P value = getattr(mod, name, P)
                        T cond = → if value ≠ P → P
                            P safe_name = re D sub("[^a-zA-Z0-9_]", "_", name)
                            T cond = → if safe_name ≠ self D env → P  // pass
                    → E Exception (_)
                        // pass
                ) (D |export_names|)
            → E manifold [ImportError, Exception] (_)
                // pass
        ) (D |_stdlib_modules|)
        // self D env["len"] := len
        // self D env["range"] := range
        // self D env["list"] := list
        // self D env["dict"] := dict
        // self D env["set"] := set
        // self D env["tuple"] := tuple
        // self D env["int"] := int
        // self D env["float"] := float
        // self D env["str"] := str
        // self D env["bool"] := bool
        // self D env["bytes"] := bytes
        // self D env["type"] := type
        // self D env["isinstance"] := isinstance
        // self D env["hasattr"] := hasattr
        // self D env["getattr"] := getattr
        // self D env["setattr"] := setattr
        // self D env["print"] := print
        // self D env["open"] := open
        // self D env["repr"] := repr
        // self D env["sorted"] := sorted
        // self D env["reversed"] := reversed
        // self D env["enumerate"] := enumerate
        // self D env["zip"] := zip
        // self D env["any"] := any
        // self D env["all"] := all
        // self D env["min"] := min
        // self D env["max"] := max
        // self D env["sum"] := _et_sum
        // self D env["round"] := round
        // self D env["id"] := id
        // self D env["hex"] := hex
        // self D env["oct"] := oct
        // self D env["bin"] := bin
        // self D env["chr"] := chr
        // self D env["ord"] := ord
        // self D env["format"] := format
        // self D env["vars"] := vars
        // self D env["dir"] := dir
        // self D env["iter"] := iter
        // self D env["next"] := next
        // self D env["callable"] := callable
        // self D env["staticmethod"] := staticmethod
        // self D env["classmethod"] := classmethod
        // self D env["property"] := property
        // self D env["super"] := super
        // self D env["object"] := object
        // self D env["Exception"] := Exception
        // self D env["ValueError"] := ValueError
        // self D env["TypeError"] := TypeError
        // self D env["RuntimeError"] := RuntimeError
        // self D env["ImportError"] := ImportError
        // self D env["OSError"] := OSError
        // self D env["IOError"] := IOError
        // self D env["KeyError"] := KeyError
        // self D env["IndexError"] := IndexError
