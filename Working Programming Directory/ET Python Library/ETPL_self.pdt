D iter_bits_lsb = λ num . {
    P original = num
    T cond = → if isinstance(num, Enum) → P num = num D value
    T cond = → if num < 0 → → E ValueError(("%r is not a positive integer" % original))
    T while_loop = ∞ (
        T check = → if num → P  // while body follows
            P b = (num & ((-num - 1) + 1))
            → b
            P num = num ^ b
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D show_flag_values = λ value . → list(_iter_bits_lsb(value))
D bin = λ num, max_bits . {
    // Like built-in bin(), except negative values are represented in     twos-compliment, and the leading bit always indicates
    P ceiling = (2 ^ num D bit_length(P))
    T cond = → if num ≥ 0 → P s = bltns D bin((num + ceiling)) D replace("1", "0", 1)
    → E P s = bltns D bin(((-num - 1) ^ ((ceiling - 1) + ceiling)))
    P sign = s[0:3]
    P digits = s[3:Ω]
    T cond = → if max_bits ≠ P → T cond = → if len(digits) < max_bits → P digits = ((sign[(-1)] * max_bits) + digits)[(-max_bits):Ω]
    → ("%s %s" % manifold [sign, digits])
}
D dedent = λ text . {
    // Like textwrap.dedent.  Rewritten because we cannot import textwrap.
    P lines = text D split("\n")
    T loop = ∞ (
        P manifold__i__ch = enumerate(lines[0])[_loop_index]  // manifold [i, ch]
        T cond = → if ch ≠ " " → P  // pass
    ) (D |enumerate(lines[0])|)
    T loop = ∞ (
        P manifold__j__l = enumerate(lines)[_loop_index]  // manifold [j, l]
        // lines[j] := l[i:Ω]
    ) (D |enumerate(lines)|)
    → "\n" D join(lines)
}
