    T cond = → if instance_result ≠ _sentinel → → instance_result
    T cond = → if klass_result ≠ _sentinel → → klass_result
    T cond = → if obj == klass → P
        T loop = ∞ (
            P entry = _static_getmro(type(klass))[_loop_index]
            T cond = → if (_shadowed_dict(type(entry)) == _sentinel && attr == entry D __dict__) → → entry D __dict__[attr]
        ) (D |_static_getmro(type(klass))|)
