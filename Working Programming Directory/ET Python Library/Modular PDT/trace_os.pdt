D makedirs = λ name, mode, exist_ok . {
    // makedirs(name [, mode=0o777][, exist_ok=False])      Super-mkdir; create a leaf directory and all intermediate ones.  Wo
    P manifold__head__tail = path D split(name)  // manifold [head, tail] := path D split(name)
    T cond = → if (!tail) → P manifold__head__tail = path D split(head)  // manifold [head, tail] := path D split(head)
    T cond = → if (head && tail && (!path D exists(head))) → P
        T attempt = → P  // try
            makedirs(head, manifold ["exist_ok", exist_ok])
        → E FileExistsError (_)
            // pass
        P cdir = curdir
        T cond = → if isinstance(tail, bytes) → P cdir = bytes(curdir, "ASCII")
        T cond = → if tail == cdir → → P
    T attempt = → P  // try
        mkdir(name, mode)
    → E OSError (_)
        T cond = → if ((!exist_ok) || (!path D isdir(name))) → → E P
}
D removedirs = λ name . {
    // removedirs(name)      Super-rmdir; remove a leaf directory and all empty intermediate     ones.  Works like rmdir except
    rmdir(name)
    P manifold__head__tail = path D split(name)  // manifold [head, tail] := path D split(name)
    T cond = → if (!tail) → P manifold__head__tail = path D split(head)  // manifold [head, tail] := path D split(head)
    T while_loop = ∞ (
        T check = → if (head && tail) → P  // while body follows
            T attempt = → P  // try
                rmdir(head)
            → E OSError (_)
                // break
            P manifold__head__tail = path D split(head)  // manifold [head, tail] := path D split(head)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D renames = λ old, new . {
    // renames(old, new)      Super-rename; create directories as necessary and delete any left     empty.  Works like rename, 
    P manifold__head__tail = path D split(new)  // manifold [head, tail] := path D split(new)
    T cond = → if (head && tail && (!path D exists(head))) → makedirs(head)
    rename(old, new)
    P manifold__head__tail = path D split(old)  // manifold [head, tail] := path D split(old)
    T cond = → if (head && tail) → P
        T attempt = → P  // try
            removedirs(head)
        → E OSError (_)
            // pass
}
