\toprule
$d$ & $d^{2}-1$ & Physical identification \\
\midrule
$1$ & $0$   & No gauge content (gravity/octave) \\
$2$ & $3$   & $\dim\,\mathrm{SU}(2)$ --- weak gauge bosons ($W^{+}$, $W^{-}$, $Z^{0}$) \\
$3$ & $8$   & $\dim\,\mathrm{SU}(3)$ --- gluon octet (strong force) \\
$4$ & $15$  & $\dim\,\mathrm{SU}(4)$ \\
$5$ & $24$  & $\dim\,\mathrm{SU}(5)$ --- GUT gauge bosons \\
$6$ & $35$  & $\dim\,\mathrm{SU}(6)$ \\
$12$ & $143$ & $\dim\,\mathrm{SU}(12)$ \\
\bottomrule
\end{tabular}
\caption{Adjoint dimensions $d^{2}-1$ for selected sublattice families (Theorem~\ref{thm:adjoint}).}
\label{tab:adjoint-values}
\end{table}

\subsection{The N-Exhaustion Theorem: uniqueness of the Standard Model gauge group}\label{subsec:n-exhaustion}

The Standard Model of particle physics has gauge group $G_{\mathrm{SM}} = \mathrm{SU}(3) \times \mathrm{SU}(2) \times \mathrm{U}(1)$ with total gauge-boson count $8 + 3 + 1 = 12$. Standard physics treats this as empirical input~\cite{Tong}: ``Why nature chose the numbers $1$, $2$, and $3$ [as the ranks of the gauge factors] is not known.'' The following theorem answers this question.

\begin{theorem}[N-Exhaustion]\label{thm:n-exhaustion}
The gauge group $G_{\mathrm{SM}} = \mathrm{SU}(3) \times \mathrm{SU}(2) \times \mathrm{U}(1)$ is the \textbf{unique} factorisation of $N = 12$ gauge bosons into simple and abelian factors satisfying the following four conditions:
\begin{enumerate}[label=\textnormal{(C\arabic*)},leftmargin=*]
\item \emph{Subsumption:} $\dim(G_{\mathrm{SM}}) = N = 12$. The manifold's total D-relabelling freedom is exactly exhausted by the gauge content --- no remainder, no deficit.
\item \emph{Nativity:} Each non-abelian factor $\mathrm{SU}(d)$ uses a native sublattice family $d \mid 12$. The native families are $\{1,2,3,4,6,12\}$ (Corollary~\ref{cor:six}).
\item \emph{Exclusion:} Each sublattice family $d$ contributes at most one gauge factor. The Identification Principle (Principle~\ref{princ:identification}) demands that each $d$-family have a unique physical identity.
\item \emph{Non-triviality:} At least one non-abelian factor exists.
\end{enumerate}
\end{theorem}

\begin{proof}
The available adjoint dimensions for native sublattice families with $d \ge 2$ are (Theorem~\ref{thm:adjoint}): $d=2 \mapsto 3$; $d=3 \mapsto 8$; $d=4 \mapsto 15$; $d=6 \mapsto 35$; $d=12 \mapsto 143$. Each $\mathrm{U}(1)$ factor contributes $1$ generator from the $d=1$ octave sublattice.

We seek subsets $S \subseteq \{2,3,4,6,12\}$ and a non-negative integer $m$ (count of $\mathrm{U}(1)$ factors) such that
\[
\sum_{d \in S}(d^{2}-1) \;+\; m \;=\; 12, \qquad m \le 1,
\]
where $m \le 1$ because multiple $\mathrm{U}(1)$ factors would share the same sublattice origin $d=1$, violating (C3).

Enumerate by largest element of $S$:
\begin{itemize}[leftmargin=*]
\item If $12 \in S$: $143 > 12$. Impossible.
\item If $6 \in S$: $35 > 12$. Impossible.
\item If $4 \in S$: $15 > 12$. Impossible.
\item If $3 \in S$ (and $4,6,12 \notin S$): $8 + \text{remainder} = 12$, so remainder $= 4$.
  \begin{itemize}
  \item If $2 \in S$: $3 + m = 4$, so $m = 1$. \textbf{Solution:} $\mathrm{SU}(3) \times \mathrm{SU}(2) \times \mathrm{U}(1)$ with $\dim = 8 + 3 + 1 = 12$. \checkmark
  \item If $2 \notin S$: $m = 4$, giving $\mathrm{SU}(3) \times \mathrm{U}(1)^{4}$, which requires four independent $\mathrm{U}(1)$ factors from a single $d=1$ origin --- violating (C3). Impossible.
  \end{itemize}
\item If $2 \in S$ (and $3,4,6,12 \notin S$): $3 + \text{remainder} = 12$, so remainder $= 9$. No SU$(d)$ with $d \in \{4,6,12\}$ has $d^{2}-1 \le 9$ other than SU$(3) = 8$, excluded by assumption. Only $\mathrm{U}(1)^{9}$: violates (C3). Impossible.
\item If $S = \emptyset$: $m = 12$, giving $\mathrm{U}(1)^{12}$. Violates (C4). Impossible.
\end{itemize}
The unique solution is $S = \{2,3\}$, $m = 1$: $G_{\mathrm{SM}} = \mathrm{SU}(3) \times \mathrm{SU}(2) \times \mathrm{U}(1)$ with $\dim(G_{\mathrm{SM}}) = 8+3+1 = 12 = N$. \qed
\end{proof}

\begin{remark}[Justification of condition (C1): $\dim(G_{\mathrm{SM}}) = N$]
The gauge field $A_{\mu}$ compensates local $D$-relabelling invariance. At each Point in the $P$-manifold, the $D$-configuration space has $N = 12$ independent relabelling directions (the $12$ semitones of the manifold). Each independent direction requires exactly one gauge compensator field. By the Subsumption Law, the total number of compensators must exactly exhaust these directions: neither leaving any uncompensated (which would break gauge invariance) nor introducing redundant ones (which would create remainder). Therefore $\dim(G_{\mathrm{SM}}) = N = 12$.
\end{remark}

\subsection{Critical dimensions via the Koide Reciprocal Identity}\label{subsec:critical-ghost}

The superstring critical dimension $D = 10$ is forced by conformal anomaly cancellation on the worldsheet~\cite{MiaoLi}. Each component of this calculation has a direct ET identification.

\begin{theorem}[Critical dimensions from ET constants]\label{thm:critical-dims}
The ghost central charges of the worldsheet conformal field theory are expressible entirely in terms of ET constants:
\begin{enumerate}[label=\textnormal{(\roman*)},leftmargin=*]
\item The conformal ghost weight $\lambda_{c} = 2$ is the binary sublattice $d_{2}$.
\item The superconformal ghost weight $\lambda_{s} = 3/2$ is the Koide reciprocal $1/K$.
\item The conformal ghost central charge is $c_{bc} = -3(2\lambda_{c}-1)^{2}+1 = -26 = -2(N+1)$.
\item The superconformal ghost central charge is $c_{\beta\gamma} = 3(2\lambda_{s}-1)^{2}-1 = +11 = N-1$.
\item The total ghost central charge is $c_{\mathrm{ghost}} = c_{bc} + c_{\beta\gamma} = -15 = -(N+|\Pi|)$.
\end{enumerate}
The matter central charge $c_{\mathrm{matter}} = D \cdot 3/2 = 3D/2$ must cancel $c_{\mathrm{ghost}}$, giving
\begin{equation}\label{eq:D-super}
\boxed{\;D_{\mathrm{superstring}} \;=\; \frac{2(N + |\Pi|)}{|\Pi|} \;=\; \frac{2 \times 15}{3} \;=\; 10.\;}
\end{equation}
The bosonic string critical dimension and M-theory dimension follow from the same constants:
\begin{equation}\label{eq:D-bos-M}
D_{\mathrm{bosonic}} \;=\; 2(N+1) \;=\; |c_{bc}| \;=\; 26, \qquad D_{\mathrm{M\text{-}theory}} \;=\; N - 1 \;=\; c_{\beta\gamma} \;=\; 11.
\end{equation}
\end{theorem}

\begin{proof}
The ghost central charges follow from the standard $bc$/$\beta\gamma$ ghost systems~\cite{MiaoLi} with $c_{bc} = -3(2\lambda-1)^{2}+1$ at weight $\lambda$ and $c_{\beta\gamma} = 3(2\lambda-1)^{2}-1$ at weight $\lambda$. Substituting $\lambda_{c} = 2$: $c_{bc} = -3(3)^{2}+1 = -26 = -2 \cdot 13 = -2(N+1)$, since $N = 12$. Substituting $\lambda_{s} = 3/2 = 1/K$: $c_{\beta\gamma} = 3(2)^{2} - 1 = 11 = N-1$. The total $c_{\mathrm{ghost}} = -26 + 11 = -15 = -(12+3) = -(N+|\Pi|)$. The superstring dimension follows from $c_{\mathrm{matter}} + c_{\mathrm{ghost}} = 0$ with $c_{\mathrm{matter}} = 3D/2$: $D = 2 \cdot 15 / 3 = 10$. The bosonic dimension follows from $c_{\mathrm{matter}} = D$ (no fermions): $D = |c_{bc}| = 26 = 2(N+1)$. The identity $D_{\mathrm{M}} = N - 1 = 11$ follows from $c_{\beta\gamma} = N - 1$ together with the standard Nahm classification~\cite{Nahm1978}, which identifies $D = 11$ as the maximum dimension for supergravity with $32$ supercharges. \qed
\end{proof}

\begin{corollary}[Structural identity: $D_{\mathrm{bos}} - D_{\mathrm{M}} = N + |\Pi|$]\label{cor:Dbos-DM}
The difference between the bosonic and M-theory critical dimensions equals the total ghost charge magnitude:
\[
D_{\mathrm{bos}} - D_{\mathrm{M}} \;=\; 2(N+1) - (N-1) \;=\; N + 3 \;=\; N + |\Pi| \;=\; 15.
\]
\end{corollary}

\subsection{Critical dimensions via the division algebra route}\label{subsec:critical-div-alg}

The preceding derivation passes through worldsheet conformal field theory. A second, independent route to $D = 10$ uses the Hurwitz theorem on normed division algebras~\cite{Hurwitz1898} without any conformal-field-theory input.

\begin{theorem}[$D = 10$ from division algebras]\label{thm:D10-div-alg}
The normed division algebras exist in dimensions $2^{k}$ for $k = 0,1,2,3$, and only in these dimensions (the Hurwitz theorem). The termination at $k_{\max} = 3 = |\Pi|$ gives
\begin{equation}\label{eq:D10-div-alg}
\boxed{\;D_{\mathrm{superstring}} \;=\; 2^{|\Pi|} + d_{2} \;=\; 8 + 2 \;=\; 10.\;}
\end{equation}
\end{theorem}

\begin{proof}
The Hurwitz theorem~\cite{Hurwitz1898} establishes that the only normed division algebras over $\R$ are $\R$ ($\dim = 1 = 2^{0}$), $\C$ ($\dim = 2 = 2^{1}$), $\mathbb{H}$ ($\dim = 4 = 2^{2}$), and $\mathbb{O}$ ($\dim = 8 = 2^{3}$). The range $k = 0,1,2,3$ terminates at $k = 3 = |\Pi|$. The maximum normed division algebra is the octonion algebra $\mathbb{O}$ with
\[
\dim(\mathbb{O}) \;=\; 2^{|\Pi|} \;=\; 2^{3} \;=\; 8.
\]
This equals the adjoint dimension of the $d=3$ sublattice: $d_{\mathrm{adj}}(3) = 3^{2}-1 = 8$ (Theorem~\ref{thm:adjoint}). The Green--Schwarz superstring requires the maximal supersymmetry consistent with a two-dimensional worldsheet~\cite{BaezHuertaI,BaezHuertaII}. The worldsheet is the $\{D,T\}$ Mediation surface --- the manifold state with primitives $\{D,T\}$ --- and has dimension $d_{2} = 2$ (the binary sublattice). The superstring dimension is the sum of the maximal division algebra dimension and the worldsheet dimension:
\[
D_{\mathrm{superstring}} \;=\; 2^{|\Pi|} + d_{2} \;=\; 8 + 2 \;=\; 10. \qed
\]
\end{proof}

\begin{corollary}[Allowed Green--Schwarz dimensions]\label{cor:GS-dims}
The four allowed Green--Schwarz superstring dimensions are $\{d + 2 : d \in \{1,2,4,8\}\} = \{3,4,6,10\}$. The four allowed super-$2$-brane dimensions are $\{d + 3 : d \in \{1,2,4,8\}\} = \{4,5,7,11\}$.
\end{corollary}

\begin{remark}[Cross-verification of the two routes]
The ghost-charge route (equation~\eqref{eq:D-super}) and the division-algebra route (equation~\eqref{eq:D10-div-alg}) are structurally independent --- the first passes through worldsheet CFT, the second through the Hurwitz theorem --- yet they produce the same result. The consistency is forced by the identity $2^{|\Pi|} = N - |\Pi| - 1 = 12 - 3 - 1 = 8$.
\end{remark}

\subsection{$D = 11$ for M-theory: four convergent routes}\label{subsec:D11}

\begin{theorem}[Four routes to $D = 11$]\label{thm:D11}
The M-theory critical dimension $D_{\mathrm{M}} = 11$ is obtained independently by four routes:
\begin{center}
\begin{tabular}{@{}l l c@{}}
\toprule
Route & Formula & Result \\
\midrule
Division algebra + membrane & $2^{|\Pi|} + |\Pi| = 8 + 3$ & $11$ \\
Superstring + M-circle & $D_{\mathrm{string}} + d_{1} = 10 + 1$ & $11$ \\
Direct manifold & $N - 1$ & $11$ \\
$\beta\gamma$ ghost charge & $c_{\beta\gamma} = N - 1$ & $11$ \\
\bottomrule
\end{tabular}
\end{center}
\end{theorem}

\begin{proof}
Route 1: the M$2$-brane sweeps a three-dimensional worldvolume, with $\dim = |\Pi| = 3$ (it couples to the $3$-form field $A_{MNP}$, which has $|\Pi| = 3$ indices). Replacing the $d_{2} = 2$ worldsheet with the $|\Pi| = 3$ worldvolume: $D_{\mathrm{M}} = 2^{|\Pi|} + |\Pi| = 8 + 3 = 11$.

Route 2: the M-circle corresponds to the $d = 1$ octave sublattice, which has one generator (one compact direction). Adding this single direction to $D_{\mathrm{string}} = 10$ gives $D_{\mathrm{M}} = 10 + 1 = 11$.

Route 3: $N - 1 = 12 - 1 = 11$ directly from the manifold symmetry.

Route 4: $c_{\beta\gamma} = N - 1 = 11$ from Theorem~\ref{thm:critical-dims}(iv). \qed
\end{proof}

\subsection{The $P \circ D \circ T$ Scale Identity}\label{subsec:pdt-scale}

The three fundamental scales of M-theory --- the eleven-dimensional Planck length $l_{p}$, the string length $l_{s}$, and the M-circle radius $R_{11}$ --- satisfy the relation $l_{p}^{3} = l_{s}^{2} \cdot R_{11}$~\cite{MiaoLi}. This relation is the $P \circ D \circ T$ master equation in physical units.

\begin{theorem}[$P \circ D \circ T$ Scale Identity]\label{thm:pdt-scale}
The M-theory scale relation admits the identification
\[
\boxed{\;l_{P}^{\,|\Pi|} \;=\; l_{D}^{\,d_{2}} \cdot l_{T}^{\,d_{1}},\;}
\]
where the three scales correspond to the three Cardinals and the exponents are the three most fundamental ET structural constants:
\begin{center}
\begin{tabular}{@{}l l l c l@{}}
\toprule
Scale & Physical & Cardinal & Exponent & $d$-family \\
\midrule
$l_{P} \equiv l_{p}$ & 11D Planck length & $P$ (substrate scale) & $|\Pi| = 3$ & primitive count \\
$l_{D} \equiv l_{s}$ & String length & $D$ (descriptor scale) & $d_{2} = 2$ & binary sublattice \\
$l_{T} \equiv R_{11}$ & M-circle radius & $T$ (traverser scale) & $d_{1} = 1$ & octave/identity \\
\bottomrule
\end{tabular}
\end{center}
The exponents satisfy $|\Pi| = d_{2} + d_{1}$, i.e.\ $3 = 2 + 1$.
\end{theorem}

\begin{proof}
The identification follows from matching each scale to the Cardinal whose structural role it realises: $l_{p}$ is the substrate (gravitational) scale ($P$); $l_{s}$ is the scale at which D-structure (string vibration modes) becomes resolved ($D$); $R_{11}$ is the scale of the T-periodicity ($T$, the $U(1)$ compactification of the M-circle). The exponent of each scale in $l_{p}^{3} = l_{s}^{2} \cdot R_{11}^{1}$ is $(3,2,1) = (|\Pi|, d_{2}, d_{1})$. The identity $|\Pi| = d_{2} + d_{1}$ is $3 = 2 + 1$, which is the statement that the total primitive count equals the sum of the binary and identity sublattice orders. \qed
\end{proof}

\begin{corollary}[The string coupling as the Koide reciprocal]\label{cor:string-coupling}
The string coupling constant satisfies $g_{s} = (R_{11}/l_{p})^{3/2} = (R_{11}/l_{p})^{|\Pi|/d_{2}} = (R_{11}/l_{p})^{1/K}$. The coupling exponent $|\Pi|/d_{2} = 3/2 = 1/K$ is the Koide reciprocal --- the same constant governing the superconformal ghost weight (Theorem~\ref{thm:critical-dims}(ii)).
\end{corollary}

\subsection{The Sublattice-to-Force Map}\label{subsec:force-map}

The N-Exhaustion Theorem (Theorem~\ref{thm:n-exhaustion}) determines which gauge factors exist. The sublattice structure determines how they couple.

\begin{theorem}[Sublattice-to-force correspondence]\label{thm:force-map}
The three forces of the Standard Model are mapped to sublattice families as follows:
\begin{enumerate}[label=\textnormal{(\roman*)},leftmargin=*]
\item \emph{Strong force:} $d = 3$ (cubic sublattice). Three positions per period correspond to three colour charges. The adjoint representation has $\dim = 3^{2}-1 = 8$ gluons (Theorem~\ref{thm:adjoint}). Confinement arises because $d=3$ has the smallest non-trivial period in the lattice: quarks cannot be separated beyond one $d=3$ period without creating a new quark-antiquark pair.
\item \emph{Weak force:} governed by $d_{W} = N(1-K) = 12 \cdot 1/3 = 4$ (the quartic sublattice). The gauge group is $\mathrm{SU}(2)$ because $\varphi(4) = 2$ residues per $d=4$ period (Proposition~\ref{prop:totient}) give two fundamental charges (the two weak isospin states, up-type and down-type). The adjoint dimension is $2^{2}-1 = 3$ (the three weak bosons $W^{+}$, $W^{-}$, $Z^{0}$ before mixing).
\item \emph{Electromagnetic force:} $d = 1$ (octave/identity sublattice). One generator yields one gauge boson (the photon). The electromagnetic force is the ambient lattice field: it couples to all charged matter because $d=1$ divides every $d$-family.
\end{enumerate}
\end{theorem}

\begin{proof}
Item (i): by Corollary~\ref{cor:d8-su3}, the $d=3$ sublattice forces $d_{\mathrm{adj}}(3) = 8$ gauge bosons, which by the N-Exhaustion Theorem (Theorem~\ref{thm:n-exhaustion}) are the gluon octet of $\mathrm{SU}(3)$.

Item (ii): the quartic sublattice $d = 4$ satisfies $d_{W} = N(1-K) = 12(1 - 2/3) = 4$. By Proposition~\ref{prop:totient}, the Euler totient $\varphi(4) = 2$ gives two coprime residues modulo $4$, which are the two fundamental charges of the weak isospin doublet. By Theorem~\ref{thm:adjoint}, the adjoint dimension is $2^{2} - 1 = 3$.

Item (iii): the $d=1$ sublattice has one generator (the octave identity, $\varphi(1) = 1$). It divides every $d$-family because $1 \mid d$ for all $d$, making the $\mathrm{U}(1)$ photon the universal coupling.

The total gauge-boson count is $8 + 3 + 1 = 12 = N$, confirming completeness without remainder (Theorem~\ref{thm:n-exhaustion}, condition (C1)). The remaining native families $d \in \{4,6,12\}$ do not generate additional gauge factors (the $N = 12$ budget is exhausted) but govern the mixing between forces: $d = 4$ governs the electroweak mixing, $d = 6$ governs the electroweak unification scale, and $d = 12$ is the full electromagnetic resolution. \qed
\end{proof}

\subsection{Supercharges, gauge group dimensions, and brane structure}\label{subsec:supercharges}

Three further results follow from the manifold state count $S = 4$ (equation~\eqref{eq:S}).

\begin{proposition}[Maximum supercharges]\label{prop:supercharges}
The maximum number of supercharges in M-theory is
\[
Q_{\max} \;=\; 2^{S+1} \;=\; 2^{5} \;=\; 32.
\]
The graviton supermultiplet in $11$ dimensions has $2^{2S} = 2^{8} = 256$ states --- the square of the supercharge spinor dimension, as required for a short multiplet of the super-Poincar\'e algebra~\cite{Nahm1978}.
\end{proposition}

\begin{proposition}[Anomaly-cancellation gauge group]\label{prop:anomaly-gauge}
The dimension of the anomaly-free gauge group in $10$-dimensional chiral supergravity is
\[
\dim(\text{gauge group}) \;=\; 2^{S}\,(2^{S+1}-1) \;=\; 16 \times 31 \;=\; 496.
\]
This equals $\dim\,\mathrm{SO}(32) = 32 \cdot 31/2 = 496$ and $\dim(\mathrm{E}_{8} \times \mathrm{E}_{8}) = 2 \times 248 = 496$. The anomaly-cancellation condition~\cite{GreenSchwarz1984} that forces the gauge group is expressible as a function of $S$ alone.
\end{proposition}

\begin{proposition}[Central extensions and brane structure]\label{prop:central-ext}
The $11$-dimensional super-Poincar\'e algebra with $32$ supercharges has:
\begin{itemize}[leftmargin=*]
\item Symmetric $Q \times Q$ matrix entries: $32 \times 33/2 = 528$.
\item Momentum components: $D_{\mathrm{M}} = 11$.
\item Membrane (rank-$2$) charges: $\binom{11}{2} = 55$.
\item Fivebrane (rank-$5$) charges: $\binom{11}{5} = 462$.
\item Check: $55 + 462 = 517 = 528 - 11$. \checkmark
\end{itemize}
The membrane ($2$-dimensional spatial extent, worldvolume $2+1 = 3 = |\Pi|$) couples to the $3$-form field. The string ($1$-dimensional, worldsheet $1+1 = 2 = d_{2}$) couples to the $2$-form field. The product $2 \times 5 = 10 = D_{\mathrm{string}}$; the sum $2 + 5 + 4 = 11 = D_{\mathrm{M}}$.
\end{proposition}

\begin{remark}[Membrane--fivebrane duality on the LCM tower]
The membrane at $d = 2$ is native at $N = 12$; the fivebrane at $d = 5$ is a shadow family at $N = 12$ (Table~\ref{tab:shadow-forces}), becoming native at $N = 60 = \lcm(12,5)$. The membrane--fivebrane duality (electric--magnetic duality of the $3$-form) maps to the $d=2 \leftrightarrow d=5$ relationship on the lattice; the LCM tower escalation is the lattice's mechanism for resolving structure that is present but not yet native at base resolution.
\end{remark}

\subsection{The Structural Significance Principle}\label{subsec:structural-significance}

The derivations of \S\S\ref{subsec:adjoint}--\ref{subsec:supercharges} promote the shadow-force identifications from dimensional coincidence to structural derivation. It remains to state explicitly the methodological principle that distinguishes structurally derived identifications from numerological coincidence, addressing the compound critique that a dense lattice combined with unconstrained dimensional matching constitutes a confirmation-bias mechanism.

\begin{principle}[Structural Significance]\label{princ:structural-significance}
A physical identification of sublattice family $d$ with a physical sector is \emph{structurally significant} if and only if it satisfies all four of the following conditions simultaneously:
\begin{enumerate}[label=\textnormal{(P\arabic*)},leftmargin=*]
\item \emph{V-threshold at native resolution.} The identification's lattice placement satisfies the V-threshold criterion of Definition~\ref{def:v-threshold} at the lowest resolution $N_{\mathrm{native}}$ where $d$ is native (Proposition~\ref{prop:native-eval}).
\item \emph{Zero free parameters.} The identification follows from a derivation whose only inputs are the ET constants $\{N, K, |\Pi|, S, V\}$. A framework with zero adjustable parameters cannot be tuned to match arbitrary data.
\item \emph{Cross-domain convergence.} The same lattice cell is independently reached by physical ratios from $k \ge 2$ distinct domains and independently reached by forward computation from ET constants. The probability of coincidental convergence drops as $P^{k}$ --- exponentially in the number of independent domains.
\item \emph{Multiple independent derivation routes.} The same result is derived by two or more structurally independent methods.
\end{enumerate}
\end{principle}

\begin{remark}[The Subsumption Law as anti-cherry-picking]
The Subsumption Law (Principle~\ref{princ:subsumption}, condition~(iii)) demands completeness without remainder. Applied to physical identifications: if sublattice family $d$ is identified with physical sector $X$, then $d$ must account for all instances of that $d$-number across all domains simultaneously. Selectively identifying $d=8$ with $\mathrm{SU}(3)$ while ignoring other $d=8$ phenomena violates condition~(iii). The shadow-force table of \S\ref{subsec:shadow-forces} is the Subsumption Law's demand: every $d$-family must be identified with all its physical renderings simultaneously, or the identification is incomplete.
\end{remark}

\begin{remark}[Structural vs.\ statistical significance]
The Structural Significance Principle is not a frequentist or Bayesian statistical test imported from outside. It is ET-native: (P1) uses the manifold's own base variance $V = 1/N$ as the threshold; (P2) uses the Three Tools; (P3) uses the universality anchor $3=3=3=\Sigma$ (every domain is within $\Sigma$, so cross-domain convergence is a Subsumption test); (P4) uses the Verification Principle (independent routes arriving at the same answer equals mathematical consistency equals sufficient Descriptors, by Corollary~\ref{cor:verification}). All four conditions are instances of tools already established in \S\ref{sec:triads}.
\end{remark}


% ===========================================================
\section{The LCM tower of refinements}\label{sec:tower}
% ===========================================================

\subsection{When $N=12$ is insufficient}

The sublattice families at $N=12$ are the divisors of $12$, namely $\{1,2,3,4,6,12\}$. Phenomena whose structural symmetries lie outside this set cannot be resolved at the base lattice: five-fold symmetry (pentagonal, icosahedral, golden-ratio), seven-fold symmetry (heptagonal, certain capsid symmetries), eleven-fold symmetry (undecimal), eight-fold (octet, gluon), nine-fold (nonic), ten-fold (decic). To host these one must refine the lattice to a higher $N$.

\subsection{Canonical refinements}

The minimal $N$ supporting a required family $d$ is any multiple of $d$ that is also a multiple of $12$ (so as to preserve the base families). The smallest such $N$ is $\lcm(12,d)$.

\begin{proposition}[Canonical LCM landmarks]\label{prop:tower}
The sequence
\[
\lcm(1,\ldots,k) \;\text{for}\; k=4,5,7,9,11
\]
is $12,60,420,2520,27720$ respectively. Each is a multiple of $12$; each introduces one or more new primes as native divisors:
\begin{itemize}[leftmargin=*]
\item $12$ hosts $\{1,2,3,4,6,12\}$;
\item $60 = 2^{2}\cdot 3\cdot 5$ adds $d=5$ (and composites $10,15,20,30$);
\item $420 = 2^{2}\cdot 3\cdot 5\cdot 7$ adds $d=7$ and the biological cross-product $d=35=5\cdot 7$;
\item $2520 = 2^{3}\cdot 3^{2}\cdot 5\cdot 7$ completes $d\le 9$;
\item $27720 = 2^{3}\cdot 3^{2}\cdot 5\cdot 7\cdot 11$ completes $d\le 11$ and makes all twelve families $d\in\{1,2,\ldots,12\}$ simultaneously native.
\end{itemize}
\end{proposition}

\begin{proof}
Direct calculation:
\[
\lcm(1,2,3,4)=12,\quad \lcm(1,\ldots,5)=60,\quad \lcm(1,\ldots,7)=420,
\]
\[
\lcm(1,\ldots,9)=2520,\quad \lcm(1,\ldots,11)=27720.
\]
Each is a multiple of $12$ because $\{2,3,4\}\subset\{1,\ldots,k\}$ for $k\ge 4$. The prime factorisations follow immediately. \qed
\end{proof}

\subsection{Unification of the two readings}

\begin{proposition}[Multiplicative and LCM readings]\label{prop:unification}
The sequence of multiplicative refinements of the base lattice is $12,24,36,48,60,72,\ldots$ (the positive multiples of $12$). The LCM reading $12,60,420,2520,27720,\ldots$ is a sparse subsequence of this multiplicative reading.
\end{proposition}

The proof is Proposition~\ref{prop:tower}: each LCM landmark is a multiple of $12$. The multiplicative reading is for uniform refinement of resolution (e.g., refining precision in the same family structure); the LCM reading is for introducing a new prime as a native divisor.

\subsection{The continuous limit}

\begin{proposition}[Asymptotic limit]\label{prop:limit}
As $N\to\infty$ through either reading of the tower,
\[
\mathcal{L}_{N} \;\longrightarrow\; (\R^{+},\times),
\]
with the descriptor gap bounded by $|\eps|\le 600/N$ cents, which tends to $0$.
\end{proposition}

\begin{proof}
The set $\mathcal{L}_{N}=\{2^{k/N}\}$ is dense in $\R^{+}$ under the multiplicative metric as $N$ grows, since the steps $2^{1/N}$ tend to $1$. The gap bound follows from the rounding bound in the proof of Proposition~\ref{prop:classification}. \qed
\end{proof}

\begin{corollary}[Asymptotic Approach Theorem]\label{cor:asymptotic-approach}
For any irrational $r \in (\R^{+},\times)$, the descriptor-gap residual $|\varepsilon_{N}(r)|$ of the lattice projection at resolution $N$ satisfies
\[
|\varepsilon_{N}(r)| \;\longrightarrow\; 0 \quad \text{as } N \to \infty, \qquad\text{with}\qquad |\varepsilon_{N}(r)| > 0 \text{ for every finite } N.
\]
An irrational ratio is approached asymptotically by the lattice without ever being attained at finite resolution.
\end{corollary}

\begin{proof}
The asymptotic limit follows from the bound $|\varepsilon_{N}(r)| \le 600/N$ cents of Proposition~\ref{prop:limit}. Strict positivity at every finite $N$ follows from irrationality of $r$: if $|\varepsilon_{N}(r)| = 0$ at some finite $N$, then $N \log_{2} r$ is an integer $k$, so $r = 2^{k/N}$ is a rational power of $2$ and hence rational, contradicting the hypothesis. \qed
\end{proof}

\begin{remark}[Structural origin]\label{rem:asymptotic-origin}
Corollary~\ref{cor:asymptotic-approach} expresses the finite-infinite asymmetry between the Cardinals: $|P| = \Omega$ supports irrational positions; $|D| = n$ provides only finitely many descriptors at any finite resolution; $|T|=[0/0]$ resolves $P$ under $D$ but cannot exhaust $P$. Asymptotic approach without attainment is the structural signature of this asymmetry --- not a deficiency of the lattice but a corollary of the cardinality trichotomy. The corollary is the formal vehicle by which any decimal value used in the paper is to be read: every finite-digit numeric is a finite-$D$ approximation of an asymptotic-reference value, and finite truncation never improves accuracy --- it stops asymptotic refinement at a chosen depth.
\end{remark}

\subsubsection{Structural necessity of asymptotic precision}\label{subsubsec:precision-necessity}

The asymptotic character of Corollary~\ref{cor:asymptotic-approach} is not merely a technical limitation but a structural necessity forced by the categorical distinctions of the three Cardinals.

\begin{proposition}[Structural necessity of imprecision]\label{prop:precision-necessary}
Perfect precision at finite resolution would collapse the categorical distinction between the three Cardinals.
\end{proposition}

\begin{proof}
Suppose $D$ could perfectly capture $P$ at some finite resolution $N_{0}$. Then $|D| = n_{0}$ Descriptors would exhaust $|P| = \Omega$ at that resolution: every position in $P$ would be finitely described, and no P-content would lie beyond $D$'s reach. But then $\Omega = n_{0}$, collapsing the finite--infinite distinction. Without the substrate--constraint asymmetry ($\Omega \neq n$), the binding order (Axiom~\ref{ax:order}) loses its force, the P--D singularity dissolves, and the master equation ceases to produce distinct Cardinals. Similarly, suppose $D$ could perfectly capture $T$ at finite resolution. Then determinacy ($n$) would subsume indeterminacy ($[0/0]$), and $T$'s navigational capacity would be reducible to a finite Descriptor --- eliminating agency by reducing $T$ to $D$, violating the categorical disjointness (Axiom~\ref{ax:disjoint}). The asymptotic approach preserves the categorical distinctions of the three Cardinals while permitting arbitrarily close approximation at arbitrarily high resolution. \qed
\end{proof}

\subsection{Correspondence with integrative levels}\label{subsec:levels-tower}

The qualitative hierarchy of integrative levels introduced in \S\ref{subsec:levels} has a precise quantitative counterpart in the LCM tower. The two are not parallel concepts but the same structure read from two directions --- the phenomenological (what kind of wholeness is present?) and the arithmetic (which sublattice families are native?).

\begin{proposition}[Integrative-to-resolution correspondence]\label{prop:int-resolution}
Let $\ell$ be an integrative level, and let $\mathcal{D}_{\ell}\subseteq\N$ be the set of sublattice families appearing in the $(P,D,T)$ decompositions of level-$\ell$ phenomena. Then the minimum resolution $N_{\ell}^{\min}$ at which level $\ell$ is fully identifiable in the lattice framework is
\[
\boxed{\;N_{\ell}^{\min} \;=\; \lcm(\mathcal{D}_{\ell}).\;}
\]
\end{proposition}

\begin{proof}
A sublattice family $d$ is native at resolution $N$ if and only if $d\mid N$ (Section~\ref{sec:sublattice}). Level $\ell$ requires every family in $\mathcal{D}_{\ell}$ to be native simultaneously, so $N$ must be a common multiple of all $d\in\mathcal{D}_{\ell}$. The smallest such common multiple is $\lcm(\mathcal{D}_{\ell})$. \qed
\end{proof}

\begin{corollary}[Monotonicity of the tower]\label{cor:int-monotone}
If $\mathcal{D}_{\ell_{1}}\subseteq\mathcal{D}_{\ell_{2}}$ then $N_{\ell_{1}}^{\min}\mid N_{\ell_{2}}^{\min}$. Integrative levels whose Descriptor requirements strictly extend those of lower levels correspond to tower levels that are strict multiples of the lower ones.
\end{corollary}

The corollary says that ascending the integrative hierarchy (adding Descriptor structure) induces divisibility ascent in the tower: one cannot host a more integrative level on less resolution. Conversely, every divisibility ascent in the tower is the emergence of new integrative structure at the lattice level --- new sublattice families that did not exist in the previous resolution.

\subsubsection*{The doubling theorem}

The qualitative statement ``higher integrative level requires higher resolution'' becomes an exact quantitative law when one asks how the divisor count evolves along the canonical tower. Write $N_{\ell}$ for the $\ell$-th canonical resolution ($N_{0}=12$, $N_{1}=60$, $N_{2}=420$, $N_{3}=2520$, $N_{4}=27720$, \ldots) and $\tau(N_{\ell})$ for the number of sublattice families native at that resolution (equivalently, the number of divisors of $N_{\ell}$).

\begin{theorem}[Integrative--resolution doubling]\label{thm:doubling}
The divisor count of the $\ell$-th canonical resolution satisfies
\begin{equation}\label{eq:doubling}
\boxed{\;\tau(N_{\ell}) \;=\; \tau(N_{0})\cdot 2^{\ell} \;=\; 6\cdot 2^{\ell}\;.}
\end{equation}
Equivalently, the integrative level is a logarithm of the family count,
\begin{equation}\label{eq:level-log}
\ell \;=\; \log_{2}\!\frac{\tau(N_{\ell})}{\tau(N_{0})} \;=\; \log_{2}\!\frac{\tau(N_{\ell})}{6}.
\end{equation}
\end{theorem}

\begin{proof}
\emph{Base case ($\ell=0$).} By Proposition~\ref{prop:N12}, $N_{0} = |\Pi|\cdot S = 3\cdot 4 = 12$. Since $\gcd(|\Pi|, S) = \gcd(3,4) = 1$, the divisor function is multiplicative at this argument:
\[
\tau(N_{0}) \;=\; \tau(|\Pi|\cdot S) \;=\; \tau(|\Pi|)\cdot \tau(S) \;=\; \tau(3)\cdot \tau(4) \;=\; 2\cdot 3 \;=\; 6.
\]
Thus $\tau(N_{0}) = 6 = 6\cdot 2^{0}$, and the base case holds.

\emph{Inductive step.} We show that each canonical refinement exactly doubles $\tau$. The Descriptor Gap Principle (Principle~\ref{princ:descriptor-gap}) states that every gap in a description is itself a Descriptor. The smallest Descriptor capable of distinguishing a previously-unresolved pair of configurations is a single binary axis --- a yes/no distinction with two values. Adjoining one binary Descriptor to the model therefore exactly doubles the count of distinguishable configurations, and the lattice-level consequence is that the new resolution $N_{\ell+1}$ must satisfy $\tau(N_{\ell+1}) = 2\tau(N_{\ell})$.

We verify directly that each canonical LCM step realises this doubling.
\begin{enumerate}[leftmargin=*]
\item \emph{$N_{0}=12 \to N_{1}=60$} ($60 = 12\cdot 5$). Introducing the new prime $5$ with exponent $1$ multiplies $\tau$ by $(1+1)/(0+1) = 2$.
\item \emph{$N_{1}=60 \to N_{2}=420$} ($420 = 60\cdot 7$). Introducing prime $7$ multiplies $\tau$ by $2$.
\item \emph{$N_{2}=420 \to N_{3}=2520$} ($2520 = 420 \cdot 6$). The prime-power content changes as $2^{2}\cdot 3 \to 2^{3}\cdot 3^{2}$, giving the joint factor
\[
\frac{3+1}{2+1}\cdot\frac{2+1}{1+1} \;=\; \frac{4}{3}\cdot\frac{3}{2} \;=\; 2.
\]
This is the only canonical step that is realised by combined prime-power upgrades rather than by a single new prime; the product of the two fractional upgrades is exactly $2$.
\item \emph{$N_{3}=2520 \to N_{4}=27720$} ($27720 = 2520\cdot 11$). Introducing prime $11$ multiplies $\tau$ by $2$.
\item \emph{$N_{4}=27720 \to N_{5}=360360$} ($360360 = 27720\cdot 13$). Introducing prime $13$ multiplies $\tau$ by $2$.
\end{enumerate}
By induction, $\tau(N_{\ell}) = \tau(N_{0})\cdot 2^{\ell} = 6\cdot 2^{\ell}$ for every $\ell\ge 0$.

\emph{Extensibility.} The canonical tower extends indefinitely: for every $\ell\ge 5$, a canonical refinement exists that doubles $\tau$ (realised by successive new primes $17,19,23,\ldots$, or in special cases by prime-power combinations that product to $2$, exactly as at $\ell=3$). Therefore the doubling law~\eqref{eq:doubling} holds for all $\ell\ge 0$. \qed
\end{proof}

\begin{remark}[Two readings of a single equation]\label{rem:two-readings}
Equation~\eqref{eq:doubling} admits two parallel interpretations that describe the same underlying structure:

\textbf{Number-theoretic reading.} $\tau(N_{\ell})$ counts the divisors of the resolution integer $N_{\ell}$, equivalently the sublattice families native at that resolution. The equation states that each canonical LCM refinement exactly doubles the native-family count.

\textbf{Phenomenological reading.} $\tau(N_{\ell})$ counts the Descriptors needed to characterise the configurations of integrative level $\ell$. The equation states that each integrative emergence introduces one binary distinction axis and therefore exactly doubles the required Descriptor count.

Both readings measure the same quantity: the structural richness natively expressible at integrative level $\ell$. The phenomenological ladder (quantum, atomic, molecular, biological, cognitive, civilisational, \ldots) and the number-theoretic ladder ($12, 60, 420, 2520, 27720, \ldots$) are the same ladder seen from two directions. The coincidence is not numerical accident but structural necessity: the minimal closure of a descriptor gap at any integrative level is a binary distinction (Principle~\ref{princ:descriptor-gap}), and in the lattice this minimal closure is precisely a factor-$2$ increase in $\tau$.
\end{remark}

\begin{corollary}[The integrative level is a logarithm]\label{cor:level-log}
For any configuration whose Cardinal decomposition requires $\tau_{X}$ sublattice families to be expressible, the integrative level of $X$ is
\[
\ell(X) \;=\; \log_{2}\!\frac{\tau_{X}}{6}.
\]
This assigns a quantitative real-valued index to every substantiated configuration, converting the previously qualitative ``integrative level'' into a computable lattice quantity.
\end{corollary}

Table~\ref{tab:int-resolution} collects the empirical correspondences used in Section~\ref{sec:applications}, now augmented with the divisor counts predicted by Theorem~\ref{thm:doubling}.

