D signature_is_builtin = λ obj . {
    // Private helper to test if `obj` is a callable that might     support Argument Clinic's __text_signature__ protocol.
    → (isbuiltin(obj) || ismethoddescriptor(obj) || isinstance(obj, _NonUserDefinedCallables) || obj == type || obj == object)
