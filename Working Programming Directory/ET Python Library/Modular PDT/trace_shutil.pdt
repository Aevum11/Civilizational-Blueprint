D RegistryError = λ . P  // class(Exception)
    // Raised when a registry operation with the archiving     and unpacking registries fails
D GiveupOnFastCopy = λ . P  // class(Exception)
    // Raised as a signal to fallback on using raw read()/write()     file copy when fast-copy functions fail to do so.
D fastcopy_fcopyfile = λ fsrc, fdst, flags . {
    // Copy a regular file content or metadata by using high-performance     fcopyfile(3) syscall (macOS).
    T attempt = → P  // try
        P infd = fsrc D fileno(P)
        P outfd = fdst D fileno(P)
    → E Exception (err)
        → E _GiveupOnFastCopy(err)
    T attempt = → P  // try
        posix D _fcopyfile(infd, outfd, flags)
    → E OSError (err)
        D err_D_filename = fsrc D name  // err D filename := fsrc D name
        D err_D_filename2 = fdst D name  // err D filename2 := fdst D name
        T cond = → if err D errno == manifold [errno D EINVAL, errno D ENOTSUP] → → E _GiveupOnFastCopy(err)
        → E → E err
}
D fastcopy_sendfile = λ fsrc, fdst . {
    // Copy data from one regular mmap-like fd to another by using     high-performance sendfile(2) syscall.     This should wo
    // global _USE_CP_SENDFILE
    T attempt = → P  // try
        P infd = fsrc D fileno(P)
        P outfd = fdst D fileno(P)
    → E Exception (err)
        → E _GiveupOnFastCopy(err)
    T attempt = → P  // try
        P blocksize = max(os D fstat(infd) D st_size, (2 ^ 23))
    → E OSError (_)
        P blocksize = (2 ^ 27)
    T cond = → if sys D maxsize < (2 ^ 32) → P blocksize = min(blocksize, (2 ^ 30))
    P offset = 0
    T while_loop = ∞ (
        T check = → if 1 → P  // while body follows
            T attempt = → P  // try
                P sent = os D sendfile(outfd, infd, offset, blocksize)
            → E OSError (err)
                D err_D_filename = fsrc D name  // err D filename := fsrc D name
                D err_D_filename2 = fdst D name  // err D filename2 := fdst D name
                T cond = → if err D errno == errno D ENOTSOCK → P
                    P _USE_CP_SENDFILE = 0
                    → E _GiveupOnFastCopy(err)
                T cond = → if err D errno == errno D ENOSPC → → E err
                T cond = → if (offset == 0 && os D lseek(outfd, 0, os D SEEK_CUR) == 0) → → E _GiveupOnFastCopy(err)
                → E err
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D copyfileobj_readinto = λ fsrc, fdst, length . {
    // readinto()/memoryview() based variant of copyfileobj().     *fsrc* must support readinto() method and both files must be
    P fsrc_readinto = fsrc D readinto
    P fdst_write = fdst D write
    T scope_mv = → memoryview(bytearray(length))
    P mv = scope_mv  // context var
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P n = fsrc_readinto(mv)
                T cond = → if (!n) → P  // pass
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D copyfileobj = λ fsrc, fdst, length . {
    // copy data from file-like object fsrc to file-like object fdst
    T cond = → if (!length) → P length = COPY_BUFSIZE
    P fsrc_read = fsrc D read
    P fdst_write = fdst D write
    T while_loop = ∞ (
        T check = → if (λ buf . buf)(fsrc_read(length)) → P  // while body follows
            fdst_write(buf)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D samefile = λ src, dst . {
    T cond = → if (isinstance(src, os D DirEntry) && hasattr(os D path, "samestat")) → P
        T attempt = → P  // try
            → os D path D samestat(src D stat(P), os D stat(dst))
        → E OSError (_)
            → 0
    T cond = → if hasattr(os D path, "samefile") → P
        T attempt = → P  // try
            → os D path D samefile(src, dst)
        → E OSError (_)
            → 0
    → os D path D normcase(os D path D abspath(src)) == os D path D normcase(os D path D abspath(dst))
}
D stat = λ fn . → if isinstance(fn, os D DirEntry) → fn D stat(P) → E os D stat(fn)
D islink = λ fn . → if isinstance(fn, os D DirEntry) → fn D is_symlink(P) → E os D path D islink(fn)
D copyfile = λ src, dst . {
    // Copy data from src to dst in the most efficient way possible.      If follow_symlinks is not set and src is a symbolic l
    sys D audit("shutil.copyfile", src, dst)
    T cond = → if _samefile(src, dst) → → E SameFileError("{!r} and {!r} are the same file" D format(src, dst))
    P file_size = 0
    T loop = ∞ (
        P manifold__i__fn = enumerate(manifold [src, dst])[_loop_index]  // manifold [i, fn]
        T attempt = → P  // try
            P st = _stat(fn)
        → E OSError (_)
            // pass
    ) (D |enumerate(manifold [src, dst])|)
    T cond = → if ((!follow_symlinks) && _islink(src)) → os D symlink(os D readlink(src), dst)
    → E P
        T scope_fsrc = → open(src, "rb")
        P fsrc = scope_fsrc  // context var
            T attempt = → P  // try
                T scope_fdst = → open(dst, "wb")
                P fdst = scope_fdst  // context var
                    T cond = → if _HAS_FCOPYFILE → P
                        T attempt = → P  // try
                            _fastcopy_fcopyfile(fsrc, fdst, posix D _COPYFILE_DATA)
                            → dst
                        → E _GiveupOnFastCopy (_)
                            // pass
                    → E P
                        T cond = → if _USE_CP_SENDFILE → P
                            T attempt = → P  // try
                                _fastcopy_sendfile(fsrc, fdst)
                                → dst
                            → E _GiveupOnFastCopy (_)
                                // pass
                        → E P
                            T cond = → if (_WINDOWS && file_size > 0) → P
                                _copyfileobj_readinto(fsrc, fdst, min(file_size, COPY_BUFSIZE))
                                → dst
                    copyfileobj(fsrc, fdst)
            → E IsADirectoryError (e)
                T cond = → if (!os D path D exists(dst)) → → E FileNotFoundError("Directory does not exist: " + dst)
                → E → E P
    → dst
}
D copymode = λ src, dst . {
    // Copy mode bits from src to dst.      If follow_symlinks is not set, symlinks aren't followed if and only     if both `sr
    sys D audit("shutil.copymode", src, dst)
    T cond = → if ((!follow_symlinks) && _islink(src) && os D path D islink(dst)) → P
        T cond = → if hasattr(os, "lchmod") → P manifold__stat_func__chmod_func = manifold [os D lstat, os D lchmod]  // manifold [stat_func, chmod_func] := manifold [os D lstat, os D lchmod]
        → E → P
    → E P
        P stat_func = _stat
        T cond = → if (os D name == "nt" && os D path D islink(dst)) → D chmod_func = λ  . os D chmod(args, manifold ["follow_symlinks", 1])
        → E P chmod_func = os D chmod
    P st = stat_func(src)
    chmod_func(dst, stat D S_IMODE(st D st_mode))
}
T cond = → if hasattr(os, "listxattr") → P
    D copyxattr = λ src, dst . {
        // Copy extended filesystem attributes from `src` to `dst`.          Overwrite existing attributes.          If `follow_sym
        T attempt = → P  // try
            P names = os D listxattr(src, manifold ["follow_symlinks", follow_symlinks])
        → E OSError (e)
            T cond = → if e D errno ≠ manifold [errno D ENOTSUP, errno D ENODATA, errno D EINVAL] → → E P
            → P
        T loop = ∞ (
            P name = names[_loop_index]
            T attempt = → P  // try
                P value = os D getxattr(src, name, manifold ["follow_symlinks", follow_symlinks])
                os D setxattr(dst, name, value, manifold ["follow_symlinks", follow_symlinks])
            → E OSError (e)
                T cond = → if e D errno ≠ manifold [errno D EPERM, errno D ENOTSUP, errno D ENODATA, errno D EINVAL, errno D EACCES] → → E P
        ) (D |names|)
    }
→ E D copyxattr = λ  . P  // empty body
D copystat = λ src, dst . {
    // Copy file metadata      Copy the permission bits, last access time, last modification time, and     flags from `src` to 
    sys D audit("shutil.copystat", src, dst)
    D nop = λ  . P  // empty body
    P follow = (follow_symlinks || (!(_islink(src) && os D path D islink(dst))))
    T cond = → if follow → D lookup = λ name . → getattr(os, name, _nop)
    → E P
        D lookup = λ name . {
            P fn = getattr(os, name, _nop)
            T cond = → if fn == os D supports_follow_symlinks → → fn
            → _nop
        }
    T cond = → if isinstance(src, os D DirEntry) → P st = src D stat(manifold ["follow_symlinks", follow])
    → E P st = lookup("stat")(src, manifold ["follow_symlinks", follow])
    P mode = stat D S_IMODE(st D st_mode)
    lookup("utime")(dst, manifold ["ns", manifold [st D st_atime_ns, st D st_mtime_ns]], manifold ["follow_symlinks", follow])
    _copyxattr(src, dst, manifold ["follow_symlinks", follow])
    T attempt = → P  // try
        lookup("chmod")(dst, mode, manifold ["follow_symlinks", follow])
    → E NotImplementedError (_)
        // pass
    T cond = → if hasattr(st, "st_flags") → P
        T attempt = → P  // try
            lookup("chflags")(dst, st D st_flags, manifold ["follow_symlinks", follow])
        → E OSError (why)
            T loop = ∞ (
                P err = manifold ["EOPNOTSUPP", "ENOTSUP"][_loop_index]
                T cond = → if (hasattr(errno, err) && why D errno == getattr(errno, err)) → P  // pass
            ) (D |manifold ["EOPNOTSUPP", "ENOTSUP"]|)
}
D copy = λ src, dst . {
    // Copy data and mode bits ("cp src dst"). Return the file's destination.      The destination may be a directory.      If 
    T cond = → if os D path D isdir(dst) → P dst = os D path D join(dst, os D path D basename(src))
    copyfile(src, dst, manifold ["follow_symlinks", follow_symlinks])
    copymode(src, dst, manifold ["follow_symlinks", follow_symlinks])
    → dst
}
D copy2 = λ src, dst . {
    // Copy data and metadata. Return the file's destination.      Metadata is copied with copystat(). Please see the copystat 
    T cond = → if os D path D isdir(dst) → P dst = os D path D join(dst, os D path D basename(src))
    T cond = → if hasattr(_winapi, "CopyFile2") → P
        P src_ = os D fsdecode(src)
        P dst_ = os D fsdecode(dst)
        P flags = _winapi D COPY_FILE_ALLOW_DECRYPTED_DESTINATION
        T cond = → if (!follow_symlinks) → P flags = flags | _winapi D COPY_FILE_COPY_SYMLINK
        T attempt = → P  // try
            _winapi D CopyFile2(src_, dst_, flags)
            → dst
        → E OSError (exc)
            T cond = → if (exc D winerror == _winapi D ERROR_PRIVILEGE_NOT_HELD && (!follow_symlinks)) → P  // pass
    copyfile(src, dst, manifold ["follow_symlinks", follow_symlinks])
    copystat(src, dst, manifold ["follow_symlinks", follow_symlinks])
    → dst
}
D ignore_patterns = λ  . {
    // Function that can be used as copytree() ignore parameter.      Patterns is a sequence of glob-style patterns     that ar
    D ignore_patterns = λ path, names . {
        P ignored_names = manifold []
        T loop = ∞ (
            P pattern = patterns[_loop_index]
            ignored_names D extend(fnmatch D filter(names, pattern))
        ) (D |patterns|)
        → set(ignored_names)
    }
    → _ignore_patterns
}
D copytree = λ entries, src, dst, symlinks, ignore, copy_function, ignore_dangling_symlinks, dirs_exist_ok . {
    T cond = → if ignore ≠ P → P ignored_names = ignore(os D fspath(src), { T loop = ∞ (x D name) (D |entries|) })
    → E P ignored_names = manifold []
    os D makedirs(dst, manifold ["exist_ok", dirs_exist_ok])
    P errors = manifold []
    P use_srcentry = (copy_function == copy2 || copy_function == copy)
    T loop = ∞ (
        P srcentry = entries[_loop_index]
        T cond = → if srcentry D name == ignored_names → P  // pass
        P srcname = os D path D join(src, srcentry D name)
        P dstname = os D path D join(dst, srcentry D name)
        P srcobj = if use_srcentry → srcentry → E srcname
        T attempt = → P  // try
            P is_symlink = srcentry D is_symlink(P)
            T cond = → if (is_symlink && os D name == "nt") → P
                P lstat = srcentry D stat(manifold ["follow_symlinks", 0])
                T cond = → if lstat D st_reparse_tag == stat D IO_REPARSE_TAG_MOUNT_POINT → P is_symlink = 0
            T cond = → if is_symlink → P
                P linkto = os D readlink(srcname)
                T cond = → if symlinks → P
                    os D symlink(linkto, dstname)
                    copystat(srcobj, dstname, manifold ["follow_symlinks", (!symlinks)])
                → E P
                    T cond = → if ((!os D path D exists(linkto)) && ignore_dangling_symlinks) → P  // pass
                    T cond = → if srcentry D is_dir(P) → copytree(srcobj, dstname, symlinks, ignore, copy_function, ignore_dangling_symlinks, dirs_exist_ok)
                    → E copy_function(srcobj, dstname)
            → E P
                T cond = → if srcentry D is_dir(P) → copytree(srcobj, dstname, symlinks, ignore, copy_function, ignore_dangling_symlinks, dirs_exist_ok)
                → E copy_function(srcobj, dstname)
        → E Error (err)
            errors D extend(err D args[0])
        → E OSError (why)
            errors D append(manifold [srcname, dstname, str(why)])
    ) (D |entries|)
    T attempt = → P  // try
        copystat(src, dst)
    → E OSError (why)
        T cond = → if getattr(why, "winerror", P) == P → errors D append(manifold [src, dst, str(why)])
    T cond = → if errors → → E Error(errors)
    → dst
}
D copytree = λ src, dst, symlinks, ignore, copy_function, ignore_dangling_symlinks, dirs_exist_ok . {
    // Recursively copy a directory tree and return the destination directory.      If exception(s) occur, an Error is raised w
    sys D audit("shutil.copytree", src, dst)
    T scope_itr = → os D scandir(src)
    P itr = scope_itr  // context var
        P entries = list(itr)
    → _copytree(manifold ["entries", entries], manifold ["src", src], manifold ["dst", dst], manifold ["symlinks", symlinks], manifold ["ignore", ignore], manifold ["copy_function", copy_function], manifold ["ignore_dangling_symlinks", ignore_dangling_symlinks], manifold ["dirs_exist_ok", dirs_exist_ok])
}
T cond = → if hasattr(os D stat_result, "st_file_attributes") → D rmtree_islink = λ st . → (stat D S_ISLNK(st D st_mode) || ((st D st_file_attributes & stat D FILE_ATTRIBUTE_REPARSE_POINT) && st D st_reparse_tag == stat D IO_REPARSE_TAG_MOUNT_POINT))
→ E D rmtree_islink = λ st . → stat D S_ISLNK(st D st_mode)
D rmtree_unsafe = λ path, onexc . {
    D onerror = λ err . T cond = → if (!isinstance(err, FileNotFoundError)) → onexc(os D scandir, err D filename, err)
    P results = os D walk(path, manifold ["topdown", 0], manifold ["onerror", onerror], manifold ["followlinks", os D _walk_symlinks_as_files])
    T loop = ∞ (
        P manifold__dirpath__dirnames__filenames = results[_loop_index]  // manifold [dirpath, dirnames, filenames]
        T loop = ∞ (
            P name = dirnames[_loop_index]
            P fullname = os D path D join(dirpath, name)
            T attempt = → P  // try
                os D rmdir(fullname)
            → E FileNotFoundError (_)
                // continue
            → E OSError (err)
                onexc(os D rmdir, fullname, err)
        ) (D |dirnames|)
        T loop = ∞ (
            P name = filenames[_loop_index]
            P fullname = os D path D join(dirpath, name)
            T attempt = → P  // try
                os D unlink(fullname)
            → E FileNotFoundError (_)
                // continue
            → E OSError (err)
                onexc(os D unlink, fullname, err)
        ) (D |filenames|)
    ) (D |results|)
    T attempt = → P  // try
        os D rmdir(path)
    → E FileNotFoundError (_)
        // pass
    → E OSError (err)
        onexc(os D rmdir, path, err)
}
D rmtree_safe_fd = λ stack, onexc . {
    P manifold__func__dirfd__path__orig_entry = stack D pop(P)  // manifold [func, dirfd, path, orig_entry] := stack D pop(P)
    P name = if orig_entry == P → path → E orig_entry D name
    T attempt = → P  // try
        T cond = → if func == os D close → P
            os D close(dirfd)
            → P
        T cond = → if func == os D rmdir → P
            os D rmdir(name, manifold ["dir_fd", dirfd])
            → P
        T assert = → if func == os D lstat → "ok" → E "Assertion failed"
        T cond = → if orig_entry == P → P orig_st = os D lstat(name, manifold ["dir_fd", dirfd])
        → E P orig_st = orig_entry D stat(manifold ["follow_symlinks", 0])
        P func = os D open
        P topfd = os D open(name, (os D O_RDONLY | os D O_NONBLOCK), manifold ["dir_fd", dirfd])
        P func = os D path D islink
        T attempt = → P  // try
            T cond = → if (!os D path D samestat(orig_st, os D fstat(topfd))) → → E OSError("Cannot call rmtree on a symbolic link")
            stack D append(manifold [os D rmdir, dirfd, path, orig_entry])
        // finally:
            stack D append(manifold [os D close, topfd, path, orig_entry])
        P func = os D scandir
        T scope_scandir_it = → os D scandir(topfd)
        P scandir_it = scope_scandir_it  // context var
            P entries = list(scandir_it)
        T loop = ∞ (
            P entry = entries[_loop_index]
            P fullname = os D path D join(path, entry D name)
            T attempt = → P  // try
                T cond = → if entry D is_dir(manifold ["follow_symlinks", 0]) → stack D append(manifold [os D lstat, topfd, fullname, entry])
            → E FileNotFoundError (_)
                // continue
            → E OSError (_)
                // pass
            T attempt = → P  // try
                os D unlink(entry D name, manifold ["dir_fd", topfd])
            → E FileNotFoundError (_)
                // continue
            → E OSError (err)
                onexc(os D unlink, fullname, err)
        ) (D |entries|)
    → E FileNotFoundError (err)
        T cond = → if (orig_entry == P || func == os D close) → P
            D err_D_filename = path  // err D filename := path
            onexc(func, path, err)
    → E OSError (err)
        D err_D_filename = path  // err D filename := path
        onexc(func, path, err)
}
P _use_fd_functions = (manifold [os D open, os D stat, os D unlink, os D rmdir] ≤ os D supports_dir_fd && os D scandir == os D supports_fd && os D stat == os D supports_follow_symlinks)
D rmtree = λ path, ignore_errors, onerror . {
    // Recursively delete a directory tree.      If dir_fd is not None, it should be a file descriptor open to a directory;    
    sys D audit("shutil.rmtree", path, dir_fd)
    T cond = → if ignore_errors → D onexc = λ  . P  // empty body
    → E P
        T cond = → if (onerror == P && onexc == P) → D onexc = λ  . → E P
        → E P
            T cond = → if onexc == P → P
                T cond = → if onerror == P → D onexc = λ  . → E P
                → E P
                    D onexc = λ  . {
                        P manifold__func__path__exc = args  // manifold [func, path, exc] := args
                        T cond = → if exc == P → P exc_info = manifold [P, P, P]
                        → E P exc_info = manifold [type(exc), exc, exc D __traceback__]
                        → onerror(func, path, exc_info)
                    }
    T cond = → if _use_fd_functions → P
        T cond = → if isinstance(path, bytes) → P path = os D fsdecode(path)
        P stack = manifold [manifold [os D lstat, dir_fd, path, P]]
        T attempt = → P  // try
            T while_loop = ∞ (
                T check = → if stack → P  // while body follows
                    _rmtree_safe_fd(stack, onexc)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        // finally:
            T while_loop = ∞ (
                T check = → if stack → P  // while body follows
                    P manifold__func__fd__path__entry = stack D pop(P)  // manifold [func, fd, path, entry] := stack D pop(P)
                    T cond = → if func ≠ os D close → P  // pass
                    T attempt = → P  // try
                        os D close(fd)
                    → E OSError (err)
                        onexc(os D close, path, err)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → E P
        T cond = → if dir_fd ≠ P → → E NotImplementedError("dir_fd unavailable on this platform")
        T attempt = → P  // try
            P st = os D lstat(path)
        → E OSError (err)
            onexc(os D lstat, path, err)
            → P
        T attempt = → P  // try
            T cond = → if _rmtree_islink(st) → → E OSError("Cannot call rmtree on a symbolic link")
        → E OSError (err)
            onexc(os D path D islink, path, err)
            → P
        → _rmtree_unsafe(path, onexc)
}
D rmtree_D_avoids_symlink_attacks = _use_fd_functions  // rmtree D avoids_symlink_attacks := _use_fd_functions
D basename = λ path . {
    // A basename() variant which first strips the trailing slash, if present.     Thus we always get the last component of the
    P path = os D fspath(path)
    P sep = (os D path D sep + (os D path D altsep || ""))
    → os D path D basename(path D rstrip(sep))
}
D move = λ src, dst, copy_function . {
    // Recursively move a file or directory to another location. This is     similar to the Unix "mv" command. Return the file 
    sys D audit("shutil.move", src, dst)
    P real_dst = dst
    T cond = → if os D path D isdir(dst) → P
        T cond = → if (_samefile(src, dst) && (!os D path D islink(src))) → P
            os D rename(src, dst)
            → P
        P real_dst = os D path D join(dst, _basename(src))
        T cond = → if os D path D exists(real_dst) → → E Error(("Destination path '%s' already exists" % real_dst))
    T attempt = → P  // try
        os D rename(src, real_dst)
    → E OSError (_)
        T cond = → if os D path D islink(src) → P
            P linkto = os D readlink(src)
            os D symlink(linkto, real_dst)
            os D unlink(src)
        → E P
            T cond = → if os D path D isdir(src) → P
                T cond = → if _destinsrc(src, dst) → → E Error(("Cannot move a directory '%s' into itself '%s'." % manifold [src, dst]))
                T cond = → if (_is_immutable(src) || ((!os D access(src, os D W_OK)) && os D listdir(src) && sys D platform == "darwin")) → → E PermissionError(("Cannot move the non-empty directory '%s': Lacking write permission to '%s'." % manifold [src, src]))
                copytree(src, real_dst, manifold ["copy_function", copy_function], manifold ["symlinks", 1])
                rmtree(src)
            → E P
                copy_function(src, real_dst)
                os D unlink(src)
    → real_dst
}
D destinsrc = λ src, dst . {
    P src = os D path D abspath(src)
    P dst = os D path D abspath(dst)
    T cond = → if (!src D endswith(os D path D sep)) → P src = src + os D path D sep
    T cond = → if (!dst D endswith(os D path D sep)) → P dst = dst + os D path D sep
    → dst D startswith(src)
}
D is_immutable = λ src . {
    P st = _stat(src)
    P immutable_states = manifold [stat D UF_IMMUTABLE, stat D SF_IMMUTABLE]
    → (hasattr(st, "st_flags") && st D st_flags == immutable_states)
}
D get_gid = λ name . {
    // Returns a gid, given a group name.
    T cond = → if name == P → → P
    T attempt = → P  // try
        // @ETPL:unresolvable grp.getgrnam
    → E ImportError (_)
        → P
    T attempt = → P  // try
        P result = getgrnam(name)
    → E KeyError (_)
        P result = P
    T cond = → if result ≠ P → → result[2]
    → P
}
D get_uid = λ name . {
    // Returns an uid, given a user name.
    T cond = → if name == P → → P
    T attempt = → P  // try
