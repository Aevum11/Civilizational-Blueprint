D make_zipfile_D_supports_root_dir = 1  // _make_zipfile D supports_root_dir := 1
P _ARCHIVE_FORMATS = manifold [manifold ["tar", manifold [_make_tarball, manifold [manifold ["compress", P]], "uncompressed tar file"]]]
T cond = → if _ZLIB_SUPPORTED → P  // pass
T cond = → if _BZ2_SUPPORTED → P  // pass
