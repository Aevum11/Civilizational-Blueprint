            self D _raise_if_pid_reused(P)
            P manifold__pid__ppid__name = manifold [self D pid, self D _ppid, self D _name]  // manifold [pid, ppid, name] := manifold [self D pid, self D _ppid, self D _name]
            T cond = → if pid == 0 → P
                P msg = "preventing sending signal to process with PID 0 as it would affect every process in the process group of the calling process (os.getpid()) instead of PID 0"
                → E ValueError(msg)
