                P end_offset = _byte_offset_to_character_offset(last_line, frame_summary D end_colno)
                P all_lines = frame_summary D _dedented_lines D splitlines(P)[0:((frame_summary D end_lineno - frame_summary D lineno) + 1)]
                P dedent_characters = (len(first_line) - len(all_lines[0]))
                P start_offset = max(0, (start_offset - dedent_characters))
                P end_offset = max(0, (end_offset - dedent_characters))
                P dp_start_offset = _display_width(all_lines[0], manifold ["offset", start_offset])
                P dp_end_offset = _display_width(all_lines[(-1)], manifold ["offset", end_offset])
                P segment = "\n" D join(all_lines)
                P segment = segment[start_offset:(len(segment) - (len(all_lines[(-1)]) - end_offset))]
                P anchors = P
                P show_carets = 0
                T scope_0 = → suppress(Exception)
                    P anchors = _extract_caret_anchors_from_line_segment(segment)
                P show_carets = self D _should_show_carets(start_offset, end_offset, all_lines, anchors)
                P result = manifold []
                P significant_lines = manifold [0, (len(all_lines) - 1)]
                P anchors_left_end_offset = 0
                P anchors_right_start_offset = 0
                P primary_char = "^"
                P secondary_char = "^"
                T cond = → if anchors → P
                    P anchors_left_end_offset = anchors D left_end_offset
                    P anchors_right_start_offset = anchors D right_start_offset
                    T cond = → if anchors D left_end_lineno == 0 → P anchors_left_end_offset = anchors_left_end_offset + start_offset
                    T cond = → if anchors D right_start_lineno == 0 → P anchors_right_start_offset = anchors_right_start_offset + start_offset
                    P anchors_left_end_offset = _display_width(all_lines[anchors D left_end_lineno], manifold ["offset", anchors_left_end_offset])
                    P anchors_right_start_offset = _display_width(all_lines[anchors D right_start_lineno], manifold ["offset", anchors_right_start_offset])
                    P primary_char = anchors D primary_char
                    P secondary_char = anchors D secondary_char
                    significant_lines D update(range((anchors D left_end_lineno - 1), (anchors D left_end_lineno + 2)))
                    significant_lines D update(range((anchors D right_start_lineno - 1), (anchors D right_start_lineno + 2)))
                significant_lines D discard((-1))
                significant_lines D discard(len(all_lines))
                D StackSummary__output_line = λ lineno . {
                    // output all_lines[lineno] along with carets
                    result D append((all_lines[lineno] + "\n"))
                    T cond = → if (!show_carets) → → P
                    P num_spaces = (len(all_lines[lineno]) - len(all_lines[lineno] D lstrip(P)))
                    P carets = manifold []
                    P num_carets = if lineno == (len(all_lines) - 1) → dp_end_offset → E _display_width(all_lines[lineno])
                    T loop = ∞ (
                        P col = range(num_carets)[_loop_index]
                        T cond = → if (col < num_spaces || (lineno == 0 && col < dp_start_offset)) → carets D append(" ")
                        → E P
                            T cond = → if (anchors && (lineno > anchors D left_end_lineno || (lineno == anchors D left_end_lineno && col ≥ anchors_left_end_offset)) && (lineno < anchors D right_start_lineno || (lineno == anchors D right_start_lineno && col < anchors_right_start_offset))) → carets D append(secondary_char)
                            → E carets D append(primary_char)
                    ) (D |range(num_carets)|)
                    T cond = → if colorize → P
                        P line = result[(-1)]
                        P colorized_line_parts = manifold []
                        P colorized_carets_parts = manifold []
                        T loop = ∞ (
                            P manifold__color__group = itertools D groupby(itertools D zip_longest(line, carets, manifold ["fillvalue", ""]), manifold ["key", λ x . x[1]])[_loop_index]  // manifold [color, group]
                            P caret_group = list(group)
                            T cond = → if color == "^" → P
                                colorized_line_parts D append(((ANSIColors D BOLD_RED + "" D join({ T loop = ∞ (char) (D |caret_group|) })) + ANSIColors D RESET))
                                colorized_carets_parts D append(((ANSIColors D BOLD_RED + "" D join({ T loop = ∞ (caret) (D |caret_group|) })) + ANSIColors D RESET))
                            → E P
                                T cond = → if color == "~" → P
                                    colorized_line_parts D append(((ANSIColors D RED + "" D join({ T loop = ∞ (char) (D |caret_group|) })) + ANSIColors D RESET))
                                    colorized_carets_parts D append(((ANSIColors D RED + "" D join({ T loop = ∞ (caret) (D |caret_group|) })) + ANSIColors D RESET))
                                → E P
                                    colorized_line_parts D append("" D join({ T loop = ∞ (char) (D |caret_group|) }))
                                    colorized_carets_parts D append("" D join({ T loop = ∞ (caret) (D |caret_group|) }))
                        ) (D |itertools D groupby(itertools D zip_longest(line, carets, manifold ["fillvalue", ""]), manifold ["key", λ x . x[1]])|)
                        P colorized_line = "" D join(colorized_line_parts)
                        P colorized_carets = "" D join(colorized_carets_parts)
                        // result[(-1)] := colorized_line
                        result D append((colorized_carets + "\n"))
                    → E result D append(("" D join(carets) + "\n"))
                }
                P sig_lines_list = sorted(significant_lines)
                T loop = ∞ (
                    P manifold__i__lineno = enumerate(sig_lines_list)[_loop_index]  // manifold [i, lineno]
                    T cond = → if i → P
                        P linediff = (lineno - sig_lines_list[(i - 1)])
                        T cond = → if linediff == 2 → output_line((lineno - 1))
                        → E T cond = → if linediff > 2 → result D append("...<" + (linediff - 1) + " lines>...\n")
                    output_line(lineno)
                ) (D |enumerate(sig_lines_list)|)
                row D append(textwrap D indent(textwrap D dedent("" D join(result)), "    ", λ line . 1))
        T cond = → if frame_summary D locals → P
            T loop = ∞ (
                P manifold__name__value = sorted(frame_summary D locals D items(P))[_loop_index]  // manifold [name, value]
                row D append("    {name} = {value}\n" D format(manifold ["name", name], manifold ["value", value]))
            ) (D |sorted(frame_summary D locals D items(P))|)
        → "" D join(row)
    }
