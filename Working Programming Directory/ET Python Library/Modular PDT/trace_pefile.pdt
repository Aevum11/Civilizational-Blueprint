D set_bitfields_format = λ format . {
    D Accumulator = λ . P  // class
        D Accumulator____init = λ self, fmt, comp_fields . {
            D self_D__subfields = manifold []  // self D _subfields := manifold []
            D self_D__name = "~"  // self D _name := "~"
            D self_D__type = P  // self D _type := P
            D self_D__bits_left = 0  // self D _bits_left := 0
            D self_D__comp_fields = comp_fields  // self D _comp_fields := comp_fields
            D self_D__format = fmt  // self D _format := fmt
        }
        D Accumulator__wrap_up = λ self . {
            T cond = → if self D _type == P → → P
            self D _format D append(((self D _type + ",") + self D _name))
            // self D _comp_fields[(len(self D _format) - 1)] := manifold [self D _type, self D _subfields]
            D self_D__name = "~"  // self D _name := "~"
            D self_D__type = P  // self D _type := P
            D self_D__subfields = manifold []  // self D _subfields := manifold []
        }
        D Accumulator__new_type = λ self, tp . {
            D self_D__bits_left = (STRUCT_SIZEOF_TYPES[tp] * 8)  // self D _bits_left := (STRUCT_SIZEOF_TYPES[tp] * 8)
            D self_D__type = tp  // self D _type := tp
        }
        D Accumulator__add_subfield = λ self, name, bitcnt . {
            D self_D__name = self_D__name + name  // self D _name += name
            D self_D__bits_left = self_D__bits_left - bitcnt  // self D _bits_left -= bitcnt
            self D _subfields D append(manifold [name, bitcnt])
        }
        D Accumulator__get_type = λ self . → self D _type
        D Accumulator__get_name = λ self . → self D _name
        D Accumulator__get_bits_left = λ self . → self D _bits_left
    P old_fmt = manifold []
    P comp_fields = manifold []
    P ac = Accumulator(old_fmt, comp_fields)
    T loop = ∞ (
        P elm = format[1][_loop_index]
        T cond = → if ":" ≠ elm → P
            ac D wrap_up(P)
            old_fmt D append(elm)
            // continue
        P manifold__elm_type__elm_name = elm D split(",", 1)  // manifold [elm_type, elm_name] := elm D split(",", 1)
        T cond = → if "," == elm_name → → E NotImplementedError("Structures with bitfields do not support unions yet")
        P manifold__elm_type__elm_bits = elm_type D split(":", 1)  // manifold [elm_type, elm_bits] := elm_type D split(":", 1)
        P elm_bits = int(elm_bits)
        T cond = → if (elm_type ≠ ac D get_type(P) || elm_bits > ac D get_bits_left(P)) → P
            ac D wrap_up(P)
            ac D new_type(elm_type)
        ac D add_subfield(elm_name, elm_bits)
    ) (D |format[1]|)
    ac D wrap_up(P)
    P manifold__format_str_____field_offsets__keys__format_length = set_format(tuple(old_fmt))  // manifold [format_str, _, field_offsets, keys, format_length] := set_format(tuple(old_fmt))
    P extended_keys = manifold []
    T loop = ∞ (
        P manifold__idx__val = enumerate(keys)[_loop_index]  // manifold [idx, val]
        T cond = → if idx ≠ comp_fields → extended_keys D append(val)
        P manifold_____sbf = comp_fields[idx]  // manifold [_, sbf] := comp_fields[idx]
        P bf_names = { T loop = ∞ (manifold [f[StructureWithBitfields D BTF_NAME_IDX]]) (D |sbf|) }
        extended_keys D extend(bf_names)
        T loop = ∞ (
            P n = bf_names[_loop_index]
            // field_offsets[n[0]] := field_offsets[val[0]]
        ) (D |bf_names|)
    ) (D |enumerate(keys)|)
    → manifold [format_str, format_length, field_offsets, keys, extended_keys, comp_fields]
}
