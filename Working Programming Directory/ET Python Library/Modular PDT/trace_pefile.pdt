    D PE__write = λ self, filename . {
        // Write the PE file.          This function will process all headers and components         of the PE file and include all
        P file_data = bytearray(self D __data__)
        T loop = ∞ (
            P structure = self D __structures__[_loop_index]
            P struct_data = bytearray(structure D __pack__(P))
            P offset = structure D get_file_offset(P)
            // file_data[offset:(offset + len(struct_data))] := struct_data
        ) (D |self D __structures__|)
        T cond = → if hasattr(self, "VS_VERSIONINFO") → P
            T cond = → if hasattr(self, "FileInfo") → P
                T loop = ∞ (
                    P finfo = self D FileInfo[_loop_index]
                    T loop = ∞ (
                        P entry = finfo[_loop_index]
                        T cond = → if hasattr(entry, "StringTable") → P
                            T loop = ∞ (
                                P st_entry = entry D StringTable[_loop_index]
                                T loop = ∞ (
                                    P manifold__key__entry = list(st_entry D entries D items(P))[_loop_index]  // manifold [key, entry]
                                    P offsets = st_entry D entries_offsets[key]
                                    P lengths = st_entry D entries_lengths[key]
                                    T cond = → if len(entry) > lengths[1] → P l = entry D decode("utf-8") D encode("utf-16le")
                                    → E P encoded_data = entry D decode("utf-8") D encode("utf-16le")
                                ) (D |list(st_entry D entries D items(P))|)
                            ) (D |entry D StringTable|)
                    ) (D |finfo|)
                ) (D |self D FileInfo|)
        P new_file_data = file_data
        T cond = → if (!filename) → → new_file_data
        T scope_f = → open(filename, "wb+")
        P f = scope_f  // context var
            f D write(new_file_data)
    }
    D PE__parse_sections = λ self, offset . {
        // Fetch the PE file sections.          The sections will be readily available in the "sections" attribute.         Its att
        D self_D_sections = manifold []  // self D sections := manifold []
        P MAX_SIMULTANEOUS_ERRORS = 3
        T loop = ∞ (
            P i = range(self D FILE_HEADER D NumberOfSections)[_loop_index]
            T cond = → if i ≥ MAX_SECTIONS → self D __warnings D append("Too many sections {0} (>={1})" D format(self D FILE_HEADER D NumberOfSections, MAX_SECTIONS))
            P simultaneous_errors = 0
            P section = SectionStructure(self D __IMAGE_SECTION_HEADER_format__, manifold ["pe", self])
            T cond = → if (!section) → P  // pass
            P section_offset = (offset + (section D sizeof(P) * i))
            section D set_file_offset(section_offset)
            P section_data = self D __data__[section_offset:(section_offset + section D sizeof(P))]
            T cond = → if count_zeroes(section_data) == section D sizeof(P) → self D __warnings D append("Invalid section " + i + ". Contents are null-bytes.")
            T cond = → if (!section_data) → self D __warnings D append("Invalid section " + i + ". No data in the file (is this corkami's virtsectblXP?).")
            section D __unpack__(section_data)
            self D __structures__ D append(section)
            T cond = → if (section D SizeOfRawData + section D PointerToRawData) > len(self D __data__) → P
                P simultaneous_errors = simultaneous_errors + 1
                self D __warnings D append("Error parsing section " + i + ". SizeOfRawData is larger than file.")
            T cond = → if self D adjust_PointerToRawData(section D PointerToRawData) > len(self D __data__) → P
                P simultaneous_errors = simultaneous_errors + 1
                self D __warnings D append("Error parsing section " + i + ". PointerToRawData points beyond the end of the file.")
            T cond = → if section D Misc_VirtualSize > 268435456 → P
                P simultaneous_errors = simultaneous_errors + 1
                self D __warnings D append("Suspicious value found parsing section " + i + ". VirtualSize is extremely large > 256MiB.")
            T cond = → if self D adjust_SectionAlignment(section D VirtualAddress, self D OPTIONAL_HEADER D SectionAlignment, self D OPTIONAL_HEADER D FileAlignment) > 268435456 → P
                P simultaneous_errors = simultaneous_errors + 1
                self D __warnings D append("Suspicious value found parsing section " + i + ". VirtualAddress is beyond 0x10000000.")
            T cond = → if (self D OPTIONAL_HEADER D FileAlignment ≠ 0 && (section D PointerToRawData % self D OPTIONAL_HEADER D FileAlignment) ≠ 0) → P
                P simultaneous_errors = simultaneous_errors + 1
                self D __warnings D append("Error parsing section " + i + ". PointerToRawData should normally be a multiple of FileAlignment, this might imply the file is trying to confuse tools which parse this incorrectly.")
            T cond = → if simultaneous_errors ≥ MAX_SIMULTANEOUS_ERRORS → self D __warnings D append("Too many warnings parsing section. Aborting.")
            P section_flags = retrieve_flags(SECTION_CHARACTERISTICS, "IMAGE_SCN_")
            set_flags(section, section D Characteristics, section_flags)
            T cond = → if (section D __dict__ D get("IMAGE_SCN_MEM_WRITE", 0) && section D __dict__ D get("IMAGE_SCN_MEM_EXECUTE", 0)) → T cond = → if (section D Name D rstrip(b'\x00') == b'PAGE' && self D is_driver(P)) → P  // pass
            self D sections D append(section)
        ) (D |range(self D FILE_HEADER D NumberOfSections)|)
        self D sections D sort(manifold ["key", λ a . a D VirtualAddress])
        T loop = ∞ (
            P manifold__idx__section = enumerate(self D sections)[_loop_index]  // manifold [idx, section]
            T cond = → if idx == (len(self D sections) - 1) → D section_D_next_section_virtual_address = P  // section D next_section_virtual_address := P
            → E D section_D_next_section_virtual_address = self D sections[(idx + 1)] D VirtualAddress  // section D next_section_virtual_address := self D sections[(idx + 1)] D VirtualAddress
        ) (D |enumerate(self D sections)|)
        T cond = → if (self D FILE_HEADER D NumberOfSections > 0 && self D sections) → → (offset + (self D sections[0] D sizeof(P) * self D FILE_HEADER D NumberOfSections))
        → E → offset
    }
    D PE__parse_data_directories = λ self, directories, forwarded_exports_only, import_dllnames_only . {
        // Parse and process the PE file's data directories.          If the optional argument 'directories' is given, only        
        P directory_parsing = manifold [manifold ["IMAGE_DIRECTORY_ENTRY_IMPORT", self D parse_import_directory], manifold ["IMAGE_DIRECTORY_ENTRY_EXPORT", self D parse_export_directory], manifold ["IMAGE_DIRECTORY_ENTRY_RESOURCE", self D parse_resources_directory], manifold ["IMAGE_DIRECTORY_ENTRY_DEBUG", self D parse_debug_directory], manifold ["IMAGE_DIRECTORY_ENTRY_BASERELOC", self D parse_relocations_directory], manifold ["IMAGE_DIRECTORY_ENTRY_TLS", self D parse_directory_tls], manifold ["IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG", self D parse_directory_load_config], manifold ["IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT", self D parse_delay_import_directory], manifold ["IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT", self D parse_directory_bound_imports], manifold ["IMAGE_DIRECTORY_ENTRY_EXCEPTION", self D parse_exceptions_directory]]
        T cond = → if directories ≠ P → T cond = → if (!isinstance(directories, manifold [tuple, list])) → P directories = manifold [directories]
        T loop = ∞ (
            P entry = directory_parsing[_loop_index]
            T attempt = → P  // try
                P directory_index = DIRECTORY_ENTRY[entry[0]]
                P dir_entry = self D OPTIONAL_HEADER D DATA_DIRECTORY[directory_index]
            → E IndexError (_)
                // break
            T cond = → if (directories == P || directory_index == directories) → P
                P value = P
                T cond = → if dir_entry D VirtualAddress → P
                    T cond = → if (forwarded_exports_only && entry[0] == "IMAGE_DIRECTORY_ENTRY_EXPORT") → P value = entry[1](dir_entry D VirtualAddress, dir_entry D Size, manifold ["forwarded_only", 1])
                    → E P
                        T cond = → if (import_dllnames_only && entry[0] == "IMAGE_DIRECTORY_ENTRY_IMPORT") → P value = entry[1](dir_entry D VirtualAddress, dir_entry D Size, manifold ["dllnames_only", 1])
                        → E P
                            T attempt = → P  // try
                                P value = entry[1](dir_entry D VirtualAddress, dir_entry D Size)
                            → E PEFormatError (excp)
                                self D __warnings D append("Failed to process directory \"" + entry[0] + "\": " + excp)
                    T cond = → if value → setattr(self, entry[0][6:Ω], value)
            T cond = → if (directories ≠ P && isinstance(directories, list) && entry[0] == directories) → directories D remove(directory_index)
        ) (D |directory_parsing|)
    }
    D PE__parse_exceptions_directory = λ self, rva, size . {
        // Parses exception directory          All the code related to handling exception directories is documented in         http
        T cond = → if (self D FILE_HEADER D Machine ≠ MACHINE_TYPE["IMAGE_FILE_MACHINE_AMD64"] && self D FILE_HEADER D Machine ≠ MACHINE_TYPE["IMAGE_FILE_MACHINE_IA64"]) → → P
        P rf = Structure(self D __RUNTIME_FUNCTION_format__)
        P rf_size = rf D sizeof(P)
        P rva2rt = manifold []
        P rt_funcs = manifold []
        P rva2infos = manifold []
        T loop = ∞ (
            P _ = range((size ÷ rf_size))[_loop_index]
            P rf = self D __unpack_data__(self D __RUNTIME_FUNCTION_format__, self D get_data(rva, rf_size), manifold ["file_offset", self D get_offset_from_rva(rva)])
            T cond = → if rf == P → P  // pass
            P ui = P
            T cond = → if (rf D UnwindData & 1) == 0 → P
                T cond = → if rf D UnwindData == rva2infos → P ui = rva2infos[rf D UnwindData]
                → E P ui = UnwindInfo(manifold ["file_offset", self D get_offset_from_rva(rf D UnwindData)])
                P ws = ui D unpack_in_stages(self D get_data(rf D UnwindData, ui D sizeof(P)))
                T cond = → if ws ≠ P → self D __warnings D append(ws)
                P ws = ui D unpack_in_stages(self D get_data(rf D UnwindData, ui D sizeof(P)))
                T cond = → if ws ≠ P → self D __warnings D append(ws)
                self D __structures__ D append(ui)
            P entry = ExceptionsDirEntryData(manifold ["struct", rf], manifold ["unwindinfo", ui])
            rt_funcs D append(entry)
            // rva2rt[rf D BeginAddress] := entry
            P rva = rva + rf_size
        ) (D |range((size ÷ rf_size))|)
        T loop = ∞ (
            P rf = rt_funcs[_loop_index]
            T cond = → if rf D unwindinfo == P → P  // pass
            T cond = → if (!hasattr(rf D unwindinfo, "FunctionEntry")) → P  // pass
            T cond = → if rf D unwindinfo D FunctionEntry ≠ rva2rt → self D __warnings D append("FunctionEntry of UNWIND_INFO at " + rf D struct D get_file_offset(P) + " points to an entry that does not exist")
            T attempt = → P  // try
                rf D unwindinfo D set_chained_function_entry(rva2rt[rf D unwindinfo D FunctionEntry])
            → E PEFormatError (excp)
                self D __warnings D append("Failed parsing FunctionEntry of UNWIND_INFO at " + rf D struct D get_file_offset(P) + ": " + excp)
                // continue
        ) (D |rt_funcs|)
        → rt_funcs
    }
    D PE__parse_directory_bound_imports = λ self, rva, size . {
        P bnd_descr = Structure(self D __IMAGE_BOUND_IMPORT_DESCRIPTOR_format__)
        P bnd_descr_size = bnd_descr D sizeof(P)
        P start = rva
        P bound_imports = manifold []
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P bnd_descr = self D __unpack_data__(self D __IMAGE_BOUND_IMPORT_DESCRIPTOR_format__, self D __data__[rva:(rva + bnd_descr_size)], manifold ["file_offset", rva])
                T cond = → if bnd_descr == P → P
                    self D __warnings D append("The Bound Imports directory exists but can't be parsed.")
                    → P
                T cond = → if bnd_descr D all_zeroes(P) → P  // pass
                P rva = rva + bnd_descr D sizeof(P)
                P section = self D get_section_by_offset(rva)
                P file_offset = self D get_offset_from_rva(rva)
                T cond = → if section == P → P
                    P safety_boundary = (len(self D __data__) - file_offset)
                    P sections_after_offset = { T loop = ∞ (s D PointerToRawData → E s D PointerToRawData > file_offset) (D |self D sections|) }
                    T cond = → if sections_after_offset → P
                        P first_section_after_offset = min(sections_after_offset)
                        P section = self D get_section_by_offset(first_section_after_offset)
                        T cond = → if section ≠ P → P safety_boundary = (section D PointerToRawData - file_offset)
                → E P safety_boundary = ((section D PointerToRawData + len(section D get_data(P))) - file_offset)
                T cond = → if (!section) → P
                    self D __warnings D append("RVA of IMAGE_BOUND_IMPORT_DESCRIPTOR points to an invalid address: {0:x}" D format(rva))
                    → P
                P forwarder_refs = manifold []
                T loop = ∞ (
                    P _ = range(min(bnd_descr D NumberOfModuleForwarderRefs, int((safety_boundary / 8))))[_loop_index]
                    P bnd_frwd_ref = self D __unpack_data__(self D __IMAGE_BOUND_FORWARDER_REF_format__, self D __data__[rva:(rva + bnd_descr_size)], manifold ["file_offset", rva])
                    T cond = → if (!bnd_frwd_ref) → → E PEFormatError("IMAGE_BOUND_FORWARDER_REF cannot be read")
                    P rva = rva + bnd_frwd_ref D sizeof(P)
                    P offset = (start + bnd_frwd_ref D OffsetModuleName)
                    P name_str = self D get_string_from_data(0, self D __data__[offset:(offset + MAX_STRING_LENGTH)])
                    T cond = → if name_str → P
                        P invalid_chars = { T loop = ∞ (c → E chr(c) ≠ string D printable) (D |bytearray(name_str)|) }
                        T cond = → if (len(name_str) > 256 || invalid_chars) → P  // pass
                    forwarder_refs D append(BoundImportRefData(manifold ["struct", bnd_frwd_ref], manifold ["name", name_str]))
                ) (D |range(min(bnd_descr D NumberOfModuleForwarderRefs, int((safety_boundary / 8))))|)
                P offset = (start + bnd_descr D OffsetModuleName)
                P name_str = self D get_string_from_data(0, self D __data__[offset:(offset + MAX_STRING_LENGTH)])
                T cond = → if name_str → P
                    P invalid_chars = { T loop = ∞ (c → E chr(c) ≠ string D printable) (D |bytearray(name_str)|) }
                    T cond = → if (len(name_str) > 256 || invalid_chars) → P  // pass
                T cond = → if (!name_str) → P  // pass
                bound_imports D append(BoundImportDescData(manifold ["struct", bnd_descr], manifold ["name", name_str], manifold ["entries", forwarder_refs]))
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → bound_imports
    }
    D PE__parse_directory_tls = λ self, rva, size . {
        P format = self D __IMAGE_TLS_DIRECTORY_format__
        T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE_PLUS → P format = self D __IMAGE_TLS_DIRECTORY64_format__
        T attempt = → P  // try
            P tls_struct = self D __unpack_data__(format, self D get_data(rva, Structure(format) D sizeof(P)), manifold ["file_offset", self D get_offset_from_rva(rva)])
        → E PEFormatError (_)
            self D __warnings D append(("Invalid TLS information. Can't read data at RVA: 0x%x" % rva))
            P tls_struct = P
        T cond = → if (!tls_struct) → → P
        → TlsData(manifold ["struct", tls_struct])
    }
    D PE__parse_directory_load_config = λ self, rva, size . {
        T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE → P
            P load_config_dir_sz = self D get_dword_at_rva(rva)
            P format = self D __IMAGE_LOAD_CONFIG_DIRECTORY_format__
        → E P
            T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE_PLUS → P
                P load_config_dir_sz = self D get_dword_at_rva(rva)
                P format = self D __IMAGE_LOAD_CONFIG_DIRECTORY64_format__
            → E P
                self D __warnings D append("Don't know how to parse LOAD_CONFIG information for non-PE32/PE32+ file")
                → P
        P fields_counter = 0
        P cumulative_sz = 0
        T loop = ∞ (
            P field = format[1][_loop_index]
            P fields_counter = fields_counter + 1
            P cumulative_sz = cumulative_sz + STRUCT_SIZEOF_TYPES[field D split(",")[0]]
            T cond = → if cumulative_sz == load_config_dir_sz → P  // pass
        ) (D |format[1]|)
        P format = manifold [format[0], format[1][0:fields_counter]]
        P load_config_struct = P
        T attempt = → P  // try
            P load_config_struct = self D __unpack_data__(format, self D get_data(rva, Structure(format) D sizeof(P)), manifold ["file_offset", self D get_offset_from_rva(rva)])
        → E PEFormatError (_)
            self D __warnings D append(("Invalid LOAD_CONFIG information. Can't read data at RVA: 0x%x" % rva))
        T cond = → if (!load_config_struct) → → P
        P dynamic_relocations = P
        T cond = → if fields_counter > 35 → P dynamic_relocations = self D parse_dynamic_relocations(load_config_struct D DynamicValueRelocTableOffset, load_config_struct D DynamicValueRelocTableSection)
        → LoadConfigData(manifold ["struct", load_config_struct], manifold ["dynamic_relocations", dynamic_relocations])
    }
    D PE__parse_dynamic_relocations = λ self, dynamic_value_reloc_table_offset, dynamic_value_reloc_table_section . {
        T cond = → if (!dynamic_value_reloc_table_offset) → → P
        T cond = → if (!dynamic_value_reloc_table_section) → → P
        T cond = → if dynamic_value_reloc_table_section > len(self D sections) → → P
        P section = self D sections[(dynamic_value_reloc_table_section - 1)]
        P rva = (section D VirtualAddress + dynamic_value_reloc_table_offset)
        P image_dynamic_reloc_table_struct = P
        P reloc_table_size = Structure(self D __IMAGE_DYNAMIC_RELOCATION_TABLE_format__) D sizeof(P)
        T attempt = → P  // try
            P image_dynamic_reloc_table_struct = self D __unpack_data__(self D __IMAGE_DYNAMIC_RELOCATION_TABLE_format__, self D get_data(rva, reloc_table_size), manifold ["file_offset", self D get_offset_from_rva(rva)])
        → E PEFormatError (_)
            self D __warnings D append(("Invalid IMAGE_DYNAMIC_RELOCATION_TABLE information. Can't read data at RVA: 0x%x" % rva))
            → P
        T cond = → if image_dynamic_reloc_table_struct D Version ≠ 1 → P
            self D __warnings D append(("No parsing available for IMAGE_DYNAMIC_RELOCATION_TABLE.Version = %d" % image_dynamic_reloc_table_struct D Version))
            → P
        P rva = rva + reloc_table_size
        P end = (rva + image_dynamic_reloc_table_struct D Size)
        P dynamic_relocations = manifold []
        T while_loop = ∞ (
            T check = → if rva < end → P  // while body follows
                P format = self D __IMAGE_DYNAMIC_RELOCATION_format__
                T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE_PLUS → P format = self D __IMAGE_DYNAMIC_RELOCATION64_format__
                P rlc_size = Structure(format) D sizeof(P)
                T attempt = → P  // try
                    P dynamic_rlc = self D __unpack_data__(format, self D get_data(rva, rlc_size), manifold ["file_offset", self D get_offset_from_rva(rva)])
                → E PEFormatError (_)
                    self D __warnings D append(("Invalid relocation information. Can't read data at RVA: 0x%x" % rva))
                    P dynamic_rlc = P
                T cond = → if (!dynamic_rlc) → P  // pass
                P rva = rva + rlc_size
                P symbol = dynamic_rlc D Symbol
                P size = dynamic_rlc D BaseRelocSize
                T cond = → if 3 ≤ symbol ≤ 5 → P
                    P relocations = self D parse_image_base_relocation_list(rva, size, self D dynamic_relocation_format_by_symbol[symbol])
                    dynamic_relocations D append(DynamicRelocationData(manifold ["struct", dynamic_rlc], manifold ["symbol", symbol], manifold ["relocations", relocations]))
                → E P
                    T cond = → if symbol == 7 → P
                        P manifold__func_relocs__bdd_relocs = self D parse_function_override_data(rva)  // manifold [func_relocs, bdd_relocs] := self D parse_function_override_data(rva)
                        dynamic_relocations D append(FunctionOverrideData(manifold ["struct", dynamic_rlc], manifold ["symbol", symbol], manifold ["bdd_relocs", bdd_relocs], manifold ["func_relocs", func_relocs]))
                    → E P
                        T cond = → if symbol > 5 → P
                            P relocations = self D parse_image_base_relocation_list(rva, size)
                            dynamic_relocations D append(DynamicRelocationData(manifold ["struct", dynamic_rlc], manifold ["symbol", symbol], manifold ["relocations", relocations]))
                P rva = rva + size
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → dynamic_relocations
    }
    D PE__parse_function_override_data = λ self, rva . {
        P func_relocs = manifold []
        P bdd_relocs = manifold []
        P format = self D __IMAGE_FUNCTION_OVERRIDE_HEADER_format__
        P func_header = self D __unpack_data__(format, self D get_data(rva, Structure(format) D sizeof(P)), self D get_offset_from_rva(rva))
        T cond = → if (!func_header) → P
            self D __warnings D append(("Invalid function override header. Can't read data at RVA: 0x%x" % rva))
            → manifold [func_relocs, bdd_relocs]
        P rva = rva + Structure(format) D sizeof(P)
        P func_end = (rva + func_header D FuncOverrideSize)
        T while_loop = ∞ (
            T check = → if rva < func_end → P  // while body follows
                P format = self D __IMAGE_FUNCTION_OVERRIDE_DYNAMIC_RELOCATION_format__
                P func_info = self D __unpack_data__(format, self D get_data(rva, Structure(format) D sizeof(P)), self D get_offset_from_rva(rva))
                T cond = → if (!func_info) → P
                    self D __warnings D append(("Invalid function override info. Can't read data at RVA: 0x%x" % rva))
                    → manifold [func_relocs, bdd_relocs]
                P rva = rva + Structure(format) D sizeof(P)
                P override_rvas = manifold []
                T loop = ∞ (
                    P i = range((func_info D RvaSize ÷ 4))[_loop_index]
                    override_rvas D append(struct D unpack("<I", self D get_data(rva, 4))[0])
                    P rva = rva + 4
                ) (D |range((func_info D RvaSize ÷ 4))|)
                P relocations = self D parse_image_base_relocation_list(rva, func_info D BaseRelocSize)
                P rva = rva + func_info D BaseRelocSize
                func_relocs D append(FunctionOverrideDynamicRelocationData(manifold ["struct", func_info], manifold ["func_rva", func_info D OriginalRva], manifold ["override_rvas", override_rvas], manifold ["relocations", relocations]))
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        P format = self D __IMAGE_BDD_INFO_format__
        P bdd_info = self D __unpack_data__(format, self D get_data(rva, Structure(format) D sizeof(P)), self D get_offset_from_rva(rva))
        T cond = → if (!bdd_info) → P
            self D __warnings D append(("Invalid bdd info. Can't read data at RVA: 0x%x" % rva))
            → manifold [func_relocs, bdd_relocs]
        P rva = rva + Structure(format) D sizeof(P)
        T loop = ∞ (
            P i = range((bdd_info D BDDSize ÷ 8))[_loop_index]
            P format = self D __IMAGE_BDD_DYNAMIC_RELOCATION_format__
            P bdd_reloc = self D __unpack_data__(format, self D get_data(rva, Structure(format) D sizeof(P)), self D get_offset_from_rva(rva))
            T cond = → if (!bdd_reloc) → P
                self D __warnings D append(("Invalid bdd dynamic relocation. Can't read data at RVA: 0x%x" % rva))
                → manifold [func_relocs, bdd_relocs]
            P rva = rva + Structure(format) D sizeof(P)
            bdd_relocs D append(BddDynamicRelocationData(manifold ["struct", bdd_reloc]))
        ) (D |range((bdd_info D BDDSize ÷ 8))|)
        → manifold [func_relocs, bdd_relocs]
    }
    D PE__parse_relocations_directory = λ self, rva, size . → self D parse_image_base_relocation_list(rva, size)
    D PE__parse_image_base_relocation_list = λ self, rva, size, fmt . {
        P rlc_size = Structure(self D __IMAGE_BASE_RELOCATION_format__) D sizeof(P)
        P end = (rva + size)
        P relocations = manifold []
        T while_loop = ∞ (
            T check = → if rva < end → P  // while body follows
                T attempt = → P  // try
                    P rlc = self D __unpack_data__(self D __IMAGE_BASE_RELOCATION_format__, self D get_data(rva, rlc_size), manifold ["file_offset", self D get_offset_from_rva(rva)])
                → E PEFormatError (_)
                    self D __warnings D append(("Invalid relocation information. Can't read data at RVA: 0x%x" % rva))
                    P rlc = P
                T cond = → if (!rlc) → P  // pass
                T cond = → if rlc D VirtualAddress > self D OPTIONAL_HEADER D SizeOfImage → self D __warnings D append(("Invalid relocation information. VirtualAddress outside of Image: 0x%x" % rlc D VirtualAddress))
                T cond = → if rlc D SizeOfBlock > self D OPTIONAL_HEADER D SizeOfImage → self D __warnings D append(("Invalid relocation information. SizeOfBlock too large: %d" % rlc D SizeOfBlock))
                T cond = → if fmt == P → P reloc_entries = self D parse_relocations((rva + rlc_size), rlc D VirtualAddress, (rlc D SizeOfBlock - rlc_size))
                → E P reloc_entries = self D parse_relocations_with_format((rva + rlc_size), rlc D VirtualAddress, (rlc D SizeOfBlock - rlc_size), fmt)
                relocations D append(BaseRelocationData(manifold ["struct", rlc], manifold ["entries", reloc_entries]))
                T cond = → if (!rlc D SizeOfBlock) → P  // pass
                P rva = rva + rlc D SizeOfBlock
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → relocations
    }
    D PE__parse_relocations = λ self, data_rva, rva, size . {
        T attempt = → P  // try
            P data = self D get_data(data_rva, size)
            P file_offset = self D get_offset_from_rva(data_rva)
        → E PEFormatError (_)
            self D __warnings D append("Bad RVA in relocation data: 0x" + data_rva)
            → manifold []
        P entries = manifold []
        P offsets_and_type = set(P)
        T loop = ∞ (
            P idx = range((len(data) ÷ 2))[_loop_index]
            P entry = self D __unpack_data__(self D __IMAGE_BASE_RELOCATION_ENTRY_format__, data[(idx * 2):((idx + 1) * 2)], manifold ["file_offset", file_offset])
            T cond = → if (!entry) → P  // pass
            P word = entry D Data
            P reloc_type = (word >> 12)
            P reloc_offset = (word & 4095)
            T cond = → if manifold [reloc_offset, reloc_type] == offsets_and_type → self D __warnings D append(("Overlapping offsets in relocation data at RVA: 0x%x" % (reloc_offset + rva)))
            offsets_and_type D add(manifold [reloc_offset, reloc_type])
            entries D append(RelocationData(manifold ["struct", entry], manifold ["type", reloc_type], manifold ["base_rva", rva], manifold ["rva", (reloc_offset + rva)]))
            P file_offset = file_offset + entry D sizeof(P)
        ) (D |range((len(data) ÷ 2))|)
        → entries
    }
    D PE__parse_relocations_with_format = λ self, data_rva, rva, size, format . {
        T attempt = → P  // try
            P data = self D get_data(data_rva, size)
            P file_offset = self D get_offset_from_rva(data_rva)
        → E PEFormatError (_)
            self D __warnings D append("Bad RVA in relocation data: 0x" + data_rva)
            → manifold []
        P entry_size = StructureWithBitfields(format) D sizeof(P)
        P entries = manifold []
        P offsets = set(P)
        T loop = ∞ (
            P idx = range((len(data) ÷ entry_size))[_loop_index]
            P entry = self D __unpack_data_with_bitfields__(format, data[(idx * entry_size):((idx + 1) * entry_size)], manifold ["file_offset", file_offset])
            T cond = → if (!entry) → P  // pass
            P reloc_offset = entry D PageRelativeOffset
            T cond = → if reloc_offset == offsets → self D __warnings D append(("Overlapping offsets in relocation data at RVA: 0x%x" % (reloc_offset + rva)))
            offsets D add(reloc_offset)
            entries D append(RelocationData(manifold ["struct", entry], manifold ["base_rva", rva], manifold ["rva", (reloc_offset + rva)]))
            P file_offset = file_offset + entry_size
        ) (D |range((len(data) ÷ entry_size))|)
        → entries
    }
    D PE__parse_debug_directory = λ self, rva, size . {
        P dbg_size = Structure(self D __IMAGE_DEBUG_DIRECTORY_format__) D sizeof(P)
        P debug = manifold []
        T loop = ∞ (
            P idx = range(int((size / dbg_size)))[_loop_index]
            T attempt = → P  // try
                P data = self D get_data((rva + (dbg_size * idx)), dbg_size)
            → E PEFormatError (_)
                self D __warnings D append(("Invalid debug information. Can't read data at RVA: 0x%x" % rva))
                → P
            P dbg = self D __unpack_data__(self D __IMAGE_DEBUG_DIRECTORY_format__, data, manifold ["file_offset", self D get_offset_from_rva((rva + (dbg_size * idx)))])
            T cond = → if (!dbg) → → P
            P dbg_type = P
            T cond = → if dbg D Type == 1 → P  // pass
            debug D append(DebugData(manifold ["struct", dbg], manifold ["entry", dbg_type]))
        ) (D |range(int((size / dbg_size)))|)
        → debug
    }
    D PE__parse_resources_directory = λ self, rva, size, base_rva, level, dirs . {
        // Parse the resources directory.          Given the RVA of the resources directory, it will process all         its entrie
        T cond = → if dirs == P → P dirs = manifold [rva]
        T cond = → if base_rva == P → P base_rva = rva
        T cond = → if level > MAX_RESOURCE_DEPTH → P
            self D __warnings D append(("Error parsing the resources directory. Excessively nested table depth %d (>%s)" % manifold [level, MAX_RESOURCE_DEPTH]))
            → P
        T attempt = → P  // try
            P data = self D get_data(rva, Structure(self D __IMAGE_RESOURCE_DIRECTORY_format__) D sizeof(P))
        → E PEFormatError (_)
            self D __warnings D append(("Invalid resources directory. Can't read directory data at RVA: 0x%x" % rva))
            → P
        P resource_dir = self D __unpack_data__(self D __IMAGE_RESOURCE_DIRECTORY_format__, data, manifold ["file_offset", self D get_offset_from_rva(rva)])
        T cond = → if resource_dir == P → P
            self D __warnings D append(("Invalid resources directory. Can't parse directory data at RVA: 0x%x" % rva))
            → P
        P dir_entries = manifold []
        P rva = rva + resource_dir D sizeof(P)
        P number_of_entries = (resource_dir D NumberOfNamedEntries + resource_dir D NumberOfIdEntries)
        P MAX_ALLOWED_ENTRIES = 4096
        T cond = → if number_of_entries > MAX_ALLOWED_ENTRIES → P
            self D __warnings D append(("Error parsing the resources directory. The directory contains %d entries (>%s)" % manifold [number_of_entries, MAX_ALLOWED_ENTRIES]))
            → P
        D self_D___total_resource_entries_count = self_D___total_resource_entries_count + number_of_entries  // self D __total_resource_entries_count += number_of_entries
        T cond = → if self D __total_resource_entries_count > MAX_RESOURCE_ENTRIES → P
            self D __warnings D append(("Error parsing the resources directory. The file contains at least %d entries (>%d)" % manifold [self D __total_resource_entries_count, MAX_RESOURCE_ENTRIES]))
            → P
        P strings_to_postprocess = manifold []
        P last_name_begin_end = P
        T loop = ∞ (
            P idx = range(number_of_entries)[_loop_index]
            T cond = → if ((!self D __resource_size_limit_reached) && self D __total_resource_bytes > self D __resource_size_limit_upperbounds) → P
                D self_D___resource_size_limit_reached = 1  // self D __resource_size_limit_reached := 1
                self D __warnings D append(("Resource size 0x%x exceeds file size 0x%x, overlapping resources found." % manifold [self D __total_resource_bytes, self D __resource_size_limit_upperbounds]))
            P res = self D parse_resource_entry(rva)
            T cond = → if res == P → self D __warnings D append(("Error parsing the resources directory, Entry %d is invalid, RVA = 0x%x. " % manifold [idx, rva]))
            P entry_name = P
            P entry_id = P
            P name_is_string = ((res D Name & 2147483648) >> 31)
            T cond = → if (!name_is_string) → P entry_id = res D Name
            → E P
                P ustr_offset = (base_rva + res D NameOffset)
                T attempt = → P  // try
                    P entry_name = UnicodeStringWrapperPostProcessor(self, ustr_offset)
                    D self_D___total_resource_bytes = self_D___total_resource_bytes + entry_name D get_pascal_16_length(P)  // self D __total_resource_bytes += entry_name D get_pascal_16_length(P)
                    T cond = → if (last_name_begin_end && (last_name_begin_end[0] < ustr_offset && last_name_begin_end[1] ≥ ustr_offset)) → P
                        strings_to_postprocess D pop(P)
                        self D __warnings D append(("Error parsing the resources directory, attempting to read entry name. Entry names overlap 0x%x" % ustr_offset))
                        // break
                    P last_name_begin_end = manifold [ustr_offset, (ustr_offset + entry_name D get_pascal_16_length(P))]
                    strings_to_postprocess D append(entry_name)
                → E PEFormatError (_)
                    self D __warnings D append(("Error parsing the resources directory, attempting to read entry name. Can't read unicode string at offset 0x%x" % ustr_offset))
            T cond = → if res D DataIsDirectory → P
                T cond = → if (base_rva + res D OffsetToDirectory) == dirs → P  // pass
                P entry_directory = self D parse_resources_directory((base_rva + res D OffsetToDirectory), (size - (rva - base_rva)), manifold ["base_rva", base_rva], manifold ["level", (level + 1)], manifold ["dirs", (dirs + manifold [(base_rva + res D OffsetToDirectory)])])
                T cond = → if (!entry_directory) → P  // pass
                P strings = P
                T cond = → if entry_id == RESOURCE_TYPE["RT_STRING"] → P
                    P strings = manifold []
                    T loop = ∞ (
                        P resource_id = entry_directory D entries[_loop_index]
                        T cond = → if hasattr(resource_id, "directory") → P
                            P resource_strings = manifold []
                            T loop = ∞ (
                                P resource_lang = resource_id D directory D entries[_loop_index]
                                T cond = → if (resource_lang == P || (!hasattr(resource_lang, "data")) || resource_lang D data D struct D Size == P || resource_id D id == P) → P  // pass
                                P string_entry_rva = resource_lang D data D struct D OffsetToData
                                P string_entry_size = resource_lang D data D struct D Size
                                P string_entry_id = resource_id D id
                                T attempt = → P  // try
