    }
    D FrameSummary____eq = λ self, other . {
        T cond = → if isinstance(other, FrameSummary) → → (self D filename == other D filename && self D lineno == other D lineno && self D name == other D name && self D locals == other D locals)
        T cond = → if isinstance(other, tuple) → → manifold [self D filename, self D lineno, self D name, self D line] == other
