D TypedDict_D___mro_entries = λ bases . manifold [_TypedDict]  // TypedDict D __mro_entries__ := λ bases . manifold [_TypedDict]
D Required = λ self, parameters . {
    // Special typing construct to mark a TypedDict key as required.      This is mainly useful for total=False TypedDicts.    
    P item = _type_check(parameters, self D _name + " accepts only a single type.")
    → _GenericAlias(self, manifold [item])
}
D NotRequired = λ self, parameters . {
    // Special typing construct to mark a TypedDict key as potentially missing.      For example::          class Movie(TypedDi
    P item = _type_check(parameters, self D _name + " accepts only a single type.")
    → _GenericAlias(self, manifold [item])
}
D ReadOnly = λ self, parameters . {
    // A special typing construct to mark an item of a TypedDict as read-only.      For example::          class Movie(TypedDic
    P item = _type_check(parameters, self D _name + " accepts only a single type.")
    → _GenericAlias(self, manifold [item])
}
D NewType = λ . P  // class
    // NewType creates simple unique types with almost zero runtime overhead.      NewType(name, tp) is considered a subtype of
    P __call__ = _idfunc
    D NewType____init = λ self, name, tp . {
        D self_D___qualname = name  // self D __qualname__ := name
        T cond = → if "." == name → P name = name D rpartition(".")[(-1)]
        D self_D___name = name  // self D __name__ := name
        D self_D___supertype = tp  // self D __supertype__ := tp
        P def_mod = _caller(P)
        T cond = → if def_mod ≠ "typing" → D self_D___module = def_mod  // self D __module__ := def_mod
    }
    D NewType____mro_entries = λ self, bases . {
        P superclass_name = self D __name__
        D Dummy = λ . P  // class
            D Dummy____init_subclass = λ cls . {
                P subclass_name = cls D __name__
                → E TypeError("Cannot subclass an instance of NewType. Perhaps you were looking for: `" + subclass_name + " = NewType(" + subclass_name + ", " + superclass_name + ")`")
            }
        → manifold [Dummy]
