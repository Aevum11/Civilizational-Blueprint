    L("  %stmt = call %ETASTNode* @etpl_parse_statement()")
    L("  %stmt_null = icmp eq %ETASTNode* %stmt, null")
    L("  br i1 %stmt_null, label %done, label %add_stmt")
    L("add_stmt:")
    L("  call void @etpl_ast_add_child(%ETASTNode* %prog, %ETASTNode* %stmt)")
    L("  br label %parse_loop")
    L("done:")
    L("  ret %ETASTNode* %prog")
    L("}")
    L("")
    P manifold__op_plus_n__op_plus_nb = S("s2_op_plus", "+")  // manifold [op_plus_n, op_plus_nb] := S("s2_op_plus", "+")
    P manifold__op_minus_n__op_minus_nb = S("s2_op_minus", "-")  // manifold [op_minus_n, op_minus_nb] := S("s2_op_minus", "-")
    P manifold__op_star_n__op_star_nb = S("s2_op_star", "*")  // manifold [op_star_n, op_star_nb] := S("s2_op_star", "*")
    P manifold__op_slash_n__op_slash_nb = S("s2_op_slash", "/")  // manifold [op_slash_n, op_slash_nb] := S("s2_op_slash", "/")
    P manifold__op_mod_n__op_mod_nb = S("s2_op_mod", "%")  // manifold [op_mod_n, op_mod_nb] := S("s2_op_mod", "%")
    P manifold__op_pow_n__op_pow_nb = S("s2_op_pow", "**")  // manifold [op_pow_n, op_pow_nb] := S("s2_op_pow", "**")
    P manifold__op_lt_n__op_lt_nb = S("s2_op_lt", "<")  // manifold [op_lt_n, op_lt_nb] := S("s2_op_lt", "<")
    P manifold__op_gt_n__op_gt_nb = S("s2_op_gt", ">")  // manifold [op_gt_n, op_gt_nb] := S("s2_op_gt", ">")
    P manifold__op_le_n__op_le_nb = S("s2_op_le", "<=")  // manifold [op_le_n, op_le_nb] := S("s2_op_le", "<=")
    P manifold__op_ge_n__op_ge_nb = S("s2_op_ge", ">=")  // manifold [op_ge_n, op_ge_nb] := S("s2_op_ge", ">=")
    P manifold__op_eq_n__op_eq_nb = S("s2_op_eq", "==")  // manifold [op_eq_n, op_eq_nb] := S("s2_op_eq", "==")
    P manifold__op_ne_n__op_ne_nb = S("s2_op_ne", "!=")  // manifold [op_ne_n, op_ne_nb] := S("s2_op_ne", "!=")
    L("; etpl_parse_statement: parses one statement")
    L("define %ETASTNode* @etpl_parse_statement() nounwind {")
    L("entry:")
    L("  %type = call i32 @etpl_parse_peek_type()")
    L("  ; P declaration")
    L("  %is_P = icmp eq i32 %type, 1")
    L("  br i1 %is_P, label %parse_p_decl, label %chk_D")
    L("chk_D:")
    L("  %is_D = icmp eq i32 %type, 2")
    L("  br i1 %is_D, label %parse_d_decl, label %chk_T")
    L("chk_T:")
    L("  %is_T = icmp eq i32 %type, 3")
    L("  br i1 %is_T, label %parse_t_decl, label %chk_sov_print")
    L("chk_sov_print:")
    L("  %is_sp = icmp eq i32 %type, 57")
    L("  br i1 %is_sp, label %parse_sov_print, label %chk_arrow")
    L("chk_arrow:")
    L("  %is_arrow = icmp eq i32 %type, 7")
    L("  br i1 %is_arrow, label %parse_path, label %chk_inf_loop")
    L("chk_inf_loop:")
    L("  %is_inf = icmp eq i32 %type, 70")
    L("  br i1 %is_inf, label %parse_loop, label %parse_expr_stmt")
    L("")
    L("parse_p_decl:")
    L("  %p_tok = call %ETToken* @etpl_parse_advance()")
    L("  %name_tok = call %ETToken* @etpl_parse_advance()")
    L("  %name_val = call i8* @etpl_parse_tok_value(%ETToken* %name_tok)")
    L("  %eq_tok = call %ETToken* @etpl_parse_advance()")
    L("  %p_body = call %ETASTNode* @etpl_parse_expression()")
    L("  %p_node = call %ETASTNode* @etpl_ast_new(i32 1)")
    L("  call void @etpl_ast_set_name(%ETASTNode* %p_node, i8* %name_val)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %p_node, %ETASTNode* %p_body)")
    L("  ret %ETASTNode* %p_node")
    L("")
    L("parse_d_decl:")
    L("  %d_tok = call %ETToken* @etpl_parse_advance()")
    L("  %d_name_tok = call %ETToken* @etpl_parse_advance()")
    L("  %d_name = call i8* @etpl_parse_tok_value(%ETToken* %d_name_tok)")
    L("  %d_eq_tok = call %ETToken* @etpl_parse_advance()")
    L("  %d_peek = call i32 @etpl_parse_peek_type()")
    L("  %d_is_lambda = icmp eq i32 %d_peek, 6")
    L("  br i1 %d_is_lambda, label %parse_d_lambda, label %parse_d_value")
    L("parse_d_lambda:")
    L("  %lam_tok = call %ETToken* @etpl_parse_advance()")
    L("  ; Read parameter name")
    L("  %lam_param_tok = call %ETToken* @etpl_parse_advance()")
    L("  %lam_param_name = call i8* @etpl_parse_tok_value(%ETToken* %lam_param_tok)")
    L("  %dot_tok = call %ETToken* @etpl_parse_advance()")
    L("  %lam_body = call %ETASTNode* @etpl_parse_expression()")
    L("  %d_lam_node = call %ETASTNode* @etpl_ast_new(i32 2)")
    L("  call void @etpl_ast_set_name(%ETASTNode* %d_lam_node, i8* %d_name)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %d_lam_node, %ETASTNode* %lam_body)")
    L("  ; Store param via params array")
    L("  %param_arr = call i8* @malloc(i64 8)")
    L("  %param_arr_typed = bitcast i8* %param_arr to i8**")
    L("  %param_dup = call i8* @" + strdup_fn + "(i8* %lam_param_name)")
    L("  store i8* %param_dup, i8** %param_arr_typed")
    L("  %params_ptr = getelementptr %ETASTNode, %ETASTNode* %d_lam_node, i32 0, i32 10")
    L("  store i8** %param_arr_typed, i8*** %params_ptr")
    L("  %pcnt_ptr = getelementptr %ETASTNode, %ETASTNode* %d_lam_node, i32 0, i32 11")
    L("  store i32 1, i32* %pcnt_ptr")
    L("  ret %ETASTNode* %d_lam_node")
    L("parse_d_value:")
    L("  %d_val = call %ETASTNode* @etpl_parse_expression()")
    L("  %d_val_node = call %ETASTNode* @etpl_ast_new(i32 2)")
    L("  call void @etpl_ast_set_name(%ETASTNode* %d_val_node, i8* %d_name)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %d_val_node, %ETASTNode* %d_val)")
    L("  ret %ETASTNode* %d_val_node")
    L("")
    L("parse_t_decl:")
    L("  %t_tok = call %ETToken* @etpl_parse_advance()")
    L("  %t_name_tok = call %ETToken* @etpl_parse_advance()")
    L("  %t_name = call i8* @etpl_parse_tok_value(%ETToken* %t_name_tok)")
    L("  %t_eq = call %ETToken* @etpl_parse_advance()")
    L("  %t_body = call %ETASTNode* @etpl_parse_expression()")
    L("  %t_node = call %ETASTNode* @etpl_ast_new(i32 3)")
    L("  call void @etpl_ast_set_name(%ETASTNode* %t_node, i8* %t_name)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %t_node, %ETASTNode* %t_body)")
    L("  ret %ETASTNode* %t_node")
    L("")
    L("parse_sov_print:")
    L("  %sp_tok = call %ETToken* @etpl_parse_advance()")
    L("  %sp_peek = call i32 @etpl_parse_peek_type()")
    L("  %sp_has_compose = icmp eq i32 %sp_peek, 5")
    L("  br i1 %sp_has_compose, label %sp_eat_compose, label %sp_parse_arg")
    L("sp_eat_compose:")
    L("  %sp_comp = call %ETToken* @etpl_parse_advance()")
    L("  br label %sp_parse_arg")
    L("sp_parse_arg:")
    L("  %sp_arg = call %ETASTNode* @etpl_parse_expression()")
    L("  %sp_node = call %ETASTNode* @etpl_ast_new(i32 19)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %sp_node, %ETASTNode* %sp_arg)")
    L("  ret %ETASTNode* %sp_node")
    L("")
    L("parse_path:")
    L("  %path_tok = call %ETToken* @etpl_parse_advance()")
    L("  %path_body = call %ETASTNode* @etpl_parse_expression()")
    L("  %path_node = call %ETASTNode* @etpl_ast_new(i32 16)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %path_node, %ETASTNode* %path_body)")
    L("  ret %ETASTNode* %path_node")
    L("")
    L("parse_loop:")
    L("  %loop_tok = call %ETToken* @etpl_parse_advance()")
    L("  %loop_lp = call %ETToken* @etpl_parse_advance()")
    L("  %loop_body = call %ETASTNode* @etpl_parse_expression()")
    L("  %loop_rp = call %ETToken* @etpl_parse_advance()")
    L("  %loop_lp2 = call %ETToken* @etpl_parse_advance()")
    L("  %loop_d = call %ETToken* @etpl_parse_advance()")
    L("  %loop_bound = call %ETASTNode* @etpl_parse_expression()")
    L("  %loop_rp2 = call %ETToken* @etpl_parse_advance()")
    L("  %loop_node = call %ETASTNode* @etpl_ast_new(i32 13)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %loop_node, %ETASTNode* %loop_body)")
    L("  call void @etpl_ast_set_bound(%ETASTNode* %loop_node, %ETASTNode* %loop_bound)")
    L("  ret %ETASTNode* %loop_node")
    L("")
    L("parse_expr_stmt:")
    L("  %expr = call %ETASTNode* @etpl_parse_expression()")
    L("  ret %ETASTNode* %expr")
    L("}")
    L("")
    L("define %ETASTNode* @etpl_parse_expression() nounwind {")
    L("entry:")
    L("  %result = call %ETASTNode* @etpl_parse_comparison()")
    L("  ; Check for ∘ (function application)")
    L("  %peek = call i32 @etpl_parse_peek_type()")
    L("  %is_compose = icmp eq i32 %peek, 5")
    L("  br i1 %is_compose, label %parse_call, label %done")
    L("parse_call:")
    L("  %comp_tok = call %ETToken* @etpl_parse_advance()")
    L("  %arg = call %ETASTNode* @etpl_parse_expression()")
    L("  %call_node = call %ETASTNode* @etpl_ast_new(i32 6)")
    L("  call void @etpl_ast_set_left(%ETASTNode* %call_node, %ETASTNode* %result)")
    L("  call void @etpl_ast_set_right(%ETASTNode* %call_node, %ETASTNode* %arg)")
    L("  ret %ETASTNode* %call_node")
    L("done:")
    L("  ret %ETASTNode* %result")
    L("}")
    L("")
    L("define %ETASTNode* @etpl_parse_comparison() nounwind {")
    L("entry:")
    L("  %left = call %ETASTNode* @etpl_parse_additive()")
    L("  %peek = call i32 @etpl_parse_peek_type()")
    P cmp_ops = manifold [manifold [60, op_lt_n, op_lt_nb], manifold [61, op_gt_n, op_gt_nb], manifold [62, op_le_n, op_le_nb], manifold [63, op_ge_n, op_ge_nb], manifold [64, op_eq_n, op_eq_nb], manifold [65, op_ne_n, op_ne_nb]]
    T loop = ∞ (
        P manifold__ci__manifold__tok_id__op_n__op_nb = enumerate(cmp_ops)[_loop_index]  // manifold [ci, manifold [tok_id, op_n, op_nb]]
        P next_lbl = if ci < (len(cmp_ops) - 1) → "cmp_chk_" + (ci + 1) → E "cmp_done"
        L("  %is_cmp_" + ci + " = icmp eq i32 %peek, " + tok_id)
        L("  br i1 %is_cmp_" + ci + ", label %cmp_op_" + ci + ", label %" + next_lbl)
        L("cmp_op_" + ci + ":")
        L("  %cmp_tok_" + ci + " = call %ETToken* @etpl_parse_advance()")
        L("  %cmp_right_" + ci + " = call %ETASTNode* @etpl_parse_additive()")
        L("  %cmp_node_" + ci + " = call %ETASTNode* @etpl_ast_new(i32 18)")
        L("  call void @etpl_ast_set_left(%ETASTNode* %cmp_node_" + ci + ", %ETASTNode* %left)")
        L("  call void @etpl_ast_set_right(%ETASTNode* %cmp_node_" + ci + ", %ETASTNode* %cmp_right_" + ci + ")")
        L("  %cmp_op_str_" + ci + " = " + G(op_n, op_nb))
        L("  call void @etpl_ast_set_op(%ETASTNode* %cmp_node_" + ci + ", i8* %cmp_op_str_" + ci + ")")
        L("  ret %ETASTNode* %cmp_node_" + ci)
        T cond = → if ci < (len(cmp_ops) - 1) → L("cmp_chk_" + (ci + 1) + ":")
    ) (D |enumerate(cmp_ops)|)
    L("cmp_done:")
    L("  ret %ETASTNode* %left")
    L("}")
    L("")
    L("define %ETASTNode* @etpl_parse_additive() nounwind {")
    L("entry:")
    L("  %left = call %ETASTNode* @etpl_parse_multiplicative()")
    L("  br label %add_loop")
    L("add_loop:")
    L("  %add_left = phi %ETASTNode* [ %left, %entry ], [ %add_node, %add_cont ]")
    L("  %add_peek = call i32 @etpl_parse_peek_type()")
    L("  %is_plus = icmp eq i32 %add_peek, 19")
    L("  %is_minus = icmp eq i32 %add_peek, 20")
    L("  %is_add_op = or i1 %is_plus, %is_minus")
    L("  br i1 %is_add_op, label %add_op, label %add_done")
    L("add_op:")
    L("  %add_tok = call %ETToken* @etpl_parse_advance()")
    L("  %add_op_str = select i1 %is_plus, i8* " + G(op_plus_n, op_plus_nb) + ", i8* " + G(op_minus_n, op_minus_nb))
    L("  %add_right = call %ETASTNode* @etpl_parse_multiplicative()")
    L("  %add_node = call %ETASTNode* @etpl_ast_new(i32 7)")
    L("  call void @etpl_ast_set_left(%ETASTNode* %add_node, %ETASTNode* %add_left)")
    L("  call void @etpl_ast_set_right(%ETASTNode* %add_node, %ETASTNode* %add_right)")
    L("  call void @etpl_ast_set_op(%ETASTNode* %add_node, i8* %add_op_str)")
    L("  br label %add_cont")
    L("add_cont:")
    L("  br label %add_loop")
    L("add_done:")
    L("  ret %ETASTNode* %add_left")
    L("}")
    L("")
    L("define %ETASTNode* @etpl_parse_multiplicative() nounwind {")
    L("entry:")
    L("  %left = call %ETASTNode* @etpl_parse_unary()")
    L("  br label %mul_loop")
    L("mul_loop:")
    L("  %mul_left = phi %ETASTNode* [ %left, %entry ], [ %mul_node, %mul_cont ]")
    L("  %mul_peek = call i32 @etpl_parse_peek_type()")
    L("  %is_star = icmp eq i32 %mul_peek, 21")
    L("  %is_slash = icmp eq i32 %mul_peek, 22")
    L("  %is_mod = icmp eq i32 %mul_peek, 26")
    L("  %is_dstar = icmp eq i32 %mul_peek, 24")
    L("  %mul1 = or i1 %is_star, %is_slash")
    L("  %mul2 = or i1 %mul1, %is_mod")
    L("  %is_mul_op = or i1 %mul2, %is_dstar")
    L("  br i1 %is_mul_op, label %mul_op, label %mul_done")
    L("mul_op:")
    L("  %mul_tok = call %ETToken* @etpl_parse_advance()")
    L("  %mul_op_s1 = select i1 %is_star, i8* " + G(op_star_n, op_star_nb) + ", i8* " + G(op_slash_n, op_slash_nb))
    L("  %mul_op_s2 = select i1 %is_mod, i8* " + G(op_mod_n, op_mod_nb) + ", i8* %mul_op_s1")
    L("  %mul_op_str = select i1 %is_dstar, i8* " + G(op_pow_n, op_pow_nb) + ", i8* %mul_op_s2")
    L("  %mul_right = call %ETASTNode* @etpl_parse_unary()")
    L("  %mul_node = call %ETASTNode* @etpl_ast_new(i32 7)")
    L("  call void @etpl_ast_set_left(%ETASTNode* %mul_node, %ETASTNode* %mul_left)")
    L("  call void @etpl_ast_set_right(%ETASTNode* %mul_node, %ETASTNode* %mul_right)")
    L("  call void @etpl_ast_set_op(%ETASTNode* %mul_node, i8* %mul_op_str)")
    L("  br label %mul_cont")
    L("mul_cont:")
    L("  br label %mul_loop")
    L("mul_done:")
    L("  ret %ETASTNode* %mul_left")
    L("}")
    L("")
    L("define %ETASTNode* @etpl_parse_unary() nounwind {")
    L("entry:")
    L("  %peek = call i32 @etpl_parse_peek_type()")
    L("  %is_minus = icmp eq i32 %peek, 20")
    L("  br i1 %is_minus, label %unary_minus, label %parse_atom")
    L("unary_minus:")
    L("  %neg_tok = call %ETToken* @etpl_parse_advance()")
    L("  %operand = call %ETASTNode* @etpl_parse_unary()")
    L("  %neg_node = call %ETASTNode* @etpl_ast_new(i32 8)")
    L("  %neg_op = " + G(op_minus_n, op_minus_nb))
    L("  call void @etpl_ast_set_op(%ETASTNode* %neg_node, i8* %neg_op)")
    L("  call void @etpl_ast_set_body(%ETASTNode* %neg_node, %ETASTNode* %operand)")
    L("  ret %ETASTNode* %neg_node")
    L("parse_atom:")
    L("  %atom = call %ETASTNode* @etpl_parse_atom()")
    L("  ret %ETASTNode* %atom")
    L("}")
    L("")
    L("define %ETASTNode* @etpl_parse_atom() nounwind {")
    L("entry:")
    L("  %peek = call i32 @etpl_parse_peek_type()")
    L("  %is_int = icmp eq i32 %peek, 50")
    L("  br i1 %is_int, label %parse_int, label %chk_flt")
    L("parse_int:")
    L("  %int_tok = call %ETToken* @etpl_parse_advance()")
    L("  %int_val_s = call i8* @etpl_parse_tok_value(%ETToken* %int_tok)")
    L("  %int_node = call %ETASTNode* @etpl_ast_new(i32 9)")
    L("  call void @etpl_ast_set_value(%ETASTNode* %int_node, i8* %int_val_s)")
    L("  ret %ETASTNode* %int_node")
    L("")
    L("chk_flt:")
    L("  %is_flt = icmp eq i32 %peek, 51")
    L("  br i1 %is_flt, label %parse_flt, label %chk_str")
    L("parse_flt:")
    L("  %flt_tok = call %ETToken* @etpl_parse_advance()")
    L("  %flt_val_s = call i8* @etpl_parse_tok_value(%ETToken* %flt_tok)")
    L("  %flt_node = call %ETASTNode* @etpl_ast_new(i32 10)")
    L("  call void @etpl_ast_set_value(%ETASTNode* %flt_node, i8* %flt_val_s)")
    L("  ret %ETASTNode* %flt_node")
    L("")
    L("chk_str:")
    L("  %is_str = icmp eq i32 %peek, 52")
    L("  br i1 %is_str, label %parse_str, label %chk_ident")
    L("parse_str:")
    L("  %str_tok = call %ETToken* @etpl_parse_advance()")
    L("  %str_val = call i8* @etpl_parse_tok_value(%ETToken* %str_tok)")
    L("  %str_node = call %ETASTNode* @etpl_ast_new(i32 11)")
    L("  call void @etpl_ast_set_value(%ETASTNode* %str_node, i8* %str_val)")
    L("  ret %ETASTNode* %str_node")
    L("")
    L("chk_ident:")
    L("  %is_ident = icmp eq i32 %peek, 53")
    L("  br i1 %is_ident, label %parse_ident, label %chk_lparen")
    L("parse_ident:")
    L("  %id_tok = call %ETToken* @etpl_parse_advance()")
    L("  %id_val = call i8* @etpl_parse_tok_value(%ETToken* %id_tok)")
    L("  %id_node = call %ETASTNode* @etpl_ast_new(i32 12)")
    L("  call void @etpl_ast_set_value(%ETASTNode* %id_node, i8* %id_val)")
    L("  call void @etpl_ast_set_name(%ETASTNode* %id_node, i8* %id_val)")
    L("  ret %ETASTNode* %id_node")
    L("")
    L("chk_lparen:")
    L("  %is_lp = icmp eq i32 %peek, 11")
    L("  br i1 %is_lp, label %parse_paren, label %chk_if")
    L("parse_paren:")
    L("  %lp_tok = call %ETToken* @etpl_parse_advance()")
    L("  %inner = call %ETASTNode* @etpl_parse_expression()")
    L("  %rp_tok = call %ETToken* @etpl_parse_advance()")
    L("  ret %ETASTNode* %inner")
    L("")
    L("chk_if:")
    L("  %is_if = icmp eq i32 %peek, 56")
    L("  br i1 %is_if, label %parse_if, label %chk_manifold")
    L("parse_if:")
    L("  %if_tok = call %ETToken* @etpl_parse_advance()")
    L("  %if_lp = call %ETToken* @etpl_parse_advance()")
    L("  %if_cond = call %ETASTNode* @etpl_parse_expression()")
    L("  %if_rp = call %ETToken* @etpl_parse_advance()")
    L("  %if_arrow = call %ETToken* @etpl_parse_advance()")
    L("  %if_then = call %ETASTNode* @etpl_parse_expression()")
    L("  ; Check for else branch (→ E expr)")
    L("  %if_peek = call i32 @etpl_parse_peek_type()")
    L("  %if_has_arrow = icmp eq i32 %if_peek, 7")
    L("  br i1 %if_has_arrow, label %parse_else, label %if_done")
    L("parse_else:")
    L("  %else_arr = call %ETToken* @etpl_parse_advance()")
    L("  %else_e = call %ETToken* @etpl_parse_advance()")
    L("  %if_else = call %ETASTNode* @etpl_parse_expression()")
    L("  %if_node_e = call %ETASTNode* @etpl_ast_new(i32 17)")
    L("  call void @etpl_ast_set_condition(%ETASTNode* %if_node_e, %ETASTNode* %if_cond)")
    L("  call void @etpl_ast_set_then_br(%ETASTNode* %if_node_e, %ETASTNode* %if_then)")
    L("  call void @etpl_ast_set_else_br(%ETASTNode* %if_node_e, %ETASTNode* %if_else)")
    L("  ret %ETASTNode* %if_node_e")
    L("if_done:")
    L("  %if_node = call %ETASTNode* @etpl_ast_new(i32 17)")
    L("  call void @etpl_ast_set_condition(%ETASTNode* %if_node, %ETASTNode* %if_cond)")
    L("  call void @etpl_ast_set_then_br(%ETASTNode* %if_node, %ETASTNode* %if_then)")
    L("  ret %ETASTNode* %if_node")
    L("")
    L("chk_manifold:")
    L("  %is_manifold = icmp eq i32 %peek, 55")
    L("  br i1 %is_manifold, label %parse_manifold_kw, label %chk_lbracket")
    L("parse_manifold_kw:")
    L("  %mf_tok = call %ETToken* @etpl_parse_advance()")
    L("  br label %parse_manifold")
    L("chk_lbracket:")
    L("  %is_lb = icmp eq i32 %peek, 13")
    L("  br i1 %is_lb, label %parse_manifold, label %chk_lbrace")
    L("parse_manifold:")
    L("  %mf_open = call %ETToken* @etpl_parse_advance()")
    L("  %mf_node = call %ETASTNode* @etpl_ast_new(i32 15)")
    L("  %mf_peek = call i32 @etpl_parse_peek_type()")
    L("  %mf_empty = icmp eq i32 %mf_peek, 14")
    L("  br i1 %mf_empty, label %mf_close, label %mf_items")
    L("mf_items:")
    L("  %mf_item = call %ETASTNode* @etpl_parse_expression()")
    L("  call void @etpl_ast_add_child(%ETASTNode* %mf_node, %ETASTNode* %mf_item)")
    L("  %mf_sep = call i32 @etpl_parse_peek_type()")
    L("  %mf_is_comma = icmp eq i32 %mf_sep, 17")
    L("  br i1 %mf_is_comma, label %mf_eat_comma, label %mf_close")
    L("mf_eat_comma:")
    L("  %mf_comma = call %ETToken* @etpl_parse_advance()")
    L("  br label %mf_items")
    L("mf_close:")
    L("  %mf_rb = call %ETToken* @etpl_parse_advance()")
    L("  ret %ETASTNode* %mf_node")
    L("")
    L("chk_lbrace:")
    L("  %is_lbr = icmp eq i32 %peek, 15")
    L("  br i1 %is_lbr, label %parse_block, label %fallback_none")
    L("parse_block:")
    L("  %blk_open = call %ETToken* @etpl_parse_advance()")
    L("  %blk_prog = call %ETASTNode* @etpl_ast_new(i32 0)")
    L("  br label %blk_loop")
    L("blk_loop:")
    L("  %blk_peek = call i32 @etpl_parse_peek_type()")
    L("  %blk_is_end = icmp eq i32 %blk_peek, 16")
    L("  %blk_is_eof = icmp eq i32 %blk_peek, 0")
    L("  %blk_done = or i1 %blk_is_end, %blk_is_eof")
    L("  br i1 %blk_done, label %blk_close, label %blk_stmt")
    L("blk_stmt:")
    L("  %blk_s = call %ETASTNode* @etpl_parse_statement()")
    L("  %blk_s_null = icmp eq %ETASTNode* %blk_s, null")
    L("  br i1 %blk_s_null, label %blk_close, label %blk_add")
    L("blk_add:")
    L("  call void @etpl_ast_add_child(%ETASTNode* %blk_prog, %ETASTNode* %blk_s)")
    L("  br label %blk_loop")
    L("blk_close:")
    L("  %blk_close_peek = call i32 @etpl_parse_peek_type()")
    L("  %blk_close_is_rb = icmp eq i32 %blk_close_peek, 16")
    L("  br i1 %blk_close_is_rb, label %blk_eat_rb, label %blk_ret")
    L("blk_eat_rb:")
    L("  %blk_rb = call %ETToken* @etpl_parse_advance()")
    L("  br label %blk_ret")
    L("blk_ret:")
    L("  ret %ETASTNode* %blk_prog")
    L("")
    L("fallback_none:")
    L("  ; Consume the unknown token to avoid infinite loop")
    L("  %unk_tok = call %ETToken* @etpl_parse_advance()")
    L("  ret %ETASTNode* null")
    L("}")
    L("")
}
D emit_s2_interpreter = λ self, L, S, G, is_win . {
    // Emit native AST interpreter.      ET Form: P(AST) ∘ D(eval rules) ∘ T(tree walk) = E(runtime value)
    P strdup_fn = if is_win → "_strdup" → E "strdup"
    P manifold__undef_n__undef_nb = S("s2_undef", "  [ETPL Native] Error: Undefined identifier '%s'\n")  // manifold [undef_n, undef_nb] := S("s2_undef", "  [ETPL Native] Error: Undefined identifier '%s'\n")
    P manifold__divzero_n__divzero_nb = S("s2_divzero", "  [ETPL Native] Warning: Division by zero\n")  // manifold [divzero_n, divzero_nb] := S("s2_divzero", "  [ETPL Native] Warning: Division by zero\n")
    P manifold__sp_prefix_n__sp_prefix_nb = S("s2_sp_prefix", "")  // manifold [sp_prefix_n, sp_prefix_nb] := S("s2_sp_prefix", "")
    P manifold__float_buf_n__float_buf_nb = S("s2_float_buf_fmt", "%g")  // manifold [float_buf_n, float_buf_nb] := S("s2_float_buf_fmt", "%g")
    L("; --- Native Interpreter (Stage 2) ---")
    L("; etpl_eval: evaluate AST node in environment → ETValue*")
    L("define %ETValue* @etpl_eval(%ETASTNode* %node, %ETEnv* %env) nounwind {")
    L("entry:")
    L("  %is_null = icmp eq %ETASTNode* %node, null")
    L("  br i1 %is_null, label %ret_none, label %get_type")
    L("ret_none:")
    L("  %none = call %ETValue* @etpl_val_new_none()")
    L("  ret %ETValue* %none")
    L("get_type:")
    L("  %type = call i32 @etpl_ast_get_type(%ETASTNode* %node)")
    L("  switch i32 %type, label %ret_none [")
    L("    i32 0,  label %eval_program")
    L("    i32 1,  label %eval_p_decl")
    L("    i32 2,  label %eval_d_decl")
    L("    i32 3,  label %eval_t_decl")
    L("    i32 6,  label %eval_call")
    L("    i32 7,  label %eval_math_op")
    L("    i32 8,  label %eval_unary_op")
    L("    i32 9,  label %eval_lit_int")
    L("    i32 10, label %eval_lit_float")
    L("    i32 11, label %eval_lit_string")
    L("    i32 12, label %eval_identifier")
    L("    i32 13, label %eval_loop")
    L("    i32 15, label %eval_manifold")
    L("    i32 16, label %eval_path")
    L("    i32 17, label %eval_if")
    L("    i32 18, label %eval_comparison")
    L("    i32 19, label %eval_sov_call")
    L("  ]")
    L("")
    L("eval_program:")
    L("  %prog_cnt = call i32 @etpl_ast_get_child_count(%ETASTNode* %node)")
    L("  %prog_cnt_ext = zext i32 %prog_cnt to i64")
    L("  %children_ptr = getelementptr %ETASTNode, %ETASTNode* %node, i32 0, i32 12")
    L("  %children = load %ETASTNode**, %ETASTNode*** %children_ptr")
    L("  br label %prog_loop")
    L("prog_loop:")
    L("  %pi = phi i64 [ 0, %eval_program ], [ %pi_next, %prog_cont ]")
    L("  %p_result = phi %ETValue* [ null, %eval_program ], [ %p_val, %prog_cont ]")
    L("  %p_done = icmp uge i64 %pi, %prog_cnt_ext")
    L("  br i1 %p_done, label %prog_done, label %prog_eval_child")
    L("prog_eval_child:")
    L("  %child_ptr = getelementptr %ETASTNode*, %ETASTNode** %children, i64 %pi")
    L("  %child = load %ETASTNode*, %ETASTNode** %child_ptr")
    L("  %p_val = call %ETValue* @etpl_eval(%ETASTNode* %child, %ETEnv* %env)")
    L("  %pi_next = add i64 %pi, 1")
    L("  br label %prog_cont")
    L("prog_cont:")
    L("  br label %prog_loop")
    L("prog_done:")
    L("  %prog_ret = phi %ETValue* [ null, %prog_loop ]")
    L("  %prog_is_null = icmp eq %ETValue* %p_result, null")
    L("  br i1 %prog_is_null, label %prog_ret_none, label %prog_ret_val")
    L("prog_ret_none:")
    L("  %prog_none = call %ETValue* @etpl_val_new_none()")
    L("  ret %ETValue* %prog_none")
    L("prog_ret_val:")
    L("  ret %ETValue* %p_result")
    L("")
    L("eval_p_decl:")
    L("  %pd_body = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  %pd_val = call %ETValue* @etpl_eval(%ETASTNode* %pd_body, %ETEnv* %env)")
    L("  %pd_name = call i8* @etpl_ast_get_name(%ETASTNode* %node)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %pd_name, %ETValue* %pd_val)")
    L("  ret %ETValue* %pd_val")
    L("")
    L("eval_d_decl:")
    L("  %dd_pcnt = call i32 @etpl_ast_get_param_count(%ETASTNode* %node)")
    L("  %dd_has_params = icmp ugt i32 %dd_pcnt, 0")
    L("  br i1 %dd_has_params, label %dd_closure, label %dd_value")
    L("dd_closure:")
    L("  ; Create a closure value (tag=5, ptr1=body_node, ptr2=env)")
    L("  %dd_closure_val = call %ETValue* @etpl_val_new_none()")
    L("  %dd_cl_tag = getelementptr %ETValue, %ETValue* %dd_closure_val, i32 0, i32 0")
    L("  store i32 5, i32* %dd_cl_tag")
    L("  ; Store node pointer in ptr1")
    L("  %dd_cl_ptr1 = getelementptr %ETValue, %ETValue* %dd_closure_val, i32 0, i32 3")
    L("  %dd_node_raw = bitcast %ETASTNode* %node to i8*")
    L("  store i8* %dd_node_raw, i8** %dd_cl_ptr1")
    L("  ; Store env pointer in ptr2")
    L("  %dd_cl_ptr2 = getelementptr %ETValue, %ETValue* %dd_closure_val, i32 0, i32 4")
    L("  %dd_env_raw = bitcast %ETEnv* %env to i8*")
    L("  store i8* %dd_env_raw, i8** %dd_cl_ptr2")
    L("  %dd_name_cl = call i8* @etpl_ast_get_name(%ETASTNode* %node)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %dd_name_cl, %ETValue* %dd_closure_val)")
    L("  ret %ETValue* %dd_closure_val")
    L("dd_value:")
    L("  %dd_body = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  %dd_v = call %ETValue* @etpl_eval(%ETASTNode* %dd_body, %ETEnv* %env)")
    L("  %dd_name = call i8* @etpl_ast_get_name(%ETASTNode* %node)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %dd_name, %ETValue* %dd_v)")
    L("  ret %ETValue* %dd_v")
    L("")
    L("eval_t_decl:")
    L("  %td_body = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  %td_val = call %ETValue* @etpl_eval(%ETASTNode* %td_body, %ETEnv* %env)")
    L("  %td_name = call i8* @etpl_ast_get_name(%ETASTNode* %node)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %td_name, %ETValue* %td_val)")
    L("  ret %ETValue* %td_val")
    L("")
    L("eval_call:")
    L("  %call_l = call %ETASTNode* @etpl_ast_get_left(%ETASTNode* %node)")
    L("  %call_r = call %ETASTNode* @etpl_ast_get_right(%ETASTNode* %node)")
    L("  %call_func = call %ETValue* @etpl_eval(%ETASTNode* %call_l, %ETEnv* %env)")
    L("  %call_arg = call %ETValue* @etpl_eval(%ETASTNode* %call_r, %ETEnv* %env)")
    L("  %call_func_tag = call i32 @etpl_val_get_tag(%ETValue* %call_func)")
    L("  %is_closure = icmp eq i32 %call_func_tag, 5")
    L("  br i1 %is_closure, label %call_closure, label %call_raw")
    L("call_closure:")
    L("  ; Extract closure: ptr1=AST node, ptr2=captured env")
    L("  %cl_ptr1 = getelementptr %ETValue, %ETValue* %call_func, i32 0, i32 3")
    L("  %cl_node_raw = load i8*, i8** %cl_ptr1")
    L("  %cl_node = bitcast i8* %cl_node_raw to %ETASTNode*")
    L("  %cl_ptr2 = getelementptr %ETValue, %ETValue* %call_func, i32 0, i32 4")
    L("  %cl_env_raw = load i8*, i8** %cl_ptr2")
    L("  %cl_env = bitcast i8* %cl_env_raw to %ETEnv*")
    L("  ; Create new scope with param bound to arg")
    L("  %call_scope = call %ETEnv* @etpl_env_new(%ETEnv* %cl_env)")
    L("  %cl_params_ptr = getelementptr %ETASTNode, %ETASTNode* %cl_node, i32 0, i32 10")
    L("  %cl_params = load i8**, i8*** %cl_params_ptr")
    L("  %cl_param0_ptr = getelementptr i8*, i8** %cl_params, i64 0")
    L("  %cl_param0 = load i8*, i8** %cl_param0_ptr")
    L("  call void @etpl_env_set(%ETEnv* %call_scope, i8* %cl_param0, %ETValue* %call_arg)")
    L("  %cl_body = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %cl_node)")
    L("  %cl_result = call %ETValue* @etpl_eval(%ETASTNode* %cl_body, %ETEnv* %call_scope)")
    L("  ret %ETValue* %cl_result")
    L("call_raw:")
    L("  ; Non-closure call: return the function value")
    L("  ret %ETValue* %call_func")
    L("")
    L("eval_math_op:")
    L("  %mo_l = call %ETASTNode* @etpl_ast_get_left(%ETASTNode* %node)")
    L("  %mo_r = call %ETASTNode* @etpl_ast_get_right(%ETASTNode* %node)")
    L("  %mo_lv = call %ETValue* @etpl_eval(%ETASTNode* %mo_l, %ETEnv* %env)")
    L("  %mo_rv = call %ETValue* @etpl_eval(%ETASTNode* %mo_r, %ETEnv* %env)")
    L("  %mo_op = call i8* @etpl_ast_get_op(%ETASTNode* %node)")
    L("  %mo_result = call %ETValue* @etpl_math_op(%ETValue* %mo_lv, %ETValue* %mo_rv, i8* %mo_op)")
    L("  ret %ETValue* %mo_result")
    L("")
    L("eval_unary_op:")
    L("  %uo_body = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  %uo_val = call %ETValue* @etpl_eval(%ETASTNode* %uo_body, %ETEnv* %env)")
    L("  %uo_f = call double @etpl_val_to_float(%ETValue* %uo_val)")
    L("  %uo_neg = fneg double %uo_f")
    L("  %uo_result = call %ETValue* @etpl_val_new_float(double %uo_neg)")
    L("  ret %ETValue* %uo_result")
    L("")
    L("eval_lit_int:")
    L("  %li_val_s = call i8* @etpl_ast_get_value(%ETASTNode* %node)")
    L("  %li_null = alloca i8*")
    L("  %li_val = call i64 @strtol(i8* %li_val_s, i8** %li_null, i32 10)")
    L("  %li_result = call %ETValue* @etpl_val_new_int(i64 %li_val)")
    L("  ret %ETValue* %li_result")
    L("")
    L("eval_lit_float:")
    L("  %lf_val_s = call i8* @etpl_ast_get_value(%ETASTNode* %node)")
    L("  %lf_null = alloca i8*")
    L("  %lf_val = call double @strtod(i8* %lf_val_s, i8** %lf_null)")
    L("  %lf_result = call %ETValue* @etpl_val_new_float(double %lf_val)")
    L("  ret %ETValue* %lf_result")
    L("")
    L("eval_lit_string:")
    L("  %ls_val = call i8* @etpl_ast_get_value(%ETASTNode* %node)")
    L("  %ls_result = call %ETValue* @etpl_val_new_str(i8* %ls_val)")
    L("  ret %ETValue* %ls_result")
    L("")
    L("eval_identifier:")
    L("  %id_name = call i8* @etpl_ast_get_name(%ETASTNode* %node)")
    L("  %id_result = call %ETValue* @etpl_env_get(%ETEnv* %env, i8* %id_name)")
    L("  %id_is_null = icmp eq %ETValue* %id_result, null")
    L("  br i1 %id_is_null, label %id_undef, label %id_found")
    L("id_undef:")
    L("  %undef_p = " + G(undef_n, undef_nb))
    L("  call i32 (i8*, ...) @printf(i8* %undef_p, i8* %id_name)")
    L("  %id_none = call %ETValue* @etpl_val_new_none()")
    L("  ret %ETValue* %id_none")
    L("id_found:")
    L("  ret %ETValue* %id_result")
    L("")
    L("eval_loop:")
    L("  %loop_bound_node = call %ETASTNode* @etpl_ast_get_bound(%ETASTNode* %node)")
    L("  %loop_bound_val = call %ETValue* @etpl_eval(%ETASTNode* %loop_bound_node, %ETEnv* %env)")
    L("  %loop_bound_i = call i64 @etpl_val_get_int(%ETValue* %loop_bound_val)")
    L("  %loop_body_node = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  br label %loop_iter")
    L("loop_iter:")
    L("  %loop_i = phi i64 [ 0, %eval_loop ], [ %loop_i_next, %loop_next ]")
    L("  %loop_result = phi %ETValue* [ null, %eval_loop ], [ %loop_val, %loop_next ]")
    L("  %loop_done = icmp uge i64 %loop_i, %loop_bound_i")
    L("  br i1 %loop_done, label %loop_end, label %loop_exec")
    L("loop_exec:")
    L("  %loop_val = call %ETValue* @etpl_eval(%ETASTNode* %loop_body_node, %ETEnv* %env)")
    L("  %loop_i_next = add i64 %loop_i, 1")
    L("  br label %loop_next")
    L("loop_next:")
    L("  br label %loop_iter")
    L("loop_end:")
    L("  %loop_final = icmp eq %ETValue* %loop_result, null")
    L("  br i1 %loop_final, label %loop_ret_none, label %loop_ret_val")
    L("loop_ret_none:")
    L("  %loop_none = call %ETValue* @etpl_val_new_none()")
    L("  ret %ETValue* %loop_none")
    L("loop_ret_val:")
    L("  ret %ETValue* %loop_result")
    L("")
    L("eval_manifold:")
    L("  %mf_cnt = call i32 @etpl_ast_get_child_count(%ETASTNode* %node)")
    L("  %mf_list = call %ETValue* @etpl_val_new_list(i32 %mf_cnt)")
    L("  ; TODO: populate list items")
    L("  ret %ETValue* %mf_list")
    L("")
    L("eval_path:")
    L("  %path_b = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  %path_v = call %ETValue* @etpl_eval(%ETASTNode* %path_b, %ETEnv* %env)")
    L("  ret %ETValue* %path_v")
    L("")
    L("eval_if:")
    L("  %if_c = call %ETASTNode* @etpl_ast_get_condition(%ETASTNode* %node)")
    L("  %if_cv = call %ETValue* @etpl_eval(%ETASTNode* %if_c, %ETEnv* %env)")
    L("  %if_truthy = call i32 @etpl_val_is_truthy(%ETValue* %if_cv)")
    L("  %if_is_true = icmp ne i32 %if_truthy, 0")
    L("  br i1 %if_is_true, label %if_then, label %if_else")
    L("if_then:")
    L("  %if_t = call %ETASTNode* @etpl_ast_get_then_br(%ETASTNode* %node)")
    L("  %if_tv = call %ETValue* @etpl_eval(%ETASTNode* %if_t, %ETEnv* %env)")
    L("  ret %ETValue* %if_tv")
    L("if_else:")
    L("  %if_e = call %ETASTNode* @etpl_ast_get_else_br(%ETASTNode* %node)")
    L("  %if_e_null = icmp eq %ETASTNode* %if_e, null")
    L("  br i1 %if_e_null, label %if_ret_none, label %if_eval_else")
    L("if_eval_else:")
    L("  %if_ev = call %ETValue* @etpl_eval(%ETASTNode* %if_e, %ETEnv* %env)")
    L("  ret %ETValue* %if_ev")
    L("if_ret_none:")
    L("  %if_none = call %ETValue* @etpl_val_new_none()")
    L("  ret %ETValue* %if_none")
    L("")
    L("eval_comparison:")
    L("  %cmp_l = call %ETASTNode* @etpl_ast_get_left(%ETASTNode* %node)")
    L("  %cmp_r = call %ETASTNode* @etpl_ast_get_right(%ETASTNode* %node)")
    L("  %cmp_lv = call %ETValue* @etpl_eval(%ETASTNode* %cmp_l, %ETEnv* %env)")
    L("  %cmp_rv = call %ETValue* @etpl_eval(%ETASTNode* %cmp_r, %ETEnv* %env)")
    L("  %cmp_op_s = call i8* @etpl_ast_get_op(%ETASTNode* %node)")
    L("  %cmp_lf = call double @etpl_val_to_float(%ETValue* %cmp_lv)")
    L("  %cmp_rf = call double @etpl_val_to_float(%ETValue* %cmp_rv)")
    L("  ; Dispatch on op string (first char)")
    L("  %cmp_op_ch = load i8, i8* %cmp_op_s")
    L("  %cmp_op_ci = zext i8 %cmp_op_ch to i32")
    L("  ; < = 60, > = 62, = = 61, ! = 33")
    L("  %cmp_is_lt = icmp eq i32 %cmp_op_ci, 60")
    L("  br i1 %cmp_is_lt, label %cmp_lt_group, label %cmp_gt_group")
    L("cmp_lt_group:")
    L("  %cmp_p2 = getelementptr i8, i8* %cmp_op_s, i64 1")
    L("  %cmp_c2 = load i8, i8* %cmp_p2")
    L("  %cmp_is_le = icmp eq i8 %cmp_c2, 61")
    L("  br i1 %cmp_is_le, label %do_le, label %do_lt")
    L("do_lt:")
    L("  %lt_r = fcmp olt double %cmp_lf, %cmp_rf")
    L("  %lt_i = zext i1 %lt_r to i64")
    L("  %lt_v = call %ETValue* @etpl_val_new_int(i64 %lt_i)")
    L("  ret %ETValue* %lt_v")
    L("do_le:")
    L("  %le_r = fcmp ole double %cmp_lf, %cmp_rf")
    L("  %le_i = zext i1 %le_r to i64")
    L("  %le_v = call %ETValue* @etpl_val_new_int(i64 %le_i)")
    L("  ret %ETValue* %le_v")
    L("cmp_gt_group:")
    L("  %cmp_is_gt = icmp eq i32 %cmp_op_ci, 62")
    L("  br i1 %cmp_is_gt, label %cmp_gt_sub, label %cmp_eq_group")
    L("cmp_gt_sub:")
    L("  %cmp_g2 = getelementptr i8, i8* %cmp_op_s, i64 1")
    L("  %cmp_gc2 = load i8, i8* %cmp_g2")
    L("  %cmp_is_ge = icmp eq i8 %cmp_gc2, 61")
    L("  br i1 %cmp_is_ge, label %do_ge, label %do_gt")
    L("do_gt:")
    L("  %gt_r = fcmp ogt double %cmp_lf, %cmp_rf")
    L("  %gt_i = zext i1 %gt_r to i64")
    L("  %gt_v = call %ETValue* @etpl_val_new_int(i64 %gt_i)")
    L("  ret %ETValue* %gt_v")
    L("do_ge:")
    L("  %ge_r = fcmp oge double %cmp_lf, %cmp_rf")
    L("  %ge_i = zext i1 %ge_r to i64")
    L("  %ge_v = call %ETValue* @etpl_val_new_int(i64 %ge_i)")
    L("  ret %ETValue* %ge_v")
    L("cmp_eq_group:")
    L("  %cmp_is_eq = icmp eq i32 %cmp_op_ci, 61")
    L("  br i1 %cmp_is_eq, label %do_eq, label %do_ne")
    L("do_eq:")
    L("  %eq_r = fcmp oeq double %cmp_lf, %cmp_rf")
    L("  %eq_i = zext i1 %eq_r to i64")
    L("  %eq_v = call %ETValue* @etpl_val_new_int(i64 %eq_i)")
    L("  ret %ETValue* %eq_v")
    L("do_ne:")
    L("  %ne_r = fcmp one double %cmp_lf, %cmp_rf")
    L("  %ne_i = zext i1 %ne_r to i64")
    L("  %ne_v = call %ETValue* @etpl_val_new_int(i64 %ne_i)")
    L("  ret %ETValue* %ne_v")
    L("")
    L("eval_sov_call:")
    L("  %sc_body = call %ETASTNode* @etpl_ast_get_body(%ETASTNode* %node)")
    L("  %sc_val = call %ETValue* @etpl_eval(%ETASTNode* %sc_body, %ETEnv* %env)")
    L("  call void @etpl_val_println(%ETValue* %sc_val)")
    L("  ret %ETValue* %sc_val")
    L("}")
    L("")
    L("; etpl_math_op: ET-derived arithmetic on ETValues")
    L("define %ETValue* @etpl_math_op(%ETValue* %lv, %ETValue* %rv, i8* %op) nounwind {")
    L("entry:")
    L("  %lf = call double @etpl_val_to_float(%ETValue* %lv)")
    L("  %rf = call double @etpl_val_to_float(%ETValue* %rv)")
    L("  %op_ch = load i8, i8* %op")
    L("  %op_i = zext i8 %op_ch to i32")
    L("  ; + = 43, - = 45, * = 42, / = 47, % = 37")
    L("  %is_add = icmp eq i32 %op_i, 43")
    L("  br i1 %is_add, label %do_add, label %chk_sub")
    L("do_add:")
    L("  %add_r = fadd double %lf, %rf")
    L("  %add_v = call %ETValue* @etpl_val_new_float(double %add_r)")
    L("  ret %ETValue* %add_v")
    L("chk_sub:")
    L("  %is_sub = icmp eq i32 %op_i, 45")
    L("  br i1 %is_sub, label %do_sub, label %chk_mul")
    L("do_sub:")
    L("  %sub_r = fsub double %lf, %rf")
    L("  %sub_v = call %ETValue* @etpl_val_new_float(double %sub_r)")
    L("  ret %ETValue* %sub_v")
    L("chk_mul:")
    L("  %is_mul = icmp eq i32 %op_i, 42")
    L("  br i1 %is_mul, label %do_mul, label %chk_div")
    L("do_mul:")
    L("  %mul_r = fmul double %lf, %rf")
    L("  %mul_v = call %ETValue* @etpl_val_new_float(double %mul_r)")
    L("  ret %ETValue* %mul_v")
    L("chk_div:")
    L("  %is_div = icmp eq i32 %op_i, 47")
    L("  br i1 %is_div, label %do_div, label %chk_mod")
    L("do_div:")
    L("  %div_r = fdiv double %lf, %rf")
    L("  %div_v = call %ETValue* @etpl_val_new_float(double %div_r)")
    L("  ret %ETValue* %div_v")
    L("chk_mod:")
    L("  %is_mod = icmp eq i32 %op_i, 37")
    L("  br i1 %is_mod, label %do_mod, label %chk_pow")
    L("do_mod:")
    L("  %mod_r = call double @fmod(double %lf, double %rf)")
    L("  %mod_v = call %ETValue* @etpl_val_new_float(double %mod_r)")
    L("  ret %ETValue* %mod_v")
    L("chk_pow:")
    L("  ; ** starts with * (42), check second char")
    L("  %op_p2 = getelementptr i8, i8* %op, i64 1")
    L("  %op_c2 = load i8, i8* %op_p2")
    L("  %op_c2i = zext i8 %op_c2 to i32")
    L("  %is_pow = icmp eq i32 %op_c2i, 42")
    L("  br i1 %is_pow, label %do_pow, label %do_default")
    L("do_pow:")
    L("  %pow_r = call double @pow(double %lf, double %rf)")
    L("  %pow_v = call %ETValue* @etpl_val_new_float(double %pow_r)")
    L("  ret %ETValue* %pow_v")
    L("do_default:")
    L("  %def_v = call %ETValue* @etpl_val_new_float(double %lf)")
    L("  ret %ETValue* %def_v")
    L("}")
    L("")
}
D emit_s2_handlers = λ self, L, S, G, is_win . {
    // Emit the real interpret, compile, translate, repl handlers.      These replace the Stage 1 stubs.     ET Form: P(file) ∘
    P manifold__interp_ok_n__interp_ok_nb = S("s2_interp_ok", "  [ETPL Native] Interpreting: %s\n")  // manifold [interp_ok_n, interp_ok_nb] := S("s2_interp_ok", "  [ETPL Native] Interpreting: %s\n")
    P manifold__interp_done_n__interp_done_nb = S("s2_interp_done", "  [ETPL Native] Interpretation complete.\n")  // manifold [interp_done_n, interp_done_nb] := S("s2_interp_done", "  [ETPL Native] Interpretation complete.\n")
    P manifold__no_file_n__no_file_nb = S("s2_no_file", "  [ETPL Native] Error: No file specified.\n  Usage: interpret <file.pdt>\n")  // manifold [no_file_n, no_file_nb] := S("s2_no_file", "  [ETPL Native] Error: No file specified.\n  Usage: interpret <file.pdt>\n")
    P manifold__repl_banner_n__repl_banner_nb = S("s2_repl_banner", "\n  ETPL REPL (Native Binary) — Expression evaluator\n  Type expressions. sovereign_print ∘ \"hello\" to print.\n  Type .quit to exit REPL.\n\n")  // manifold [repl_banner_n, repl_banner_nb] := S("s2_repl_banner", "\n  ETPL REPL (Native Binary) — Expression evaluator\n  Type expressions. sovereign_print ∘ \"hello\" to print.\n  Type .quit to exit REPL.\n\n")
    P manifold__repl_prompt_n__repl_prompt_nb = S("s2_repl_prompt", "etpl>> ")  // manifold [repl_prompt_n, repl_prompt_nb] := S("s2_repl_prompt", "etpl>> ")
    P manifold__repl_quit_n__repl_quit_nb = S("s2_repl_quit", ".quit")  // manifold [repl_quit_n, repl_quit_nb] := S("s2_repl_quit", ".quit")
    P manifold__repl_result_n__repl_result_nb = S("s2_repl_result", "  => ")  // manifold [repl_result_n, repl_result_nb] := S("s2_repl_result", "  => ")
    P const_names_and_vals = manifold [manifold ["MANIFOLD_SYMMETRY", 12], manifold ["BASE_VARIANCE", (-1)], manifold ["KOIDE_RATIO", (-2)], manifold ["True", 1], manifold ["False", 0]]
    T loop = ∞ (
        P manifold__cname = const_names_and_vals[_loop_index]  // manifold [cname, _]
        S("s2_const_" + cname, cname)
    ) (D |const_names_and_vals|)
    L("; --- Stage 2: Setup builtin environment ---")
    L("define %ETEnv* @etpl_setup_builtins() nounwind {")
    L("entry:")
    L("  %env = call %ETEnv* @etpl_env_new(%ETEnv* null)")
    P manifold__ms_n__ms_nb = S("s2_const_MANIFOLD_SYMMETRY", "MANIFOLD_SYMMETRY")  // manifold [ms_n, ms_nb] := S("s2_const_MANIFOLD_SYMMETRY", "MANIFOLD_SYMMETRY")
    L("  %ms_name = " + G(ms_n, ms_nb))
    L("  %ms_val = call %ETValue* @etpl_val_new_int(i64 12)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %ms_name, %ETValue* %ms_val)")
    P manifold__true_n__true_nb = S("s2_const_True", "True")  // manifold [true_n, true_nb] := S("s2_const_True", "True")
    L("  %true_name = " + G(true_n, true_nb))
    L("  %true_val = call %ETValue* @etpl_val_new_int(i64 1)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %true_name, %ETValue* %true_val)")
    P manifold__false_n__false_nb = S("s2_const_False", "False")  // manifold [false_n, false_nb] := S("s2_const_False", "False")
    L("  %false_name = " + G(false_n, false_nb))
    L("  %false_val = call %ETValue* @etpl_val_new_int(i64 0)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %false_name, %ETValue* %false_val)")
    P manifold__none_n__none_nb = S("s2_const_None", "None")  // manifold [none_n, none_nb] := S("s2_const_None", "None")
    L("  %none_name = " + G(none_n, none_nb))
    L("  %none_val = call %ETValue* @etpl_val_new_none()")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %none_name, %ETValue* %none_val)")
    P manifold__pi_name_n__pi_name_nb = S("s2_const_pi", "pi")  // manifold [pi_name_n, pi_name_nb] := S("s2_const_pi", "pi")
    L("  %pi_name = " + G(pi_name_n, pi_name_nb))
    L("  %pi_val = call %ETValue* @etpl_val_new_float(double 0x400921FB54442D18)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %pi_name, %ETValue* %pi_val)")
    P manifold__e_name_n__e_name_nb = S("s2_const_e", "e")  // manifold [e_name_n, e_name_nb] := S("s2_const_e", "e")
    L("  %e_name = " + G(e_name_n, e_name_nb))
    L("  %e_val = call %ETValue* @etpl_val_new_float(double 0x4005BF0A8B145769)")
    L("  call void @etpl_env_set(%ETEnv* %env, i8* %e_name, %ETValue* %e_val)")
    L("  ret %ETEnv* %env")
    L("}")
    L("")
    L("; etpl_interpret_file: P(file) ∘ D(ETPL grammar) ∘ T(eval) = E(result)")
    L("define void @etpl_interpret_file(i8* %path) nounwind {")
    L("entry:")
    L("  %msg = " + G(interp_ok_n, interp_ok_nb))
    L("  call i32 (i8*, ...) @printf(i8* %msg, i8* %path)")
    L("  %source = call i8* @etpl_read_file(i8* %path)")
    L("  %src_null = icmp eq i8* %source, null")
    L("  br i1 %src_null, label %fail, label %tokenize")
    L("fail:")
    L("  ret void")
    L("tokenize:")
    L("  %tok_count_ptr = alloca i32")
    L("  %tokens = call %ETToken* @etpl_tokenize(i8* %source, i32* %tok_count_ptr)")
    L("  %tok_count = load i32, i32* %tok_count_ptr")
    L("  ; Parse")
    L("  %ast = call %ETASTNode* @etpl_parse_program_impl(%ETToken* %tokens, i32 %tok_count)")
    L("  ; Create environment with builtins")
    L("  %env = call %ETEnv* @etpl_setup_builtins()")
    L("  ; Evaluate")
    L("  %result = call %ETValue* @etpl_eval(%ETASTNode* %ast, %ETEnv* %env)")
    L("  %done_msg = " + G(interp_done_n, interp_done_nb))
    L("  call i32 (i8*, ...) @printf(i8* %done_msg)")
    L("  ; Cleanup")
    L("  call void @free(i8* %source)")
    L("  ret void")
    L("}")
    L("")
    L("; etpl_do_interpret with file argument from CLI buffer")
    L("define void @etpl_do_interpret_s2(i8* %buf) nounwind {")
    L("entry:")
    L("  ; buf contains the full command line, e.g. \"interpret test.pdt\"")
    L("  ; Find the first space to extract the filename")
    L("  %space = call i8* @strchr(i8* %buf, i32 32)")
    L("  %has_file = icmp ne i8* %space, null")
    L("  br i1 %has_file, label %extract, label %no_file")
    L("no_file:")
    L("  %nf = " + G(no_file_n, no_file_nb))
    L("  call i32 (i8*, ...) @printf(i8* %nf)")
    L("  ret void")
    L("extract:")
    L("  ; Skip the space")
    L("  %file_ptr = getelementptr i8, i8* %space, i64 1")
    L("  ; Skip any leading spaces")
    L("  %file_ch = load i8, i8* %file_ptr")
    L("  %file_empty = icmp eq i8 %file_ch, 0")
    L("  br i1 %file_empty, label %no_file, label %do_interpret")
    L("do_interpret:")
    L("  call void @etpl_interpret_file(i8* %file_ptr)")
    L("  ret void")
    L("}")
    L("")
    L("; etpl_do_repl: Read-Eval-Print Loop (Stage 2)")
    L("define void @etpl_do_repl_s2() nounwind {")
    L("entry:")
    L("  %banner = " + G(repl_banner_n, repl_banner_nb))
    L("  call i32 (i8*, ...) @printf(i8* %banner)")
    L("  %env = call %ETEnv* @etpl_setup_builtins()")
    L("  %buf = alloca [4096 x i8]")
    L("  %buf_ptr = getelementptr inbounds [4096 x i8], [4096 x i8]* %buf, i64 0, i64 0")
    T cond = → if is_win → L("  %stdin_repl = call i8* @__acrt_iob_func(i32 0)")
    → E P
        L("  %stdin_gv_repl = load i8*, i8** @stdin")
        L("  %stdin_repl = bitcast i8* %stdin_gv_repl to i8*")
    L("  br label %repl_loop")
    L("")
    L("repl_loop:")
    L("  %prompt = " + G(repl_prompt_n, repl_prompt_nb))
    L("  call i32 (i8*, ...) @printf(i8* %prompt)")
    L("  call i32 @fflush(i8* null)")
    L("  %r_result = call i8* @fgets(i8* %buf_ptr, i32 4096, i8* %stdin_repl)")
    L("  %r_eof = icmp eq i8* %r_result, null")
    L("  br i1 %r_eof, label %repl_done, label %repl_process")
    L("repl_process:")
    L("  call void @strip_newline(i8* %buf_ptr)")
    L("  %r_len = call i64 @strlen(i8* %buf_ptr)")
    L("  %r_empty = icmp eq i64 %r_len, 0")
    L("  br i1 %r_empty, label %repl_loop, label %repl_check_quit")
    L("repl_check_quit:")
    L("  %quit_s = " + G(repl_quit_n, repl_quit_nb))
    L("  %quit_cmp = call i32 @strcmp(i8* %buf_ptr, i8* %quit_s)")
    L("  %is_quit = icmp eq i32 %quit_cmp, 0")
    L("  br i1 %is_quit, label %repl_done, label %repl_eval")
    L("repl_eval:")
    L("  ; Tokenize the line")
    L("  %r_tcnt_ptr = alloca i32")
    L("  %r_tokens = call %ETToken* @etpl_tokenize(i8* %buf_ptr, i32* %r_tcnt_ptr)")
    L("  %r_tcnt = load i32, i32* %r_tcnt_ptr")
    L("  ; Parse")
    L("  %r_ast = call %ETASTNode* @etpl_parse_program_impl(%ETToken* %r_tokens, i32 %r_tcnt)")
    L("  ; Eval")
    L("  %r_val = call %ETValue* @etpl_eval(%ETASTNode* %r_ast, %ETEnv* %env)")
    L("  ; Print result")
    L("  %r_tag = call i32 @etpl_val_get_tag(%ETValue* %r_val)")
    L("  %r_is_none = icmp eq i32 %r_tag, 0")
    L("  br i1 %r_is_none, label %repl_loop, label %repl_print")
    L("repl_print:")
    L("  %r_prefix = " + G(repl_result_n, repl_result_nb))
    L("  call i32 (i8*, ...) @printf(i8* %r_prefix)")
    L("  call void @etpl_val_println(%ETValue* %r_val)")
    L("  br label %repl_loop")
    L("repl_done:")
    L("  ret void")
    L("}")
    L("")
}