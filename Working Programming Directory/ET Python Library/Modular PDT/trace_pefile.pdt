                    // break
                D stringfileinfo_struct_D_Key = stringfileinfo_string  // stringfileinfo_struct D Key := stringfileinfo_string
                finfo D append(stringfileinfo_struct)
                T cond = → if (stringfileinfo_string && stringfileinfo_string D startswith(b'StringFileInfo')) → P
                    T cond = → if (stringfileinfo_struct D Type == manifold [0, 1] && stringfileinfo_struct D ValueLength == 0) → P
                        P stringtable_offset = self D dword_align(((stringfileinfo_offset + stringfileinfo_struct D sizeof(P)) + (2 * (len(stringfileinfo_string) + 1))), version_struct D OffsetToData)
                        D stringfileinfo_struct_D_StringTable = manifold []  // stringfileinfo_struct D StringTable := manifold []
                        T while_loop = ∞ (
                            T check = → if 1 → P  // while body follows
