        P load = P  // [ET:callable:plistlib.load]
        // @ETPL:preload dump plistlib.dump
        P dump = P  // [ET:callable:plistlib.dump]
        // @ETPL:preload loads plistlib.loads
        P loads = P  // [ET:callable:plistlib.loads]
        // @ETPL:preload dumps plistlib.dumps
        P dumps = P  // [ET:callable:plistlib.dumps]
        // @ETPL:preload UID plistlib.UID
        P UID = P  // [ET:callable:plistlib.UID]
    → E ImportError (_)
        → P
    T scope_f = → open(fn, "rb")
