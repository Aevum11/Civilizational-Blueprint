D net_if_addrs = λ  . {
    // Return the addresses associated to each NIC (network interface     card) installed on the system as a dictionary whose k
    P rawlist = _psplatform D net_if_addrs(P)
    rawlist D sort(manifold ["key", λ x . x[1]])
    P ret = collections D defaultdict(list)
    T loop = ∞ (
        P manifold__name__fam__addr__mask__broadcast__ptp = rawlist[_loop_index]  // manifold [name, fam, addr, mask, broadcast, ptp]
        T attempt = → P  // try
            P fam = socket D AddressFamily(fam)
        → E ValueError (_)
            T cond = → if (WINDOWS && fam == (-1)) → P fam = _psplatform D AF_LINK
            → E T cond = → if (hasattr(_psplatform, "AF_LINK") && fam == _psplatform D AF_LINK) → P fam = _psplatform D AF_LINK
        T cond = → if fam == _psplatform D AF_LINK → P
            P separator = if POSIX → ":" → E "-"
            T while_loop = ∞ (
                T check = → if addr D count(separator) < 5 → P  // while body follows
                    P addr = addr + separator + "00"
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        P nt = _ntp D snicaddr(fam, addr, mask, broadcast, ptp)
        T cond = → if (WINDOWS && fam == manifold [socket D AF_INET, socket D AF_INET6]) → P
            T attempt = → P  // try
                P broadcast = _common D broadcast_addr(nt)
            → E Exception (err)
                debug(err)
        ret[name] D append(nt)
    ) (D |rawlist|)
    → dict(ret)
}
