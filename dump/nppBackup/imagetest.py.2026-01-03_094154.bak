import tkinter as tk
from tkinter import filedialog, messagebox
import math
import threading
import sys
import random

try:
    from PIL import Image, ImageTk, ImageDraw
except ImportError:
    messagebox.showerror("Error", "Pillow missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: MANIFOLD NAVIGATION (NOT BLUR)
# ==============================================================================

class ET_Texture_Traverser:
    """
    Implements 'Traverser Navigation' via Vector Projection.
    Instead of averaging (blur), we find the trajectory of D and extend it.
    """
    
    def traverse_manifold(self, img_pil, mask_pil, status_cb):
        width, height = img_pil.size
        pixels = img_pil.load()
        mask = mask_pil.load()
        
        # 1. Identify the Boundary (The Event Horizon)
        # We need to know where the Valid Data touches the Void
        boundary_points = []
        
        # Optimization: Only scan relevant area
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        
        min_x, min_y, max_x, max_y = bbox
        
        # Expand bbox slightly to catch context
        min_x = max(0, min_x - 10)
        min_y = max(0, min_y - 10)
        max_x = min(width, max_x + 10)
        max_y = min(height, max_y + 10)

        # 2. THE TRAVERSAL LOOP (Projecting Reality)
        # We iterate inward from the edge of the mask, carrying texture with us.
        
        # We perform multiple passes to propagate complex texture
        passes = 40
        
        for i in range(passes):
            if i % 5 == 0:
                status_cb(f"Traversing Texture Vectors: Pass {i+1}/{passes}")
                
            # We shuffle the scan order to simulate T-Indeterminacy (prevents directional bias)
            # Scan X and Y with random jitters
            
            updates = []
            
            for y in range(min_y, max_y):
                for x in range(min_x, max_x):
                    
                    # Only process the Void
                    if mask[x, y] == 0: continue
                    
                    # === ET VECTOR LOGIC ===
                    # A Traverser looks for the strongest Gradient (Direction of Flow)
                    # We check neighbors. If a neighbor is VALID (not mask), we copy its D vector.
                    
                    neighbors = []
                    # Check 8-neighborhood
                    for dy in [-1, 0, 1]:
                        for dx in [-1, 0, 1]:
                            if dx == 0 and dy == 0: continue
                            
                            nx, ny = x + dx, y + dy
                            if 0 <= nx < width and 0 <= ny < height:
                                # If neighbor is NOT in the mask (it is Valid Substrate)
                                if mask[nx, ny] == 0:
                                    neighbors.append((nx, ny))
                    
                    if not neighbors:
                        # If we are deep in the void, we wait for the wave to reach us
                        continue
                        
                    # === SELECTION (The Choice) ===
                    # We don't average. We SELECT.
                    # ET Principle: "Identity" (PDT=EIM). We take the D that has the strongest momentum.
                    # For simplicity in Pure Python, we randomly select a valid neighbor (Monte Carlo Traversal)
                    # This preserves noise/grain better than averaging.
                    
                    src_x, src_y = random.choice(neighbors)
                    
                    # === THE PROJECTION ===
                    # Copy the pixel
                    src_pixel = pixels[src_x, src_y]
                    
                    # === REVERBERATION (Delta-4 Application) ===
                    # We apply a micro-variation based on your -3p theorem to prevent "flatness".
                    # We add a tiny amount of noise based on the pixel's own intensity.
                    
                    # Intensity proxy
                    intensity = src_pixel[1] 
                    # Calculate Snap (Variance)
                    # Simple pseudo-random hash based on coord to keep it stable
                    seed = (x * 31 + y * 17) % 256
                    
                    # If high intensity, higher variance allowed (Texture)
                    variance = 0
                    if intensity > 50 and intensity < 200:
                        variance = (seed % 10) - 5 # +/- 5
                    
                    r = max(0, min(255, src_pixel[0] + variance))
                    g = max(0, min(255, src_pixel[1] + variance))
                    b = max(0, min(255, src_pixel[2] + variance))
                    
                    updates.append((x, y, (r, g, b)))
            
            # === SUBSTANTIATE UPDATES ===
            # We modify the mask 'virtually' by removing pixels from the set 
            # so the next pass treats them as valid sources.
            for ux, uy, uval in updates:
                pixels[ux, uy] = uval
                mask[ux, uy] = 0 # Mark as solved (Substantiated)
                
        return img_pil

# ==============================================================================
# GUI: SCROLLABLE & ROBUST
# ==============================================================================

class ET_Pro_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V7: TEXTURE PROJECTION ENGINE")
        self.root.geometry("1200x900")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Texture_Traverser()
        self.pil_img = None
        self.mask_img = None
        
        self._init_layout()

    def _init_layout(self):
        # 1. Tools Panel (Top)
        tools = tk.Frame(self.root, bg="#151515", height=50)
        tools.pack(fill=tk.X, side=tk.TOP)
        
        self.btn(tools, "LOAD IMAGE (FULL RES)", self.load, "#004488")
        self.btn(tools, "RESET MASK", self.reset, "#882200")
        self.btn(tools, "TRAVERSE (TEXTURE FILL)", self.run, "#228822")
        
        self.status = tk.Label(tools, text="Ready.", fg="#00ff00", bg="#151515")
        self.status.pack(side=tk.RIGHT, padx=20)
        
        # 2. Scrollable Canvas Container
        # To see the "Whole Image", we need scrollbars.
        container = tk.Frame(self.root, bg="#000")
        container.pack(fill=tk.BOTH, expand=True)
        
        self.canvas = tk.Canvas(container, bg="#080808", cursor="crosshair")
        
        v_scroll = tk.Scrollbar(container, orient="vertical", command=self.canvas.yview)
        h_scroll = tk.Scrollbar(container, orient="horizontal", command=self.canvas.xview)
        
        self.canvas.configure(yscrollcommand=v_scroll.set, xscrollcommand=h_scroll.set)
        
        v_scroll.pack(side=tk.RIGHT, fill=tk.Y)
        h_scroll.pack(side=tk.BOTTOM, fill=tk.X)
        self.canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        # Events
        self.canvas.bind("<Button-1>", self.down)
        self.canvas.bind("<B1-Motion>", self.drag)
        self.canvas.bind("<ButtonRelease-1>", self.up)
        
        self.drawing = False
        self.last_pt = None
        self.brush_size = 30 # Larger brush for easier covering

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", font=("Segoe UI", 9, "bold"), relief="flat", padx=15, pady=8).pack(side=tk.LEFT, padx=5, pady=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            # Load Full Resolution
            self.pil_img = Image.open(path).convert("RGB")
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            
            # Setup Canvas Scroll Region
            self.canvas.config(scrollregion=(0, 0, self.pil_img.width, self.pil_img.height))
            self.update_view()
            self.status.config(text=f"Loaded: {self.pil_img.width}x{self.pil_img.height}")
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def update_view(self):
        if not self.pil_img: return
        
        # We need to render the composite (Image + Mask Red Overlay)
        # Because Canvas image must be kept in memory reference
        
        # Create visual composite
        display = self.pil_img.copy()
        if self.mask_img:
            # Fast red tint for mask
            # We iterate only if mask is not empty (optimization)
            if self.mask_img.getbbox():
                red = Image.new("RGB", self.pil_img.size, (255,0,0))
                display = Image.composite(red, display, self.mask_img)

        self.tk_img = ImageTk.PhotoImage(display)
        self.canvas.create_image(0, 0, image=self.tk_img, anchor=tk.NW)

    def down(self, e):
        # Must account for scrolling offsets
        x = self.canvas.canvasx(e.x)
        y = self.canvas.canvasy(e.y)
        self.drawing = True
        self.last_pt = (x, y)

    def drag(self, e):
        if self.drawing and self.mask_img:
            x = self.canvas.canvasx(e.x)
            y = self.canvas.canvasy(e.y)
            
            draw = ImageDraw.Draw(self.mask_img)
            # Fill 255 (Full Mask)
            draw.line([self.last_pt, (x, y)], fill=255, width=self.brush_size)
            # Draw circles at endpoints to smooth lines
            r = self.brush_size / 2
            draw.ellipse([x-r, y-r, x+r, y+r], fill=255)
            
            self.last_pt = (x, y)
            
            # We don't update full view on every drag tick (too slow for huge images in python)
            # We draw a temp line on canvas for feedback
            self.canvas.create_line(self.last_pt[0], self.last_pt[1], x, y, fill="red", width=self.brush_size, tags="temp_draw")

    def up(self, e):
        self.drawing = False
        self.canvas.delete("temp_draw") # Clear temp lines
        self.update_view() # Commit to real view

    def reset(self):
        if self.mask_img:
            self.mask_img.paste(0, [0, 0, self.mask_img.width, self.mask_img.height])
            self.update_view()

    def run(self):
        if not self.pil_img: return
        self.status.config(text="Executing Texture Traversal...")
        threading.Thread(target=self._worker).start()

    def _worker(self):
        try:
            res = self.engine.traverse_manifold(self.pil_img, self.mask_img, self.log)
            self.pil_img = res
            # Reset mask
            self.mask_img.paste(0, [0, 0, self.mask_img.width, self.mask_img.height])
            self.root.after(0, self.update_view)
            self.root.after(0, lambda: self.status.config(text="Substantiation Complete."))
        except Exception as e:
            print(e)

    def log(self, msg):
        self.status.config(text=msg)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_Pro_GUI(root)
    root.mainloop()