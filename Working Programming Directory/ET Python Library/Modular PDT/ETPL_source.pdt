    D ETMathV2__et_modulo = λ a, b . {
        // ET modulo: remainder after D-bounded division traversal.         Derived from T-traversal remainder: T navigates a in st
        T cond = → if b == 0 → → 0
        T cond = → if (isinstance(a, float) || isinstance(b, float)) → → (a - (b * ETMathNative D et_floor((a / b))))
        → (a % b)
    }
    D ETMathV2__et_integer_divide = λ a, b . {
