import kotlin.math.abs

class OmniMeasureService : Service(), SensorEventListener {

    enum class ScanMode { BATTERY_SAVER, LEVEL_STABILITY, VIBRATION_MONITOR, NOISE_SCANNER, LIGHT_METER, WEATHER_MONITOR }
    data class LogEntry(val time: Long, val result: OmniTraverserEngine.SubstantiatedResult)

    inner class LocalBinder : Binder() { fun getService(): OmniMeasureService = this@OmniMeasureService }

    private val binder = LocalBinder()
    private lateinit var sensorManager: SensorManager
    private val etEngine = OmniTraverserEngine()
    private lateinit var prefs: SharedPreferences
    private lateinit var windowManager: WindowManager

    private val _lastResult = AtomicReference<OmniTraverserEngine.SubstantiatedResult>()
    val lastResult: OmniTraverserEngine.SubstantiatedResult? get() = _lastResult.get()

    private val dataLog = ConcurrentLinkedQueue<LogEntry>()

    var currentMode = ScanMode.LEVEL_STABILITY
    var sessionStartTime: Long = 0
    private var startBatteryLevel: Int = 0
    var batteryDrainRate: Double = 0.0
    var batteryTemp: Float = 0.0f
    
    private var isThrottled = false
    private var throttleCounter = 0L
    private val deviceKey = Build.MODEL.replace(" ", "_")
    private var isRunning = false
    
    private var serviceJob: Job? = null
    private val serviceScope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    private lateinit var sensorThread: HandlerThread
    private lateinit var sensorHandler: Handler
    private var wakeLock: PowerManager.WakeLock? = null
    
    private val audioLock = Any()
    private var audioRecord: AudioRecord? = null
    private var currentAudioBuffer: ShortArray? = null
    private var detectedSampleRate = 16000
    private var detectedBufferSize = 0

    var calibrationStatus = "Ready"

    override fun onBind(intent: Intent): IBinder = binder

    override fun onCreate() {
        super.onCreate()
        sensorManager = getSystemService(Context.SENSOR_SERVICE) as SensorManager
        windowManager = getSystemService(Context.WINDOW_SERVICE) as WindowManager
        prefs = getSharedPreferences("ET_Prefs", Context.MODE_PRIVATE)
        
        sensorThread = HandlerThread("ET_Sensor_Thread", Process.THREAD_PRIORITY_MORE_FAVORABLE)
        sensorThread.start()
        sensorHandler = Handler(sensorThread.looper)

        loadCalibration()
        createNotificationChannel()
        val modeIdx = prefs.getInt("last_mode_$deviceKey", ScanMode.LEVEL_STABILITY.ordinal)
        currentMode = ScanMode.values().getOrElse(modeIdx) { ScanMode.LEVEL_STABILITY }
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent?.action == "STOP_SERVICE") { stopMeasurement(); stopForeground(true); stopSelf() }
        return START_NOT_STICKY
    }

    fun startMeasurement(mode: ScanMode) {
        stopMeasurement()
        isRunning = true; currentMode = mode
        prefs.edit().putInt("last_mode_$deviceKey", mode.ordinal).apply()
        sessionStartTime = System.currentTimeMillis()
        startBatteryLevel = getBatteryStats().level
        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
        wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "ET:ScanLock")
        wakeLock?.acquire(12*60*60*1000L)
        startForeground(1, buildNotification("ET Active: $mode", "v10.2-Verified"))
        registerSensorsForMode(mode)
        if (mode == ScanMode.NOISE_SCANNER || mode == ScanMode.VIBRATION_MONITOR) startAudioLoop()
    }
    
    private fun registerSensorsForMode(mode: ScanMode) {
        sensorManager.unregisterListener(this)
        val delay = when(mode) {
            ScanMode.BATTERY_SAVER, ScanMode.LIGHT_METER, ScanMode.WEATHER_MONITOR -> SensorManager.SENSOR_DELAY_NORMAL
            ScanMode.LEVEL_STABILITY, ScanMode.NOISE_SCANNER -> SensorManager.SENSOR_DELAY_UI
            else -> SensorManager.SENSOR_DELAY_GAME
        }
        val accel = sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
        sensorManager.registerListener(this, accel, delay, sensorHandler)
        
        if (mode == ScanMode.VIBRATION_MONITOR || mode == ScanMode.LEVEL_STABILITY || mode == ScanMode.WEATHER_MONITOR) {
            val mag = sensorManager.getDefaultSensor(Sensor.TYPE_MAGNETIC_FIELD)
            if (mag != null) sensorManager.registerListener(this, mag, delay, sensorHandler)
            
            if (mode != ScanMode.WEATHER_MONITOR) {
                val gyro = sensorManager.getDefaultSensor(Sensor.TYPE_GYROSCOPE)
                sensorManager.registerListener(this, gyro, delay, sensorHandler)
            }
        }
        
        val light = sensorManager.getDefaultSensor(Sensor.TYPE_LIGHT)
        if (light != null && (mode == ScanMode.LIGHT_METER || mode == ScanMode.LEVEL_STABILITY || mode == ScanMode.WEATHER_MONITOR)) {
            sensorManager.registerListener(this, light, delay, sensorHandler)
        }
        val pressure = sensorManager.getDefaultSensor(Sensor.TYPE_PRESSURE)
        if (pressure != null) sensorManager.registerListener(this, pressure, delay, sensorHandler)
        
        val temp = sensorManager.getDefaultSensor(Sensor.TYPE_AMBIENT_TEMPERATURE)
        if (temp != null) {
            sensorManager.registerListener(this, temp, SensorManager.SENSOR_DELAY_NORMAL, sensorHandler)
        }
    }

    fun stopMeasurement() {
        isRunning = false; serviceJob?.cancel()
        try { sensorManager.unregisterListener(this) } catch (e: Exception) {}
        stopAudio()
        try { if (wakeLock?.isHeld == true) wakeLock?.release() } catch (e: Exception) {}
    }

    override fun onDestroy() {
        stopMeasurement(); sensorThread.quitSafely(); serviceScope.cancel()
        super.onDestroy()
    }

    private fun startAudioLoop() {
        serviceJob = serviceScope.launch(Dispatchers.IO) {
            if (audioRecord != null) stopAudio()
            if (!initAudioRecordSafe()) return@launch
            val buffer = ShortArray(detectedBufferSize)
            try {
                while (isActive && isRunning && !isThrottled) {
                    if (currentMode == ScanMode.NOISE_SCANNER) {
                        if (audioRecord?.recordingState != AudioRecord.RECORDSTATE_RECORDING) audioRecord?.startRecording()
                        val burstEnd = System.currentTimeMillis() + 5000 
                        while (System.currentTimeMillis() < burstEnd && isActive && isRunning) {
                            val read = audioRecord?.read(buffer, 0, detectedBufferSize) ?: 0
                            if (read > 0) synchronized(audioLock) { currentAudioBuffer = buffer.copyOf() }
                        }
                        audioRecord?.stop()
                        val sleepEnd = System.currentTimeMillis() + 55000
                        while (System.currentTimeMillis() < sleepEnd && isActive && isRunning && currentMode == ScanMode.NOISE_SCANNER) delay(200)
                    } else if (currentMode == ScanMode.VIBRATION_MONITOR) {
                        if (audioRecord?.recordingState != AudioRecord.RECORDSTATE_RECORDING) audioRecord?.startRecording()
                        val read = audioRecord?.read(buffer, 0, detectedBufferSize) ?: 0
                        if (read > 0) synchronized(audioLock) { currentAudioBuffer = buffer.copyOf() }
                        delay(20)
                    }
                }
            } catch (e: Exception) { e.printStackTrace() } finally { stopAudio() }
        }
    }

    private fun initAudioRecordSafe(): Boolean {
        stopAudio() 
        val rates = intArrayOf(16000, 44100, 48000, 8000)
        for (rate in rates) {
            try {
                val size = AudioRecord.getMinBufferSize(rate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
                if (size > 0) {
                    detectedSampleRate = rate; detectedBufferSize = size
                    audioRecord = AudioRecord(MediaRecorder.AudioSource.MIC, rate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, size)
                    if (audioRecord?.state == AudioRecord.STATE_INITIALIZED) return true
                    else { audioRecord?.release(); audioRecord = null }
                }
            } catch (e: Exception) { continue }
        }
        return false
    }
    
    private fun stopAudio() { 
        try { if (audioRecord?.state == AudioRecord.STATE_INITIALIZED) audioRecord?.stop(); audioRecord?.release() } 
        catch(e: Exception) {} finally { audioRecord = null }
    }

    private var lastAccel = FloatArray(3); private var lastGyro = FloatArray(3); private var lastMag = FloatArray(3)
    private var currentLux: Float? = null; private var currentPressure: Float? = null; private var currentAmbientTemp: Float? = null
    private var lastComputeTime = 0L

    override fun onSensorChanged(event: SensorEvent?) {
        event ?: return
        if (event.sensor.type == Sensor.TYPE_ACCELEROMETER) System.arraycopy(event.values, 0, lastAccel, 0, 3)
        if (event.sensor.type == Sensor.TYPE_GYROSCOPE) System.arraycopy(event.values, 0, lastGyro, 0, 3)
        if (event.sensor.type == Sensor.TYPE_MAGNETIC_FIELD) System.arraycopy(event.values, 0, lastMag, 0, 3)
        if (event.sensor.type == Sensor.TYPE_LIGHT) currentLux = event.values[0]
        if (event.sensor.type == Sensor.TYPE_PRESSURE) currentPressure = event.values[0]
        if (event.sensor.type == Sensor.TYPE_AMBIENT_TEMPERATURE) currentAmbientTemp = event.values[0]

        if (isThrottled) { throttleCounter++; if (throttleCounter % 10 != 0L) return }

        val now = System.currentTimeMillis()
        val dt = now - lastComputeTime
        val computeInterval = if(currentMode == ScanMode.BATTERY_SAVER || currentMode == ScanMode.LIGHT_METER || currentMode == ScanMode.WEATHER_MONITOR) 200 else 50 
        
        if (dt >= computeInterval) {
            var bufferToProcess: ShortArray? = null
            synchronized(audioLock) { bufferToProcess = currentAudioBuffer; currentAudioBuffer = null }
            
            val rotation = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) try { baseContext.display?.rotation ?: 0 } catch(e:Exception) {0} else @Suppress("DEPRECATION") windowManager.defaultDisplay.rotation
            
            val result = etEngine.resolveConfiguration(
                lastAccel.clone(), lastGyro.clone(), lastMag.clone(), currentPressure, currentAmbientTemp,
                bufferToProcess, currentLux, rotation, event.timestamp, detectedSampleRate
            )
            
            _lastResult.set(result)
            lastComputeTime = now
            logData(result, now)
            updateBatteryStats(now)
        }
    }

    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}

    private fun logData(result: OmniTraverserEngine.SubstantiatedResult, time: Long) {
        dataLog.add(LogEntry(time, result))
        while (dataLog.size > 5000) dataLog.poll()
    }
    
    fun tareAltitude() {
        val p = currentPressure
        if (p != null) etEngine.tareAltitude(p.toDouble())
    }
    
    fun getLogZip(context: Context): File {
        val timestamp = System.currentTimeMillis()
        val zipFile = File(context.cacheDir, "et_report_$timestamp.zip")
        val snapshot = ArrayList(dataLog)
        val dateFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US)
        val sb = StringBuilder()
        ZipOutputStream(FileOutputStream(zipFile)).use { zos ->
            zos.putNextEntry(ZipEntry("session_data.csv"))
            zos.write("Time,Hz,Shimmer,Vel_mm_s,ISO_Zone,SPL_dBA,Lux,Pressure_hPa,Alt_m,Temp_C,Freq_Hz,Label,Severity\n".toByteArray())
            snapshot.forEach { entry ->
                val r = entry.result
                val t = dateFormat.format(Date(entry.time))
                sb.setLength(0)
                sb.append(t).append(",")
                sb.append(String.format("%.1f", r.realHz)).append(",")
                sb.append(String.format("%.4f", r.shimmerIndex)).append(",")
                sb.append(String.format("%.2f", r.velocityRms)).append(",")
                sb.append(r.isoZone).append(",")
                sb.append(String.format("%.1f", r.correctedSPL)).append(",")
                sb.append(String.format("%.0f", r.illuminanceLux)).append(",")
                sb.append(String.format("%.2f", r.pressureHpa)).append(",")
                sb.append(String.format("%.1f", r.relativeAltitude)).append(",")
                sb.append(if(r.ambientTempC != null) String.format("%.1f", r.ambientTempC) else "N/A").append(",")
                sb.append(String.format("%.1f", r.dominantFreq)).append(",")
                sb.append(r.freqLabel).append(",")
                sb.append(r.faultSeverity).append("\n")
                zos.write(sb.toString().toByteArray())
            }
            zos.closeEntry()
        }
        return zipFile
    }
    
    fun getLogCsv(context: Context): File {
        val timestamp = System.currentTimeMillis()
        val csvFile = File(context.cacheDir, "et_data_$timestamp.csv")
        val snapshot = ArrayList(dataLog)
        val dateFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US)
        val sb = StringBuilder()
        FileOutputStream(csvFile).use { fos ->
            fos.write("Time,Hz,Shimmer,Vel_mm_s,ISO_Zone,SPL_dBA,Lux,Pressure_hPa,Alt_m,Temp_C,Freq_Hz,Label,Severity\n".toByteArray())
            snapshot.forEach { entry ->
                val r = entry.result
                val t = dateFormat.format(Date(entry.time))
                sb.setLength(0)
                sb.append(t).append(",")
                sb.append(String.format("%.1f", r.realHz)).append(",")
                sb.append(String.format("%.4f", r.shimmerIndex)).append(",")
                sb.append(String.format("%.2f", r.velocityRms)).append(",")
                sb.append(r.isoZone).append(",")
                sb.append(String.format("%.1f", r.correctedSPL)).append(",")
                sb.append(String.format("%.0f", r.illuminanceLux)).append(",")
                sb.append(String.format("%.2f", r.pressureHpa)).append(",")
                sb.append(String.format("%.1f", r.relativeAltitude)).append(",")
                sb.append(if(r.ambientTempC != null) String.format("%.1f", r.ambientTempC) else "N/A").append(",")
                sb.append(String.format("%.1f", r.dominantFreq)).append(",")
                sb.append(r.freqLabel).append(",")
                sb.append(r.faultSeverity).append("\n")
                fos.write(sb.toString().toByteArray())
            }
        }
        return csvFile
    }

    // --- UPLOAD (Moved to Service) ---
    // Actually, network ops can run in Service context for robustness.
    // I will add flushPendingReports to Service or keep logic centralized here.
    // Keeping logic here for simplicity, but triggered via Service/Activity interaction is fine.
    
    fun flushPendingReports(context: Context) {
        val ip = prefs.getString("server_ip", "") ?: return
        if (ip.isEmpty()) return
        
        // Secure Prefs access (need to re-init if called from service, but here we are in service)
        // Best to pass API key from Activity or re-init secure prefs.
        // For simplicity, we assume upload happens when app is foreground/active in MainActivity.
        // But for robustness, we implement basic upload loop here.
        
        val secure = try {
             val mk = MasterKey.Builder(context).setKeyScheme(MasterKey.KeyScheme.AES256_GCM).build()
             EncryptedSharedPreferences.create(
                context, "ET_Secure_Prefs", mk,
                EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
                EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM
            )
        } catch(e:Exception) { context.getSharedPreferences("ET_Secure_Prefs_Fallback", Context.MODE_PRIVATE) }
        
        val apiKey = secure.getString("api_key", "") ?: ""
        val pendingDir = File(context.filesDir, "pending_reports")
        val files = pendingDir.listFiles { _, name -> name.endsWith(".zip") } ?: return
        
        serviceScope.launch(Dispatchers.IO) {
            for (zipFile in files) {
                val descFile = File(pendingDir, zipFile.name.replace(".zip", ".txt"))
                val desc = if (descFile.exists()) descFile.readText() else ""
                var urlStr = ip
                if (!urlStr.startsWith("http")) urlStr = "https://$urlStr"
                if (!urlStr.contains("/api/v1/upload")) urlStr += "/api/v1/upload"
                
                if (uploadFile(zipFile, desc, urlStr, apiKey)) {
                    zipFile.delete(); if (descFile.exists()) descFile.delete()
                }
            }
        }
    }
    
    private fun uploadFile(file: File, description: String, urlStr: String, apiKey: String): Boolean {
        try {
            val url = URL(urlStr)
            val boundary = "Boundary-${System.currentTimeMillis()}"
            val conn = url.openConnection() as HttpURLConnection
            conn.requestMethod = "POST"; conn.doOutput = true
            conn.connectTimeout = 10000; conn.readTimeout = 30000
            conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=$boundary")
            if(apiKey.isNotEmpty()) conn.setRequestProperty("X-ET-AUTH-TOKEN", apiKey)
            val os = DataOutputStream(conn.outputStream)
            if (description.isNotEmpty()) os.writeBytes("--$boundary\r\nContent-Disposition: form-data; name=\"description\"\r\n\r\n$description\r\n")
            os.writeBytes("--$boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"${file.name}\"\r\nContent-Type: application/zip\r\n\r\n")
            file.inputStream().use { it.copyTo(os) }
            os.writeBytes("\r\n--$boundary--\r\n"); os.close()
            return conn.responseCode in 200..299
        } catch (e: Exception) { return false }
    }

    private data class BatteryStats(val level: Int, val temp: Float)
    private fun getBatteryStats(): BatteryStats {
        val intent = registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
        val level = intent?.getIntExtra(BatteryManager.EXTRA_LEVEL, -1) ?: 100
        val tempRaw = intent?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 0) ?: 0
        return BatteryStats(level, tempRaw / 10.0f)
    }

    private fun updateBatteryStats(now: Long) {
        if ((now - sessionStartTime) % 60000 < 100) {
            val stats = getBatteryStats()
            batteryTemp = stats.temp
            if (batteryTemp > 45.0f && !isThrottled) { isThrottled = true; registerSensorsForMode(ScanMode.BATTERY_SAVER) }
            else if (batteryTemp < 40.0f && isThrottled) { isThrottled = false; registerSensorsForMode(currentMode) }
            val hrs = (now - sessionStartTime) / 3600000.0
            if (hrs > 0.1) batteryDrainRate = (startBatteryLevel - stats.level) / hrs
        }
    }
    
    fun runCalibration() {
        calibrationStatus = "Calibrating..."
        serviceScope.launch {
            val samples = 50; var ax = 0.0; var ay = 0.0; var az = 0.0; var variance = 0.0
            val readingsX = DoubleArray(samples)
            for(i in 0 until samples) { readingsX[i] = lastAccel[0].toDouble(); ax += lastAccel[0]; ay += lastAccel[1]; az += lastAccel[2]; delay(20) }
            val meanX = ax / samples
            for(x in readingsX) variance += (x - meanX) * (x - meanX)
            if ((variance/samples) > 0.05) { calibrationStatus = "Failed: Moving" } 
            else {
                ax /= samples; ay /= samples; az /= samples
                prefs.edit().putFloat("cal_acc_x_$deviceKey", ax.toFloat()).putFloat("cal_acc_y_$deviceKey", ay.toFloat()).putFloat("cal_acc_z_$deviceKey", az.toFloat()).apply()
                etEngine.setCalibration(floatArrayOf(ax.toFloat(), ay.toFloat(), az.toFloat()), floatArrayOf(0f,0f,0f), 0.0)
                calibrationStatus = "Success"
            }
        }
    }

    private fun loadCalibration() {
        val ax = prefs.getFloat("cal_acc_x_$deviceKey", 0f); val ay = prefs.getFloat("cal_acc_y_$deviceKey", 0f); val az = prefs.getFloat("cal_acc_z_$deviceKey", 0f)
        val spl = prefs.getFloat("cal_spl_$deviceKey", 0f).toDouble()
        etEngine.setCalibration(floatArrayOf(ax, ay, az), floatArrayOf(0f,0f,0f), spl)
    }

    fun getDurationString(): String {
        if (sessionStartTime == 0L) return "00:00"
        val diff = System.currentTimeMillis() - sessionStartTime
        return String.format("%02d:%02d", diff/3600000, (diff/60000)%60)
    }

    private fun buildNotification(title: String, text: String): Notification {
        val pendingIntent = PendingIntent.getActivity(this, 0, Intent(this, MainActivity::class.java), PendingIntent.FLAG_IMMUTABLE)
        val builder = NotificationCompat.Builder(this, "ET_CHANNEL_ID")
            .setContentTitle(title).setContentText(text).setSmallIcon(android.R.drawable.ic_menu_compass).setContentIntent(pendingIntent)
        if (isThrottled) builder.setSubText("⚠ COOLING MODE")
        return builder.build()
    }
    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel("ET_CHANNEL_ID", "ET Scanner", NotificationManager.IMPORTANCE_LOW)
            getSystemService(NotificationManager::class.java).createNotificationChannel(channel)
        }
    }
}