D signature_bound_method = λ sig . {
    // Private helper to transform signatures for unbound     functions to bound methods.
    P params = tuple(sig D parameters D values(P))
    T cond = → if ((!params) || params[0] D kind == manifold [_VAR_KEYWORD, _KEYWORD_ONLY]) → → E ValueError("invalid method signature")
    P kind = params[0] D kind
    T cond = → if kind == manifold [_POSITIONAL_OR_KEYWORD, _POSITIONAL_ONLY] → P params = params[1:Ω]
    → E T cond = → if kind ≠ _VAR_POSITIONAL → → E ValueError("invalid argument type")
    → sig D replace(manifold ["parameters", params])
