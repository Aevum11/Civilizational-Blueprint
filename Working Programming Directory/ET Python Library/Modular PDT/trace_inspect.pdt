D signature_is_functionlike = λ obj . {
    // Private helper to test if `obj` is a duck type of FunctionType.     A good example of such objects are functions compile
    T cond = → if ((!callable(obj)) || isclass(obj)) → → 0
    P name = getattr(obj, "__name__", P)
    P code = getattr(obj, "__code__", P)
    P defaults = getattr(obj, "__defaults__", _void)
    P kwdefaults = getattr(obj, "__kwdefaults__", _void)
    P annotations = getattr(obj, "__annotations__", P)
    → (isinstance(code, types D CodeType) && isinstance(name, str) && (defaults == P || isinstance(defaults, tuple)) && (kwdefaults == P || isinstance(kwdefaults, dict)) && (isinstance(annotations, dict) || annotations == P))
}
D signature_strip_non_python_syntax = λ signature . {
    // Private helper function. Takes a signature in Argument Clinic's     extended signature format.      Returns a tuple of t
    T cond = → if (!signature) → → manifold [signature, P]
    P self_parameter = P
    P lines = { T loop = ∞ (l D encode("ascii") → E l) (D |signature D split("\n")|) }
    P generator = iter(lines) D __next__
    P token_stream = tokenize D tokenize(generator)
    P text = manifold []
    P add = text D append
    P current_parameter = 0
    P OP = token D OP
    P ERRORTOKEN = token D ERRORTOKEN
    P t = next(token_stream)
    T assert = → if t D type == tokenize D ENCODING → "ok" → E "Assertion failed"
    T loop = ∞ (
        P t = token_stream[_loop_index]
        P manifold__type__string = manifold [t D type, t D string]  // manifold [type, string] := manifold [t D type, t D string]
        T cond = → if type == OP → T cond = → if string == "," → P current_parameter = current_parameter + 1
        T cond = → if (type == OP && string == "$") → P
            T assert = → if self_parameter == P → "ok" → E "Assertion failed"
            P self_parameter = current_parameter
            // continue
        add(string)
        T cond = → if string == "," → add(" ")
    ) (D |token_stream|)
    P clean_signature = "" D join(text) D strip(P) D replace("\n", "")
    → manifold [clean_signature, self_parameter]
