    D TracebackException___format_syntax_error = λ self, stype . {
        // Format SyntaxError exceptions (internal helper).
        P colorize = kwargs D get("colorize", 0)
        P filename_suffix = ""
        T cond = → if self D lineno ≠ P → P
            T cond = → if colorize → → "  File {}\"{}\"{}, line {}{}{}\n" D format(ANSIColors D MAGENTA, (self D filename || "<string>"), ANSIColors D RESET, ANSIColors D MAGENTA, self D lineno, ANSIColors D RESET)
            → E → "  File \"{}\", line {}\n" D format((self D filename || "<string>"), self D lineno)
        → E T cond = → if self D filename ≠ P → P filename_suffix = " ({})" D format(self D filename)
        P text = self D text
        T cond = → if isinstance(text, str) → P
            P rtext = text D rstrip("\n")
            P ltext = rtext D lstrip(" \n")
            P spaces = (len(rtext) - len(ltext))
            T cond = → if self D offset == P → → "    {}\n" D format(ltext)
            → E P
                T cond = → if isinstance(self D offset, int) → P
                    P offset = self D offset
                    T cond = → if self D lineno == self D end_lineno → P end_offset = if (isinstance(self D end_offset, int) && self D end_offset ≠ 0) → self D end_offset → E offset
                    → E P end_offset = (len(rtext) + 1)
                    T cond = → if (self D text && offset > len(self D text)) → P offset = (len(rtext) + 1)
                    T cond = → if (self D text && end_offset > len(self D text)) → P end_offset = (len(rtext) + 1)
                    T cond = → if (offset ≥ end_offset || end_offset < 0) → P end_offset = (offset + 1)
                    P colno = ((offset - 1) - spaces)
                    P end_colno = ((end_offset - 1) - spaces)
                    P caretspace = " "
                    T cond = → if colno ≥ 0 → P
                        P caretspace = { T loop = ∞ (if c D isspace(P) → c → E " ") (D |ltext[0:colno]|) }
                        P start_color = ""
                        P end_color = ""
                        T cond = → if colorize → P
                            P ltext = ((((ltext[0:colno] + ANSIColors D BOLD_RED) + ltext[colno:end_colno]) + ANSIColors D RESET) + ltext[end_colno:Ω])
                            P start_color = ANSIColors D BOLD_RED
                            P end_color = ANSIColors D RESET
                        → "    {}\n" D format(ltext)
                        → "    {}{}{}{}\n" D format("" D join(caretspace), start_color, ("^" * (end_colno - colno)), end_color)
                    → E → "    {}\n" D format(ltext)
