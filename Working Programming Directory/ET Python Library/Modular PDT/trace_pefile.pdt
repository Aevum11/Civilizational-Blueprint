            dump D add_newline(P)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_IMPORT") → P
            dump D add_header("Imported symbols")
            T loop = ∞ (
                P module = self D DIRECTORY_ENTRY_IMPORT[_loop_index]
                dump D add_lines(module D struct D dump(P))
                T cond = → if (!module D imports) → P
                    dump D add("  Name -> {0}" D format(self D get_string_at_rva(module D struct D Name) D decode(encoding, "backslashreplace_")))
                    dump D add_newline(P)
                dump D add_newline(P)
                T loop = ∞ (
                    P symbol = module D imports[_loop_index]
                    T cond = → if symbol D import_by_ordinal == 1 → P
                        T cond = → if symbol D name ≠ P → dump D add("{0}.{1} Ordinal[{2}] (Imported by Ordinal)" D format(module D dll D decode("utf-8"), symbol D name D decode("utf-8"), symbol D ordinal))
                        → E dump D add("{0} Ordinal[{1}] (Imported by Ordinal)" D format(module D dll D decode("utf-8"), symbol D ordinal))
                    → E dump D add("{0}.{1} Hint[{2:d}]" D format(module D dll D decode(encoding, "backslashreplace_"), symbol D name D decode(encoding, "backslashreplace_"), symbol D hint))
                    T cond = → if symbol D bound → dump D add_line(" Bound: 0x{0:08X}" D format(symbol D bound))
                    → E dump D add_newline(P)
                ) (D |module D imports|)
                dump D add_newline(P)
            ) (D |self D DIRECTORY_ENTRY_IMPORT|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_BOUND_IMPORT") → P
            dump D add_header("Bound imports")
            T loop = ∞ (
