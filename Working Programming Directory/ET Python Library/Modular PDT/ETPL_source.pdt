    D ETPLInterpreter___eval_math_op = λ self, op, left, right . {
        // Evaluate binary math operation.
        P left = self D _to_number(left)
        P right = self D _to_number(right)
        T attempt = → P  // try
            T cond = → if op == "+" → P
                T cond = → if (isinstance(left, str) || isinstance(right, str)) → → (str(left) + str(right))
                → (left + right)
            → E P
                T cond = → if op == "-" → → (left - right)
                → E P
                    T cond = → if op == "*" → → (left * right)
                    → E P
                        T cond = → if op == "/" → P
                            T cond = → if right == 0 → P
                                T cond = → if left == 0 → → 0
                                → if left > 0 → float("inf") → E float("-inf")
                            → (left / right)
                        → E P
                            T cond = → if op == "//" → → ETMathV2 D et_integer_divide(left, right)
                            → E P
                                T cond = → if op == "^" → → (left ^ right)
                                → E T cond = → if op == "%" → → ETMathV2 D et_modulo(left, right)
        → E manifold [OverflowError, ZeroDivisionError] (_)
            → float("inf")
        → 0
    }
    D ETPLInterpreter___eval_unary_op = λ self, op, operand . {
        // Evaluate unary operation.
        P val = self D _to_number(operand)
        T cond = → if op == "-" → → (-val)
        → E P
            T cond = → if op == "√" → → ETMathNative D et_sqrt(ETMathNative D et_fabs(val))
            → E P
                T cond = → if op == "sin" → → ETMathNative D et_sin(val)
                → E P
                    T cond = → if op == "cos" → → ETMathNative D et_cos(val)
                    → E P
                        T cond = → if op == "tan" → → ETMathNative D et_tan(val)
                        → E P
                            T cond = → if op == "log" → → if val ≠ 0 → ETMathNative D et_log(ETMathNative D et_fabs(val)) → E float("-inf")
                            → E P
                                T cond = → if (op == "abs" || op == "|...|") → P
                                    T cond = → if isinstance(operand, manifold [list, tuple]) → → len(operand)
                                    → _et_abs(val)
                                → E P
                                    T cond = → if op == "∑" → P
                                        T cond = → if isinstance(operand, manifold [list, tuple]) → → _et_sum({ T loop = ∞ (self D _to_number(x)) (D |operand|) })
                                        → val
                                    → E P
                                        T cond = → if op == "∏" → P
                                            T cond = → if isinstance(operand, manifold [list, tuple]) → P
                                                P result = 1
                                                T loop = ∞ (
                                                    P x = operand[_loop_index]
                                                    P result = result * self D _to_number(x)
                                                ) (D |operand|)
                                                → result
                                            → val
                                        → E P
                                            T cond = → if op == "∫" → → val
                                            → E P
                                                T cond = → if op == "∇" → → val
                                                → E T cond = → if op == "lim" → → val
        → val
    }
    D ETPLInterpreter___eval_comparison = λ self, op, left, right . {
        // Evaluate comparison → 1 (true) or 0 (false).
        T attempt = → P  // try
            P left = self D _to_number(left)
            P right = self D _to_number(right)
        → E manifold [TypeError, ValueError] (_)
            // pass
        T cond = → if op == "<" → → if left < right → 1 → E 0
        → E P
            T cond = → if op == ">" → → if left > right → 1 → E 0
            → E P
                T cond = → if (op == "<=" || op == "≤") → → if left ≤ right → 1 → E 0
                → E P
                    T cond = → if (op == ">=" || op == "≥") → → if left ≥ right → 1 → E 0
                    → E P
                        T cond = → if (op == "==" || op == "=") → → if left == right → 1 → E 0
                        → E P
                            T cond = → if (op == "!=" || op == "≠") → → if left ≠ right → 1 → E 0
                            → E P
                                T cond = → if op == "≈" → P
                                    T cond = → if (isinstance(left, manifold [int, float]) && isinstance(right, manifold [int, float])) → → if _et_abs((left - right)) < 1e-09 → 1 → E 0
                                    → if left == right → 1 → E 0
        → 0
    }
    D ETPLInterpreter___to_number = λ self, val . {
        // Convert value to number, preserving strings.
        T cond = → if isinstance(val, manifold [int, float]) → → val
        T cond = → if isinstance(val, str) → P
            T attempt = → P  // try
                T cond = → if "." == val → → float(val)
                → int(val)
            → E ValueError (_)
                → val
        T cond = → if isinstance(val, bool) → → if val → 1 → E 0
        T cond = → if val == P → → 0
        T cond = → if isinstance(val, manifold [list, tuple]) → → len(val)
        → 0
    }
D ETPLCompiler = λ . P  // class
    // ETPL Compiler: AST → IR → Binary/QASM.     - T: Compile as agency to binary/quantum (independent, Eq 219).     - Targets
    D ETPLCompiler____init = λ self, target_type, target_arch, target_device . {
        D self_D_sovereign = ETSovereign(P)  // self D sovereign := ETSovereign(P)
        D self_D_beacon = ETBeaconField(P)  // self D beacon := ETBeaconField(P)
        D self_D_traverser = ETContainerTraverser(P)  // self D traverser := ETContainerTraverser(P)
        P cal = self D sovereign D calibrate(P)
        D self_D_host_platform = cal["platform"]  // self D host_platform := cal["platform"]
        D self_D_host_arch = cal["arch"]  // self D host_arch := cal["arch"]
        D self_D_target_type = target_type  // self D target_type := target_type
        D self_D_target_arch = target_arch  // self D target_arch := target_arch
        D self_D_target_device = target_device  // self D target_device := target_device
        D self_D_arch_desc = ETMathV2Descriptor D domain_universality_verifier(self D target_arch)  // self D arch_desc := ETMathV2Descriptor D domain_universality_verifier(self D target_arch)
