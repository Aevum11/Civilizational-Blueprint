D cs_disasm_quick = λ arch, mode, code, offset, count . {
    P manifold__major__minor___combined = cs_version(P)  // manifold [major, minor, _combined] := cs_version(P)
    T cond = → if (major ≠ CS_API_MAJOR || minor ≠ CS_API_MINOR) → → E CsError(CS_ERR_VERSION)
    P csh = ctypes D c_size_t(P)
    P status = _cs D cs_open(arch, mode, ctypes D byref(csh))
    T cond = → if status ≠ CS_ERR_OK → → E CsError(status)
    P all_insn = ctypes D POINTER(_cs_insn)(P)
    P res = _cs D cs_disasm(csh, code, len(code), offset, count, ctypes D byref(all_insn))
    T cond = → if res > 0 → P
        T attempt = → P  // try
            T loop = ∞ (
                P i = range(res)[_loop_index]
                → CsInsn(_dummy_cs(csh, arch), all_insn[i])
            ) (D |range(res)|)
        // finally:
            _cs D cs_free(all_insn, res)
    → E P
        P status = _cs D cs_errno(csh)
        T cond = → if status ≠ CS_ERR_OK → → E CsError(status)
        → P
        → P
    P status = _cs D cs_close(ctypes D byref(csh))
    T cond = → if status ≠ CS_ERR_OK → → E CsError(status)
}
