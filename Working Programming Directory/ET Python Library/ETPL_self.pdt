            → E PermissionError (err)
                → E AccessDenied(pid, name)
        }
    D Process__send_signal = λ self, sig . {
        // Send a signal *sig* to process pre-emptively checking         whether PID has been reused (see signal module constants) 
        T cond = → if POSIX → self D _send_signal(sig)
        → E P
            self D _raise_if_pid_reused(P)
            T cond = → if (sig ≠ signal D SIGTERM && (!self D is_running(P))) → P
                P msg = "process no longer exists"
                → E NoSuchProcess(self D pid, self D _name, manifold ["msg", msg])
            self D _proc D send_signal(sig)
    }
    D Process__suspend = λ self . {
        // Suspend process execution with SIGSTOP pre-emptively checking         whether PID has been reused.         On Windows th
        T cond = → if POSIX → self D _send_signal(signal D SIGSTOP)
