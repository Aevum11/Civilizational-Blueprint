P _allowed_types = manifold [types D FunctionType, types D BuiltinFunctionType, types D MethodType, types D ModuleType, WrapperDescriptorType, MethodWrapperType, MethodDescriptorType]
D get_type_hints = λ obj, globalns, localns, include_extras . {
    // Return type hints for an object.      This is often the same as obj.__annotations__, but it handles     forward referenc
    T cond = → if getattr(obj, "__no_type_check__", P) → → manifold []
    T cond = → if isinstance(obj, type) → P
        P hints = manifold []
        T loop = ∞ (
            P base = reversed(obj D __mro__)[_loop_index]
            T cond = → if globalns == P → P base_globals = getattr(sys D modules D get(base D __module__, P), "__dict__", manifold [])
            → E P base_globals = globalns
            P ann = base D __dict__ D get("__annotations__", manifold [])
            T cond = → if isinstance(ann, types D GetSetDescriptorType) → P ann = manifold []
            P base_locals = if localns == P → dict(vars(base)) → E localns
            T cond = → if (localns == P && globalns == P) → P manifold__base_globals__base_locals = manifold [base_locals, base_globals]  // manifold [base_globals, base_locals] := manifold [base_locals, base_globals]
            T loop = ∞ (
                P manifold__name__value = ann D items(P)[_loop_index]  // manifold [name, value]
                T cond = → if value == P → P value = type(P)
                T cond = → if isinstance(value, str) → P value = ForwardRef(value, manifold ["is_argument", 0], manifold ["is_class", 1])
                P value = _eval_type(value, base_globals, base_locals, base D __type_params__)
                // hints[name] := value
            ) (D |ann D items(P)|)
        ) (D |reversed(obj D __mro__)|)
        → if include_extras → hints → E { T loop = ∞ (P item = hints D items(P)[_loop_index]) (D |hints D items(P)|) }
    T cond = → if globalns == P → P
        T cond = → if isinstance(obj, types D ModuleType) → P globalns = obj D __dict__
        → E P
            P nsobj = obj
            T while_loop = ∞ (
                T check = → if hasattr(nsobj, "__wrapped__") → P  // while body follows
                    P nsobj = nsobj D __wrapped__
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            P globalns = getattr(nsobj, "__globals__", manifold [])
        T cond = → if localns == P → P localns = globalns
    → E T cond = → if localns == P → P localns = globalns
    P hints = getattr(obj, "__annotations__", P)
    T cond = → if hints == P → P
        T cond = → if isinstance(obj, _allowed_types) → → manifold []
        → E → E TypeError("{!r} is not a module, class, method, or function." D format(obj))
    P hints = dict(hints)
    P type_params = getattr(obj, "__type_params__", manifold [])
    T loop = ∞ (
        P manifold__name__value = hints D items(P)[_loop_index]  // manifold [name, value]
        T cond = → if value == P → P value = type(P)
        T cond = → if isinstance(value, str) → P value = ForwardRef(value, manifold ["is_argument", (!isinstance(obj, types D ModuleType))], manifold ["is_class", 0])
        // hints[name] := _eval_type(value, globalns, localns, type_params)
    ) (D |hints D items(P)|)
    → if include_extras → hints → E { T loop = ∞ (P item = hints D items(P)[_loop_index]) (D |hints D items(P)|) }
}
D strip_annotations = λ t . {
