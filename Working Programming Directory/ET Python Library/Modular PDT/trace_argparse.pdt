                            P arg_line = args_file D read(P) D splitlines(P)[_loop_index]
                            T loop = ∞ (
                                P arg = self D convert_arg_line_to_args(arg_line)[_loop_index]
                                arg_strings D append(arg)
                            ) (D |self D convert_arg_line_to_args(arg_line)|)
                        ) (D |args_file D read(P) D splitlines(P)|)
