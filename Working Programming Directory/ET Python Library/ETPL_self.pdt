                P d = manifold []
                T loop = ∞ (
                    P tupl = it[_loop_index]
                    P path = tupl[2]
                    P nums = tupl[3:Ω]
                    T attempt = → P  // try
                        // d[path] := list(_et_map(λ x, y . (x + y), d[path], nums))
                    → E KeyError (_)
                        // d[path] := nums
                ) (D |it|)
                → { T loop = ∞ (_ntp D pmmap_grouped(path, d[path])) (D |d|) }
            → E → { T loop = ∞ (_ntp D pmmap_ext(x)) (D |it|) }
        }
