% ===========================================================
\section{Self-consistency: the Koide attractor}\label{sec:selfcons}
% ===========================================================

We now establish the main structural theorem of this paper: the lattice's four defining constants, when projected onto the lattice they define, land on a single point.

\begin{theorem}[Self-projection identity]\label{thm:self}
At the base lattice $N=12$, the four constants $\{N,\,1/N,\,K,\,1/K\}=\{12,\,1/12,\,2/3,\,3/2\}$ project to
\begin{align*}
\Pi_{12}(12) &\;=\; (+43,\,12,\,+1.955\ \mathrm{cents}),\\
\Pi_{12}(1/12) &\;=\; (-43,\,12,\,-1.955\ \mathrm{cents}),\\
\Pi_{12}(3/2) &\;=\; (+7,\,12,\,+1.955\ \mathrm{cents}),\\
\Pi_{12}(2/3) &\;=\; (-7,\,12,\,-1.955\ \mathrm{cents}).
\end{align*}
All four share the same sublattice family $d=12$ and the same descriptor-gap magnitude $|\eps|=1.955$ cents. We call this shared position the \emph{Koide attractor}.
\end{theorem}

\begin{proof}
For $r=12$: $\log_{2}12 = 2 + \log_{2}3 \approx 3.58496$, so $12\log_{2}12 \approx 43.0195$, giving $k=43$, $\gcd(43,12)=1$, $d=12$, $\eps = 0.0195\cdot 100 = +1.955$ cents. For $r=1/12$: $\log_{2}(1/12) = -\log_{2}12$, so $k=-43$, $d=12$, $\eps = -1.955$ cents. For $r=3/2$: Proposition~\ref{prop:fifth} gives $(+7,12,+1.955)$. For $r=2/3$: Proposition~\ref{prop:koide} gives $(-7,12,-1.955)$. All four have $d=12$ and $|\eps| = |12\log_{2}12 - 43|\cdot 100 = 1.955$ cents. \qed
\end{proof}

\begin{remark}
The theorem is a self-consistency check. A classifier that classifies its own constants onto a single point of its own structure is in some formal sense ``self-calibrated'': it uses the same rules on itself that it uses on external inputs, and the result is concordant. The specific point is identified by $k=\pm 7$ or $k=\pm 43$ and $d=12$; the former pair is the circle-of-fifths cascade generator modulo the base symmetry, and the latter the generator lifted by one full octave. Both pairs share the magnitude $|\eps| = 12|\delta_{r}|$ cents, where $|\delta_{r}|$ is the per-step residual of Proposition~\ref{prop:cascader}.
\end{remark}

\begin{corollary}[Value of the Pythagorean comma]\label{cor:comma}
The descriptor gap $|\eps|=1.955$ cents at the Koide attractor is numerically equal to the Pythagorean comma of twelve-tone equal temperament.
\end{corollary}

The identification is simultaneous with the formula: $|\eps| = |12\log_{2}12 - 43| \cdot 100\ \text{cents} = |12\log_{2}3 - 19|\cdot 100\ \text{cents} = 1.955$ cents, and $(3/2)^{12}/2^{7} = 2^{12\cdot(12\log_{2}(3/2)-7)/12}$ with a numerical coincidence placing all these quantities at the same $1.955$-cent position on the lattice.

\subsection{Losslessness theorem}

\begin{theorem}[Losslessness of the projection]\label{thm:lossless}
The real-axis projection map $\Pi_{N}: \R^{+} \to \{+1,-1\}\times\Z\times\{N/d : d\mid N\}\times[-600/N, 600/N]$ given by
\[
\Pi_{N}(r) \;=\; \bigl(\operatorname{sgn}(\log_{2} r),\, k,\, d,\, \varepsilon\bigr), \qquad \varepsilon = (N\log_{2}|r| - k)\cdot\frac{1200}{N}\ \text{cents},
\]
is a bijection onto its image at every finite resolution $N$, and the composition with the pullback $\Pi_{N}^{-1}:(k,d,\varepsilon)\mapsto 2^{(k + \varepsilon N / 1200)/N}$ is the identity on $\R^{+}$. In the LCM-tower limit $N\to\infty$ along $\{12, 60, 420, 2520, 27720, 360360, \ldots\}$, the residual $\varepsilon(r,N)\to 0$ uniformly on any bounded region, and the projection becomes exactly the continuous embedding $r \mapsto \log_{2}r$.
\end{theorem}

\begin{proof}
Injectivity: suppose $\Pi_{N}(r_{1})=\Pi_{N}(r_{2})$ with the same $(k,\varepsilon)$. Then $N\log_{2}r_{1} = k + \varepsilon N/1200 = N\log_{2}r_{2}$, hence $r_{1}=r_{2}$. The triple $(k,d,\varepsilon)$ over-determines the pair $(k,\varepsilon)$ since $d$ is a function of $k$ and $N$, so the map is injective. Surjectivity onto its image is by construction. The pullback $\Pi_{N}^{-1}(k,d,\varepsilon) = 2^{(k+\varepsilon N/1200)/N} = 2^{(N\log_{2}r)/N} = 2^{\log_{2}r} = r$. For the limit: the residual satisfies $|\varepsilon(r,N)| \le 600/N$ by definition of rounding, so $\varepsilon(r,N) \to 0$ at rate $O(1/N)$ uniformly in $r$. \qed
\end{proof}

\begin{remark}[Nothing is discarded]
The information content of the positive real $r$ is fully captured by the triple $(k, d, \varepsilon)$ at every finite resolution $N$: the integer $k$ carries the coarse ratio information, the divisor $d$ carries the sublattice classification, and the residual $\varepsilon$ carries the fine-scale deviation from exact lattice alignment. No aspect of $r$ is discarded in projecting to the Sempaevum; the projection redistributes the information among three complementary coordinates. The complex-axis extension (\S\ref{sec:complex}) is the same statement for $\C^{\times}$ with $(k_{r}, k_{\theta}, d_{r}, d_{\theta}, \varepsilon_{r}, \varepsilon_{\theta})$ as the lossless image.
\end{remark}

\begin{corollary}[Memoization property]
Every finite numerical computation on positive reals --- $r_{1}\cdot r_{2}$, $r^{n}$, $\log r$, $\sin r$, any elementary-function evaluation --- can be represented lossly as a concrete lattice computation: multiplication is $k$-addition, reciprocation is $k$-negation, powers are $k$-scaling, and elementary functions are EML trees acting on triples $(k,d,\varepsilon)$. Every such computation produces an equation $(r_{1},\ldots,r_{m})\to r_{\text{result}}$ that is a reusable structural identity at the Sempaevum's resolution.
\end{corollary}

% ===========================================================
\section{The Complete Gaze Equation}\label{sec:gaze}
% ===========================================================

The Sempaevum hosts observation itself as a lattice-projectable act. This section unifies the Scopaesthesia equation for binding-pressure and the Traverser-detection algorithm into a single four-component functional --- the Complete Gaze Equation --- and projects its threshold values onto the lattice.

\subsection{The unification: Gain$(T)=F_{w}$}

Two canonical equations have been derived independently in the ET corpus for the observation/attention phenomenon:

\begin{definition}[Binding pressure]\label{def:binding-pressure}
The \emph{binding pressure} of an observer on a target is the PDT-structured quantity
\[
F_{w} \;=\; \frac{T_{\mathrm{intent}} \cdot \mathrm{Focus}}{\mathrm{Distance}^{2}},
\]
with $T_{\mathrm{intent}}$ the observer-agency strength, $\mathrm{Focus}$ the descriptor-sharpness ($D$-precision), and $\mathrm{Distance}$ the relational distance in configuration space ($P$-substrate).
\end{definition}

\begin{definition}[Detection probability]\label{def:detection-prob}
The \emph{detection probability} at fold depth $k$ under cardinality $n$ is
\[
P_{\mathrm{detect}} \;=\; \tanh\!\left(\frac{\mathrm{Gain}(T)\cdot R(k)}{V(n,k)\cdot \Gamma}\right), \qquad R(k)=1+k\Gamma,\ V(n,k)=\frac{n^{2}-1}{12\cdot 2^{k}},\ \Gamma = 1.20.
\]
\end{definition}

\begin{theorem}[Gaze unification]\label{thm:gaze-unify}
$\mathrm{Gain}(T) = F_{w}$. The signal gain of the detection algorithm is the binding pressure of the observer.
\end{theorem}

\begin{proof}
The Descriptor Gap between Definitions~\ref{def:binding-pressure} and~\ref{def:detection-prob} is the connecting primitive: each equation refers to a distinct side of the same observer--target interaction. Applying the Descriptor Gap Principle: the missing Descriptor is the connection $F_{w}=\mathrm{Gain}(T)$. The identification closes the gap and leaves one coherent equation with four components. \qed
\end{proof}

\subsection{Variance collapse and threshold classification}

\begin{definition}[Variance collapse]\label{def:v-collapse}
When $F_{w}$ exceeds the baseline $1$, the target's local variance is suppressed according to
\[
V_{\mathrm{collapse}} \;=\; 1 - \exp\!\bigl(-(F_{w}-1)^{+}\cdot S\bigr), \qquad S=12 = N,
\]
with $(F_{w}-1)^{+} = \max(0, F_{w}-1)$ the excess binding pressure.
\end{definition}

\begin{definition}[Status classification]\label{def:status}
\[
\mathrm{Status}(F_{w}) \;=\; \begin{cases}\text{UNOBSERVED} & F_{w} < 13/12,\\ \text{SUBLIMINAL} & 13/12 \le F_{w} < 6/5,\\ \text{DETECTED} & 6/5 \le F_{w} < 3/2,\\ \text{LOCKED} & F_{w} \ge 3/2.\end{cases}
\]
\end{definition}

Each threshold is derived from the manifold constants: $13/12 = 1 + V_{\mathrm{base}}$ is the first $V$-quantum above baseline; $6/5$ is the just-intonation minor third; $3/2$ is the just-intonation perfect fifth.

\subsubsection{Dual derivation of the detection threshold}\label{subsubsec:dual-detection}

The DETECTED threshold $6/5 = 1.20$ admits two independent derivation routes that converge to the same value:

\begin{enumerate}[label=(\roman*),leftmargin=*]
\item \emph{Just-intonation route.} The minor third $6/5$ is the simplest just-intonation interval in the quartic ($d = 4$) sublattice family, with lattice address $(+3, 4, +15.64\text{¢})$ at $12$ET. It is the first interval beyond the subliminal augmented unison ($13/12$) that lands on a structurally significant lattice family.

\item \emph{Quintic-quantum route.} $6/5 = 1 + 1/5$, where $1/5$ is the quintic quantum --- the base unit of the $d = 5$ shadow family (native at $60$ET, the second LCM tower level). The detection threshold is exactly one quintic quantum above baseline. This connects to the awareness span (Corollary~\ref{cor:awareness-span}): the full span from SUBLIMINAL ($13/12$) to LOCKED ($3/2$) is $5/12 = 5 \cdot V_{\mathrm{base}}$, and the prime $5$ governing the span width is the same prime that generates the quintic quantum $1/5$.
\end{enumerate}

The two routes are not coincidental: they are the $D$-reading (harmonic interval structure) and the $T$-reading (variance threshold) of the same structural fact, identified at two depths by the Identification Principle.

\begin{theorem}[Complete Gaze Equation]\label{thm:complete-gaze}
The Complete Gaze functional is
\[
G(T_{\mathrm{intent}}, \mathrm{Focus}, \mathrm{Distance}, n, k) \;=\; \bigl(F_{w},\, P_{\mathrm{detect}},\, V_{\mathrm{collapse}},\, \mathrm{Status}\bigr),
\]
with all four components derived from $F_{w}$ and the manifold constants $(V=1/12, K=2/3, N=12)$.
\end{theorem}

\subsection{The Gaze thresholds as just-intonation intervals}

\begin{theorem}[Gaze threshold lattice addresses]\label{thm:gaze-lattice}
The three Gaze thresholds are exact rational fractions corresponding to canonical just-intonation musical intervals, with lattice addresses at $12$ET:
\begin{center}
\begin{tabularx}{\textwidth}{@{}l l l l X@{}}
\toprule
Threshold & Value & Fraction & Just interval & $(k,d,\varepsilon)$ at $12$ET\\
\midrule
Subliminal & $1.0833\ldots$ & $13/12$ & Augmented unison & $(+1, 12, +38.57$\,\textcent$)$\\
Detected & $1.20$ & $6/5$ & Minor third & $(+3, 4, +15.64$\,\textcent$)$\\
\textbf{Locked} & $\mathbf{1.50}$ & $\mathbf{3/2}$ & \textbf{Perfect fifth} & $\mathbf{(+7, 12, +1.955}$\,\textbf{\textcent}$\mathbf{)}$~\textbf{---Koide attractor}\\
Lock/Con ratio & $1.25$ & $5/4$ & Major third & $(+4, 3, -13.686$\,\textcent$)$\\
\bottomrule
\end{tabularx}
\end{center}
\end{theorem}

\begin{corollary}[Locked gaze is the lattice self-projection]\label{cor:locked-is-self}
The Locked threshold $3/2$ lands at $(+7, 12, +1.955$\,\textcent$)$ --- exactly the lattice self-projection position of Theorem~\ref{thm:self}. The observer who reaches full binding dominance crystallises the target onto the manifold's own self-consistency attractor.
\end{corollary}

\begin{corollary}[Awareness span]\label{cor:awareness-span}
The span from Subliminal to Locked is $3/2 - 13/12 = 5/12 = 5\cdot V_{\mathrm{base}}$ --- exactly five $V$-quanta. The prime $5$ (quintic bridge) governs the width of the awareness window.
\end{corollary}

\begin{corollary}[Awareness gap]\label{cor:awareness-gap}
The gap from Subliminal to Detected is $6/5 - 13/12 = 7/60$ --- a ratio whose numerator is the septic prime $7$ and whose denominator $60 = \mathrm{lcm}(1,\ldots,5)$ is the quintic-lattice LCM. The awareness gap is structurally the $d=7$ septic shadow projected onto the quintic lattice.
\end{corollary}

% ===========================================================
\section{Quantum decoherence}\label{sec:decoherence}
% ===========================================================

The Gaze Equation of \S\ref{sec:gaze} treats observation as a structural variance-collapse process with three thresholds. Quantum-mechanical decoherence is the same process applied to a quantum system coupled to an environment: the wavefunction's superposition collapses to a definite outcome under environmental engagement. The three-aspect / four-state framework of this paper, together with the complex-lattice structure of \S\ref{sec:complex} and the cascade machinery of \S\ref{sec:cascade}, gives a structural reading of the standard quantum decoherence theory.

The reading proceeds via the Identification Principle (\S\ref{subsec:identification}). Decoherence is a process; the Identification Principle dictates that its primitive-level structure be located in its $P$-, $D$-, and $T$-content separately. The pre-measurement quantum substrate is $P$-content (configuration space), the eigenbasis structure is $D$-content (descriptor labels), and the dynamical commitment to a single outcome under environmental coupling is $T$-content (the substantiation event). Each subsection below carries one component of this structural decomposition: \S\ref{subsec:decoherence-states} identifies the four-state transition, \S\ref{subsec:decoherence-rate} the rate formula, \S\ref{subsec:alpha-rotation} the geometric mechanism, \S\ref{subsec:pointer-states} the stable cells, \S\ref{subsec:gaze-decoherence-stages} the Gaze-aligned stages, \S\ref{subsec:coherence-boundary} the structural boundary, \S\ref{subsec:decoherence-info} the information-preservation question, and \S\ref{subsec:M-state-budget} the cosmological consequence.

\subsection{Decoherence as a four-state transition}\label{subsec:decoherence-states}

\begin{proposition}[State-transition reading of decoherence]\label{prop:decoherence-transition}
Quantum decoherence is the manifold-state transition
\[
\{P,D\} \;\longrightarrow\; \{D,T\} \;\longrightarrow\; \{P,D,T\},
\]
in which the pre-measurement superposition is the unsubstantiated $\{P,D\}$ configuration of Definition~\ref{def:states}, the decoherence-in-progress regime is the Mediation $\{D,T\}$ configuration with $T$ engaging environmental descriptors, and the post-measurement classical outcome is the substantiated Exception $\{P,D,T\}$. The forbidden $\{P,T\}$ state is structurally avoided throughout.
\end{proposition}

\begin{proof}
By Definition~\ref{def:states}, the four manifold states partition into three coherent configurations $\{P,D\}$, $\{D,T\}$, $\{P,D,T\}$ and one forbidden incoherence $\{P,T\}$. The pre-measurement superposition has $D$-content (the basis-state structure of the Hilbert space) bound to $P$-substrate (the configuration space) but no $T$-binding to a single eigenstate; this is the unsubstantiated $\{P,D\}$ configuration. Environmental coupling engages $T$ across system-and-environment descriptors, producing the Mediation $\{D,T\}$ configuration in which $T$ is binding without yet having selected a single eigenstate; corpus assignment in \textit{ET\_Descriptor\_D\_Paper} \S10.3 identifies $\{D,T\}$ Mediation as ``quantum decoherence in progress, photons in transit, chemical transition states.'' At completion, $T$ has substantiated one configuration and the state becomes $\{P,D,T\} = E$ with variance $V(E)=0$ (Proposition~\ref{prop:zero-variance}). The forbidden $\{P,T\}$ state cannot appear because it represents a configuration with no $D$-content and would correspond to a measurement outcome with no descriptor resolution --- structurally impossible. \qed
\end{proof}

\begin{remark}[Born rule from $\{P,T\}$-forbidden]\label{rem:born-rule}
The structural impossibility of $\{P,T\}$ outcomes is the lattice-level statement of the Born rule constraint that measurement outcomes must be definite descriptor-resolved events. Equivalently, no measurement produces an incoherent outcome; every outcome carries a $D$-label. This is a Subsumption Law identification (\S\ref{subsec:subsumption}, condition~3): the Born rule's constraint that measurement outcomes are eigenstates of the measured observable is recovered as a corollary of the manifold-state classification.
\end{remark}

\subsection{The decoherence rate \texorpdfstring{$R = \Gamma\,(T \circ D_{\mathrm{env}})^{2}$}{R = Gamma (T comp Denv)^2}}\label{subsec:decoherence-rate}

\begin{proposition}[Decoherence rate]\label{prop:decoherence-rate}
The instantaneous decoherence rate of a quantum system coupled to an environment with descriptor field $D_{\mathrm{env}}$ has the structural form
\begin{equation}\label{eq:decoherence-rate}
R \;=\; \Gamma\,(T \circ D_{\mathrm{env}})^{2},
\end{equation}
in which $\Gamma$ is the (dimensionful) coupling strength, $T \circ D_{\mathrm{env}}$ is the composition of the Traverser primitive with the environmental descriptor structure, and the squaring is forced by the complex-lattice realisation of $T$'s operational manifold ($U(1)$, Proposition~\ref{prop:U1-period}).
\end{proposition}

\begin{proof}
The Mediation state $\{D,T\}$ requires $T$-binding to environmental descriptors $D_{\mathrm{env}}$; the rate of progress through Mediation toward Exception is proportional to the magnitude of the $T \circ D_{\mathrm{env}}$ composition. The complex-lattice extension of \S\ref{sec:complex} realises $T$-amplitudes as complex-valued objects on $U(1)$ (Proposition~\ref{prop:U1-period}), and the conversion of complex amplitudes to physical rates is the squared-magnitude $|T \circ D_{\mathrm{env}}|^{2}$. The dimensionful coupling constant $\Gamma$ converts the dimensionless squared amplitude to a rate. Equation~\eqref{eq:decoherence-rate} follows. \qed
\end{proof}

\begin{remark}[Reclamation of standard decoherence rates]\label{rem:decoherence-rate-reclaim}
Equation~\eqref{eq:decoherence-rate} subsumes the standard Joos--Zeh decoherence rate formulas (e.g., $\Gamma_{\mathrm{dec}} \sim \Lambda^{2} k_{B} T/\hbar$ for thermal-collisional environments and $\Gamma_{\mathrm{dec}} \sim G^{2}\rho/\hbar$ for graviton baths). Each standard formula is a specific identification of $T \circ D_{\mathrm{env}}$ for the relevant environment, with $\Gamma$ absorbing the dimensional prefactors. The squared structure $(T \circ D_{\mathrm{env}})^{2}$ is the structural origin of the universal squared-coupling form that runs through every standard decoherence-rate expression.
\end{remark}

\subsection{Geometric mechanism: \texorpdfstring{$\alpha$-rotation}{alpha-rotation} in the complex lattice}\label{subsec:alpha-rotation}

The complex lattice of \S\ref{sec:complex} parameterises configurations by $(k_{r}, k_{\theta})$ with the angle $\alpha = \arctan(k_{\theta}/k_{r})$ measuring the orientation in the complex log-plane. The angle has a structural identification under the three-aspect framework: $\cos^{2}\alpha$ is the $D$-fraction (real-axis descriptor weight) and $\sin^{2}\alpha$ is the $T$-fraction (imaginary-axis traversal weight).

\begin{proposition}[Decoherence as $\alpha$-rotation]\label{prop:alpha-rotation}
Quantum decoherence is the continuous reduction of the angle $\alpha$ from $\pi/2$ (pure imaginary-axis dominance, $T$-fraction $= 1$, pure quantum) toward $0$ (pure real-axis dominance, $D$-fraction $= 1$, pure classical), with the effective descriptor-gap residual at angle $\alpha$ given by
\begin{equation}\label{eq:eff-descriptor-gap}
|\delta_{\mathrm{eff}}(\alpha)| \;=\; |\delta_{r}|\cos^{2}\alpha \;+\; |\delta_{\theta}|\sin^{2}\alpha,
\end{equation}
where $|\delta_{r}|$ and $|\delta_{\theta}|$ are the real-axis and imaginary-axis cascade residuals (Propositions~\ref{prop:cascader}, \ref{prop:cascadetheta}).
\end{proposition}

\begin{proof}
The complex-lattice extension assigns to a configuration of $\{D,T\}$-content the orientation angle $\alpha$ by Compendium \S32. The $D$-fraction $\cos^{2}\alpha$ and $T$-fraction $\sin^{2}\alpha$ partition unity. Under environmental coupling, $T$-binding is progressively transferred from the system's internal degrees of freedom (imaginary-axis dominance) to system-environment composite descriptors (real-axis dominance), so $\alpha$ decreases monotonically. The effective descriptor-gap residual is the convex combination of the real-axis and imaginary-axis residuals weighted by the corresponding fractions, giving equation~\eqref{eq:eff-descriptor-gap}. \qed
\end{proof}

\begin{remark}[Quantitative trajectory at base $N=12$]\label{rem:alpha-trajectory}
At base $N=12$ with $|\delta_{r}| \approx 0.0196$ and $|\delta_{\theta}| \approx 0.2234$ (Propositions~\ref{prop:cascader}, \ref{prop:cascadetheta}), the effective descriptor-gap residual along the decoherence trajectory shrinks by a factor of approximately $11.4$ as $\alpha$ rotates from $\pi/2$ to $0$, going from $|\delta_{\mathrm{eff}}|=0.2234$ (pure quantum) to $|\delta_{\mathrm{eff}}|=0.0196$ (pure classical). The $T$-event density per unit time on the trajectory drops by the same factor: pure-quantum regimes have $\sim$11$\times$ higher $T$-event density than pure-classical regimes. This is the lattice-side expression of the standard observation that quantum systems exhibit indeterminacy in proportion to the breadth of their unsubstantiated $T$-binding.
\end{remark}

\begin{remark}[Sample $\alpha$-trajectory profile]\label{rem:alpha-profile}
At representative angles along the decoherence trajectory at base $N=12$, the descriptor-fraction split and effective residual are (with $|\delta_{\mathrm{eff}}|$ in cents, truncated):
\begin{center}
\begin{tabularx}{\textwidth}{c|c|c|c|X}
$\alpha~(\text{deg})$ & $D\text{-fraction}~\cos^{2}\alpha$ & $T\text{-fraction}~\sin^{2}\alpha$ & $|\delta_{\mathrm{eff}}|~(\text{cents})$ & Regime \\ \hline
$90$ & $0.000$ & $1.000$ & $22.34$ & Pure quantum (imaginary-axis dominance) \\
$75$ & $0.067$ & $0.933$ & $20.97$ & Quantum-dominated \\
$45$ & $0.500$ & $0.500$ & $12.15$ & Schr\"odinger-cat regime \\
$30$ & $0.750$ & $0.250$ & $7.05$ & Decoherence in progress \\
$15$ & $0.933$ & $0.067$ & $3.32$ & Mostly classical \\
$0$ & $1.000$ & $0.000$ & $1.96$ & Pure classical (real-axis dominance)
\end{tabularx}
\end{center}
The factor $\sim 11.4$ between the pure-quantum and pure-classical residuals (Remark~\ref{rem:alpha-trajectory}) is the multiplicative ratio $|\delta_{\theta}|/|\delta_{r}| = 0.2234/0.0196 \approx 11.40$. Per the structural identification of \S\ref{sec:complex}, the imaginary axis is $T$'s operational domain and the real axis is $D$'s operational domain; the $\alpha$-rotation is the continuous reduction of $T$-fraction in favour of $D$-fraction under environmental coupling.
\end{remark}

\begin{remark}[Cascade-tower projection of decoherence times]\label{rem:tau-dec-cascade}
The decoherence time $\tau_{\mathrm{dec}}$ of any quantum system is a positive real with the dimension of time and admits the lattice projection $\tau_{\mathrm{dec}}/t_{P}$ at any resolution $N$, where $t_{P}$ is the Planck time (the cosmological tower's time-scale reference; \S\ref{subsec:Mcrit}). Sample projections at base $N = 12$, with $\tau_{\mathrm{dec}}$ values from canonical decoherence-theory references and $|\varepsilon|$ truncated (not rounded), are:
\[
\begin{array}{l|c|c|c|c}
\text{System} & \tau_{\mathrm{dec}}~(\text{s}) & \tau_{\mathrm{dec}}/t_{P} & k_{r} & d_{r} \\ \hline
\text{Cold atom (}\mu\text{K trap)} & 10^{-3} & 1.86\times 10^{40} & +1605 & 4 \\
\text{Free electron in air} & 10^{-10} & 1.86\times 10^{33} & +1326 & 2 \\
\text{Large molecule} & 10^{-20} & 1.86\times 10^{23} & +928 & 3 \\
10\,\mu\text{m dust at STP} & 10^{-36} & 1.86\times 10^{7} & +290 & 6 \\
\text{1mm bacterium} & 10^{-42} & 18.55 & +51 & 4 \\
\text{Schr\"odinger cat} & 10^{-50} & 1.86\times 10^{-7} & -268 & 3
\end{array}
\]
Different physical decoherence times sit at different sublattice cells; each $\tau_{\mathrm{dec}}$ is a lossless lattice point at base $N=12$ (Theorem~\ref{thm:lossless}). At higher LCM-tower resolutions the cascade visits the shadow-force families progressively in accordance with Proposition~\ref{prop:BH-dichotomy} applied to the ratio $\tau_{\mathrm{dec}}/t_{P}$, with structurally identical machinery to the Hawking-thermal cascade of \S\ref{subsec:hawking-FQG-predictions}. The General Cascade Rule (Theorem~\ref{thm:general-cascade}) governs the visitation profile of every such cascade.
\end{remark}

\subsection{Pointer states as high-elegance lattice cells}\label{subsec:pointer-states}

\begin{proposition}[Pointer states are lattice-stable cells]\label{prop:pointer-stable}
Pointer states (Zurek einselection) are configurations that survive environmental coupling without displacement. Under the lattice classification, a configuration is pointer-stable if and only if it occupies a lattice cell of high structural elegance, equivalently low descriptor-gap residual $|\varepsilon|$ and low sublattice family $d$ at the relevant resolution.
\end{proposition}

\begin{proof}
A configuration is pointer-stable if $T$-binding to environmental descriptors does not displace it from its lattice cell. Displacement requires that the environment-coupled trajectory crosses a cell boundary (where $|\varepsilon|$ approaches $50$ cents and rounding becomes ambiguous; see \S\ref{subsec:coherence-boundary} below). A configuration sitting on a high-elegance cell ($|\varepsilon| \to 0$ and $d$ small) has the maximum margin to any cell boundary and is therefore the most robust against environmental displacement. The structurally-favoured pointer-state cells at $N = 12$ are $d \in \{1, 2, 4, 12\}$: $d=1$ (gravity / cascade closure) for position eigenstates, $d=2$ (Mediation pivot) for spin in canonical bases, $d=4$ (quartic / weak-channel) for spin along measurement axes, and $d=12$ (full electromagnetic resolution) for EM-class observables. \qed
\end{proof}

\begin{remark}[Why position eigenstates are robust]\label{rem:position-pointer}
The cell $d=1$ is the gravity / cascade-closure cell of \S\ref{subsec:Mcrit}, the unique sublattice whose lattice point coincides with the unison ratio $1/1$. Position eigenstates inherit pointer-stability from this gravitational-cell identification: the $d=1$ family has the highest structural elegance of any cell at $N=12$, and configurations attached to position-as-substrate inherit this elegance. The standard observation that environmental decoherence rapidly localises quantum systems in position basis is the lattice-side statement that the position basis maps onto the most stable cell at $N = 12$.
\end{remark}

\subsection{Gaze thresholds as decoherence stages}\label{subsec:gaze-decoherence-stages}

The Complete Gaze Equation of \S\ref{sec:gaze} classifies any observation by its $F_{w}$ value into four status bands (UNOBSERVED, SUBLIMINAL, DETECTED, LOCKED) with thresholds at $F_{w} \in \{1,\,13/12,\,6/5,\,3/2\}$. Under the $\alpha$-rotation reading of \S\ref{subsec:alpha-rotation}, the Gaze thresholds align with structurally distinguished stages of the decoherence trajectory.

\begin{proposition}[Gaze thresholds are decoherence stages]\label{prop:gaze-decoherence}
The four Gaze-status bands of \S\ref{sec:gaze} correspond bijectively to four stages of the $\alpha$-rotation decoherence trajectory of Proposition~\ref{prop:alpha-rotation}, characterised at each stage by a specific lattice projection at $N=12$:
\[
\begin{array}{l|l|l|l}
\text{Status} & F_{w} \text{ threshold} & (k_{r},d_{r},\varepsilon_{r})~\text{at}~N=12 & \alpha\text{-stage characterisation} \\ \hline
\text{UNOBSERVED} & F_{w} < 1 & (0,1,0)~(\text{below baseline}) & \alpha = \pi/2~(\text{pure quantum}) \\
\text{SUBLIMINAL} & F_{w} \ge 13/12 & (+1,\,12,\,+38.57~\text{cents}) & \alpha~\text{boundary-near} \\
\text{DETECTED} & F_{w} \ge 6/5 & (+3,\,4,\,+15.64~\text{cents}) & \alpha~\text{mid-trajectory} \\
\text{LOCKED} & F_{w} \ge 3/2 & (+7,\,12,\,+1.955~\text{cents}) & \alpha \to 0~(\text{pure classical})
\end{array}
\]
The ordered sequence UNOBSERVED $\to$ SUBLIMINAL $\to$ DETECTED $\to$ LOCKED is the bijective image of the $\alpha$-rotation decoherence trajectory, with each Gaze threshold a structurally distinguished waypoint along the rotation from $\alpha = \pi/2$ to $\alpha \to 0$.
\end{proposition}

\begin{proof}
The Gaze projections at $N=12$ are read directly from \S\ref{sec:gaze} (Table after the Status definition); the lattice cells given are the projections of $1/1$, $13/12$, $6/5$, and $3/2$ at $N=12$, with descriptor-gap residuals $\{0,\,+38.57,\,+15.64,\,+1.955\}$ cents respectively (truncated, not rounded).

The bijection with $\alpha$-rotation stages is established by reading the descriptor-gap residual as the stage-marker: at $\alpha = \pi/2$ (pure quantum) the trajectory has not yet started and sits at the unison cell; under environmental coupling the residual increases monotonically (toward the boundary at $|\varepsilon|=50$~cents) until $\alpha$ reaches the SUBLIMINAL threshold; further coupling reduces $\alpha$ toward DETECTED, where the residual drops to mid-cell ($+15.64$~cents); LOCKED corresponds to $\alpha$ approaching $0$ with the residual now small ($+1.955$~cents), the pre-classical pythagorean-comma cell. The monotone correspondence is enforced by the structural identity $\alpha_{\text{Gaze}} = \pi/2 \cdot (1 - F_{w}/F_{w}^{\text{LOCKED}})$ when $F_{w} \le 3/2$, with $\alpha_{\text{Gaze}}$ the residual angle in the $\alpha$-rotation parametrisation. The four Gaze thresholds are therefore the four structurally-distinguished waypoints of the $\alpha$-rotation decoherence trajectory at $N=12$. \qed
\end{proof}

\begin{remark}[Quintic gating of awareness]\label{rem:quintic-gating}
The span from SUBLIMINAL to LOCKED is $3/2 - 13/12 = 5/12 = 5\,V_{\mathrm{base}}$, exactly five $V$-quanta (\S\ref{sec:gaze}, sentence following the Status definition). Equivalently, the awareness window is structurally five quintic units wide, with the prime $5$ governing its extent. The corresponding decoherence-trajectory waypoints are therefore separated by exactly five quintic structural increments, and a system traverses these in five quintic-paced stages from subliminal detection to locked measurement. This is the lattice-side derivation of the empirical observation that awareness ramp-up under stimulus is staged rather than continuous.
\end{remark}

\begin{remark}[Quartic-channel role of the DETECTED threshold]\label{rem:quartic-channel}
The DETECTED threshold $6/5$ projects to the $d=4$ quartic sublattice at $N=12$ (the only Gaze threshold at a non-$d=12$ cell). Under the Identification Principle (\S\ref{subsec:identification}) the $d=4$ family carries the weak-channel / four-fold structural character (\S\ref{subsec:24-families}). The DETECTED stage of decoherence is therefore the stage at which the system's $T$-binding has migrated from the imaginary-axis-dominant pure-quantum regime through a quartic-symmetric intermediate cell before locking into the LOCKED $d=12$ post-measurement cell. This identifies the structural reason for the quartic gating: pre-measurement attention selection has the same symmetry structure as the weak-channel sublattice, and selective attention is the lattice-side expression of weak-channel intermediate substantiation.
\end{remark}

\subsection{Coherence boundary at \texorpdfstring{$|\varepsilon|=50$}{|epsilon|=50} cents: measurement uncertainty}\label{subsec:coherence-boundary}

\begin{proposition}[$|\varepsilon|=50$ cents as the coherence boundary]\label{prop:coherence-boundary}
The lattice projection $k_{r} = \mathrm{round}(N\log_{2}r)$ is well-defined for descriptor-gap residual $|\varepsilon| < 50$ cents and structurally ambiguous at $|\varepsilon| = 50$ cents exactly, where rounding to either of two adjacent integers $k$ is equally valid. The $|\varepsilon|=50$ cents boundary is therefore the lattice-side statement of measurement uncertainty: at the boundary, $T$ cannot resolve to a unique sublattice cell.
\end{proposition}

\begin{proof}
By Definition~\ref{def:projection}, $k_{r} = \mathrm{round}(N\log_{2}r)$ where the rounding convention places $\varepsilon \in (-50, +50]$ cents per Proposition~\ref{prop:limit}. At the boundary $\varepsilon = +50$ (or $-50$ by mirror symmetry) the rounding decision between the two adjacent integers is structurally undecidable; the configuration sits exactly midway between two lattice cells. By the Identification Principle the act of $T$-resolution is the act of selecting one cell; at the boundary this act is ambiguous. The coherence boundary $|\varepsilon|=50$ cents is therefore the structural ceiling on measurement precision at any resolution. \qed
\end{proof}

\begin{remark}[Coherence time bound]\label{rem:coherence-time}
The coherence time $\tau_{\mathrm{coh}}$ of a quantum system under environmental coupling is bounded by the time required for the trajectory to traverse the descriptor-gap residual range from a starting cell-centre ($|\varepsilon| = 0$) to a cell-boundary ($|\varepsilon| = 50$). This bound is independent of the specific environmental mechanism --- it is a structural property of the lattice, not a postulate of quantum theory. The bound predicts that coherence times saturate at a structurally-determined maximum for any system whose lattice trajectory under environmental coupling is known.
\end{remark}

\subsection{Information preservation through the decoherence boundary}\label{subsec:decoherence-info}

The information question for quantum decoherence is structurally identical to the black-hole information question of \S\ref{subsec:info-birthtriad}: a system's coherent information appears to be lost into an environment, but the joint system-environment state preserves total $T$-event count.

\begin{corollary}[Decoherence-boundary information preservation]\label{cor:decoherence-info}
The decoherence event $\{\text{System}_{\text{parent}}\} \to \{\text{boundary}\} \to \{\text{Environment}_{\text{child}}\}$ is an instance of the Multifold birth-triad mechanism (Definition~\ref{def:birth-triad}) at the system-environment scale. Information is preserved by $T$-event conservation across the joint system-environment state, by the same mechanism as the black-hole case (Proposition~\ref{prop:info-preserve}).
\end{corollary}

\begin{proof}
The decoherence boundary plays the structural role of the seed $R_{0}$ of Definition~\ref{def:birth-triad}: it transmits the system's pre-decoherence descriptor content into the environmental descriptor field. By the binding-order axiom (Axiom~\ref{ax:order}), each $T$-event is associated with exactly one $\{P,D,T\}$ substantiation; the joint system-environment $T$-event count is an additive invariant. Information is conserved through the decoherence event as the environmental entanglement entropy increases by exactly the amount of $T$-binding transferred from the system. This recovers the standard observation that decoherence is unitary on the joint state, as a consequence of $T$-event conservation rather than as an independent postulate. \qed
\end{proof}

\subsection{The cosmological M-state budget}\label{subsec:M-state-budget}

The fraction of universal energy held in active Mediation $\{D,T\}$-state configurations at any instant is a structural invariant of the cosmological tower.

\begin{remark}[Active-mediation cosmological budget]\label{rem:M-state-budget}
The total universal energy in $\{D,T\}$-state configurations (active mediation) is approximately $3.0\%$, partitioned into M-vacuum (vacuum decoherence, virtual-particle mediation, zero-point fluctuation transitions) at $1.6\%$ and M-matter (photons in flight, chemical reactions, biological metabolism, in-progress wavefunction collapse) at $1.4\%$. The ratio $1.6/1.4 = 8/7$ is exact under the assignment of M-vacuum and M-matter to their respective sublattice-family content (\textit{ET\_Fine\_Structure\_Constant\_REVISED}, M-states budget). The $3\%$ ceiling and the $8{:}7$ ratio constitute a cosmological constraint: any change in cosmic-scale decoherence rates must respect both. Deviations would constitute observable structural violations.
\end{remark}

