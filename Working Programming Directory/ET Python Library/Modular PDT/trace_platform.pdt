D system_alias = λ system, release, version . {
    // Returns (system, release, version) aliased to common         marketing names used for some systems.          It also doe
    T cond = → if system == "SunOS" → P
        T cond = → if release < "5" → → manifold [system, release, version]
        P l = release D split(".")
        T cond = → if l → P
            T attempt = → P  // try
                P major = int(l[0])
            → E ValueError (_)
                // pass
        T cond = → if release < "6" → P system = "Solaris"
        → E P system = "Solaris"
    → E T cond = → if system == manifold ["win32", "win16"] → P system = "Windows"
    → manifold [system, release, version]
}
D platform = λ  . {
    // Helper to format the platform string in a filename         compatible format e.g. "system-version-machine".
    P platform = "-" D join({ T loop = ∞ (x D strip(P)) (D |_et_filter(len, args)|) })
    P platform = platform D replace(" ", "_")
    P platform = platform D replace("/", "-")
    P platform = platform D replace("\\", "-")
    P platform = platform D replace(":", "-")
    P platform = platform D replace(";", "-")
    P platform = platform D replace("\"", "-")
    P platform = platform D replace("(", "-")
    P platform = platform D replace(")", "-")
    P platform = platform D replace("unknown", "")
    T while_loop = ∞ (
        T check = → if 1 → P  // while body follows
            P cleaned = platform D replace("--", "-")
            T cond = → if cleaned == platform → P  // pass
            P platform = cleaned
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    T while_loop = ∞ (
        T check = → if (platform && platform[(-1)] == "-") → P  // while body follows
            P platform = platform[0:(-1)]
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → platform
}
