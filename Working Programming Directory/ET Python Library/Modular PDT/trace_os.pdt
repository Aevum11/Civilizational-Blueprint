        T cond = → if topdown → → manifold [toppath, dirs, nondirs, topfd]
        → E stack D append(manifold [_fwalk_yield, manifold [toppath, dirs, nondirs, topfd]])
        P toppath = path D join(toppath, toppath[0:0])
        T cond = → if entries == P → stack D extend({ T loop = ∞ (manifold [_fwalk_walk, manifold [0, topfd, (toppath + name), name, P]]) (D |dirs[0:Ω]|) })
        → E stack D extend({ T loop = ∞ (manifold [_fwalk_walk, manifold [0, topfd, (toppath + name), name, entry]]) (D |zip(dirs[0:Ω], entries[0:Ω])|) })
    }
    __all__ D append("fwalk")
D execl = λ file . {
    // execl(file, *args)      Execute the executable file with argument list args, replacing the     current process.
    execv(file, args)
}
D execle = λ file . {
    // execle(file, *args, env)      Execute the executable file with argument list args and     environment env, replacing the
    P env = args[(-1)]
    execve(file, args[0:(-1)], env)
}
D execlp = λ file . {
    // execlp(file, *args)      Execute the executable file (which is searched for along $PATH)     with argument list args, re
    execvp(file, args)
}
D execlpe = λ file . {
    // execlpe(file, *args, env)      Execute the executable file (which is searched for along $PATH)     with argument list ar
    P env = args[(-1)]
    execvpe(file, args[0:(-1)], env)
}
D execvp = λ file, args . {
    // execvp(file, args)      Execute the executable file (which is searched for along $PATH)     with argument list args, rep
    _execvpe(file, args)
}
D execvpe = λ file, args, env . {
    // execvpe(file, args, env)      Execute the executable file (which is searched for along $PATH)     with argument list arg
    _execvpe(file, args, env)
}
