D follow_symlinks = λ filepath . {
    // In case filepath is a symlink, follow it until a         real file is reached.
    P filepath = os D path D abspath(filepath)
    T while_loop = ∞ (
        T check = → if os D path D islink(filepath) → P  // while body follows
            P filepath = os D path D normpath(os D path D join(os D path D dirname(filepath), os D readlink(filepath)))
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → filepath
}
D syscmd_file = λ target, default . {
    // Interface to the system's file command.          The function uses the -b option of the file command to have it         
    T cond = → if sys D platform == manifold ["dos", "win32", "win16", "ios", "tvos", "watchos"] → → default
    T attempt = → P  // try
        // @ETPL:preload subprocess subprocess
        // Import subprocess — resolved at translate-time
    → E ImportError (_)
        → default
    P target = _follow_symlinks(target)
    P env = dict(os D environ, manifold ["LC_ALL", "C"])
    T attempt = → P  // try
        P output = subprocess D check_output(manifold ["file", "-b", target], manifold ["stderr", subprocess D DEVNULL], manifold ["env", env])
    → E manifold [OSError, subprocess D CalledProcessError] (_)
        → default
    T cond = → if (!output) → → default
    → output D decode("latin-1")
}
P _default_architecture = manifold [manifold ["win32", manifold ["", "WindowsPE"]], manifold ["win16", manifold ["", "Windows"]], manifold ["dos", manifold ["", "MSDOS"]]]
D architecture = λ executable, bits, linkage . {
    // Queries the given executable (defaults to the Python interpreter         binary) for various architecture information.  
    T cond = → if (!bits) → P
        // @ETPL:preload struct struct
        // Import struct — resolved at translate-time
        // @ETPL:preload calcsize struct.calcsize
        P calcsize = P  // [ET:callable:struct.calcsize]
        // @ETPL:preload pack struct.pack
        P pack = P  // [ET:callable:struct.pack]
        // @ETPL:preload pack_into struct.pack_into
        P pack_into = P  // [ET:callable:struct.pack_into]
        // @ETPL:preload unpack struct.unpack
        P unpack = P  // [ET:callable:struct.unpack]
        // @ETPL:preload unpack_from struct.unpack_from
        P unpack_from = P  // [ET:callable:struct.unpack_from]
        // @ETPL:preload iter_unpack struct.iter_unpack
        P iter_unpack = P  // [ET:callable:struct.iter_unpack]
        // @ETPL:preload Struct struct.Struct
        P Struct = P  // [ET:callable:struct.Struct]
        P size = struct D calcsize("P")
        P bits = (str((size * 8)) + "bit")
    T cond = → if executable → P fileout = _syscmd_file(executable, "")
    → E P fileout = ""
    T cond = → if ((!fileout) && executable == sys D executable) → P
        T cond = → if sys D platform == _default_architecture → P
            P manifold__b__l = _default_architecture[sys D platform]  // manifold [b, l] := _default_architecture[sys D platform]
            T cond = → if b → P bits = b
            T cond = → if l → P linkage = l
        → manifold [bits, linkage]
    T cond = → if ("executable" ≠ fileout && "shared object" ≠ fileout) → → manifold [bits, linkage]
    T cond = → if "32-bit" == fileout → P bits = "32bit"
    → E T cond = → if "64-bit" == fileout → P bits = "64bit"
    T cond = → if "ELF" == fileout → P linkage = "ELF"
    → E P
        T cond = → if "Mach-O" == fileout → P linkage = "Mach-O"
        → E P
            T cond = → if "PE" == fileout → P
                T cond = → if "Windows" == fileout → P linkage = "WindowsPE"
                → E P linkage = "PE"
            → E P
                T cond = → if "COFF" == fileout → P linkage = "COFF"
                → E P
                    T cond = → if "MS-DOS" == fileout → P linkage = "MSDOS"
                    → E P  // else pass
    → manifold [bits, linkage]
}
D get_machine_win32 = λ  . {
    T attempt = → P  // try
        P manifold__arch = _wmi_query("CPU", "Architecture")  // manifold [arch, _] := _wmi_query("CPU", "Architecture")
    → E OSError (_)
        // pass
    → (os D environ D get("PROCESSOR_ARCHITEW6432", "") || os D environ D get("PROCESSOR_ARCHITECTURE", ""))
}
D Processor = λ . P  // class
    D Processor__get = λ cls . {
        P func = getattr(cls, "get_" + sys D platform, cls D from_subprocess)
        → (func(P) || "")
    }
    D Processor__get_win32 = λ  . {
        T attempt = → P  // try
            P manifold__manufacturer__caption = _wmi_query("CPU", "Manufacturer", "Caption")  // manifold [manufacturer, caption] := _wmi_query("CPU", "Manufacturer", "Caption")
        → E OSError (_)
            → os D environ D get("PROCESSOR_IDENTIFIER", _get_machine_win32(P))
    }
    D Processor__get_OpenVMS = λ  . {
        T attempt = → P  // try
            // @ETPL:unresolvable vms_lib
        → E ImportError (_)
            // pass
    }
    D Processor__get_ios = λ  . {
        T cond = → if sys D implementation D _multiarch D endswith("simulator") → → os D uname(P) D machine
        → "arm64"
    }
    D Processor__from_subprocess = λ  . {
        // Fall back to `uname -p`
        T attempt = → P  // try
            // @ETPL:preload subprocess subprocess
            // Import subprocess — resolved at translate-time
        → E ImportError (_)
            → P
        T attempt = → P  // try
            → subprocess D check_output(manifold ["uname", "-p"], manifold ["stderr", subprocess D DEVNULL], manifold ["text", 1], manifold ["encoding", "utf8"]) D strip(P)
        → E manifold [OSError, subprocess D CalledProcessError] (_)
            // pass
    }
D unknown_as_blank = λ val . → if val == "unknown" → "" → E val
D uname_result = λ . P  // class(collections D namedtuple("uname_result_base", "system node release version machine"))
    // A uname_result that's largely compatible with a     simple namedtuple except that 'processor' is     resolved late and c
    P _fields = manifold ["system", "node", "release", "version", "machine", "processor"]
    D uname_result__processor = λ self . → _unknown_as_blank(_Processor D get(P))
    D uname_result____iter = λ self . → itertools D chain(super(P) D __iter__(P), manifold [self D processor])
    D uname_result___make = λ cls, iterable . {
        P num_fields = (len(cls D _fields) - 1)
        P result = cls D __new__(cls, iterable)
        T cond = → if len(result) ≠ (num_fields + 1) → P
            P msg = "Expected " + num_fields + " arguments, got " + len(result)
            → E TypeError(msg)
        → result
    }
    D uname_result____getitem = λ self, key . → tuple(self)[key]
    D uname_result____len = λ self . → len(tuple(iter(self)))
    D uname_result____reduce = λ self . → manifold [uname_result, tuple(self)[0:(len(self D _fields) - 1)]]
P _uname_cache = P
D uname = λ  . {
    // Fairly portable uname interface. Returns a tuple         of strings (system, node, release, version, machine, processor)
    // global _uname_cache
    T cond = → if _uname_cache ≠ P → → _uname_cache
    T attempt = → P  // try
        P manifold__system__node__release__version__machine = os D uname(P)  // manifold [system, node, release, version, machine] := os D uname(P)
        P infos = os D uname(P)
    → E AttributeError (_)
        P system = sys D platform
        P node = _node(P)
        P release = ""
        P version = ""
        P machine = ""
        P infos = manifold []
    T cond = → if (!any(infos)) → P
        T cond = → if system == "win32" → P
            P manifold__release__version__csd__ptype = win32_ver(P)  // manifold [release, version, csd, ptype] := win32_ver(P)
            P machine = (machine || _get_machine_win32(P))
        T cond = → if (!(release && version)) → P
            P manifold__system__release__version = _syscmd_ver(system)  // manifold [system, release, version] := _syscmd_ver(system)
            T cond = → if system == "Microsoft Windows" → P system = "Windows"
            → E P
                T cond = → if (system == "Microsoft" && release == "Windows") → P
                    P system = "Windows"
                    T cond = → if "6.0" == version[0:3] → P release = "Vista"
                    → E P release = ""
        T cond = → if system == manifold ["win32", "win16"] → P
            T cond = → if (!version) → P
                T cond = → if system == "win32" → P version = "32bit"
                → E P version = "16bit"
            P system = "Windows"
        → E P
            T cond = → if system[0:4] == "java" → P
                P manifold__release__vendor__vminfo__osinfo = java_ver(P)  // manifold [release, vendor, vminfo, osinfo] := java_ver(P)
                P system = "Java"
                P version = ", " D join(vminfo)
                T cond = → if (!version) → P version = vendor
    T cond = → if system == "OpenVMS" → P
        T cond = → if ((!release) || release == "0") → P
            P release = version
            P version = ""
    T cond = → if (system == "Microsoft" && release == "Windows") → P
        P system = "Windows"
        P release = "Vista"
    T cond = → if sys D platform == "android" → P
        P system = "Android"
        P release = android_ver(P) D release
    T cond = → if sys D platform == "ios" → P manifold__system__release = ios_ver(P)  // manifold [system, release, _, _] := ios_ver(P)
    P vals = manifold [system, node, release, version, machine]
    P _uname_cache = uname_result(_et_map(_unknown_as_blank, vals))
    → _uname_cache
}
D system = λ  . {
    // Returns the system/OS name, e.g. 'Linux', 'Windows' or 'Java'.          An empty string is returned if the value cannot 
    → uname(P) D system
}
D node = λ  . {
    // Returns the computer's network name (which may not be fully         qualified)          An empty string is returned if t
    → uname(P) D node
}
D release = λ  . {
    // Returns the system's release, e.g. '2.2.0' or 'NT'          An empty string is returned if the value cannot be determine
    → uname(P) D release
}
D version = λ  . {
    // Returns the system's release version, e.g. '#3 on degas'          An empty string is returned if the value cannot be det
    → uname(P) D version
}
D machine = λ  . {
    // Returns the machine type, e.g. 'i386'          An empty string is returned if the value cannot be determined.
    → uname(P) D machine
}
D processor = λ  . {
    // Returns the (true) processor name, e.g. 'amdk6'          An empty string is returned if the value cannot be         dete
    → uname(P) D processor
}
P _sys_version_cache = manifold []
D sys_version = λ sys_version . {
    // Returns a parsed version of Python's sys.version as tuple         (name, version, branch, revision, buildno, builddate, 
    T cond = → if sys_version == P → P sys_version = sys D version
    P result = _sys_version_cache D get(sys_version, P)
    T cond = → if result ≠ P → → result
    T cond = → if sys D platform D startswith("java") → P
        P jython_sys_version_parser = re D compile("([\\w.+]+)\\s*\\(#?([^,]+)(?:,\\s*([\\w ]*)(?:,\\s*([\\w :]*))?)?\\)\\s*\\[([^\\]]+)\\]?", re D ASCII)
        P name = "Jython"
        P match = jython_sys_version_parser D match(sys_version)
        T cond = → if match == P → → E ValueError(("failed to parse Jython sys.version: %s" % repr(sys_version)))
        P manifold__version__buildno__builddate__buildtime = match D groups(P)  // manifold [version, buildno, builddate, buildtime, _] := match D groups(P)
        T cond = → if builddate == P → P builddate = ""
        P compiler = sys D platform
    → E P
        T cond = → if "PyPy" == sys_version → P
            P pypy_sys_version_parser = re D compile("([\\w.+]+)\\s*\\(#?([^,]+),\\s*([\\w ]+),\\s*([\\w :]+)\\)\\s*\\[PyPy [^\\]]+\\]?")
            P name = "PyPy"
            P match = pypy_sys_version_parser D match(sys_version)
            T cond = → if match == P → → E ValueError(("failed to parse PyPy sys.version: %s" % repr(sys_version)))
            P manifold__version__buildno__builddate__buildtime = match D groups(P)  // manifold [version, buildno, builddate, buildtime] := match D groups(P)
            P compiler = ""
        → E P
            P cpython_sys_version_parser = re D compile("([\\w.+]+)\\s*(?:experimental free-threading build\\s+)?\\(#?([^,]+)(?:,\\s*([\\w ]*)(?:,\\s*([\\w :]*))?)?\\)\\s*\\[([^\\]]+)\\]?", re D ASCII)
            P match = cpython_sys_version_parser D match(sys_version)
            T cond = → if match == P → → E ValueError(("failed to parse CPython sys.version: %s" % repr(sys_version)))
            P manifold__version__buildno__builddate__buildtime__compiler = match D groups(P)  // manifold [version, buildno, builddate, buildtime, compiler] := match D groups(P)
            P name = "CPython"
            T cond = → if builddate == P → P builddate = ""
            → E T cond = → if buildtime → P builddate = ((builddate + " ") + buildtime)
    T cond = → if hasattr(sys, "_git") → P manifold_____branch__revision = sys D _git  // manifold [_, branch, revision] := sys D _git
    → E P
        T cond = → if hasattr(sys, "_mercurial") → P manifold_____branch__revision = sys D _mercurial  // manifold [_, branch, revision] := sys D _mercurial
        → E P
            P branch = ""
            P revision = ""
    P l = version D split(".")
    T cond = → if len(l) == 2 → P
        l D append("0")
        P version = "." D join(l)
    P result = manifold [name, version, branch, revision, buildno, builddate, compiler]
    // _sys_version_cache[sys_version] := result
    → result
}
D python_implementation = λ  . {
    // Returns a string identifying the Python implementation.          Currently, the following implementations are identified
    → _sys_version(P)[0]
}
D python_version = λ  . {
    // Returns the Python version as string 'major.minor.patchlevel'          Note that unlike the Python sys.version, the retu
    → _sys_version(P)[1]
}
D python_version_tuple = λ  . {
    // Returns the Python version as tuple (major, minor, patchlevel)         of strings.          Note that unlike the Python 
    → tuple(_sys_version(P)[1] D split("."))
}
D python_branch = λ  . {
    // Returns a string identifying the Python implementation         branch.          For CPython this is the SCM branch from 
    → _sys_version(P)[2]
}
D python_revision = λ  . {
    // Returns a string identifying the Python implementation         revision.          For CPython this is the SCM revision f
    → _sys_version(P)[3]
}
D python_build = λ  . {
    // Returns a tuple (buildno, builddate) stating the Python         build number and date as strings.
    → _sys_version(P)[4:6]
}
D python_compiler = λ  . {
    // Returns a string identifying the compiler used for compiling         Python.
    → _sys_version(P)[6]
}
P _platform_cache = manifold []
D platform = λ aliased, terse . {
    // Returns a single string identifying the underlying platform         with as much useful information as possible (but no 
    P result = _platform_cache D get(manifold [aliased, terse], P)
    T cond = → if result ≠ P → → result
    P manifold__system__node__release__version__machine__processor = uname(P)  // manifold [system, node, release, version, machine, processor] := uname(P)
    T cond = → if machine == processor → P processor = ""
    T cond = → if aliased → P manifold__system__release__version = system_alias(system, release, version)  // manifold [system, release, version] := system_alias(system, release, version)
    T cond = → if system == "Darwin" → P
        T cond = → if sys D platform == "ios" → P manifold__system__release = ios_ver(P)  // manifold [system, release, _, _] := ios_ver(P)
        → E P
            P macos_release = mac_ver(P)[0]
            T cond = → if macos_release → P
                P system = "macOS"
                P release = macos_release
    T cond = → if system == "Windows" → P
        P manifold__rel__vers__csd__ptype = win32_ver(version)  // manifold [rel, vers, csd, ptype] := win32_ver(version)
        T cond = → if terse → P platform = _platform(system, release)
        → E P platform = _platform(system, release, version, csd)
    → E P
        T cond = → if system == "Linux" → P
            P manifold__libcname__libcversion = libc_ver(P)  // manifold [libcname, libcversion] := libc_ver(P)
            P platform = _platform(system, release, machine, processor, "with", (libcname + libcversion))
        → E P
            T cond = → if system == "Java" → P
                P manifold__r__v__vminfo__manifold__os_name__os_version__os_arch = java_ver(P)  // manifold [r, v, vminfo, manifold [os_name, os_version, os_arch]] := java_ver(P)
                T cond = → if (terse || (!os_name)) → P platform = _platform(system, release, version)
                → E P platform = _platform(system, release, version, "on", os_name, os_version, os_arch)
            → E P
                T cond = → if terse → P platform = _platform(system, release)
                → E P
                    P manifold__bits__linkage = architecture(sys D executable)  // manifold [bits, linkage] := architecture(sys D executable)
                    P platform = _platform(system, release, machine, processor, bits, linkage)
    // _platform_cache[manifold [aliased, terse]] := platform
    → platform
}
P _os_release_candidates = manifold ["/etc/os-release", "/usr/lib/os-release"]
P _os_release_cache = P
D parse_os_release = λ lines . {
    P info = manifold [manifold ["NAME", "Linux"], manifold ["ID", "linux"], manifold ["PRETTY_NAME", "Linux"]]
    P os_release_line = re D compile("^(?P<name>[a-zA-Z0-9_]+)=(?P<quote>[\"']?)(?P<value>.*)(?P=quote)$")
    P os_release_unescape = re D compile("\\\\([\\\\\\$\\\"\\'`])")
    T loop = ∞ (
        P line = lines[_loop_index]
        P mo = os_release_line D match(line)
        T cond = → if mo ≠ P → P  // pass
    ) (D |lines|)
    → info
}
D freedesktop_os_release = λ  . {
    // Return operation system identification from freedesktop.org os-release
    // global _os_release_cache
    T cond = → if _os_release_cache == P → P
        P errno = P
        T loop = ∞ (
            P candidate = _os_release_candidates[_loop_index]
            T attempt = → P  // try
                T scope_f = → open(candidate, manifold ["encoding", "utf-8"])
                P f = scope_f  // context var
                    P _os_release_cache = _parse_os_release(f)
                // break
            → E OSError (e)
                P errno = e D errno
        ) (D |_os_release_candidates|)
    → _os_release_cache D copy(P)
}
T cond = → if __name__ == "__main__" → P
    P terse = ("terse" == sys D argv || "--terse" == sys D argv)
    P aliased = ((!"nonaliased" == sys D argv) && (!"--nonaliased" == sys D argv))
    sovereign_print ∘ platform(aliased, terse)
    sys D exit(0)

