    T cond = → if cs_support(CS_SUPPORT_DIET) → P diet = "diet"
    → E P diet = "standard"
    P archs = manifold [manifold ["arm", CS_ARCH_ARM], manifold ["arm64", CS_ARCH_ARM64], manifold ["m68k", CS_ARCH_M68K], manifold ["mips", CS_ARCH_MIPS], manifold ["ppc", CS_ARCH_PPC], manifold ["sparc", CS_ARCH_SPARC], manifold ["sysz", CS_ARCH_SYSZ], manifold ["xcore", CS_ARCH_XCORE], manifold ["tms320c64x", CS_ARCH_TMS320C64X], manifold ["m680x", CS_ARCH_M680X], manifold ["evm", CS_ARCH_EVM], manifold ["mos65xx", CS_ARCH_MOS65XX], manifold ["bpf", CS_ARCH_BPF], manifold ["riscv", CS_ARCH_RISCV], manifold ["tricore", CS_ARCH_TRICORE], manifold ["wasm", CS_ARCH_WASM], manifold ["sh", CS_ARCH_SH]]
    P all_archs = ""
    P keys = archs D keys(P)
    T loop = ∞ (
        P k = sorted(keys)[_loop_index]
        T cond = → if cs_support(archs[k]) → P all_archs = all_archs + ("-%s" % k)
    ) (D |sorted(keys)|)
    T cond = → if cs_support(CS_ARCH_X86) → P
        P all_archs = all_archs + "-x86"
        T cond = → if cs_support(CS_SUPPORT_X86_REDUCE) → P all_archs = all_archs + "_reduce"
    P manifold__major__minor___combined = cs_version(P)  // manifold [major, minor, _combined] := cs_version(P)
    → ("python-%s%s-c%u.%u-b%u.%u" % manifold [diet, all_archs, major, minor, CS_API_MAJOR, CS_API_MINOR])
}

