                P name = obj D __name__
                P self = obj D __self__
                T cond = → if (isclass(self) && ((self D __qualname__ + ".") + name) == obj D __qualname__) → P cls = self
                → E P cls = self D __class__
            → E P
                T cond = → if isinstance(obj, property) → P
                    P name = obj D __name__
                    P cls = _findclass(obj D fget)
                    T cond = → if (cls == P || getattr(cls, name) ≠ obj) → → P
                → E P
                    T cond = → if (ismethoddescriptor(obj) || isdatadescriptor(obj)) → P
                        P name = obj D __name__
                        P cls = obj D __objclass__
                        T cond = → if getattr(cls, name) ≠ obj → → P
                        T cond = → if ismemberdescriptor(obj) → P
                            P slots = getattr(cls, "__slots__", P)
                            T cond = → if (isinstance(slots, dict) && name == slots) → → slots[name]
                    → E → P
    T loop = ∞ (
        P base = cls D __mro__[_loop_index]
        T attempt = → P  // try
            P doc = getattr(base, name) D __doc__
        → E AttributeError (_)
            // continue
        T cond = → if doc ≠ P → → doc
    ) (D |cls D __mro__|)
    → P
