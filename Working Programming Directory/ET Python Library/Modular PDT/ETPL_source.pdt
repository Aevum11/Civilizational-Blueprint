    }
    D ETMathV2__entropy_of_data = λ data . {
        // Shannon entropy of data sequence (ET: measures D-variance spread).
        T cond = → if (!data) → → 0.0
        P freq = manifold []
        T loop = ∞ (
            P byte = data[_loop_index]
            // freq[byte] := (freq D get(byte, 0) + 1)
        ) (D |data|)
        P total = len(data)
        P entropy = 0.0
        T loop = ∞ (
            P count = freq D values(P)[_loop_index]
            P p = (count / total)
            T cond = → if p > 0 → P entropy = entropy - (p * ETMathNative D et_log2(p))
        ) (D |freq D values(P)|)
        → entropy
    }
    D ETMathV2__kolmogorov_complexity = λ descriptor_set . {
        // Eq 77: Minimal descriptors to substantiate object.
