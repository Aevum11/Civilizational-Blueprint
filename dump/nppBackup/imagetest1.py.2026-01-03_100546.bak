import tkinter as tk
from tkinter import filedialog, messagebox
import threading
import sys
import math

try:
    from PIL import Image, ImageTk, ImageDraw, ImageFilter
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: ADAPTIVE RESONANCE (SMART UNBINDING)
# ==============================================================================

class ET_Adaptive_Engine:
    """
    Implements Edge-Preserving De-Occlusion.
    D_final = (P_raw - Veil_Texture) + Protected_Structure
    """
    
    def process_layer(self, img_pil, mask_pil, threshold, removal_str, detail_boost, status_cb):
        width, height = img_pil.size
        pixels = img_pil.load()
        mask = mask_pil.load()
        
        # 1. GENERATE FREQUENCY MAPS
        status_cb("Mapping Manifold Structure...")
        
        # A. The Blur (Low Freq Base)
        # We use BoxBlur for speed in Pure Python, approximates the "Average"
        blur_img = img_pil.filter(ImageFilter.BoxBlur(2))
        blur_pix = blur_img.load()
        
        # B. The Structure Map (High Freq)
        # This contains BOTH the Veil Texture AND the Object Edges.
        # We need to filter this.
        
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        min_x, min_y, max_x, max_y = bbox
        
        updates = []
        
        # Factors
        thresh_sq = threshold * threshold # Use squared distance to avoid sqrt (faster)
        rem_factor = removal_str / 100.0
        boost_factor = 1.0 + (detail_boost / 50.0)
        
        # 2. THE ADAPTIVE LOOP
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                if mask[x, y] == 0: continue
                
                # Raw Reality (P)
                p = pixels[x, y]
                # Low Freq Baseline (L)
                l = blur_pix[x, y]
                
                # Calculate the Difference Vector (The "Detail")
                dr = p[0] - l[0]
                dg = p[1] - l[1]
                db = p[2] - l[2]
                
                # Calculate Magnitude of Difference (Energy)
                energy = (dr*dr + dg*dg + db*db)
                
                # --- ET LOGIC: THE DECISION (Rule 214) ---
                
                # If Energy > Threshold, it is an EDGE (Structure). Keep it.
                # If Energy < Threshold, it is TEXTURE (Veil). Remove it.
                
                is_structure = False
                if energy > thresh_sq:
                    is_structure = True
                    
                # New Pixel Calculation
                new_r, new_g, new_b = p[0], p[1], p[2]
                
                if is_structure:
                    # It's an edge (e.g. outline of the object).
                    # We do NOT remove it. We actually AMPLIFY it (Detail Boost).
                    new_r = l[0] + (dr * boost_factor)
                    new_g = l[1] + (dg * boost_factor)
                    new_b = l[2] + (db * boost_factor)
                else:
                    # It's texture (e.g. weave of curtain).
                    # We REMOVE it by pushing towards the Low Freq Baseline.
                    new_r = p[0] - (dr * rem_factor)
                    new_g = p[1] - (dg * rem_factor)
                    new_b = p[2] - (db * rem_factor)
                    
                    # Contrast Correction for the smoothed area
                    # (Prevents "muddy" look)
                    # We slightly boost the Low Freq signal itself
                    new_r = (new_r - 128) * 1.05 + 128
                    new_g = (new_g - 128) * 1.05 + 128
                    new_b = (new_b - 128) * 1.05 + 128

                # Clamp
                updates.append((x, y, (
                    int(max(0, min(255, new_r))),
                    int(max(0, min(255, new_g))),
                    int(max(0, min(255, new_b)))
                )))
        
        # Apply Updates
        for ux, uy, uval in updates:
            pixels[ux, uy] = uval
            
        return img_pil

# ==============================================================================
# GUI
# ==============================================================================

class ET_V13_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V13: ADAPTIVE RESONANCE (EDGE PRESERVER)")
        self.root.geometry("1200x900")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Adaptive_Engine()
        self.pil_img = None
        self.mask_img = None
        
        self._layout()

    def _layout(self):
        t = tk.Frame(self.root, bg="#101010", pady=5)
        t.pack(fill=tk.X)
        
        self.btn(t, "LOAD IMAGE", self.load, "#004488")
        self.btn(t, "RESET", self.reset, "#882200")
        self.btn(t, "ADAPTIVE UNBIND", self.run, "#228822")
        
        # 1. EDGE THRESHOLD: The "Smart" Slider
        # Low = Everything is an edge (Nothing removed)
        # High = Everything is texture (Everything smoothed)
        # Sweet Spot = 15-30
        tk.Label(t, text="EDGE LOCK:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.thr_scale = tk.Scale(t, from_=5, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.thr_scale.set(20) 
        self.thr_scale.pack(side=tk.LEFT)
        
        # 2. REMOVAL FORCE: How much to smooth the non-edges
        tk.Label(t, text="VEIL MELT:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.rem_scale = tk.Scale(t, from_=0, to=150, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.rem_scale.set(100)
        self.rem_scale.pack(side=tk.LEFT)
        
        # 3. DETAIL BOOST: Amplifies the protected edges
        tk.Label(t, text="DETAIL AMP:", fg="white", bg="#101010").pack(side=tk.LEFT, padx=5)
        self.det_scale = tk.Scale(t, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0")
        self.det_scale.set(20)
        self.det_scale.pack(side=tk.LEFT)

        self.stat = tk.Label(t, text="Ready.", fg="#888", bg="#101010")
        self.stat.pack(side=tk.RIGHT, padx=20)
        
        # Canvas
        container = tk.Frame(self.root)
        container.pack(fill=tk.BOTH, expand=True)
        self.cv = tk.Canvas(container, bg="#080808", cursor="crosshair")
        vs = tk.Scrollbar(container, orient="vertical", command=self.cv.yview)
        hs = tk.Scrollbar(container, orient="horizontal", command=self.cv.xview)
        self.cv.config(yscrollcommand=vs.set, xscrollcommand=hs.set)
        
        vs.pack(side=tk.RIGHT, fill=tk.Y)
        hs.pack(side=tk.BOTTOM, fill=tk.X)
        self.cv.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.cv.bind("<Button-1>", self.down)
        self.cv.bind("<B1-Motion>", self.drag)
        self.cv.bind("<ButtonRelease-1>", self.up)
        
        self.drawing=False; self.brush=30

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", relief="flat", padx=10).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            self.pil_img = Image.open(path).convert("RGB")
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            self.cv.config(scrollregion=(0,0,self.pil_img.width,self.pil_img.height))
            self.update_view()
            self.stat.config(text=f"Loaded: {self.pil_img.size}")
        except: pass

    def update_view(self):
        if not self.pil_img: return
        d = self.pil_img.copy()
        if self.mask_img.getbbox():
            r = Image.new("RGB", self.pil_img.size, (255,255,0)) # Yellow mask
            d = Image.composite(r, d, self.mask_img)
        self.tk = ImageTk.PhotoImage(d)
        self.cv.create_image(0,0, image=self.tk, anchor=tk.NW)

    def down(self,e): 
        x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
        self.drawing=True; self.lp=(x,y)
        
    def drag(self,e):
        if self.drawing and self.mask_img:
            x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
            d = ImageDraw.Draw(self.mask_img)
            d.line([self.lp, (x,y)], fill=128, width=self.brush)
            d.ellipse([x-15,y-15,x+15,y+15], fill=128)
            self.lp=(x,y); 
            self.cv.create_line(self.lp[0],self.lp[1],x,y,fill="yellow",width=self.brush,tags="t")

    def up(self,e): self.drawing=False; self.cv.delete("t"); self.update_view()
    
    def reset(self):
        if self.mask_img: self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height]); self.update_view()

    def run(self):
        if not self.pil_img: return
        self.stat.config(text="Processing Adaptive Manifold...")
        thr = self.thr_scale.get()
        rem = self.rem_scale.get()
        det = self.det_scale.get()
        threading.Thread(target=self._w, args=(thr,rem,det)).start()

    def _w(self, t, r, d):
        res = self.engine.process_layer(self.pil_img, self.mask_img, t, r, d, self.log)
        self.pil_img = res
        self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
        self.root.after(0, self.update_view)
        self.root.after(0, lambda: self.stat.config(text="Structure Preserved. Veil Removed."))

    def log(self, m): self.stat.config(text=m)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_V13_GUI(root)
    root.mainloop()