# ============================================================================
# KERNEL-LEVEL K=2/3 ENFORCEMENT — BEFORE ANY LIBRARY IMPORTS
# The Koide ceiling is enforced at the OS level. The process is structurally
# unable to exceed 2/3 of system resources. This is non-negotiable.
# ============================================================================

_K_KOIDE = 2.0 / 3.0
_N_CORES = os.cpu_count() or 1
_MAX_THREADS = max(1, int(_N_CORES * _K_KOIDE))

# Limit numpy/scipy/openblas thread count BEFORE they are imported
os.environ['OMP_NUM_THREADS'] = str(_MAX_THREADS)
os.environ['MKL_NUM_THREADS'] = str(_MAX_THREADS)
os.environ['OPENBLAS_NUM_THREADS'] = str(_MAX_THREADS)
os.environ['NUMEXPR_NUM_THREADS'] = str(_MAX_THREADS)
os.environ['VECLIB_MAXIMUM_THREADS'] = str(_MAX_THREADS)
os.environ['BLIS_NUM_THREADS'] = str(_MAX_THREADS)

def _enforce_kernel_hard_cap():
    """
    Enforce K=2/3 at the kernel level. Called once at module load.
    
    Windows:
      1. SetProcessWorkingSetSizeEx with QUOTA_LIMITS_HARDWS_MAX_ENABLE
         — hard limit on physical memory, kernel-enforced
      2. SetProcessAffinityMask — limit to floor(K × cores) cores
      3. SetPriorityClass — BELOW_NORMAL
      4. Job Object with JOB_OBJECT_LIMIT_PROCESS_MEMORY and CPU rate control
    
    Linux:
      resource.setrlimit(RLIMIT_AS) — hard virtual memory cap
    
    The process CANNOT exceed these limits. malloc returns NULL / raises
    MemoryError if it would breach the cap.
    """
    if sys.platform == 'win32':
        try:
            kernel32 = ctypes.windll.kernel32
            process = kernel32.GetCurrentProcess()
            
            # ── 1. WORKING SET HARD LIMIT ─────────────────────────────
            # This is the most reliable kernel-level memory enforcement
            class MEMORYSTATUSEX(ctypes.Structure):
                _fields_ = [
                    ('dwLength', ctypes.c_ulong),
                    ('dwMemoryLoad', ctypes.c_ulong),
                    ('ullTotalPhys', ctypes.c_ulonglong),
                    ('ullAvailPhys', ctypes.c_ulonglong),
                    ('ullTotalPageFile', ctypes.c_ulonglong),
                    ('ullAvailPageFile', ctypes.c_ulonglong),
                    ('ullTotalVirtual', ctypes.c_ulonglong),
                    ('ullAvailVirtual', ctypes.c_ulonglong),
                    ('ullAvailExtendedVirtual', ctypes.c_ulonglong),
                ]
            mem_status = MEMORYSTATUSEX()
            mem_status.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
            kernel32.GlobalMemoryStatusEx(ctypes.byref(mem_status))
            total_ram = mem_status.ullTotalPhys
            cap_bytes = int(total_ram * _K_KOIDE)
            
            # SetProcessWorkingSetSizeEx with HARD cap flag
            QUOTA_LIMITS_HARDWS_MAX_ENABLE = 0x00000004
            QUOTA_LIMITS_HARDWS_MIN_DISABLE = 0x00000002
            min_ws = 1024 * 1024 * 64  # 64 MB minimum working set
            
            result = kernel32.SetProcessWorkingSetSizeEx(
                process,
                ctypes.c_size_t(min_ws),
                ctypes.c_size_t(cap_bytes),
                ctypes.c_ulong(QUOTA_LIMITS_HARDWS_MAX_ENABLE |
                               QUOTA_LIMITS_HARDWS_MIN_DISABLE))
            
            if result:
                print(f"  KERNEL HARD CAP — Working set: {cap_bytes/1024**3:.1f} GB "
                      f"(K={_K_KOIDE:.4f} × {total_ram/1024**3:.1f} GB)")
            else:
                print(f"  Working set cap: failed (error {kernel32.GetLastError()})")
            
            # ── 2. CPU AFFINITY ───────────────────────────────────────
            affinity_mask = (1 << _MAX_THREADS) - 1
            kernel32.SetProcessAffinityMask(process, ctypes.c_size_t(affinity_mask))
            print(f"  KERNEL HARD CAP — CPU affinity: {_MAX_THREADS} of {_N_CORES} cores "
                  f"(mask=0x{affinity_mask:X})")
            
            # ── 3. PRIORITY ───────────────────────────────────────────
            BELOW_NORMAL_PRIORITY_CLASS = 0x00004000
            kernel32.SetPriorityClass(process, BELOW_NORMAL_PRIORITY_CLASS)
            print(f"  KERNEL HARD CAP — Priority: BELOW_NORMAL")
            
            # ── 4. JOB OBJECT (memory + CPU) ──────────────────────────
            class IO_COUNTERS(ctypes.Structure):
                _fields_ = [('ReadOperationCount', ctypes.c_ulonglong),
                            ('WriteOperationCount', ctypes.c_ulonglong),
                            ('OtherOperationCount', ctypes.c_ulonglong),
                            ('ReadTransferCount', ctypes.c_ulonglong),
                            ('WriteTransferCount', ctypes.c_ulonglong),
                            ('OtherTransferCount', ctypes.c_ulonglong)]
            
            class JOBOBJECT_BASIC_LIMIT_INFORMATION(ctypes.Structure):
                _fields_ = [('PerProcessUserTimeLimit', ctypes.c_longlong),
                            ('PerJobUserTimeLimit', ctypes.c_longlong),
                            ('LimitFlags', ctypes.c_ulong),
                            ('MinimumWorkingSetSize', ctypes.c_size_t),
                            ('MaximumWorkingSetSize', ctypes.c_size_t),
                            ('ActiveProcessLimit', ctypes.c_ulong),
                            ('Affinity', ctypes.c_size_t),
                            ('PriorityClass', ctypes.c_ulong),
                            ('SchedulingClass', ctypes.c_ulong)]
            
            class JOBOBJECT_EXTENDED_LIMIT_INFORMATION(ctypes.Structure):
                _fields_ = [('BasicLimitInformation', JOBOBJECT_BASIC_LIMIT_INFORMATION),
                            ('IoInfo', IO_COUNTERS),
                            ('ProcessMemoryLimit', ctypes.c_size_t),
                            ('JobMemoryLimit', ctypes.c_size_t),
                            ('PeakProcessMemoryUsed', ctypes.c_size_t),
                            ('PeakJobMemoryUsed', ctypes.c_size_t)]
            
            job = kernel32.CreateJobObjectW(None, None)
            if job:
                JOB_OBJECT_LIMIT_PROCESS_MEMORY = 0x00000100
                info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION()
                info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_PROCESS_MEMORY
                info.ProcessMemoryLimit = cap_bytes
                
                kernel32.SetInformationJobObject(
                    job, 9, ctypes.byref(info), ctypes.sizeof(info))
                kernel32.AssignProcessToJobObject(job, process)
                print(f"  KERNEL HARD CAP — Job object: {cap_bytes/1024**3:.1f} GB commit limit")
            
        except (OSError, AttributeError, ValueError) as e:
            print(f"  Kernel enforcement error: {e}")
    else:
        try:
            import resource
            mem_bytes = os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES')
            cap = int(mem_bytes * _K_KOIDE)
            resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
            print(f"  KERNEL HARD CAP — RLIMIT_AS: {cap/1024**3:.1f} GB")
        except (ImportError, ValueError, OSError) as e:
            print(f"  Kernel enforcement error: {e}")
    
    print(f"  Thread limits: OMP/MKL/BLAS = {_MAX_THREADS}")

# Execute IMMEDIATELY — before any numpy/scipy import
print("=" * 60)
print("ET METABOLISM — KERNEL-LEVEL K=2/3 ENFORCEMENT")
print("=" * 60)
_enforce_kernel_hard_cap()
print("=" * 60)

