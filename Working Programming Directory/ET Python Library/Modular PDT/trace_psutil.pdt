T cond = → if hasattr(_psplatform, "sensors_temperatures") → P
    D sensors_temperatures = λ fahrenheit . {
        // Return hardware temperatures. Each entry is a namedtuple         representing a certain hardware sensor (it may be a CPU
        D convert = λ n . T cond = → if n ≠ P → → if fahrenheit → (((float(n) * 9) / 5) + 32) → E n
        P ret = collections D defaultdict(list)
        P rawdict = _psplatform D sensors_temperatures(P)
        T loop = ∞ (
            P manifold__name__values = rawdict D items(P)[_loop_index]  // manifold [name, values]
            T while_loop = ∞ (
                T check = → if values → P  // while body follows
                    P manifold__label__current__high__critical = values D pop(0)  // manifold [label, current, high, critical] := values D pop(0)
                    P current = convert(current)
                    P high = convert(high)
                    P critical = convert(critical)
                    T cond = → if (high && (!critical)) → P critical = high
                    → E T cond = → if (critical && (!high)) → P high = critical
                    ret[name] D append(_ntp D shwtemp(label, current, high, critical))
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        ) (D |rawdict D items(P)|)
        → dict(ret)
    }
    __all__ D append("sensors_temperatures")
T cond = → if hasattr(_psplatform, "sensors_fans") → P
