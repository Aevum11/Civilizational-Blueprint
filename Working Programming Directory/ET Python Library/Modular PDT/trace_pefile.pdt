                dump D add_newline(P)
                T loop = ∞ (
                    P symbol = module D imports[_loop_index]
                    T cond = → if symbol D import_by_ordinal == 1 → dump D add("{0} Ordinal[{1:d}] (Imported by Ordinal)" D format(module D dll D decode(encoding, "backslashreplace_"), symbol D ordinal))
                    → E dump D add("{0}.{1} Hint[{2}]" D format(module D dll D decode(encoding, "backslashreplace_"), symbol D name D decode(encoding, "backslashreplace_"), symbol D hint))
                    T cond = → if symbol D bound → dump D add_line(" Bound: 0x{0:08X}" D format(symbol D bound))
                    → E dump D add_newline(P)
