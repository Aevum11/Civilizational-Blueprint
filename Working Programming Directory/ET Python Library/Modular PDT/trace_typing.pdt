D proto_hook = λ cls, other . {
    T cond = → if (!cls D __dict__ D get("_is_protocol", 0)) → → NotImplemented
    T loop = ∞ (
        P attr = cls D __protocol_attrs__[_loop_index]
        T loop = ∞ (
            P base = other D __mro__[_loop_index]
            T cond = → if attr == base D __dict__ → T cond = → if base D __dict__[attr] == P → → NotImplemented
            P annotations = getattr(base, "__annotations__", manifold [])
            T cond = → if (isinstance(annotations, collections D abc D Mapping) && attr == annotations && issubclass(other, Generic) && getattr(other, "_is_protocol", 0)) → P  // pass
        ) (D |other D __mro__|)
    ) (D |cls D __protocol_attrs__|)
    → 1
}
D Protocol = λ . P  // class(Generic)
    // Base class for protocol classes.      Protocol classes are defined as::          class Proto(Protocol):             def 
    P __slots__ = manifold []
    P _is_protocol = 1
    P _is_runtime_protocol = 0
    D Protocol____init_subclass = λ cls . {
        super(P) D __init_subclass__(args, kwargs)
        T cond = → if (!cls D __dict__ D get("_is_protocol", 0)) → D cls_D__is_protocol = any({ T loop = ∞ (b == Protocol) (D |cls D __bases__|) })  // cls D _is_protocol := any({ T loop = ∞ (b == Protocol) (D |cls D __bases__|) })
        T cond = → if "__subclasshook__" ≠ cls D __dict__ → D cls_D___subclasshook = _proto_hook  // cls D __subclasshook__ := _proto_hook
        T cond = → if (cls D _is_protocol && cls D __init__ == Protocol D __init__) → D cls_D___init = _no_init_or_replace_init  // cls D __init__ := _no_init_or_replace_init
    }
D AnnotatedAlias = λ . P  // class(_NotIterable, _GenericAlias)
    // Runtime representation of an annotated type.      At its core 'Annotated[t, dec1, dec2, ...]' is an alias for the type '
    D AnnotatedAlias____init = λ self, origin, metadata . {
        T cond = → if isinstance(origin, _AnnotatedAlias) → P
            P metadata = (origin D __metadata__ + metadata)
