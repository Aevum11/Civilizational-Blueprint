package com.et.physics.toolbox

import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.Path
import android.util.AttributeSet
import android.view.View
import kotlin.math.min
import kotlin.math.cos
import kotlin.math.sin

/**
 * VisualizerView v10.2
 * - History Graph: Pressure (Yellow), Temp (Red), SPL (Cyan), Vib (Magenta)
 */
class VisualizerView(context: Context, attrs: AttributeSet) : View(context, attrs) {

    private val paint = Paint().apply { isAntiAlias = true; style = Paint.Style.FILL }
    private val textPaint = Paint().apply { color = Color.WHITE; textSize = 30f; textAlign = Paint.Align.CENTER }
    private val graphPaint = Paint().apply { style = Paint.Style.STROKE; strokeWidth = 3f; isAntiAlias = true }

    var pitch: Double = 0.0; var roll: Double = 0.0
    var vibration: Double = 0.0; var spl: Double = 0.0; var lux: Double = 0.0
    var azimuth: Double = 0.0; var pressure: Double = 0.0; var tempC: Double? = null
    
    private val historySize = 600
    private val splHistory = FloatArray(historySize)
    private val vibHistory = FloatArray(historySize)
    private val pressHistory = FloatArray(historySize)
    private val tempHistory = FloatArray(historySize)
    private var historyIdx = 0
    private var updateCounter = 0

    fun update(p: Double, r: Double, v: Double, s: Double, l: Double, a: Double, press: Double, t: Double?) {
        pitch = p; roll = r; vibration = v; spl = s; lux = l; azimuth = a; pressure = press; tempC = t
        updateCounter++
        if (updateCounter % 10 == 0) { 
            splHistory[historyIdx] = s.toFloat()
            vibHistory[historyIdx] = v.toFloat()
            pressHistory[historyIdx] = press.toFloat()
            tempHistory[historyIdx] = t?.toFloat() ?: 0f
            historyIdx = (historyIdx + 1) % historySize
        }
        invalidate()
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        canvas.drawColor(Color.parseColor("#111111"))

        val w = width.toFloat(); val h = height.toFloat()
        val cx = w * 0.25f; val cy = h / 2 // Move gauge left

        // 1. Bubble Level & Compass
        val bubbleR = h / 3.5f
        paint.color = Color.DKGRAY; paint.style = Paint.Style.STROKE
        canvas.drawCircle(cx, cy, bubbleR + 20f, paint) // Compass Ring
        
        paint.color = Color.RED; paint.style = Paint.Style.FILL
        val rad = Math.toRadians(azimuth - 90) 
        canvas.drawCircle(cx + (bubbleR + 20f) * cos(rad).toFloat(), cy + (bubbleR + 20f) * sin(rad).toFloat(), 8f, paint)
        
        paint.color = Color.DKGRAY; paint.style = Paint.Style.STROKE
        canvas.drawCircle(cx, cy, bubbleR, paint)
        paint.color = Color.WHITE
        canvas.drawCircle(cx, cy, bubbleR, paint) // Inner Level
        
        val maxTilt = 45.0
        val bbx = cx + (roll.coerceIn(-maxTilt, maxTilt) / maxTilt * (bubbleR-20)).toFloat()
        val bby = cy + (pitch.coerceIn(-maxTilt, maxTilt) / maxTilt * (bubbleR-20)).toFloat()
        paint.style = Paint.Style.FILL; paint.color = if (Math.abs(roll) < 1 && Math.abs(pitch) < 1) Color.GREEN else Color.YELLOW
        canvas.drawCircle(bbx, bby, 15f, paint)

        // 2. History Graph (Right 60%)
        val gx = w * 0.45f; val gy = 50f; val gw = w * 0.50f; val gh = h - 100f
        paint.color = Color.parseColor("#222222"); paint.style = Paint.Style.FILL
        canvas.drawRect(gx, gy, gx + gw, gy + gh, paint)
        paint.color = Color.DKGRAY; paint.style = Paint.Style.STROKE
        canvas.drawRect(gx, gy, gx + gw, gy + gh, paint)
        
        drawHistory(canvas, splHistory, gx, gy, gw, gh, 30f, 100f, Color.CYAN)
        drawHistory(canvas, vibHistory, gx, gy, gw, gh, 0f, 10f, Color.MAGENTA)
        
        // Auto-scale Pressure
        var minP = 2000f; var maxP = 0f
        for(p in pressHistory) if(p>0){ if(p<minP) minP=p; if(p>maxP) maxP=p }
        if(maxP > 0) drawHistory(canvas, pressHistory, gx, gy, gw, gh, minP-1f, maxP+1f, Color.YELLOW)
        
        // Temp (Red)
        drawHistory(canvas, tempHistory, gx, gy, gw, gh, 0f, 50f, Color.RED)
        
        canvas.drawText("Cyan=dB Mag=Vib Yel=hPa Red=°C", gx + gw/2, gy + gh + 40f, textPaint)
    }
    
    private fun drawHistory(canvas: Canvas, data: FloatArray, x: Float, y: Float, w: Float, h: Float, min: Float, max: Float, color: Int) {
        graphPaint.color = color
        val path = Path()
        var first = true
        val range = if((max-min) < 0.1) 1f else max-min
        
        for (i in 0 until historySize) {
            val idx = (historyIdx + i) % historySize
            val `val` = data[idx]
            if (`val` != 0f) { // Skip empty history
                val px = x + (i.toFloat() / historySize) * w
                val py = y + h - ((`val`.coerceIn(min, max) - min) / range) * h
                if (first) { path.moveTo(px, py); first = false } else path.lineTo(px, py)
            }
        }
        if(!first) canvas.drawPath(path, graphPaint)
    }
}