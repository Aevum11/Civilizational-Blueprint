        T cond = → if rich_index == (-1) → → P
        T attempt = → P  // try
            P rich_data = self D __data__[128:(rich_index + 8)]
            P rich_data = rich_data[0:(4 * (len(rich_data) ÷ 4))]
            P data = list(struct D unpack("<{0}I" D format((len(rich_data) ÷ 4)), rich_data))
            T cond = → if RICH ≠ data → → P
        → E PEFormatError (_)
            → P
        P key = struct D pack("<L", data[(data D index(RICH) + 1)])
        P result = manifold [manifold ["key", key]]
        P raw_data = rich_data[0:rich_data D find(b'Rich')]
        // result["raw_data"] := raw_data
        P ord_ = λ c . if (!isinstance(c, int)) → ord(c) → E c
        P clear_data = bytearray(P)
        T loop = ∞ (
            P manifold__idx__val = enumerate(raw_data)[_loop_index]  // manifold [idx, val]
            clear_data D append((ord_(val) ^ ord_(key[(idx % len(key))])))
        ) (D |enumerate(raw_data)|)
        // result["clear_data"] := bytes(clear_data)
        P checksum = int D from_bytes(key, "little")
        T cond = → if ((data[0] ^ checksum) ≠ DANS || data[1] ≠ checksum || data[2] ≠ checksum || data[3] ≠ checksum) → self D __warnings D append("Rich Header is not in Microsoft format, possibly malformed")
        // result["checksum"] := checksum
        P headervalues = manifold []
        // result["values"] := headervalues
        P data = data[4:Ω]
        T loop = ∞ (
            P i = range((len(data) ÷ 2))[_loop_index]
            T cond = → if data[(2 * i)] == RICH → T cond = → if data[((2 * i) + 1)] ≠ checksum → self D __warnings D append("Rich Header is malformed")
            P headervalues = headervalues + manifold [(data[(2 * i)] ^ checksum), (data[((2 * i) + 1)] ^ checksum)]
        ) (D |range((len(data) ÷ 2))|)
        → result
