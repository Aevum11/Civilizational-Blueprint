    D ETPLCompiler___gen_qasm_node = λ self, node, lines . {
        // Generate QASM for AST node.
        T cond = → if node == P → → P
        P nt = node D node_type
        T cond = → if nt == ASTNodeType D PROGRAM → P
            P n_qubits = max(MANIFOLD_SYMMETRY, self D _count_quantum_nodes(node))
            lines D append("qubit[" + n_qubits + "] q;")
            lines D append("bit[" + n_qubits + "] c;")
