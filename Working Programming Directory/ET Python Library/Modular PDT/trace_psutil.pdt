        D self_D__ppid = P  // self D _ppid := P
        D self_D__proc = _psplatform D Process(pid)  // self D _proc := _psplatform D Process(pid)
        D self_D__last_sys_cpu_times = P  // self D _last_sys_cpu_times := P
        D self_D__last_proc_cpu_times = P  // self D _last_proc_cpu_times := P
        D self_D__exitcode = _SENTINEL  // self D _exitcode := _SENTINEL
        D self_D__ident = manifold [self D pid, P]  // self D _ident := manifold [self D pid, P]
        T attempt = → P  // try
            D self_D__ident = self D _get_ident(P)  // self D _ident := self D _get_ident(P)
        → E AccessDenied (_)
            // pass
        → E ZombieProcess (_)
            // pass
        → E NoSuchProcess (_)
