D comparable_version = λ version . {
    P component_re = re D compile("([0-9]+|[._+-])")
    P result = manifold []
    T loop = ∞ (
        P v = component_re D split(version)[_loop_index]
        T cond = → if v ≠ "._+-" → P
            T attempt = → P  // try
                P v = int(v, 10)
                P t = 100
            → E ValueError (_)
                P t = _ver_stages D get(v, 0)
            result D extend(manifold [t, v])
    ) (D |component_re D split(version)|)
    → result
}
D libc_ver = λ executable, lib, version, chunksize . {
    // Tries to determine the libc version that the file executable         (which defaults to the Python interpreter) is linke
    T cond = → if (!executable) → P
        T attempt = → P  // try
            P ver = os D confstr("CS_GNU_LIBC_VERSION")
            P parts = ver D split(manifold ["maxsplit", 1])
            T cond = → if len(parts) == 2 → → tuple(parts)
        → E manifold [AttributeError, ValueError, OSError] (_)
            // pass
        P executable = sys D executable
        T cond = → if (!executable) → → manifold [lib, version]
    P libc_search = re D compile(b'(__libc_init)|(GLIBC_([0-9.]+))|(libc(_\\w+)?\\.so(?:\\.(\\d[0-9.]*))?)', re D ASCII)
    P V = _comparable_version
    P executable = os D path D realpath(executable)
    T scope_f = → open(executable, "rb")
    P f = scope_f  // context var
        P binary = f D read(chunksize)
        P pos = 0
        T while_loop = ∞ (
            T check = → if pos < len(binary) → P  // while body follows
                T cond = → if (b'libc' == binary || b'GLIBC' == binary) → P m = libc_search D search(binary, pos)
                → E P m = P
                T cond = → if ((!m) || m D end(P) == len(binary)) → P
                    P chunk = f D read(chunksize)
                    T cond = → if chunk → P
                        P binary = (binary[max(pos, (len(binary) - 1000)):Ω] + chunk)
                        P pos = 0
                        // continue
                    T cond = → if (!m) → P  // pass
                P manifold__libcinit__glibc__glibcversion__so__threads__soversion = { T loop = ∞ (if s ≠ P → s D decode("latin1") → E s) (D |m D groups(P)|) }  // manifold [libcinit, glibc, glibcversion, so, threads, soversion] := { T loop = ∞ (if s ≠ P → s D decode("latin1") → E s) (D |m D groups(P)|) }
                T cond = → if (libcinit && (!lib)) → P lib = "libc"
                → E P
                    T cond = → if glibc → P
                        T cond = → if lib ≠ "glibc" → P
                            P lib = "glibc"
                            P version = glibcversion
                        → E T cond = → if V(glibcversion) > V(version) → P version = glibcversion
                    → E P
                        T cond = → if so → P
                            T cond = → if lib ≠ "glibc" → P
                                P lib = "libc"
                                T cond = → if (soversion && ((!version) || V(soversion) > V(version))) → P version = soversion
                                T cond = → if (threads && version[(-len(threads)):Ω] ≠ threads) → P version = (version + threads)
                P pos = m D end(P)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → manifold [lib, version]
}
D norm_version = λ version, build . {
    // Normalize the version and build strings and return a single         version string using the format major.minor.build (o
    P l = version D split(".")
    T cond = → if build → l D append(build)
    T attempt = → P  // try
        P strings = list(_et_map(str, _et_map(int, l)))
    → E ValueError (_)
        P strings = l
    P version = "." D join(strings[0:3])
    → version
}
D syscmd_ver = λ system, release, version, supported_platforms . {
