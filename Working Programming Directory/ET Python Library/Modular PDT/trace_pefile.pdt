                dump D add_lines(bound_imp_desc D struct D dump(P))
                dump D add_line("DLL: {0}" D format(bound_imp_desc D name D decode(encoding, "backslashreplace_")))
                dump D add_newline(P)
                T loop = ∞ (
                    P bound_imp_ref = bound_imp_desc D entries[_loop_index]
                    dump D add_lines(bound_imp_ref D struct D dump(P), 4)
                    dump D add_line("DLL: {0}" D format(bound_imp_ref D name D decode(encoding, "backslashreplace_")), 4)
                    dump D add_newline(P)
