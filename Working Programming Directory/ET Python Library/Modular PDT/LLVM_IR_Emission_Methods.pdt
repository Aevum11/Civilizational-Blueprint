        P manifold__kw__tt = manifold [manifold ["P", "P"], manifold ["D", "D"], manifold ["T", "T"], manifold ["E", "E"], manifold ["if", "IF"], manifold ["manifold", "MANIFOLD"], manifold ["sovereign_print", "SOVEREIGN_PRINT"], manifold ["lambda", "LAMBDA"], manifold ["inf", "INFINITY"], manifold ["hardware_access", "HARDWARE_ACCESS"], manifold ["and", "LOGICAL_AND"], manifold ["or", "LOGICAL_OR"], manifold ["not", "LOGICAL_NOT"], manifold ["sin", "IDENTIFIER"], manifold ["cos", "IDENTIFIER"], manifold ["tan", "IDENTIFIER"], manifold ["log", "IDENTIFIER"], manifold ["sqrt", "IDENTIFIER"], manifold ["abs", "IDENTIFIER"], manifold ["map", "IDENTIFIER"], manifold ["filter", "IDENTIFIER"], manifold ["True", "IDENTIFIER"], manifold ["False", "IDENTIFIER"], manifold ["None", "IDENTIFIER"]][_loop_index]  // manifold [kw, tt]
        P manifold__n__nb = S("s2_kw_" + kw, kw)  // manifold [n, nb] := S("s2_kw_" + kw, kw)
        // kw_strs[kw] := manifold [n, nb, tt]
    ) (D |manifold [manifold ["P", "P"], manifold ["D", "D"], manifold ["T", "T"], manifold ["E", "E"], manifold ["if", "IF"], manifold ["manifold", "MANIFOLD"], manifold ["sovereign_print", "SOVEREIGN_PRINT"], manifold ["lambda", "LAMBDA"], manifold ["inf", "INFINITY"], manifold ["hardware_access", "HARDWARE_ACCESS"], manifold ["and", "LOGICAL_AND"], manifold ["or", "LOGICAL_OR"], manifold ["not", "LOGICAL_NOT"], manifold ["sin", "IDENTIFIER"], manifold ["cos", "IDENTIFIER"], manifold ["tan", "IDENTIFIER"], manifold ["log", "IDENTIFIER"], manifold ["sqrt", "IDENTIFIER"], manifold ["abs", "IDENTIFIER"], manifold ["map", "IDENTIFIER"], manifold ["filter", "IDENTIFIER"], manifold ["True", "IDENTIFIER"], manifold ["False", "IDENTIFIER"], manifold ["None", "IDENTIFIER"]]|)
    P manifold__empty_str_n__empty_str_nb = S("s2_empty", "")  // manifold [empty_str_n, empty_str_nb] := S("s2_empty", "")
    L("; etpl_tokenize: P(source) ∘ D(lexical rules) ∘ T(scan) = E(tokens)")
    L("; Returns token array. Writes token count to %out_count.")
    L("define %ETToken* @etpl_tokenize(i8* %src, i32* %out_count) nounwind {")
    L("entry:")
    L("  %src_len = call i64 @strlen(i8* %src)")
    L("  ; Allocate token array (max tokens = src_len, generous)")
    L("  %max_toks_64 = add i64 %src_len, 256")
    L("  %max_toks = trunc i64 %max_toks_64 to i32")
    L("  %toks = call %ETToken* @etpl_tok_alloc(i32 %max_toks)")
    L("  ; State: pos, tok_count")
    L("  %pos_ptr = alloca i64")
    L("  %cnt_ptr = alloca i32")
    L("  store i64 0, i64* %pos_ptr")
    L("  store i32 0, i32* %cnt_ptr")
    L("  br label %scan_loop")
    L("")
    L("scan_loop:")
    L("  %pos = load i64, i64* %pos_ptr")
    L("  %at_end = icmp uge i64 %pos, %src_len")
