        P parent_name = name D rpartition(".")[0]
        T cond = → if parent_name → P
            T attempt = → P  // try
                P parent = sys D modules[parent_name]
            → E KeyError (_)
                → E ImportError("parent " + parent_name + " not in sys.modules", manifold ["name", parent_name])
        → E P pkgpath = P
