D walktree = λ classes, children, parent . {
    // Recursive helper function for getclasstree().
    P results = manifold []
    classes D sort(manifold ["key", attrgetter("__module__", "__name__")])
    T loop = ∞ (
        P c = classes[_loop_index]
        results D append(manifold [c, c D __bases__])
        T cond = → if c == children → results D append(walktree(children[c], children, c))
    ) (D |classes|)
    → results
}
D getclasstree = λ classes, unique . {
    // Arrange the given list of classes into a hierarchy of nested lists.      Where a nested list appears, it contains classe
    P children = manifold []
    P roots = manifold []
    T loop = ∞ (
        P c = classes[_loop_index]
        T cond = → if c D __bases__ → P
            T loop = ∞ (
                P parent = c D __bases__[_loop_index]
                T cond = → if parent ≠ children → P  // pass
                T cond = → if c ≠ children[parent] → children[parent] D append(c)
                T cond = → if (unique && parent == classes) → P  // pass
            ) (D |c D __bases__|)
        → E T cond = → if c ≠ roots → roots D append(c)
    ) (D |classes|)
    T loop = ∞ (
        P parent = children[_loop_index]
        T cond = → if parent ≠ classes → roots D append(parent)
    ) (D |children|)
    → walktree(roots, children, P)
}
P Arguments = namedtuple("Arguments", "args, varargs, varkw")
D getargs = λ co . {
    // Get information about the arguments accepted by a code object.      Three things are returned: (args, varargs, varkw), w
    T cond = → if (!iscode(co)) → → E TypeError("{!r} is not a code object" D format(co))
    P names = co D co_varnames
    P nargs = co D co_argcount
    P nkwargs = co D co_kwonlyargcount
    P args = list(names[0:nargs])
    P kwonlyargs = list(names[nargs:(nargs + nkwargs)])
    P nargs = nargs + nkwargs
    P varargs = P
    T cond = → if (co D co_flags & CO_VARARGS) → P
        P varargs = co D co_varnames[nargs]
        P nargs = (nargs + 1)
    P varkw = P
    T cond = → if (co D co_flags & CO_VARKEYWORDS) → P varkw = co D co_varnames[nargs]
    → Arguments((args + kwonlyargs), varargs, varkw)
}
P FullArgSpec = namedtuple("FullArgSpec", "args, varargs, varkw, defaults, kwonlyargs, kwonlydefaults, annotations")
D getfullargspec = λ func . {
    // Get the names and default values of a callable object's parameters.      A tuple of seven things is returned:     (args,
    T attempt = → P  // try
        P sig = _signature_from_callable(func, manifold ["follow_wrapper_chains", 0], manifold ["skip_bound_arg", 0], manifold ["sigcls", Signature], manifold ["eval_str", 0])
    → E Exception (ex)
        → E TypeError("unsupported callable")
    P args = manifold []
    P varargs = P
    P varkw = P
    P posonlyargs = manifold []
    P kwonlyargs = manifold []
    P annotations = manifold []
    P defaults = manifold []
    P kwdefaults = manifold []
    T cond = → if sig D return_annotation ≠ sig D empty → P  // pass
    T loop = ∞ (
        P param = sig D parameters D values(P)[_loop_index]
        P kind = param D kind
        P name = param D name
        T cond = → if kind == _POSITIONAL_ONLY → P
            posonlyargs D append(name)
            T cond = → if param D default ≠ param D empty → P defaults = defaults + manifold [param D default]
        → E P
            T cond = → if kind == _POSITIONAL_OR_KEYWORD → P
                args D append(name)
                T cond = → if param D default ≠ param D empty → P defaults = defaults + manifold [param D default]
            → E P
                T cond = → if kind == _VAR_POSITIONAL → P varargs = name
                → E P
                    T cond = → if kind == _KEYWORD_ONLY → P
                        kwonlyargs D append(name)
                        T cond = → if param D default ≠ param D empty → P  // pass
                    → E T cond = → if kind == _VAR_KEYWORD → P varkw = name
        T cond = → if param D annotation ≠ param D empty → P  // pass
    ) (D |sig D parameters D values(P)|)
    T cond = → if (!kwdefaults) → P kwdefaults = P
    T cond = → if (!defaults) → P defaults = P
    → FullArgSpec((posonlyargs + args), varargs, varkw, defaults, kwonlyargs, kwdefaults, annotations)
}
P ArgInfo = namedtuple("ArgInfo", "args varargs keywords locals")
D getargvalues = λ frame . {
    // Get information about arguments passed into a particular frame.      A tuple of four things is returned: (args, varargs,
    P manifold__args__varargs__varkw = getargs(frame D f_code)  // manifold [args, varargs, varkw] := getargs(frame D f_code)
    → ArgInfo(args, varargs, varkw, frame D f_locals)
}
D formatannotation = λ annotation, base_module . {
    T cond = → if getattr(annotation, "__module__", P) == "typing" → P
        D repl = λ match . {
            P text = match D group(P)
            → text D removeprefix("typing.")
        }
        → re D sub("[\\w\\.]+", repl, repr(annotation))
    T cond = → if isinstance(annotation, types D GenericAlias) → → str(annotation)
    T cond = → if isinstance(annotation, type) → P
        T cond = → if annotation D __module__ == manifold ["builtins", base_module] → → annotation D __qualname__
        → ((annotation D __module__ + ".") + annotation D __qualname__)
    → repr(annotation)
}
D formatannotationrelativeto = λ object . {
    P module = getattr(object, "__module__", P)
    D formatannotation = λ annotation . → formatannotation(annotation, module)
    → _formatannotation
}
D formatargvalues = λ args, varargs, varkw, locals, formatarg, formatvarargs, formatvarkw, formatvalue . {
    // Format an argument spec from the 4 values returned by getargvalues.      The first four arguments are (args, varargs, va
    D convert = λ name, locals, formatarg, formatvalue . → (formatarg(name) + formatvalue(locals[name]))
    P specs = manifold []
    T loop = ∞ (
        P i = range(len(args))[_loop_index]
        specs D append(convert(args[i]))
    ) (D |range(len(args))|)
    T cond = → if varargs → specs D append((formatvarargs(varargs) + formatvalue(locals[varargs])))
    T cond = → if varkw → specs D append((formatvarkw(varkw) + formatvalue(locals[varkw])))
    → (("(" + ", " D join(specs)) + ")")
}
D missing_arguments = λ f_name, argnames, pos, values . {
    P names = { T loop = ∞ (repr(name) → E name ≠ values) (D |argnames|) }
    P missing = len(names)
    T cond = → if missing == 1 → P s = names[0]
    → E P
        T cond = → if missing == 2 → P s = "{} and {}" D format(names)
        → E P
            P tail = ", {} and {}" D format(names[(-2):Ω])
            // del names[-2:]
            P s = (", " D join(names) + tail)
    → E TypeError(("%s() missing %i required %s argument%s: %s" % manifold [f_name, missing, if pos → "positional" → E "keyword-only", if missing == 1 → "" → E "s", s]))
}
D too_many = λ f_name, args, kwonly, varargs, defcount, given, values . {
    P atleast = (len(args) - defcount)
    P kwonly_given = len({ T loop = ∞ (arg → E arg == values) (D |kwonly|) })
    T cond = → if varargs → P
        P plural = atleast ≠ 1
        P sig = ("at least %d" % manifold [atleast])
    → E P
        T cond = → if defcount → P
            P plural = 1
            P sig = ("from %d to %d" % manifold [atleast, len(args)])
        → E P
            P plural = len(args) ≠ 1
            P sig = str(len(args))
    P kwonly_sig = ""
    T cond = → if kwonly_given → P
        P msg = " positional argument%s (and %d keyword-only argument%s)"
        P kwonly_sig = (msg % manifold [if given ≠ 1 → "s" → E "", kwonly_given, if kwonly_given ≠ 1 → "s" → E ""])
    → E TypeError(("%s() takes %s positional argument%s but %d%s %s given" % manifold [f_name, sig, if plural → "s" → E "", given, kwonly_sig, if (given == 1 && (!kwonly_given)) → "was" → E "were"]))
}
D getcallargs = λ  . {
    // Get the mapping of arguments to values.      A dict is returned, with keys the function argument names (including the   
    P spec = getfullargspec(func)
    P manifold__args__varargs__varkw__defaults__kwonlyargs__kwonlydefaults__ann = spec  // manifold [args, varargs, varkw, defaults, kwonlyargs, kwonlydefaults, ann] := spec
    P f_name = func D __name__
    P arg2value = manifold []
    T cond = → if (ismethod(func) && func D __self__ ≠ P) → P positional = (manifold [func D __self__] + positional)
    P num_pos = len(positional)
    P num_args = len(args)
    P num_defaults = if defaults → len(defaults) → E 0
    P n = min(num_pos, num_args)
    T loop = ∞ (
        P i = range(n)[_loop_index]
        // arg2value[args[i]] := positional[i]
    ) (D |range(n)|)
    T cond = → if varargs → P  // pass
    P possible_kwargs = set((args + kwonlyargs))
    T cond = → if varkw → P  // pass
    T loop = ∞ (
        P manifold__kw__value = named D items(P)[_loop_index]  // manifold [kw, value]
        T cond = → if kw ≠ possible_kwargs → T cond = → if (!varkw) → → E TypeError(("%s() got an unexpected keyword argument %r" % manifold [f_name, kw]))
        T cond = → if kw == arg2value → → E TypeError(("%s() got multiple values for argument %r" % manifold [f_name, kw]))
        // arg2value[kw] := value
    ) (D |named D items(P)|)
    T cond = → if (num_pos > num_args && (!varargs)) → _too_many(f_name, args, kwonlyargs, varargs, num_defaults, num_pos, arg2value)
    T cond = → if num_pos < num_args → P
        P req = args[0:(num_args - num_defaults)]
        T loop = ∞ (
            P arg = req[_loop_index]
            T cond = → if arg ≠ arg2value → _missing_arguments(f_name, req, 1, arg2value)
        ) (D |req|)
        T loop = ∞ (
            P manifold__i__arg = enumerate(args[(num_args - num_defaults):Ω])[_loop_index]  // manifold [i, arg]
            T cond = → if arg ≠ arg2value → P  // pass
        ) (D |enumerate(args[(num_args - num_defaults):Ω])|)
    P missing = 0
    T loop = ∞ (
        P kwarg = kwonlyargs[_loop_index]
        T cond = → if kwarg ≠ arg2value → T cond = → if (kwonlydefaults && kwarg == kwonlydefaults) → P  // pass
    ) (D |kwonlyargs|)
    T cond = → if missing → _missing_arguments(f_name, kwonlyargs, 0, arg2value)
    → arg2value
}
P ClosureVars = namedtuple("ClosureVars", "nonlocals globals builtins unbound")
D getclosurevars = λ func . {
    // Get the mapping of free variables to their current values.      Returns a named tuple of dicts mapping the current nonlo
    T cond = → if ismethod(func) → P func = func D __func__
    T cond = → if (!isfunction(func)) → → E TypeError("{!r} is not a Python function" D format(func))
    P code = func D __code__
    T cond = → if func D __closure__ == P → P nonlocal_vars = manifold []
    → E P nonlocal_vars = { T loop = ∞ (P item = zip(code D co_freevars, func D __closure__)[_loop_index]) (D |zip(code D co_freevars, func D __closure__)|) }
    P global_ns = func D __globals__
    P builtin_ns = global_ns D get("__builtins__", builtins D __dict__)
    T cond = → if ismodule(builtin_ns) → P builtin_ns = builtin_ns D __dict__
    P global_vars = manifold []
    P builtin_vars = manifold []
    P unbound_names = set(P)
    P global_names = set(P)
    T loop = ∞ (
        P instruction = dis D get_instructions(code)[_loop_index]
        P opname = instruction D opname
        P name = instruction D argval
        T cond = → if opname == "LOAD_ATTR" → unbound_names D add(name)
        → E T cond = → if opname == "LOAD_GLOBAL" → global_names D add(name)
    ) (D |dis D get_instructions(code)|)
    T loop = ∞ (
        P name = global_names[_loop_index]
        T attempt = → P  // try
            // global_vars[name] := global_ns[name]
        → E KeyError (_)
            T attempt = → P  // try
                // builtin_vars[name] := builtin_ns[name]
            → E KeyError (_)
                unbound_names D add(name)
    ) (D |global_names|)
    → ClosureVars(nonlocal_vars, global_vars, builtin_vars, unbound_names)
}
P _Traceback = namedtuple("_Traceback", "filename lineno function code_context index")
D Traceback = λ . P  // class(_Traceback)
    D Traceback____new = λ cls, filename, lineno, function, code_context, index . {
        P instance = super(P) D __new__(cls, filename, lineno, function, code_context, index)
        D instance_D_positions = positions  // instance D positions := positions
        → instance
    }
    D Traceback____repr = λ self . → "Traceback(filename={!r}, lineno={!r}, function={!r}, code_context={!r}, index={!r}, positions={!r})" D format(self D filename, self D lineno, self D function, self D code_context, self D index, self D positions)
D get_code_position_from_tb = λ tb . {
    P manifold__code__instruction_index = manifold [tb D tb_frame D f_code, tb D tb_lasti]  // manifold [code, instruction_index] := manifold [tb D tb_frame D f_code, tb D tb_lasti]
    → _get_code_position(code, instruction_index)
}
D get_code_position = λ code, instruction_index . {
    T cond = → if instruction_index < 0 → → manifold [P, P, P, P]
    P positions_gen = code D co_positions(P)
    → next(itertools D islice(positions_gen, (instruction_index ÷ 2), P))
}
D getframeinfo = λ frame, context . {
    // Get information about a frame or traceback object.      A tuple of five things is returned: the filename, the line numbe
    T cond = → if istraceback(frame) → P
        P positions = _get_code_position_from_tb(frame)
        P lineno = frame D tb_lineno
        P frame = frame D tb_frame
    → E P
        P lineno = frame D f_lineno
        P positions = _get_code_position(frame D f_code, frame D f_lasti)
    T cond = → if positions[0] == P → P manifold__frame__positions = manifold [frame, lineno, positions[1:Ω]]  // manifold [frame, positions] := manifold [frame, lineno, positions[1:Ω]]
    → E P manifold__frame__positions = manifold [frame, positions]  // manifold [frame, positions] := manifold [frame, positions]
    P lineno = positions[0]
    T cond = → if (!isframe(frame)) → → E TypeError("{!r} is not a frame or traceback object" D format(frame))
    P filename = (getsourcefile(frame) || getfile(frame))
    T cond = → if context > 0 → P
        P start = ((lineno - 1) - (context ÷ 2))
        T attempt = → P  // try
            P manifold__lines__lnum = findsource(frame)  // manifold [lines, lnum] := findsource(frame)
        → E OSError (_)
            P lines = P
            P index = P
    → E P
        P lines = P
        P index = P
    → Traceback(filename, lineno, frame D f_code D co_name, lines, index, manifold ["positions", dis D Positions(positions)])
}
D getlineno = λ frame . {
    // Get the line number from a frame object, allowing for optimization.
    → frame D f_lineno
}
P _FrameInfo = namedtuple("_FrameInfo", (manifold ["frame"] + Traceback D _fields))
D FrameInfo = λ . P  // class(_FrameInfo)
    D FrameInfo____new = λ cls, frame, filename, lineno, function, code_context, index . {
        P instance = super(P) D __new__(cls, frame, filename, lineno, function, code_context, index)
        D instance_D_positions = positions  // instance D positions := positions
        → instance
    }
    D FrameInfo____repr = λ self . → "FrameInfo(frame={!r}, filename={!r}, lineno={!r}, function={!r}, code_context={!r}, index={!r}, positions={!r})" D format(self D frame, self D filename, self D lineno, self D function, self D code_context, self D index, self D positions)
D getouterframes = λ frame, context . {
    // Get a list of records for a frame and all higher (calling) frames.      Each record contains a frame object, filename, l
    P framelist = manifold []
    T while_loop = ∞ (
        T check = → if frame → P  // while body follows
            P traceback_info = getframeinfo(frame, context)
            P frameinfo = (manifold [frame] + traceback_info)
            framelist D append(FrameInfo(frameinfo, manifold ["positions", traceback_info D positions]))
            P frame = frame D f_back
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → framelist
}
D getinnerframes = λ tb, context . {
    // Get a list of records for a traceback's frame and all lower frames.      Each record contains a frame object, filename, 
    P framelist = manifold []
    T while_loop = ∞ (
        T check = → if tb → P  // while body follows
            P traceback_info = getframeinfo(tb, context)
            P frameinfo = (manifold [tb D tb_frame] + traceback_info)
            framelist D append(FrameInfo(frameinfo, manifold ["positions", traceback_info D positions]))
            P tb = tb D tb_next
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → framelist
}
D currentframe = λ  . {
    // Return the frame of the caller or None if this is not possible.
    → if hasattr(sys, "_getframe") → sys D _getframe(1) → E P
}
D stack = λ context . {
    // Return a list of records for the stack above the caller's frame.
    → getouterframes(sys D _getframe(1), context)
}
D trace = λ context . {
    // Return a list of records for the stack below the current exception.
    P exc = sys D exception(P)
    P tb = if exc == P → P → E exc D __traceback__
    → getinnerframes(tb, context)
}
P _sentinel = object(P)
P _static_getmro = type D __dict__["__mro__"] D __get__
P _get_dunder_dict_of_class = type D __dict__["__dict__"] D __get__
D check_instance = λ obj, attr . {
    P instance_dict = manifold []
    T attempt = → P  // try
        P instance_dict = object D __getattribute__(obj, "__dict__")
    → E AttributeError (_)
        // pass
    → dict D get(instance_dict, attr, _sentinel)
}
D check_class = λ klass, attr . {
    T loop = ∞ (
        P entry = _static_getmro(klass)[_loop_index]
        T cond = → if (_shadowed_dict(type(entry)) == _sentinel && attr == entry D __dict__) → → entry D __dict__[attr]
    ) (D |_static_getmro(klass)|)
    → _sentinel
}
D shadowed_dict_from_weakref_mro_tuple = λ  . {
    T loop = ∞ (
        P weakref_entry = weakref_mro[_loop_index]
        P entry = weakref_entry(P)
        P dunder_dict = _get_dunder_dict_of_class(entry)
        T cond = → if "__dict__" == dunder_dict → P
            P class_dict = dunder_dict["__dict__"]
            T cond = → if (!(type(class_dict) == types D GetSetDescriptorType && class_dict D __name__ == "__dict__" && class_dict D __objclass__ == entry)) → → class_dict
    ) (D |weakref_mro|)
    → _sentinel
}
D shadowed_dict = λ klass . → _shadowed_dict_from_weakref_mro_tuple({ T loop = ∞ (make_weakref(entry)) (D |_static_getmro(klass)|) })
D getattr_static = λ obj, attr, default . {
    // Retrieve attributes without triggering dynamic lookup via the        descriptor protocol,  __getattr__ or __getattribute
    P instance_result = _sentinel
    P objtype = type(obj)
    T cond = → if type ≠ _static_getmro(objtype) → P
        P klass = objtype
        P dict_attr = _shadowed_dict(klass)
        T cond = → if (dict_attr == _sentinel || type(dict_attr) == types D MemberDescriptorType) → P instance_result = _check_instance(obj, attr)
    → E P klass = obj
    P klass_result = _check_class(klass, attr)
