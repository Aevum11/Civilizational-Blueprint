package com.et.physics.toolbox

import org.junit.Test
import org.junit.Assert.*
import kotlin.math.abs

/**
 * Unit Tests for OmniTraverser Engine v10.2
 * Verifies Physics, Math, and Logic.
 */
class OmniTraverserEngineTest {

    private val engine = OmniTraverserEngine()

    @Test
    fun testZeroInputResult() {
        val result = engine.resolveConfiguration(
            floatArrayOf(0f, 0f, 0f), 
            floatArrayOf(0f, 0f, 0f), 
            null, null, null, null, null,
            0, 1000000L, 16000
        )
        assertEquals(0.0, result.shimmerIndex, 0.001)
        assertEquals(OmniTraverserEngine.EtState.STATE_0_EXCEPTION, result.etState)
    }

    @Test
    fun testIsoVelocityIntegration() {
        // Feed constant 1G oscillation at ~50Hz
        // 1. Stabilize gravity
        for(i in 0..50) engine.resolveConfiguration(floatArrayOf(0f,0f,9.81f), floatArrayOf(0f,0f,0f), null, null, null, null, null, 0, 0, 16000)

        // 2. Inject Motion Pulse (simulating vibration)
        val res = engine.resolveConfiguration(
            floatArrayOf(0.5f, 0f, 9.81f), 
            floatArrayOf(0f, 0f, 0f), 
            null, null, null, null, null,
            0, System.nanoTime() + 20000000, 16000
        )
        
        assertTrue("Velocity should be registered (>0)", res.velocityRms > 0.0)
    }

    @Test
    fun testThermalAlert() {
        // Feed high temperature
        val res = engine.resolveConfiguration(
            floatArrayOf(0f,0f,9.81f), floatArrayOf(0f,0f,0f), null, null, 
            60.0f, // 60C Ambient Temp
            null, null, 0, System.nanoTime(), 16000
        )
        assertEquals("Critical", res.thermalState)
    }

    @Test
    fun testAWeightingFilter() {
        // 1kHz Sine Wave
        val buffer = ShortArray(1024)
        for(i in buffer.indices) {
            buffer[i] = (10000 * Math.sin(2.0 * Math.PI * 1000.0 * i / 16000.0)).toInt().toShort()
        }
        
        val res = engine.resolveConfiguration(
            floatArrayOf(0f,0f,9.81f), floatArrayOf(0f,0f,0f), null, null, null,
            buffer, null, 0, System.nanoTime(), 16000
        )
        
        // A-weighting should imply positive gain at 1kHz (approx 0dB ref, but our logic adds gain)
        assertTrue("SPL should be calculated", res.correctedSPL > 40.0)
    }
}