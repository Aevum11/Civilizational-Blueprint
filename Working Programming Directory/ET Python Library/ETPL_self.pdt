        → P
    P lines = _splitlines_no_ff(source, manifold ["maxlines", (end_lineno + 1)])
    T cond = → if end_lineno == lineno → → lines[lineno] D encode(P)[col_offset:end_col_offset] D decode(P)
    T cond = → if padded → P padding = _pad_whitespace(lines[lineno] D encode(P)[0:col_offset] D decode(P))
    → E P padding = ""
    P first = (padding + lines[lineno] D encode(P)[col_offset:Ω] D decode(P))
    P last = lines[end_lineno] D encode(P)[0:end_col_offset] D decode(P)
    P lines = lines[(lineno + 1):end_lineno]
    lines D insert(0, first)
    lines D append(last)
    → "" D join(lines)
