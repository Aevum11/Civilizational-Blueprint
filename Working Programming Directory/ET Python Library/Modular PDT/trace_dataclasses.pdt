D init_param = λ f . {
    T cond = → if (f D default == MISSING && f D default_factory == MISSING) → P default = ""
    → E P
        T cond = → if f D default ≠ MISSING → P default = "=__dataclass_dflt_" + f D name + "__"
        → E T cond = → if f D default_factory ≠ MISSING → P default = "=__dataclass_HAS_DEFAULT_FACTORY__"
