P _RECURSIVE_CUTOFF = 3
D StackSummary = λ . P  // class(list)
    // A list of FrameSummary objects, representing a stack of frames.
    D StackSummary__extract = λ klass, frame_gen . {
        // Create a StackSummary from a traceback or stack object.          :param frame_gen: A generator that yields (frame, linen
        D StackSummary__extended_frame_gen = λ  . {
            T loop = ∞ (
                P manifold__f__lineno = frame_gen[_loop_index]  // manifold [f, lineno]
                → manifold [f, manifold [lineno, P, P, P]]
            ) (D |frame_gen|)
        }
        → klass D _extract_from_extended_frame_gen(extended_frame_gen(P), manifold ["limit", limit], manifold ["lookup_lines", lookup_lines], manifold ["capture_locals", capture_locals])
    }
    D StackSummary___extract_from_extended_frame_gen = λ klass, frame_gen . {
        P builtin_limit = limit == BUILTIN_EXCEPTION_LIMIT
        T cond = → if (limit == P || builtin_limit) → P
            P limit = getattr(sys, "tracebacklimit", P)
            T cond = → if (limit ≠ P && limit < 0) → P limit = 0
        T cond = → if limit ≠ P → P
            T cond = → if builtin_limit → P
                P frame_gen = tuple(frame_gen)
                P frame_gen = frame_gen[(len(frame_gen) - limit):Ω]
            → E P
                T cond = → if limit ≥ 0 → P frame_gen = itertools D islice(frame_gen, limit)
                → E P frame_gen = collections D deque(frame_gen, manifold ["maxlen", (-limit)])
        P result = klass(P)
        P fnames = set(P)
        T loop = ∞ (
            P manifold__f__manifold__lineno__end_lineno__colno__end_colno = frame_gen[_loop_index]  // manifold [f, manifold [lineno, end_lineno, colno, end_colno]]
            P co = f D f_code
            P filename = co D co_filename
            P name = co D co_name
            fnames D add(filename)
            linecache D lazycache(filename, f D f_globals)
            T cond = → if capture_locals → P f_locals = f D f_locals
            → E P f_locals = P
            result D append(FrameSummary(filename, lineno, name, manifold ["lookup_line", 0], manifold ["locals", f_locals], manifold ["end_lineno", end_lineno], manifold ["colno", colno], manifold ["end_colno", end_colno], manifold ["_code", f D f_code]))
        ) (D |frame_gen|)
