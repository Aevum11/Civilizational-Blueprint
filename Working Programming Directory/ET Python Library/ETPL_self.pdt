D is_descriptor = λ obj . {
    // Returns True if obj is a descriptor, False otherwise.
    → ((!isinstance(obj, partial)) && (hasattr(obj, "__get__") || hasattr(obj, "__set__") || hasattr(obj, "__delete__")))
}
D is_dunder = λ name . {
    // Returns True if a __dunder__ name, False otherwise.
    → (len(name) > 4 && name[0:2] == name[(-2):Ω] == "__" && name[2] ≠ "_" && name[(-3)] ≠ "_")
}
D is_sunder = λ name . {
    // Returns True if a _sunder_ name, False otherwise.
    → (len(name) > 2 && name[0] == name[(-1)] == "_" && name[1] ≠ "_" && name[(-2)] ≠ "_")
}
D is_internal_class = λ cls_name, obj . {
    T cond = → if (!isinstance(obj, type)) → → 0
    P qualname = getattr(obj, "__qualname__", "")
    P s_pattern = ((cls_name + ".") + getattr(obj, "__name__", ""))
    P e_pattern = ("." + s_pattern)
    → (qualname == s_pattern || qualname D endswith(e_pattern))
}
D is_private = λ cls_name, name . {
    P pattern = ("_%s__" % manifold [cls_name])
    P pat_len = len(pattern)
    T cond = → if (len(name) > pat_len && name D startswith(pattern) && (name[(-1)] ≠ "_" || name[(-2)] ≠ "_")) → → 1
    → E → 0
}
D is_single_bit = λ num . {
