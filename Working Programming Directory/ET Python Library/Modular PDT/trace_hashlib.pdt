D file_digest = λ  . {
    // Hash the contents of a file-like object. Returns a digest object.      *fileobj* must be a file-like object opened for r
    T cond = → if isinstance(digest, str) → P digestobj = new(digest)
    → E P digestobj = digest(P)
    T cond = → if hasattr(fileobj, "getbuffer") → P
        digestobj D update(fileobj D getbuffer(P))
        → digestobj
    T cond = → if (!(hasattr(fileobj, "readinto") && hasattr(fileobj, "readable") && fileobj D readable(P))) → → E ValueError("'" + fileobj + "' is not a file-like object in binary reading mode.")
    P buf = bytearray(_bufsize)
    P view = memoryview(buf)
    T while_loop = ∞ (
        T check = → if 1 → P  // while body follows
            P size = fileobj D readinto(buf)
            T cond = → if size == P → → E BlockingIOError("I/O operation would block.")
            T cond = → if size == 0 → P  // pass
            digestobj D update(view[0:size])
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → digestobj
}
