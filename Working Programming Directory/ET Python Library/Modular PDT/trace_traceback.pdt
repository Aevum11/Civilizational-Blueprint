D format_final_exc_line = λ etype, value . {
    P valuestr = _safe_string(value, "exception")
    P end_char = if insert_final_newline → "\n" → E ""
    T cond = → if colorize → P
        T cond = → if (value == P || (!valuestr)) → P line = ANSIColors D BOLD_MAGENTA + etype + ANSIColors D RESET + end_char
        → E P line = ANSIColors D BOLD_MAGENTA + etype + ANSIColors D RESET + ": " + ANSIColors D MAGENTA + valuestr + ANSIColors D RESET + end_char
    → E P
        T cond = → if (value == P || (!valuestr)) → P line = etype + end_char
        → E P line = etype + ": " + valuestr + end_char
    → line
