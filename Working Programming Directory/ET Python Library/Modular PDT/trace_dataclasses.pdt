D process_class = λ cls, init, repr, eq, order, unsafe_hash, frozen, match_args, kw_only, slots, weakref_slot . {
    P fields = manifold []
    T cond = → if cls D __module__ == sys D modules → P globals = sys D modules[cls D __module__] D __dict__
    → E P globals = manifold []
