D signature_fromstr = λ cls, obj, s, skip_bound_arg . {
    // Private helper to parse content of '__text_signature__'     and return a Signature based on it.
    P Parameter = cls D _parameter_cls
    P manifold__clean_signature__self_parameter = _signature_strip_non_python_syntax(s)  // manifold [clean_signature, self_parameter] := _signature_strip_non_python_syntax(s)
    P program = (("def foo" + clean_signature) + ": pass")
    T attempt = → P  // try
        P module = ast D parse(program)
    → E SyntaxError (_)
        P module = P
    T cond = → if (!isinstance(module, ast D Module)) → → E ValueError("{!r} builtin has invalid signature" D format(obj))
    P f = module D body[0]
    P parameters = manifold []
    P empty = Parameter D empty
    P module = P
    P module_dict = manifold []
    P module_name = getattr(obj, "__module__", P)
    T cond = → if (!module_name) → P
        P objclass = getattr(obj, "__objclass__", P)
        P module_name = getattr(objclass, "__module__", P)
    T cond = → if module_name → P
        P module = sys D modules D get(module_name, P)
        T cond = → if module → P module_dict = module D __dict__
    P sys_module_dict = sys D modules D copy(P)
    D parse_name = λ node . {
        T assert = → if isinstance(node, ast D arg) → "ok" → E "Assertion failed"
        T cond = → if node D annotation ≠ P → → E ValueError("Annotations are not currently supported")
        → node D arg
    }
    D wrap_value = λ s . {
        T attempt = → P  // try
            P value = eval(s, module_dict)
        → E NameError (_)
            T attempt = → P  // try
                P value = eval(s, sys_module_dict)
            → E NameError (_)
                → E ValueError
        T cond = → if isinstance(value, manifold [str, int, float, bytes, bool, type(P)]) → → ast D Constant(value)
        → E ValueError
    }
    D RewriteSymbolics = λ . P  // class(ast D NodeTransformer)
        D RewriteSymbolics__visit_Attribute = λ self, node . {
            P a = manifold []
            P n = node
            T while_loop = ∞ (
                T check = → if isinstance(n, ast D Attribute) → P  // while body follows
                    a D append(n D attr)
                    P n = n D value
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            T cond = → if (!isinstance(n, ast D Name)) → → E ValueError
            a D append(n D id)
            P value = "." D join(reversed(a))
            → wrap_value(value)
        }
        D RewriteSymbolics__visit_Name = λ self, node . {
            T cond = → if (!isinstance(node D ctx, ast D Load)) → → E ValueError(P)
            → wrap_value(node D id)
        }
        D RewriteSymbolics__visit_BinOp = λ self, node . {
            P left = self D visit(node D left)
            P right = self D visit(node D right)
            T cond = → if ((!isinstance(left, ast D Constant)) || (!isinstance(right, ast D Constant))) → → E ValueError
            T cond = → if isinstance(node D op, ast D Add) → → ast D Constant((left D value + right D value))
            → E P
                T cond = → if isinstance(node D op, ast D Sub) → → ast D Constant((left D value - right D value))
                → E T cond = → if isinstance(node D op, ast D BitOr) → → ast D Constant((left D value | right D value))
            → E ValueError
        }
    D p = λ name_node, default_node, default . {
        P name = parse_name(name_node)
        T cond = → if (default_node && default_node ≠ _empty) → P
            T attempt = → P  // try
                P default_node = RewriteSymbolics(P) D visit(default_node)
