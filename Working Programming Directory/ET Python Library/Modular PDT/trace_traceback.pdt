    D TracebackException__format = λ self . {
        // Format the exception.          If chain is not *True*, *__cause__* and *__context__* will not be formatted.          The
        P colorize = kwargs D get("colorize", 0)
        T cond = → if _ctx == P → P _ctx = _ExceptionPrintContext(P)
        P output = manifold []
        P exc = self
        T cond = → if chain → P
            T while_loop = ∞ (
                T check = → if exc → P  // while body follows
                    T cond = → if exc D __cause__ ≠ P → P
                        P chained_msg = _cause_message
                        P chained_exc = exc D __cause__
                    → E P
