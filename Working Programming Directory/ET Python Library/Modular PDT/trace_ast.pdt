            fstring_parts D append(manifold ["" D join(buffer), isinstance(value, Constant)])
        ) (D |node D values|)
        P new_fstring_parts = manifold []
        P quote_types = list(_ALL_QUOTES)
        P fallback_to_repr = 0
        T loop = ∞ (
            P manifold__value__is_constant = fstring_parts[_loop_index]  // manifold [value, is_constant]
            T cond = → if is_constant → P
                P manifold__value__new_quote_types = self D _str_literal_helper(value, manifold ["quote_types", quote_types], manifold ["escape_special_whitespace", 1])  // manifold [value, new_quote_types] := self D _str_literal_helper(value, manifold ["quote_types", quote_types], manifold ["escape_special_whitespace", 1])
                T cond = → if set(new_quote_types) D isdisjoint(quote_types) → P fallback_to_repr = 1
                P quote_types = new_quote_types
            → E P
                T cond = → if "\n" == value → P
                    P quote_types = { T loop = ∞ (q → E q == _MULTI_QUOTES) (D |quote_types|) }
                    T assert = → if quote_types → "ok" → E "Assertion failed"
                P new_quote_types = { T loop = ∞ (q → E q ≠ value) (D |quote_types|) }
                T cond = → if new_quote_types → P quote_types = new_quote_types
            new_fstring_parts D append(value)
