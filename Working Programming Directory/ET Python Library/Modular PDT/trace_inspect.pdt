D getdoc = λ object . {
    // Get the documentation string for an object.      All tabs are expanded to spaces.  To clean up docstrings that are     i
    T attempt = → P  // try
        P doc = object D __doc__
    → E AttributeError (_)
        → P
    T cond = → if doc == P → P
        T attempt = → P  // try
            P doc = _finddoc(object)
        → E manifold [AttributeError, TypeError] (_)
            → P
    T cond = → if (!isinstance(doc, str)) → → P
    → cleandoc(doc)
}
D cleandoc = λ doc . {
    // Clean up indentation from docstrings.      Any whitespace that can be uniformly removed from the second line     onwards
    P lines = doc D expandtabs(P) D split("\n")
    P margin = sys D maxsize
    T loop = ∞ (
        P line = lines[1:Ω][_loop_index]
        P content = len(line D lstrip(" "))
        T cond = → if content → P
            P indent = (len(line) - content)
            P margin = min(margin, indent)
    ) (D |lines[1:Ω]|)
    T cond = → if lines → P  // pass
    T cond = → if margin < sys D maxsize → P
        T loop = ∞ (
            P i = range(1, len(lines))[_loop_index]
            // lines[i] := lines[i][margin:Ω]
        ) (D |range(1, len(lines))|)
    T while_loop = ∞ (
        T check = → if (lines && (!lines[(-1)])) → P  // while body follows
            lines D pop(P)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    T while_loop = ∞ (
        T check = → if (lines && (!lines[0])) → P  // while body follows
            lines D pop(0)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → "\n" D join(lines)
}
D getfile = λ object . {
    // Work out which source or compiled file an object was defined in.
    T cond = → if ismodule(object) → P
        T cond = → if getattr(object, "__file__", P) → → object D __file__
        → E TypeError("{!r} is a built-in module" D format(object))
    T cond = → if isclass(object) → P
        T cond = → if hasattr(object, "__module__") → P
            P module = sys D modules D get(object D __module__)
            T cond = → if getattr(module, "__file__", P) → → module D __file__
            T cond = → if object D __module__ == "__main__" → → E OSError("source code not available")
        → E TypeError("{!r} is a built-in class" D format(object))
    T cond = → if ismethod(object) → P object = object D __func__
    T cond = → if isfunction(object) → P object = object D __code__
    T cond = → if istraceback(object) → P object = object D tb_frame
    T cond = → if isframe(object) → P object = object D f_code
    T cond = → if iscode(object) → → object D co_filename
    → E TypeError("module, class, method, function, traceback, frame, or code object was expected, got {}" D format(type(object) D __name__))
}
D getmodulename = λ path . {
    // Return the module name for a given file, or None.
    P fname = os D path D basename(path)
    P suffixes = { T loop = ∞ (manifold [(-len(suffix)), suffix]) (D |importlib D machinery D all_suffixes(P)|) }
    suffixes D sort(P)
    T loop = ∞ (
        P manifold__neglen__suffix = suffixes[_loop_index]  // manifold [neglen, suffix]
        T cond = → if fname D endswith(suffix) → → fname[0:neglen]
    ) (D |suffixes|)
    → P
}
D getsourcefile = λ object . {
    // Return the filename that can be used to locate an object's source.     Return None if no way can be identified to get th
    P filename = getfile(object)
    P all_bytecode_suffixes = importlib D machinery D DEBUG_BYTECODE_SUFFIXES[0:Ω]
    P all_bytecode_suffixes = all_bytecode_suffixes + importlib D machinery D OPTIMIZED_BYTECODE_SUFFIXES[0:Ω]
    T cond = → if any({ T loop = ∞ (filename D endswith(s)) (D |all_bytecode_suffixes|) }) → P filename = (os D path D splitext(filename)[0] + importlib D machinery D SOURCE_SUFFIXES[0])
    → E P
        T cond = → if any({ T loop = ∞ (filename D endswith(s)) (D |importlib D machinery D EXTENSION_SUFFIXES|) }) → → P
        → E T cond = → if filename D endswith(".fwork") → → P
    T cond = → if filename == linecache D cache → → filename
    T cond = → if os D path D exists(filename) → → filename
    P module = getmodule(object, filename)
    T cond = → if getattr(module, "__loader__", P) ≠ P → → filename
    → E T cond = → if getattr(getattr(module, "__spec__", P), "loader", P) ≠ P → → filename
}
D getabsfile = λ object, _filename . {
    // Return an absolute path to the source or compiled file for an object.      The idea is for each object to have a unique 
    T cond = → if _filename == P → P _filename = (getsourcefile(object) || getfile(object))
    → os D path D normcase(os D path D abspath(_filename))
}
P modulesbyfile = manifold []
P _filesbymodname = manifold []
D getmodule = λ object, _filename . {
    // Return the module an object was defined in, or None if not found.
    T cond = → if ismodule(object) → → object
    T cond = → if hasattr(object, "__module__") → → sys D modules D get(object D __module__)
    T cond = → if (_filename ≠ P && _filename == modulesbyfile) → → sys D modules D get(modulesbyfile[_filename])
    T attempt = → P  // try
        P file = getabsfile(object, _filename)
    → E manifold [TypeError, FileNotFoundError] (_)
        → P
    T cond = → if file == modulesbyfile → → sys D modules D get(modulesbyfile[file])
    T loop = ∞ (
        P manifold__modname__module = sys D modules D copy(P) D items(P)[_loop_index]  // manifold [modname, module]
        T cond = → if (ismodule(module) && hasattr(module, "__file__")) → P
            P f = module D __file__
            T cond = → if f == _filesbymodname D get(modname, P) → P  // pass
            // _filesbymodname[modname] := f
            P f = getabsfile(module)
            // modulesbyfile[f] := module D __name__
            // modulesbyfile[os D path D realpath(f)] := module D __name__
    ) (D |sys D modules D copy(P) D items(P)|)
    T cond = → if file == modulesbyfile → → sys D modules D get(modulesbyfile[file])
    P main = sys D modules["__main__"]
    T cond = → if (!hasattr(object, "__name__")) → → P
    T cond = → if hasattr(main, object D __name__) → P
        P mainobject = getattr(main, object D __name__)
        T cond = → if mainobject == object → → main
    P builtin = sys D modules["builtins"]
    T cond = → if hasattr(builtin, object D __name__) → P
        P builtinobject = getattr(builtin, object D __name__)
        T cond = → if builtinobject == object → → builtin
}
D ClassFoundException = λ . P  // class(Exception)
    // pass
D findsource = λ object . {
    // Return the entire source file and starting line number for an object.      The argument may be a module, class, method, 
    P file = getsourcefile(object)
    T cond = → if file → linecache D checkcache(file)
    → E P
        P file = getfile(object)
        T cond = → if ((!(file D startswith("<") && file D endswith(">"))) || file D endswith(".fwork")) → → E OSError("source code not available")
    P module = getmodule(object, file)
    T cond = → if module → P
        P lines = linecache D getlines(file, module D __dict__)
        T cond = → if ((!lines) && file D startswith("<") && hasattr(object, "__code__")) → P lines = linecache D _getlines_from_code(object D __code__)
    → E P lines = linecache D getlines(file)
    T cond = → if (!lines) → → E OSError("could not get source code")
    T cond = → if ismodule(object) → → manifold [lines, 0]
    T cond = → if isclass(object) → P
        T attempt = → P  // try
            P lnum = (vars(object)["__firstlineno__"] - 1)
        → E manifold [TypeError, KeyError] (_)
            → E OSError("source code not available")
        T cond = → if lnum ≥ len(lines) → → E OSError("lineno is out of bounds")
        → manifold [lines, lnum]
    T cond = → if ismethod(object) → P object = object D __func__
    T cond = → if isfunction(object) → P object = object D __code__
    T cond = → if istraceback(object) → P object = object D tb_frame
    T cond = → if isframe(object) → P object = object D f_code
    T cond = → if iscode(object) → P
        T cond = → if (!hasattr(object, "co_firstlineno")) → → E OSError("could not find function definition")
        P lnum = (object D co_firstlineno - 1)
        T cond = → if lnum ≥ len(lines) → → E OSError("lineno is out of bounds")
        → manifold [lines, lnum]
    → E OSError("could not find code object")
}
D getcomments = λ object . {
    // Get lines of comments immediately preceding an object's source code.      Returns None when source can't be found.
    T attempt = → P  // try
        P manifold__lines__lnum = findsource(object)  // manifold [lines, lnum] := findsource(object)
    → E manifold [OSError, TypeError] (_)
        → P
    T cond = → if ismodule(object) → P
        P start = 0
        T cond = → if (lines && lines[0][0:2] == "#!") → P start = 1
        T while_loop = ∞ (
            T check = → if (start < len(lines) && lines[start] D strip(P) == manifold ["", "#"]) → P  // while body follows
                P start = (start + 1)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if (start < len(lines) && lines[start][0:1] == "#") → P
            P comments = manifold []
            P end = start
            T while_loop = ∞ (
                T check = → if (end < len(lines) && lines[end][0:1] == "#") → P  // while body follows
                    comments D append(lines[end] D expandtabs(P))
                    P end = (end + 1)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            → "" D join(comments)
    → E P
        T cond = → if lnum > 0 → P
            P indent = indentsize(lines[lnum])
            P end = (lnum - 1)
            T cond = → if (end ≥ 0 && lines[end] D lstrip(P)[0:1] == "#" && indentsize(lines[end]) == indent) → P
                P comments = manifold [lines[end] D expandtabs(P) D lstrip(P)]
                T cond = → if end > 0 → P
                    P end = (end - 1)
                    P comment = lines[end] D expandtabs(P) D lstrip(P)
                    T while_loop = ∞ (
                        T check = → if (comment[0:1] == "#" && indentsize(lines[end]) == indent) → P  // while body follows
                            // comments[0:0] := manifold [comment]
                            P end = (end - 1)
                            T cond = → if end < 0 → P  // pass
                            P comment = lines[end] D expandtabs(P) D lstrip(P)
                    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                T while_loop = ∞ (
                    T check = → if (comments && comments[0] D strip(P) == "#") → P  // while body follows
                        // comments[0:1] := manifold []
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                T while_loop = ∞ (
                    T check = → if (comments && comments[(-1)] D strip(P) == "#") → P  // while body follows
                        // comments[(-1):Ω] := manifold []
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                → "" D join(comments)
}
D EndOfBlock = λ . P  // class(Exception)
    // pass
D BlockFinder = λ . P  // class
    // Provide a tokeneater() method to detect the end of a code block.
    D BlockFinder____init = λ self . {
        D self_D_indent = 0  // self D indent := 0
        D self_D_singleline = 0  // self D singleline := 0
        D self_D_started = 0  // self D started := 0
        D self_D_passline = 0  // self D passline := 0
        D self_D_indecorator = 0  // self D indecorator := 0
        D self_D_last = 1  // self D last := 1
        D self_D_body_col0 = P  // self D body_col0 := P
    }
    D BlockFinder__tokeneater = λ self, type, token, srowcol, erowcol, line . {
        T cond = → if ((!self D started) && (!self D indecorator)) → P
            T cond = → if type == manifold [tokenize D INDENT, tokenize D COMMENT, tokenize D NL] → P  // pass
            D self_D_passline = 1  // self D passline := 1
        → E P
            T cond = → if type == tokenize D NEWLINE → P
                D self_D_passline = 0  // self D passline := 0
                D self_D_last = srowcol[0]  // self D last := srowcol[0]
                T cond = → if self D singleline → → E EndOfBlock
                T cond = → if self D indecorator → D self_D_indecorator = 0  // self D indecorator := 0
            → E T cond = → if self D passline → P  // pass
    }
D getblock = λ lines . {
    // Extract the block of code at the top of the given list of lines.
    P blockfinder = BlockFinder(P)
    T attempt = → P  // try
        P tokens = tokenize D generate_tokens(iter(lines) D __next__)
        T loop = ∞ (
            P _token = tokens[_loop_index]
            blockfinder D tokeneater(_token)
        ) (D |tokens|)
    → E manifold [EndOfBlock, IndentationError] (_)
        // pass
    → E SyntaxError (e)
        T cond = → if "unmatched" ≠ e D msg → → E e
        P manifold______token_info = _token  // manifold [_, _token_info] := _token
        T attempt = → P  // try
            blockfinder D tokeneater(tokenize D NEWLINE, _token_info)
        → E manifold [EndOfBlock, IndentationError] (_)
            // pass
    → lines[0:blockfinder D last]
}
D getsourcelines = λ object . {
    // Return a list of source lines and starting line number for an object.      The argument may be a module, class, method, 
    P object = unwrap(object)
    P manifold__lines__lnum = findsource(object)  // manifold [lines, lnum] := findsource(object)
    T cond = → if istraceback(object) → P object = object D tb_frame
    T cond = → if (ismodule(object) || (isframe(object) && object D f_code D co_name == "<module>")) → → manifold [lines, 0]
    → E → manifold [getblock(lines[lnum:Ω]), (lnum + 1)]
}
D getsource = λ object . {
    // Return the text of the source code for an object.      The argument may be a module, class, method, function, traceback,
    P manifold__lines__lnum = getsourcelines(object)  // manifold [lines, lnum] := getsourcelines(object)
    → "" D join(lines)
