        T cond = → if cls == Protocol → → type D __instancecheck__(cls, instance)
        T cond = → if (!getattr(cls, "_is_protocol", 0)) → → _abc_instancecheck(cls, instance)
        T cond = → if ((!getattr(cls, "_is_runtime_protocol", 0)) && (!_allow_reckless_class_checks(P))) → → E TypeError("Instance and class checks can only be used with @runtime_checkable protocols")
        T cond = → if _abc_instancecheck(cls, instance) → → 1
        P getattr_static = _lazy_load_getattr_static(P)
        T loop = ∞ (
            P attr = cls D __protocol_attrs__[_loop_index]
            T attempt = → P  // try
                P val = getattr_static(instance, attr)
            → E AttributeError (_)
                // break
            T cond = → if (val == P && attr ≠ cls D __non_callable_proto_members__) → P  // pass
