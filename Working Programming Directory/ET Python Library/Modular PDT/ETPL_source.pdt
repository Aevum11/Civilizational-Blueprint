                                                T attempt = → P  // try
                                                    → os D getuid(P)
                                                → E AttributeError (_)
                                                    → 0
                                            → E P
                                                T cond = → if addr_str == "getgid" → P
                                                    T attempt = → P  // try
                                                        → os D getgid(P)
                                                    → E AttributeError (_)
                                                        → 0
                                                → E P
                                                    T cond = → if addr_str == "cwd" → → os D getcwd(P)
                                                    → E P
                                                        T cond = → if addr_str == "readline" → P
                                                            T attempt = → P  // try
                                                                → sys D stdin D readline(P)
                                                            → E Exception (_)
                                                                → ""
                                                        → E P
                                                            T cond = → if addr_str == "environ" → → dict(os D environ)
                                                            → E P
                                                                T cond = → if addr_str == "pipe" → P
                                                                    T attempt = → P  // try
                                                                        P manifold__r__w = os D pipe(P)  // manifold [r, w] := os D pipe(P)
                                                                        → manifold [r, w]
                                                                    → E Exception (_)
                                                                        → manifold [0, 1]
                                                                → E P
                                                                    T cond = → if addr_str == "fork" → P
                                                                        T attempt = → P  // try
                                                                            → os D fork(P)
                                                                        → E AttributeError (_)
                                                                            → (-1)
                                                                    → E P
                                                                        T cond = → if addr_str D startswith("open") → → 3
                                                                        → E P
                                                                            T cond = → if addr_str D startswith("close") → → 0
                                                                            → E P
                                                                                T cond = → if addr_str D startswith("read") → → b''
                                                                                → E P
                                                                                    T cond = → if addr_str D startswith("write") → → 0
                                                                                    → E P
                                                                                        T cond = → if addr_str D startswith("listdir") → P
                                                                                            T attempt = → P  // try
                                                                                                → os D listdir(".")
                                                                                            → E Exception (_)
                                                                                                → manifold []
                                                                                        → E P
                                                                                            T cond = → if addr_str D startswith("path_join") → → os D path D join(if "∘" == addr_str → addr_str D split("∘")[(-1)] D strip(P) → E ".")
                                                                                            → E P
                                                                                                T cond = → if addr_str D startswith("path_exists") → P
                                                                                                    P path_arg = addr_str D replace("path_exists", "") D strip(P)
                                                                                                    → if path_arg → int(os D path D exists(path_arg)) → E 0
                                                                                                → E P
                                                                                                    T cond = → if addr_str D startswith("path_isfile") → P
                                                                                                        P path_arg = addr_str D replace("path_isfile", "") D strip(P)
                                                                                                        → if path_arg → int(os D path D isfile(path_arg)) → E 0
                                                                                                    → E P
                                                                                                        T cond = → if addr_str D startswith("path_isdir") → P
                                                                                                            P path_arg = addr_str D replace("path_isdir", "") D strip(P)
                                                                                                            → if path_arg → int(os D path D isdir(path_arg)) → E 0
                                                                                                        → E P
                                                                                                            T cond = → if addr_str D startswith("path_abspath") → P
                                                                                                                P path_arg = addr_str D replace("path_abspath", "") D strip(P)
                                                                                                                → if path_arg → os D path D abspath(path_arg) → E os D getcwd(P)
                                                                                                            → E P
                                                                                                                T cond = → if addr_str D startswith("path_dirname") → P
                                                                                                                    P path_arg = addr_str D replace("path_dirname", "") D strip(P)
                                                                                                                    → if path_arg → os D path D dirname(path_arg) → E ""
                                                                                                                → E P
                                                                                                                    T cond = → if addr_str D startswith("path_basename") → P
                                                                                                                        P path_arg = addr_str D replace("path_basename", "") D strip(P)
                                                                                                                        → if path_arg → os D path D basename(path_arg) → E ""
                                                                                                                    → E P
                                                                                                                        T cond = → if addr_str D startswith("path_splitext") → P
                                                                                                                            P path_arg = addr_str D replace("path_splitext", "") D strip(P)
                                                                                                                            → if path_arg → list(os D path D splitext(path_arg)) → E manifold ["", ""]
                                                                                                                        → E P
                                                                                                                            T cond = → if addr_str D startswith("path_expanduser") → P
                                                                                                                                P path_arg = addr_str D replace("path_expanduser", "") D strip(P)
                                                                                                                                → if path_arg → os D path D expanduser(path_arg) → E "."
                                                                                                                            → E P
                                                                                                                                T cond = → if addr_str D startswith("path_expandvars") → P
                                                                                                                                    P path_arg = addr_str D replace("path_expandvars", "") D strip(P)
                                                                                                                                    → if path_arg → os D path D expandvars(path_arg) → E ""
                                                                                                                                → E P
                                                                                                                                    T cond = → if addr_str D startswith("path_getsize") → P
                                                                                                                                        P path_arg = addr_str D replace("path_getsize", "") D strip(P)
                                                                                                                                        T attempt = → P  // try
                                                                                                                                            → os D path D getsize(path_arg)
                                                                                                                                        → E Exception (_)
                                                                                                                                            → 0
                                                                                                                                    → E P
                                                                                                                                        T cond = → if addr_str D startswith("path_getmtime") → P
                                                                                                                                            P path_arg = addr_str D replace("path_getmtime", "") D strip(P)
                                                                                                                                            T attempt = → P  // try
                                                                                                                                                → os D path D getmtime(path_arg)
                                                                                                                                            → E Exception (_)
                                                                                                                                                → 0.0
                                                                                                                                        → E P
                                                                                                                                            T cond = → if addr_str D startswith("stat") → P
                                                                                                                                                P path_arg = addr_str D replace("stat", "") D strip(P)
                                                                                                                                                T attempt = → P  // try
                                                                                                                                                    P s = os D stat(path_arg)
                                                                                                                                                    → manifold [s D st_mode, s D st_ino, s D st_dev, s D st_nlink, s D st_uid, s D st_gid, s D st_size, s D st_atime, s D st_mtime, s D st_ctime]
                                                                                                                                                → E Exception (_)
                                                                                                                                                    → (manifold [0] * 10)
                                                                                                                                            → E P
                                                                                                                                                T cond = → if addr_str D startswith("gmtime") → P
                                                                                                                                                    T attempt = → P  // try
                                                                                                                                                        P t_arg = float((addr_str D replace("gmtime", "") D strip(P) || time D time(P)))
                                                                                                                                                        P gt = time D gmtime(t_arg)
                                                                                                                                                        → list(gt[0:9])
                                                                                                                                                    → E Exception (_)
                                                                                                                                                        → (manifold [0] * 9)
                                                                                                                                                → E P
                                                                                                                                                    T cond = → if addr_str D startswith("localtime") → P
                                                                                                                                                        T attempt = → P  // try
                                                                                                                                                            P t_arg = float((addr_str D replace("localtime", "") D strip(P) || time D time(P)))
                                                                                                                                                            P lt = time D localtime(t_arg)
                                                                                                                                                            → list(lt[0:9])
                                                                                                                                                        → E Exception (_)
                                                                                                                                                            → (manifold [0] * 9)
                                                                                                                                                    → E P
                                                                                                                                                        T cond = → if addr_str D startswith("timezone") → P
                                                                                                                                                            T attempt = → P  // try
                                                                                                                                                                → time D timezone
                                                                                                                                                            → E Exception (_)
                                                                                                                                                                → 0
                                                                                                                                                        → E P
                                                                                                                                                            T cond = → if addr_str D startswith("etb_decode") → → P
                                                                                                                                                            → E P
