            P val = self D _gen_ir_expr(node D body, module, builder)
            T cond = → if val ≠ P → P
                T attempt = → P  // try
                    P existing = module D get_global(node D name)
                    T cond = → if existing D type D pointee == val D type → P gv = existing
                    → E P
                        P suffix = 1
                        T while_loop = ∞ (
                            T check = → if 1 → P  // while body follows
                                P shadow_name = node D name + "." + suffix
                                T attempt = → P  // try
                                    module D get_global(shadow_name)
                                    P suffix = suffix + 1
                                → E KeyError (_)
                                    // break
                        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                        P gv = llvm_ir D GlobalVariable(module, val D type, shadow_name)
                → E KeyError (_)
                    P gv = llvm_ir D GlobalVariable(module, val D type, node D name)
