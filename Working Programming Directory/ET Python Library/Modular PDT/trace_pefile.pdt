    D PE__get_string_u_at_rva = λ self, rva, max_length, encoding . {
        // Get an Unicode string located at the given address.
        T cond = → if max_length == 0 → → b''
        P data = self D get_data(rva, 2)
        P max_length = max_length << 1
        P requested = min(max_length, 256)
        P data = self D get_data(rva, requested)
        P null_index = (-1)
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P null_index = data D find(b'\x00\x00', (null_index + 1))
                T cond = → if null_index == (-1) → P
                    P data_length = len(data)
                    T cond = → if (data_length < requested || data_length == max_length) → P null_index = (len(data) >> 1)
                    P data = data + self D get_data((rva + data_length), (max_length - data_length))
                    P null_index = (requested - 1)
                    P requested = max_length
                → E T cond = → if (null_index % 2) == 0 → P null_index = null_index >> 1
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        P uchrs = struct D unpack("<{:d}H" D format(null_index), data[0:(null_index * 2)])
