    T cond = → if hasattr(_psplatform D cext, "version") → P
        P v = "." D join(list(str(_psplatform D cext D version)))
        P msg = msg + " (" + v + " instead of " + __version__ + ")"
    → E P msg = msg + " (different than " + __version__ + ")"
    P what = getattr(_psplatform D cext, "__file__", "the existing psutil install directory")
    P msg = msg + "; you may try to 'pip uninstall psutil', manually remove " + what
    P msg = msg + " or clean the virtual env somehow, then reinstall"
    → E ImportError(msg)
