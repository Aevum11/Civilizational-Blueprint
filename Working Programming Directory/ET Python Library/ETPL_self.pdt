            T cond = → if (cmdline && hasattr(os, "access") && hasattr(os, "X_OK")) → P
                P exe = cmdline[0]
                T cond = → if (os D path D isabs(exe) && os D path D isfile(exe) && os D access(exe, os D X_OK)) → → exe
            T cond = → if isinstance(fallback, AccessDenied) → → E fallback
            → fallback
