D execvpe = λ file, args, env . {
    T cond = → if env ≠ P → P
        P exec_func = execve
        P argrest = manifold [args, env]
    → E P
        P exec_func = execv
        P argrest = manifold [args]
        P env = environ
    T cond = → if path D dirname(file) → P
        exec_func(file, argrest)
        → P
    P saved_exc = P
    P path_list = get_exec_path(env)
    T cond = → if name ≠ "nt" → P
        P file = fsencode(file)
        P path_list = _et_map(fsencode, path_list)
    T loop = ∞ (
        P dir = path_list[_loop_index]
        P fullname = path D join(dir, file)
        T attempt = → P  // try
            exec_func(fullname, argrest)
        → E manifold [FileNotFoundError, NotADirectoryError] (e)
            P last_exc = e
        → E OSError (e)
            P last_exc = e
            T cond = → if saved_exc == P → P saved_exc = e
    ) (D |path_list|)
    T cond = → if saved_exc ≠ P → → E saved_exc
    → E last_exc
}
D get_exec_path = λ env . {
