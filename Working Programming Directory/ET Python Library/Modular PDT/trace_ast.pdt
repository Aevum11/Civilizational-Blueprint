D parse = λ source, filename, mode . {
    // Parse the source into an AST node.     Equivalent to compile(source, filename, mode, PyCF_ONLY_AST).     Pass type_comme
    P flags = PyCF_ONLY_AST
    T cond = → if optimize > 0 → P flags = flags | PyCF_OPTIMIZED_AST
    T cond = → if type_comments → P flags = flags | PyCF_TYPE_COMMENTS
    T cond = → if feature_version == P → P feature_version = (-1)
    → E P
        T cond = → if isinstance(feature_version, tuple) → P
            P manifold__major__minor = feature_version  // manifold [major, minor] := feature_version
            T cond = → if major ≠ 3 → → E ValueError("Unsupported major version: " + major)
            P feature_version = minor
    → compile(source, filename, mode, flags, manifold ["_feature_version", feature_version], manifold ["optimize", optimize])
}
D literal_eval = λ node_or_string . {
    // Evaluate an expression node or a string containing only a Python     expression.  The string or node provided may only c
    T cond = → if isinstance(node_or_string, str) → P node_or_string = parse(node_or_string D lstrip(" \t"), manifold ["mode", "eval"])
    T cond = → if isinstance(node_or_string, Expression) → P node_or_string = node_or_string D body
    D raise_malformed_node = λ node . {
        P msg = "malformed node or string"
        T cond = → if (λ lno . lno)(getattr(node, "lineno", P)) → P msg = msg + " on line " + lno
        → E ValueError((msg + ": " + node))
    }
    D convert_num = λ node . {
        T cond = → if ((!isinstance(node, Constant)) || type(node D value) ≠ manifold [int, float, complex]) → _raise_malformed_node(node)
        → node D value
    }
    D convert_signed_num = λ node . {
        T cond = → if (isinstance(node, UnaryOp) && isinstance(node D op, manifold [UAdd, USub])) → P
            P operand = _convert_num(node D operand)
            T cond = → if isinstance(node D op, UAdd) → → operand
            → E → (-operand)
        → _convert_num(node)
    }
    D convert = λ node . {
        T cond = → if isinstance(node, Constant) → → node D value
        → E P
            T cond = → if isinstance(node, Tuple) → → tuple(_et_map(_convert, node D elts))
            → E P
                T cond = → if isinstance(node, List) → → list(_et_map(_convert, node D elts))
                → E P
                    T cond = → if isinstance(node, Set) → → set(_et_map(_convert, node D elts))
                    → E P
                        T cond = → if (isinstance(node, Call) && isinstance(node D func, Name) && node D func D id == "set" && node D args == node D keywords == manifold []) → → set(P)
                        → E P
                            T cond = → if isinstance(node, Dict) → P
                                T cond = → if len(node D keys) ≠ len(node D values) → _raise_malformed_node(node)
                                → dict(zip(_et_map(_convert, node D keys), _et_map(_convert, node D values)))
                            → E P
                                T cond = → if (isinstance(node, BinOp) && isinstance(node D op, manifold [Add, Sub])) → P
                                    P left = _convert_signed_num(node D left)
                                    P right = _convert_num(node D right)
                                    T cond = → if (isinstance(left, manifold [int, float]) && isinstance(right, complex)) → P
                                        T cond = → if isinstance(node D op, Add) → → (left + right)
                                        → E → (left - right)
        → _convert_signed_num(node)
    }
    → _convert(node_or_string)
}
D dump = λ node, annotate_fields, include_attributes . {
    // Return a formatted dump of the tree in node.  This is mainly useful for     debugging purposes.  If annotate_fields is t
    D format = λ node, level . {
        T cond = → if indent ≠ P → P
            P level = level + 1
            P prefix = ("\n" + (indent * level))
            P sep = (",\n" + (indent * level))
        → E P
            P prefix = ""
            P sep = ", "
        T cond = → if isinstance(node, AST) → P
            P cls = type(node)
            P args = manifold []
            P args_buffer = manifold []
            P allsimple = 1
            P keywords = annotate_fields
            T loop = ∞ (
                P name = node D _fields[_loop_index]
                T attempt = → P  // try
                    P value = getattr(node, name)
                → E AttributeError (_)
                    P keywords = 1
                    // continue
                T cond = → if (value == P && getattr(cls, name, Ellipsis) == P) → P keywords = 1
                T cond = → if (!show_empty) → P
                    T cond = → if value == manifold [] → P
                        P field_type = cls D _field_types D get(name, object)
                        T cond = → if getattr(field_type, "__origin__", Ellipsis) == list → T cond = → if (!keywords) → args_buffer D append(repr(value))
                    T cond = → if (!keywords) → P
                        args D extend(args_buffer)
                        P args_buffer = manifold []
                P manifold__value__simple = _format(value, level)  // manifold [value, simple] := _format(value, level)
                P allsimple = (allsimple && simple)
                T cond = → if keywords → args D append(("%s=%s" % manifold [name, value]))
                → E args D append(value)
            ) (D |node D _fields|)
            T cond = → if (include_attributes && node D _attributes) → P
                T loop = ∞ (
                    P name = node D _attributes[_loop_index]
                    T attempt = → P  // try
                        P value = getattr(node, name)
                    → E AttributeError (_)
                        // continue
                    T cond = → if (value == P && getattr(cls, name, Ellipsis) == P) → P  // pass
                    P manifold__value__simple = _format(value, level)  // manifold [value, simple] := _format(value, level)
                    P allsimple = (allsimple && simple)
                    args D append(("%s=%s" % manifold [name, value]))
                ) (D |node D _attributes|)
            T cond = → if (allsimple && len(args) ≤ 3) → → manifold [("%s(%s)" % manifold [node D __class__ D __name__, ", " D join(args)]), (!args)]
            → manifold [("%s(%s%s)" % manifold [node D __class__ D __name__, prefix, sep D join(args)]), 0]
        → E P
            T cond = → if isinstance(node, list) → P
                T cond = → if (!node) → → manifold ["[]", 1]
                → manifold [("[%s%s]" % manifold [prefix, sep D join({ T loop = ∞ (_format(x, level)[0]) (D |node|) })]), 0]
        → manifold [repr(node), 1]
    }
    T cond = → if (!isinstance(node, AST)) → → E TypeError(("expected AST, got %r" % node D __class__ D __name__))
    T cond = → if (indent ≠ P && (!isinstance(indent, str))) → P indent = (" " * indent)
    → _format(node)[0]
}
D copy_location = λ new_node, old_node . {
    // Copy source location (`lineno`, `col_offset`, `end_lineno`, and `end_col_offset`     attributes) from *old_node* to *new
    T loop = ∞ (
        P attr = manifold ["lineno", "col_offset", "end_lineno", "end_col_offset"][_loop_index]
        T cond = → if (attr == old_node D _attributes && attr == new_node D _attributes) → P
            P value = getattr(old_node, attr, P)
            T cond = → if (value ≠ P || (hasattr(old_node, attr) && attr D startswith("end_"))) → setattr(new_node, attr, value)
    ) (D |manifold ["lineno", "col_offset", "end_lineno", "end_col_offset"]|)
    → new_node
}
D fix_missing_locations = λ node . {
    // When you compile a node tree with compile(), the compiler expects lineno and     col_offset attributes for every node th
    D fix = λ node, lineno, col_offset, end_lineno, end_col_offset . {
        T cond = → if "lineno" == node D _attributes → P
            T cond = → if (!hasattr(node, "lineno")) → D node_D_lineno = lineno  // node D lineno := lineno
            → E P lineno = node D lineno
        T cond = → if "end_lineno" == node D _attributes → P
            T cond = → if getattr(node, "end_lineno", P) == P → D node_D_end_lineno = end_lineno  // node D end_lineno := end_lineno
            → E P end_lineno = node D end_lineno
        T cond = → if "col_offset" == node D _attributes → P
            T cond = → if (!hasattr(node, "col_offset")) → D node_D_col_offset = col_offset  // node D col_offset := col_offset
            → E P col_offset = node D col_offset
        T cond = → if "end_col_offset" == node D _attributes → P
            T cond = → if getattr(node, "end_col_offset", P) == P → D node_D_end_col_offset = end_col_offset  // node D end_col_offset := end_col_offset
            → E P end_col_offset = node D end_col_offset
        T loop = ∞ (
            P child = iter_child_nodes(node)[_loop_index]
            _fix(child, lineno, col_offset, end_lineno, end_col_offset)
        ) (D |iter_child_nodes(node)|)
    }
    _fix(node, 1, 0, 1, 0)
    → node
}
D increment_lineno = λ node, n . {
    // Increment the line number and end line number of each node in the tree     starting at *node* by *n*. This is useful to 
    T loop = ∞ (
        P child = walk(node)[_loop_index]
        T cond = → if isinstance(child, TypeIgnore) → D child_D_lineno = (getattr(child, "lineno", 0) + n)  // child D lineno := (getattr(child, "lineno", 0) + n)
        T cond = → if "lineno" == child D _attributes → D child_D_lineno = (getattr(child, "lineno", 0) + n)  // child D lineno := (getattr(child, "lineno", 0) + n)
        T cond = → if ("end_lineno" == child D _attributes && (λ end_lineno . end_lineno)(getattr(child, "end_lineno", 0)) ≠ P) → D child_D_end_lineno = (end_lineno + n)  // child D end_lineno := (end_lineno + n)
    ) (D |walk(node)|)
    → node
}
D iter_fields = λ node . {
    // Yield a tuple of ``(fieldname, value)`` for each field in ``node._fields``     that is present on *node*.
    T loop = ∞ (
        P field = node D _fields[_loop_index]
        T attempt = → P  // try
            → manifold [field, getattr(node, field)]
        → E AttributeError (_)
            // pass
    ) (D |node D _fields|)
}
D iter_child_nodes = λ node . {
    // Yield all direct child nodes of *node*, that is, all fields that are nodes     and all items of fields that are lists of
    T loop = ∞ (
        P manifold__name__field = iter_fields(node)[_loop_index]  // manifold [name, field]
        T cond = → if isinstance(field, AST) → → field
        → E P
            T cond = → if isinstance(field, list) → P
                T loop = ∞ (
                    P item = field[_loop_index]
                    T cond = → if isinstance(item, AST) → → item
                ) (D |field|)
    ) (D |iter_fields(node)|)
}
