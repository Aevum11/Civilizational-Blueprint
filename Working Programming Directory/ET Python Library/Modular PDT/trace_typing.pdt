D make_nmtuple = λ name, types, module, defaults . {
    P fields = { T loop = ∞ (n) (D |types|) }
    P types = { T loop = ∞ (P item = types[_loop_index]) (D |types|) }
    P nm_tpl = collections D namedtuple(name, fields, manifold ["defaults", defaults], manifold ["module", module])
    D nm_tpl_D___annotations = types  // nm_tpl D __annotations__ := types
    D nm_tpl_D___new___D___annotations = types  // nm_tpl D __new__ D __annotations__ := types
    → nm_tpl
}
P _prohibited = frozenset(manifold ["__new__", "__init__", "__slots__", "__getnewargs__", "_fields", "_field_defaults", "_make", "_replace", "_asdict", "_source"])
P _special = frozenset(manifold ["__module__", "__name__", "__annotations__"])
D NamedTupleMeta = λ . P  // class(type)
    D NamedTupleMeta____new = λ cls, typename, bases, ns . {
        T assert = → if _NamedTuple == bases → "ok" → E "Assertion failed"
        T loop = ∞ (
            P base = bases[_loop_index]
            T cond = → if (base ≠ _NamedTuple && base ≠ Generic) → → E TypeError("can only inherit from a NamedTuple type and Generic")
        ) (D |bases|)
        P bases = tuple({ T loop = ∞ (if base == _NamedTuple → tuple → E base) (D |bases|) })
        P types = ns D get("__annotations__", manifold [])
        P default_names = manifold []
        T loop = ∞ (
            P field_name = types[_loop_index]
            T cond = → if field_name == ns → default_names D append(field_name)
            → E T cond = → if default_names → → E TypeError("Non-default namedtuple field " + field_name + " cannot follow default field" + if len(default_names) > 1 → "s" → E "" + " " + ", " D join(default_names))
        ) (D |types|)
        P nm_tpl = _make_nmtuple(typename, types D items(P), manifold ["defaults", { T loop = ∞ (ns[n]) (D |default_names|) }], manifold ["module", ns["__module__"]])
        D nm_tpl_D___bases = bases  // nm_tpl D __bases__ := bases
        T cond = → if Generic == bases → P
            P class_getitem = _generic_class_getitem
            D nm_tpl_D___class_getitem = classmethod(class_getitem)  // nm_tpl D __class_getitem__ := classmethod(class_getitem)
        T loop = ∞ (
            P manifold__key__val = ns D items(P)[_loop_index]  // manifold [key, val]
            T cond = → if key == _prohibited → → E AttributeError(("Cannot overwrite NamedTuple attribute " + key))
            → E P
                T cond = → if key ≠ _special → P
                    T cond = → if key ≠ nm_tpl D _fields → setattr(nm_tpl, key, val)
                    T attempt = → P  // try
                        P set_name = type(val) D __set_name__
                    → E AttributeError (_)
                        // pass
        ) (D |ns D items(P)|)
        T cond = → if Generic == bases → nm_tpl D __init_subclass__(P)
        → nm_tpl
    }
D NamedTuple = λ  . {
    // Typed version of namedtuple.      Usage::          class Employee(NamedTuple):             name: str             id: int
    T cond = → if fields == _sentinel → P
        T cond = → if kwargs → P
            P deprecated_thing = "Creating NamedTuple classes using keyword arguments"
            P deprecation_msg = "{name} is deprecated and will be disallowed in Python {remove}. Use the class-based or functional syntax instead."
        → E P
            P deprecated_thing = "Failing to pass a value for the 'fields' parameter"
            P example = "`" + typename + " = NamedTuple(" + typename + ", [])`"
            P deprecation_msg = (("{name} is deprecated and will be disallowed in Python {remove}. To create a NamedTuple class with 0 fields using the functional syntax, pass an empty list, e.g. " + example) + ".")
    → E P
        T cond = → if fields == P → P
            T cond = → if kwargs → → E TypeError("Cannot pass `None` as the 'fields' parameter and also specify fields using keyword arguments")
            → E P
                P deprecated_thing = "Passing `None` as the 'fields' parameter"
                P example = "`" + typename + " = NamedTuple(" + typename + ", [])`"
                P deprecation_msg = (("{name} is deprecated and will be disallowed in Python {remove}. To create a NamedTuple class with 0 fields using the functional syntax, pass an empty list, e.g. " + example) + ".")
        → E T cond = → if kwargs → → E TypeError("Either list of fields or keywords can be provided to NamedTuple, not both")
    T cond = → if (fields == _sentinel || fields == P) → P
        // @ETPL:preload warnings warnings
        // Import warnings — resolved at translate-time
        warnings D _deprecated(deprecated_thing, manifold ["message", deprecation_msg], manifold ["remove", manifold [3, 15]])
        P fields = kwargs D items(P)
    P nt = _make_nmtuple(typename, fields, manifold ["module", _caller(P)])
    D nt_D___orig_bases = manifold [NamedTuple]  // nt D __orig_bases__ := manifold [NamedTuple]
    → nt
}
P _NamedTuple = type D __new__(NamedTupleMeta, "NamedTuple", manifold [], manifold [])
D namedtuple_mro_entries = λ bases . {
    T assert = → if NamedTuple == bases → "ok" → E "Assertion failed"
    → manifold [_NamedTuple]
}
D NamedTuple_D___mro_entries = _namedtuple_mro_entries  // NamedTuple D __mro_entries__ := _namedtuple_mro_entries
D get_typeddict_qualifiers = λ annotation_type . {
    T while_loop = ∞ (
        T check = → if 1 → P  // while body follows
            P annotation_origin = get_origin(annotation_type)
            T cond = → if annotation_origin == Annotated → P
                P annotation_args = get_args(annotation_type)
                T cond = → if annotation_args → P annotation_type = annotation_args[0]
                → E P  // else pass
            → E P
                T cond = → if annotation_origin == Required → P
                    → Required
                    P manifold__annotation_type = get_args(annotation_type)  // manifold [annotation_type] := get_args(annotation_type)
                → E P
                    T cond = → if annotation_origin == NotRequired → P
                        → NotRequired
                        P manifold__annotation_type = get_args(annotation_type)  // manifold [annotation_type] := get_args(annotation_type)
                    → E P
                        T cond = → if annotation_origin == ReadOnly → P
                            → ReadOnly
                            P manifold__annotation_type = get_args(annotation_type)  // manifold [annotation_type] := get_args(annotation_type)
                        → E P  // else pass
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D TypedDictMeta = λ . P  // class(type)
    D TypedDictMeta____new = λ cls, name, bases, ns, total . {
        // Create a new typed dict class object.          This method is called when TypedDict is subclassed,         or when Typed
        T loop = ∞ (
            P base = bases[_loop_index]
            T cond = → if (type(base) ≠ _TypedDictMeta && base ≠ Generic) → → E TypeError("cannot inherit from both a TypedDict type and a non-TypedDict base class")
        ) (D |bases|)
        T cond = → if any({ T loop = ∞ (issubclass(b, Generic)) (D |bases|) }) → P generic_base = manifold [Generic]
        → E P generic_base = manifold []
        P tp_dict = type D __new__(_TypedDictMeta, name, manifold [generic_base, dict], ns)
        T cond = → if (!hasattr(tp_dict, "__orig_bases__")) → D tp_dict_D___orig_bases = bases  // tp_dict D __orig_bases__ := bases
        P annotations = manifold []
        P own_annotations = ns D get("__annotations__", manifold [])
        P msg = "TypedDict('Name', {f0: t0, f1: t1, ...}); each t must be a type"
        P own_annotations = { T loop = ∞ (P item = own_annotations D items(P)[_loop_index]) (D |own_annotations D items(P)|) }
        P required_keys = set(P)
        P optional_keys = set(P)
        P readonly_keys = set(P)
        P mutable_keys = set(P)
        T loop = ∞ (
            P base = bases[_loop_index]
            annotations D update(base D __dict__ D get("__annotations__", manifold []))
            P base_required = base D __dict__ D get("__required_keys__", set(P))
            P required_keys = required_keys | base_required
            P optional_keys = optional_keys - base_required
            P base_optional = base D __dict__ D get("__optional_keys__", set(P))
            P required_keys = required_keys - base_optional
            P optional_keys = optional_keys | base_optional
            readonly_keys D update(base D __dict__ D get("__readonly_keys__", manifold []))
            mutable_keys D update(base D __dict__ D get("__mutable_keys__", manifold []))
        ) (D |bases|)
        annotations D update(own_annotations)
        T loop = ∞ (
            P manifold__annotation_key__annotation_type = own_annotations D items(P)[_loop_index]  // manifold [annotation_key, annotation_type]
            P qualifiers = set(_get_typeddict_qualifiers(annotation_type))
            T cond = → if Required == qualifiers → P is_required = 1
            → E P
                T cond = → if NotRequired == qualifiers → P is_required = 0
                → E P is_required = total
            T cond = → if is_required → P
                required_keys D add(annotation_key)
                optional_keys D discard(annotation_key)
            → E P
                optional_keys D add(annotation_key)
                required_keys D discard(annotation_key)
            T cond = → if ReadOnly == qualifiers → P
                T cond = → if annotation_key == mutable_keys → → E TypeError("Cannot override mutable key " + annotation_key + " with read-only key")
                readonly_keys D add(annotation_key)
            → E P
                mutable_keys D add(annotation_key)
                readonly_keys D discard(annotation_key)
        ) (D |own_annotations D items(P)|)
        T assert = → if required_keys D isdisjoint(optional_keys) → "ok" → E "Assertion failed"
        D tp_dict_D___annotations = annotations  // tp_dict D __annotations__ := annotations
        D tp_dict_D___required_keys = frozenset(required_keys)  // tp_dict D __required_keys__ := frozenset(required_keys)
        D tp_dict_D___optional_keys = frozenset(optional_keys)  // tp_dict D __optional_keys__ := frozenset(optional_keys)
        D tp_dict_D___readonly_keys = frozenset(readonly_keys)  // tp_dict D __readonly_keys__ := frozenset(readonly_keys)
        D tp_dict_D___mutable_keys = frozenset(mutable_keys)  // tp_dict D __mutable_keys__ := frozenset(mutable_keys)
        D tp_dict_D___total = total  // tp_dict D __total__ := total
        → tp_dict
    }
    P __call__ = dict
    D TypedDictMeta____subclasscheck = λ cls, other . → E TypeError("TypedDict does not support instance and class checks")
    P __instancecheck__ = __subclasscheck__
D TypedDict = λ  . {
    // A simple typed namespace. At runtime it is equivalent to a plain dict.      TypedDict creates a dictionary type such tha
    T cond = → if (fields == _sentinel || fields == P) → P
        // @ETPL:preload warnings warnings
        // Import warnings — resolved at translate-time
        T cond = → if fields == _sentinel → P deprecated_thing = "Failing to pass a value for the 'fields' parameter"
        → E P deprecated_thing = "Passing `None` as the 'fields' parameter"
        P example = "`" + typename + " = TypedDict(" + typename + ", {{}})`"
        P deprecation_msg = (("{name} is deprecated and will be disallowed in Python {remove}. To create a TypedDict class with 0 fields using the functional syntax, pass an empty dictionary, e.g. " + example) + ".")
        warnings D _deprecated(deprecated_thing, manifold ["message", deprecation_msg], manifold ["remove", manifold [3, 15]])
        P fields = manifold []
    P ns = manifold [manifold ["__annotations__", dict(fields)]]
    P module = _caller(P)
    T cond = → if module ≠ P → P  // pass
    P td = _TypedDictMeta(typename, manifold [], ns, manifold ["total", total])
    D td_D___orig_bases = manifold [TypedDict]  // td D __orig_bases__ := manifold [TypedDict]
    → td
}
