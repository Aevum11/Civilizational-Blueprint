            → E P
                T attempt = → P  // try
                    T scope_args_file = → open(arg_string[1:Ω], manifold ["encoding", _sys D getfilesystemencoding(P)], manifold ["errors", _sys D getfilesystemencodeerrors(P)])
                    P args_file = scope_args_file  // context var
                        P arg_strings = manifold []
