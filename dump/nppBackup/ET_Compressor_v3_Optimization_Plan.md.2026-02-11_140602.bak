### 4.2 — Section 6: Replace String-Based Huffman with Integer Bit-Packing

**Requires: Eq 238 (Sovereign Bit-Packing Throughput)**

**New `_huffman_encode()` — integer accumulator:**
```python
def _huffman_encode_v3(data: bytes) -> Tuple[bytes, Dict[int, int]]:
    """Eq 238: Integer bit-packed Huffman encoding."""
    if not data:
        return b"", {}
    freq_table = Counter(data)
    tree = _build_huffman_tree(freq_table)
    # Build code table as (integer_code, bit_length) instead of strings
    code_table = _build_int_code_table(tree)  # NEW: returns Dict[int, Tuple[int, int]]
    
    output = bytearray()
    accumulator = 0
    bit_pos = 0
    
    for byte in data:
        code, length = code_table[byte]
        accumulator |= code << bit_pos
        bit_pos += length
        while bit_pos >= 8:
            output.append(accumulator & 0xFF)
            accumulator >>= 8
            bit_pos -= 8
    
    # Flush remaining bits
    if bit_pos > 0:
        output.append(accumulator & 0xFF)
    
    return bytes(output), freq_table
```

**New `_huffman_decode()` — table-based lookup (no tree walk):**
```python
def _huffman_decode_v3(encoded: bytes, freq_table: Dict[int, int],
                       original_length: int) -> bytes:
    """Eq 238: Table-based Huffman decoding — O(1) per symbol."""
    if not encoded or not freq_table:
        return b""
    tree = _build_huffman_tree(freq_table)
    # Build lookup table: for each possible 16-bit prefix, store (symbol, code_length)
    max_code_len = 16  # Huffman codes rarely exceed 16 bits for byte alphabets
    lookup = _build_decode_table(tree, max_code_len)  # NEW
    
    result = bytearray(original_length)
    bit_buffer = 0
    bits_in_buffer = 0
    byte_idx = 0
    out_idx = 0
    
    while out_idx < original_length:
        # Refill buffer
        while bits_in_buffer < max_code_len and byte_idx < len(encoded):
            bit_buffer |= encoded[byte_idx] << bits_in_buffer
            bits_in_buffer += 8
            byte_idx += 1
        
        # Lookup
        prefix = bit_buffer & ((1 << max_code_len) - 1)
        symbol, code_len = lookup[prefix]
        result[out_idx] = symbol
        out_idx += 1
        bit_buffer >>= code_len
        bits_in_buffer -= code_len
    
    return bytes(result)
```

This changes Huffman decode from O(n × avg_code_length) tree walks to O(n) table lookups — **10–30x faster**.

