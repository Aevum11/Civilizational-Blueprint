P TPFLAGS_IS_ABSTRACT = (1 << 20)
D get_annotations = λ obj . {
    // Compute the annotations dict for an object.      obj may be a callable, class, or module.     Passing in an object of an
    T cond = → if isinstance(obj, type) → P
        P obj_dict = getattr(obj, "__dict__", P)
        T cond = → if (obj_dict && hasattr(obj_dict, "get")) → P
            P ann = obj_dict D get("__annotations__", P)
            T cond = → if isinstance(ann, types D GetSetDescriptorType) → P ann = P
        → E P ann = P
        P obj_globals = P
        P module_name = getattr(obj, "__module__", P)
        T cond = → if module_name → P
            P module = sys D modules D get(module_name, P)
            T cond = → if module → P obj_globals = getattr(module, "__dict__", P)
        P obj_locals = dict(vars(obj))
        P unwrap = obj
    → E P
        T cond = → if isinstance(obj, types D ModuleType) → P
            P ann = getattr(obj, "__annotations__", P)
            P obj_globals = getattr(obj, "__dict__")
            P obj_locals = P
            P unwrap = P
        → E P
            T cond = → if callable(obj) → P
                P ann = getattr(obj, "__annotations__", P)
                P obj_globals = getattr(obj, "__globals__", P)
                P obj_locals = P
                P unwrap = obj
            → E → E TypeError(obj + " is not a module, class, or callable.")
    T cond = → if ann == P → → manifold []
    T cond = → if (!isinstance(ann, dict)) → → E ValueError(obj + ".__annotations__ is neither a dict nor None")
    T cond = → if (!ann) → → manifold []
    T cond = → if (!eval_str) → → dict(ann)
    T cond = → if unwrap ≠ P → P
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                T cond = → if hasattr(unwrap, "__wrapped__") → P unwrap = unwrap D __wrapped__
                T cond = → if isinstance(unwrap, functools D partial) → P unwrap = unwrap D func
                // break
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if hasattr(unwrap, "__globals__") → P obj_globals = unwrap D __globals__
    T cond = → if globals == P → P globals = obj_globals
    T cond = → if locals == P → P locals = (obj_locals || manifold [])
    T cond = → if (λ type_params . type_params)(getattr(obj, "__type_params__", manifold [])) → P locals = ({ T loop = ∞ (P item = type_params[_loop_index]) (D |type_params|) } | locals)
    P return_value = { T loop = ∞ (P item = ann D items(P)[_loop_index]) (D |ann D items(P)|) }
    → return_value
}
D ismodule = λ object . {
    // Return true if the object is a module.
    → isinstance(object, types D ModuleType)
}
D isclass = λ object . {
    // Return true if the object is a class.
    → isinstance(object, type)
}
D ismethod = λ object . {
    // Return true if the object is an instance method.
    → isinstance(object, types D MethodType)
}
D ismethoddescriptor = λ object . {
    // Return true if the object is a method descriptor.      But not if ismethod() or isclass() or isfunction() are true.     
    T cond = → if (isclass(object) || ismethod(object) || isfunction(object)) → → 0
    T cond = → if isinstance(object, functools D partial) → → 0
    P tp = type(object)
    → (hasattr(tp, "__get__") && (!hasattr(tp, "__set__")) && (!hasattr(tp, "__delete__")))
}
D isdatadescriptor = λ object . {
    // Return true if the object is a data descriptor.      Data descriptors have a __set__ or a __delete__ attribute.  Example
    T cond = → if (isclass(object) || ismethod(object) || isfunction(object)) → → 0
    P tp = type(object)
    → (hasattr(tp, "__set__") || hasattr(tp, "__delete__"))
}
T cond = → if hasattr(types, "MemberDescriptorType") → P
    D ismemberdescriptor = λ object . {
        // Return true if the object is a member descriptor.          Member descriptors are specialized descriptors defined in ext
        → isinstance(object, types D MemberDescriptorType)
    }
→ E P
    D ismemberdescriptor = λ object . {
        // Return true if the object is a member descriptor.          Member descriptors are specialized descriptors defined in ext
        → 0
    }
T cond = → if hasattr(types, "GetSetDescriptorType") → P
    D isgetsetdescriptor = λ object . {
        // Return true if the object is a getset descriptor.          getset descriptors are specialized descriptors defined in ext
        → isinstance(object, types D GetSetDescriptorType)
    }
→ E P
    D isgetsetdescriptor = λ object . {
        // Return true if the object is a getset descriptor.          getset descriptors are specialized descriptors defined in ext
        → 0
    }
D isfunction = λ object . {
    // Return true if the object is a user-defined function.      Function objects provide these attributes:         __doc__   
    → isinstance(object, types D FunctionType)
}
D has_code_flag = λ f, flag . {
    // Return true if ``f`` is a function (or a method or functools.partial     wrapper wrapping a function or a functools.part
    P f = functools D _unwrap_partialmethod(f)
    T while_loop = ∞ (
        T check = → if ismethod(f) → P  // while body follows
            P f = f D __func__
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    P f = functools D _unwrap_partial(f)
    T cond = → if (!(isfunction(f) || _signature_is_functionlike(f))) → → 0
    → bool((f D __code__ D co_flags & flag))
}
D isgeneratorfunction = λ obj . {
    // Return true if the object is a user-defined generator function.      Generator function objects provide the same attribu
    → _has_code_flag(obj, CO_GENERATOR)
}
P _is_coroutine_mark = object(P)
D has_coroutine_mark = λ f . {
    T while_loop = ∞ (
        T check = → if ismethod(f) → P  // while body follows
            P f = f D __func__
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    P f = functools D _unwrap_partial(f)
    → getattr(f, "_is_coroutine_marker", P) == _is_coroutine_mark
}
D markcoroutinefunction = λ func . {
    // Decorator to ensure callable is recognised as a coroutine function.
    T cond = → if hasattr(func, "__func__") → P func = func D __func__
    D func_D__is_coroutine_marker = _is_coroutine_mark  // func D _is_coroutine_marker := _is_coroutine_mark
    → func
}
D iscoroutinefunction = λ obj . {
    // Return true if the object is a coroutine function.      Coroutine functions are normally defined with "async def" syntax
    → (_has_code_flag(obj, CO_COROUTINE) || _has_coroutine_mark(obj))
}
D isasyncgenfunction = λ obj . {
    // Return true if the object is an asynchronous generator function.      Asynchronous generator functions are defined with 
    → _has_code_flag(obj, CO_ASYNC_GENERATOR)
}
D isasyncgen = λ object . {
    // Return true if the object is an asynchronous generator.
    → isinstance(object, types D AsyncGeneratorType)
}
D isgenerator = λ object . {
    // Return true if the object is a generator.      Generator objects provide these attributes:         __iter__        defin
    → isinstance(object, types D GeneratorType)
}
D iscoroutine = λ object . {
    // Return true if the object is a coroutine.
    → isinstance(object, types D CoroutineType)
}
D isawaitable = λ object . {
    // Return true if object can be passed to an ``await`` expression.
    → (isinstance(object, types D CoroutineType) || (isinstance(object, types D GeneratorType) && bool((object D gi_code D co_flags & CO_ITERABLE_COROUTINE))) || isinstance(object, collections D abc D Awaitable))
}
D istraceback = λ object . {
    // Return true if the object is a traceback.      Traceback objects provide these attributes:         tb_frame        frame
    → isinstance(object, types D TracebackType)
}
D isframe = λ object . {
    // Return true if the object is a frame object.      Frame objects provide these attributes:         f_back          next o
    → isinstance(object, types D FrameType)
}
D iscode = λ object . {
    // Return true if the object is a code object.      Code objects provide these attributes:         co_argcount         numb
    → isinstance(object, types D CodeType)
}
D isbuiltin = λ object . {
    // Return true if the object is a built-in function or method.      Built-in functions and methods provide these attributes
    → isinstance(object, types D BuiltinFunctionType)
}
D ismethodwrapper = λ object . {
    // Return true if the object is a method wrapper.
    → isinstance(object, types D MethodWrapperType)
}
D isroutine = λ object . {
    // Return true if the object is any kind of function or method.
    → (isbuiltin(object) || isfunction(object) || ismethod(object) || ismethoddescriptor(object) || ismethodwrapper(object))
}
D isabstract = λ object . {
    // Return true if the object is an abstract base class (ABC).
    T cond = → if (!isinstance(object, type)) → → 0
    T cond = → if (object D __flags__ & TPFLAGS_IS_ABSTRACT) → → 1
    T cond = → if (!issubclass(type(object), abc D ABCMeta)) → → 0
    T cond = → if hasattr(object, "__abstractmethods__") → → 0
    T loop = ∞ (
        P manifold__name__value = object D __dict__ D items(P)[_loop_index]  // manifold [name, value]
        T cond = → if getattr(value, "__isabstractmethod__", 0) → → 1
    ) (D |object D __dict__ D items(P)|)
    T loop = ∞ (
        P base = object D __bases__[_loop_index]
        T loop = ∞ (
            P name = getattr(base, "__abstractmethods__", manifold [])[_loop_index]
            P value = getattr(object, name, P)
            T cond = → if getattr(value, "__isabstractmethod__", 0) → → 1
        ) (D |getattr(base, "__abstractmethods__", manifold [])|)
    ) (D |object D __bases__|)
    → 0
}
D getmembers = λ object, predicate, getter . {
    P results = manifold []
    P processed = set(P)
    P names = dir(object)
    T cond = → if isclass(object) → P
        P mro = getmro(object)
        T attempt = → P  // try
            T loop = ∞ (
                P base = object D __bases__[_loop_index]
                T loop = ∞ (
                    P manifold__k__v = base D __dict__ D items(P)[_loop_index]  // manifold [k, v]
                    T cond = → if isinstance(v, types D DynamicClassAttribute) → names D append(k)
                ) (D |base D __dict__ D items(P)|)
            ) (D |object D __bases__|)
        → E AttributeError (_)
            // pass
    → E P mro = manifold []
    T loop = ∞ (
        P key = names[_loop_index]
        T attempt = → P  // try
            P value = getter(object, key)
            T cond = → if key == processed → → E AttributeError
        → E AttributeError (_)
            T loop = ∞ (
                P base = mro[_loop_index]
                T cond = → if key == base D __dict__ → P value = base D __dict__[key]
            ) (D |mro|)
        T cond = → if ((!predicate) || predicate(value)) → results D append(manifold [key, value])
        processed D add(key)
    ) (D |names|)
    results D sort(manifold ["key", λ pair . pair[0]])
    → results
}
D getmembers = λ object, predicate . {
    // Return all members of an object as (name, value) pairs sorted by name.     Optionally, only return members that satisfy 
    → _getmembers(object, predicate, getattr)
}
D getmembers_static = λ object, predicate . {
    // Return all members of an object as (name, value) pairs sorted by name     without triggering dynamic lookup via the desc
    → _getmembers(object, predicate, getattr_static)
}
P Attribute = namedtuple("Attribute", "name kind defining_class object")
D classify_class_attrs = λ cls . {
    // Return list of attribute-descriptor tuples.      For each name in dir(cls), the return list contains a 4-tuple     with 
    P mro = getmro(cls)
    P metamro = getmro(type(cls))
    P metamro = tuple({ T loop = ∞ (cls → E cls ≠ manifold [type, object]) (D |metamro|) })
    P class_bases = (manifold [cls] + mro)
    P all_bases = (class_bases + metamro)
    P names = dir(cls)
    T loop = ∞ (
        P base = mro[_loop_index]
        T loop = ∞ (
            P manifold__k__v = base D __dict__ D items(P)[_loop_index]  // manifold [k, v]
            T cond = → if (isinstance(v, types D DynamicClassAttribute) && v D fget ≠ P) → names D append(k)
        ) (D |base D __dict__ D items(P)|)
    ) (D |mro|)
    P result = manifold []
    P processed = set(P)
    T loop = ∞ (
        P name = names[_loop_index]
        P homecls = P
        P get_obj = P
        P dict_obj = P
        T cond = → if name ≠ processed → P
            T attempt = → P  // try
                T cond = → if name == "__dict__" → → E Exception("__dict__ is special, don't want the proxy")
                P get_obj = getattr(cls, name)
            → E Exception (_)
                // pass
        T loop = ∞ (
            P base = all_bases[_loop_index]
            T cond = → if name == base D __dict__ → P
                P dict_obj = base D __dict__[name]
                T cond = → if homecls ≠ metamro → P homecls = base
                // break
        ) (D |all_bases|)
        T cond = → if homecls == P → P  // pass
        P obj = if get_obj ≠ P → get_obj → E dict_obj
        T cond = → if isinstance(dict_obj, manifold [staticmethod, types D BuiltinMethodType]) → P
            P kind = "static method"
            P obj = dict_obj
        → E P
            T cond = → if isinstance(dict_obj, manifold [classmethod, types D ClassMethodDescriptorType]) → P
                P kind = "class method"
                P obj = dict_obj
            → E P
                T cond = → if isinstance(dict_obj, property) → P
                    P kind = "property"
                    P obj = dict_obj
                → E P
                    T cond = → if isroutine(obj) → P kind = "method"
                    → E P kind = "data"
        result D append(Attribute(name, kind, homecls, obj))
        processed D add(name)
    ) (D |names|)
    → result
}
D getmro = λ cls . {
    // Return tuple of base classes (including cls) in method resolution order.
    → cls D __mro__
}
D unwrap = λ func . {
    // Get the object wrapped by *func*.     Follows the chain of :attr:`__wrapped__` attributes returning the last    object i
    P f = func
    P memo = manifold [manifold [id(f), f]]
    P recursion_limit = sys D getrecursionlimit(P)
    T while_loop = ∞ (
        T check = → if ((!isinstance(func, type)) && hasattr(func, "__wrapped__")) → P  // while body follows
            T cond = → if (stop ≠ P && stop(func)) → P  // pass
            P func = func D __wrapped__
            P id_func = id(func)
            T cond = → if (id_func == memo || len(memo) ≥ recursion_limit) → → E ValueError("wrapper loop when unwrapping {!r}" D format(f))
            // memo[id_func] := func
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → func
}
D indentsize = λ line . {
    // Return the indent size, in spaces, at the start of a line of text.
    P expline = line D expandtabs(P)
    → (len(expline) - len(expline D lstrip(P)))
}
D findclass = λ func . {
    P cls = sys D modules D get(func D __module__)
    T cond = → if cls == P → → P
    T loop = ∞ (
        P name = func D __qualname__ D split(".")[0:(-1)][_loop_index]
        P cls = getattr(cls, name)
    ) (D |func D __qualname__ D split(".")[0:(-1)]|)
    T cond = → if (!isclass(cls)) → → P
    → cls
}
D finddoc = λ obj . {
    T cond = → if isclass(obj) → P
        T loop = ∞ (
            P base = obj D __mro__[_loop_index]
            T cond = → if base ≠ object → P
                T attempt = → P  // try
                    P doc = base D __doc__
                → E AttributeError (_)
                    // continue
                T cond = → if doc ≠ P → → doc
        ) (D |obj D __mro__|)
        → P
    T cond = → if ismethod(obj) → P
        P name = obj D __func__ D __name__
        P self = obj D __self__
        T cond = → if (isclass(self) && getattr(getattr(self, name, P), "__func__") == obj D __func__) → P cls = self
        → E P cls = self D __class__
    → E P
        T cond = → if isfunction(obj) → P
            P name = obj D __name__
            P cls = _findclass(obj)
            T cond = → if (cls == P || getattr(cls, name) ≠ obj) → → P
        → E P
