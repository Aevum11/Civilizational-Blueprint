import tkinter as tk
from tkinter import filedialog, messagebox, colorchooser
import threading
import sys
import math

try:
    from PIL import Image, ImageTk, ImageDraw, ImageFilter, ImageChops
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: ADAPTIVE OPTICAL PHYSICS
# ==============================================================================

class ET_Adaptive_Optical:
    def lift_adaptive_layer(self, img_pil, mask_pil, base_veil, density, adaptation, gamma, status_cb):
        """
        Solves J(x) = (I(x) - A(x)) / t(x) + A(x)
        Where A(x) adapts to local lighting conditions.
        """
        width, height = img_pil.size
        pixels = img_pil.load()
        mask = mask_pil.load()
        
        # 1. GENERATE TRANSMISSION MAP (t)
        # We use MinFilter to estimate thickness, but we SHARPEN it to prevent blur
        status_cb("Mapping Optical Thickness (High-Res)...")
        
        # Estimate haze thickness
        dark_ref = img_pil.filter(ImageFilter.MinFilter(15))
        # Blur the map slightly to reduce noise, then UnsharpMask to keep edges
        # This fixes the "Blurry Transparency" issue
        tx_map = dark_ref.filter(ImageFilter.GaussianBlur(2))
        tx_map = tx_map.filter(ImageFilter.UnsharpMask(radius=2, percent=150, threshold=3))
        
        tx_pix = tx_map.load()
        
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        min_x, min_y, max_x, max_y = bbox
        
        updates = []
        
        # Factors
        omega = density / 100.0   # How much haze to remove
        t0 = 0.1                  # Minimum transmission (protection)
        adapt_fac = adaptation / 100.0 # How much A changes per pixel
        
        # Base Veil Color
        ar_base, ag_base, ab_base = base_veil
        
        # Pre-calc Gamma LUT for speed
        gamma_lut = []
        if gamma != 1.0:
            inv_gamma = 1.0 / gamma
            for i in range(256):
                val = 255.0 * math.pow(i/255.0, inv_gamma)
                gamma_lut.append(val)
        else:
            gamma_lut = list(range(256))

        # 2. THE ADAPTIVE LOOP
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                if mask[x, y] == 0: continue
                
                # I (Observed)
                pr, pg, pb = pixels[x, y]
                
                # --- ET LOGIC: VEIL ADAPTATION (A(x)) ---
                # Real fabric changes color in shadow.
                # We modulate the Base Veil Color by the local pixel luminance.
                
                p_lum = (pr + pg + pb) / 3.0
                lum_ratio = p_lum / 255.0
                
                # If adaptation is 0, we use Base Veil.
                # If adaptation is 100, A matches pixel luminance perfectly (bad).
                # We blend.
                
                # We darken the veil color in dark areas to match the physics of shadow
                mod_factor = (1.0 - adapt_fac) + (adapt_fac * lum_ratio)
                
                ar = ar_base * mod_factor
                ag = ag_base * mod_factor
                ab = ab_base * mod_factor
                
                # Ensure non-zero
                ar = max(1, ar); ag = max(1, ag); ab = max(1, ab)
                
                # --- CALCULATE TRANSMISSION (t) ---
                # Get local dark channel estimate
                local_min = tx_pix[x, y]
                # Normalize by local A
                dr = local_min[0] / ar
                dg = local_min[1] / ag
                db = local_min[2] / ab
                dark_c = min(dr, dg, db)
                
                t = 1.0 - (omega * dark_c)
                t = max(t0, t)
                
                # --- OPTICAL RECOVERY (J) ---
                # J = (I - A)/t + A
                
                jr = ((pr - ar) / t) + ar
                jg = ((pg - ag) / t) + ag
                jb = ((pb - ab) / t) + ab
                
                # --- SHADOW INJECTION (Gamma) ---
                # We apply gamma correction to the result to lift the deep shadows
                # Clamping index 0-255
                jr_idx = int(max(0, min(255, jr)))
                jg_idx = int(max(0, min(255, jg)))
                jb_idx = int(max(0, min(255, jb)))
                
                final_r = gamma_lut[jr_idx]
                final_g = gamma_lut[jg_idx]
                final_b = gamma_lut[jb_idx]
                
                updates.append((x, y, (int(final_r), int(final_g), int(final_b))))
                
        for ux, uy, uval in updates:
            pixels[ux, uy] = uval
            
        return img_pil

# ==============================================================================
# GUI
# ==============================================================================

class ET_V19_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V19: ADAPTIVE OPTICAL ENGINE (SHADOW & COLOR FIX)")
        self.root.geometry("1200x950")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Adaptive_Optical()
        self.pil_img = None
        self.mask_img = None
        self.backup_img = None
        self.veil_color = (200, 200, 200) # Default grey
        
        self._layout()

    def _layout(self):
        t = tk.Frame(self.root, bg="#101010", pady=10)
        t.pack(fill=tk.X)
        
        self.btn(t, "LOAD", self.load, "#004488")
        self.btn(t, "RESET", self.reset, "#882200")
        self.btn(t, "SET VEIL COLOR", self.pick, "#444444")
        self.btn(t, "EXECUTE", self.run, "#228822")
        
        self.c_lbl = tk.Label(t, text="   ", bg="#cccccc", relief="sunken")
        self.c_lbl.pack(side=tk.LEFT)
        
        # 1. THICKNESS (Density)
        f1 = tk.Frame(t, bg="#101010"); f1.pack(side=tk.LEFT, padx=10)
        tk.Label(f1, text="LAYER THICKNESS", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.den_scale = tk.Scale(f1, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=100)
        self.den_scale.set(85)
        self.den_scale.pack()
        
        # 2. ADAPTATION (Color Shift Fix)
        # Allows veil to change color in shadows
        f2 = tk.Frame(t, bg="#101010"); f2.pack(side=tk.LEFT, padx=10)
        tk.Label(f2, text="VEIL ADAPT", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.adp_scale = tk.Scale(f2, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=100)
        self.adp_scale.set(50) 
        self.adp_scale.pack()
        
        # 3. SHADOW RECOVERY (Gamma)
        f3 = tk.Frame(t, bg="#101010"); f3.pack(side=tk.LEFT, padx=10)
        tk.Label(f3, text="SHADOW LIFT", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.gam_scale = tk.Scale(f3, from_=10, to=30, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=100)
        self.gam_scale.set(18) # 1.8
        self.gam_scale.pack()

        self.stat = tk.Label(t, text="Ready.", fg="#888", bg="#101010")
        self.stat.pack(side=tk.RIGHT, padx=20)
        
        container = tk.Frame(self.root)
        container.pack(fill=tk.BOTH, expand=True)
        self.cv = tk.Canvas(container, bg="#080808", cursor="crosshair")
        vs = tk.Scrollbar(container, orient="vertical", command=self.cv.yview)
        hs = tk.Scrollbar(container, orient="horizontal", command=self.cv.xview)
        self.cv.config(yscrollcommand=vs.set, xscrollcommand=hs.set)
        
        vs.pack(side=tk.RIGHT, fill=tk.Y)
        hs.pack(side=tk.BOTTOM, fill=tk.X)
        self.cv.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.cv.bind("<Button-1>", self.down)
        self.cv.bind("<B1-Motion>", self.drag)
        self.cv.bind("<ButtonRelease-1>", self.up)
        
        self.drawing=False; self.brush=30

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", relief="flat", padx=10, pady=5).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            self.pil_img = Image.open(path).convert("RGB")
            self.backup_img = self.pil_img.copy()
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            self.cv.config(scrollregion=(0,0,self.pil_img.width,self.pil_img.height))
            self.update_view()
            self.stat.config(text=f"Loaded: {self.pil_img.size}")
        except: pass

    def update_view(self):
        if not self.pil_img: return
        d = self.pil_img.copy()
        if self.mask_img.getbbox():
            r = Image.new("RGB", self.pil_img.size, (255,0,0)) 
            d = Image.composite(r, d, self.mask_img)
        self.tk = ImageTk.PhotoImage(d)
        self.cv.create_image(0,0, image=self.tk, anchor=tk.NW)
        
    def pick(self):
        c = colorchooser.askcolor(title="Pick Veil Color")[0]
        if c:
            self.veil_color = (int(c[0]), int(c[1]), int(c[2]))
            h = '#%02x%02x%02x' % self.veil_color
            self.c_lbl.config(bg=h)

    def down(self,e): 
        x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
        self.drawing=True; self.lp=(x,y)
        
    def drag(self,e):
        if self.drawing and self.mask_img:
            x=self.cv.canvasx(e.x); y=self.cv.canvasy(e.y)
            d = ImageDraw.Draw(self.mask_img)
            d.line([self.lp, (x,y)], fill=255, width=self.brush)
            d.ellipse([x-15,y-15,x+15,y+15], fill=255)
            self.lp=(x,y); 
            self.cv.create_line(self.lp[0],self.lp[1],x,y,fill="red",width=self.brush,tags="t")

    def up(self,e): self.drawing=False; self.cv.delete("t"); self.update_view()
    
    def reset(self):
        if self.backup_img:
            self.pil_img = self.backup_img.copy()
            if self.mask_img: self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
            self.update_view()
            self.stat.config(text="Reset.")

    def run(self):
        if not self.pil_img: return
        self.stat.config(text="Executing Adaptive Optics...")
        
        den = self.den_scale.get()
        adp = self.adp_scale.get()
        gam = self.gam_scale.get() / 10.0
        vc = self.veil_color
        
        threading.Thread(target=self._w, args=(vc, den, adp, gam)).start()

    def _w(self, v, d, a, g):
        res = self.engine.lift_adaptive_layer(self.pil_img, self.mask_img, v, d, a, g, self.log)
        self.pil_img = res
        self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height])
        self.root.after(0, self.update_view)
        self.root.after(0, lambda: self.stat.config(text="Optical Adaptation Complete."))

    def log(self, m): self.stat.config(text=m)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_V19_GUI(root)
    root.mainloop()