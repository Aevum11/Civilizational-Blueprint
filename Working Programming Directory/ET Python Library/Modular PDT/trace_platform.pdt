    // @ETPL:preload SubprocessError subprocess.SubprocessError
    P SubprocessError = P  // [ET:callable:subprocess.SubprocessError]
    // @ETPL:preload TimeoutExpired subprocess.TimeoutExpired
    P TimeoutExpired = P  // [ET:callable:subprocess.TimeoutExpired]
    // @ETPL:preload CompletedProcess subprocess.CompletedProcess
    P CompletedProcess = P  // [ET:callable:subprocess.CompletedProcess]
    P CREATE_NEW_CONSOLE = 16
    P CREATE_NEW_PROCESS_GROUP = 512
    P STD_INPUT_HANDLE = 4294967286
    P STD_OUTPUT_HANDLE = 4294967285
    P STD_ERROR_HANDLE = 4294967284
    P SW_HIDE = 0
    P STARTF_USESTDHANDLES = 256
    P STARTF_USESHOWWINDOW = 1
    P STARTF_FORCEONFEEDBACK = 64
    P STARTF_FORCEOFFFEEDBACK = 128
    // @ETPL:preload STARTUPINFO subprocess.STARTUPINFO
    P STARTUPINFO = P  // [ET:callable:subprocess.STARTUPINFO]
    P ABOVE_NORMAL_PRIORITY_CLASS = 32768
    P BELOW_NORMAL_PRIORITY_CLASS = 16384
    P HIGH_PRIORITY_CLASS = 128
    P IDLE_PRIORITY_CLASS = 64
    P NORMAL_PRIORITY_CLASS = 32
    P REALTIME_PRIORITY_CLASS = 256
    P CREATE_NO_WINDOW = 134217728
    P DETACHED_PROCESS = 8
    P CREATE_DEFAULT_ERROR_MODE = 67108864
    P CREATE_BREAKAWAY_FROM_JOB = 16777216
    T loop = ∞ (
        P cmd = manifold ["ver", "command /c ver", "cmd /c ver"][_loop_index]
        T attempt = → P  // try
            P info = subprocess D check_output(cmd, manifold ["stdin", subprocess D DEVNULL], manifold ["stderr", subprocess D DEVNULL], manifold ["text", 1], manifold ["encoding", "locale"], manifold ["shell", 1])
        → E manifold [OSError, subprocess D CalledProcessError] (why)
            // continue
    ) (D |manifold ["ver", "command /c ver", "cmd /c ver"]|)
    P ver_output = re D compile("(?:([\\w ]+) ([\\w.]+) .*\\[.* ([\\d.]+)\\])")
    P info = info D strip(P)
    P m = ver_output D match(info)
    T cond = → if m ≠ P → P
        P manifold__system__release__version = m D groups(P)  // manifold [system, release, version] := m D groups(P)
        T cond = → if release[(-1)] == "." → P release = release[0:(-1)]
        T cond = → if version[(-1)] == "." → P version = version[0:(-1)]
        P version = _norm_version(version)
    → manifold [system, release, version]
}
D wmi_query = λ table . {
    // global _wmi
    T cond = → if (!_wmi) → → E OSError("not supported")
    P table = manifold [manifold ["OS", "Win32_OperatingSystem"], manifold ["CPU", "Win32_Processor"]][table]
    T attempt = → P  // try
        P data = _wmi D exec_query("SELECT {} FROM {}" D format("," D join(keys), table)) D split("␀")
    → E OSError (_)
        P _wmi = P
        → E OSError("not supported")
    P split_data = { T loop = ∞ (i D partition("=")) (D |data|) }
    P dict_data = { T loop = ∞ (P item = split_data[_loop_index]) (D |split_data|) }
    → { T loop = ∞ (dict_data[k]) (D |keys|) }
}
