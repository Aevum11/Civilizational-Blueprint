# Helper to generate self-signed certs for local HTTPS testing
# Requires: pip install pyopenssl
import random
from OpenSSL import crypto

def generate_self_signed_cert():
    # Create Key
    k = crypto.PKey()
    k.generate_key(crypto.TYPE_RSA, 4096)

    # Create Cert
    cert = crypto.X509()
    cert.get_subject().C = "US"
    cert.get_subject().ST = "State"
    cert.get_subject().L = "City"
    cert.get_subject().O = "ET Physics"
    cert.get_subject().OU = "Toolbox"
    cert.get_subject().CN = "localhost"
    cert.set_serial_number(random.randint(1000, 1000000))
    cert.gmtime_adj_notBefore(0)
    cert.gmtime_adj_notAfter(365*24*60*60) # 1 Year
    cert.set_issuer(cert.get_subject())
    cert.set_pubkey(k)
    cert.sign(k, 'sha256')

    # Save
    with open("cert.pem", "wb") as f:
        f.write(crypto.dump_certificate(crypto.FILETYPE_PEM, cert))
    with open("key.pem", "wb") as f:
        f.write(crypto.dump_privatekey(crypto.FILETYPE_PEM, k))
    
    print("[*] Generated cert.pem and key.pem")

if __name__ == "__main__":
    try:
        generate_self_signed_cert()
    except ImportError:
        print("Error: PyOpenSSL not installed. Run: pip install pyopenssl")