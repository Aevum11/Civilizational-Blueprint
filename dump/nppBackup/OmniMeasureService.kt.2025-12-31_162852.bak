package com.et.physics.toolbox

import android.app.*
import android.content.*
import android.graphics.Color
import android.graphics.Paint
import android.graphics.pdf.PdfDocument
import android.hardware.*
import android.location.*
import android.media.*
import android.net.nsd.NsdManager
import android.net.nsd.NsdServiceInfo
import android.os.*
import android.view.WindowManager
import androidx.core.app.NotificationCompat
import androidx.security.crypto.EncryptedSharedPreferences
import androidx.security.crypto.MasterKey
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicReference
import java.text.SimpleDateFormat
import java.util.*
import java.util.zip.*
import java.io.*
import java.net.*
import kotlinx.coroutines.*
import kotlin.math.max
import com.google.gson.Gson 
import com.google.gson.GsonBuilder

/**
 * OmniMeasureService v24.0 - THE NETWORKED REALITY
 * - Added Sync Manager (NSD + UDP)
 */
class OmniMeasureService : Service(), SensorEventListener, LocationListener {

    enum class ScanMode { BATTERY_SAVER, LEVEL_STABILITY, VIBRATION_MONITOR, NOISE_SCANNER, LIGHT_METER, WEATHER_MONITOR }
    data class LogEntry(val time: Long, val result: OmniTraverserEngine.SubstantiatedResult)
    data class TrendPoint(val timestamp: Long, val maxVibration: Double, val avgSpl: Double, val avgPressure: Double, val avgTemp: Double?, val avgLux: Double)

    inner class LocalBinder : Binder() { fun getService(): OmniMeasureService = this@OmniMeasureService }
    private val binder = LocalBinder()
    private lateinit var sensorManager: SensorManager
    private lateinit var locationManager: LocationManager
    private val etEngine = OmniTraverserEngine()
    private lateinit var prefs: SharedPreferences
    private lateinit var windowManager: WindowManager
    private lateinit var nsdManager: NsdManager

    private val _lastResult = AtomicReference<OmniTraverserEngine.SubstantiatedResult>()
    val lastResult: OmniTraverserEngine.SubstantiatedResult? get() = _lastResult.get()
    private val dataLog = ConcurrentLinkedQueue<LogEntry>()
    private val trendLog = ArrayList<TrendPoint>()
    private val trendLock = Any()
    private var trendStartTime = 0L
    private var accVibMax = 0.0; private var accSplSum = 0.0; private var accSplCount = 0; private var accPressSum = 0.0; private var accPressCount = 0; private var accTempSum = 0.0; private var accTempCount = 0; private var accLuxSum = 0.0; private var accLuxCount = 0

    // State
    private var lastAlarmTime = 0L; var activeAlarmConfig: OmniTraverserEngine.AlarmConfig? = null
    var baselineVib: Double? = null; private set; var baselineSpl: Double? = null; private set; var baselineLux: Double? = null; private set; var hasBaseline = false; private set
    var currentMode = ScanMode.LEVEL_STABILITY; var sessionStartTime: Long = 0
    private var startBatteryLevel: Int = 0; var batteryDrainRate: Double = 0.0; var batteryTemp: Float = 0.0f
    var isGpsEnabled = false; private var currentLat: Double? = null; private var currentLon: Double? = null; private var currentAlt: Double? = null; private var currentAcc: Float? = null
    private var isThrottled = false; private var throttleCounter = 0L; private val deviceKey = Build.MODEL.replace(" ", "_"); private var isRunning = false
    private var serviceJob: Job? = null; private val serviceScope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    private lateinit var sensorThread: HandlerThread; private lateinit var sensorHandler: Handler; private var wakeLock: PowerManager.WakeLock? = null
    private val audioLock = Any(); private var audioRecord: AudioRecord? = null; private var currentAudioBuffer: ShortArray? = null; private var detectedSampleRate = 16000; private var detectedBufferSize = 0
    var isRecordingAudio = false; private var wavOutputStream: FileOutputStream? = null; private var wavFile: File? = null
    var calibrationStatus = "Ready"

    // UNIT SYSTEM
    enum class UnitSystem { METRIC, IMPERIAL }
    var currentUnitSystem = UnitSystem.METRIC
    
    // DOSIMETRY
    var currentDoseStandard = OmniTraverserEngine.DoseStandard.OSHA
    
    // VOICE MEMOS
    private var memoRecorder: MediaRecorder? = null
    private val voiceMemos = ArrayList<File>()
    var isRecordingMemo = false
    
    // SYNC STATE
    var isSyncLeader = false
    var connectedPeers = 0
    private var udpSocket: DatagramSocket? = null
    private val SYNC_PORT = 54321

    override fun onBind(intent: Intent): IBinder = binder

    override fun onCreate() {
        super.onCreate()
        sensorManager = getSystemService(Context.SENSOR_SERVICE) as SensorManager
        locationManager = getSystemService(Context.LOCATION_SERVICE) as LocationManager
        windowManager = getSystemService(Context.WINDOW_SERVICE) as WindowManager
        nsdManager = getSystemService(Context.NSD_SERVICE) as NsdManager
        prefs = getSharedPreferences("ET_Prefs", Context.MODE_PRIVATE)
        sensorThread = HandlerThread("ET_Sensor_Thread", Process.THREAD_PRIORITY_MORE_FAVORABLE); sensorThread.start(); sensorHandler = Handler(sensorThread.looper)
        loadCalibration(); loadBaseline(); createNotificationChannel()
        val modeIdx = prefs.getInt("last_mode_$deviceKey", ScanMode.LEVEL_STABILITY.ordinal); currentMode = ScanMode.values().getOrElse(modeIdx) { ScanMode.LEVEL_STABILITY }
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int { if (intent?.action == "STOP_SERVICE") { stopMeasurement(); stopForeground(true); stopSelf() }; return START_NOT_STICKY }

    fun setUnitSystem(units: UnitSystem) { currentUnitSystem = units }
    fun setDoseStandard(std: OmniTraverserEngine.DoseStandard) { currentDoseStandard = std }
    fun setAlarmConfig(config: OmniTraverserEngine.AlarmConfig?) { activeAlarmConfig = config; etEngine.setAlarms(config) }
    fun captureBaseline() { val current = lastResult ?: return; baselineVib = current.rmsVibration; baselineSpl = current.correctedSPL; baselineLux = current.illuminanceLux; hasBaseline = true; saveBaseline() }
    fun clearBaseline() { baselineVib = null; baselineSpl = null; baselineLux = null; hasBaseline = false; prefs.edit().remove("base_vib_$deviceKey").remove("base_spl_$deviceKey").remove("base_lux_$deviceKey").apply() }
    private fun saveBaseline() { prefs.edit().putFloat("base_vib_$deviceKey", baselineVib?.toFloat()?:-1f).putFloat("base_spl_$deviceKey", baselineSpl?.toFloat()?:-1f).putFloat("base_lux_$deviceKey", baselineLux?.toFloat()?:-1f).apply() }
    private fun loadBaseline() { val v = prefs.getFloat("base_vib_$deviceKey", -1f); if (v >= 0) { baselineVib = v.toDouble(); baselineSpl = prefs.getFloat("base_spl_$deviceKey", -1f).toDouble(); baselineLux = prefs.getFloat("base_lux_$deviceKey", -1f).toDouble(); hasBaseline = true } }
    fun setGpsEnabled(enabled: Boolean) { if (isGpsEnabled == enabled) return; isGpsEnabled = enabled; if (isRunning) registerSensorsForMode(currentMode) }
    fun setAudioRecordingEnabled(enabled: Boolean) { if (isRecordingAudio == enabled) return; isRecordingAudio = enabled; if (enabled) startWavRecording() else stopWavRecording() }
    
    // --- SYNC ---
    fun startSyncMode(leader: Boolean) {
        isSyncLeader = leader
        serviceScope.launch(Dispatchers.IO) {
            try {
                udpSocket?.close()
                udpSocket = DatagramSocket(if(leader) null else SYNC_PORT) // Leader sends, Follower listens? Or peers.
                // Simple multicast setup for discovery or direct for data
                if (leader) startNsdDiscovery() else registerNsdService()
            } catch(e:Exception) { e.printStackTrace() }
        }
    }
    
    fun stopSyncMode() {
        try { nsdManager.unregisterService(registrationListener) } catch(e:Exception) {}
        try { nsdManager.stopServiceDiscovery(discoveryListener) } catch(e:Exception) {}
        udpSocket?.close(); udpSocket = null
        connectedPeers = 0
    }
    
    private val registrationListener = object : NsdManager.RegistrationListener {
        override fun onServiceRegistered(NsdServiceInfo: NsdServiceInfo) {}
        override fun onRegistrationFailed(serviceInfo: NsdServiceInfo, errorCode: Int) {}
        override fun onServiceUnregistered(arg0: NsdServiceInfo) {}
        override fun onUnregistrationFailed(serviceInfo: NsdServiceInfo, errorCode: Int) {}
    }
    
    private val discoveryListener = object : NsdManager.DiscoveryListener {
        override fun onDiscoveryStarted(regType: String) {}
        override fun onServiceFound(service: NsdServiceInfo) { if(service.serviceName.contains("ET_Sync")) connectedPeers++ }
        override fun onServiceLost(service: NsdServiceInfo) { if(connectedPeers > 0) connectedPeers-- }
        override fun onDiscoveryStopped(serviceType: String) {}
        override fun onStartDiscoveryFailed(serviceType: String, errorCode: Int) {}
        override fun onStopDiscoveryFailed(serviceType: String, errorCode: Int) {}
    }
    
    private fun registerNsdService() {
        val serviceInfo = NsdServiceInfo()
        serviceInfo.serviceName = "ET_Sync_${deviceKey}"
        serviceInfo.serviceType = "_et_physics._udp"
        serviceInfo.port = SYNC_PORT
        nsdManager.registerService(serviceInfo, NsdManager.PROTOCOL_DNS_SD, registrationListener)
    }
    private fun startNsdDiscovery() {
        nsdManager.discoverServices("_et_physics._udp", NsdManager.PROTOCOL_DNS_SD, discoveryListener)
    }

    fun startMeasurement(mode: ScanMode) { stopMeasurement(); isRunning = true; currentMode = mode; prefs.edit().putInt("last_mode_$deviceKey", mode.ordinal).apply(); sessionStartTime = System.currentTimeMillis(); trendStartTime = sessionStartTime; resetTrendAccumulators(); etEngine.resetDosimetry(); startBatteryLevel = getBatteryStats().level; val pm = getSystemService(Context.POWER_SERVICE) as PowerManager; wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "ET:ScanLock"); wakeLock?.acquire(12*60*60*1000L); startForeground(1, buildNotification("ET Active: $mode", "v24.0-Networked")); registerSensorsForMode(mode); if (mode == ScanMode.NOISE_SCANNER || mode == ScanMode.VIBRATION_MONITOR) startAudioLoop(); voiceMemos.clear() }
    private fun registerSensorsForMode(mode: ScanMode) { sensorManager.unregisterListener(this); locationManager.removeUpdates(this); val delay = when(mode) { ScanMode.BATTERY_SAVER, ScanMode.LIGHT_METER, ScanMode.WEATHER_MONITOR -> SensorManager.SENSOR_DELAY_NORMAL; ScanMode.LEVEL_STABILITY, ScanMode.NOISE_SCANNER -> SensorManager.SENSOR_DELAY_UI; else -> SensorManager.SENSOR_DELAY_GAME }; val accel = sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER); sensorManager.registerListener(this, accel, delay, sensorHandler); if (mode == ScanMode.VIBRATION_MONITOR || mode == ScanMode.LEVEL_STABILITY || mode == ScanMode.WEATHER_MONITOR) { val mag = sensorManager.getDefaultSensor(Sensor.TYPE_MAGNETIC_FIELD); if (mag != null) sensorManager.registerListener(this, mag, delay, sensorHandler); if (mode != ScanMode.WEATHER_MONITOR) { val gyro = sensorManager.getDefaultSensor(Sensor.TYPE_GYROSCOPE); sensorManager.registerListener(this, gyro, delay, sensorHandler) } }; val light = sensorManager.getDefaultSensor(Sensor.TYPE_LIGHT); if (light != null && (mode == ScanMode.LIGHT_METER || mode == ScanMode.LEVEL_STABILITY || mode == ScanMode.WEATHER_MONITOR)) sensorManager.registerListener(this, light, delay, sensorHandler); val pressure = sensorManager.getDefaultSensor(Sensor.TYPE_PRESSURE); if (pressure != null) sensorManager.registerListener(this, pressure, delay, sensorHandler); val temp = sensorManager.getDefaultSensor(Sensor.TYPE_AMBIENT_TEMPERATURE); if (temp != null) sensorManager.registerListener(this, temp, SensorManager.SENSOR_DELAY_NORMAL, sensorHandler); if (isGpsEnabled) try { if (locationManager.isProviderEnabled(LocationManager.GPS_PROVIDER)) locationManager.requestLocationUpdates(LocationManager.GPS_PROVIDER, 2000L, 5f, this) } catch (e: SecurityException) { isGpsEnabled = false } }
    fun stopMeasurement() { isRunning = false; serviceJob?.cancel(); try { sensorManager.unregisterListener(this) } catch (e: Exception) {}; try { locationManager.removeUpdates(this) } catch (e: Exception) {}; stopAudio(); stopWavRecording(); stopSyncMode(); try { if (wakeLock?.isHeld == true) wakeLock?.release() } catch (e: Exception) {}; synchronized(trendLock) {} }
    override fun onDestroy() { stopMeasurement(); sensorThread.quitSafely(); serviceScope.cancel(); super.onDestroy() }
    override fun onLocationChanged(location: Location) { currentLat = location.latitude; currentLon = location.longitude; currentAlt = location.altitude; currentAcc = location.accuracy }
    override fun onStatusChanged(provider: String?, status: Int, extras: Bundle?) {}
    override fun onProviderEnabled(provider: String) {}
    override fun onProviderDisabled(provider: String) {}
    private fun startWavRecording() { val timestamp = System.currentTimeMillis(); wavFile = File(cacheDir, "recording_$timestamp.raw"); try { wavOutputStream = FileOutputStream(wavFile) } catch (e: Exception) { isRecordingAudio = false; e.printStackTrace() } }
    private fun stopWavRecording() { try { wavOutputStream?.close(); wavOutputStream = null } catch (e: Exception) { e.printStackTrace() } }
    private fun writeAudioToWav(buffer: ShortArray, readSize: Int) { if (!isRecordingAudio || wavOutputStream == null) return; try { val bytes = ByteArray(readSize * 2); for (i in 0 until readSize) { val s = buffer[i].toInt(); bytes[i * 2] = (s and 0x00FF).toByte(); bytes[i * 2 + 1] = ((s shr 8) and 0x00FF).toByte() }; wavOutputStream?.write(bytes) } catch (e: Exception) { e.printStackTrace() } }
    
    // --- VOICE MEMO LOGIC ---
    fun startVoiceMemo() {
        if (isRecordingMemo) return
        val file = File(cacheDir, "memo_${System.currentTimeMillis()}.3gp")
        voiceMemos.add(file)
        memoRecorder = MediaRecorder().apply { setAudioSource(MediaRecorder.AudioSource.MIC); setOutputFormat(MediaRecorder.OutputFormat.THREE_GPP); setAudioEncoder(MediaRecorder.AudioEncoder.AMR_NB); setOutputFile(file.absolutePath); try { prepare(); start(); isRecordingMemo = true } catch(e:IOException) { e.printStackTrace() } }
    }
    fun stopVoiceMemo() { try { memoRecorder?.stop(); memoRecorder?.release() } catch(e:Exception) {}; memoRecorder = null; isRecordingMemo = false }

    private fun startAudioLoop() { serviceJob = serviceScope.launch(Dispatchers.IO) { if (audioRecord != null) stopAudio(); if (!initAudioRecordSafe()) return@launch; val buffer = ShortArray(detectedBufferSize); try { while (isActive && isRunning && !isThrottled) { if (currentMode == ScanMode.NOISE_SCANNER || currentMode == ScanMode.VIBRATION_MONITOR) { if (audioRecord?.recordingState != AudioRecord.RECORDSTATE_RECORDING) audioRecord?.startRecording(); val read = audioRecord?.read(buffer, 0, detectedBufferSize) ?: 0; if (read > 0) { synchronized(audioLock) { currentAudioBuffer = buffer.copyOf() }; if (isRecordingAudio) writeAudioToWav(buffer, read) }; if (currentMode == ScanMode.NOISE_SCANNER && !isRecordingAudio) {} else { delay(20) } } } } catch (e: Exception) { e.printStackTrace() } finally { stopAudio() } } }
    private fun initAudioRecordSafe(): Boolean { stopAudio(); val rates = intArrayOf(16000, 44100, 48000, 8000); for (rate in rates) { try { val size = AudioRecord.getMinBufferSize(rate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT); if (size > 0) { detectedSampleRate = rate; detectedBufferSize = size; audioRecord = AudioRecord(MediaRecorder.AudioSource.MIC, rate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, size); if (audioRecord?.state == AudioRecord.STATE_INITIALIZED) return true else { audioRecord?.release(); audioRecord = null } } } catch (e: Exception) { continue } }; return false }
    private fun stopAudio() { try { if (audioRecord?.state == AudioRecord.STATE_INITIALIZED) audioRecord?.stop(); audioRecord?.release() } catch(e: Exception) {} finally { audioRecord = null } }
    private var lastAccel = FloatArray(3); private var lastGyro = FloatArray(3); private var lastMag = FloatArray(3); private var currentLux: Float? = null; private var currentPressure: Float? = null; private var currentAmbientTemp: Float? = null
    override fun onSensorChanged(event: SensorEvent?) { event ?: return; if (event.sensor.type == Sensor.TYPE_ACCELEROMETER) System.arraycopy(event.values, 0, lastAccel, 0, 3); if (event.sensor.type == Sensor.TYPE_GYROSCOPE) System.arraycopy(event.values, 0, lastGyro, 0, 3); if (event.sensor.type == Sensor.TYPE_MAGNETIC_FIELD) System.arraycopy(event.values, 0, lastMag, 0, 3); if (event.sensor.type == Sensor.TYPE_LIGHT) currentLux = event.values[0]; if (event.sensor.type == Sensor.TYPE_PRESSURE) currentPressure = event.values[0]; if (event.sensor.type == Sensor.TYPE_AMBIENT_TEMPERATURE) currentAmbientTemp = event.values[0]; if (isThrottled) { throttleCounter++; if (throttleCounter % 10 != 0L) return }; val now = System.currentTimeMillis(); var bufferToProcess: ShortArray? = null; synchronized(audioLock) { bufferToProcess = currentAudioBuffer; currentAudioBuffer = null }; val rotation = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) try { baseContext.display?.rotation ?: 0 } catch(e:Exception) {0} else @Suppress("DEPRECATION") windowManager.defaultDisplay.rotation; val result = etEngine.resolveConfiguration(lastAccel.clone(), lastGyro.clone(), lastMag.clone(), currentPressure, currentAmbientTemp, bufferToProcess, currentLux, currentLat, currentLon, currentAlt, currentAcc, rotation, event.timestamp, detectedSampleRate, currentDoseStandard); _lastResult.set(result); logData(result, now); updateTrend(result, now); updateBatteryStats(now); checkAlarm(result, now) }
    private fun checkAlarm(result: OmniTraverserEngine.SubstantiatedResult, now: Long) { if (result.alarmBreached && (now - lastAlarmTime > ALARM_COOLDOWN)) { triggerAlarmNotification(result.alarmMessage); lastAlarmTime = now } }
    private fun triggerAlarmNotification(msg: String) { val intent = Intent(this, MainActivity::class.java); val pendingIntent = PendingIntent.getActivity(this, 0, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE); val builder = NotificationCompat.Builder(this, "ET_ALARM_CHANNEL").setContentTitle("ET SENTINEL ALERT").setContentText(msg).setSmallIcon(android.R.drawable.stat_sys_warning).setPriority(NotificationCompat.PRIORITY_HIGH).setDefaults(NotificationCompat.DEFAULT_ALL).setContentIntent(pendingIntent).setAutoCancel(true); val nm = getSystemService(NotificationManager::class.java); nm.notify(999, builder.build()) }
    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
    private fun logData(result: OmniTraverserEngine.SubstantiatedResult, time: Long) { dataLog.add(LogEntry(time, result)); while (dataLog.size > 5000) dataLog.poll() }
    private fun resetTrendAccumulators() { accVibMax = 0.0; accSplSum = 0.0; accSplCount = 0; accPressSum = 0.0; accPressCount = 0; accTempSum = 0.0; accTempCount = 0; accLuxSum = 0.0; accLuxCount = 0 }
    private fun updateTrend(result: OmniTraverserEngine.SubstantiatedResult, now: Long) { synchronized(trendLock) { accVibMax = max(accVibMax, result.rmsVibration); if (result.correctedSPL > 0) { accSplSum += result.correctedSPL; accSplCount++ }; if (result.pressureHpa > 0) { accPressSum += result.pressureHpa; accPressCount++ }; if (result.ambientTempC != null) { accTempSum += result.ambientTempC; accTempCount++ }; if (result.illuminanceLux >= 0) { accLuxSum += result.illuminanceLux; accLuxCount++ }; if (now - trendStartTime >= 60000) { trendLog.add(TrendPoint(trendStartTime + 30000, accVibMax, if (accSplCount > 0) accSplSum / accSplCount else 0.0, if (accPressCount > 0) accPressSum / accPressCount else 0.0, if (accTempCount > 0) accTempSum / accTempCount else null, if (accLuxCount > 0) accLuxSum / accLuxCount else 0.0)); while (trendLog.size > 1440) trendLog.removeAt(0); trendStartTime = now; resetTrendAccumulators() } } }
    fun getTrendHistory(): List<TrendPoint> { synchronized(trendLock) { return ArrayList(trendLog) } }
    fun tareAltitude() { val p = currentPressure; if (p != null) etEngine.tareAltitude(p.toDouble()) }
    private data class BatteryStats(val level: Int, val temp: Float)
    private fun getBatteryStats(): BatteryStats { val intent = registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED)); val level = intent?.getIntExtra(BatteryManager.EXTRA_LEVEL, -1) ?: 100; val tempRaw = intent?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 0) ?: 0; return BatteryStats(level, tempRaw / 10.0f) }
    private fun updateBatteryStats(now: Long) { if ((now - sessionStartTime) % 60000 < 100) { val stats = getBatteryStats(); batteryTemp = stats.temp; if (batteryTemp > 45.0f && !isThrottled) { isThrottled = true; registerSensorsForMode(ScanMode.BATTERY_SAVER) } else if (batteryTemp < 40.0f && isThrottled) { isThrottled = false; registerSensorsForMode(currentMode) }; val hrs = (now - sessionStartTime) / 3600000.0; if (hrs > 0.1) batteryDrainRate = (startBatteryLevel - stats.level) / hrs } }
    fun runCalibration() { calibrationStatus = "Calibrating..."; serviceScope.launch { val samples = 50; var ax = 0.0; var ay = 0.0; var az = 0.0; for(i in 1..samples) { readingsX[i] = lastAccel[0].toDouble(); ax += lastAccel[0]; ay += lastAccel[1]; az += lastAccel[2]; delay(20) }; prefs.edit().putFloat("cal_acc_x_$deviceKey", ax.toFloat()).putFloat("cal_acc_y_$deviceKey", ay.toFloat()).putFloat("cal_acc_z_$deviceKey", az.toFloat()).apply(); etEngine.setCalibration(floatArrayOf(ax.toFloat(), ay.toFloat(), az.toFloat()), floatArrayOf(0f,0f,0f), 0.0); calibrationStatus = "Success" } }
    private val readingsX = DoubleArray(50) 
    private fun loadCalibration() { val ax = prefs.getFloat("cal_acc_x_$deviceKey", 0f); val ay = prefs.getFloat("cal_acc_y_$deviceKey", 0f); val az = prefs.getFloat("cal_acc_z_$deviceKey", 0f); val spl = prefs.getFloat("cal_spl_$deviceKey", 0f).toDouble(); etEngine.setCalibration(floatArrayOf(ax, ay, az), floatArrayOf(0f,0f,0f), spl) }
    fun getDurationString(): String { if (sessionStartTime == 0L) return "00:00"; val diff = System.currentTimeMillis() - sessionStartTime; return String.format("%02d:%02d", diff/3600000, (diff/60000)%60) }
    private fun buildNotification(title: String, text: String): Notification { val pendingIntent = PendingIntent.getActivity(this, 0, Intent(this, MainActivity::class.java), PendingIntent.FLAG_IMMUTABLE); val builder = NotificationCompat.Builder(this, "ET_CHANNEL_ID").setContentTitle(title).setContentText(text).setSmallIcon(android.R.drawable.ic_menu_compass).setContentIntent(pendingIntent); if (isThrottled) builder.setSubText("⚠ COOLING MODE"); return builder.build() }
    private fun createNotificationChannel() { val nm = getSystemService(NotificationManager::class.java); if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) { val channel = NotificationChannel("ET_CHANNEL_ID", "ET Scanner", NotificationManager.IMPORTANCE_LOW); nm.createNotificationChannel(channel); val alarmChannel = NotificationChannel("ET_ALARM_CHANNEL", "ET Alarms", NotificationManager.IMPORTANCE_HIGH); alarmChannel.enableVibration(true); alarmChannel.enableLights(true); nm.createNotificationChannel(alarmChannel) } }

    private fun convVib(v: Double) = if (currentUnitSystem == UnitSystem.METRIC) v else v * 0.03937
    private fun convPress(p: Double) = if (currentUnitSystem == UnitSystem.METRIC) p else p * 0.02953
    private fun convTemp(t: Double?) = if (t == null) null else if (currentUnitSystem == UnitSystem.METRIC) t else t * 1.8 + 32
    private fun convAlt(a: Double) = if (currentUnitSystem == UnitSystem.METRIC) a else a * 3.28084

    fun generatePdfReport(context: Context): File {
        val pdfFile = File(context.cacheDir, "ET_Report_${System.currentTimeMillis()}.pdf")
        val pdfDocument = PdfDocument()
        val pageInfo = PdfDocument.PageInfo.Builder(595, 842, 1).create()
        val page = pdfDocument.startPage(pageInfo); val canvas = page.canvas; val paint = Paint()
        val trendSnapshot = getTrendHistory()

        paint.color = Color.BLACK; paint.textSize = 24f; paint.isFakeBoldText = true
        canvas.drawText("ET PHYSICS TOOLBOX - FIELD REPORT", 50f, 50f, paint)
        paint.textSize = 12f; paint.isFakeBoldText = false
        val dateStr = SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.US).format(Date())
        canvas.drawText("Generated: $dateStr", 50f, 70f, paint); canvas.drawText("Device: ${Build.MODEL}", 50f, 85f, paint)
        
        paint.style = Paint.Style.STROKE; paint.strokeWidth = 1f; canvas.drawRect(50f, 120f, 545f, 200f, paint)
        paint.style = Paint.Style.FILL; canvas.drawText("SESSION SUMMARY (${currentUnitSystem})", 60f, 140f, paint)
        
        var maxV = 0.0; var maxS = 0.0; var avgP = 0.0
        if (trendSnapshot.isNotEmpty()) { maxV = trendSnapshot.maxOf { it.maxVibration }; maxS = trendSnapshot.maxOf { it.avgSpl }; avgP = trendSnapshot.map { it.avgPressure }.average() }
        val uV = if(currentUnitSystem==UnitSystem.METRIC) "mm/s" else "in/s"; val uP = if(currentUnitSystem==UnitSystem.METRIC) "hPa" else "inHg"
        canvas.drawText("Peak Vib: %.3f %s".format(convVib(maxV), uV), 60f, 160f, paint)
        canvas.drawText("Peak SPL: %.1f dB(A)".format(maxS), 300f, 160f, paint)
        canvas.drawText("Avg Press: %.1f %s".format(convPress(avgP), uP), 60f, 180f, paint)
        
        // Add Dosimetry to PDF
        val res = lastResult
        if (res != null) {
            canvas.drawText("Dose: %.1f%% (%s)".format(res.dosePercent, res.doseStandard), 300f, 180f, paint)
            canvas.drawText("Proj TWA: %.1f dB".format(res.twaDb), 450f, 180f, paint)
        }
        
        canvas.drawText("TREND ANALYSIS", 50f, 240f, paint)
        val graphRect = android.graphics.RectF(50f, 260f, 545f, 500f)
        paint.style = Paint.Style.STROKE; canvas.drawRect(graphRect, paint)
        if (trendSnapshot.isNotEmpty()) {
            val pathV = android.graphics.Path(); val w = graphRect.width(); val h = graphRect.height()
            trendSnapshot.forEachIndexed { i, p -> val x = graphRect.left + (i.toFloat() / trendSnapshot.size) * w; val yV = graphRect.bottom - (p.maxVibration.toFloat() / 10f) * h; if(i==0) pathV.moveTo(x, yV) else pathV.lineTo(x, yV) }
            paint.color = Color.MAGENTA; paint.strokeWidth = 2f; canvas.drawPath(pathV, paint)
        }
        pdfDocument.finishPage(page); FileOutputStream(pdfFile).use { pdfDocument.writeTo(it) }; pdfDocument.close()
        return pdfFile
    }

    fun getLogZip(context: Context): File {
        val timestamp = System.currentTimeMillis(); val zipFile = File(context.cacheDir, "et_report_$timestamp.zip"); val snapshot = ArrayList(dataLog); val trendSnapshot = getTrendHistory(); val dateFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US); val sb = StringBuilder()
        ZipOutputStream(FileOutputStream(zipFile)).use { zos ->
            zos.putNextEntry(ZipEntry("raw_data.csv")); val units = currentUnitSystem
            zos.write("Time,Hz,Shimmer,Vel_${if(units==UnitSystem.METRIC)"mm" else "in"}_s,ISO_Zone,SPL_dBA,Dose_Pct,TWA_dB,Lux,Pressure_${if(units==UnitSystem.METRIC)"hPa" else "inHg"},Alt_${if(units==UnitSystem.METRIC)"m" else "ft"},Temp_${if(units==UnitSystem.METRIC)"C" else "F"},Lat,Lon,Freq_Hz,Label,Severity\n".toByteArray())
            snapshot.forEach { entry -> val r = entry.result; val t = dateFormat.format(Date(entry.time)); sb.setLength(0); sb.append(t).append(",")
                sb.append(String.format("%.1f", r.realHz)).append(",")
                sb.append(String.format("%.4f", r.shimmerIndex)).append(",")
                sb.append(String.format("%.2f", convVib(r.velocityRms))).append(",")
                sb.append(r.isoZone).append(",")
                sb.append(String.format("%.1f", r.correctedSPL)).append(",")
                sb.append(String.format("%.1f", r.dosePercent)).append(",")
                sb.append(String.format("%.1f", r.twaDb)).append(",")
                sb.append(String.format("%.0f", r.illuminanceLux)).append(",")
                sb.append(String.format("%.2f", convPress(r.pressureHpa))).append(",")
                sb.append(String.format("%.1f", convAlt(r.relativeAltitude))).append(",")
                sb.append(if(r.ambientTempC != null) String.format("%.1f", convTemp(r.ambientTempC)) else "N/A").append(",")
                sb.append(if(r.gpsLat != null) String.format("%.6f", r.gpsLat) else "").append(",")
                sb.append(if(r.gpsLon != null) String.format("%.6f", r.gpsLon) else "").append(",")
                sb.append(String.format("%.1f", r.dominantFreq)).append(",")
                sb.append(r.freqLabel).append(",")
                sb.append(r.faultSeverity).append("\n")
                zos.write(sb.toString().toByteArray()) }
            zos.closeEntry()
            
            zos.putNextEntry(ZipEntry("trend_history.csv")); zos.write("Time,MaxVib,AvgSPL,AvgPress,AvgTemp,AvgLux\n".toByteArray())
            trendSnapshot.forEach { p -> val t = dateFormat.format(Date(p.timestamp)); sb.setLength(0); sb.append(t).append(",").append(String.format("%.3f", convVib(p.maxVibration))).append(",").append(String.format("%.1f", p.avgSpl)).append(",").append(String.format("%.2f", convPress(p.avgPressure))).append(",").append(if(p.avgTemp!=null) String.format("%.1f", convTemp(p.avgTemp)) else "N/A").append(",").append(String.format("%.0f", p.avgLux)).append("\n"); zos.write(sb.toString().toByteArray()) }; zos.closeEntry()
            
            val gson = GsonBuilder().setPrettyPrinting().create()
            val jsonFile = File(context.cacheDir, "scientific_data.json")
            val jsonMap = mapOf("meta" to mapOf("device" to Build.MODEL, "timestamp" to timestamp), "data" to snapshot.map { mapOf("t" to it.time, "vib" to it.result.rmsVibration, "spl" to it.result.correctedSPL, "press" to it.result.pressureHpa, "dose" to it.result.dosePercent) })
            jsonFile.writeText(gson.toJson(jsonMap))
            zos.putNextEntry(ZipEntry("scientific_data.json")); FileInputStream(jsonFile).use { it.copyTo(zos) }; zos.closeEntry()

            if (wavFile != null && wavFile!!.exists()) { zos.putNextEntry(ZipEntry("audio_capture.wav")); val rawLen = wavFile!!.length(); val header = createWavHeader(rawLen, detectedSampleRate); zos.write(header); FileInputStream(wavFile).use { it.copyTo(zos) }; zos.closeEntry() }
            
            // Add Voice Memos
            voiceMemos.forEach { memo ->
                if (memo.exists()) {
                    zos.putNextEntry(ZipEntry("voice_memos/${memo.name}"))
                    FileInputStream(memo).use { it.copyTo(zos) }
                    zos.closeEntry()
                }
            }
        }
        return zipFile
    }

    private fun createWavHeader(pcmLen: Long, sampleRate: Int): ByteArray { val totalLen = pcmLen + 36; val header = ByteArray(44); header[0] = 'R'.toByte(); header[1] = 'I'.toByte(); header[2] = 'F'.toByte(); header[3] = 'F'.toByte(); header[4] = (totalLen and 0xff).toByte(); header[5] = ((totalLen shr 8) and 0xff).toByte(); header[6] = ((totalLen shr 16) and 0xff).toByte(); header[7] = ((totalLen shr 24) and 0xff).toByte(); header[8] = 'W'.toByte(); header[9] = 'A'.toByte(); header[10] = 'V'.toByte(); header[11] = 'E'.toByte(); header[12] = 'f'.toByte(); header[13] = 'm'.toByte(); header[14] = 't'.toByte(); header[15] = ' '.toByte(); header[16] = 16; header[17] = 0; header[18] = 0; header[19] = 0; header[20] = 1; header[21] = 0; header[22] = 1; header[23] = 0; header[24] = (sampleRate and 0xff).toByte(); header[25] = ((sampleRate shr 8) and 0xff).toByte(); header[26] = ((sampleRate shr 16) and 0xff).toByte(); header[27] = ((sampleRate shr 24) and 0xff).toByte(); val byteRate = sampleRate * 2; header[28] = (byteRate and 0xff).toByte(); header[29] = ((byteRate shr 8) and 0xff).toByte(); header[30] = ((byteRate shr 16) and 0xff).toByte(); header[31] = ((byteRate shr 24) and 0xff).toByte(); header[32] = 2; header[33] = 0; header[34] = 16; header[35] = 0; header[36] = 'd'.toByte(); header[37] = 'a'.toByte(); header[38] = 't'.toByte(); header[39] = 'a'.toByte(); header[40] = (pcmLen and 0xff).toByte(); header[41] = ((pcmLen shr 8) and 0xff).toByte(); header[42] = ((pcmLen shr 16) and 0xff).toByte(); header[43] = ((pcmLen shr 24) and 0xff).toByte(); return header }
    fun getLogCsv(context: Context): File { 
        val timestamp = System.currentTimeMillis(); val csvFile = File(context.cacheDir, "et_data_$timestamp.csv"); val snapshot = ArrayList(dataLog); val dateFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US); val sb = StringBuilder(); 
        FileOutputStream(csvFile).use { fos -> 
            val units = currentUnitSystem
            fos.write("Time,Hz,Shimmer,Vel_${if(units==UnitSystem.METRIC)"mm" else "in"}_s,ISO_Zone,SPL_dBA,Dose_Pct,TWA_dB,Lux,Pressure_${if(units==UnitSystem.METRIC)"hPa" else "inHg"},Alt_${if(units==UnitSystem.METRIC)"m" else "ft"},Temp_${if(units==UnitSystem.METRIC)"C" else "F"},Lat,Lon,Freq_Hz,Label,Severity\n".toByteArray())
            snapshot.forEach { entry -> val r = entry.result; val t = dateFormat.format(Date(entry.time)); sb.setLength(0); sb.append(t).append(",")
            sb.append(String.format("%.1f", r.realHz)).append(",")
            sb.append(String.format("%.4f", r.shimmerIndex)).append(",")
            sb.append(String.format("%.2f", convVib(r.velocityRms))).append(",")
            sb.append(r.isoZone).append(",")
            sb.append(String.format("%.1f", r.correctedSPL)).append(",")
            sb.append(String.format("%.1f", r.dosePercent)).append(",")
            sb.append(String.format("%.1f", r.twaDb)).append(",")
            sb.append(String.format("%.0f", r.illuminanceLux)).append(",")
            sb.append(String.format("%.2f", convPress(r.pressureHpa))).append(",")
            sb.append(String.format("%.1f", convAlt(r.relativeAltitude))).append(",")
            sb.append(if(r.ambientTempC != null) String.format("%.1f", convTemp(r.ambientTempC)) else "N/A").append(",")
            sb.append(if(r.gpsLat != null) String.format("%.6f", r.gpsLat) else "").append(",")
            sb.append(if(r.gpsLon != null) String.format("%.6f", r.gpsLon) else "").append(",")
            sb.append(String.format("%.1f", r.dominantFreq)).append(",")
            sb.append(r.freqLabel).append(",")
            sb.append(r.faultSeverity).append("\n")
            fos.write(sb.toString().toByteArray()) } 
        }
        return csvFile 
    }
    
    // SERVER FLUSH (From v19.0)
    fun flushPendingReports(context: Context) {
        val ip = prefs.getString("server_ip", "") ?: return
        if (ip.isEmpty()) return
        val secure = try {
             val mk = MasterKey.Builder(context).setKeyScheme(MasterKey.KeyScheme.AES256_GCM).build()
             EncryptedSharedPreferences.create(context, "ET_Secure_Prefs", mk, EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV, EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM)
        } catch(e:Exception) { context.getSharedPreferences("ET_Secure_Prefs_Fallback", Context.MODE_PRIVATE) }
        val apiKey = secure.getString("api_key", "") ?: ""
        val pendingDir = File(context.filesDir, "pending_reports")
        val files = pendingDir.listFiles { _, name -> name.endsWith(".zip") } ?: return
        serviceScope.launch(Dispatchers.IO) {
            for (zipFile in files) {
                val descFile = File(pendingDir, zipFile.name.replace(".zip", ".txt")); val desc = if (descFile.exists()) descFile.readText() else ""
                var urlStr = ip; if (!urlStr.startsWith("http")) urlStr = "https://$urlStr"; if (!urlStr.contains("/api/v1/upload")) urlStr += "/api/v1/upload"
                if (uploadFile(zipFile, desc, urlStr, apiKey)) { zipFile.delete(); if (descFile.exists()) descFile.delete() }
            }
        }
    }
    private fun uploadFile(file: File, description: String, urlStr: String, apiKey: String): Boolean {
        try { val url = URL(urlStr); val boundary = "Boundary-${System.currentTimeMillis()}"; val conn = url.openConnection() as HttpURLConnection; conn.requestMethod = "POST"; conn.doOutput = true; conn.connectTimeout = 10000; conn.readTimeout = 30000; conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=$boundary"); if(apiKey.isNotEmpty()) conn.setRequestProperty("X-ET-AUTH-TOKEN", apiKey); val os = DataOutputStream(conn.outputStream); if (description.isNotEmpty()) os.writeBytes("--$boundary\r\nContent-Disposition: form-data; name=\"description\"\r\n\r\n$description\r\n"); os.writeBytes("--$boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"${file.name}\"\r\nContent-Type: application/zip\r\n\r\n"); file.inputStream().use { it.copyTo(os) }; os.writeBytes("\r\n--$boundary--\r\n"); os.close(); return conn.responseCode in 200..299 } catch (e: Exception) { return false }
    }
}