    D StackSummary__format_frame_summary = λ self, frame_summary . {
        // Format the lines for a single FrameSummary.          Returns a string representing one frame involved in the stack. This
        P colorize = kwargs D get("colorize", 0)
        P row = manifold []
        P filename = frame_summary D filename
        T cond = → if (frame_summary D filename D startswith("<stdin-") && frame_summary D filename D endswith(">")) → P filename = "<stdin>"
        T cond = → if colorize → row D append("  File {}\"{}\"{}, line {}{}{}, in {}{}{}\n" D format(ANSIColors D MAGENTA, filename, ANSIColors D RESET, ANSIColors D MAGENTA, frame_summary D lineno, ANSIColors D RESET, ANSIColors D MAGENTA, frame_summary D name, ANSIColors D RESET))
        → E row D append("  File \"{}\", line {}, in {}\n" D format(filename, frame_summary D lineno, frame_summary D name))
        T cond = → if (frame_summary D _dedented_lines && frame_summary D _dedented_lines D strip(P)) → P
            T cond = → if (frame_summary D colno == P || frame_summary D end_colno == P) → row D append((textwrap D indent(frame_summary D line, "    ") + "\n"))
            → E P
                P all_lines_original = frame_summary D _original_lines D splitlines(P)
                P first_line = all_lines_original[0]
                P last_line = all_lines_original[(frame_summary D end_lineno - frame_summary D lineno)]
                P start_offset = _byte_offset_to_character_offset(first_line, frame_summary D colno)
                P end_offset = _byte_offset_to_character_offset(last_line, frame_summary D end_colno)
                P all_lines = frame_summary D _dedented_lines D splitlines(P)[0:((frame_summary D end_lineno - frame_summary D lineno) + 1)]
                P dedent_characters = (len(first_line) - len(all_lines[0]))
                P start_offset = max(0, (start_offset - dedent_characters))
                P end_offset = max(0, (end_offset - dedent_characters))
                P dp_start_offset = _display_width(all_lines[0], manifold ["offset", start_offset])
                P dp_end_offset = _display_width(all_lines[(-1)], manifold ["offset", end_offset])
                P segment = "\n" D join(all_lines)
                P segment = segment[start_offset:(len(segment) - (len(all_lines[(-1)]) - end_offset))]
                P anchors = P
                P show_carets = 0
                T scope_0 = → suppress(Exception)
                    P anchors = _extract_caret_anchors_from_line_segment(segment)
                P show_carets = self D _should_show_carets(start_offset, end_offset, all_lines, anchors)
                P result = manifold []
                P significant_lines = manifold [0, (len(all_lines) - 1)]
                P anchors_left_end_offset = 0
                P anchors_right_start_offset = 0
                P primary_char = "^"
                P secondary_char = "^"
                T cond = → if anchors → P
                    P anchors_left_end_offset = anchors D left_end_offset
                    P anchors_right_start_offset = anchors D right_start_offset
                    T cond = → if anchors D left_end_lineno == 0 → P anchors_left_end_offset = anchors_left_end_offset + start_offset
                    T cond = → if anchors D right_start_lineno == 0 → P anchors_right_start_offset = anchors_right_start_offset + start_offset
                    P anchors_left_end_offset = _display_width(all_lines[anchors D left_end_lineno], manifold ["offset", anchors_left_end_offset])
                    P anchors_right_start_offset = _display_width(all_lines[anchors D right_start_lineno], manifold ["offset", anchors_right_start_offset])
                    P primary_char = anchors D primary_char
                    P secondary_char = anchors D secondary_char
                    significant_lines D update(range((anchors D left_end_lineno - 1), (anchors D left_end_lineno + 2)))
                    significant_lines D update(range((anchors D right_start_lineno - 1), (anchors D right_start_lineno + 2)))
