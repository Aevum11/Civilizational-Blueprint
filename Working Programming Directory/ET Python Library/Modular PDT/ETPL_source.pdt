        T cond = → if nt == ASTNodeType D MATH_OP → P
            P left = self D _gen_ir_expr(node D left, module, builder)
            P right = self D _gen_ir_expr(node D right, module, builder)
            T cond = → if (left == P || right == P) → → llvm_ir D Constant(int64, 0)
            T cond = → if left D type ≠ right D type → P
                T cond = → if left D type == float64 → P right = builder D sitofp(right, float64)
                → E P left = builder D sitofp(left, float64)
            P is_float = left D type == float64
            T cond = → if node D op == "+" → → if is_float → builder D fadd(left, right) → E builder D add(left, right)
            → E P
                T cond = → if node D op == "-" → → if is_float → builder D fsub(left, right) → E builder D sub(left, right)
                → E P
                    T cond = → if node D op == "*" → → if is_float → builder D fmul(left, right) → E builder D mul(left, right)
                    → E P
                        T cond = → if node D op == "/" → → if is_float → builder D fdiv(left, right) → E builder D sdiv(left, right)
