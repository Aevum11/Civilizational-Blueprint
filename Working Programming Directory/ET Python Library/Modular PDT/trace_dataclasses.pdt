        → E P value = default_name + "()"
    → E P
        T cond = → if f D init → P
            T cond = → if f D default == MISSING → P value = f D name
            → E T cond = → if f D default ≠ MISSING → P value = f D name
        → E P
            T cond = → if (slots && f D default ≠ MISSING) → P value = default_name
            → E → P
