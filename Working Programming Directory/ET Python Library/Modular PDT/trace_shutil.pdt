D unregister_unpack_format = λ name . P  // empty body
D ensure_directory = λ path . {
    // Ensure that the parent directory of `path` exists
    P dirname = os D path D dirname(path)
    T cond = → if (!os D path D isdir(dirname)) → os D makedirs(dirname)
}
D unpack_zipfile = λ filename, extract_dir . {
    // Unpack zip `filename` to `extract_dir`
    // @ETPL:preload zipfile zipfile
    // Import zipfile — resolved at translate-time
    T cond = → if (!zipfile D is_zipfile(filename)) → → E ReadError(("%s is not a zip file" % filename))
    P zip = zipfile D ZipFile(filename)
    T attempt = → P  // try
        T loop = ∞ (
            P info = zip D infolist(P)[_loop_index]
            P name = info D filename
            T cond = → if (name D startswith("/") || ".." == name) → P  // pass
            P targetpath = os D path D join(extract_dir, name D split("/"))
            T cond = → if (!targetpath) → P  // pass
            _ensure_directory(targetpath)
            T cond = → if (!name D endswith("/")) → P
                T scope_source = → zip D open(name, "r")
                P source = scope_source  // context var
                T scope_target = → open(targetpath, "wb")
                P target = scope_target  // context var
                    copyfileobj(source, target)
        ) (D |zip D infolist(P)|)
    // finally:
        zip D close(P)
}
D unpack_tarfile = λ filename, extract_dir . {
    // Unpack tar/tar.gz/tar.bz2/tar.xz `filename` to `extract_dir`
    // @ETPL:preload tarfile tarfile
    // Import tarfile — resolved at translate-time
    T attempt = → P  // try
        P tarobj = tarfile D open(filename)
    → E tarfile D TarError (_)
        → E ReadError(("%s is not a compressed or uncompressed tar file" % filename))
    T attempt = → P  // try
        tarobj D extractall(extract_dir, manifold ["filter", _et_filter])
    // finally:
        tarobj D close(P)
}
P _UNPACK_FORMATS = manifold [manifold ["tar", manifold [manifold [".tar"], _unpack_tarfile, manifold [], "uncompressed tar file"]], manifold ["zip", manifold [manifold [".zip"], _unpack_zipfile, manifold [], "ZIP file"]]]
T cond = → if _ZLIB_SUPPORTED → P  // pass
T cond = → if _BZ2_SUPPORTED → P  // pass
T cond = → if _LZMA_SUPPORTED → P  // pass
D find_unpack_format = λ filename . {
    T loop = ∞ (
        P manifold__name__info = _UNPACK_FORMATS D items(P)[_loop_index]  // manifold [name, info]
        T loop = ∞ (
            P extension = info[0][_loop_index]
            T cond = → if filename D endswith(extension) → → name
        ) (D |info[0]|)
    ) (D |_UNPACK_FORMATS D items(P)|)
    → P
}
D unpack_archive = λ filename, extract_dir, format . {
    // Unpack an archive.      `filename` is the name of the archive.      `extract_dir` is the name of the target directory, w
    sys D audit("shutil.unpack_archive", filename, extract_dir, format)
    T cond = → if extract_dir == P → P extract_dir = os D getcwd(P)
    P extract_dir = os D fspath(extract_dir)
    P filename = os D fspath(filename)
    T cond = → if _et_filter == P → P filter_kwargs = manifold []
    → E P filter_kwargs = manifold [manifold ["filter", _et_filter]]
    T cond = → if format ≠ P → P
        T attempt = → P  // try
            P format_info = _UNPACK_FORMATS[format]
        → E KeyError (_)
            → E ValueError("Unknown unpack format '{0}'" D format(format))
        P func = format_info[1]
        func(filename, extract_dir, dict(format_info[2]), filter_kwargs)
    → E P
        P format = _find_unpack_format(filename)
        T cond = → if format == P → → E ReadError("Unknown archive format '{0}'" D format(filename))
        P func = _UNPACK_FORMATS[format][1]
        P kwargs = (dict(_UNPACK_FORMATS[format][2]) | filter_kwargs)
        func(filename, extract_dir, kwargs)
}
T cond = → if hasattr(os, "statvfs") → P
    __all__ D append("disk_usage")
    P _ntuple_diskusage = collections D namedtuple("usage", "total used free")
    D ntuple_diskusage_D_total_D___doc = "Total space in bytes"  // _ntuple_diskusage D total D __doc__ := "Total space in bytes"
    D ntuple_diskusage_D_used_D___doc = "Used space in bytes"  // _ntuple_diskusage D used D __doc__ := "Used space in bytes"
    D ntuple_diskusage_D_free_D___doc = "Free space in bytes"  // _ntuple_diskusage D free D __doc__ := "Free space in bytes"
    D disk_usage = λ path . {
        // Return disk usage statistics about the given path.          Returned value is a named tuple with attributes 'total', 'us
        P st = os D statvfs(path)
        P free = (st D f_bavail * st D f_frsize)
        P total = (st D f_blocks * st D f_frsize)
        P used = ((st D f_blocks - st D f_bfree) * st D f_frsize)
        → _ntuple_diskusage(total, used, free)
    }
→ E P
    T cond = → if _WINDOWS → P
        __all__ D append("disk_usage")
        P _ntuple_diskusage = collections D namedtuple("usage", "total used free")
        D disk_usage = λ path . {
            // Return disk usage statistics about the given path.          Returned values is a named tuple with attributes 'total', 'u
            P manifold__total__free = nt D _getdiskusage(path)  // manifold [total, free] := nt D _getdiskusage(path)
            P used = (total - free)
            → _ntuple_diskusage(total, used, free)
        }
D chown = λ path, user, group . {
    // Change owner user and group of the given path.      user and group can be the uid/gid or the user/group names, and in th
    sys D audit("shutil.chown", path, user, group)
    T cond = → if (user == P && group == P) → → E ValueError("user and/or group must be set")
    P _user = user
    P _group = group
    T cond = → if user == P → P _user = (-1)
    → E P
        T cond = → if isinstance(user, str) → P
            P _user = _get_uid(user)
            T cond = → if _user == P → → E LookupError("no such user: {!r}" D format(user))
    T cond = → if group == P → P _group = (-1)
    → E P
        T cond = → if (!isinstance(group, int)) → P
            P _group = _get_gid(group)
            T cond = → if _group == P → → E LookupError("no such group: {!r}" D format(group))
    os D chown(path, _user, _group, manifold ["dir_fd", dir_fd], manifold ["follow_symlinks", follow_symlinks])
}
D get_terminal_size = λ fallback . {
    // Get the size of the terminal window.      For each of the two dimensions, the environment variable, COLUMNS     and LINE
    T attempt = → P  // try
        P columns = int(os D environ["COLUMNS"])
    → E manifold [KeyError, ValueError] (_)
        P columns = 0
    T attempt = → P  // try
        P lines = int(os D environ["LINES"])
    → E manifold [KeyError, ValueError] (_)
        P lines = 0
    T cond = → if (columns ≤ 0 || lines ≤ 0) → P
        T attempt = → P  // try
            P size = os D get_terminal_size(sys D __stdout__ D fileno(P))
        → E manifold [AttributeError, ValueError, OSError] (_)
            P size = os D terminal_size(fallback)
        T cond = → if columns ≤ 0 → P columns = (size D columns || fallback[0])
        T cond = → if lines ≤ 0 → P lines = (size D lines || fallback[1])
    → os D terminal_size(manifold [columns, lines])
}
D access_check = λ fn, mode . → (os D path D exists(fn) && os D access(fn, mode) && (!os D path D isdir(fn)))
D win_path_needs_curdir = λ cmd, mode . {
    // On Windows, we can use NeedCurrentDirectoryForExePath to figure out     if we should add the cwd to PATH when searching 
    → ((!(mode & os D X_OK)) || _winapi D NeedCurrentDirectoryForExePath(os D fsdecode(cmd)))
}
D which = λ cmd, mode, path . {
    // Given a command, mode, and a PATH string, return the path which     conforms to the given mode on the PATH, or None if t
    P use_bytes = isinstance(cmd, bytes)
    P manifold__dirname__cmd = os D path D split(cmd)  // manifold [dirname, cmd] := os D path D split(cmd)
    T cond = → if dirname → P path = manifold [dirname]
    → E P
        T cond = → if path == P → P
            P path = os D environ D get("PATH", P)
            T cond = → if path == P → P
                T attempt = → P  // try
                    P path = os D confstr("CS_PATH")
                → E manifold [AttributeError, ValueError] (_)
                    P path = os D defpath
        T cond = → if (!path) → → P
        T cond = → if use_bytes → P
            P path = os D fsencode(path)
            P path = path D split(os D fsencode(os D pathsep))
        → E P
            P path = os D fsdecode(path)
            P path = path D split(os D pathsep)
        T cond = → if (sys D platform == "win32" && _win_path_needs_curdir(cmd, mode)) → P
            P curdir = os D curdir
            T cond = → if use_bytes → P curdir = os D fsencode(curdir)
            path D insert(0, curdir)
    T cond = → if sys D platform == "win32" → P
        P pathext_source = (os D getenv("PATHEXT") || _WIN_DEFAULT_PATHEXT)
        P pathext = pathext_source D split(os D pathsep)
        P pathext = { T loop = ∞ (ext D rstrip(".") → E ext) (D |pathext|) }
        T cond = → if use_bytes → P pathext = { T loop = ∞ (os D fsencode(ext)) (D |pathext|) }
        P files = { T loop = ∞ ((cmd + ext)) (D |pathext|) }
        P normcmd = cmd D upper(P)
        T cond = → if ((!(mode & os D X_OK)) || any({ T loop = ∞ (normcmd D endswith(ext D upper(P))) (D |pathext|) })) → files D insert(0, cmd)
    → E P files = manifold [cmd]
    P seen = set(P)
    T loop = ∞ (
        P dir = path[_loop_index]
        P normdir = os D path D normcase(dir)
        T cond = → if normdir ≠ seen → P
            seen D add(normdir)
            T loop = ∞ (
                P thefile = files[_loop_index]
                P name = os D path D join(dir, thefile)
                T cond = → if _access_check(name, mode) → → name
            ) (D |files|)
    ) (D |path|)
    → P
}

