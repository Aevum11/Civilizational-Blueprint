D rmtree = λ path, ignore_errors, onerror . {
    // Recursively delete a directory tree.      If dir_fd is not None, it should be a file descriptor open to a directory;    
    sys D audit("shutil.rmtree", path, dir_fd)
    T cond = → if ignore_errors → D onexc = λ  . P  // empty body
    → E P
        T cond = → if (onerror == P && onexc == P) → D onexc = λ  . → E P
        → E P
            T cond = → if onexc == P → P
                T cond = → if onerror == P → D onexc = λ  . → E P
                → E P
                    D onexc = λ  . {
                        P manifold__func__path__exc = args  // manifold [func, path, exc] := args
                        T cond = → if exc == P → P exc_info = manifold [P, P, P]
                        → E P exc_info = manifold [type(exc), exc, exc D __traceback__]
                        → onerror(func, path, exc_info)
                    }
    T cond = → if _use_fd_functions → P
        T cond = → if isinstance(path, bytes) → P path = os D fsdecode(path)
        P stack = manifold [manifold [os D lstat, dir_fd, path, P]]
        T attempt = → P  // try
            T while_loop = ∞ (
                T check = → if stack → P  // while body follows
                    _rmtree_safe_fd(stack, onexc)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        // finally:
            T while_loop = ∞ (
                T check = → if stack → P  // while body follows
                    P manifold__func__fd__path__entry = stack D pop(P)  // manifold [func, fd, path, entry] := stack D pop(P)
                    T cond = → if func ≠ os D close → P  // pass
                    T attempt = → P  // try
                        os D close(fd)
                    → E OSError (err)
                        onexc(os D close, path, err)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → E P
        T cond = → if dir_fd ≠ P → → E NotImplementedError("dir_fd unavailable on this platform")
        T attempt = → P  // try
            P st = os D lstat(path)
        → E OSError (err)
            onexc(os D lstat, path, err)
            → P
        T attempt = → P  // try
            T cond = → if _rmtree_islink(st) → → E OSError("Cannot call rmtree on a symbolic link")
        → E OSError (err)
            onexc(os D path D islink, path, err)
            → P
        → _rmtree_unsafe(path, onexc)
}
D rmtree_D_avoids_symlink_attacks = _use_fd_functions  // rmtree D avoids_symlink_attacks := _use_fd_functions
D basename = λ path . {
    // A basename() variant which first strips the trailing slash, if present.     Thus we always get the last component of the
    P path = os D fspath(path)
    P sep = (os D path D sep + (os D path D altsep || ""))
    → os D path D basename(path D rstrip(sep))
}
D move = λ src, dst, copy_function . {
    // Recursively move a file or directory to another location. This is     similar to the Unix "mv" command. Return the file 
    sys D audit("shutil.move", src, dst)
    P real_dst = dst
    T cond = → if os D path D isdir(dst) → P
        T cond = → if (_samefile(src, dst) && (!os D path D islink(src))) → P
            os D rename(src, dst)
            → P
        P real_dst = os D path D join(dst, _basename(src))
        T cond = → if os D path D exists(real_dst) → → E Error(("Destination path '%s' already exists" % real_dst))
    T attempt = → P  // try
        os D rename(src, real_dst)
    → E OSError (_)
        T cond = → if os D path D islink(src) → P
            P linkto = os D readlink(src)
            os D symlink(linkto, real_dst)
            os D unlink(src)
        → E P
            T cond = → if os D path D isdir(src) → P
                T cond = → if _destinsrc(src, dst) → → E Error(("Cannot move a directory '%s' into itself '%s'." % manifold [src, dst]))
                T cond = → if (_is_immutable(src) || ((!os D access(src, os D W_OK)) && os D listdir(src) && sys D platform == "darwin")) → → E PermissionError(("Cannot move the non-empty directory '%s': Lacking write permission to '%s'." % manifold [src, src]))
                copytree(src, real_dst, manifold ["copy_function", copy_function], manifold ["symlinks", 1])
                rmtree(src)
            → E P
                copy_function(src, real_dst)
                os D unlink(src)
    → real_dst
}
D destinsrc = λ src, dst . {
    P src = os D path D abspath(src)
    P dst = os D path D abspath(dst)
    T cond = → if (!src D endswith(os D path D sep)) → P src = src + os D path D sep
    T cond = → if (!dst D endswith(os D path D sep)) → P dst = dst + os D path D sep
    → dst D startswith(src)
}
D is_immutable = λ src . {
    P st = _stat(src)
    P immutable_states = manifold [stat D UF_IMMUTABLE, stat D SF_IMMUTABLE]
    → (hasattr(st, "st_flags") && st D st_flags == immutable_states)
}
D get_gid = λ name . {
    // Returns a gid, given a group name.
    T cond = → if name == P → → P
    T attempt = → P  // try
        // @ETPL:unresolvable grp.getgrnam
    → E ImportError (_)
        → P
    T attempt = → P  // try
        P result = getgrnam(name)
    → E KeyError (_)
        P result = P
    T cond = → if result ≠ P → → result[2]
    → P
}
D get_uid = λ name . {
    // Returns an uid, given a user name.
    T cond = → if name == P → → P
    T attempt = → P  // try
        // @ETPL:unresolvable pwd.getpwnam
    → E ImportError (_)
        → P
    T attempt = → P  // try
        P result = getpwnam(name)
    → E KeyError (_)
        P result = P
    T cond = → if result ≠ P → → result[2]
    → P
}
D make_tarball = λ base_name, base_dir, compress, verbose, dry_run, owner, group, logger, root_dir . {
    // Create a (possibly compressed) tar file from all the files under     'base_dir'.      'compress' must be "gzip" (the def
    T cond = → if compress == P → P tar_compression = ""
    → E P
        T cond = → if (_ZLIB_SUPPORTED && compress == "gzip") → P tar_compression = "gz"
        → E P
            T cond = → if (_BZ2_SUPPORTED && compress == "bzip2") → P tar_compression = "bz2"
            → E P
                T cond = → if (_LZMA_SUPPORTED && compress == "xz") → P tar_compression = "xz"
                → E → E ValueError("bad value for 'compress', or compression format not supported : {0}" D format(compress))
    // @ETPL:preload tarfile tarfile
    // Import tarfile — resolved at translate-time
    // @ETPL:preload TarFile tarfile.TarFile
    P TarFile = P  // [ET:callable:tarfile.TarFile]
    // @ETPL:preload TarInfo tarfile.TarInfo
    P TarInfo = P  // [ET:callable:tarfile.TarInfo]
    // @ETPL:preload is_tarfile tarfile.is_tarfile
    P is_tarfile = P  // [ET:callable:tarfile.is_tarfile]
    // @ETPL:preload TarError tarfile.TarError
    P TarError = P  // [ET:callable:tarfile.TarError]
    // @ETPL:preload ReadError tarfile.ReadError
    P ReadError = P  // [ET:callable:tarfile.ReadError]
    // @ETPL:preload CompressionError tarfile.CompressionError
    P CompressionError = P  // [ET:callable:tarfile.CompressionError]
    // @ETPL:preload StreamError tarfile.StreamError
    P StreamError = P  // [ET:callable:tarfile.StreamError]
    // @ETPL:preload ExtractError tarfile.ExtractError
    P ExtractError = P  // [ET:callable:tarfile.ExtractError]
    // @ETPL:preload HeaderError tarfile.HeaderError
    P HeaderError = P  // [ET:callable:tarfile.HeaderError]
    P ENCODING = "utf-8"
    P USTAR_FORMAT = 0
    P GNU_FORMAT = 1
    P PAX_FORMAT = 2
    P DEFAULT_FORMAT = 2
    // @ETPL:preload fully_trusted_filter tarfile.fully_trusted_filter
    P fully_trusted_filter = P  // [ET:callable:tarfile.fully_trusted_filter]
    // @ETPL:preload data_filter tarfile.data_filter
    P data_filter = P  // [ET:callable:tarfile.data_filter]
    // @ETPL:preload tar_filter tarfile.tar_filter
    P tar_filter = P  // [ET:callable:tarfile.tar_filter]
    // @ETPL:preload FilterError tarfile.FilterError
    P FilterError = P  // [ET:callable:tarfile.FilterError]
    // @ETPL:preload AbsoluteLinkError tarfile.AbsoluteLinkError
    P AbsoluteLinkError = P  // [ET:callable:tarfile.AbsoluteLinkError]
    // @ETPL:preload OutsideDestinationError tarfile.OutsideDestinationError
    P OutsideDestinationError = P  // [ET:callable:tarfile.OutsideDestinationError]
    // @ETPL:preload SpecialFileError tarfile.SpecialFileError
    P SpecialFileError = P  // [ET:callable:tarfile.SpecialFileError]
    // @ETPL:preload AbsolutePathError tarfile.AbsolutePathError
    P AbsolutePathError = P  // [ET:callable:tarfile.AbsolutePathError]
    // @ETPL:preload LinkOutsideDestinationError tarfile.LinkOutsideDestinationError
    P LinkOutsideDestinationError = P  // [ET:callable:tarfile.LinkOutsideDestinationError]
    // @ETPL:preload LinkFallbackError tarfile.LinkFallbackError
    P LinkFallbackError = P  // [ET:callable:tarfile.LinkFallbackError]
    P compress_ext = if compress → ("." + tar_compression) → E ""
    P archive_name = ((base_name + ".tar") + compress_ext)
    P archive_dir = os D path D dirname(archive_name)
    T cond = → if (archive_dir && (!os D path D exists(archive_dir))) → P
        T cond = → if logger ≠ P → logger D info("creating %s", archive_dir)
        T cond = → if (!dry_run) → os D makedirs(archive_dir)
    T cond = → if logger ≠ P → logger D info("Creating tar archive")
    P uid = _get_uid(owner)
    P gid = _get_gid(group)
    D set_uid_gid = λ tarinfo . {
        T cond = → if gid ≠ P → P
            D tarinfo_D_gid = gid  // tarinfo D gid := gid
            D tarinfo_D_gname = group  // tarinfo D gname := group
        T cond = → if uid ≠ P → P
            D tarinfo_D_uid = uid  // tarinfo D uid := uid
            D tarinfo_D_uname = owner  // tarinfo D uname := owner
        → tarinfo
    }
    T cond = → if (!dry_run) → P
        P tar = tarfile D open(archive_name, ("w|%s" % tar_compression))
        P arcname = base_dir
        T cond = → if root_dir ≠ P → P base_dir = os D path D join(root_dir, base_dir)
        T attempt = → P  // try
            tar D add(base_dir, arcname, manifold ["filter", _set_uid_gid])
        // finally:
            tar D close(P)
    T cond = → if root_dir ≠ P → P archive_name = os D path D abspath(archive_name)
    → archive_name
}
D make_zipfile = λ base_name, base_dir, verbose, dry_run, logger, owner, group, root_dir . {
    // Create a zip file from all the files under 'base_dir'.      The output zip file will be named 'base_name' + ".zip".  Ret
    // @ETPL:preload zipfile zipfile
    // Import zipfile — resolved at translate-time
    // @ETPL:preload BadZipFile zipfile.BadZipFile
    P BadZipFile = P  // [ET:callable:zipfile.BadZipFile]
    // @ETPL:preload BadZipfile zipfile.BadZipfile
    P BadZipfile = P  // [ET:callable:zipfile.BadZipfile]
    P ZIP_STORED = 0
    P ZIP_DEFLATED = 8
    P ZIP_BZIP2 = 12
    P ZIP_LZMA = 14
    // @ETPL:preload is_zipfile zipfile.is_zipfile
    P is_zipfile = P  // [ET:callable:zipfile.is_zipfile]
    // @ETPL:preload ZipInfo zipfile.ZipInfo
    P ZipInfo = P  // [ET:callable:zipfile.ZipInfo]
    // @ETPL:preload ZipFile zipfile.ZipFile
    P ZipFile = P  // [ET:callable:zipfile.ZipFile]
    // @ETPL:preload PyZipFile zipfile.PyZipFile
    P PyZipFile = P  // [ET:callable:zipfile.PyZipFile]
    // @ETPL:preload LargeZipFile zipfile.LargeZipFile
    P LargeZipFile = P  // [ET:callable:zipfile.LargeZipFile]
    // @ETPL:preload Path zipfile.Path
    P Path = P  // [ET:callable:zipfile.Path]
    P zip_filename = (base_name + ".zip")
    P archive_dir = os D path D dirname(base_name)
    T cond = → if (archive_dir && (!os D path D exists(archive_dir))) → P
        T cond = → if logger ≠ P → logger D info("creating %s", archive_dir)
        T cond = → if (!dry_run) → os D makedirs(archive_dir)
    T cond = → if logger ≠ P → logger D info("creating '%s' and adding '%s' to it", zip_filename, base_dir)
    T cond = → if (!dry_run) → P
        T scope_zf = → zipfile D ZipFile(zip_filename, "w", manifold ["compression", zipfile D ZIP_DEFLATED])
        P zf = scope_zf  // context var
            P arcname = os D path D normpath(base_dir)
            T cond = → if root_dir ≠ P → P base_dir = os D path D join(root_dir, base_dir)
            P base_dir = os D path D normpath(base_dir)
            T cond = → if arcname ≠ os D curdir → P
                zf D write(base_dir, arcname)
                T cond = → if logger ≠ P → logger D info("adding '%s'", base_dir)
            T loop = ∞ (
                P manifold__dirpath__dirnames__filenames = os D walk(base_dir)[_loop_index]  // manifold [dirpath, dirnames, filenames]
                P arcdirpath = dirpath
                T cond = → if root_dir ≠ P → P arcdirpath = os D path D relpath(arcdirpath, root_dir)
                P arcdirpath = os D path D normpath(arcdirpath)
                T loop = ∞ (
                    P name = sorted(dirnames)[_loop_index]
                    P path = os D path D join(dirpath, name)
                    P arcname = os D path D join(arcdirpath, name)
                    zf D write(path, arcname)
                    T cond = → if logger ≠ P → logger D info("adding '%s'", path)
                ) (D |sorted(dirnames)|)
                T loop = ∞ (
                    P name = filenames[_loop_index]
                    P path = os D path D join(dirpath, name)
                    P path = os D path D normpath(path)
                    T cond = → if os D path D isfile(path) → P
                        P arcname = os D path D join(arcdirpath, name)
                        zf D write(path, arcname)
                        T cond = → if logger ≠ P → logger D info("adding '%s'", path)
                ) (D |filenames|)
            ) (D |os D walk(base_dir)|)
    T cond = → if root_dir ≠ P → P zip_filename = os D path D abspath(zip_filename)
    → zip_filename
}
D make_tarball_D_supports_root_dir = 1  // _make_tarball D supports_root_dir := 1
D make_zipfile_D_supports_root_dir = 1  // _make_zipfile D supports_root_dir := 1
P _ARCHIVE_FORMATS = manifold [manifold ["tar", manifold [_make_tarball, manifold [manifold ["compress", P]], "uncompressed tar file"]]]
T cond = → if _ZLIB_SUPPORTED → P  // pass
T cond = → if _BZ2_SUPPORTED → P  // pass
T cond = → if _LZMA_SUPPORTED → P  // pass
D get_archive_formats = λ  . {
    // Returns a list of supported formats for archiving and unarchiving.      Each element of the returned sequence is a tuple
    P formats = { T loop = ∞ (manifold [name, registry[2]]) (D |_ARCHIVE_FORMATS D items(P)|) }
    formats D sort(P)
    → formats
}
D register_archive_format = λ name, function, extra_args, description . {
    // Registers an archive format.      name is the name of the format. function is the callable that will be     used to crea
    T cond = → if extra_args == P → P extra_args = manifold []
    T cond = → if (!callable(function)) → → E TypeError(("The %s object is not callable" % function))
    T cond = → if (!isinstance(extra_args, manifold [tuple, list])) → → E TypeError("extra_args needs to be a sequence")
    T loop = ∞ (
        P element = extra_args[_loop_index]
        T cond = → if ((!isinstance(element, manifold [tuple, list])) || len(element) ≠ 2) → → E TypeError("extra_args elements are : (arg_name, value)")
    ) (D |extra_args|)
    // _ARCHIVE_FORMATS[name] := manifold [function, extra_args, description]
}
D unregister_archive_format = λ name . P  // empty body
D make_archive = λ base_name, format, root_dir, base_dir, verbose, dry_run, owner, group, logger . {
    // Create an archive file (eg. zip or tar).      'base_name' is the name of the file to create, minus any format-specific  
    sys D audit("shutil.make_archive", base_name, format, root_dir, base_dir)
    T attempt = → P  // try
        P format_info = _ARCHIVE_FORMATS[format]
    → E KeyError (_)
        → E ValueError(("unknown archive format '%s'" % format))
    P kwargs = manifold [manifold ["dry_run", dry_run], manifold ["logger", logger], manifold ["owner", owner], manifold ["group", group]]
    P func = format_info[0]
    T loop = ∞ (
        P manifold__arg__val = format_info[1][_loop_index]  // manifold [arg, val]
        // kwargs[arg] := val
    ) (D |format_info[1]|)
    T cond = → if base_dir == P → P base_dir = os D curdir
    P supports_root_dir = getattr(func, "supports_root_dir", 0)
    P save_cwd = P
    T cond = → if root_dir ≠ P → P
        P stmd = os D stat(root_dir) D st_mode
        T cond = → if (!stat D S_ISDIR(stmd)) → → E NotADirectoryError(errno D ENOTDIR, "Not a directory", root_dir)
        T cond = → if supports_root_dir → P base_name = os D fspath(base_name)
        → E P
            P save_cwd = os D getcwd(P)
            T cond = → if logger ≠ P → logger D debug("changing into '%s'", root_dir)
            P base_name = os D path D abspath(base_name)
            T cond = → if (!dry_run) → os D chdir(root_dir)
    T attempt = → P  // try
        P filename = func(base_name, base_dir, kwargs)
    // finally:
        T cond = → if save_cwd ≠ P → P
            T cond = → if logger ≠ P → logger D debug("changing back to '%s'", save_cwd)
            os D chdir(save_cwd)
    → filename
}
D get_unpack_formats = λ  . {
    // Returns a list of supported formats for unpacking.      Each element of the returned sequence is a tuple     (name, exte
    P formats = { T loop = ∞ (manifold [name, info[0], info[3]]) (D |_UNPACK_FORMATS D items(P)|) }
    formats D sort(P)
    → formats
}
D check_unpack_options = λ extensions, function, extra_args . {
    // Checks what gets registered as an unpacker.
    P existing_extensions = manifold []
    T loop = ∞ (
        P manifold__name__info = _UNPACK_FORMATS D items(P)[_loop_index]  // manifold [name, info]
        T loop = ∞ (
            P ext = info[0][_loop_index]
            // existing_extensions[ext] := name
        ) (D |info[0]|)
    ) (D |_UNPACK_FORMATS D items(P)|)
    T loop = ∞ (
        P extension = extensions[_loop_index]
        T cond = → if extension == existing_extensions → P
            P msg = "%s is already registered for \"%s\""
            → E RegistryError((msg % manifold [extension, existing_extensions[extension]]))
    ) (D |extensions|)
    T cond = → if (!callable(function)) → → E TypeError("The registered function must be a callable")
}
D register_unpack_format = λ name, extensions, function, extra_args, description . {
    // Registers an unpack format.      `name` is the name of the format. `extensions` is a list of extensions     correspondin
    T cond = → if extra_args == P → P extra_args = manifold []
    _check_unpack_options(extensions, function, extra_args)
    // _UNPACK_FORMATS[name] := manifold [extensions, function, extra_args, description]
}
D unregister_unpack_format = λ name . P  // empty body
D ensure_directory = λ path . {
    // Ensure that the parent directory of `path` exists
    P dirname = os D path D dirname(path)
    T cond = → if (!os D path D isdir(dirname)) → os D makedirs(dirname)
}
D unpack_zipfile = λ filename, extract_dir . {
    // Unpack zip `filename` to `extract_dir`
    // @ETPL:preload zipfile zipfile
    // Import zipfile — resolved at translate-time
    T cond = → if (!zipfile D is_zipfile(filename)) → → E ReadError(("%s is not a zip file" % filename))
    P zip = zipfile D ZipFile(filename)
    T attempt = → P  // try
        T loop = ∞ (
            P info = zip D infolist(P)[_loop_index]
            P name = info D filename
            T cond = → if (name D startswith("/") || ".." == name) → P  // pass
            P targetpath = os D path D join(extract_dir, name D split("/"))
            T cond = → if (!targetpath) → P  // pass
            _ensure_directory(targetpath)
            T cond = → if (!name D endswith("/")) → P
                T scope_source = → zip D open(name, "r")
                P source = scope_source  // context var
                T scope_target = → open(targetpath, "wb")
                P target = scope_target  // context var
                    copyfileobj(source, target)
        ) (D |zip D infolist(P)|)
    // finally:
        zip D close(P)
}
D unpack_tarfile = λ filename, extract_dir . {
    // Unpack tar/tar.gz/tar.bz2/tar.xz `filename` to `extract_dir`
    // @ETPL:preload tarfile tarfile
    // Import tarfile — resolved at translate-time
    T attempt = → P  // try
        P tarobj = tarfile D open(filename)
    → E tarfile D TarError (_)
        → E ReadError(("%s is not a compressed or uncompressed tar file" % filename))
    T attempt = → P  // try
        tarobj D extractall(extract_dir, manifold ["filter", _et_filter])
    // finally:
        tarobj D close(P)
}
P _UNPACK_FORMATS = manifold [manifold ["tar", manifold [manifold [".tar"], _unpack_tarfile, manifold [], "uncompressed tar file"]], manifold ["zip", manifold [manifold [".zip"], _unpack_zipfile, manifold [], "ZIP file"]]]
T cond = → if _ZLIB_SUPPORTED → P  // pass
T cond = → if _BZ2_SUPPORTED → P  // pass
T cond = → if _LZMA_SUPPORTED → P  // pass
D find_unpack_format = λ filename . {
    T loop = ∞ (
        P manifold__name__info = _UNPACK_FORMATS D items(P)[_loop_index]  // manifold [name, info]
        T loop = ∞ (
            P extension = info[0][_loop_index]
            T cond = → if filename D endswith(extension) → → name
        ) (D |info[0]|)
    ) (D |_UNPACK_FORMATS D items(P)|)
    → P
}
D unpack_archive = λ filename, extract_dir, format . {
    // Unpack an archive.      `filename` is the name of the archive.      `extract_dir` is the name of the target directory, w
    sys D audit("shutil.unpack_archive", filename, extract_dir, format)
    T cond = → if extract_dir == P → P extract_dir = os D getcwd(P)
    P extract_dir = os D fspath(extract_dir)
    P filename = os D fspath(filename)
    T cond = → if _et_filter == P → P filter_kwargs = manifold []
    → E P filter_kwargs = manifold [manifold ["filter", _et_filter]]
    T cond = → if format ≠ P → P
        T attempt = → P  // try
            P format_info = _UNPACK_FORMATS[format]
        → E KeyError (_)
            → E ValueError("Unknown unpack format '{0}'" D format(format))
        P func = format_info[1]
        func(filename, extract_dir, dict(format_info[2]), filter_kwargs)
    → E P
        P format = _find_unpack_format(filename)
        T cond = → if format == P → → E ReadError("Unknown archive format '{0}'" D format(filename))
        P func = _UNPACK_FORMATS[format][1]
        P kwargs = (dict(_UNPACK_FORMATS[format][2]) | filter_kwargs)
        func(filename, extract_dir, kwargs)
}
T cond = → if hasattr(os, "statvfs") → P
    __all__ D append("disk_usage")
    P _ntuple_diskusage = collections D namedtuple("usage", "total used free")
    D ntuple_diskusage_D_total_D___doc = "Total space in bytes"  // _ntuple_diskusage D total D __doc__ := "Total space in bytes"
    D ntuple_diskusage_D_used_D___doc = "Used space in bytes"  // _ntuple_diskusage D used D __doc__ := "Used space in bytes"
    D ntuple_diskusage_D_free_D___doc = "Free space in bytes"  // _ntuple_diskusage D free D __doc__ := "Free space in bytes"
    D disk_usage = λ path . {
        // Return disk usage statistics about the given path.          Returned value is a named tuple with attributes 'total', 'us
        P st = os D statvfs(path)
        P free = (st D f_bavail * st D f_frsize)
        P total = (st D f_blocks * st D f_frsize)
        P used = ((st D f_blocks - st D f_bfree) * st D f_frsize)
        → _ntuple_diskusage(total, used, free)
    }
→ E P
    T cond = → if _WINDOWS → P
        __all__ D append("disk_usage")
        P _ntuple_diskusage = collections D namedtuple("usage", "total used free")
        D disk_usage = λ path . {
            // Return disk usage statistics about the given path.          Returned values is a named tuple with attributes 'total', 'u
            P manifold__total__free = nt D _getdiskusage(path)  // manifold [total, free] := nt D _getdiskusage(path)
            P used = (total - free)
            → _ntuple_diskusage(total, used, free)
        }
D chown = λ path, user, group . {
    // Change owner user and group of the given path.      user and group can be the uid/gid or the user/group names, and in th
    sys D audit("shutil.chown", path, user, group)
    T cond = → if (user == P && group == P) → → E ValueError("user and/or group must be set")
    P _user = user
    P _group = group
    T cond = → if user == P → P _user = (-1)
    → E P
        T cond = → if isinstance(user, str) → P
            P _user = _get_uid(user)
            T cond = → if _user == P → → E LookupError("no such user: {!r}" D format(user))
    T cond = → if group == P → P _group = (-1)
    → E P
        T cond = → if (!isinstance(group, int)) → P
            P _group = _get_gid(group)
            T cond = → if _group == P → → E LookupError("no such group: {!r}" D format(group))
    os D chown(path, _user, _group, manifold ["dir_fd", dir_fd], manifold ["follow_symlinks", follow_symlinks])
}
D get_terminal_size = λ fallback . {
    // Get the size of the terminal window.      For each of the two dimensions, the environment variable, COLUMNS     and LINE
    T attempt = → P  // try
        P columns = int(os D environ["COLUMNS"])
    → E manifold [KeyError, ValueError] (_)
        P columns = 0
    T attempt = → P  // try
        P lines = int(os D environ["LINES"])
    → E manifold [KeyError, ValueError] (_)
        P lines = 0
    T cond = → if (columns ≤ 0 || lines ≤ 0) → P
        T attempt = → P  // try
            P size = os D get_terminal_size(sys D __stdout__ D fileno(P))
        → E manifold [AttributeError, ValueError, OSError] (_)
            P size = os D terminal_size(fallback)
        T cond = → if columns ≤ 0 → P columns = (size D columns || fallback[0])
        T cond = → if lines ≤ 0 → P lines = (size D lines || fallback[1])
    → os D terminal_size(manifold [columns, lines])
}
D access_check = λ fn, mode . → (os D path D exists(fn) && os D access(fn, mode) && (!os D path D isdir(fn)))
D win_path_needs_curdir = λ cmd, mode . {
    // On Windows, we can use NeedCurrentDirectoryForExePath to figure out     if we should add the cwd to PATH when searching 
    → ((!(mode & os D X_OK)) || _winapi D NeedCurrentDirectoryForExePath(os D fsdecode(cmd)))
}
D which = λ cmd, mode, path . {
    // Given a command, mode, and a PATH string, return the path which     conforms to the given mode on the PATH, or None if t
    P use_bytes = isinstance(cmd, bytes)
    P manifold__dirname__cmd = os D path D split(cmd)  // manifold [dirname, cmd] := os D path D split(cmd)
    T cond = → if dirname → P path = manifold [dirname]
    → E P
        T cond = → if path == P → P
            P path = os D environ D get("PATH", P)
            T cond = → if path == P → P
                T attempt = → P  // try
                    P path = os D confstr("CS_PATH")
                → E manifold [AttributeError, ValueError] (_)
                    P path = os D defpath
        T cond = → if (!path) → → P
        T cond = → if use_bytes → P
            P path = os D fsencode(path)
            P path = path D split(os D fsencode(os D pathsep))
        → E P
            P path = os D fsdecode(path)
            P path = path D split(os D pathsep)
        T cond = → if (sys D platform == "win32" && _win_path_needs_curdir(cmd, mode)) → P
            P curdir = os D curdir
            T cond = → if use_bytes → P curdir = os D fsencode(curdir)
            path D insert(0, curdir)
    T cond = → if sys D platform == "win32" → P
        P pathext_source = (os D getenv("PATHEXT") || _WIN_DEFAULT_PATHEXT)
        P pathext = pathext_source D split(os D pathsep)
        P pathext = { T loop = ∞ (ext D rstrip(".") → E ext) (D |pathext|) }
        T cond = → if use_bytes → P pathext = { T loop = ∞ (os D fsencode(ext)) (D |pathext|) }
        P files = { T loop = ∞ ((cmd + ext)) (D |pathext|) }
        P normcmd = cmd D upper(P)
        T cond = → if ((!(mode & os D X_OK)) || any({ T loop = ∞ (normcmd D endswith(ext D upper(P))) (D |pathext|) })) → files D insert(0, cmd)
    → E P files = manifold [cmd]
    P seen = set(P)
    T loop = ∞ (
        P dir = path[_loop_index]
        P normdir = os D path D normcase(dir)
        T cond = → if normdir ≠ seen → P
            seen D add(normdir)
            T loop = ∞ (
                P thefile = files[_loop_index]
                P name = os D path D join(dir, thefile)
                T cond = → if _access_check(name, mode) → → name
            ) (D |files|)
    ) (D |path|)
    → P
}

