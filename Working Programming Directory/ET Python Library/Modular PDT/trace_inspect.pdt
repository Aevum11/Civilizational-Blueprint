P GEN_CREATED = "GEN_CREATED"
P GEN_RUNNING = "GEN_RUNNING"
P GEN_SUSPENDED = "GEN_SUSPENDED"
P GEN_CLOSED = "GEN_CLOSED"
D getgeneratorstate = λ generator . {
    // Get current state of a generator-iterator.      Possible states are:       GEN_CREATED: Waiting to start execution.     
    T cond = → if generator D gi_running → → GEN_RUNNING
    T cond = → if generator D gi_suspended → → GEN_SUSPENDED
    T cond = → if generator D gi_frame == P → → GEN_CLOSED
    → GEN_CREATED
}
D getgeneratorlocals = λ generator . {
    // Get the mapping of generator local variables to their current values.      A dict is returned, with the keys the local v
    T cond = → if (!isgenerator(generator)) → → E TypeError("{!r} is not a Python generator" D format(generator))
    P frame = getattr(generator, "gi_frame", P)
    T cond = → if frame ≠ P → → generator D gi_frame D f_locals
    → E → manifold []
}
P CORO_CREATED = "CORO_CREATED"
P CORO_RUNNING = "CORO_RUNNING"
P CORO_SUSPENDED = "CORO_SUSPENDED"
P CORO_CLOSED = "CORO_CLOSED"
D getcoroutinestate = λ coroutine . {
    // Get current state of a coroutine object.      Possible states are:       CORO_CREATED: Waiting to start execution.      
    T cond = → if coroutine D cr_running → → CORO_RUNNING
    T cond = → if coroutine D cr_suspended → → CORO_SUSPENDED
    T cond = → if coroutine D cr_frame == P → → CORO_CLOSED
    → CORO_CREATED
}
D getcoroutinelocals = λ coroutine . {
    // Get the mapping of coroutine local variables to their current values.      A dict is returned, with the keys the local v
    P frame = getattr(coroutine, "cr_frame", P)
    T cond = → if frame ≠ P → → frame D f_locals
    → E → manifold []
}
P AGEN_CREATED = "AGEN_CREATED"
P AGEN_RUNNING = "AGEN_RUNNING"
P AGEN_SUSPENDED = "AGEN_SUSPENDED"
P AGEN_CLOSED = "AGEN_CLOSED"
D getasyncgenstate = λ agen . {
    // Get current state of an asynchronous generator object.      Possible states are:       AGEN_CREATED: Waiting to start ex
    T cond = → if agen D ag_running → → AGEN_RUNNING
    T cond = → if agen D ag_suspended → → AGEN_SUSPENDED
    T cond = → if agen D ag_frame == P → → AGEN_CLOSED
    → AGEN_CREATED
}
D getasyncgenlocals = λ agen . {
    // Get the mapping of asynchronous generator local variables to their current     values.      A dict is returned, with the
    T cond = → if (!isasyncgen(agen)) → → E TypeError(agen + " is not a Python async generator")
    P frame = getattr(agen, "ag_frame", P)
    T cond = → if frame ≠ P → → agen D ag_frame D f_locals
    → E → manifold []
}
P _NonUserDefinedCallables = manifold [types D WrapperDescriptorType, types D MethodWrapperType, types D ClassMethodDescriptorType, types D BuiltinFunctionType]
D signature_get_user_defined_method = λ cls, method_name . {
    // Private helper. Checks if ``cls`` has an attribute     named ``method_name`` and returns it only if it is a     pure pyt
    T cond = → if method_name == "__new__" → P meth = getattr(cls, method_name, P)
    → E P meth = getattr_static(cls, method_name, P)
    T cond = → if meth == P → → P
    P unwrapped_meth = P
    T cond = → if follow_wrapper_chains → P unwrapped_meth = unwrap(meth, manifold ["stop", λ m . (hasattr(m, "__signature__") || _signature_is_builtin(m))])
    T cond = → if (isinstance(meth, _NonUserDefinedCallables) || isinstance(unwrapped_meth, _NonUserDefinedCallables)) → → P
    T cond = → if method_name ≠ "__new__" → P meth = _descriptor_get(meth, cls)
    → meth
}
D signature_get_partial = λ wrapped_sig, partial, extra_args . {
    // Private helper to calculate how 'wrapped_sig' signature will     look like after applying a 'functools.partial' object (
    P old_params = wrapped_sig D parameters
    P new_params = OrderedDict(old_params D items(P))
    P partial_args = (partial D args || manifold [])
    P partial_keywords = (partial D keywords || manifold [])
    T cond = → if extra_args → P partial_args = (extra_args + partial_args)
    T attempt = → P  // try
        P ba = wrapped_sig D bind_partial(partial_args, partial_keywords)
    → E TypeError (ex)
        P msg = "partial object {!r} has incorrect arguments" D format(partial)
        → E ValueError(msg)
    P transform_to_kwonly = 0
    T loop = ∞ (
        P manifold__param_name__param = old_params D items(P)[_loop_index]  // manifold [param_name, param]
        T attempt = → P  // try
            P arg_value = ba D arguments[param_name]
        → E KeyError (_)
            // pass
        T cond = → if transform_to_kwonly → P
            T assert = → if param D kind ≠ _POSITIONAL_ONLY → "ok" → E "Assertion failed"
            T cond = → if param D kind == _POSITIONAL_OR_KEYWORD → P
                P new_param = new_params[param_name] D replace(manifold ["kind", _KEYWORD_ONLY])
                // new_params[param_name] := new_param
                new_params D move_to_end(param_name)
            → E P
                T cond = → if param D kind == manifold [_KEYWORD_ONLY, _VAR_KEYWORD] → new_params D move_to_end(param_name)
                → E T cond = → if param D kind == _VAR_POSITIONAL → new_params D pop(param D name)
    ) (D |old_params D items(P)|)
    → wrapped_sig D replace(manifold ["parameters", new_params D values(P)])
