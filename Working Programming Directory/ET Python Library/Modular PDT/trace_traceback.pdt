D walk_stack = λ f . {
    // Walk a stack yielding the frame and line number for each frame.      This will follow f.f_back from the given frame. If 
    T cond = → if f == P → P f = sys D _getframe(P) D f_back D f_back D f_back D f_back
    T while_loop = ∞ (
        T check = → if f ≠ P → P  // while body follows
            → manifold [f, f D f_lineno]
            P f = f D f_back
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D walk_tb = λ tb . {
    // Walk a traceback yielding the frame and line number for each frame.      This will follow tb.tb_next (and thus is in the
    T while_loop = ∞ (
        T check = → if tb ≠ P → P  // while body follows
            → manifold [tb D tb_frame, tb D tb_lineno]
            P tb = tb D tb_next
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
}
D walk_tb_with_full_positions = λ tb . {
    T while_loop = ∞ (
        T check = → if tb ≠ P → P  // while body follows
            P positions = _get_code_position(tb D tb_frame D f_code, tb D tb_lasti)
            T cond = → if positions[0] == P → → manifold [tb D tb_frame, (manifold [tb D tb_lineno] + positions[1:Ω])]
            → E → manifold [tb D tb_frame, positions]
            P tb = tb D tb_next
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
