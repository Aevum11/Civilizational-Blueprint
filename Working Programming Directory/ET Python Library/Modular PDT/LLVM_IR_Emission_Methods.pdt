    L("  %num_buf = call i8* @malloc(i64 %num_alloc)")
    L("  %num_src = getelementptr i8, i8* %src, i64 %num_start")
    L("  call i8* @memcpy(i8* %num_buf, i8* %num_src, i64 %num_len)")
    L("  %num_term = getelementptr i8, i8* %num_buf, i64 %num_len")
