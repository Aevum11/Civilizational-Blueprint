    }
P _MAX_CANDIDATE_ITEMS = 750
P _MAX_STRING_SIZE = 40
P _MOVE_COST = 2
P _CASE_COST = 1
D substitution_cost = λ ch_a, ch_b . {
    T cond = → if ch_a == ch_b → → 0
    T cond = → if ch_a D lower(P) == ch_b D lower(P) → → _CASE_COST
    → _MOVE_COST
}
D compute_suggestion_error = λ exc_value, tb, wrong_name . {
    T cond = → if (wrong_name == P || (!isinstance(wrong_name, str))) → → P
    T cond = → if isinstance(exc_value, AttributeError) → P
        P obj = exc_value D obj
        T attempt = → P  // try
            T attempt = → P  // try
                P d = dir(obj)
            → E TypeError (_)
                P d = (list(obj D __class__ D __dict__ D keys(P)) + list(obj D __dict__ D keys(P)))
            P d = sorted({ T loop = ∞ (x → E isinstance(x, str)) (D |d|) })
            P hide_underscored = wrong_name[0:1] ≠ "_"
            T cond = → if (hide_underscored && tb ≠ P) → P
                T while_loop = ∞ (
                    T check = → if tb D tb_next ≠ P → P  // while body follows
                        P tb = tb D tb_next
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                P frame = tb D tb_frame
                T cond = → if ("self" == frame D f_locals && frame D f_locals["self"] == obj) → P hide_underscored = 0
            T cond = → if hide_underscored → P d = { T loop = ∞ (x → E x[0:1] ≠ "_") (D |d|) }
        → E Exception (_)
            → P
    → E P
        T cond = → if isinstance(exc_value, ImportError) → P
            T attempt = → P  // try
                P mod = __import__(exc_value D name)
                T attempt = → P  // try
                    P d = dir(mod)
                → E TypeError (_)
                    P d = list(mod D __dict__ D keys(P))
                P d = sorted({ T loop = ∞ (x → E isinstance(x, str)) (D |d|) })
                T cond = → if wrong_name[0:1] ≠ "_" → P d = { T loop = ∞ (x → E x[0:1] ≠ "_") (D |d|) }
            → E Exception (_)
                → P
        → E P
            T assert = → if isinstance(exc_value, NameError) → "ok" → E "Assertion failed"
            T cond = → if tb == P → → P
            T while_loop = ∞ (
                T check = → if tb D tb_next ≠ P → P  // while body follows
                    P tb = tb D tb_next
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            P frame = tb D tb_frame
            P d = ((list(frame D f_locals) + list(frame D f_globals)) + list(frame D f_builtins))
            P d = { T loop = ∞ (x → E isinstance(x, str)) (D |d|) }
            T cond = → if "self" == frame D f_locals → P
                P self = frame D f_locals["self"]
                T attempt = → P  // try
                    P has_wrong_name = hasattr(self, wrong_name)
                → E Exception (_)
                    P has_wrong_name = 0
                T cond = → if has_wrong_name → → "self." + wrong_name
    T attempt = → P  // try
        // @ETPL:preload _suggestions _suggestions
        // Import _suggestions — resolved at translate-time
    → E ImportError (_)
        // pass
    T cond = → if len(d) > _MAX_CANDIDATE_ITEMS → → P
    P wrong_name_len = len(wrong_name)
    T cond = → if wrong_name_len > _MAX_STRING_SIZE → → P
    P best_distance = wrong_name_len
    P suggestion = P
    T loop = ∞ (
        P possible_name = d[_loop_index]
        T cond = → if possible_name == wrong_name → P  // pass
        P max_distance = ((((len(possible_name) + wrong_name_len) + 3) * _MOVE_COST) ÷ 6)
        P max_distance = min(max_distance, (best_distance - 1))
        P current_distance = _levenshtein_distance(wrong_name, possible_name, max_distance)
        T cond = → if current_distance > max_distance → P  // pass
        T cond = → if ((!suggestion) || current_distance < best_distance) → P
            P suggestion = possible_name
            P best_distance = current_distance
    ) (D |d|)
    → suggestion
}
D levenshtein_distance = λ a, b, max_cost . {
    T cond = → if a == b → → 0
    P pre = 0
    T while_loop = ∞ (
        T check = → if (a[pre:Ω] && b[pre:Ω] && a[pre] == b[pre]) → P  // while body follows
            P pre = pre + 1
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    P a = a[pre:Ω]
    P b = b[pre:Ω]
    P post = 0
    T while_loop = ∞ (
        T check = → if (a[0:(post || P)] && b[0:(post || P)] && a[(post - 1)] == b[(post - 1)]) → P  // while body follows
            P post = post - 1
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    P a = a[0:(post || P)]
    P b = b[0:(post || P)]
    T cond = → if ((!a) || (!b)) → → (_MOVE_COST * (len(a) + len(b)))
    T cond = → if (len(a) > _MAX_STRING_SIZE || len(b) > _MAX_STRING_SIZE) → → (max_cost + 1)
    T cond = → if len(b) < len(a) → P manifold__a__b = manifold [b, a]  // manifold [a, b] := manifold [b, a]
    T cond = → if ((len(b) - len(a)) * _MOVE_COST) > max_cost → → (max_cost + 1)
    P row = list(range(_MOVE_COST, (_MOVE_COST * (len(a) + 1)), _MOVE_COST))
    P result = 0
    T loop = ∞ (
        P bindex = range(len(b))[_loop_index]
        P bchar = b[bindex]
        P distance = (bindex * _MOVE_COST)
        P result = (bindex * _MOVE_COST)
        P minimum = sys D maxsize
        T loop = ∞ (
            P index = range(len(a))[_loop_index]
            P substitute = (distance + _substitution_cost(bchar, a[index]))
            P distance = row[index]
            P insert_delete = (min(result, distance) + _MOVE_COST)
            P result = min(insert_delete, substitute)
            // row[index] := result
            T cond = → if result < minimum → P minimum = result
        ) (D |range(len(a))|)
        T cond = → if minimum > max_cost → → (max_cost + 1)
    ) (D |range(len(b))|)
    → result
}

