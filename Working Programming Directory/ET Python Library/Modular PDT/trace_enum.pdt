D bin = λ num, max_bits . {
    // Like built-in bin(), except negative values are represented in     twos-compliment, and the leading bit always indicates
    P ceiling = (2 ^ num D bit_length(P))
    T cond = → if num ≥ 0 → P s = bltns D bin((num + ceiling)) D replace("1", "0", 1)
    → E P s = bltns D bin(((-num - 1) ^ ((ceiling - 1) + ceiling)))
