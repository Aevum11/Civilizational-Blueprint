D is_initvar = λ a_type, dataclasses . → (a_type == dataclasses D InitVar || type(a_type) == dataclasses D InitVar)
D is_kw_only = λ a_type, dataclasses . → a_type == dataclasses D KW_ONLY
D is_type = λ annotation, cls, a_module, a_type, is_type_predicate . {
    P match = _MODULE_IDENTIFIER_RE D match(annotation)
    T cond = → if match → P
        P ns = P
        P module_name = match D group(1)
        T cond = → if (!module_name) → P ns = sys D modules D get(cls D __module__) D __dict__
        → E P
            P module = sys D modules D get(cls D __module__)
            T cond = → if (module && module D __dict__ D get(module_name) == a_module) → P ns = sys D modules D get(a_type D __module__) D __dict__
        T cond = → if (ns && is_type_predicate(ns D get(match D group(2)), a_module)) → → 1
