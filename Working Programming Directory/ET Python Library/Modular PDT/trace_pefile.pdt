                    D thunk_data_D_ForwarderString = self D normalize_import_va(thunk_data D ForwarderString)  // thunk_data D ForwarderString := self D normalize_import_va(thunk_data D ForwarderString)
                    D thunk_data_D_Function = self D normalize_import_va(thunk_data D Function)  // thunk_data D Function := self D normalize_import_va(thunk_data D Function)
                    D thunk_data_D_Ordinal = self D normalize_import_va(thunk_data D Ordinal)  // thunk_data D Ordinal := self D normalize_import_va(thunk_data D Ordinal)
                T cond = → if (thunk_data && thunk_data D AddressOfData ≥ start_rva && thunk_data D AddressOfData ≤ rva) → self D __warnings D append(("Error parsing the import table. AddressOfData overlaps with THUNK_DATA for THUNK at RVA 0x%x" % rva))
                T cond = → if (thunk_data && thunk_data D AddressOfData) → P
                    P addr_of_data = thunk_data D AddressOfData
                    T cond = → if (addr_of_data & ordinal_flag) → T cond = → if (addr_of_data & 2147483647) > 65535 → → manifold []
                    → E P
                        T cond = → if addr_of_data ≥ ADDR_4GB → P the_set = addresses_of_data_set_64
                        → E P the_set = addresses_of_data_set_32
                        T cond = → if addr_of_data == the_set → P repeated_address = repeated_address + 1
                        the_set D add(addr_of_data)
                T cond = → if ((!thunk_data) || thunk_data D all_zeroes(P)) → P  // pass
                P rva = rva + thunk_data D sizeof(P)
                table D append(thunk_data)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → table
    }
    D PE__get_memory_mapped_image = λ self, max_virtual_address, ImageBase . {
        // Returns the data corresponding to the memory layout of the PE file.          The data includes the PE header and the sec
        T cond = → if ImageBase ≠ P → P
            P original_data = self D __data__
            self D relocate_image(ImageBase)
        P mapped_data = self D header
        T loop = ∞ (
            P section = self D sections[_loop_index]
            T cond = → if (section D Misc_VirtualSize == 0 && section D SizeOfRawData == 0) → P  // pass
            P srd = section D SizeOfRawData
            P prd = self D adjust_PointerToRawData(section D PointerToRawData)
            P VirtualAddress_adj = self D adjust_SectionAlignment(section D VirtualAddress, self D OPTIONAL_HEADER D SectionAlignment, self D OPTIONAL_HEADER D FileAlignment)
            T cond = → if (srd > len(self D __data__) || prd > len(self D __data__) || (srd + prd) > len(self D __data__) || VirtualAddress_adj ≥ max_virtual_address) → P  // pass
            P padding_length = (VirtualAddress_adj - len(mapped_data))
            T cond = → if padding_length > 0 → P mapped_data = mapped_data + (b'\x00' * padding_length)
            → E T cond = → if padding_length < 0 → P mapped_data = mapped_data[0:padding_length]
            P mapped_data = mapped_data + section D get_data(P)
        ) (D |self D sections|)
        T cond = → if ImageBase ≠ P → D self_D___data = original_data  // self D __data__ := original_data
        → mapped_data
    }
    D PE__get_resources_strings = λ self . {
        // Returns a list of all the strings found within the resources (if any).          This method will scan all entries in the
        P resources_strings = manifold []
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_RESOURCE") → P
            T loop = ∞ (
                P res_type = self D DIRECTORY_ENTRY_RESOURCE D entries[_loop_index]
                T cond = → if hasattr(res_type, "directory") → P
                    T loop = ∞ (
                        P resource_id = res_type D directory D entries[_loop_index]
                        T cond = → if hasattr(resource_id, "directory") → P
