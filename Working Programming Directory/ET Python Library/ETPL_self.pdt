                finfo D append(stringfileinfo_struct)
                T cond = → if (stringfileinfo_string && stringfileinfo_string D startswith(b'StringFileInfo')) → P
                    T cond = → if (stringfileinfo_struct D Type == manifold [0, 1] && stringfileinfo_struct D ValueLength == 0) → P
                        P stringtable_offset = self D dword_align(((stringfileinfo_offset + stringfileinfo_struct D sizeof(P)) + (2 * (len(stringfileinfo_string) + 1))), version_struct D OffsetToData)
                        D stringfileinfo_struct_D_StringTable = manifold []  // stringfileinfo_struct D StringTable := manifold []
                        T while_loop = ∞ (
                            T check = → if 1 → P  // while body follows
                                P stringtable_struct = self D __unpack_data__(self D __StringTable_format__, raw_data[stringtable_offset:Ω], manifold ["file_offset", (start_offset + stringtable_offset)])
                                T cond = → if (!stringtable_struct) → P  // pass
                                P ustr_offset = ((version_struct D OffsetToData + stringtable_offset) + stringtable_struct D sizeof(P))
                                T attempt = → P  // try
                                    P stringtable_string = self D get_string_u_at_rva(ustr_offset)
                                → E PEFormatError (_)
                                    self D __warnings D append("Error parsing the version information, attempting to read StringTable string. Can't read unicode string at offset 0x{0:x}" D format(ustr_offset))
                                    // break
                                D stringtable_struct_D_LangID = stringtable_string  // stringtable_struct D LangID := stringtable_string
                                D stringtable_struct_D_entries = manifold []  // stringtable_struct D entries := manifold []
                                D stringtable_struct_D_entries_offsets = manifold []  // stringtable_struct D entries_offsets := manifold []
                                D stringtable_struct_D_entries_lengths = manifold []  // stringtable_struct D entries_lengths := manifold []
                                stringfileinfo_struct D StringTable D append(stringtable_struct)
