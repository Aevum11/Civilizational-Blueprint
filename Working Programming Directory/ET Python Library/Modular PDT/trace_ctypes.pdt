    → E P
        T cond = → if sizeof(kind) == 4 → P c_int32 = kind
        → E T cond = → if sizeof(kind) == 8 → P c_int64 = kind
) (D |manifold [c_short, c_int, c_long, c_longlong]|)
T loop = ∞ (
    P kind = manifold [c_ushort, c_uint, c_ulong, c_ulonglong][_loop_index]
    T cond = → if sizeof(kind) == 2 → P c_uint16 = kind
    → E P
        T cond = → if sizeof(kind) == 4 → P c_uint32 = kind
        → E T cond = → if sizeof(kind) == 8 → P c_uint64 = kind
) (D |manifold [c_ushort, c_uint, c_ulong, c_ulonglong]|)
// del kind
T cond = → if SIZEOF_TIME_T == 8 → P c_time_t = c_int64
→ E P
    T cond = → if SIZEOF_TIME_T == 4 → P c_time_t = c_int32
    → E → E SystemError("Unexpected sizeof(time_t): SIZEOF_TIME_T=" + SIZEOF_TIME_T)
_reset_cache(P)


