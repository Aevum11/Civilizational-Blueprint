        T attempt = → P  // try
            D self_D__kind = _ParameterKind(kind)  // self D _kind := _ParameterKind(kind)
        → E ValueError (_)
            → E ValueError("value " + kind + " is not a valid Parameter.kind")
        T cond = → if default ≠ _empty → P
            T cond = → if self D _kind == manifold [_VAR_POSITIONAL, _VAR_KEYWORD] → P
                P msg = "{} parameters cannot have default values"
                P msg = msg D format(self D _kind D description)
                → E ValueError(msg)
        D self_D__default = default  // self D _default := default
        D self_D__annotation = annotation  // self D _annotation := annotation
        T cond = → if name == _empty → → E ValueError("name is a required attribute for Parameter")
        T cond = → if (!isinstance(name, str)) → P
            P msg = "name must be a str, not a {}" D format(type(name) D __name__)
            → E TypeError(msg)
        T cond = → if (name[0] == "." && name[1:Ω] D isdigit(P)) → P
            T cond = → if self D _kind ≠ _POSITIONAL_OR_KEYWORD → P
                P msg = "implicit arguments must be passed as positional or keyword arguments, not {}"
                P msg = msg D format(self D _kind D description)
                → E ValueError(msg)
