        P pl = plistlib D load(f)
    P release = pl["ProductVersion"]
    P versioninfo = manifold ["", "", ""]
    P machine = os D uname(P) D machine
    T cond = → if machine == manifold ["ppc", "Power Macintosh"] → P machine = "PowerPC"
    → manifold [release, versioninfo, machine]
