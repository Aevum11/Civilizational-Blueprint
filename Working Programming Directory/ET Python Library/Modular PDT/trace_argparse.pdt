    }
    D ArgumentParser__convert_arg_line_to_args = λ self, arg_line . → manifold [arg_line]
    D ArgumentParser___match_argument = λ self, action, arg_strings_pattern . {
        P nargs_pattern = self D _get_nargs_pattern(action)
        P match = _re D match(nargs_pattern, arg_strings_pattern)
        T cond = → if match == P → P
            P nargs_errors = manifold [manifold [P, _("expected one argument")], manifold [OPTIONAL, _("expected at most one argument")], manifold [ONE_OR_MORE, _("expected at least one argument")]]
            P msg = nargs_errors D get(action D nargs)
            T cond = → if msg == P → P msg = (ngettext("expected %s argument", "expected %s arguments", action D nargs) % action D nargs)
            → E ArgumentError(action, msg)
        → len(match D group(1))
    }
    D ArgumentParser___match_arguments_partial = λ self, actions, arg_strings_pattern . {
        T loop = ∞ (
            P i = range(len(actions), 0, (-1))[_loop_index]
            P actions_slice = actions[0:i]
            P pattern = "" D join({ T loop = ∞ (self D _get_nargs_pattern(action)) (D |actions_slice|) })
            P match = _re D match(pattern, arg_strings_pattern)
            T cond = → if match ≠ P → P
                P result = { T loop = ∞ (len(string)) (D |match D groups(P)|) }
                T cond = → if (match D end(P) < len(arg_strings_pattern) && arg_strings_pattern[match D end(P)] == "O") → P
                    T while_loop = ∞ (
                        T check = → if (result && (!result[(-1)])) → P  // while body follows
                            // del result[-1]
                    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                → result
        ) (D |range(len(actions), 0, (-1))|)
        → manifold []
    }
    D ArgumentParser___parse_optional = λ self, arg_string . {
        T cond = → if (!arg_string) → → P
        T cond = → if (!arg_string[0] == self D prefix_chars) → → P
        T cond = → if arg_string == self D _option_string_actions → P
            P action = self D _option_string_actions[arg_string]
            → manifold [manifold [action, arg_string, P, P]]
        T cond = → if len(arg_string) == 1 → → P
        P manifold__option_string__sep__explicit_arg = arg_string D partition("=")  // manifold [option_string, sep, explicit_arg] := arg_string D partition("=")
        T cond = → if (sep && option_string == self D _option_string_actions) → P
            P action = self D _option_string_actions[option_string]
            → manifold [manifold [action, option_string, sep, explicit_arg]]
        P option_tuples = self D _get_option_tuples(arg_string)
        T cond = → if option_tuples → → option_tuples
        T cond = → if self D _negative_number_matcher D match(arg_string) → T cond = → if (!self D _has_negative_number_optionals) → → P
        T cond = → if " " == arg_string → → P
        → manifold [manifold [P, arg_string, P, P]]
    }
    D ArgumentParser___get_option_tuples = λ self, option_string . {
        P result = manifold []
        P chars = self D prefix_chars
        T cond = → if (option_string[0] == chars && option_string[1] == chars) → P
            T cond = → if self D allow_abbrev → P
                P manifold__option_prefix__sep__explicit_arg = option_string D partition("=")  // manifold [option_prefix, sep, explicit_arg] := option_string D partition("=")
                T cond = → if (!sep) → P
                    P sep = P
                    P explicit_arg = P
                T loop = ∞ (
                    P option_string = self D _option_string_actions[_loop_index]
                    T cond = → if option_string D startswith(option_prefix) → P
                        P action = self D _option_string_actions[option_string]
                        P tup = manifold [action, option_string, sep, explicit_arg]
                        result D append(tup)
                ) (D |self D _option_string_actions|)
        → E P
            T cond = → if (option_string[0] == chars && option_string[1] ≠ chars) → P
                P manifold__option_prefix__sep__explicit_arg = option_string D partition("=")  // manifold [option_prefix, sep, explicit_arg] := option_string D partition("=")
                T cond = → if (!sep) → P
                    P sep = P
                    P explicit_arg = P
                P short_option_prefix = option_string[0:2]
                P short_explicit_arg = option_string[2:Ω]
                T loop = ∞ (
                    P option_string = self D _option_string_actions[_loop_index]
                    T cond = → if option_string == short_option_prefix → P
                        P action = self D _option_string_actions[option_string]
                        P tup = manifold [action, option_string, "", short_explicit_arg]
                        result D append(tup)
                    → E P
                        T cond = → if (self D allow_abbrev && option_string D startswith(option_prefix)) → P
                            P action = self D _option_string_actions[option_string]
                            P tup = manifold [action, option_string, sep, explicit_arg]
                            result D append(tup)
                ) (D |self D _option_string_actions|)
            → E → E ArgumentError(P, (_("unexpected option string: %s") % option_string))
        → result
    }
    D ArgumentParser___get_nargs_pattern = λ self, action . {
        P nargs = action D nargs
        P option = action D option_strings
        T cond = → if nargs == P → P nargs_pattern = if option → "([A])" → E "(-*A-*)"
        → E P
            T cond = → if nargs == OPTIONAL → P nargs_pattern = if option → "(A?)" → E "(-*A?-*)"
            → E P
                T cond = → if nargs == ZERO_OR_MORE → P nargs_pattern = if option → "(A*)" → E "(-*[A-]*)"
                → E P
                    T cond = → if nargs == ONE_OR_MORE → P nargs_pattern = if option → "(A+)" → E "(-*A[A-]*)"
                    → E P
                        T cond = → if nargs == REMAINDER → P nargs_pattern = if option → "([AO]*)" → E "(.*)"
                        → E P
                            T cond = → if nargs == PARSER → P nargs_pattern = if option → "(A[AO]*)" → E "(-*A[-AO]*)"
                            → E P
                                T cond = → if nargs == SUPPRESS → P nargs_pattern = if option → "()" → E "(-*)"
                                → E P nargs_pattern = if option → ("([AO]{%d})" % nargs) → E ("((?:-*A){%d}-*)" % nargs)
        → nargs_pattern
    }
    D ArgumentParser__parse_intermixed_args = λ self, args, namespace . {
        P manifold__args__argv = self D parse_known_intermixed_args(args, namespace)  // manifold [args, argv] := self D parse_known_intermixed_args(args, namespace)
        T cond = → if argv → P
            P msg = (_("unrecognized arguments: %s") % " " D join(argv))
            T cond = → if self D exit_on_error → self D error(msg)
            → E → E ArgumentError(P, msg)
        → args
    }
    D ArgumentParser__parse_known_intermixed_args = λ self, args, namespace . {
        P positionals = self D _get_positional_actions(P)
        P a = { T loop = ∞ (action → E action D nargs == manifold [PARSER, REMAINDER]) (D |positionals|) }
        T cond = → if a → → E TypeError(("parse_intermixed_args: positional arg with nargs=%s" % a[0] D nargs))
        → self D _parse_known_args2(args, namespace, manifold ["intermixed", 1])
    }
    D ArgumentParser___get_values = λ self, action, arg_strings . {
        T cond = → if ((!arg_strings) && action D nargs == OPTIONAL) → P
            T cond = → if action D option_strings → P value = action D const
            → E P value = action D default
            T cond = → if (isinstance(value, str) && value ≠ SUPPRESS) → P
                P value = self D _get_value(action, value)
                self D _check_value(action, value)
        → E P
            T cond = → if ((!arg_strings) && action D nargs == ZERO_OR_MORE && (!action D option_strings)) → P
                T cond = → if action D default ≠ P → P
                    P value = action D default
                    self D _check_value(action, value)
                → E P value = arg_strings
            → E P
                T cond = → if (len(arg_strings) == 1 && action D nargs == manifold [P, OPTIONAL]) → P
                    P manifold__arg_string = arg_strings  // manifold [arg_string] := arg_strings
                    P value = self D _get_value(action, arg_string)
                    self D _check_value(action, value)
                → E P
                    T cond = → if action D nargs == REMAINDER → P value = { T loop = ∞ (self D _get_value(action, v)) (D |arg_strings|) }
                    → E P
                        T cond = → if action D nargs == PARSER → P
                            P value = { T loop = ∞ (self D _get_value(action, v)) (D |arg_strings|) }
                            self D _check_value(action, value[0])
                        → E P
                            T cond = → if action D nargs == SUPPRESS → P value = SUPPRESS
                            → E P
                                P value = { T loop = ∞ (self D _get_value(action, v)) (D |arg_strings|) }
                                T loop = ∞ (
                                    P v = value[_loop_index]
                                    self D _check_value(action, v)
                                ) (D |value|)
        → value
    }
    D ArgumentParser___get_value = λ self, action, arg_string . {
        P type_func = self D _registry_get("type", action D type, action D type)
        T cond = → if (!callable(type_func)) → P
            P msg = _("%r is not callable")
            → E ArgumentError(action, (msg % type_func))
        T attempt = → P  // try
            P result = type_func(arg_string)
        → E ArgumentTypeError (err)
            P msg = str(err)
            → E ArgumentError(action, msg)
        → E manifold [TypeError, ValueError] (_)
            P name = getattr(action D type, "__name__", repr(action D type))
            P args = manifold [manifold ["type", name], manifold ["value", arg_string]]
            P msg = _("invalid %(type)s value: %(value)r")
            → E ArgumentError(action, (msg % args))
        → result
    }
    D ArgumentParser___check_value = λ self, action, value . {
        P choices = action D choices
        T cond = → if choices ≠ P → P
            T cond = → if isinstance(choices, str) → P choices = iter(choices)
            T cond = → if value ≠ choices → P
                P args = manifold [manifold ["value", str(value)], manifold ["choices", ", " D join(_et_map(str, action D choices))]]
                P msg = _("invalid choice: %(value)r (choose from %(choices)s)")
                → E ArgumentError(action, (msg % args))
    }
    D ArgumentParser__format_usage = λ self . {
        P formatter = self D _get_formatter(P)
        formatter D add_usage(self D usage, self D _actions, self D _mutually_exclusive_groups)
        → formatter D format_help(P)
    }
    D ArgumentParser__format_help = λ self . {
        P formatter = self D _get_formatter(P)
        formatter D add_usage(self D usage, self D _actions, self D _mutually_exclusive_groups)
        formatter D add_text(self D description)
        T loop = ∞ (
            P action_group = self D _action_groups[_loop_index]
            formatter D start_section(action_group D title)
            formatter D add_text(action_group D description)
            formatter D add_arguments(action_group D _group_actions)
            formatter D end_section(P)
        ) (D |self D _action_groups|)
        formatter D add_text(self D epilog)
        → formatter D format_help(P)
    }
    D ArgumentParser___get_formatter = λ self . → self D formatter_class(manifold ["prog", self D prog])
    D ArgumentParser__print_usage = λ self, file . {
        T cond = → if file == P → P file = _sys D stdout
        self D _print_message(self D format_usage(P), file)
    }
    D ArgumentParser__print_help = λ self, file . {
        T cond = → if file == P → P file = _sys D stdout
        self D _print_message(self D format_help(P), file)
    }
    D ArgumentParser___print_message = λ self, message, file . {
        T cond = → if message → P
            P file = (file || _sys D stderr)
            T attempt = → P  // try
                file D write(message)
            → E manifold [AttributeError, OSError] (_)
                // pass
    }
    D ArgumentParser__exit = λ self, status, message . {
        T cond = → if message → self D _print_message(message, _sys D stderr)
        _sys D exit(status)
    }
    D ArgumentParser__error = λ self, message . {
        // error(message: string)          Prints a usage message incorporating the message to stderr and         exits.          I
        self D print_usage(_sys D stderr)
        P args = manifold [manifold ["prog", self D prog], manifold ["message", message]]
        self D exit(2, (_("%(prog)s: error: %(message)s\n") % args))
    }
    D ArgumentParser___warning = λ self, message . {
        P args = manifold [manifold ["prog", self D prog], manifold ["message", message]]
        self D _print_message((_("%(prog)s: warning: %(message)s\n") % args), _sys D stderr)
    }

