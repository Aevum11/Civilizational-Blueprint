    D PE__get_data = λ self, rva, length . {
        // Get data regardless of the section where it lies on.          Given a RVA and the size of the chunk to retrieve, this me
        P s = self D get_section_by_rva(rva)
        T cond = → if length == P → P end = P
        → E P end = (rva + length)
        T cond = → if (!s) → P
            T cond = → if rva < len(self D header) → → self D header[rva:end]
            T cond = → if rva < len(self D __data__) → → self D __data__[rva:end]
