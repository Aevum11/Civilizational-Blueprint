                dump D add_newline(P)
            ) (D |self D DIRECTORY_ENTRY_DELAY_IMPORT|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_RESOURCE") → P
            dump D add_header("Resource directory")
            dump D add_lines(self D DIRECTORY_ENTRY_RESOURCE D struct D dump(P))
            T loop = ∞ (
                P res_type = self D DIRECTORY_ENTRY_RESOURCE D entries[_loop_index]
                T cond = → if res_type D name ≠ P → P
                    P name = res_type D name D decode(encoding, "backslashreplace_")
                    dump D add_line("Name: [" + name + "]", 2)
                → E P
                    P res_type_id = RESOURCE_TYPE D get(res_type D struct D Id, "-")
                    dump D add_line("Id: [0x" + res_type D struct D Id + "] (" + res_type_id + ")", 2)
                dump D add_lines(res_type D struct D dump(P), 2)
                T cond = → if hasattr(res_type, "directory") → P
                    dump D add_lines(res_type D directory D struct D dump(P), 4)
                    T loop = ∞ (
                        P resource_id = res_type D directory D entries[_loop_index]
                        T cond = → if resource_id D name ≠ P → P
                            P name = resource_id D name D decode("utf-8", "backslashreplace_")
                            dump D add_line("Name: [" + name + "]", 6)
                        → E dump D add_line("Id: [0x" + resource_id D struct D Id + "]", 6)
                        dump D add_lines(resource_id D struct D dump(P), 6)
                        T cond = → if hasattr(resource_id, "directory") → P
                            dump D add_lines(resource_id D directory D struct D dump(P), 8)
                            T loop = ∞ (
                                P resource_lang = resource_id D directory D entries[_loop_index]
                                T cond = → if hasattr(resource_lang, "data") → P
                                    dump D add_line(("\\--- LANG [%d,%d][%s,%s]" % manifold [resource_lang D data D lang, resource_lang D data D sublang, LANG D get(resource_lang D data D lang, "*unknown*"), get_sublang_name_for_lang(resource_lang D data D lang, resource_lang D data D sublang)]), 8)
                                    dump D add_lines(resource_lang D struct D dump(P), 10)
                                    dump D add_lines(resource_lang D data D struct D dump(P), 12)
                            ) (D |resource_id D directory D entries|)
                            T cond = → if (hasattr(resource_id D directory, "strings") && resource_id D directory D strings) → P
                                dump D add_line("[STRINGS]", 10)
                                T loop = ∞ (
                                    P manifold__idx__res_string = list(sorted(resource_id D directory D strings D items(P)))[_loop_index]  // manifold [idx, res_string]
                                    dump D add_line("{0:6d}: {1}" D format(idx, res_string D encode("unicode-escape", "backslashreplace") D decode("ascii")), 12)
                                ) (D |list(sorted(resource_id D directory D strings D items(P)))|)
                    ) (D |res_type D directory D entries|)
                dump D add_newline(P)
            ) (D |self D DIRECTORY_ENTRY_RESOURCE D entries|)
            dump D add_newline(P)
        T cond = → if (hasattr(self, "DIRECTORY_ENTRY_TLS") && self D DIRECTORY_ENTRY_TLS && self D DIRECTORY_ENTRY_TLS D struct) → P
            dump D add_header("TLS")
            dump D add_lines(self D DIRECTORY_ENTRY_TLS D struct D dump(P))
            dump D add_newline(P)
        T cond = → if (hasattr(self, "DIRECTORY_ENTRY_LOAD_CONFIG") && self D DIRECTORY_ENTRY_LOAD_CONFIG && self D DIRECTORY_ENTRY_LOAD_CONFIG D struct) → P
            dump D add_header("LOAD_CONFIG")
            dump D add_lines(self D DIRECTORY_ENTRY_LOAD_CONFIG D struct D dump(P))
            dump D add_newline(P)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_DEBUG") → P
            dump D add_header("Debug information")
            T loop = ∞ (
                P dbg = self D DIRECTORY_ENTRY_DEBUG[_loop_index]
                dump D add_lines(dbg D struct D dump(P))
                T attempt = → P  // try
                    dump D add_line(("Type: " + DEBUG_TYPE[dbg D struct D Type]))
                → E KeyError (_)
                    dump D add_line("Type: 0x{0:x}(Unknown)" D format(dbg D struct D Type))
                dump D add_newline(P)
                T cond = → if dbg D entry → P
                    dump D add_lines(dbg D entry D dump(P), 4)
                    dump D add_newline(P)
            ) (D |self D DIRECTORY_ENTRY_DEBUG|)
        T cond = → if self D has_relocs(P) → P
            dump D add_header("Base relocations")
            T loop = ∞ (
                P base_reloc = self D DIRECTORY_ENTRY_BASERELOC[_loop_index]
                dump D add_lines(base_reloc D struct D dump(P))
                T loop = ∞ (
                    P reloc = base_reloc D entries[_loop_index]
                    T attempt = → P  // try
                        dump D add_line(("%08Xh %s" % manifold [reloc D rva, RELOCATION_TYPE[reloc D type][16:Ω]]), 4)
                    → E KeyError (_)
                        dump D add_line(("0x%08X 0x%x(Unknown)" % manifold [reloc D rva, reloc D type]), 4)
                ) (D |base_reloc D entries|)
                dump D add_newline(P)
            ) (D |self D DIRECTORY_ENTRY_BASERELOC|)
        T cond = → if (hasattr(self, "DIRECTORY_ENTRY_EXCEPTION") && len(self D DIRECTORY_ENTRY_EXCEPTION) > 0) → P
            dump D add_header("Unwind data for exception handling")
            T loop = ∞ (
                P rf = self D DIRECTORY_ENTRY_EXCEPTION[_loop_index]
                dump D add_lines(rf D struct D dump(P))
                T cond = → if (hasattr(rf, "unwindinfo") && rf D unwindinfo ≠ P) → dump D add_lines(rf D unwindinfo D dump(P), 4)
            ) (D |self D DIRECTORY_ENTRY_EXCEPTION|)
        → dump D get_text(P)
    }
    D PE__dump_dict = λ self . {
        // Dump all the PE header information into a dictionary.
        P dump_dict = manifold []
        P warnings = self D get_warnings(P)
        T cond = → if warnings → P  // pass
        // dump_dict["DOS_HEADER"] := self D DOS_HEADER D dump_dict(P)
        // dump_dict["NT_HEADERS"] := self D NT_HEADERS D dump_dict(P)
        // dump_dict["FILE_HEADER"] := self D FILE_HEADER D dump_dict(P)
        P image_flags = retrieve_flags(IMAGE_CHARACTERISTICS, "IMAGE_FILE_")
        // dump_dict["Flags"] := manifold []
        T loop = ∞ (
            P flag = image_flags[_loop_index]
            T cond = → if getattr(self D FILE_HEADER, flag[0]) → dump_dict["Flags"] D append(flag[0])
        ) (D |image_flags|)
        T cond = → if (hasattr(self, "OPTIONAL_HEADER") && self D OPTIONAL_HEADER ≠ P) → P  // pass
        P dll_characteristics_flags = retrieve_flags(DLL_CHARACTERISTICS, "IMAGE_DLLCHARACTERISTICS_")
        // dump_dict["DllCharacteristics"] := manifold []
        T loop = ∞ (
            P flag = dll_characteristics_flags[_loop_index]
            T cond = → if getattr(self D OPTIONAL_HEADER, flag[0]) → dump_dict["DllCharacteristics"] D append(flag[0])
        ) (D |dll_characteristics_flags|)
        // dump_dict["PE Sections"] := manifold []
        P section_flags = retrieve_flags(SECTION_CHARACTERISTICS, "IMAGE_SCN_")
        T loop = ∞ (
            P section = self D sections[_loop_index]
            P section_dict = section D dump_dict(P)
            dump_dict["PE Sections"] D append(section_dict)
            // section_dict["Flags"] := manifold []
            T loop = ∞ (
                P flag = section_flags[_loop_index]
                T cond = → if getattr(section, flag[0]) → section_dict["Flags"] D append(flag[0])
            ) (D |section_flags|)
            // section_dict["Entropy"] := section D get_entropy(P)
            T cond = → if md5 ≠ P → P  // pass
            T cond = → if sha1 ≠ P → P  // pass
            T cond = → if sha256 ≠ P → P  // pass
            T cond = → if sha512 ≠ P → P  // pass
        ) (D |self D sections|)
        T cond = → if (hasattr(self, "OPTIONAL_HEADER") && hasattr(self D OPTIONAL_HEADER, "DATA_DIRECTORY")) → P
            // dump_dict["Directories"] := manifold []
            T loop = ∞ (
                P manifold__idx__directory = enumerate(self D OPTIONAL_HEADER D DATA_DIRECTORY)[_loop_index]  // manifold [idx, directory]
                T cond = → if directory ≠ P → dump_dict["Directories"] D append(directory D dump_dict(P))
            ) (D |enumerate(self D OPTIONAL_HEADER D DATA_DIRECTORY)|)
        T cond = → if hasattr(self, "VS_VERSIONINFO") → P
            // dump_dict["Version Information"] := manifold []
            T loop = ∞ (
                P manifold__idx__vs_vinfo = enumerate(self D VS_VERSIONINFO)[_loop_index]  // manifold [idx, vs_vinfo]
                P version_info_list = manifold []
                version_info_list D append(vs_vinfo D dump_dict(P))
                T cond = → if hasattr(self, "VS_FIXEDFILEINFO") → version_info_list D append(self D VS_FIXEDFILEINFO[idx] D dump_dict(P))
                T cond = → if (hasattr(self, "FileInfo") && len(self D FileInfo) > idx) → P
                    P fileinfo_list = manifold []
                    version_info_list D append(fileinfo_list)
                    T loop = ∞ (
                        P entry = self D FileInfo[idx][_loop_index]
                        fileinfo_list D append(entry D dump_dict(P))
                        T cond = → if hasattr(entry, "StringTable") → P
                            P stringtable_dict = manifold []
                            T loop = ∞ (
                                P st_entry = entry D StringTable[_loop_index]
                                fileinfo_list D extend(st_entry D dump_dict(P))
                                // stringtable_dict["LangID"] := st_entry D LangID
                                T loop = ∞ (
                                    P str_entry = list(st_entry D entries D items(P))[_loop_index]
                                    // stringtable_dict[str_entry[0]] := str_entry[1]
                                ) (D |list(st_entry D entries D items(P))|)
                            ) (D |entry D StringTable|)
                            fileinfo_list D append(stringtable_dict)
                        → E P
                            T cond = → if hasattr(entry, "Var") → P
                                T loop = ∞ (
                                    P var_entry = entry D Var[_loop_index]
                                    P var_dict = manifold []
                                    T cond = → if hasattr(var_entry, "entry") → P
                                        fileinfo_list D extend(var_entry D dump_dict(P))
                                        // var_dict[list(var_entry D entry D keys(P))[0]] := list(var_entry D entry D values(P))[0]
                                        fileinfo_list D append(var_dict)
                                ) (D |entry D Var|)
                    ) (D |self D FileInfo[idx]|)
                dump_dict["Version Information"] D append(version_info_list)
            ) (D |enumerate(self D VS_VERSIONINFO)|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_EXPORT") → P
            // dump_dict["Exported symbols"] := manifold []
            dump_dict["Exported symbols"] D append(self D DIRECTORY_ENTRY_EXPORT D struct D dump_dict(P))
            T loop = ∞ (
                P export = self D DIRECTORY_ENTRY_EXPORT D symbols[_loop_index]
                P export_dict = manifold []
                T cond = → if export D address ≠ P → P
                    export_dict D update(manifold [manifold ["Ordinal", export D ordinal], manifold ["RVA", export D address], manifold ["Name", export D name]])
                    T cond = → if export D forwarder → P  // pass
                dump_dict["Exported symbols"] D append(export_dict)
            ) (D |self D DIRECTORY_ENTRY_EXPORT D symbols|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_IMPORT") → P
            // dump_dict["Imported symbols"] := manifold []
            T loop = ∞ (
                P module = self D DIRECTORY_ENTRY_IMPORT[_loop_index]
                P import_list = manifold []
                dump_dict["Imported symbols"] D append(import_list)
                import_list D append(module D struct D dump_dict(P))
                T loop = ∞ (
                    P symbol = module D imports[_loop_index]
                    P symbol_dict = manifold []
                    T cond = → if symbol D import_by_ordinal == 1 → P  // pass
                    T cond = → if symbol D bound → P  // pass
                    import_list D append(symbol_dict)
                ) (D |module D imports|)
            ) (D |self D DIRECTORY_ENTRY_IMPORT|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_BOUND_IMPORT") → P
            // dump_dict["Bound imports"] := manifold []
            T loop = ∞ (
                P bound_imp_desc = self D DIRECTORY_ENTRY_BOUND_IMPORT[_loop_index]
                P bound_imp_desc_dict = manifold []
                dump_dict["Bound imports"] D append(bound_imp_desc_dict)
                bound_imp_desc_dict D update(bound_imp_desc D struct D dump_dict(P))
                // bound_imp_desc_dict["DLL"] := bound_imp_desc D name
                T loop = ∞ (
                    P bound_imp_ref = bound_imp_desc D entries[_loop_index]
                    P bound_imp_ref_dict = manifold []
                    bound_imp_ref_dict D update(bound_imp_ref D struct D dump_dict(P))
                    // bound_imp_ref_dict["DLL"] := bound_imp_ref D name
                ) (D |bound_imp_desc D entries|)
            ) (D |self D DIRECTORY_ENTRY_BOUND_IMPORT|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_DELAY_IMPORT") → P
            // dump_dict["Delay Imported symbols"] := manifold []
            T loop = ∞ (
                P module = self D DIRECTORY_ENTRY_DELAY_IMPORT[_loop_index]
                P module_list = manifold []
                dump_dict["Delay Imported symbols"] D append(module_list)
                module_list D append(module D struct D dump_dict(P))
                T loop = ∞ (
                    P symbol = module D imports[_loop_index]
                    P symbol_dict = manifold []
                    T cond = → if symbol D import_by_ordinal == 1 → P  // pass
                    T cond = → if symbol D bound → P  // pass
                    module_list D append(symbol_dict)
                ) (D |module D imports|)
            ) (D |self D DIRECTORY_ENTRY_DELAY_IMPORT|)
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_RESOURCE") → P
            // dump_dict["Resource directory"] := manifold []
            dump_dict["Resource directory"] D append(self D DIRECTORY_ENTRY_RESOURCE D struct D dump_dict(P))
            T loop = ∞ (
                P res_type = self D DIRECTORY_ENTRY_RESOURCE D entries[_loop_index]
                P resource_type_dict = manifold []
                T cond = → if res_type D name ≠ P → P  // pass
                resource_type_dict D update(res_type D struct D dump_dict(P))
                dump_dict["Resource directory"] D append(resource_type_dict)
                T cond = → if hasattr(res_type, "directory") → P
                    P directory_list = manifold []
                    directory_list D append(res_type D directory D struct D dump_dict(P))
                    dump_dict["Resource directory"] D append(directory_list)
                    T loop = ∞ (
                        P resource_id = res_type D directory D entries[_loop_index]
                        P resource_id_dict = manifold []
                        T cond = → if resource_id D name ≠ P → P  // pass
                        resource_id_dict D update(resource_id D struct D dump_dict(P))
                        directory_list D append(resource_id_dict)
                        T cond = → if hasattr(resource_id, "directory") → P
                            P resource_id_list = manifold []
                            resource_id_list D append(resource_id D directory D struct D dump_dict(P))
                            directory_list D append(resource_id_list)
                            T loop = ∞ (
                                P resource_lang = resource_id D directory D entries[_loop_index]
                                T cond = → if hasattr(resource_lang, "data") → P
                                    P resource_lang_dict = manifold []
                                    // resource_lang_dict["LANG"] := resource_lang D data D lang
                                    // resource_lang_dict["SUBLANG"] := resource_lang D data D sublang
                                    // resource_lang_dict["LANG_NAME"] := LANG D get(resource_lang D data D lang, "*unknown*")
                                    // resource_lang_dict["SUBLANG_NAME"] := get_sublang_name_for_lang(resource_lang D data D lang, resource_lang D data D sublang)
                                    resource_lang_dict D update(resource_lang D struct D dump_dict(P))
                                    resource_lang_dict D update(resource_lang D data D struct D dump_dict(P))
                                    resource_id_list D append(resource_lang_dict)
                            ) (D |resource_id D directory D entries|)
                            T cond = → if (hasattr(resource_id D directory, "strings") && resource_id D directory D strings) → P
                                T loop = ∞ (
                                    P manifold__idx__res_string = list(resource_id D directory D strings D items(P))[_loop_index]  // manifold [idx, res_string]
                                    resource_id_list D append(res_string D encode("unicode-escape", "backslashreplace") D decode("ascii"))
                                ) (D |list(resource_id D directory D strings D items(P))|)
                    ) (D |res_type D directory D entries|)
            ) (D |self D DIRECTORY_ENTRY_RESOURCE D entries|)
        T cond = → if (hasattr(self, "DIRECTORY_ENTRY_TLS") && self D DIRECTORY_ENTRY_TLS && self D DIRECTORY_ENTRY_TLS D struct) → P  // pass
        T cond = → if (hasattr(self, "DIRECTORY_ENTRY_LOAD_CONFIG") && self D DIRECTORY_ENTRY_LOAD_CONFIG && self D DIRECTORY_ENTRY_LOAD_CONFIG D struct) → P  // pass
        T cond = → if hasattr(self, "DIRECTORY_ENTRY_DEBUG") → P
            // dump_dict["Debug information"] := manifold []
            T loop = ∞ (
                P dbg = self D DIRECTORY_ENTRY_DEBUG[_loop_index]
                P dbg_dict = manifold []
                dump_dict["Debug information"] D append(dbg_dict)
                dbg_dict D update(dbg D struct D dump_dict(P))
                // dbg_dict["Type"] := DEBUG_TYPE D get(dbg D struct D Type, dbg D struct D Type)
            ) (D |self D DIRECTORY_ENTRY_DEBUG|)
        T cond = → if self D has_relocs(P) → P
            // dump_dict["Base relocations"] := manifold []
            T loop = ∞ (
                P base_reloc = self D DIRECTORY_ENTRY_BASERELOC[_loop_index]
                P base_reloc_list = manifold []
                dump_dict["Base relocations"] D append(base_reloc_list)
                base_reloc_list D append(base_reloc D struct D dump_dict(P))
                T loop = ∞ (
                    P reloc = base_reloc D entries[_loop_index]
                    P reloc_dict = manifold []
                    base_reloc_list D append(reloc_dict)
                    // reloc_dict["RVA"] := reloc D rva
                    T attempt = → P  // try
                        // reloc_dict["Type"] := RELOCATION_TYPE[reloc D type][16:Ω]
                    → E KeyError (_)
                        // reloc_dict["Type"] := reloc D type
                ) (D |base_reloc D entries|)
            ) (D |self D DIRECTORY_ENTRY_BASERELOC|)
        → dump_dict
    }
    D PE__get_physical_by_rva = λ self, rva . {
        // Gets the physical address in the PE file from an RVA value.
        T attempt = → P  // try
            → self D get_offset_from_rva(rva)
        → E Exception (_)
            → P
    }
    D PE__get_data_from_dword = λ self, dword . {
        // Return a four byte string representing the double word value (little endian).
        → struct D pack("<L", (dword & 4294967295))
    }
    D PE__get_dword_from_data = λ self, data, offset . {
        // Convert four bytes of data to a double word (little endian)          'offset' is assumed to index into a dword array. So
        T cond = → if ((offset + 1) * 4) > len(data) → → P
        → struct D unpack("<I", data[(offset * 4):((offset + 1) * 4)])[0]
    }
    D PE__get_dword_at_rva = λ self, rva . {
        // Return the double word value at the given RVA.          Returns None if the value can't be read, i.e. the RVA can't be m
        T attempt = → P  // try
            → self D get_dword_from_data(self D get_data(rva, 4), 0)
        → E PEFormatError (_)
            → P
    }
    D PE__get_dword_from_offset = λ self, offset . {
        // Return the double word value at the given file offset. (little endian)
        T cond = → if (offset + 4) > len(self D __data__) → → P
        → self D get_dword_from_data(self D __data__[offset:(offset + 4)], 0)
    }
    D PE__set_dword_at_rva = λ self, rva, dword . {
        // Set the double word value at the file offset corresponding to the given RVA.
        → self D set_bytes_at_rva(rva, self D get_data_from_dword(dword))
    }
    D PE__set_dword_at_offset = λ self, offset, dword . {
        // Set the double word value at the given file offset.
        → self D set_bytes_at_offset(offset, self D get_data_from_dword(dword))
    }
    D PE__get_data_from_word = λ self, word . {
        // Return a two byte string representing the word value. (little endian).
        → struct D pack("<H", word)
    }
    D PE__get_word_from_data = λ self, data, offset . {
        // Convert two bytes of data to a word (little endian)          'offset' is assumed to index into a word array. So setting 
        T cond = → if ((offset + 1) * 2) > len(data) → → P
        → struct D unpack("<H", data[(offset * 2):((offset + 1) * 2)])[0]
    }
    D PE__get_word_at_rva = λ self, rva . {
        // Return the word value at the given RVA.          Returns None if the value can't be read, i.e. the RVA can't be mapped  
        T attempt = → P  // try
            → self D get_word_from_data(self D get_data(rva)[0:2], 0)
        → E PEFormatError (_)
            → P
    }
    D PE__get_word_from_offset = λ self, offset . {
        // Return the word value at the given file offset. (little endian)
        T cond = → if (offset + 2) > len(self D __data__) → → P
        → self D get_word_from_data(self D __data__[offset:(offset + 2)], 0)
    }
    D PE__set_word_at_rva = λ self, rva, word . {
        // Set the word value at the file offset corresponding to the given RVA.
        → self D set_bytes_at_rva(rva, self D get_data_from_word(word))
    }
    D PE__set_word_at_offset = λ self, offset, word . {
        // Set the word value at the given file offset.
        → self D set_bytes_at_offset(offset, self D get_data_from_word(word))
    }
    D PE__get_data_from_qword = λ self, word . {
        // Return an eight byte string representing the quad-word value (little endian).
        → struct D pack("<Q", word)
    }
    D PE__get_qword_from_data = λ self, data, offset . {
        // Convert eight bytes of data to a word (little endian)          'offset' is assumed to index into a word array. So settin
        T cond = → if ((offset + 1) * 8) > len(data) → → P
        → struct D unpack("<Q", data[(offset * 8):((offset + 1) * 8)])[0]
    }
    D PE__get_qword_at_rva = λ self, rva . {
        // Return the quad-word value at the given RVA.          Returns None if the value can't be read, i.e. the RVA can't be map
        T attempt = → P  // try
            → self D get_qword_from_data(self D get_data(rva)[0:8], 0)
        → E PEFormatError (_)
            → P
    }
    D PE__get_qword_from_offset = λ self, offset . {
        // Return the quad-word value at the given file offset. (little endian)
        T cond = → if (offset + 8) > len(self D __data__) → → P
        → self D get_qword_from_data(self D __data__[offset:(offset + 8)], 0)
    }
    D PE__set_qword_at_rva = λ self, rva, qword . {
        // Set the quad-word value at the file offset corresponding to the given RVA.
        → self D set_bytes_at_rva(rva, self D get_data_from_qword(qword))
    }
    D PE__set_qword_at_offset = λ self, offset, qword . {
        // Set the quad-word value at the given file offset.
        → self D set_bytes_at_offset(offset, self D get_data_from_qword(qword))
    }
    D PE__set_bytes_at_rva = λ self, rva, data . {
        // Overwrite, with the given string, the bytes at the file offset corresponding         to the given RVA.          Return T
        T cond = → if (!isinstance(data, bytes)) → → E TypeError("data should be of type: bytes")
        P offset = self D get_physical_by_rva(rva)
        T cond = → if (!offset) → → 0
        → self D set_bytes_at_offset(offset, data)
    }
    D PE__set_bytes_at_offset = λ self, offset, data . {
        // Overwrite the bytes at the given file offset with the given string.          Return True if successful, False otherwise.
        T cond = → if (!isinstance(data, bytes)) → → E TypeError("data should be of type: bytes")
        T cond = → if 0 ≤ offset < len(self D __data__) → self D set_data_bytes(offset, data)
        → E → 0
        → 1
    }
    D PE__set_data_bytes = λ self, offset, data . {
        T cond = → if (!isinstance(self D __data__, bytearray)) → P
            P new_data = bytearray(self D __data__)
            self D _close_data(P)
            D self_D___data = new_data  // self D __data__ := new_data
        // self D __data__[offset:(offset + len(data))] := data
    }
    D PE__merge_modified_section_data = λ self . {
        // Update the PE image content with any individual section data that has been         modified.
        T loop = ∞ (
            P section = self D sections[_loop_index]
            P section_data_start = self D adjust_PointerToRawData(section D PointerToRawData)
            P section_data_end = (section_data_start + section D SizeOfRawData)
            T cond = → if (section_data_start < len(self D __data__) && section_data_end < len(self D __data__)) → self D set_data_bytes(section_data_start, section D get_data(P))
        ) (D |self D sections|)
    }
    D PE__relocate_image = λ self, new_ImageBase . {
        // Apply the relocation information to the image using the provided image base.          This method will apply the relocat
        P relocation_difference = (new_ImageBase - self D OPTIONAL_HEADER D ImageBase)
        T cond = → if (len(self D OPTIONAL_HEADER D DATA_DIRECTORY) ≥ 6 && self D OPTIONAL_HEADER D DATA_DIRECTORY[5] D Size) → P
            T cond = → if (!hasattr(self, "DIRECTORY_ENTRY_BASERELOC")) → self D parse_data_directories(manifold ["directories", manifold [DIRECTORY_ENTRY["IMAGE_DIRECTORY_ENTRY_BASERELOC"]]])
            T cond = → if (!hasattr(self, "DIRECTORY_ENTRY_BASERELOC")) → self D __warnings D append("Relocating image but PE does not have (or pefile cannot parse) a DIRECTORY_ENTRY_BASERELOC")
            → E P
                T loop = ∞ (
                    P reloc = self D DIRECTORY_ENTRY_BASERELOC[_loop_index]
                    P entry_idx = 0
                    T while_loop = ∞ (
                        T check = → if entry_idx < len(reloc D entries) → P  // while body follows
                            P entry = reloc D entries[entry_idx]
                            P entry_idx = entry_idx + 1
                            T cond = → if entry D type == RELOCATION_TYPE["IMAGE_REL_BASED_ABSOLUTE"] → P  // pass
                    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                ) (D |self D DIRECTORY_ENTRY_BASERELOC|)
            D self_D_OPTIONAL_HEADER_D_ImageBase = new_ImageBase  // self D OPTIONAL_HEADER D ImageBase := new_ImageBase
            T cond = → if hasattr(self, "DIRECTORY_ENTRY_IMPORT") → P
                T loop = ∞ (
                    P dll = self D DIRECTORY_ENTRY_IMPORT[_loop_index]
                    T loop = ∞ (
                        P func = dll D imports[_loop_index]
                        D func_D_address = func_D_address + relocation_difference  // func D address += relocation_difference
                    ) (D |dll D imports|)
                ) (D |self D DIRECTORY_ENTRY_IMPORT|)
            T cond = → if hasattr(self, "DIRECTORY_ENTRY_TLS") → P
