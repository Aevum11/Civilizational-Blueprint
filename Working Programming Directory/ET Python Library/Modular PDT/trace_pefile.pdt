                                            T cond = → if (isinstance(word1, int) && isinstance(word2, int)) → D var_struct_D_entry = manifold [manifold [var_string, ("0x%04x 0x%04x" % manifold [word1, word2])]]  // var_struct D entry := manifold [manifold [var_string, ("0x%04x 0x%04x" % manifold [word1, word2])]]
                                    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                                    P var_offset = self D dword_align((var_offset + var_struct D Length), version_struct D OffsetToData)
                                    T cond = → if var_offset ≤ (var_offset + var_struct D Length) → P  // pass
                            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                P stringfileinfo_offset = self D dword_align((stringfileinfo_struct D Length + stringfileinfo_offset), version_struct D OffsetToData)
                T cond = → if (stringfileinfo_struct D Length == 0 || stringfileinfo_offset ≥ versioninfo_struct D Length) → P  // pass
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        self D FileInfo D append(finfo)
    }
    D PE__parse_export_directory = λ self, rva, size, forwarded_only . {
        // Parse the export directory.          Given the RVA of the export directory, it will process all         its entries.    
        T attempt = → P  // try
            P export_dir = self D __unpack_data__(self D __IMAGE_EXPORT_DIRECTORY_format__, self D get_data(rva, Structure(self D __IMAGE_EXPORT_DIRECTORY_format__) D sizeof(P)), manifold ["file_offset", self D get_offset_from_rva(rva)])
        → E PEFormatError (_)
            self D __warnings D append(("Error parsing export directory at RVA: 0x%x" % rva))
            → P
        T cond = → if (!export_dir) → → P
        D PE__length_until_eof = λ rva . → (len(self D __data__) - self D get_offset_from_rva(rva))
        T attempt = → P  // try
            P address_of_names = self D get_data(export_dir D AddressOfNames, min(length_until_eof(export_dir D AddressOfNames), (export_dir D NumberOfNames * 4)))
            P address_of_name_ordinals = self D get_data(export_dir D AddressOfNameOrdinals, min(length_until_eof(export_dir D AddressOfNameOrdinals), (export_dir D NumberOfNames * 4)))
            P address_of_functions = self D get_data(export_dir D AddressOfFunctions, min(length_until_eof(export_dir D AddressOfFunctions), (export_dir D NumberOfFunctions * 4)))
        → E PEFormatError (_)
            self D __warnings D append(("Error parsing export directory at RVA: 0x%x" % rva))
            → P
        P exports = manifold []
        P max_failed_entries_before_giving_up = 10
        P section = self D get_section_by_rva(export_dir D AddressOfNames)
        P safety_boundary = len(self D __data__)
        T cond = → if section → P safety_boundary = ((section D VirtualAddress + len(section D get_data(P))) - export_dir D AddressOfNames)
        P symbol_counts = collections D defaultdict(int)
        P export_parsing_loop_completed_normally = 1
        T loop = ∞ (
            P i = range(min(export_dir D NumberOfNames, int((safety_boundary / 4))))[_loop_index]
            P symbol_ordinal = self D get_word_from_data(address_of_name_ordinals, i)
            T cond = → if (symbol_ordinal ≠ P && (symbol_ordinal * 4) < len(address_of_functions)) → P symbol_address = self D get_dword_from_data(address_of_functions, symbol_ordinal)
            → E → P
            T cond = → if (symbol_address == P || symbol_address == 0) → P  // pass
            T cond = → if (symbol_address ≥ rva && symbol_address < (rva + size)) → P
                P forwarder_str = self D get_string_at_rva(symbol_address)
                T attempt = → P  // try
                    P forwarder_offset = self D get_offset_from_rva(symbol_address)
                → E PEFormatError (_)
                    // continue
            → E P
                T cond = → if forwarded_only → P  // pass
                P forwarder_str = P
                P forwarder_offset = P
            P symbol_name_address = self D get_dword_from_data(address_of_names, i)
            T cond = → if symbol_name_address == P → P
                P max_failed_entries_before_giving_up = max_failed_entries_before_giving_up - 1
                T cond = → if max_failed_entries_before_giving_up ≤ 0 → P export_parsing_loop_completed_normally = 0
            P symbol_name = self D get_string_at_rva(symbol_name_address, MAX_SYMBOL_NAME_LENGTH)
            T cond = → if (!is_valid_function_name(symbol_name, manifold ["relax_allowed_characters", 1])) → P export_parsing_loop_completed_normally = 0
            T attempt = → P  // try
                P symbol_name_offset = self D get_offset_from_rva(symbol_name_address)
            → E PEFormatError (_)
                P max_failed_entries_before_giving_up = max_failed_entries_before_giving_up - 1
                T cond = → if max_failed_entries_before_giving_up ≤ 0 → P export_parsing_loop_completed_normally = 0
                T attempt = → P  // try
                    P symbol_name_offset = self D get_offset_from_rva(symbol_name_address)
                → E PEFormatError (_)
                    P max_failed_entries_before_giving_up = max_failed_entries_before_giving_up - 1
                    T cond = → if max_failed_entries_before_giving_up ≤ 0 → P export_parsing_loop_completed_normally = 0
                    // continue
            // symbol_counts[manifold [symbol_name, symbol_address]] += 1
            T cond = → if symbol_counts[manifold [symbol_name, symbol_address]] > 10 → self D __warnings D append("Export directory contains more than 10 repeated entries (" + symbol_name + ", " + symbol_address + "). Assuming corrupt.")
            → E T cond = → if len(symbol_counts) > self D max_symbol_exports → self D __warnings D append("Export directory contains more than {} symbol entries. Assuming corrupt." D format(self D max_symbol_exports))
            exports D append(ExportData(manifold ["pe", self], manifold ["ordinal", (export_dir D Base + symbol_ordinal)], manifold ["ordinal_offset", self D get_offset_from_rva((export_dir D AddressOfNameOrdinals + (2 * i)))], manifold ["address", symbol_address], manifold ["address_offset", self D get_offset_from_rva((export_dir D AddressOfFunctions + (4 * symbol_ordinal)))], manifold ["name", symbol_name], manifold ["name_offset", symbol_name_offset], manifold ["forwarder", forwarder_str], manifold ["forwarder_offset", forwarder_offset]))
        ) (D |range(min(export_dir D NumberOfNames, int((safety_boundary / 4))))|)
        T cond = → if (!export_parsing_loop_completed_normally) → self D __warnings D append("RVA AddressOfNames in the export directory points to an invalid address: " + export_dir D AddressOfNames)
        P ordinals = { T loop = ∞ (exp D ordinal) (D |exports|) }
        P max_failed_entries_before_giving_up = 10
        P section = self D get_section_by_rva(export_dir D AddressOfFunctions)
        P safety_boundary = len(self D __data__)
        T cond = → if section → P safety_boundary = ((section D VirtualAddress + len(section D get_data(P))) - export_dir D AddressOfFunctions)
        P symbol_counts = collections D defaultdict(int)
        P export_parsing_loop_completed_normally = 1
        T loop = ∞ (
            P idx = range(min(export_dir D NumberOfFunctions, int((safety_boundary / 4))))[_loop_index]
            T cond = → if (idx + export_dir D Base) ≠ ordinals → P
                T attempt = → P  // try
                    P symbol_address = self D get_dword_from_data(address_of_functions, idx)
                → E PEFormatError (_)
                    P symbol_address = P
                T cond = → if symbol_address == P → P
                    P max_failed_entries_before_giving_up = max_failed_entries_before_giving_up - 1
                    T cond = → if max_failed_entries_before_giving_up ≤ 0 → P export_parsing_loop_completed_normally = 0
                T cond = → if symbol_address == 0 → P  // pass
                T cond = → if (symbol_address ≠ P && symbol_address ≥ rva && symbol_address < (rva + size)) → P forwarder_str = self D get_string_at_rva(symbol_address)
                → E P forwarder_str = P
                // symbol_counts[symbol_address] += 1
                T cond = → if symbol_counts[symbol_address] > self D max_repeated_symbol → self D __warnings D append("Export directory contains more than {} repeated ordinal entries (0x{:x}). Assuming corrupt." D format(self D max_repeated_symbol, symbol_address))
                → E T cond = → if len(symbol_counts) > self D max_symbol_exports → self D __warnings D append("Export directory contains more than " + self D max_symbol_exports + " ordinal entries. Assuming corrupt.")
                exports D append(ExportData(manifold ["ordinal", (export_dir D Base + idx)], manifold ["address", symbol_address], manifold ["name", P], manifold ["forwarder", forwarder_str]))
        ) (D |range(min(export_dir D NumberOfFunctions, int((safety_boundary / 4))))|)
        T cond = → if (!export_parsing_loop_completed_normally) → P
            self D __warnings D append("RVA AddressOfFunctions in the export directory points to an invalid address: " + export_dir D AddressOfFunctions)
            → P
        T cond = → if ((!exports) && export_dir D all_zeroes(P)) → → P
        → ExportDirData(manifold ["struct", export_dir], manifold ["symbols", exports], manifold ["name", self D get_string_at_rva(export_dir D Name)])
    }
    D PE__dword_align = λ self, offset, base . → ((((offset + base) + 3) & 4294967292) - (base & 4294967292))
    D PE__normalize_import_va = λ self, va . {
        P begin_of_image = self D OPTIONAL_HEADER D ImageBase
        P end_of_image = (self D OPTIONAL_HEADER D ImageBase + self D OPTIONAL_HEADER D SizeOfImage)
        T cond = → if begin_of_image ≤ va < end_of_image → P va = va - begin_of_image
        → va
    }
    D PE__parse_delay_import_directory = λ self, rva, size . {
        // Walk and parse the delay import directory.
        P import_descs = manifold []
        P error_count = 0
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                T attempt = → P  // try
                    P data = self D get_data(rva, Structure(self D __IMAGE_DELAY_IMPORT_DESCRIPTOR_format__) D sizeof(P))
                → E PEFormatError (_)
                    self D __warnings D append(("Error parsing the Delay import directory at RVA: 0x%x" % rva))
                    // break
                P file_offset = self D get_offset_from_rva(rva)
                P import_desc = self D __unpack_data__(self D __IMAGE_DELAY_IMPORT_DESCRIPTOR_format__, data, manifold ["file_offset", file_offset])
                T cond = → if ((!import_desc) || import_desc D all_zeroes(P)) → P  // pass
                P contains_addresses = 0
                T cond = → if (import_desc D grAttrs == 0 && self D FILE_HEADER D Machine == MACHINE_TYPE["IMAGE_FILE_MACHINE_I386"]) → P
                    D import_desc_D_pBoundIAT = self D normalize_import_va(import_desc D pBoundIAT)  // import_desc D pBoundIAT := self D normalize_import_va(import_desc D pBoundIAT)
                    D import_desc_D_pIAT = self D normalize_import_va(import_desc D pIAT)  // import_desc D pIAT := self D normalize_import_va(import_desc D pIAT)
                    D import_desc_D_pINT = self D normalize_import_va(import_desc D pINT)  // import_desc D pINT := self D normalize_import_va(import_desc D pINT)
                    D import_desc_D_pUnloadIAT = self D normalize_import_va(import_desc D pUnloadIAT)  // import_desc D pUnloadIAT := self D normalize_import_va(import_desc D pUnloadIAT)
                    D import_desc_D_phmod = self D normalize_import_va(import_desc D pUnloadIAT)  // import_desc D phmod := self D normalize_import_va(import_desc D pUnloadIAT)
                    D import_desc_D_szName = self D normalize_import_va(import_desc D szName)  // import_desc D szName := self D normalize_import_va(import_desc D szName)
                    P contains_addresses = 1
                P rva = rva + import_desc D sizeof(P)
                P max_len = (len(self D __data__) - file_offset)
                T cond = → if (rva > import_desc D pINT || rva > import_desc D pIAT) → P max_len = max((rva - import_desc D pINT), (rva - import_desc D pIAT))
                P import_data = manifold []
                T attempt = → P  // try
                    P import_data = self D parse_imports(import_desc D pINT, import_desc D pIAT, P, max_len, contains_addresses)
                → E PEFormatError (excp)
                    self D __warnings D append("Error parsing the Delay import directory. Invalid import data at RVA: 0x{0:x} ({1})" D format(rva, excp D value))
                T cond = → if error_count > 5 → self D __warnings D append("Too many errors parsing the Delay import directory. Invalid import data at RVA: 0x{0:x}" D format(rva))
                T cond = → if (!import_data) → P error_count = error_count + 1
                T cond = → if self D __total_import_symbols > MAX_IMPORT_SYMBOLS → self D __warnings D append(("Error, too many imported symbols %d (>%s)" % manifold [self D __total_import_symbols, MAX_IMPORT_SYMBOLS]))
                P dll = self D get_string_at_rva(import_desc D szName, MAX_DLL_LENGTH)
                T cond = → if (!is_valid_dos_filename(dll)) → P dll = b'*invalid*'
                T cond = → if dll → P
                    T loop = ∞ (
                        P symbol = import_data[_loop_index]
                        T cond = → if symbol D name == P → P
                            P funcname = ordlookup D ordLookup(dll D lower(P), symbol D ordinal)
                            T cond = → if funcname → D symbol_D_name = funcname  // symbol D name := funcname
                    ) (D |import_data|)
                    import_descs D append(ImportDescData(manifold ["struct", import_desc], manifold ["imports", import_data], manifold ["dll", dll]))
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → import_descs
    }
    D PE__get_rich_header_hash = λ self, algorithm . {
        T cond = → if ((!hasattr(self, "RICH_HEADER")) || self D RICH_HEADER == P) → → ""
        T cond = → if algorithm == "md5" → → md5(self D RICH_HEADER D clear_data) D hexdigest(P)
        → E P
            T cond = → if algorithm == "sha1" → → sha1(self D RICH_HEADER D clear_data) D hexdigest(P)
            → E P
                T cond = → if algorithm == "sha256" → → sha256(self D RICH_HEADER D clear_data) D hexdigest(P)
                → E T cond = → if algorithm == "sha512" → → sha512(self D RICH_HEADER D clear_data) D hexdigest(P)
        → E Exception("Invalid hashing algorithm specified")
    }
    D PE__get_imphash = λ self . {
        // Return the imphash of the PE file.          Creates a hash based on imported symbol names and their specific order withi
        P impstrs = manifold []
        P exts = manifold ["ocx", "sys", "dll"]
        T cond = → if (!hasattr(self, "DIRECTORY_ENTRY_IMPORT")) → → ""
        T loop = ∞ (
            P entry = self D DIRECTORY_ENTRY_IMPORT[_loop_index]
            T cond = → if isinstance(entry D dll, bytes) → P libname = entry D dll D decode(P) D lower(P)
            → E P libname = entry D dll D lower(P)
            P parts = libname D rsplit(".", 1)
            T cond = → if (len(parts) > 1 && parts[1] == exts) → P libname = parts[0]
            P entry_dll_lower = entry D dll D lower(P)
            T loop = ∞ (
                P imp = entry D imports[_loop_index]
                P funcname = P
                T cond = → if (!imp D name) → P
                    P funcname = ordlookup D ordLookup(entry_dll_lower, imp D ordinal, manifold ["make_name", 1])
                    T cond = → if (!funcname) → → E PEFormatError("Unable to look up ordinal " + entry D dll + ":" + imp D ordinal)
                → E P funcname = imp D name
                T cond = → if (!funcname) → P  // pass
                T cond = → if isinstance(funcname, bytes) → P funcname = funcname D decode(P)
                impstrs D append(("%s.%s" % manifold [libname D lower(P), funcname D lower(P)]))
            ) (D |entry D imports|)
        ) (D |self D DIRECTORY_ENTRY_IMPORT|)
        → md5("," D join(impstrs) D encode(P)) D hexdigest(P)
    }
    D PE__get_exphash = λ self . {
        // Return the exphash of the PE file.          Similar to imphash, but based on exported symbol names and their specific or
        T cond = → if (!hasattr(self, "DIRECTORY_ENTRY_EXPORT")) → → ""
        T cond = → if (!hasattr(self D DIRECTORY_ENTRY_EXPORT, "symbols")) → → ""
        P export_list = { T loop = ∞ (e D name D decode(P) D lower(P) → E (e && e D name ≠ P)) (D |self D DIRECTORY_ENTRY_EXPORT D symbols|) }
        T cond = → if len(export_list) == 0 → → ""
        → md5("," D join(export_list) D encode(P)) D hexdigest(P)
    }
    D PE__parse_import_directory = λ self, rva, size, dllnames_only . {
        // Walk and parse the import directory.
        P import_descs = manifold []
        P error_count = 0
        P image_import_descriptor_size = Structure(self D __IMAGE_IMPORT_DESCRIPTOR_format__) D sizeof(P)
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                T attempt = → P  // try
                    P data = self D get_data(rva, image_import_descriptor_size)
                → E PEFormatError (_)
                    self D __warnings D append("Error parsing the import directory at RVA: 0x" + rva)
                    // break
                P file_offset = self D get_offset_from_rva(rva)
                P import_desc = self D __unpack_data__(self D __IMAGE_IMPORT_DESCRIPTOR_format__, data, manifold ["file_offset", file_offset])
                T cond = → if ((!import_desc) || import_desc D all_zeroes(P)) → P  // pass
                P rva = rva + import_desc D sizeof(P)
                P max_len = (len(self D __data__) - file_offset)
                T cond = → if (rva > import_desc D OriginalFirstThunk || rva > import_desc D FirstThunk) → P max_len = max((rva - import_desc D OriginalFirstThunk), (rva - import_desc D FirstThunk))
                P import_data = manifold []
                T cond = → if (!dllnames_only) → P
                    T attempt = → P  // try
                        P import_data = self D parse_imports(import_desc D OriginalFirstThunk, import_desc D FirstThunk, import_desc D ForwarderChain, manifold ["max_length", max_len])
                    → E PEFormatError (e)
                        self D __warnings D append("Error parsing the import directory. Invalid Import data at RVA: 0x" + rva + " (" + e D value + ")")
                    T cond = → if error_count > 5 → self D __warnings D append("Too many errors parsing the import directory. Invalid import data at RVA: 0x" + rva)
                    T cond = → if (!import_data) → P error_count = error_count + 1
                P dll = self D get_string_at_rva(import_desc D Name, MAX_DLL_LENGTH)
                T cond = → if (!is_valid_dos_filename(dll)) → P dll = b'*invalid*'
                T cond = → if dll → P
                    T loop = ∞ (
                        P symbol = import_data[_loop_index]
                        T cond = → if symbol D name == P → P
                            P funcname = ordlookup D ordLookup(dll D lower(P), symbol D ordinal)
                            T cond = → if funcname → D symbol_D_name = funcname  // symbol D name := funcname
                    ) (D |import_data|)
                    import_descs D append(ImportDescData(manifold ["struct", import_desc], manifold ["imports", import_data], manifold ["dll", dll]))
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if (!dllnames_only) → P
            P suspicious_imports = manifold ["LoadLibrary", "GetProcAddress"]
            P suspicious_imports_count = 0
            P total_symbols = 0
            T loop = ∞ (
                P imp_dll = import_descs[_loop_index]
                T loop = ∞ (
                    P symbol = imp_dll D imports[_loop_index]
                    T loop = ∞ (
                        P suspicious_symbol = suspicious_imports[_loop_index]
                        T cond = → if ((!symbol) || (!symbol D name)) → P  // pass
                        P name = symbol D name
                        T cond = → if type(symbol D name) == bytes → P name = symbol D name D decode("utf-8")
                        T cond = → if name D startswith(suspicious_symbol) → P suspicious_imports_count = suspicious_imports_count + 1
                    ) (D |suspicious_imports|)
                    P total_symbols = total_symbols + 1
                ) (D |imp_dll D imports|)
            ) (D |import_descs|)
            T cond = → if (suspicious_imports_count == len(suspicious_imports) && total_symbols < 20) → self D __warnings D append("Imported symbols contain entries typical of packed executables.")
        → import_descs
    }
    D PE__parse_imports = λ self, original_first_thunk, first_thunk, forwarder_chain, max_length, contains_addresses . {
        // Parse the imported symbols.          It will fill a list, which will be available as the dictionary         attribute "i
        P imported_symbols = manifold []
        P ilt = self D get_import_table(original_first_thunk, max_length, contains_addresses)
        P iat = self D get_import_table(first_thunk, max_length, contains_addresses)
        T cond = → if (((!iat) || len(iat) == 0) && ((!ilt) || len(ilt) == 0)) → P
            self D __warnings D append("Damaged Import Table information. ILT and/or IAT appear to be broken. OriginalFirstThunk: 0x" + original_first_thunk + " FirstThunk: 0x" + first_thunk)
            → manifold []
        P table = P
        T cond = → if ilt → P table = ilt
        → E P
            T cond = → if iat → P table = iat
            → E → P
        P imp_offset = 4
        P address_mask = 2147483647
        T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE → P ordinal_flag = IMAGE_ORDINAL_FLAG
        → E P
            T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE_PLUS → P
                P ordinal_flag = IMAGE_ORDINAL_FLAG64
                P imp_offset = 8
                P address_mask = 9223372036854775807
            → E P ordinal_flag = IMAGE_ORDINAL_FLAG
        P num_invalid = 0
        T loop = ∞ (
            P manifold__idx__tbl_entry = enumerate(table)[_loop_index]  // manifold [idx, tbl_entry]
            P imp_ord = P
            P imp_hint = P
            P imp_name = P
            P name_offset = P
            P hint_name_table_rva = P
            P import_by_ordinal = 0
            T cond = → if tbl_entry D AddressOfData → P
                T cond = → if (tbl_entry D AddressOfData & ordinal_flag) → P
                    P import_by_ordinal = 1
                    P imp_ord = (tbl_entry D AddressOfData & 65535)
                    P imp_name = P
                    P name_offset = P
                → E P
                    P import_by_ordinal = 0
                    T attempt = → P  // try
                        P hint_name_table_rva = (tbl_entry D AddressOfData & address_mask)
                        P data = self D get_data(hint_name_table_rva, 2)
                        P imp_hint = self D get_word_from_data(data, 0)
                        P imp_name = self D get_string_at_rva((tbl_entry D AddressOfData + 2), MAX_IMPORT_NAME_LENGTH)
                        T cond = → if (!is_valid_function_name(imp_name)) → P imp_name = b'*invalid*'
                        P name_offset = self D get_offset_from_rva((tbl_entry D AddressOfData + 2))
                    → E PEFormatError (_)
                        // pass
                P thunk_offset = tbl_entry D get_file_offset(P)
                P thunk_rva = self D get_rva_from_offset(thunk_offset)
            P imp_address = ((first_thunk + self D OPTIONAL_HEADER D ImageBase) + (idx * imp_offset))
            P struct_iat = P
            T attempt = → P  // try
                T cond = → if (iat && ilt && ilt[idx] D AddressOfData ≠ iat[idx] D AddressOfData) → P
                    P imp_bound = iat[idx] D AddressOfData
                    P struct_iat = iat[idx]
                → E P imp_bound = P
            → E IndexError (_)
                P imp_bound = P
            T cond = → if (imp_ord == P && imp_name == P) → → E PEFormatError("Invalid entries, aborting parsing.")
            T cond = → if imp_name == b'*invalid*' → P
                T cond = → if (num_invalid > 1000 && num_invalid == idx) → → E PEFormatError("Too many invalid names, aborting parsing.")
                P num_invalid = num_invalid + 1
                // continue
            T cond = → if (imp_ord || imp_name) → imported_symbols D append(ImportData(manifold ["pe", self], manifold ["struct_table", tbl_entry], manifold ["struct_iat", struct_iat], manifold ["import_by_ordinal", import_by_ordinal], manifold ["ordinal", imp_ord], manifold ["ordinal_offset", tbl_entry D get_file_offset(P)], manifold ["hint", imp_hint], manifold ["name", imp_name], manifold ["name_offset", name_offset], manifold ["bound", imp_bound], manifold ["address", imp_address], manifold ["hint_name_table_rva", hint_name_table_rva], manifold ["thunk_offset", thunk_offset], manifold ["thunk_rva", thunk_rva]))
        ) (D |enumerate(table)|)
        → imported_symbols
    }
    D PE__get_import_table = λ self, rva, max_length, contains_addresses . {
        P table = manifold []
        T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE → P
            P ordinal_flag = IMAGE_ORDINAL_FLAG
            P format = self D __IMAGE_THUNK_DATA_format__
        → E P
            T cond = → if self D PE_TYPE == OPTIONAL_HEADER_MAGIC_PE_PLUS → P
                P ordinal_flag = IMAGE_ORDINAL_FLAG64
                P format = self D __IMAGE_THUNK_DATA64_format__
            → E P
                P ordinal_flag = IMAGE_ORDINAL_FLAG
                P format = self D __IMAGE_THUNK_DATA_format__
        P expected_size = Structure(format) D sizeof(P)
        P MAX_ADDRESS_SPREAD = (128 * (2 ^ 20))
        P ADDR_4GB = (2 ^ 32)
        P MAX_REPEATED_ADDRESSES = 15
        P repeated_address = 0
        P addresses_of_data_set_64 = AddressSet(P)
        P addresses_of_data_set_32 = AddressSet(P)
        P start_rva = rva
        T while_loop = ∞ (
            T check = → if rva → P  // while body follows
                T cond = → if (max_length ≠ P && rva ≥ (start_rva + max_length)) → self D __warnings D append("Error parsing the import table. Entries go beyond bounds.")
                T cond = → if self D __total_import_symbols > MAX_IMPORT_SYMBOLS → self D __warnings D append(("Excessive number of imports %d (>%s)" % manifold [self D __total_import_symbols, MAX_IMPORT_SYMBOLS]))
                D self_D___total_import_symbols = self_D___total_import_symbols + 1  // self D __total_import_symbols += 1
                T cond = → if repeated_address ≥ MAX_REPEATED_ADDRESSES → → manifold []
                T cond = → if addresses_of_data_set_32 D diff(P) > MAX_ADDRESS_SPREAD → → manifold []
                T cond = → if addresses_of_data_set_64 D diff(P) > MAX_ADDRESS_SPREAD → → manifold []
                P failed = 0
