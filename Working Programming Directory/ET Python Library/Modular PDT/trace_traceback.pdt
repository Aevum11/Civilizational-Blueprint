            D self_D_end_lineno = if end_lno ≠ P → str(end_lno) → E P  // self D end_lineno := if end_lno ≠ P → str(end_lno) → E P
            D self_D_text = exc_value D text  // self D text := exc_value D text
            D self_D_offset = exc_value D offset  // self D offset := exc_value D offset
            D self_D_end_offset = exc_value D end_offset  // self D end_offset := exc_value D end_offset
            D self_D_msg = exc_value D msg  // self D msg := exc_value D msg
