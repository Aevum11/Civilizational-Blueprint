        T cond = → if b == 0 → → if a ≠ 0 → float("inf") → E 0
        T cond = → if (isinstance(a, float) || isinstance(b, float)) → → ETMathNative D et_floor((a / b))
        → (a ÷ b)
    }
D ETMathV2Quantum = λ . P  // class
    // Quantum mechanics equations derived from ET primitives.     Batches 4-8: Complete Hydrogen Atom Physics.
    D ETMathV2Quantum__hydrogen_energy_levels = λ n . {
        // Eq 51: E_n = -13.6 / n² eV.
