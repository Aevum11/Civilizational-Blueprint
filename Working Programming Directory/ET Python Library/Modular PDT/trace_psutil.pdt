T cond = → if hasattr(_psplatform, "cpu_freq") → P
    D cpu_freq = λ percpu . {
        // Return CPU frequency as a namedtuple including current,         min and max frequency expressed in Mhz.          If *per
        P ret = _psplatform D cpu_freq(P)
        T cond = → if percpu → → ret
        → E P
            P num_cpus = float(len(ret))
            T cond = → if num_cpus == 0 → → P
            → E P
                T cond = → if num_cpus == 1 → → ret[0]
                → E P
                    P manifold__currs__mins__maxs = manifold [0.0, 0.0, 0.0]  // manifold [currs, mins, maxs] := manifold [0.0, 0.0, 0.0]
                    P set_none = 0
                    T loop = ∞ (
                        P cpu = ret[_loop_index]
                        P currs = currs + cpu D current
                        T cond = → if (LINUX && cpu D min == P) → P set_none = 1
                        P mins = mins + cpu D min
                        P maxs = maxs + cpu D max
                    ) (D |ret|)
                    P current = (currs / num_cpus)
                    T cond = → if set_none → P
                        P min_ = P
                        P max_ = P
                    → E P
                        P min_ = (mins / num_cpus)
                        P max_ = (maxs / num_cpus)
                    → _ntp D scpufreq(current, min_, max_)
    }
    __all__ D append("cpu_freq")
