            P idx = self D _gen_sovereign_expr(node D right)
            → coll + "[int(" + idx + ")]"
        T cond = → if nt == ASTNodeType D MEMBER_ACCESS → P
            P obj = self D _gen_sovereign_expr(node D left)
            → obj + "." + node D name
        T cond = → if nt == ASTNodeType D SOVEREIGN_CALL → P
            T cond = → if node D name == "sovereign_print" → → self D _gen_sovereign_expr(node D body)
            → "None"
        T cond = → if nt == manifold [ASTNodeType D LITERAL_INFINITY, ASTNodeType D LITERAL_OMEGA] → → "float(\"inf\")"
        → "None"
    }
    D ETPLCompiler___ast_to_qasm = λ self, ast . {
