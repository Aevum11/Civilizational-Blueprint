import tkinter as tk
from tkinter import filedialog, messagebox, colorchooser
import threading
import sys
import math

try:
    from PIL import Image, ImageTk, ImageDraw, ImageFilter, ImageChops
except ImportError:
    messagebox.showerror("Error", "Pillow is missing. Run: pip install pillow")
    sys.exit(1)

# ==============================================================================
# ET KERNEL: FREQUENCY-SEPARATED OPTICAL PHYSICS
# ==============================================================================

class ET_Omni_Engine:
    def process_omni_stack(self, img_pil, mask_pil, veil_color, thickness, exposure_cap, shadow_lift, detail_rec, status_cb):
        """
        1. Optical De-Occlusion (Raw Physics)
        2. Frequency Separation (Base vs Detail)
        3. Independent Tone Mapping
        """
        width, height = img_pil.size
        pixels = img_pil.load()
        mask = mask_pil.load()
        
        # 1. OPTICAL THICKNESS MAPPING (The V20 Core)
        status_cb("Calculating Optical Physics...")
        
        # High-Fidelity Transmission Map
        dark_ref = img_pil.filter(ImageFilter.MinFilter(15))
        tx_map = dark_ref.filter(ImageFilter.GaussianBlur(2))
        tx_map = tx_map.filter(ImageFilter.UnsharpMask(radius=2, percent=150, threshold=3))
        tx_pix = tx_map.load()
        
        # We need a blurred version of the ORIGINAL to act as the 'Base' frequency reference
        # This helps us split the result later
        orig_blur = img_pil.filter(ImageFilter.GaussianBlur(radius=3))
        orig_blur_pix = orig_blur.load()
        
        bbox = mask_pil.getbbox()
        if not bbox: return img_pil
        min_x, min_y, max_x, max_y = bbox
        
        updates = []
        
        # Factors
        omega = thickness / 100.0
        t0 = 0.1
        ar_base, ag_base, ab_base = veil_color
        
        # Tone Mapping Factors
        # Exposure Cap: 1.0 (No cap) to 0.2 (Heavy darkening)
        exp_factor = 1.0 - (exposure_cap / 150.0) 
        
        # Shadow Lift (Gamma)
        gamma = 1.0 + (shadow_lift / 40.0)
        inv_gamma = 1.0 / gamma
        
        # Detail Boost
        detail_factor = 1.0 + (detail_rec / 50.0)

        # 2. THE OMNI LOOP
        for y in range(min_y, max_y):
            for x in range(min_x, max_x):
                if mask[x, y] == 0: continue
                
                pr, pg, pb = pixels[x, y]
                
                # --- PHASE 1: PHYSICS (Remove Layer) ---
                
                # Adaptive Veil (V19/21 Logic)
                p_lum = (pr + pg + pb) / 3.0
                lum_ratio = p_lum / 255.0
                mod_factor = 0.6 + (0.4 * lum_ratio) 
                
                ar = max(1, ar_base * mod_factor)
                ag = max(1, ag_base * mod_factor)
                ab = max(1, ab_base * mod_factor)
                
                # Transmission
                local_min = tx_pix[x, y]
                dr = local_min[0] / ar
                dg = local_min[1] / ag
                db = local_min[2] / ab
                dark_c = min(dr, dg, db)
                
                t = 1.0 - (omega * dark_c)
                t = max(t0, t)
                
                # J_Raw (Likely > 255)
                jr = ((pr - ar) / t) + ar
                jg = ((pg - ag) / t) + ag
                jb = ((pb - ab) / t) + ab
                
                # --- PHASE 2: FREQUENCY SEPARATION (Split Energy/Detail) ---
                
                # We calculate the "Detail" of the original image to inject it back
                # This ensures we keep the texture of the object underneath
                # Detail = Original - Blur
                obr, obg, obb = orig_blur_pix[x, y]
                det_r = pr - obr
                det_g = pg - obg
                det_b = pb - obb
                
                # We assume J_Raw is mostly "Base Energy" because the optical math 
                # often blows out texture. We treat J_Raw as the "Light Source".
                
                # --- PHASE 3: INDEPENDENT MAPPING ---
                
                # A. Tame the Energy (Base)
                # Apply Exposure Cap
                base_r = jr * exp_factor
                base_g = jg * exp_factor
                base_b = jb * exp_factor
                
                # Apply Gamma (Shadow Lift) on the Energy
                # Soft clamp logic
                def apply_curve(val):
                    if val < 0: return 0
                    norm = val / 255.0
                    # Logarithmic rolloff for highlights > 1.0
                    if norm > 1.0:
                        norm = 1.0 + math.log(norm) * 0.5
                    
                    # Gamma expansion for shadows
                    res = math.pow(norm, inv_gamma)
                    return res * 255.0

                base_r = apply_curve(base_r)
                base_g = apply_curve(base_g)
                base_b = apply_curve(base_b)
                
                # B. Enhance the Detail (Variance)
                # We take the original detail and amplify it, then add it to the recovered base
                # This bypasses the "blurring" of the optical math
                final_dr = det_r * detail_factor
                final_dg = det_g * detail_factor
                final_db = det_b * detail_factor
                
                # --- PHASE 4: RECOMBINE ---
                final_r = base_r + final_dr
                final_g = base_g + final_dg
                final_b = base_b + final_db
                
                updates.append((x, y, (int(max(0, min(255, final_r))), 
                                     int(max(0, min(255, final_g))), 
                                     int(max(0, min(255, final_b))))))
                
        for ux, uy, uval in updates:
            pixels[ux, uy] = uval
            
        return img_pil

# ==============================================================================
# GUI
# ==============================================================================

class ET_V22_GUI:
    def __init__(self, root):
        self.root = root
        self.root.title("ET-V22: DESCRIPTOR-SPLIT ENGINE (BEST OF ALL)")
        self.root.geometry("1200x980")
        self.root.configure(bg="#050505")
        
        self.engine = ET_Omni_Engine()
        self.pil_img = None
        self.mask_img = None
        self.backup_img = None
        
        self.veil_color = (200, 200, 200)
        self.picking_color = False
        
        self._layout()

    def _layout(self):
        t = tk.Frame(self.root, bg="#101010", pady=10)
        t.pack(fill=tk.X)
        
        # ROW 1: ACTIONS
        r1 = tk.Frame(t, bg="#101010"); r1.pack(side=tk.TOP, fill=tk.X)
        self.btn(r1, "LOAD", self.load, "#004488")
        self.btn(r1, "RESET ALL", self.reset_all, "#880000")
        self.btn(r1, "CLEAR MASK", self.clear_mask, "#550000")
        self.btn(r1, "EXECUTE", self.run, "#006600")
        
        # ROW 2: PICKER
        r2 = tk.Frame(t, bg="#101010"); r2.pack(side=tk.TOP, fill=tk.X, pady=5)
        self.pick_btn = tk.Button(r2, text="[✚] PICK VEIL COLOR", command=self.toggle_picker, bg="#444", fg="white", font=("Arial", 10, "bold"), relief="raised")
        self.pick_btn.pack(side=tk.LEFT, padx=10)
        self.c_lbl = tk.Label(r2, text="      ", bg="#cccccc", relief="sunken", width=6)
        self.c_lbl.pack(side=tk.LEFT)
        self.stat = tk.Label(r2, text="Ready.", fg="#00ff00", bg="#101010")
        self.stat.pack(side=tk.RIGHT, padx=20)
        
        # ROW 3: PHYSICS CONTROLS
        r3 = tk.Frame(t, bg="#101010"); r3.pack(side=tk.TOP, fill=tk.X, pady=5)
        
        # Thickness
        f1 = tk.Frame(r3, bg="#101010"); f1.pack(side=tk.LEFT, padx=5)
        tk.Label(f1, text="LAYER THICKNESS", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.thick_scale = tk.Scale(f1, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=140)
        self.thick_scale.set(85)
        self.thick_scale.pack()
        
        # Exposure Cap (Brightness)
        f2 = tk.Frame(r3, bg="#101010"); f2.pack(side=tk.LEFT, padx=5)
        tk.Label(f2, text="EXPOSURE CAP", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.exp_scale = tk.Scale(f2, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=140)
        self.exp_scale.set(30) # Caps the brightness
        self.exp_scale.pack()
        
        # Shadow Lift
        f3 = tk.Frame(r3, bg="#101010"); f3.pack(side=tk.LEFT, padx=5)
        tk.Label(f3, text="SHADOW RECOVERY", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.shd_scale = tk.Scale(f3, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=140)
        self.shd_scale.set(40)
        self.shd_scale.pack()
        
        # Detail Rec (Variance)
        f4 = tk.Frame(r3, bg="#101010"); f4.pack(side=tk.LEFT, padx=5)
        tk.Label(f4, text="DETAIL RECOVERY", fg="#888", bg="#101010", font=("Arial", 8)).pack()
        self.det_scale = tk.Scale(f4, from_=0, to=100, orient=tk.HORIZONTAL, bg="#101010", fg="#0f0", length=140)
        self.det_scale.set(20)
        self.det_scale.pack()

        # CANVAS
        container = tk.Frame(self.root)
        container.pack(fill=tk.BOTH, expand=True)
        self.cv = tk.Canvas(container, bg="#080808", cursor="crosshair")
        vs = tk.Scrollbar(container, orient="vertical", command=self.cv.yview)
        hs = tk.Scrollbar(container, orient="horizontal", command=self.cv.xview)
        self.cv.config(yscrollcommand=vs.set, xscrollcommand=hs.set)
        
        vs.pack(side=tk.RIGHT, fill=tk.Y)
        hs.pack(side=tk.BOTTOM, fill=tk.X)
        self.cv.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.cv.bind("<Button-1>", self.down)
        self.cv.bind("<B1-Motion>", self.drag)
        self.cv.bind("<ButtonRelease-1>", self.up)
        
        self.drawing=False; self.brush=30

    def btn(self, p, t, c, b):
        tk.Button(p, text=t, command=c, bg=b, fg="white", relief="flat", padx=10, pady=5).pack(side=tk.LEFT, padx=5)

    def load(self):
        path = filedialog.askopenfilename()
        if not path: return
        try:
            self.pil_img = Image.open(path).convert("RGB")
            self.backup_img = self.pil_img.copy()
            self.mask_img = Image.new("L", self.pil_img.size, 0)
            self.cv.config(scrollregion=(0,0,self.pil_img.width,self.pil_img.height))
            self.update_view()
            self.stat.config(text=f"Loaded: {self.pil_img.size}")
        except: pass

    def update_view(self):
        if not self.pil_img: return
        d = self.pil_img.copy()
        if self.mask_img.getbbox():
            r = Image.new("RGB", self.pil_img.size, (255,0,0)) 
            d = Image.composite(r, d, self.mask_img)
        self.tk = ImageTk.PhotoImage(d)
        self.cv.create_image(0,0, image=self.tk, anchor=tk.NW)

    def toggle_picker(self):
        if not self.pil_img: return
        self.picking_color = not self.picking_color
        if self.picking_color:
            self.pick_btn.config(bg="#ffaa00", fg="black", text="CLICK IMAGE TO PICK")
            self.cv.config(cursor="target")
        else:
            self.pick_btn.config(bg="#444", fg="white", text="[✚] PICK VEIL COLOR")
            self.cv.config(cursor="crosshair")

    def down(self,e):
        x=int(self.cv.canvasx(e.x)); y=int(self.cv.canvasy(e.y))
        if self.picking_color and self.pil_img:
            if 0 <= x < self.pil_img.width and 0 <= y < self.pil_img.height:
                r,g,b = self.pil_img.getpixel((x,y))
                self.veil_color = (r,g,b)
                hex_c = '#%02x%02x%02x' % (r,g,b)
                self.c_lbl.config(bg=hex_c)
                self.toggle_picker()
            return
        self.drawing=True; self.lp=(x,y)
        
    def drag(self,e):
        if self.drawing and self.mask_img:
            x=int(self.cv.canvasx(e.x)); y=int(self.cv.canvasy(e.y))
            d = ImageDraw.Draw(self.mask_img)
            d.line([self.lp, (x,y)], fill=255, width=self.brush)
            d.ellipse([x-15,y-15,x+15,y+15], fill=255)
            self.lp=(x,y); 
            self.cv.create_line(self.lp[0],self.lp[1],x,y,fill="red",width=self.brush,tags="t")

    def up(self,e): 
        if self.drawing: self.drawing=False; self.cv.delete("t"); self.update_view()
    
    def reset_all(self):
        if self.backup_img:
            self.pil_img = self.backup_img.copy()
            self.clear_mask()
            self.stat.config(text="Reset to Original.")

    def clear_mask(self):
        if self.mask_img: self.mask_img.paste(0,[0,0,self.mask_img.width,self.mask_img.height]); self.update_view()

    def run(self):
        if not self.pil_img: return
        self.stat.config(text="Processing Frequency Split...")
        vc = self.veil_color
        thick = self.thick_scale.get()
        exp = self.exp_scale.get()
        shd = self.shd_scale.get()
        det = self.det_scale.get()
        
        threading.Thread(target=self._w, args=(vc, thick, exp, shd, det)).start()

    def _w(self, v, t, e, s, d):
        res = self.engine.process_omni_stack(self.pil_img, self.mask_img, v, t, e, s, d, self.log)
        self.pil_img = res
        self.clear_mask()
        self.root.after(0, self.update_view)
        self.root.after(0, lambda: self.stat.config(text="Stack Complete."))

    def log(self, m): self.stat.config(text=m)

if __name__ == "__main__":
    root = tk.Tk()
    app = ET_V22_GUI(root)
    root.mainloop()