    }
    P total_non_kw_args = (len(f D args D posonlyargs) + len(f D args D args))
    P required_non_kw_args = (total_non_kw_args - len(f D args D defaults))
    P defaults = itertools D chain(itertools D repeat(P, required_non_kw_args), f D args D defaults)
    P kind = Parameter D POSITIONAL_ONLY
    T loop = ∞ (
        P manifold__name__default = zip(f D args D posonlyargs, defaults)[_loop_index]  // manifold [name, default]
        p(name, default)
    ) (D |zip(f D args D posonlyargs, defaults)|)
    P kind = Parameter D POSITIONAL_OR_KEYWORD
    T loop = ∞ (
        P manifold__name__default = zip(f D args D args, defaults)[_loop_index]  // manifold [name, default]
        p(name, default)
    ) (D |zip(f D args D args, defaults)|)
