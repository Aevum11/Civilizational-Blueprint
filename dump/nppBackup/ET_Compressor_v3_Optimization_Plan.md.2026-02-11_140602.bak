### 4.8 — Section 12: Unified Hash Pass

**Requires: Eq 243 (Coherence Hash Unification)**

```python
class UnifiedHasher:
    """Eq 243: Single-pass multi-hash computation."""
    
    def __init__(self):
        self.sha256_full = hashlib.sha256()
        self.merkle_leaves: List[str] = []
        self.cas_addresses: List[str] = []
    
    def update_block(self, block: bytes) -> str:
        """Process one block, updating all three hash streams."""
        # SHA-256 for Merkle leaf AND full-file hash
        block_hash = hashlib.sha256(block).hexdigest()
        self.sha256_full.update(block)
        self.merkle_leaves.append(block_hash)
        # SHA-1 for CAS (different hash, but same data read)
        cas_addr = hashlib.sha1(block).hexdigest()
        self.cas_addresses.append(cas_addr)
        return cas_addr
    
    def finalize(self) -> Tuple[bytes, str, List[str]]:
        """Return (file_sha256, merkle_root, cas_addresses)."""
        file_hash = self.sha256_full.digest()
        merkle = ETMath.merkle_root_from_hashes(self.merkle_leaves)  # NEW: operates on pre-computed hashes
        return file_hash, merkle, self.cas_addresses
```

