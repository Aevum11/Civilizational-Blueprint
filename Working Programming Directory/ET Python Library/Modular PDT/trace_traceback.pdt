D print_list = λ extracted_list, file . {
    // Print the list of tuples as returned by extract_tb() or     extract_stack() as a formatted stack trace to the given file
    T cond = → if file == P → P file = sys D stderr
    T loop = ∞ (
        P item = StackSummary D from_list(extracted_list) D format(P)[_loop_index]
        sovereign_print ∘ item
    ) (D |StackSummary D from_list(extracted_list) D format(P)|)
}
