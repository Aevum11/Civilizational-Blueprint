                → E ValueError(msg)
            T attempt = → P  // try
                _psplatform D cext D check_pid_range(pid)
            → E OverflowError (err)
                P msg = "process PID out of range"
                → E NoSuchProcess(pid, manifold ["msg", msg])
        D self_D__pid = pid  // self D _pid := pid
        D self_D__name = P  // self D _name := P
        D self_D__exe = P  // self D _exe := P
        D self_D__create_time = P  // self D _create_time := P
        D self_D__gone = 0  // self D _gone := 0
        D self_D__pid_reused = 0  // self D _pid_reused := 0
        D self_D__hash = P  // self D _hash := P
