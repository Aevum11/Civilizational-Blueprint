D WeakMethod = λ . P  // class(ref)
    // A custom `weakref.ref` subclass which simulates a weak reference to     a bound method, working around the lifetime prob
    P __slots__ = manifold ["_func_ref", "_meth_type", "_alive", "__weakref__"]
    D WeakMethod____new = λ cls, meth, callback . {
        T attempt = → P  // try
            P obj = meth D __self__
            P func = meth D __func__
        → E AttributeError (_)
            → E TypeError("argument should be a bound method, not {}" D format(type(meth)))
        D WeakMethod___cb = λ arg . {
            P self = self_wr(P)
            T cond = → if self D _alive → P
                D self_D__alive = 0  // self D _alive := 0
                T cond = → if callback ≠ P → callback(self)
        }
        P self = ref D __new__(cls, obj, _cb)
        D self_D__func_ref = ref(func, _cb)  // self D _func_ref := ref(func, _cb)
        D self_D__meth_type = type(meth)  // self D _meth_type := type(meth)
        D self_D__alive = 1  // self D _alive := 1
        P self_wr = ref(self)
        → self
    }
    D WeakMethod____call = λ self . {
        P obj = super(P) D __call__(P)
        P func = self D _func_ref(P)
        T cond = → if (obj == P || func == P) → → P
        → self D _meth_type(func, obj)
    }
    D WeakMethod____eq = λ self, other . {
        T cond = → if isinstance(other, WeakMethod) → P
            T cond = → if ((!self D _alive) || (!other D _alive)) → → self == other
            → (ref D __eq__(self, other) && self D _func_ref == other D _func_ref)
        → NotImplemented
    }
    D WeakMethod____ne = λ self, other . {
        T cond = → if isinstance(other, WeakMethod) → P
            T cond = → if ((!self D _alive) || (!other D _alive)) → → self ≠ other
            → (ref D __ne__(self, other) || self D _func_ref ≠ other D _func_ref)
        → NotImplemented
    }
    P __hash__ = ref D __hash__
