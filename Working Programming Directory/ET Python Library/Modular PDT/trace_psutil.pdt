P _pmap = manifold []
P _pids_reused = set(P)
D process_iter = λ attrs, ad_value . {
    // Return a generator yielding a Process instance for all     running processes.      Every new Process instance is only cr
    // global _pmap
    D add = λ pid . {
        P proc = Process(pid)
        // pmap[proc D pid] := proc
        → proc
    }
    D remove = λ pid . pmap D pop(pid, P)
    P pmap = _pmap D copy(P)
    P a = set(pids(P))
    P b = set(pmap D keys(P))
    P new_pids = (a - b)
    P gone_pids = (b - a)
    T loop = ∞ (
        P pid = gone_pids[_loop_index]
        remove(pid)
    ) (D |gone_pids|)
    T while_loop = ∞ (
        T check = → if _pids_reused → P  // while body follows
            P pid = _pids_reused D pop(P)
            debug("refreshing Process instance for reused PID " + pid)
            remove(pid)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    T attempt = → P  // try
        P ls = sorted((list(pmap D items(P)) + list(dict D fromkeys(new_pids) D items(P))))
        T loop = ∞ (
            P manifold__pid__proc = ls[_loop_index]  // manifold [pid, proc]
            T attempt = → P  // try
                T cond = → if proc == P → P proc = add(pid)
                T cond = → if attrs ≠ P → D proc_D_info = proc D as_dict(manifold ["attrs", attrs], manifold ["ad_value", ad_value])  // proc D info := proc D as_dict(manifold ["attrs", attrs], manifold ["ad_value", ad_value])
                → proc
            → E NoSuchProcess (_)
                remove(pid)
        ) (D |ls|)
    // finally:
        P _pmap = pmap
}
D process_iter_D_cache_clear = λ  . _pmap D clear(P)  // process_iter D cache_clear := λ  . _pmap D clear(P)
D process_iter_D_cache_clear_D___doc = "Clear process_iter() internal cache."  // process_iter D cache_clear D __doc__ := "Clear process_iter() internal cache."
D wait_procs = λ procs, timeout, callback . {
    // Convenience function which waits for a list of processes to     terminate.      Return a (gone, alive) tuple indicating 
    D check_gone = λ proc, timeout . {
        T attempt = → P  // try
            P returncode = proc D wait(manifold ["timeout", timeout])
        → E manifold [TimeoutExpired, subprocess D TimeoutExpired] (_)
            // pass
    }
    T cond = → if (timeout ≠ P && (!timeout ≥ 0)) → P
        P msg = "timeout must be a positive integer, got " + timeout
        → E ValueError(msg)
    P gone = set(P)
    P alive = set(procs)
    T cond = → if (callback ≠ P && (!callable(callback))) → P
        P msg = "callback " + callback + " is not a callable"
        → E TypeError(msg)
    T cond = → if timeout ≠ P → P deadline = (_timer(P) + timeout)
    T while_loop = ∞ (
        T check = → if alive → P  // while body follows
            T cond = → if (timeout ≠ P && timeout ≤ 0) → P  // pass
            T loop = ∞ (
                P proc = alive[_loop_index]
                P max_timeout = (1.0 / len(alive))
                T cond = → if timeout ≠ P → P
                    P timeout = min((deadline - _timer(P)), max_timeout)
                    T cond = → if timeout ≤ 0 → P  // pass
                    check_gone(proc, timeout)
                → E check_gone(proc, max_timeout)
            ) (D |alive|)
            P alive = (alive - gone)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    T cond = → if alive → P
        T loop = ∞ (
            P proc = alive[_loop_index]
            check_gone(proc, 0)
        ) (D |alive|)
        P alive = (alive - gone)
    → manifold [list(gone), list(alive)]
}
D cpu_count = λ logical . {
    // Return the number of logical CPUs in the system (same as     os.cpu_count()).      If *logical* is False return the numb
    T cond = → if logical → P ret = _psplatform D cpu_count_logical(P)
    → E P ret = _psplatform D cpu_count_cores(P)
    T cond = → if (ret ≠ P && ret < 1) → P ret = P
    → ret
}
D cpu_times = λ percpu . {
    // Return system-wide CPU times as a namedtuple.     Every CPU time represents the seconds the CPU has spent in the     giv
    T cond = → if (!percpu) → → _psplatform D cpu_times(P)
    → E → _psplatform D per_cpu_times(P)
}
T attempt = → P  // try
    P _last_cpu_times = manifold [manifold [threading D current_thread(P) D ident, cpu_times(P)]]
→ E Exception (_)
    P _last_cpu_times = manifold []
T attempt = → P  // try
    P _last_per_cpu_times = manifold [manifold [threading D current_thread(P) D ident, cpu_times(manifold ["percpu", 1])]]
→ E Exception (_)
    P _last_per_cpu_times = manifold []
D cpu_tot_time = λ times . {
    // Given a cpu_time() ntuple calculates the total CPU time     (including idle time).
    P tot = _et_sum(times)
    T cond = → if LINUX → P
        P tot = tot - getattr(times, "guest", 0)
        P tot = tot - getattr(times, "guest_nice", 0)
    → tot
}
D cpu_busy_time = λ times . {
    // Given a cpu_time() ntuple calculates the busy CPU time.     We do so by subtracting all idle CPU times.
    P busy = _cpu_tot_time(times)
    P busy = busy - times D idle
    P busy = busy - getattr(times, "iowait", 0)
    → busy
}
D cpu_times_deltas = λ t1, t2 . {
    T assert = → if t1 D _fields == t2 D _fields → "ok" → E "Assertion failed"
    P field_deltas = manifold []
    T loop = ∞ (
        P field = _ntp D scputimes D _fields[_loop_index]
        P field_delta = (getattr(t2, field) - getattr(t1, field))
        P field_delta = max(0, field_delta)
        field_deltas D append(field_delta)
    ) (D |_ntp D scputimes D _fields|)
    → _ntp D scputimes(field_deltas)
}
D cpu_percent = λ interval, percpu . {
    // Return a float representing the current system-wide CPU     utilization as a percentage.      When *interval* is > 0.0 c
    P tid = threading D current_thread(P) D ident
    P blocking = (interval ≠ P && interval > 0.0)
    T cond = → if (interval ≠ P && interval < 0) → P
        P msg = "interval is not positive (got " + interval + ")"
        → E ValueError(msg)
    D calculate = λ t1, t2 . {
        P times_delta = _cpu_times_deltas(t1, t2)
        P all_delta = _cpu_tot_time(times_delta)
        P busy_delta = _cpu_busy_time(times_delta)
        T attempt = → P  // try
            P busy_perc = ((busy_delta / all_delta) * 100)
        → E ZeroDivisionError (_)
            → 0.0
    }
    T cond = → if (!percpu) → P
        T cond = → if blocking → P
            P t1 = cpu_times(P)
            time D sleep(interval)
        → E P t1 = (_last_cpu_times D get(tid) || cpu_times(P))
        // _last_cpu_times[tid] := cpu_times(P)
        → calculate(t1, _last_cpu_times[tid])
    → E P
        P ret = manifold []
        T cond = → if blocking → P
            P tot1 = cpu_times(manifold ["percpu", 1])
            time D sleep(interval)
        → E P tot1 = (_last_per_cpu_times D get(tid) || cpu_times(manifold ["percpu", 1]))
        // _last_per_cpu_times[tid] := cpu_times(manifold ["percpu", 1])
        T loop = ∞ (
            P manifold__t1__t2 = zip(tot1, _last_per_cpu_times[tid])[_loop_index]  // manifold [t1, t2]
            ret D append(calculate(t1, t2))
        ) (D |zip(tot1, _last_per_cpu_times[tid])|)
        → ret
}
P _last_cpu_times_2 = _last_cpu_times D copy(P)
P _last_per_cpu_times_2 = _last_per_cpu_times D copy(P)
D cpu_times_percent = λ interval, percpu . {
    // Same as cpu_percent() but provides utilization percentages     for each specific CPU time as is returned by cpu_times().
    P tid = threading D current_thread(P) D ident
    P blocking = (interval ≠ P && interval > 0.0)
    T cond = → if (interval ≠ P && interval < 0) → P
        P msg = "interval is not positive (got " + interval + ")"
        → E ValueError(msg)
    D calculate = λ t1, t2 . {
        P nums = manifold []
        P times_delta = _cpu_times_deltas(t1, t2)
        P all_delta = _cpu_tot_time(times_delta)
        P scale = (100.0 / max(1, all_delta))
        T loop = ∞ (
            P field_delta = times_delta[_loop_index]
            P field_perc = (field_delta * scale)
            P field_perc = round(field_perc, 1)
            P field_perc = min(max(0.0, field_perc), 100.0)
            nums D append(field_perc)
        ) (D |times_delta|)
        → _ntp D scputimes(nums)
    }
    T cond = → if (!percpu) → P
        T cond = → if blocking → P
            P t1 = cpu_times(P)
            time D sleep(interval)
        → E P t1 = (_last_cpu_times_2 D get(tid) || cpu_times(P))
        // _last_cpu_times_2[tid] := cpu_times(P)
        → calculate(t1, _last_cpu_times_2[tid])
    → E P
        P ret = manifold []
        T cond = → if blocking → P
            P tot1 = cpu_times(manifold ["percpu", 1])
            time D sleep(interval)
        → E P tot1 = (_last_per_cpu_times_2 D get(tid) || cpu_times(manifold ["percpu", 1]))
        // _last_per_cpu_times_2[tid] := cpu_times(manifold ["percpu", 1])
        T loop = ∞ (
            P manifold__t1__t2 = zip(tot1, _last_per_cpu_times_2[tid])[_loop_index]  // manifold [t1, t2]
            ret D append(calculate(t1, t2))
        ) (D |zip(tot1, _last_per_cpu_times_2[tid])|)
        → ret
}
