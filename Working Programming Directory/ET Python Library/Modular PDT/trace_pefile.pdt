        P fixedfileinfo_struct = self D __unpack_data__(self D __VS_FIXEDFILEINFO_format__, raw_data[fixedfileinfo_offset:Ω], manifold ["file_offset", (start_offset + fixedfileinfo_offset)])
        T cond = → if (!fixedfileinfo_struct) → → P
