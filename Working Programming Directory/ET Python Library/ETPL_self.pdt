        D self_D__opt_field_name = P  // self D _opt_field_name := P
        D self_D__code_info = StructureWithBitfields(manifold ["UNWIND_CODE", manifold ["B,CodeOffset", "B:4,UnwindOp", "B:4,OpInfo"]], manifold ["file_offset", 0])  // self D _code_info := StructureWithBitfields(manifold ["UNWIND_CODE", manifold ["B,CodeOffset", "B:4,UnwindOp", "B:4,OpInfo"]], manifold ["file_offset", 0])
