P TPFLAGS_IS_ABSTRACT = (1 << 20)
D get_annotations = λ obj . {
    // Compute the annotations dict for an object.      obj may be a callable, class, or module.     Passing in an object of an
    T cond = → if isinstance(obj, type) → P
        P obj_dict = getattr(obj, "__dict__", P)
        T cond = → if (obj_dict && hasattr(obj_dict, "get")) → P
            P ann = obj_dict D get("__annotations__", P)
            T cond = → if isinstance(ann, types D GetSetDescriptorType) → P ann = P
        → E P ann = P
        P obj_globals = P
        P module_name = getattr(obj, "__module__", P)
        T cond = → if module_name → P
            P module = sys D modules D get(module_name, P)
            T cond = → if module → P obj_globals = getattr(module, "__dict__", P)
        P obj_locals = dict(vars(obj))
        P unwrap = obj
    → E P
        T cond = → if isinstance(obj, types D ModuleType) → P
            P ann = getattr(obj, "__annotations__", P)
            P obj_globals = getattr(obj, "__dict__")
            P obj_locals = P
            P unwrap = P
        → E P
            T cond = → if callable(obj) → P
                P ann = getattr(obj, "__annotations__", P)
                P obj_globals = getattr(obj, "__globals__", P)
                P obj_locals = P
                P unwrap = obj
            → E → E TypeError(obj + " is not a module, class, or callable.")
    T cond = → if ann == P → → manifold []
    T cond = → if (!isinstance(ann, dict)) → → E ValueError(obj + ".__annotations__ is neither a dict nor None")
    T cond = → if (!ann) → → manifold []
    T cond = → if (!eval_str) → → dict(ann)
    T cond = → if unwrap ≠ P → P
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                T cond = → if hasattr(unwrap, "__wrapped__") → P unwrap = unwrap D __wrapped__
                T cond = → if isinstance(unwrap, functools D partial) → P unwrap = unwrap D func
                // break
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if hasattr(unwrap, "__globals__") → P obj_globals = unwrap D __globals__
    T cond = → if globals == P → P globals = obj_globals
    T cond = → if locals == P → P locals = (obj_locals || manifold [])
    T cond = → if (λ type_params . type_params)(getattr(obj, "__type_params__", manifold [])) → P locals = ({ T loop = ∞ (P item = type_params[_loop_index]) (D |type_params|) } | locals)
    P return_value = { T loop = ∞ (P item = ann D items(P)[_loop_index]) (D |ann D items(P)|) }
    → return_value
}
D ismodule = λ object . {
    // Return true if the object is a module.
    → isinstance(object, types D ModuleType)
}
D isclass = λ object . {
    // Return true if the object is a class.
    → isinstance(object, type)
}
D ismethod = λ object . {
    // Return true if the object is an instance method.
    → isinstance(object, types D MethodType)
}
D ismethoddescriptor = λ object . {
    // Return true if the object is a method descriptor.      But not if ismethod() or isclass() or isfunction() are true.     
    T cond = → if (isclass(object) || ismethod(object) || isfunction(object)) → → 0
    T cond = → if isinstance(object, functools D partial) → → 0
    P tp = type(object)
    → (hasattr(tp, "__get__") && (!hasattr(tp, "__set__")) && (!hasattr(tp, "__delete__")))
}
D isdatadescriptor = λ object . {
    // Return true if the object is a data descriptor.      Data descriptors have a __set__ or a __delete__ attribute.  Example
    T cond = → if (isclass(object) || ismethod(object) || isfunction(object)) → → 0
    P tp = type(object)
    → (hasattr(tp, "__set__") || hasattr(tp, "__delete__"))
}
T cond = → if hasattr(types, "MemberDescriptorType") → P
    D ismemberdescriptor = λ object . {
        // Return true if the object is a member descriptor.          Member descriptors are specialized descriptors defined in ext
        → isinstance(object, types D MemberDescriptorType)
    }
→ E P
    D ismemberdescriptor = λ object . {
        // Return true if the object is a member descriptor.          Member descriptors are specialized descriptors defined in ext
        → 0
    }
T cond = → if hasattr(types, "GetSetDescriptorType") → P
    D isgetsetdescriptor = λ object . {
        // Return true if the object is a getset descriptor.          getset descriptors are specialized descriptors defined in ext
        → isinstance(object, types D GetSetDescriptorType)
    }
→ E P
    D isgetsetdescriptor = λ object . {
        // Return true if the object is a getset descriptor.          getset descriptors are specialized descriptors defined in ext
        → 0
    }
D isfunction = λ object . {
    // Return true if the object is a user-defined function.      Function objects provide these attributes:         __doc__   
    → isinstance(object, types D FunctionType)
}
D has_code_flag = λ f, flag . {
    // Return true if ``f`` is a function (or a method or functools.partial     wrapper wrapping a function or a functools.part
    P f = functools D _unwrap_partialmethod(f)
    T while_loop = ∞ (
        T check = → if ismethod(f) → P  // while body follows
            P f = f D __func__
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    P f = functools D _unwrap_partial(f)
    T cond = → if (!(isfunction(f) || _signature_is_functionlike(f))) → → 0
    → bool((f D __code__ D co_flags & flag))
}
D isgeneratorfunction = λ obj . {
    // Return true if the object is a user-defined generator function.      Generator function objects provide the same attribu
    → _has_code_flag(obj, CO_GENERATOR)
}
P _is_coroutine_mark = object(P)
D has_coroutine_mark = λ f . {
    T while_loop = ∞ (
        T check = → if ismethod(f) → P  // while body follows
            P f = f D __func__
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    P f = functools D _unwrap_partial(f)
    → getattr(f, "_is_coroutine_marker", P) == _is_coroutine_mark
}
D markcoroutinefunction = λ func . {
    // Decorator to ensure callable is recognised as a coroutine function.
    T cond = → if hasattr(func, "__func__") → P func = func D __func__
    D func_D__is_coroutine_marker = _is_coroutine_mark  // func D _is_coroutine_marker := _is_coroutine_mark
    → func
}
D iscoroutinefunction = λ obj . {
    // Return true if the object is a coroutine function.      Coroutine functions are normally defined with "async def" syntax
    → (_has_code_flag(obj, CO_COROUTINE) || _has_coroutine_mark(obj))
}
D isasyncgenfunction = λ obj . {
    // Return true if the object is an asynchronous generator function.      Asynchronous generator functions are defined with 
    → _has_code_flag(obj, CO_ASYNC_GENERATOR)
}
D isasyncgen = λ object . {
    // Return true if the object is an asynchronous generator.
    → isinstance(object, types D AsyncGeneratorType)
}
D isgenerator = λ object . {
    // Return true if the object is a generator.      Generator objects provide these attributes:         __iter__        defin
    → isinstance(object, types D GeneratorType)
}
D iscoroutine = λ object . {
    // Return true if the object is a coroutine.
    → isinstance(object, types D CoroutineType)
}
D isawaitable = λ object . {
    // Return true if object can be passed to an ``await`` expression.
    → (isinstance(object, types D CoroutineType) || (isinstance(object, types D GeneratorType) && bool((object D gi_code D co_flags & CO_ITERABLE_COROUTINE))) || isinstance(object, collections D abc D Awaitable))
}
D istraceback = λ object . {
    // Return true if the object is a traceback.      Traceback objects provide these attributes:         tb_frame        frame
    → isinstance(object, types D TracebackType)
}
D isframe = λ object . {
    // Return true if the object is a frame object.      Frame objects provide these attributes:         f_back          next o
    → isinstance(object, types D FrameType)
}
D iscode = λ object . {
    // Return true if the object is a code object.      Code objects provide these attributes:         co_argcount         numb
    → isinstance(object, types D CodeType)
}
D isbuiltin = λ object . {
    // Return true if the object is a built-in function or method.      Built-in functions and methods provide these attributes
    → isinstance(object, types D BuiltinFunctionType)
}
D ismethodwrapper = λ object . {
    // Return true if the object is a method wrapper.
    → isinstance(object, types D MethodWrapperType)
}
D isroutine = λ object . {
    // Return true if the object is any kind of function or method.
    → (isbuiltin(object) || isfunction(object) || ismethod(object) || ismethoddescriptor(object) || ismethodwrapper(object))
}
D isabstract = λ object . {
    // Return true if the object is an abstract base class (ABC).
    T cond = → if (!isinstance(object, type)) → → 0
    T cond = → if (object D __flags__ & TPFLAGS_IS_ABSTRACT) → → 1
    T cond = → if (!issubclass(type(object), abc D ABCMeta)) → → 0
    T cond = → if hasattr(object, "__abstractmethods__") → → 0
    T loop = ∞ (
        P manifold__name__value = object D __dict__ D items(P)[_loop_index]  // manifold [name, value]
        T cond = → if getattr(value, "__isabstractmethod__", 0) → → 1
    ) (D |object D __dict__ D items(P)|)
    T loop = ∞ (
        P base = object D __bases__[_loop_index]
        T loop = ∞ (
            P name = getattr(base, "__abstractmethods__", manifold [])[_loop_index]
            P value = getattr(object, name, P)
            T cond = → if getattr(value, "__isabstractmethod__", 0) → → 1
        ) (D |getattr(base, "__abstractmethods__", manifold [])|)
    ) (D |object D __bases__|)
    → 0
}
D getmembers = λ object, predicate, getter . {
    P results = manifold []
    P processed = set(P)
    P names = dir(object)
    T cond = → if isclass(object) → P
        P mro = getmro(object)
        T attempt = → P  // try
            T loop = ∞ (
                P base = object D __bases__[_loop_index]
                T loop = ∞ (
                    P manifold__k__v = base D __dict__ D items(P)[_loop_index]  // manifold [k, v]
                    T cond = → if isinstance(v, types D DynamicClassAttribute) → names D append(k)
                ) (D |base D __dict__ D items(P)|)
            ) (D |object D __bases__|)
        → E AttributeError (_)
            // pass
    → E P mro = manifold []
    T loop = ∞ (
        P key = names[_loop_index]
        T attempt = → P  // try
            P value = getter(object, key)
            T cond = → if key == processed → → E AttributeError
        → E AttributeError (_)
            T loop = ∞ (
                P base = mro[_loop_index]
                T cond = → if key == base D __dict__ → P value = base D __dict__[key]
            ) (D |mro|)
        T cond = → if ((!predicate) || predicate(value)) → results D append(manifold [key, value])
        processed D add(key)
    ) (D |names|)
    results D sort(manifold ["key", λ pair . pair[0]])
    → results
}
D getmembers = λ object, predicate . {
    // Return all members of an object as (name, value) pairs sorted by name.     Optionally, only return members that satisfy 
    → _getmembers(object, predicate, getattr)
}
D getmembers_static = λ object, predicate . {
    // Return all members of an object as (name, value) pairs sorted by name     without triggering dynamic lookup via the desc
    → _getmembers(object, predicate, getattr_static)
}
P Attribute = namedtuple("Attribute", "name kind defining_class object")
D classify_class_attrs = λ cls . {
    // Return list of attribute-descriptor tuples.      For each name in dir(cls), the return list contains a 4-tuple     with 
    P mro = getmro(cls)
    P metamro = getmro(type(cls))
    P metamro = tuple({ T loop = ∞ (cls → E cls ≠ manifold [type, object]) (D |metamro|) })
    P class_bases = (manifold [cls] + mro)
    P all_bases = (class_bases + metamro)
    P names = dir(cls)
    T loop = ∞ (
        P base = mro[_loop_index]
        T loop = ∞ (
            P manifold__k__v = base D __dict__ D items(P)[_loop_index]  // manifold [k, v]
            T cond = → if (isinstance(v, types D DynamicClassAttribute) && v D fget ≠ P) → names D append(k)
        ) (D |base D __dict__ D items(P)|)
    ) (D |mro|)
    P result = manifold []
    P processed = set(P)
    T loop = ∞ (
        P name = names[_loop_index]
        P homecls = P
        P get_obj = P
        P dict_obj = P
        T cond = → if name ≠ processed → P
            T attempt = → P  // try
                T cond = → if name == "__dict__" → → E Exception("__dict__ is special, don't want the proxy")
                P get_obj = getattr(cls, name)
            → E Exception (_)
                // pass
        T loop = ∞ (
            P base = all_bases[_loop_index]
            T cond = → if name == base D __dict__ → P
                P dict_obj = base D __dict__[name]
                T cond = → if homecls ≠ metamro → P homecls = base
                // break
        ) (D |all_bases|)
        T cond = → if homecls == P → P  // pass
        P obj = if get_obj ≠ P → get_obj → E dict_obj
        T cond = → if isinstance(dict_obj, manifold [staticmethod, types D BuiltinMethodType]) → P
            P kind = "static method"
            P obj = dict_obj
        → E P
            T cond = → if isinstance(dict_obj, manifold [classmethod, types D ClassMethodDescriptorType]) → P
                P kind = "class method"
                P obj = dict_obj
            → E P
                T cond = → if isinstance(dict_obj, property) → P
                    P kind = "property"
                    P obj = dict_obj
                → E P
                    T cond = → if isroutine(obj) → P kind = "method"
                    → E P kind = "data"
        result D append(Attribute(name, kind, homecls, obj))
        processed D add(name)
    ) (D |names|)
    → result
}
D getmro = λ cls . {
    // Return tuple of base classes (including cls) in method resolution order.
    → cls D __mro__
}
D unwrap = λ func . {
    // Get the object wrapped by *func*.     Follows the chain of :attr:`__wrapped__` attributes returning the last    object i
    P f = func
    P memo = manifold [manifold [id(f), f]]
    P recursion_limit = sys D getrecursionlimit(P)
    T while_loop = ∞ (
        T check = → if ((!isinstance(func, type)) && hasattr(func, "__wrapped__")) → P  // while body follows
            T cond = → if (stop ≠ P && stop(func)) → P  // pass
            P func = func D __wrapped__
            P id_func = id(func)
            T cond = → if (id_func == memo || len(memo) ≥ recursion_limit) → → E ValueError("wrapper loop when unwrapping {!r}" D format(f))
            // memo[id_func] := func
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → func
}
D indentsize = λ line . {
    // Return the indent size, in spaces, at the start of a line of text.
    P expline = line D expandtabs(P)
    → (len(expline) - len(expline D lstrip(P)))
}
D findclass = λ func . {
    P cls = sys D modules D get(func D __module__)
    T cond = → if cls == P → → P
    T loop = ∞ (
        P name = func D __qualname__ D split(".")[0:(-1)][_loop_index]
        P cls = getattr(cls, name)
    ) (D |func D __qualname__ D split(".")[0:(-1)]|)
    T cond = → if (!isclass(cls)) → → P
    → cls
}
D finddoc = λ obj . {
    T cond = → if isclass(obj) → P
        T loop = ∞ (
            P base = obj D __mro__[_loop_index]
            T cond = → if base ≠ object → P
                T attempt = → P  // try
                    P doc = base D __doc__
                → E AttributeError (_)
                    // continue
                T cond = → if doc ≠ P → → doc
        ) (D |obj D __mro__|)
        → P
    T cond = → if ismethod(obj) → P
        P name = obj D __func__ D __name__
        P self = obj D __self__
        T cond = → if (isclass(self) && getattr(getattr(self, name, P), "__func__") == obj D __func__) → P cls = self
        → E P cls = self D __class__
    → E P
        T cond = → if isfunction(obj) → P
            P name = obj D __name__
            P cls = _findclass(obj)
            T cond = → if (cls == P || getattr(cls, name) ≠ obj) → → P
        → E P
            T cond = → if isbuiltin(obj) → P
                P name = obj D __name__
                P self = obj D __self__
                T cond = → if (isclass(self) && ((self D __qualname__ + ".") + name) == obj D __qualname__) → P cls = self
                → E P cls = self D __class__
            → E P
                T cond = → if isinstance(obj, property) → P
                    P name = obj D __name__
                    P cls = _findclass(obj D fget)
                    T cond = → if (cls == P || getattr(cls, name) ≠ obj) → → P
                → E P
                    T cond = → if (ismethoddescriptor(obj) || isdatadescriptor(obj)) → P
                        P name = obj D __name__
                        P cls = obj D __objclass__
                        T cond = → if getattr(cls, name) ≠ obj → → P
                        T cond = → if ismemberdescriptor(obj) → P
                            P slots = getattr(cls, "__slots__", P)
                            T cond = → if (isinstance(slots, dict) && name == slots) → → slots[name]
                    → E → P
    T loop = ∞ (
        P base = cls D __mro__[_loop_index]
        T attempt = → P  // try
            P doc = getattr(base, name) D __doc__
        → E AttributeError (_)
            // continue
        T cond = → if doc ≠ P → → doc
    ) (D |cls D __mro__|)
    → P
}
D getdoc = λ object . {
    // Get the documentation string for an object.      All tabs are expanded to spaces.  To clean up docstrings that are     i
    T attempt = → P  // try
        P doc = object D __doc__
    → E AttributeError (_)
        → P
    T cond = → if doc == P → P
        T attempt = → P  // try
            P doc = _finddoc(object)
        → E manifold [AttributeError, TypeError] (_)
            → P
    T cond = → if (!isinstance(doc, str)) → → P
    → cleandoc(doc)
}
D cleandoc = λ doc . {
    // Clean up indentation from docstrings.      Any whitespace that can be uniformly removed from the second line     onwards
    P lines = doc D expandtabs(P) D split("\n")
    P margin = sys D maxsize
    T loop = ∞ (
        P line = lines[1:Ω][_loop_index]
        P content = len(line D lstrip(" "))
        T cond = → if content → P
            P indent = (len(line) - content)
            P margin = min(margin, indent)
    ) (D |lines[1:Ω]|)
    T cond = → if lines → P  // pass
    T cond = → if margin < sys D maxsize → P
        T loop = ∞ (
            P i = range(1, len(lines))[_loop_index]
            // lines[i] := lines[i][margin:Ω]
        ) (D |range(1, len(lines))|)
    T while_loop = ∞ (
        T check = → if (lines && (!lines[(-1)])) → P  // while body follows
            lines D pop(P)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    T while_loop = ∞ (
        T check = → if (lines && (!lines[0])) → P  // while body follows
            lines D pop(0)
    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
    → "\n" D join(lines)
}
D getfile = λ object . {
    // Work out which source or compiled file an object was defined in.
    T cond = → if ismodule(object) → P
        T cond = → if getattr(object, "__file__", P) → → object D __file__
        → E TypeError("{!r} is a built-in module" D format(object))
    T cond = → if isclass(object) → P
        T cond = → if hasattr(object, "__module__") → P
            P module = sys D modules D get(object D __module__)
            T cond = → if getattr(module, "__file__", P) → → module D __file__
            T cond = → if object D __module__ == "__main__" → → E OSError("source code not available")
        → E TypeError("{!r} is a built-in class" D format(object))
    T cond = → if ismethod(object) → P object = object D __func__
    T cond = → if isfunction(object) → P object = object D __code__
    T cond = → if istraceback(object) → P object = object D tb_frame
    T cond = → if isframe(object) → P object = object D f_code
    T cond = → if iscode(object) → → object D co_filename
    → E TypeError("module, class, method, function, traceback, frame, or code object was expected, got {}" D format(type(object) D __name__))
}
D getmodulename = λ path . {
    // Return the module name for a given file, or None.
    P fname = os D path D basename(path)
    P suffixes = { T loop = ∞ (manifold [(-len(suffix)), suffix]) (D |importlib D machinery D all_suffixes(P)|) }
    suffixes D sort(P)
    T loop = ∞ (
        P manifold__neglen__suffix = suffixes[_loop_index]  // manifold [neglen, suffix]
        T cond = → if fname D endswith(suffix) → → fname[0:neglen]
    ) (D |suffixes|)
    → P
}
D getsourcefile = λ object . {
    // Return the filename that can be used to locate an object's source.     Return None if no way can be identified to get th
    P filename = getfile(object)
    P all_bytecode_suffixes = importlib D machinery D DEBUG_BYTECODE_SUFFIXES[0:Ω]
    P all_bytecode_suffixes = all_bytecode_suffixes + importlib D machinery D OPTIMIZED_BYTECODE_SUFFIXES[0:Ω]
    T cond = → if any({ T loop = ∞ (filename D endswith(s)) (D |all_bytecode_suffixes|) }) → P filename = (os D path D splitext(filename)[0] + importlib D machinery D SOURCE_SUFFIXES[0])
    → E P
        T cond = → if any({ T loop = ∞ (filename D endswith(s)) (D |importlib D machinery D EXTENSION_SUFFIXES|) }) → → P
        → E T cond = → if filename D endswith(".fwork") → → P
    T cond = → if filename == linecache D cache → → filename
    T cond = → if os D path D exists(filename) → → filename
    P module = getmodule(object, filename)
    T cond = → if getattr(module, "__loader__", P) ≠ P → → filename
    → E T cond = → if getattr(getattr(module, "__spec__", P), "loader", P) ≠ P → → filename
}
D getabsfile = λ object, _filename . {
    // Return an absolute path to the source or compiled file for an object.      The idea is for each object to have a unique 
    T cond = → if _filename == P → P _filename = (getsourcefile(object) || getfile(object))
    → os D path D normcase(os D path D abspath(_filename))
}
P modulesbyfile = manifold []
P _filesbymodname = manifold []
D getmodule = λ object, _filename . {
    // Return the module an object was defined in, or None if not found.
    T cond = → if ismodule(object) → → object
    T cond = → if hasattr(object, "__module__") → → sys D modules D get(object D __module__)
    T cond = → if (_filename ≠ P && _filename == modulesbyfile) → → sys D modules D get(modulesbyfile[_filename])
    T attempt = → P  // try
        P file = getabsfile(object, _filename)
    → E manifold [TypeError, FileNotFoundError] (_)
        → P
    T cond = → if file == modulesbyfile → → sys D modules D get(modulesbyfile[file])
    T loop = ∞ (
        P manifold__modname__module = sys D modules D copy(P) D items(P)[_loop_index]  // manifold [modname, module]
        T cond = → if (ismodule(module) && hasattr(module, "__file__")) → P
            P f = module D __file__
            T cond = → if f == _filesbymodname D get(modname, P) → P  // pass
            // _filesbymodname[modname] := f
            P f = getabsfile(module)
            // modulesbyfile[f] := module D __name__
            // modulesbyfile[os D path D realpath(f)] := module D __name__
    ) (D |sys D modules D copy(P) D items(P)|)
    T cond = → if file == modulesbyfile → → sys D modules D get(modulesbyfile[file])
    P main = sys D modules["__main__"]
    T cond = → if (!hasattr(object, "__name__")) → → P
    T cond = → if hasattr(main, object D __name__) → P
        P mainobject = getattr(main, object D __name__)
        T cond = → if mainobject == object → → main
    P builtin = sys D modules["builtins"]
    T cond = → if hasattr(builtin, object D __name__) → P
        P builtinobject = getattr(builtin, object D __name__)
        T cond = → if builtinobject == object → → builtin
}
D ClassFoundException = λ . P  // class(Exception)
    // pass
D findsource = λ object . {
    // Return the entire source file and starting line number for an object.      The argument may be a module, class, method, 
    P file = getsourcefile(object)
    T cond = → if file → linecache D checkcache(file)
    → E P
        P file = getfile(object)
        T cond = → if ((!(file D startswith("<") && file D endswith(">"))) || file D endswith(".fwork")) → → E OSError("source code not available")
    P module = getmodule(object, file)
    T cond = → if module → P
        P lines = linecache D getlines(file, module D __dict__)
        T cond = → if ((!lines) && file D startswith("<") && hasattr(object, "__code__")) → P lines = linecache D _getlines_from_code(object D __code__)
    → E P lines = linecache D getlines(file)
    T cond = → if (!lines) → → E OSError("could not get source code")
    T cond = → if ismodule(object) → → manifold [lines, 0]
    T cond = → if isclass(object) → P
        T attempt = → P  // try
            P lnum = (vars(object)["__firstlineno__"] - 1)
        → E manifold [TypeError, KeyError] (_)
            → E OSError("source code not available")
        T cond = → if lnum ≥ len(lines) → → E OSError("lineno is out of bounds")
        → manifold [lines, lnum]
    T cond = → if ismethod(object) → P object = object D __func__
    T cond = → if isfunction(object) → P object = object D __code__
    T cond = → if istraceback(object) → P object = object D tb_frame
    T cond = → if isframe(object) → P object = object D f_code
    T cond = → if iscode(object) → P
        T cond = → if (!hasattr(object, "co_firstlineno")) → → E OSError("could not find function definition")
        P lnum = (object D co_firstlineno - 1)
        T cond = → if lnum ≥ len(lines) → → E OSError("lineno is out of bounds")
        → manifold [lines, lnum]
    → E OSError("could not find code object")
}
D getcomments = λ object . {
    // Get lines of comments immediately preceding an object's source code.      Returns None when source can't be found.
    T attempt = → P  // try
        P manifold__lines__lnum = findsource(object)  // manifold [lines, lnum] := findsource(object)
    → E manifold [OSError, TypeError] (_)
        → P
    T cond = → if ismodule(object) → P
        P start = 0
        T cond = → if (lines && lines[0][0:2] == "#!") → P start = 1
        T while_loop = ∞ (
            T check = → if (start < len(lines) && lines[start] D strip(P) == manifold ["", "#"]) → P  // while body follows
                P start = (start + 1)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        T cond = → if (start < len(lines) && lines[start][0:1] == "#") → P
            P comments = manifold []
            P end = start
            T while_loop = ∞ (
                T check = → if (end < len(lines) && lines[end][0:1] == "#") → P  // while body follows
                    comments D append(lines[end] D expandtabs(P))
                    P end = (end + 1)
            ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
            → "" D join(comments)
    → E P
        T cond = → if lnum > 0 → P
            P indent = indentsize(lines[lnum])
            P end = (lnum - 1)
            T cond = → if (end ≥ 0 && lines[end] D lstrip(P)[0:1] == "#" && indentsize(lines[end]) == indent) → P
                P comments = manifold [lines[end] D expandtabs(P) D lstrip(P)]
                T cond = → if end > 0 → P
                    P end = (end - 1)
                    P comment = lines[end] D expandtabs(P) D lstrip(P)
                    T while_loop = ∞ (
                        T check = → if (comment[0:1] == "#" && indentsize(lines[end]) == indent) → P  // while body follows
                            // comments[0:0] := manifold [comment]
                            P end = (end - 1)
                            T cond = → if end < 0 → P  // pass
                            P comment = lines[end] D expandtabs(P) D lstrip(P)
                    ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                T while_loop = ∞ (
                    T check = → if (comments && comments[0] D strip(P) == "#") → P  // while body follows
                        // comments[0:1] := manifold []
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                T while_loop = ∞ (
                    T check = → if (comments && comments[(-1)] D strip(P) == "#") → P  // while body follows
                        // comments[(-1):Ω] := manifold []
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                → "" D join(comments)
}
D EndOfBlock = λ . P  // class(Exception)
    // pass
D BlockFinder = λ . P  // class
    // Provide a tokeneater() method to detect the end of a code block.
    D BlockFinder____init = λ self . {
        D self_D_indent = 0  // self D indent := 0
        D self_D_singleline = 0  // self D singleline := 0
        D self_D_started = 0  // self D started := 0
        D self_D_passline = 0  // self D passline := 0
        D self_D_indecorator = 0  // self D indecorator := 0
        D self_D_last = 1  // self D last := 1
        D self_D_body_col0 = P  // self D body_col0 := P
    }
    D BlockFinder__tokeneater = λ self, type, token, srowcol, erowcol, line . {
        T cond = → if ((!self D started) && (!self D indecorator)) → P
            T cond = → if type == manifold [tokenize D INDENT, tokenize D COMMENT, tokenize D NL] → P  // pass
            D self_D_passline = 1  // self D passline := 1
        → E P
            T cond = → if type == tokenize D NEWLINE → P
                D self_D_passline = 0  // self D passline := 0
                D self_D_last = srowcol[0]  // self D last := srowcol[0]
                T cond = → if self D singleline → → E EndOfBlock
                T cond = → if self D indecorator → D self_D_indecorator = 0  // self D indecorator := 0
            → E T cond = → if self D passline → P  // pass
    }
D getblock = λ lines . {
    // Extract the block of code at the top of the given list of lines.
    P blockfinder = BlockFinder(P)
    T attempt = → P  // try
        P tokens = tokenize D generate_tokens(iter(lines) D __next__)
        T loop = ∞ (
            P _token = tokens[_loop_index]
            blockfinder D tokeneater(_token)
        ) (D |tokens|)
    → E manifold [EndOfBlock, IndentationError] (_)
        // pass
    → E SyntaxError (e)
        T cond = → if "unmatched" ≠ e D msg → → E e
        P manifold______token_info = _token  // manifold [_, _token_info] := _token
        T attempt = → P  // try
            blockfinder D tokeneater(tokenize D NEWLINE, _token_info)
        → E manifold [EndOfBlock, IndentationError] (_)
            // pass
    → lines[0:blockfinder D last]
}
D getsourcelines = λ object . {
    // Return a list of source lines and starting line number for an object.      The argument may be a module, class, method, 
    P object = unwrap(object)
    P manifold__lines__lnum = findsource(object)  // manifold [lines, lnum] := findsource(object)
    T cond = → if istraceback(object) → P object = object D tb_frame
    T cond = → if (ismodule(object) || (isframe(object) && object D f_code D co_name == "<module>")) → → manifold [lines, 0]
    → E → manifold [getblock(lines[lnum:Ω]), (lnum + 1)]
}
D getsource = λ object . {
    // Return the text of the source code for an object.      The argument may be a module, class, method, function, traceback,
    P manifold__lines__lnum = getsourcelines(object)  // manifold [lines, lnum] := getsourcelines(object)
    → "" D join(lines)
}
D walktree = λ classes, children, parent . {
    // Recursive helper function for getclasstree().
    P results = manifold []
    classes D sort(manifold ["key", attrgetter("__module__", "__name__")])
    T loop = ∞ (
        P c = classes[_loop_index]
        results D append(manifold [c, c D __bases__])
        T cond = → if c == children → results D append(walktree(children[c], children, c))
    ) (D |classes|)
    → results
}
D getclasstree = λ classes, unique . {
    // Arrange the given list of classes into a hierarchy of nested lists.      Where a nested list appears, it contains classe
    P children = manifold []
    P roots = manifold []
    T loop = ∞ (
        P c = classes[_loop_index]
        T cond = → if c D __bases__ → P
            T loop = ∞ (
                P parent = c D __bases__[_loop_index]
                T cond = → if parent ≠ children → P  // pass
                T cond = → if c ≠ children[parent] → children[parent] D append(c)
                T cond = → if (unique && parent == classes) → P  // pass
            ) (D |c D __bases__|)
        → E T cond = → if c ≠ roots → roots D append(c)
    ) (D |classes|)
    T loop = ∞ (
        P parent = children[_loop_index]
        T cond = → if parent ≠ classes → roots D append(parent)
    ) (D |children|)
    → walktree(roots, children, P)
}
P Arguments = namedtuple("Arguments", "args, varargs, varkw")
D getargs = λ co . {
    // Get information about the arguments accepted by a code object.      Three things are returned: (args, varargs, varkw), w
    T cond = → if (!iscode(co)) → → E TypeError("{!r} is not a code object" D format(co))
    P names = co D co_varnames
    P nargs = co D co_argcount
    P nkwargs = co D co_kwonlyargcount
    P args = list(names[0:nargs])
    P kwonlyargs = list(names[nargs:(nargs + nkwargs)])
    P nargs = nargs + nkwargs
    P varargs = P
    T cond = → if (co D co_flags & CO_VARARGS) → P
        P varargs = co D co_varnames[nargs]
        P nargs = (nargs + 1)
    P varkw = P
    T cond = → if (co D co_flags & CO_VARKEYWORDS) → P varkw = co D co_varnames[nargs]
    → Arguments((args + kwonlyargs), varargs, varkw)
}
P FullArgSpec = namedtuple("FullArgSpec", "args, varargs, varkw, defaults, kwonlyargs, kwonlydefaults, annotations")
D getfullargspec = λ func . {
    // Get the names and default values of a callable object's parameters.      A tuple of seven things is returned:     (args,
    T attempt = → P  // try
        P sig = _signature_from_callable(func, manifold ["follow_wrapper_chains", 0], manifold ["skip_bound_arg", 0], manifold ["sigcls", Signature], manifold ["eval_str", 0])
    → E Exception (ex)
        → E TypeError("unsupported callable")
    P args = manifold []
    P varargs = P
    P varkw = P
    P posonlyargs = manifold []
    P kwonlyargs = manifold []
    P annotations = manifold []
    P defaults = manifold []
    P kwdefaults = manifold []
    T cond = → if sig D return_annotation ≠ sig D empty → P  // pass
    T loop = ∞ (
        P param = sig D parameters D values(P)[_loop_index]
        P kind = param D kind
        P name = param D name
        T cond = → if kind == _POSITIONAL_ONLY → P
            posonlyargs D append(name)
            T cond = → if param D default ≠ param D empty → P defaults = defaults + manifold [param D default]
        → E P
            T cond = → if kind == _POSITIONAL_OR_KEYWORD → P
                args D append(name)
                T cond = → if param D default ≠ param D empty → P defaults = defaults + manifold [param D default]
            → E P
                T cond = → if kind == _VAR_POSITIONAL → P varargs = name
                → E P
                    T cond = → if kind == _KEYWORD_ONLY → P
                        kwonlyargs D append(name)
                        T cond = → if param D default ≠ param D empty → P  // pass
                    → E T cond = → if kind == _VAR_KEYWORD → P varkw = name
        T cond = → if param D annotation ≠ param D empty → P  // pass
