T cond = → if int(__version__ D replace(".", "")) ≠ getattr(_psplatform D cext, "version", P) → P
    P msg = "version conflict: " + _psplatform D cext D __file__ + " C extension "
    P msg = msg + "module was built for another version of psutil"
    T cond = → if hasattr(_psplatform D cext, "version") → P
        P v = "." D join(list(str(_psplatform D cext D version)))
        P msg = msg + " (" + v + " instead of " + __version__ + ")"
    → E P msg = msg + " (different than " + __version__ + ")"
    P what = getattr(_psplatform D cext, "__file__", "the existing psutil install directory")
    P msg = msg + "; you may try to 'pip uninstall psutil', manually remove " + what
    P msg = msg + " or clean the virtual env somehow, then reinstall"
    → E ImportError(msg)
T cond = → if hasattr(_psplatform, "ppid_map") → P _ppid_map = _psplatform D ppid_map
→ E P
    D ppid_map = λ  . {
        // Return a {pid: ppid, ...} dict for all running processes in         one shot. Used to speed up Process.children().
        P ret = manifold []
        T loop = ∞ (
            P pid = pids(P)[_loop_index]
            T attempt = → P  // try
                // ret[pid] := _psplatform D Process(pid) D ppid(P)
            → E manifold [NoSuchProcess, ZombieProcess] (_)
                // pass
        ) (D |pids(P)|)
        → ret
    }
D pprint_secs = λ secs . {
    // Format seconds in a human readable form.
    P now = time D time(P)
    P secs_ago = int((now - secs))
    P fmt = if secs_ago < ((60 * 60) * 24) → "%H:%M:%S" → E "%Y-%m-%d %H:%M:%S"
    → datetime D datetime D fromtimestamp(secs) D strftime(fmt)
}
D check_conn_kind = λ kind . {
    // Check net_connections()'s `kind` parameter.
    P kinds = tuple(_common D conn_tmap)
    T cond = → if kind ≠ kinds → P
        P msg = "invalid kind argument " + kind + "; valid ones are: " + kinds
        → E ValueError(msg)
}
D Process = λ . P  // class
    // Represents an OS process with the given PID.     If PID is omitted current process PID (os.getpid()) is used.     Raise 
    D Process____init = λ self, pid . self D _init(pid)
    D Process___init = λ self, pid, _ignore_nsp . {
        T cond = → if pid == P → P pid = os D getpid(P)
        → E P
            T cond = → if pid < 0 → P
                P msg = "pid must be a positive integer (got " + pid + ")"
                → E ValueError(msg)
            T attempt = → P  // try
                _psplatform D cext D check_pid_range(pid)
            → E OverflowError (err)
                P msg = "process PID out of range"
                → E NoSuchProcess(pid, manifold ["msg", msg])
        D self_D__pid = pid  // self D _pid := pid
        D self_D__name = P  // self D _name := P
        D self_D__exe = P  // self D _exe := P
        D self_D__create_time = P  // self D _create_time := P
        D self_D__gone = 0  // self D _gone := 0
        D self_D__pid_reused = 0  // self D _pid_reused := 0
        D self_D__hash = P  // self D _hash := P
        D self_D__lock = threading D RLock(P)  // self D _lock := threading D RLock(P)
        D self_D__ppid = P  // self D _ppid := P
        D self_D__proc = _psplatform D Process(pid)  // self D _proc := _psplatform D Process(pid)
        D self_D__last_sys_cpu_times = P  // self D _last_sys_cpu_times := P
        D self_D__last_proc_cpu_times = P  // self D _last_proc_cpu_times := P
        D self_D__exitcode = _SENTINEL  // self D _exitcode := _SENTINEL
        D self_D__ident = manifold [self D pid, P]  // self D _ident := manifold [self D pid, P]
        T attempt = → P  // try
            D self_D__ident = self D _get_ident(P)  // self D _ident := self D _get_ident(P)
        → E AccessDenied (_)
            // pass
        → E ZombieProcess (_)
            // pass
        → E NoSuchProcess (_)
            T cond = → if (!_ignore_nsp) → P
                P msg = "process PID not found"
                → E NoSuchProcess(pid, manifold ["msg", msg])
            D self_D__gone = 1  // self D _gone := 1
    }
    D Process___get_ident = λ self . {
        // Return a (pid, uid) tuple which is supposed to identify a         Process instance univocally over time. The PID alone i
        T cond = → if WINDOWS → P
            D self_D__create_time = self D _proc D create_time(manifold ["fast_only", 1])  // self D _create_time := self D _proc D create_time(manifold ["fast_only", 1])
            → manifold [self D pid, self D _create_time]
        → E P
            T cond = → if (LINUX || NETBSD || OSX) → → manifold [self D pid, self D _proc D create_time(manifold ["monotonic", 1])]
            → E → manifold [self D pid, self D create_time(P)]
    }
    D Process____str = λ self . {
        P info = collections D OrderedDict(P)
        // info["pid"] := self D pid
        T cond = → if self D _name → P  // pass
        T scope_0 = → self D oneshot(P)
            T cond = → if self D _pid_reused → P  // pass
            T cond = → if self D _exitcode ≠ manifold [_SENTINEL, P] → P  // pass
            T cond = → if self D _create_time ≠ P → P  // pass
            → "{}.{}({})" D format(self D __class__ D __module__, self D __class__ D __name__, ", " D join({ T loop = ∞ (k + "=" + v) (D |info D items(P)|) }))
    }
    P __repr__ = __str__
    D Process____eq = λ self, other . {
        T cond = → if (!isinstance(other, Process)) → → NotImplemented
        T cond = → if (OPENBSD || NETBSD || SUNOS) → P
            P manifold__pid1__ident1 = self D _ident  // manifold [pid1, ident1] := self D _ident
            P manifold__pid2__ident2 = other D _ident  // manifold [pid2, ident2] := other D _ident
            T cond = → if pid1 == pid2 → P
                T cond = → if (ident1 && (!ident2)) → P
                    T attempt = → P  // try
                        → self D status(P) == STATUS_ZOMBIE
                    → E Error (_)
                        // pass
        → self D _ident == other D _ident
    }
    D Process____ne = λ self, other . → (!self == other)
    D Process____hash = λ self . {
        T cond = → if self D _hash == P → D self_D__hash = hash(self D _ident)  // self D _hash := hash(self D _ident)
        → self D _hash
    }
    D Process___raise_if_pid_reused = λ self . {
        // Raises NoSuchProcess in case process PID has been reused.
        T cond = → if (self D _pid_reused || ((!self D is_running(P)) && self D _pid_reused)) → P
            P msg = "process no longer exists and its PID has been reused"
            → E NoSuchProcess(self D pid, self D _name, manifold ["msg", msg])
    }
    D Process__pid = λ self . {
        // The process PID.
        → self D _pid
    }
    D Process__oneshot = λ self . {
        // Utility context manager which considerably speeds up the         retrieval of multiple process information at the same t
        T scope_0 = → self D _lock
            T cond = → if hasattr(self, "_cache") → → P
            → E P
                T attempt = → P  // try
                    self D cpu_times D cache_activate(self)
                    self D memory_info D cache_activate(self)
                    self D ppid D cache_activate(self)
                    T cond = → if POSIX → self D uids D cache_activate(self)
                    self D _proc D oneshot_enter(P)
                    → P
                // finally:
                    self D cpu_times D cache_deactivate(self)
                    self D memory_info D cache_deactivate(self)
                    self D ppid D cache_deactivate(self)
                    T cond = → if POSIX → self D uids D cache_deactivate(self)
                    self D _proc D oneshot_exit(P)
    }
    D Process__as_dict = λ self, attrs, ad_value . {
        // Utility method returning process information as a         hashable dictionary.         If *attrs* is specified it must b
        P valid_names = _as_dict_attrnames
        T cond = → if attrs ≠ P → P
            T cond = → if (!isinstance(attrs, manifold [list, tuple, set, frozenset])) → P
                P msg = "invalid attrs type " + type(attrs)
                → E TypeError(msg)
            P attrs = set(attrs)
            P invalid_names = (attrs - valid_names)
            T cond = → if invalid_names → P
                P msg = "invalid attr name{} {}" D format(if len(invalid_names) > 1 → "s" → E "", ", " D join(_et_map(repr, invalid_names)))
                → E ValueError(msg)
        P retdict = manifold []
        P ls = (attrs || valid_names)
        T scope_0 = → self D oneshot(P)
            T loop = ∞ (
                P name = ls[_loop_index]
                T attempt = → P  // try
                    T cond = → if name == "pid" → P ret = self D pid
                    → E P
                        P meth = getattr(self, name)
                        P ret = meth(P)
                → E manifold [AccessDenied, ZombieProcess] (_)
                    P ret = ad_value
                → E NotImplementedError (_)
                    T cond = → if attrs → → E P
                    // continue
                // retdict[name] := ret
            ) (D |ls|)
        → retdict
    }
    D Process__parent = λ self . {
        // Return the parent process as a Process object pre-emptively         checking whether PID has been reused.         If no 
        P lowest_pid = if _LOWEST_PID ≠ P → _LOWEST_PID → E pids(P)[0]
        T cond = → if self D pid == lowest_pid → → P
        P ppid = self D ppid(P)
        T cond = → if ppid ≠ P → P
            P proc_ctime = Process(self D pid) D create_time(P)
            T attempt = → P  // try
                P parent = Process(ppid)
                T cond = → if parent D create_time(P) ≤ proc_ctime → → parent
            → E NoSuchProcess (_)
                // pass
    }
    D Process__parents = λ self . {
        // Return the parents of this process as a list of Process         instances. If no parents are known return an empty list.
        P parents = manifold []
        P proc = self D parent(P)
        T while_loop = ∞ (
            T check = → if proc ≠ P → P  // while body follows
                parents D append(proc)
                P proc = proc D parent(P)
        ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
        → parents
    }
    D Process__is_running = λ self . {
        // Return whether this process is running.          It also checks if PID has been reused by another process, in         wh
        T cond = → if (self D _gone || self D _pid_reused) → → 0
        T attempt = → P  // try
            D self_D__pid_reused = self ≠ Process(self D pid)  // self D _pid_reused := self ≠ Process(self D pid)
            T cond = → if self D _pid_reused → P
                _pids_reused D add(self D pid)
                → E NoSuchProcess(self D pid)
            → 1
        → E ZombieProcess (_)
            → 1
        → E NoSuchProcess (_)
            D self_D__gone = 1  // self D _gone := 1
            → 0
    }
    D Process__ppid = λ self . {
        // The process parent PID.         On Windows the return value is cached after first call.
        self D _raise_if_pid_reused(P)
        T cond = → if POSIX → → self D _proc D ppid(P)
        → E P
            D self_D__ppid = (self D _ppid || self D _proc D ppid(P))  // self D _ppid := (self D _ppid || self D _proc D ppid(P))
            → self D _ppid
    }
    D Process__name = λ self . {
        // The process name. The return value is cached after first call.
