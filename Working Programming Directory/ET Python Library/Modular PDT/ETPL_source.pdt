    D ETMathV2__et_string_contains = λ haystack, needle . {
        // ET D-membership test: is needle a D-constraint of haystack?         Returns 1 (true) or 0 (false) — ET binary cardinalit
        T cond = → if (isinstance(haystack, str) && isinstance(needle, str)) → → if needle == haystack → 1 → E 0
        → 0
