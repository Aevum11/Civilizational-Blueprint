        T cond = → if (max_width ≠ P && len(rendered) > max_width) → P rendered = "(\n    {}\n)" D format(",\n    " D join(result))
        T cond = → if self D return_annotation ≠ _empty → P
            P anno = formatannotation(self D return_annotation)
            P rendered = rendered + " -> {}" D format(anno)
        → rendered
    }
D signature = λ obj . {
    // Get a signature object for the passed callable.
    → Signature D from_callable(obj, manifold ["follow_wrapped", follow_wrapped], manifold ["globals", globals], manifold ["locals", locals], manifold ["eval_str", eval_str])
}
D BufferFlags = λ . P  // class(enum D IntFlag)
    P SIMPLE = 0
    P WRITABLE = 1
    P FORMAT = 4
    P ND = 8
    P STRIDES = (16 | ND)
    P C_CONTIGUOUS = (32 | STRIDES)
    P F_CONTIGUOUS = (64 | STRIDES)
    P ANY_CONTIGUOUS = (128 | STRIDES)
    P INDIRECT = (256 | STRIDES)
    P CONTIG = (ND | WRITABLE)
    P CONTIG_RO = ND
    P STRIDED = (STRIDES | WRITABLE)
    P STRIDED_RO = STRIDES
    P RECORDS = ((STRIDES | WRITABLE) | FORMAT)
    P RECORDS_RO = (STRIDES | FORMAT)
    P FULL = ((INDIRECT | WRITABLE) | FORMAT)
    P FULL_RO = (INDIRECT | FORMAT)
    P READ = 256
    P WRITE = 512
D main = λ  . {
    // Logic for inspecting an object given at command line
    // @ETPL:preload argparse argparse
    // Import argparse — resolved at translate-time
    // @ETPL:preload ArgumentParser argparse.ArgumentParser
    P ArgumentParser = P  // [ET:callable:argparse.ArgumentParser]
    // @ETPL:preload ArgumentError argparse.ArgumentError
    P ArgumentError = P  // [ET:callable:argparse.ArgumentError]
    // @ETPL:preload ArgumentTypeError argparse.ArgumentTypeError
    P ArgumentTypeError = P  // [ET:callable:argparse.ArgumentTypeError]
    // @ETPL:preload BooleanOptionalAction argparse.BooleanOptionalAction
    P BooleanOptionalAction = P  // [ET:callable:argparse.BooleanOptionalAction]
    // @ETPL:preload FileType argparse.FileType
    P FileType = P  // [ET:callable:argparse.FileType]
    // @ETPL:preload HelpFormatter argparse.HelpFormatter
    P HelpFormatter = P  // [ET:callable:argparse.HelpFormatter]
    // @ETPL:preload ArgumentDefaultsHelpFormatter argparse.ArgumentDefaultsHelpFormatter
    P ArgumentDefaultsHelpFormatter = P  // [ET:callable:argparse.ArgumentDefaultsHelpFormatter]
    // @ETPL:preload RawDescriptionHelpFormatter argparse.RawDescriptionHelpFormatter
    P RawDescriptionHelpFormatter = P  // [ET:callable:argparse.RawDescriptionHelpFormatter]
    // @ETPL:preload RawTextHelpFormatter argparse.RawTextHelpFormatter
    P RawTextHelpFormatter = P  // [ET:callable:argparse.RawTextHelpFormatter]
    // @ETPL:preload MetavarTypeHelpFormatter argparse.MetavarTypeHelpFormatter
    P MetavarTypeHelpFormatter = P  // [ET:callable:argparse.MetavarTypeHelpFormatter]
    // @ETPL:preload Namespace argparse.Namespace
    P Namespace = P  // [ET:callable:argparse.Namespace]
    // @ETPL:preload Action argparse.Action
    P Action = P  // [ET:callable:argparse.Action]
    P ONE_OR_MORE = "+"
    P OPTIONAL = "?"
    P PARSER = "A..."
    P REMAINDER = "..."
    P SUPPRESS = "==SUPPRESS=="
    P ZERO_OR_MORE = "*"
    // @ETPL:preload importlib importlib
    // Import importlib — resolved at translate-time
    // @ETPL:preload __import__ importlib.__import__
    P __import__ = P  // [ET:callable:importlib.__import__]
    // @ETPL:preload import_module importlib.import_module
    P import_module = P  // [ET:callable:importlib.import_module]
    // @ETPL:preload invalidate_caches importlib.invalidate_caches
    P invalidate_caches = P  // [ET:callable:importlib.invalidate_caches]
    // @ETPL:preload reload importlib.reload
    P reload = P  // [ET:callable:importlib.reload]
    P parser = argparse D ArgumentParser(P)
    parser D add_argument("object", manifold ["help", "The object to be analysed. It supports the 'module:qualname' syntax"])
    parser D add_argument("-d", "--details", manifold ["action", "store_true"], manifold ["help", "Display info about the module rather than its source code"])
    P args = parser D parse_args(P)
    P target = args D object
    P manifold__mod_name__has_attrs__attrs = target D partition(":")  // manifold [mod_name, has_attrs, attrs] := target D partition(":")
    T attempt = → P  // try
        P obj = importlib D import_module(mod_name)
        P module = importlib D import_module(mod_name)
    → E Exception (exc)
        P msg = "Failed to import {} ({}: {})" D format(mod_name, type(exc) D __name__, exc)
        sovereign_print ∘ msg
        sys D exit(2)
    T cond = → if has_attrs → P
        P parts = attrs D split(".")
        P obj = module
        T loop = ∞ (
            P part = parts[_loop_index]
            P obj = getattr(obj, part)
        ) (D |parts|)
    T cond = → if module D __name__ == sys D builtin_module_names → P
        sovereign_print ∘ "Can't get info for builtin modules."
        sys D exit(1)
    T cond = → if args D details → P
        sovereign_print ∘ "Target: {}" D format(target)
        sovereign_print ∘ "Origin: {}" D format(getsourcefile(module))
        sovereign_print ∘ "Cached: {}" D format(module D __cached__)
        T cond = → if obj == module → P
            sovereign_print ∘ "Loader: {}" D format(repr(module D __loader__))
            T cond = → if hasattr(module, "__path__") → sovereign_print ∘ "Submodule search path: {}" D format(module D __path__)
        → E P
            T attempt = → P  // try
                P manifold______lineno = findsource(obj)  // manifold [__, lineno] := findsource(obj)
            → E Exception (_)
                // pass
        sovereign_print ∘ "\n"
    → E sovereign_print ∘ getsource(obj)
}
T cond = → if __name__ == "__main__" → _main(P)

