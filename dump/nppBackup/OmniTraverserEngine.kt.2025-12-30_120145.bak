package com.et.omnimeasure.core

import android.content.Context
import android.hardware.Sensor
import android.hardware.SensorEvent
import android.hardware.SensorEventListener
import android.hardware.SensorManager
import android.media.AudioFormat
import android.media.AudioRecord
import android.media.MediaRecorder
import android.view.Surface
import android.view.WindowManager
import kotlin.math.*
import java.util.concurrent.atomic.AtomicBoolean

/**
 * =========================================================================================
 * OMNI-TRAVERSER ENGINE v5.0 (THE UNIFIED FIELD)
 * Logic: Exception Theory (P-D-T Substantiation)
 * =========================================================================================
 *
 * [P] Substrate: Android Hardware Sensors (Accel, Gyro, Light, Mic).
 * [D] Descriptors: Finite constraints (Gravity, Decibels, Lux, Frequency).
 * [T] Traverser: The Logic Agents resolving Indeterminacy into Reality.
 *
 * FEATURES:
 * 1. Manifold Rectification: Sensor Fusion (Gyro+Accel) for drift-free Tilt.
 * 2. Energy Variance: RMS calculation for Vibration (shimmer index).
 * 3. Photonic Density: Logarithmic mapping of Lux to Context.
 * 4. Acoustic Traversal: dB metering and FFT Frequency Source Identification.
 * 5. Privacy Axiom: All processing is local (No Cloud/Internet).
 */
class OmniTraverserEngine(
    private val context: Context,
    private val listener: TraverserListener
) : SensorEventListener {

    // --- INTERFACE ---
    interface TraverserListener {
        fun onPhysicsUpdate(model: PhysicsUiModel)
        fun onCalibrationState(isCalibrating: Boolean, progress: Int)
        fun onError(message: String)
    }

    // --- SYSTEM SERVICES ---
    private val sensorManager = context.getSystemService(Context.SENSOR_SERVICE) as SensorManager
    private val windowManager = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager

    // --- MANIFOLD CONSTANTS ---
    private val NS2S = 1.0f / 1_000_000_000.0f
    private val FUSION_ALPHA = 0.98f    // Trust Gyro 98%, Accel 2% (Binding Strength)
    private val GRAVITY_ALPHA = 0.90f   // Heavy smoothing for Gravity Isolation
    private val UI_THROTTLE_MS = 32L    // ~30 FPS Limit

    // --- T-STATE (FLAGS) ---
    private var isRunning = false
    private var hasSubstantiated = false // Initialization Flag
    private var lastTimestamp: Long = 0
    private var lastUiUpdate: Long = 0

    // --- D-STATE (ORIENTATION) ---
    private var currentPitch = 0.0
    private var currentRoll = 0.0
    private var fusedOrientation = FloatArray(3) // [Azimuth, Pitch, Roll]

    // --- D-STATE (VIBRATION / VARIANCE) ---
    private val gravityVector = FloatArray(3)
    private var varianceAccumulator = 0.0
    private var varianceSampleCount = 0
    private var maxPeakInWindow = 0.0

    // --- D-STATE (PHOTONIC) ---
    private var smoothedLux = 0f

    // --- D-STATE (ACOUSTIC) ---
    private var audioThread: Thread? = null
    private val isAudioRunning = AtomicBoolean(false)
    private var currentDb = 0.0
    private var dominantFreq = 0.0

    // --- CALIBRATION (BIAS REMOVAL) ---
    private var isCalibrating = false
    private var calibrationBufferCount = 0
    private val CALIBRATION_FRAMES = 100
    private val gyroBias = FloatArray(3)

    // =========================================================================================
    //  LIFECYCLE (BINDING/UNBINDING)
    // =========================================================================================

    fun engage() {
        if (isRunning) return
        
        // Reset State
        resetState()
        
        // Bind Hardware Traversers
        // SENSOR_DELAY_GAME (~20ms) allows capturing 50Hz vibration variance.
        sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)?.let {
            sensorManager.registerListener(this, it, SensorManager.SENSOR_DELAY_GAME)
        } ?: listener.onError("Substrate Missing: Accelerometer")

        sensorManager.getDefaultSensor(Sensor.TYPE_GYROSCOPE)?.let {
            sensorManager.registerListener(this, it, SensorManager.SENSOR_DELAY_GAME)
        }

        sensorManager.getDefaultSensor(Sensor.TYPE_LIGHT)?.let {
            sensorManager.registerListener(this, it, SensorManager.SENSOR_DELAY_UI)
        }

        startAudioTraversal()
        isRunning = true
    }

    fun disengage() {
        sensorManager.unregisterListener(this)
        stopAudioTraversal()
        isRunning = false
    }

    private fun resetState() {
        hasSubstantiated = false
        lastTimestamp = 0
        currentPitch = 0.0
        currentRoll = 0.0
        varianceAccumulator = 0.0
        varianceSampleCount = 0
        maxPeakInWindow = 0.0
    }

    fun startCalibration() {
        if (!isRunning) return
        isCalibrating = true
        calibrationBufferCount = 0
        gyroBias.fill(0f)
        listener.onCalibrationState(true, 0)
    }

    // =========================================================================================
    //  PHYSICS LOOP (SENSOR EVENTS)
    // =========================================================================================

    override fun onSensorChanged(event: SensorEvent?) {
        event ?: return
        when (event.sensor.type) {
            Sensor.TYPE_ACCELEROMETER -> processAccel(event)
            Sensor.TYPE_GYROSCOPE -> processGyro(event)
            Sensor.TYPE_LIGHT -> processLight(event)
        }
    }

    // --- 1. ACCELEROMETER (THE ANCHOR & THE SHIMMER) ---
    private fun processAccel(event: SensorEvent) {
        val x = event.values[0]
        val y = event.values[1]
        val z = event.values[2]

        // Initialization (Singularity Resolution)
        if (!hasSubstantiated) {
            gravityVector[0] = x; gravityVector[1] = y; gravityVector[2] = z
            hasSubstantiated = true
            return
        }

        // A. Gravity Isolation (Low-Pass Filter)
        gravityVector[0] = GRAVITY_ALPHA * gravityVector[0] + (1 - GRAVITY_ALPHA) * x
        gravityVector[1] = GRAVITY_ALPHA * gravityVector[1] + (1 - GRAVITY_ALPHA) * y
        gravityVector[2] = GRAVITY_ALPHA * gravityVector[2] + (1 - GRAVITY_ALPHA) * z

        // B. Vibration Extraction (High-Pass Filter)
        val linX = x - gravityVector[0]
        val linY = y - gravityVector[1]
        val linZ = z - gravityVector[2]

        // C. Variance Accumulation (RMS Energy)
        val magSq = (linX * linX) + (linY * linY) + (linZ * linZ)
        varianceAccumulator += magSq
        varianceSampleCount++
        
        val currentPeak = sqrt(magSq)
        if (currentPeak > maxPeakInWindow) maxPeakInWindow = currentPeak.toDouble()
    }

    // --- 2. GYROSCOPE (THE NAVIGATOR & FUSION) ---
    private fun processGyro(event: SensorEvent) {
        if (!hasSubstantiated || lastTimestamp == 0L) {
            lastTimestamp = event.timestamp
            return
        }

        // A. Calibration Intercept
        if (isCalibrating) {
            accumulateCalibration(event)
            return
        }

        // B. Time Delta
        val dt = (event.timestamp - lastTimestamp) * NS2S
        lastTimestamp = event.timestamp

        // C. Bias Correction
        val gX = event.values[0] - gyroBias[0]
        val gY = event.values[1] - gyroBias[1]
        val gZ = event.values[2] - gyroBias[2]

        // D. Observer Relativity (Screen Orientation Remap)
        val (rateX, rateY, _) = remapToDisplay(gX, gY, gZ)
        val (gravX, gravY, gravZ) = remapToDisplay(gravityVector[0], gravityVector[1], gravityVector[2])

        // E. Anchor Calculation (Accel Tilt)
        // Pitch: Rotation around X. Roll: Rotation around Y.
        val accelPitch = atan2(gravY.toDouble(), gravZ.toDouble())
        val accelRoll = atan2(-gravX.toDouble(), gravZ.toDouble())

        // F. Complementary Filter (Fusion)
        // New = Alpha * (Old + GyroChange) + (1-Alpha) * AccelAnchor
        currentPitch = FUSION_ALPHA * (currentPitch + rateX * dt) + (1 - FUSION_ALPHA) * accelPitch
        currentRoll = FUSION_ALPHA * (currentRoll + rateY * dt) + (1 - FUSION_ALPHA) * accelRoll

        // Drive UI Update
        throttleUiUpdate()
    }

    // --- 3. LIGHT (PHOTONIC DENSITY) ---
    private fun processLight(event: SensorEvent) {
        val raw = event.values[0]
        // Simple smoothing to reject flicker
        smoothedLux = if (smoothedLux == 0f) raw else (smoothedLux * 0.7f) + (raw * 0.3f)
    }

    // =========================================================================================
    //  AUDIO ENGINE (ACOUSTIC TRAVERSAL)
    // =========================================================================================

    private fun startAudioTraversal() {
        if (isAudioRunning.get()) return
        isAudioRunning.set(true)
        audioThread = Thread { audioLoop() }
        audioThread?.start()
    }

    private fun stopAudioTraversal() {
        isAudioRunning.set(false)
        try { audioThread?.join(500) } catch (e: Exception) {}
    }

    private fun audioLoop() {
        val sampleRate = 44100
        val bufferSize = AudioRecord.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
        
        if (bufferSize < 0) return // No mic hardware

        try {
            val recorder = AudioRecord(MediaRecorder.AudioSource.MIC, sampleRate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, bufferSize)
            val buffer = ShortArray(bufferSize)
            
            recorder.startRecording()
            
            while (isAudioRunning.get()) {
                val read = recorder.read(buffer, 0, bufferSize)
                if (read > 0) {
                    // 1. Decibel Calculation (RMS)
                    var sumSq = 0.0
                    for (i in 0 until read) sumSq += buffer[i] * buffer[i]
                    val rms = sqrt(sumSq / read)
                    // 20 * log10(rms / reference). Ref is typically 1.0 or 0.1 depending on calibration.
                    // Using 1.0, results are relative. +90dB approximate offset for SPL.
                    currentDb = if (rms > 0) 20 * log10(rms) else 0.0

                    // 2. Frequency Identification (Simple Zero-Crossing or FFT)
                    // For speed in this loop, we do a Zero-Crossing Count (ZCC) approximation 
                    // or a mini-FFT. Here is a simplified ZCC for efficiency:
                    var crossings = 0
                    for (i in 1 until read) {
                        if ((buffer[i-1] > 0 && buffer[i] <= 0) || (buffer[i-1] < 0 && buffer[i] >= 0)) {
                            crossings++
                        }
                    }
                    // Freq = (Crossings * SampleRate) / (2 * Samples)
                    dominantFreq = (crossings * sampleRate) / (2.0 * read)
                }
            }
            recorder.stop()
            recorder.release()
        } catch (e: SecurityException) {
            listener.onError("Permission Denied: Microphone")
        } catch (e: Exception) {
            listener.onError("Audio Init Failed")
        }
    }

    // =========================================================================================
    //  SUBSTANTIATION (UI & LOGIC MAPPING)
    // =========================================================================================

    private fun throttleUiUpdate() {
        val now = System.currentTimeMillis()
        if (now - lastUiUpdate < UI_THROTTLE_MS) return
        lastUiUpdate = now

        // 1. Calculate Vibration RMS
        var rmsVib = 0.0
        if (varianceSampleCount > 0) {
            rmsVib = sqrt(varianceAccumulator / varianceSampleCount)
        }
        
        // 2. Calculate Total Tilt
        val tiltDeg = Math.toDegrees(acos(cos(currentPitch) * cos(currentRoll)))
        
        // 3. Interpret Data (Translation Layer)
        val (vibLabel, vibDesc) = interpretVibration(rmsVib)
        val (luxLabel, luxDesc) = interpretLux(smoothedLux)
        val (noiseSource, noiseDesc) = interpretSound(dominantFreq)

        // 4. Build Model
        val model = PhysicsUiModel(
            tiltDegrees = tiltDeg,
            pitch = Math.toDegrees(currentPitch),
            roll = Math.toDegrees(currentRoll),
            vibrationRms = rmsVib,
            vibrationPeak = maxPeakInWindow,
            vibrationLabel = vibLabel,
            luxValue = smoothedLux,
            luxLabel = luxLabel,
            luxDesc = luxDesc,
            dbValue = currentDb,
            noiseFreq = dominantFreq,
            noiseSource = noiseSource
        )

        listener.onPhysicsUpdate(model)

        // Reset Window
        varianceAccumulator = 0.0
        varianceSampleCount = 0
        maxPeakInWindow = 0.0
    }

    // --- UTILITIES ---

    private fun remapToDisplay(x: Float, y: Float, z: Float): Triple<Float, Float, Float> {
        return when (windowManager.defaultDisplay.rotation) {
            Surface.ROTATION_0 -> Triple(x, y, z)
            Surface.ROTATION_90 -> Triple(-y, x, z)
            Surface.ROTATION_180 -> Triple(-x, -y, z)
            Surface.ROTATION_270 -> Triple(y, -x, z)
            else -> Triple(x, y, z)
        }
    }

    private fun accumulateCalibration(event: SensorEvent) {
        calibrationBufferCount++
        gyroBias[0] += event.values[0]
        gyroBias[1] += event.values[1]
        gyroBias[2] += event.values[2]
        listener.onCalibrationState(true, (calibrationBufferCount * 100) / CALIBRATION_FRAMES)
        
        if (calibrationBufferCount >= CALIBRATION_FRAMES) {
            gyroBias[0] /= CALIBRATION_FRAMES
            gyroBias[1] /= CALIBRATION_FRAMES
            gyroBias[2] /= CALIBRATION_FRAMES
            isCalibrating = false
            hasSubstantiated = false // Hard reset to apply bias
            listener.onCalibrationState(false, 100)
        }
    }

    // --- INTERPRETATION DICTIONARIES (ET SEMANTICS) ---

    private fun interpretVibration(rms: Double): Pair<String, String> {
        return when {
            rms < 0.05 -> "Stable" to "Stationary"
            rms < 0.30 -> "Micro-Tremor" to "AC/Machinery"
            rms < 0.80 -> "Light Shake" to "Vehicle Idle"
            rms < 2.00 -> "Moderate" to "Cobblestones/Run"
            else -> "High Energy" to "Impact/Danger"
        }
    }

    private fun interpretLux(lux: Float): Pair<String, String> {
        return when {
            lux < 10 -> "Dark" to "Night Vision"
            lux < 200 -> "Dim" to "Relaxation"
            lux < 800 -> "Normal" to "Workspace"
            lux < 5000 -> "Bright" to "Overcast Day"
            else -> "Intense" to "Direct Sun"
        }
    }

    private fun interpretSound(freq: Double): Pair<String, String> {
        return when {
            freq < 50 -> "Low Rumble" to "Traffic/Thunder"
            freq in 48.0..62.0 -> "Mains Hum" to "Electrical 50/60Hz"
            freq in 80.0..300.0 -> "Human Male" to "Speech Range"
            freq in 300.0..1200.0 -> "Mid Range" to "Speech/Music"
            freq > 2000 -> "High Pitch" to "Whine/Alarm"
            else -> "Broadband" to "White Noise"
        }
    }

    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
}

data class PhysicsUiModel(
    val tiltDegrees: Double,
    val pitch: Double,
    val roll: Double,
    val vibrationRms: Double,
    val vibrationPeak: Double,
    val vibrationLabel: String,
    val luxValue: Float,
    val luxLabel: String,
    val luxDesc: String,
    val dbValue: Double,
    val noiseFreq: Double,
    val noiseSource: String
)