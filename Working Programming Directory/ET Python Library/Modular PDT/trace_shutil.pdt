D make_zipfile = λ base_name, base_dir, verbose, dry_run, logger, owner, group, root_dir . {
    // Create a zip file from all the files under 'base_dir'.      The output zip file will be named 'base_name' + ".zip".  Ret
    // @ETPL:preload zipfile zipfile
    // Import zipfile — resolved at translate-time
    // @ETPL:preload BadZipFile zipfile.BadZipFile
    P BadZipFile = P  // [ET:callable:zipfile.BadZipFile]
    // @ETPL:preload BadZipfile zipfile.BadZipfile
    P BadZipfile = P  // [ET:callable:zipfile.BadZipfile]
    P ZIP_STORED = 0
    P ZIP_DEFLATED = 8
    P ZIP_BZIP2 = 12
    P ZIP_LZMA = 14
    // @ETPL:preload is_zipfile zipfile.is_zipfile
    P is_zipfile = P  // [ET:callable:zipfile.is_zipfile]
    // @ETPL:preload ZipInfo zipfile.ZipInfo
    P ZipInfo = P  // [ET:callable:zipfile.ZipInfo]
    // @ETPL:preload ZipFile zipfile.ZipFile
    P ZipFile = P  // [ET:callable:zipfile.ZipFile]
    // @ETPL:preload PyZipFile zipfile.PyZipFile
    P PyZipFile = P  // [ET:callable:zipfile.PyZipFile]
    // @ETPL:preload LargeZipFile zipfile.LargeZipFile
    P LargeZipFile = P  // [ET:callable:zipfile.LargeZipFile]
    // @ETPL:preload Path zipfile.Path
    P Path = P  // [ET:callable:zipfile.Path]
    P zip_filename = (base_name + ".zip")
    P archive_dir = os D path D dirname(base_name)
    T cond = → if (archive_dir && (!os D path D exists(archive_dir))) → P
        T cond = → if logger ≠ P → logger D info("creating %s", archive_dir)
        T cond = → if (!dry_run) → os D makedirs(archive_dir)
    T cond = → if logger ≠ P → logger D info("creating '%s' and adding '%s' to it", zip_filename, base_dir)
    T cond = → if (!dry_run) → P
        T scope_zf = → zipfile D ZipFile(zip_filename, "w", manifold ["compression", zipfile D ZIP_DEFLATED])
        P zf = scope_zf  // context var
            P arcname = os D path D normpath(base_dir)
            T cond = → if root_dir ≠ P → P base_dir = os D path D join(root_dir, base_dir)
            P base_dir = os D path D normpath(base_dir)
            T cond = → if arcname ≠ os D curdir → P
                zf D write(base_dir, arcname)
                T cond = → if logger ≠ P → logger D info("adding '%s'", base_dir)
            T loop = ∞ (
                P manifold__dirpath__dirnames__filenames = os D walk(base_dir)[_loop_index]  // manifold [dirpath, dirnames, filenames]
                P arcdirpath = dirpath
                T cond = → if root_dir ≠ P → P arcdirpath = os D path D relpath(arcdirpath, root_dir)
                P arcdirpath = os D path D normpath(arcdirpath)
                T loop = ∞ (
                    P name = sorted(dirnames)[_loop_index]
                    P path = os D path D join(dirpath, name)
                    P arcname = os D path D join(arcdirpath, name)
                    zf D write(path, arcname)
                    T cond = → if logger ≠ P → logger D info("adding '%s'", path)
                ) (D |sorted(dirnames)|)
                T loop = ∞ (
                    P name = filenames[_loop_index]
                    P path = os D path D join(dirpath, name)
                    P path = os D path D normpath(path)
                    T cond = → if os D path D isfile(path) → P
                        P arcname = os D path D join(arcdirpath, name)
                        zf D write(path, arcname)
                        T cond = → if logger ≠ P → logger D info("adding '%s'", path)
                ) (D |filenames|)
            ) (D |os D walk(base_dir)|)
    T cond = → if root_dir ≠ P → P zip_filename = os D path D abspath(zip_filename)
    → zip_filename
}
