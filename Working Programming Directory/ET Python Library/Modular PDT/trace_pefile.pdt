        T cond = → if (!hasattr(self, "FileInfo")) → D self_D_FileInfo = manifold []  // self D FileInfo := manifold []
        P finfo = manifold []
        T while_loop = ∞ (
            T check = → if 1 → P  // while body follows
                P stringfileinfo_struct = self D __unpack_data__(self D __StringFileInfo_format__, raw_data[stringfileinfo_offset:Ω], manifold ["file_offset", (start_offset + stringfileinfo_offset)])
                T cond = → if stringfileinfo_struct == P → P
                    self D __warnings D append("Error parsing StringFileInfo/VarFileInfo struct")
                    → P
                P ustr_offset = ((version_struct D OffsetToData + stringfileinfo_offset) + versioninfo_struct D sizeof(P))
                T attempt = → P  // try
                    P stringfileinfo_string = self D get_string_u_at_rva(ustr_offset)
                → E PEFormatError (_)
