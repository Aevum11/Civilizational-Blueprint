                → "(not " + operand + ")"
            P left = self D _gen_sovereign_expr(node D left)
            P right = self D _gen_sovereign_expr(node D right)
            P py_op = if node D op == "&&" → "and" → E "or"
            → "(" + left + " " + py_op + " " + right + ")"
        T cond = → if nt == ASTNodeType D BINARY_OP → P
            P left = self D _gen_sovereign_expr(node D left)
            P right = self D _gen_sovereign_expr(node D right)
            P op = node D op
            T cond = → if op == manifold ["|", "&", "^", "<<", ">>"] → → "(int(" + left + ") " + op + " int(" + right + "))"
            → "(" + left + " " + op + " " + right + ")"
        T cond = → if nt == ASTNodeType D CALL → P
            P func = self D _gen_sovereign_expr(node D left)
            P arg = self D _gen_sovereign_expr(node D right)
            → func + "(" + arg + ")"
