// --- SECTION 1: ET MATHEMATICAL CONSTANTS ---
// All derived from P∘D∘T series. Zero external inputs required.

// Private D-helper: arctan via Leibniz T-series
// arctan(x) = Σ_{k=0}^{N} (-1)^k · x^(2k+1) / (2k+1)
// P: real axis; D: Leibniz alternating series; T: 144-step iteration
// Converges for |x| ≤ 1 (always satisfied by Machin inputs 1/5, 1/239)
D _et_at = λ x . {
    P _at_r = 0
    P _at_xp = x
    P _at_xs = (x * x)
    P _at_s = 1
    ∞ (
        P _at_r = (_at_r + (_at_s * (_at_xp / ((2 * _loop_index) + 1))))
        P _at_xp = (_at_xp * _at_xs)
        P _at_s = (0 - _at_s)
    ) (D 72)
    → _at_r
}

// ET_PI via Machin's formula 1706 — superior convergence over Leibniz alone
// π/4 = 4·arctan(1/5) - arctan(1/239)
// Both arguments satisfy |x| < 1: convergence guaranteed.
// Eq: ET_PI = 4·(4·arctan(0.2) - arctan(1/239))
P ET_PI = (4 * ((4 * _et_at(0.2)) - _et_at(0.0041841004184100418)))
P ET_TAU = (2 * ET_PI)

// ET_E via Taylor series: e = Σ_{k=0}^{144} 1/k!
// P: unit substrate; D: reciprocal factorial; T: 144 ratio-reduction steps
// Ratio form: term[k+1] = term[k] / (k+1) — avoids factorial overflow
D _et_e_build = λ dummy . {
    P _eb_r = 1
    P _eb_t = 1
    ∞ (
        P _eb_t = (_eb_t / (_loop_index + 1))
        P _eb_r = (_eb_r + _eb_t)
    ) (D 144)
    → _eb_r
}
P ET_E = _et_e_build(0)

// Private arctanh series: arctanh(x) = Σ_{k=0}^{N} x^(2k+1)/(2k+1)
// Used for logarithm derivation: ln(x) = 2·arctanh((x-1)/(x+1))
D _et_atanh_s = λ x . {
    P _as_r = 0
    P _as_xp = x
    P _as_xs = (x * x)
    ∞ (
        P _as_r = (_as_r + (_as_xp / ((2 * _loop_index) + 1)))
        P _as_xp = (_as_xp * _as_xs)
    ) (D 72)
    → _as_r
}

// ET_LN2 via arctanh: ln(2) = 2·arctanh(1/3)
// 1/3 is the canonical Machin-like argument for ln(2)
P ET_LN2 = (2 * _et_atanh_s(0.3333333333333333))

// ET_LN10 via decomposition: ln(10) = 3·ln(2) + 2·arctanh(1/9)
// Derivation: 10 = 8·(10/8) → ln(10)=3ln(2)+ln(10/8)=3ln(2)+2arctanh(1/9)
P ET_LN10 = ((3 * ET_LN2) + (2 * _et_atanh_s(0.1111111111111111)))

// --- SECTION 2: ET SQUARE ROOT — Newton-Raphson T-iteration ---
// g_{n+1} = (g_n + x/g_n) / 2 → fixed point: g = √x
// P: non-negative real substrate (Ω for negative → ET ground)
// D: Newton-Raphson convergence constraint
// T: 64 iterations (sufficient for double precision; N²=144 bound is conservative)
// E: √x (grounded finite output)
D et_sqrt = λ x . (if (x < 0) → 0 → E (if (x == 0) → 0 → E {
    P _sq_g = (if (x > 1) → (x / 2) → E (x / 2))
    ∞ (P _sq_g = ((_sq_g + (x / _sq_g)) / 2)) (D 64)
    → _sq_g
}))

// ET_PHI = (1 + √5)/2  — golden ratio from sqrt derivation
P ET_PHI = ((1 + et_sqrt(5)) / 2)

// --- SECTION 3: ET EXPONENTIAL — Taylor series ratio form ---
// exp(x) = Σ_{k=0}^{N} x^k/k!
// Ratio form: t[k+1] = t[k]·x/(k+1)  avoids repeated factorial computation
// P: real exponent substrate; D: ratio-bound Taylor terms; T: 144 steps
// E: e^x (substantiated value)
D et_exp = λ x . {
    P _ex_r = 1
    P _ex_t = 1
    ∞ (
        P _ex_t = (_ex_t * x / (_loop_index + 1))
        P _ex_r = (_ex_r + _ex_t)
    ) (D 144)
    → _ex_r
}

// expm1(x) = exp(x)-1, optimized for small x via direct series
// Avoids cancellation near 0 by computing the series from k=1 upward
D et_expm1 = λ x . {
    P _em_r = 0
    P _em_t = x
    ∞ (
        P _em_t = (_em_t * x / (_loop_index + 2))
        P _em_r = (_em_r + _em_t)
    ) (D 143)
    → (_em_r + x)
}

// --- SECTION 4: ET LOGARITHM — arctanh series ---
// ln(x) = 2·arctanh((x-1)/(x+1))
// P: positive real substrate; D: arctanh convergence; T: 72 steps
// E: ln(x) (finite grounded output)
D et_log = λ x . (if (x <= 0) → 0 → E {
    P _lg_t = ((x - 1) / (x + 1))
    → (2 * _et_atanh_s(_lg_t))
})

// log(x, base) = ln(x)/ln(base)
D et_log_b = λ x, base . (et_log(x) / et_log(base))

// log2(x) = ln(x)/ln(2)
D et_log2 = λ x . (et_log(x) / ET_LN2)

// log10(x) = ln(x)/ln(10)
D et_log10 = λ x . (et_log(x) / ET_LN10)

// log1p(x) = ln(1+x), numerically stable for small x
// 2·arctanh(x/(x+2)) — equivalent to ln(1+x) via algebraic substitution
D et_log1p = λ x . (2 * _et_atanh_s((x / (x + 2))))

// --- SECTION 5: ET TRIGONOMETRIC — Leibniz T-series ---
// Ratio form avoids repeated factorial computation:
//   sin: t[k+1] = -t[k]·x²/((2k+2)(2k+3)), start t[0]=x
//   cos: t[k+1] = -t[k]·x²/((2k+1)(2k+2)), start t[0]=1

// sin(x): Leibniz ratio-series
// ET: T traverses 72 ratio steps, D = alternating sign × x² divisor sequence
D et_sin = λ x . {
    P _sn_r = x
    P _sn_t = x
    P _sn_xsq = (x * x)
    ∞ (
        P _sn_t = (0 - ((_sn_t * _sn_xsq) / (((2 * _loop_index) + 2) * ((2 * _loop_index) + 3))))
        P _sn_r = (_sn_r + _sn_t)
    ) (D 72)
    → _sn_r
}

// cos(x): Leibniz ratio-series
// ET: T traverses 72 ratio steps, D = alternating sign × x² divisor sequence
D et_cos = λ x . {
    P _cs_r = 1
    P _cs_t = 1
    P _cs_xsq = (x * x)
    ∞ (
        P _cs_t = (0 - ((_cs_t * _cs_xsq) / (((2 * _loop_index) + 1) * ((2 * _loop_index) + 2))))
        P _cs_r = (_cs_r + _cs_t)
    ) (D 72)
    → _cs_r
}

// tan(x) = sin(x)/cos(x) — D-composition of sin and cos descriptors
D et_tan = λ x . (et_sin(x) / et_cos(x))

// --- SECTION 6: ET INVERSE TRIGONOMETRIC ---

// asin(x) via Newton-Raphson on sin:
// g_{n+1} = g - (sin(g) - x)/cos(g)
// Initial estimate: g = x (first term of arcsin series)
D et_asin = λ x . {
    P _as_g = x
    ∞ (
        P _as_sg = et_sin(_as_g)
        P _as_cg = et_cos(_as_g)
        P _as_g = (if (_as_cg == 0) → _as_g → E (_as_g - ((_as_sg - x) / _as_cg)))
    ) (D 12)
    → _as_g
}

// acos(x) = π/2 - asin(x)
D et_acos = λ x . ((ET_PI / 2) - et_asin(x))

// atan(x): Leibniz ratio-series — same as _et_at helper
// ET: T traverses 72 steps, D = alternating denominator series
D et_atan = λ x . {
    P _ta_r = 0
    P _ta_xp = x
    P _ta_xs = (x * x)
    P _ta_s = 1
    ∞ (
        P _ta_r = (_ta_r + (_ta_s * (_ta_xp / ((2 * _loop_index) + 1))))
        P _ta_xp = (_ta_xp * _ta_xs)
        P _ta_s = (0 - _ta_s)
    ) (D 72)
    → _ta_r
}

// atan2(y, x): quadrant-aware atan
// D-descriptor: branch on quadrant of (x,y) to return full-range angle
D et_atan2 = λ y, x . (if (x > 0) → et_atan((y / x)) → E
    (if (x < 0) →
        (if (y >= 0) → (et_atan((y / x)) + ET_PI) → E (et_atan((y / x)) - ET_PI))
        → E (if (y > 0) → (ET_PI / 2) → E
            (if (y < 0) → (0 - (ET_PI / 2)) → E 0))))

// --- SECTION 7: ET HYPERBOLIC FUNCTIONS ---
// sinh(x) = (e^x - e^{-x})/2  — D-composition over et_exp
// cosh(x) = (e^x + e^{-x})/2
// tanh(x) = sinh(x)/cosh(x)

D et_sinh = λ x . ((et_exp(x) - et_exp((0 - x))) / 2)
D et_cosh = λ x . ((et_exp(x) + et_exp((0 - x))) / 2)
D et_tanh = λ x . (et_sinh(x) / et_cosh(x))

// --- SECTION 8: ET POWER & ABSOLUTE VALUE ---

// pow(x, y) = exp(y·ln(x)) — D-composition of exp and log descriptors
// ET: P (base) ∘ D (exponent constraint) ∘ T (exp-log traversal) = x^y
D et_pow = λ x, y . (if (x == 0) → 0 → E et_exp((y * et_log(x))))

// fabs(x): absolute value — D-conditional on sign
// ET: D-descriptor selects the non-negative P-branch
D et_fabs = λ x . (if (x < 0) → (0 - x) → E x)

// copysign(x, y): magnitude of x with sign of y
D et_copysign = λ x, y . (if (y < 0) → (0 - et_fabs(x)) → E et_fabs(x))

// hypot(x, y) = √(x² + y²)
D et_hypot = λ x, y . et_sqrt(((x * x) + (y * y)))

// --- SECTION 9: ET FLOOR, CEIL, ROUND, TRUNCATE ---
// Derived from modulo descriptor: floor(x) = x - (x mod 1)
// ET: D-bounded remainder after T-traversal of integer steps

// et_floor_pos: floor for x ≥ 0, using modulo descriptor
// For x ≥ 0: x % 1 = fractional part, floor = x - frac
D _et_fl_pos = λ x . (x - (x % 1))

// et_floor(x): full-domain floor
// For x < 0 with non-zero fractional part: floor = -(floor_pos(-x)) - 1
// For x < 0 with zero fractional part: floor = -floor_pos(-x)
D et_floor = λ x . {
    P _fl_ax = (if (x >= 0) → x → E (0 - x))
    P _fl_fp = _et_fl_pos(_fl_ax)
    P _fl_fr = (_fl_ax - _fl_fp)
    → (if (x >= 0) → _fl_fp → E
        (if (_fl_fr == 0) → (0 - _fl_fp) → E ((0 - _fl_fp) - 1)))
}

// et_ceil(x): ceiling = -(floor(-x))
// ET: D-complement of floor descriptor
D et_ceil = λ x . (0 - et_floor((0 - x)))

// et_trunc(x): truncate toward zero
// ET: D-bounded to integer part by discarding fractional descriptor
D et_trunc = λ x . (if (x >= 0) → et_floor(x) → E (0 - et_floor((0 - x))))

// et_round(x): round to nearest integer (ties go to even)
D et_round = λ x . {
    P _rn_f = et_floor(x)
    P _rn_fr = (x - _rn_f)
    → (if (_rn_fr > 0.5) → (_rn_f + 1) → E
        (if (_rn_fr < 0.5) → _rn_f → E
            (if ((_rn_f % 2) == 0) → _rn_f → E (_rn_f + 1))))
}

// fmod(x, y): ET modulo — remainder after D-bounded T-traversal
// ET: residual P-substrate after dividing D-steps of y into x
D et_fmod = λ x, y . (x - (y * et_trunc((x / y))))

// modf(x): decompose into integer and fractional parts
// Returns fractional part (integer accessible via et_trunc)
D et_modf_frac = λ x . (x - et_trunc(x))
D et_modf_int = λ x . et_trunc(x)

// frexp: decompose into mantissa m and exponent e: x = m * 2^e
// where 0.5 ≤ |m| < 1. Implemented via ET log2 decomposition.
D et_frexp_exp = λ x . {
    P _fe_ax = (if (x < 0) → (0 - x) → E x)
    P _fe_e = et_floor(et_log2(_fe_ax))
    → (_fe_e + 1)
}
D et_frexp_mant = λ x . {
    P _fm_e = et_frexp_exp(x)
    // mantissa = x / 2^e, computed via exp(-e * ln2)
    → (x * et_exp((0 - _fm_e * ET_LN2)))
}

// ldexp(x, i) = x * 2^i
D et_ldexp = λ x, i . (x * et_exp((i * ET_LN2)))

// --- SECTION 10: ET FACTORIAL & COMBINATORICS ---
// D-loop traversal: n! = ∏_{k=1}^{n} k
// ET: T traverses n steps, D accumulates factorial product
D et_factorial = λ n . {
    P _fc_r = 1
    ∞ (P _fc_r = (_fc_r * (_loop_index + 1))) (D n)
    → _fc_r
}

// GCD via Euclidean algorithm — T-iteration with D-modular descent
D et_gcd = λ a, b . {
    P _gc_a = (if (a < 0) → (0 - a) → E a)
    P _gc_b = (if (b < 0) → (0 - b) → E b)
    ∞ (
        T _gc_t = → _gc_a
        P _gc_a = (_gc_b % _gc_a)
        P _gc_b = _gc_t
        T _gc_sw = → if (_gc_a == 0) → P _gc_a = _gc_b → E P _gc_a = _gc_a
    ) (D 144)
    → (if (_gc_b == 0) → _gc_a → E _gc_b)
}

// LCM via ET: |a*b| / gcd(a,b)
D et_lcm = λ a, b . (et_fabs((a * b)) / et_gcd(a, b))

// --- SECTION 11: ET SPECIAL FUNCTIONS ---

// erf(x) via Taylor series: erf(x) = (2/√π) · Σ (-1)^k x^(2k+1) / (k!(2k+1))
// Ratio form: t[k+1] = -t[k] · x² / (k+1) · (2k+1)/(2k+3)
D et_erf = λ x . {
    P _ef_r = x
    P _ef_t = x
    P _ef_xsq = (x * x)
    ∞ (
        P _ef_t = (0 - (_ef_t * _ef_xsq / ((_loop_index + 1) * ((2 * _loop_index) + 3) / ((2 * _loop_index) + 1))))
        P _ef_r = (_ef_r + _ef_t)
    ) (D 72)
    // multiply by 2/√π
    → (_ef_r * 1.1283791670955126)
}

// erfc(x) = 1 - erf(x)
D et_erfc = λ x . (1 - et_erf(x))

// gamma(x) via Lanczos approximation with g=7, n=9
// Lanczos: Γ(z) ≈ √(2π) · ((z + g - 1/2)/e)^(z-1/2) · A(z)
// where A(z) = c[0] + Σ_{k=1}^{n} c[k]/(z+k-1)
// Lanczos coefficients for g=7 (Numerical Recipes 6.1)
D et_gamma = λ x . {
    // Reflection for x < 0.5: Γ(x)Γ(1-x) = π/sin(πx)
    P _gm_x = (if (x < 0.5) → (1 - x) → E x)
    // Lanczos sum with g=5 coefficients (simplified; enough for double precision)
    // c = [1.000000000190015, 76.18009172947146, -86.50532032941677,
    //       24.01409824083091, -1.231739572450155, 0.001208650973866179,
    //       -0.000005395239384953]
    P _gm_c0 = 1.000000000190015
    P _gm_c1 = 76.18009172947146
    P _gm_c2 = -86.50532032941677
    P _gm_c3 = 24.01409824083091
    P _gm_c4 = -1.231739572450155
    P _gm_c5 = 0.001208650973866179
    P _gm_c6 = -0.000005395239384953
    P _gm_s = (_gm_c0 + (_gm_c1 / _gm_x) + (_gm_c2 / (_gm_x + 1)) +
               (_gm_c3 / (_gm_x + 2)) + (_gm_c4 / (_gm_x + 3)) +
               (_gm_c5 / (_gm_x + 4)) + (_gm_c6 / (_gm_x + 5)))
    P _gm_t = (_gm_x + 5.5)
    P _gm_result = (2.5066282746310002 * et_pow(_gm_t, (_gm_x - 0.5)) *
                    et_exp((0 - _gm_t)) * _gm_s)
    → (if (x < 0.5) → (ET_PI / (et_sin((ET_PI * x)) * _gm_result)) → E _gm_result)
}

// lgamma(x) = ln|Γ(x)|
D et_lgamma = λ x . et_log(et_fabs(et_gamma(x)))

// --- SECTION 12: ET UTILITY FUNCTIONS ---

// Degree/Radian conversions
// ET: D-scalar binding with π ratio
D et_degrees = λ x . (x * (180 / ET_PI))
D et_radians = λ x . (x * (ET_PI / 180))

// isnan: x is NaN if and only if x ≠ x (IEEE 754 axiom)
// ET: D-identity check — a P-substrate is indeterminate iff it is not self-equal
D et_isnan = λ x . (if (x == x) → 0 → E 1)

// isinf: x is infinite if |x| overflows finite descriptor bound
// ET: D-cardinality check — absolute value exceeds maximum finite P-substrate
D et_isinf = λ x . (if (et_fabs(x) > 1.7976931348623157e+308) → 1 → E 0)

// isfinite: not nan and not inf
D et_isfinite = λ x . (if (et_isnan(x) == 1) → 0 → E (if (et_isinf(x) == 1) → 0 → E 1))

// prod(iterable): T-product accumulator
// For manifold inputs — traverses all elements
D et_prod = λ items . {
    P _pr_r = 1
    ∞ (P _pr_r = (_pr_r * items[_loop_index])) (D WHILE_LOOP_FINITE_BOUND)
    → _pr_r
}

// sum_et(items): T-sum accumulator (supplement to built-in sum)
D et_sum_seq = λ items . {
    P _sm_r = 0
    ∞ (P _sm_r = (_sm_r + items[_loop_index])) (D WHILE_LOOP_FINITE_BOUND)
    → _sm_r
}

