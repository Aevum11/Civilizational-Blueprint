    D ET_Marshal__etb_dumps = λ source . {
        // Serialize source to ETB binary format.         ET Master Equation: P(source) ∘ D(ETB format) ∘ T(encode) = E(bytes)     
        P src_bytes = source D encode("utf-8")
        P header = ET_Marshal D etb_header(len(src_bytes))
        P payload_section = ET_Marshal D etb_encode(src_bytes)
        P body = (header + payload_section)
        P checksum = ET_Marshal D etb_checksum(body)
        → (body + checksum)
    }
    D ET_Marshal__etb_loads = λ data . {
        // Deserialize ETB binary to Python source string.         ET: T traverses the byte stream; D validates magic, version, che
        T cond = → if len(data) < 24 → → E ValueError("ET_Marshal: ETB data too short")
        T cond = → if data[0:4] ≠ ET_Marshal D ETB_MAGIC → → E ValueError("ET_Marshal: bad magic " + data[0:4])
        P version = struct D unpack("<I", data[4:8])[0]
        T cond = → if version ≠ ET_Marshal D ETB_VERSION → → E ValueError("ET_Marshal: unsupported version " + version)
        P source_size = struct D unpack("<I", data[16:20])[0]
        P payload_len = struct D unpack("<I", data[20:24])[0]
        P payload = data[24:(24 + payload_len)]
        T cond = → if len(payload) ≠ payload_len → → E ValueError("ET_Marshal: payload truncated")
        P body = data[0:((20 + 4) + payload_len)]
        P expected_cs = struct D unpack("<I", data[((20 + 4) + payload_len):(((20 + 4) + payload_len) + 4)])[0]
        P actual_cs = ET_Marshal D adler32(body)
        T cond = → if expected_cs ≠ actual_cs → → E ValueError("ET_Marshal: checksum mismatch (expected " + expected_cs + ", got " + actual_cs + ")")
        → payload D decode("utf-8")
    }
    D ET_Marshal__pyc_magic_bytes = λ  . {
        // Produce Python .pyc magic bytes WITHOUT importing importlib.         ET: D-maps Python version_info to the canonical mag
        P minor = sys D version_info D minor
        P magic_int = ET_Marshal D _PYC_MAGIC_MAP D get(minor)
        T cond = → if magic_int == P → P magic_int = ((3300 + (minor * 12)) + 13)
        P lo = (magic_int & 255)
        P hi = ((magic_int >> 8) & 255)
        → bytes(manifold [lo, hi, 13, 10])
    }
    D ET_Marshal__pyc_dumps = λ source, filename . {
        // Compile Python source and produce .pyc bytes WITHOUT marshal or importlib.          Pipeline (ET P∘D∘T=E):           P: 
        T attempt = → P  // try
            // @ETPL:preload _t time
            // Import time — resolved at translate-time
            P mtime = (int(_t D time(P)) & 4294967295)
        → E Exception (_)
            P mtime = 0
        P src_bytes = source D encode("utf-8")
        P src_size = (len(src_bytes) & 4294967295)
        T attempt = → P  // try
            P code_obj = compile(source, filename, "exec", manifold ["optimize", 0], manifold ["dont_inherit", 1])
        → E SyntaxError (exc)
            P err = "raise SyntaxError(" + exc D msg + ", (" + exc D filename + ", " + exc D lineno + ", " + exc D offset + ", " + exc D text + "))"
            P code_obj = compile(err, "<etpl_error>", "exec")
        T attempt = → P  // try
            P _real_marshal = sys D modules D get("marshal")
            T cond = → if _real_marshal == P → P  // pass
            P marshalled = _real_marshal D dumps(code_obj)
        → E Exception (_)
            P marshalled = ET_Marshal D _marshal_code_obj(code_obj)
        T attempt = → P  // try
            P _ilu = sys D modules D get("importlib.util")
            T cond = → if _ilu == P → P
                // @ETPL:preload _ilu importlib.util
                // Import importlib.util — resolved at translate-time
                // @ETPL:preload LazyLoader importlib.util.LazyLoader
                P LazyLoader = P  // [ET:callable:importlib.util.LazyLoader]
                // @ETPL:preload Loader importlib.util.Loader
                P Loader = P  // [ET:callable:importlib.util.Loader]
                P MAGIC_NUMBER = "f30d0d0a"  // bytes
                // @ETPL:preload cache_from_source importlib.util.cache_from_source
                P cache_from_source = P  // [ET:callable:importlib.util.cache_from_source]
                // @ETPL:preload decode_source importlib.util.decode_source
                P decode_source = P  // [ET:callable:importlib.util.decode_source]
                // @ETPL:preload find_spec importlib.util.find_spec
                P find_spec = P  // [ET:callable:importlib.util.find_spec]
                // @ETPL:preload module_from_spec importlib.util.module_from_spec
                P module_from_spec = P  // [ET:callable:importlib.util.module_from_spec]
                // @ETPL:preload resolve_name importlib.util.resolve_name
                P resolve_name = P  // [ET:callable:importlib.util.resolve_name]
                // @ETPL:preload source_from_cache importlib.util.source_from_cache
                P source_from_cache = P  // [ET:callable:importlib.util.source_from_cache]
                // @ETPL:preload source_hash importlib.util.source_hash
                P source_hash = P  // [ET:callable:importlib.util.source_hash]
                // @ETPL:preload spec_from_file_location importlib.util.spec_from_file_location
                P spec_from_file_location = P  // [ET:callable:importlib.util.spec_from_file_location]
                // @ETPL:preload spec_from_loader importlib.util.spec_from_loader
                P spec_from_loader = P  // [ET:callable:importlib.util.spec_from_loader]
            P magic = _ilu D MAGIC_NUMBER
        → E Exception (_)
            P magic = ET_Marshal D pyc_magic_bytes(P)
        P flags = struct D pack("<I", 0)
        P ts = struct D pack("<I", mtime)
        P ssize = struct D pack("<I", src_size)
        → ((((magic + flags) + ts) + ssize) + marshalled)
    }
    D ET_Marshal___marshal_code_obj = λ code_obj . {
        // Serialize a Python code object to marshal bytes in pure Python.          ET derivation:           P = code object (infin
        P ctx = _MarshalContext(P)
        ctx D write_object(code_obj)
        → bytes(ctx D buf)
    }
D MarshalContext = λ . P  // class
    // Pure-Python marshal serializer context.     ET: P = value substrate, D = type rule, T = recursive traversal, E = bytes. 
    P TYPE_NULL = ord("0")
    P TYPE_NONE = ord("N")
    P TYPE_FALSE = ord("F")
    P TYPE_TRUE = ord("T")
    P TYPE_STOPITER = ord("S")
    P TYPE_ELLIPSIS = ord(".")
    P TYPE_INT = ord("i")
    P TYPE_INT64 = ord("I")
    P TYPE_FLOAT = ord("g")
    P TYPE_COMPLEX = ord("y")
    P TYPE_STRING = ord("s")
    P TYPE_INTERNED = ord("t")
    P TYPE_REF = ord("r")
    P TYPE_TUPLE = ord("(")
    P TYPE_LIST = ord("[")
    P TYPE_DICT = ord("{")
    P TYPE_CODE = ord("c")
    P TYPE_UNICODE = ord("u")
    P TYPE_UNKNOWN = ord("?")
    P TYPE_SET = ord("<")
    P TYPE_FROZENSET = ord(">")
    P TYPE_ASCII = ord("a")
    P TYPE_ASCII_INTERNED = ord("A")
    P TYPE_SMALL_TUPLE = ord(")")
    P TYPE_SHORT_ASCII = ord("z")
    P TYPE_SHORT_ASCII_INTERNED = ord("Z")
    P FLAG_REF = 128
    D MarshalContext____init = λ self . {
        D self_D_buf = manifold []  // self D buf := manifold []
        D self_D_ref_table = manifold []  // self D ref_table := manifold []
    }
    D MarshalContext___write_byte = λ self, b . self D buf D append((b & 255))
    D MarshalContext___write_bytes = λ self, data . self D buf D extend(data)
    D MarshalContext___write_u32 = λ self, n . {
        // Write 4-byte little-endian unsigned int.
        self D _write_bytes(struct D pack("<I", (n & 4294967295)))
    }
    D MarshalContext___write_i32 = λ self, n . {
        // Write 4-byte little-endian signed int.
        self D _write_bytes(struct D pack("<i", n))
    }
    D MarshalContext___write_u64 = λ self, n . {
        // Write 8-byte little-endian unsigned int.
        self D _write_bytes(struct D pack("<Q", (n & 18446744073709551615)))
    }
    D MarshalContext___write_double = λ self, f . {
        // Write 8-byte IEEE 754 double (little-endian).
        self D _write_bytes(struct D pack("<d", f))
    }
    D MarshalContext__write_object = λ self, obj . {
        // Serialize obj to the marshal byte stream.         ET T-traversal: dispatches on type (D-constraint), writes bytes (E-out
        T cond = → if obj == P → self D _write_byte(self D TYPE_NONE)
        → E P
            T cond = → if obj == 0 → self D _write_byte(self D TYPE_FALSE)
            → E P
                T cond = → if obj == 1 → self D _write_byte(self D TYPE_TRUE)
                → E P
                    T cond = → if obj == Ellipsis → self D _write_byte(self D TYPE_ELLIPSIS)
                    → E P
                        T cond = → if isinstance(obj, int) → self D _write_int(obj)
                        → E P
                            T cond = → if isinstance(obj, float) → P
                                self D _write_byte(self D TYPE_FLOAT)
                                self D _write_double(obj)
                            → E P
                                T cond = → if isinstance(obj, complex) → P
                                    self D _write_byte(self D TYPE_COMPLEX)
                                    self D _write_double(obj D real)
                                    self D _write_double(obj D imag)
                                → E P
                                    T cond = → if isinstance(obj, bytes) → P
                                        self D _write_byte(self D TYPE_STRING)
                                        self D _write_u32(len(obj))
                                        self D _write_bytes(obj)
                                    → E P
                                        T cond = → if isinstance(obj, str) → self D _write_str(obj)
                                        → E P
                                            T cond = → if isinstance(obj, tuple) → self D _write_tuple(obj)
                                            → E P
                                                T cond = → if isinstance(obj, list) → P
                                                    self D _write_byte(self D TYPE_LIST)
                                                    self D _write_u32(len(obj))
                                                    T loop = ∞ (
                                                        P item = obj[_loop_index]
                                                        self D write_object(item)
                                                    ) (D |obj|)
                                                → E P
                                                    T cond = → if isinstance(obj, manifold [set, frozenset]) → P
                                                        P tag = if isinstance(obj, frozenset) → self D TYPE_FROZENSET → E self D TYPE_SET
                                                        self D _write_byte(tag)
                                                        self D _write_u32(len(obj))
                                                        T loop = ∞ (
                                                            P item = sorted(obj, manifold ["key", repr])[_loop_index]
                                                            self D write_object(item)
                                                        ) (D |sorted(obj, manifold ["key", repr])|)
                                                    → E P
                                                        T cond = → if isinstance(obj, dict) → P
                                                            self D _write_byte(self D TYPE_DICT)
                                                            T loop = ∞ (
                                                                P manifold__k__v = obj D items(P)[_loop_index]  // manifold [k, v]
                                                                self D write_object(k)
                                                                self D write_object(v)
                                                            ) (D |obj D items(P)|)
                                                            self D _write_byte(self D TYPE_NULL)
                                                        → E P
                                                            T cond = → if (hasattr(obj, "co_code") || hasattr(obj, "co_consts")) → self D _write_code_obj(obj)
                                                            → E self D _write_byte(self D TYPE_NONE)
    }
    D MarshalContext___write_int = λ self, n . {
        // Write integer in marshal format.         ET: D dispatches on range:           fits in i32: TYPE_INT + 4 bytes           
        T cond = → if (-2147483648) ≤ n ≤ 2147483647 → P
            self D _write_byte(self D TYPE_INT)
            self D _write_i32(n)
        → E P
            T cond = → if (-9223372036854775808) ≤ n ≤ 9223372036854775807 → P
                self D _write_byte(self D TYPE_INT64)
                self D _write_bytes(struct D pack("<q", n))
            → E P
                self D _write_byte(ord("l"))
                P sign = if n ≥ 0 → 1 → E (-1)
                P n_abs = _et_abs(n)
                P digits = manifold []
                T while_loop = ∞ (
                    T check = → if n_abs → P  // while body follows
                        digits D append((n_abs & 32767))
                        P n_abs = n_abs >> 15
                ) (D WHILE_LOOP_FINITE_BOUND)  // bounded by condition; max=144
                P size = (len(digits) * sign)
                self D _write_i32(size)
                T loop = ∞ (
                    P d = digits[_loop_index]
                    self D _write_bytes(struct D pack("<H", d))
                ) (D |digits|)
    }
    D MarshalContext___write_str = λ self, s . {
        // Write string in marshal format.         ET: D selects encoding based on content:           short ASCII (≤ 255 bytes, all
        T attempt = → P  // try
            P b = s D encode("ascii")
            T cond = → if len(b) ≤ 255 → P
                self D _write_byte(self D TYPE_SHORT_ASCII)
                self D _write_byte(len(b))
                self D _write_bytes(b)
            → E P
                self D _write_byte(self D TYPE_ASCII)
                self D _write_u32(len(b))
                self D _write_bytes(b)
        → E UnicodeEncodeError (_)
            P b = s D encode("utf-8")
            self D _write_byte(self D TYPE_UNICODE)
            self D _write_u32(len(b))
            self D _write_bytes(b)
    }
    D MarshalContext___write_tuple = λ self, t . {
        // Write tuple in marshal format.         ET: D selects SMALL_TUPLE (1-byte count) for len ≤ 255, else TUPLE (4-byte).
        T cond = → if len(t) ≤ 255 → P
            self D _write_byte(self D TYPE_SMALL_TUPLE)
            self D _write_byte(len(t))
        → E P
            self D _write_byte(self D TYPE_TUPLE)
            self D _write_u32(len(t))
        T loop = ∞ (
            P item = t[_loop_index]
            self D write_object(item)
        ) (D |t|)
    }
    D MarshalContext___write_code_obj = λ self, co . {
        // Write Python code object in marshal format.         ET: T traverses all co_* fields in version-appropriate order.       
        self D _write_byte(self D TYPE_CODE)
        P minor = sys D version_info D minor
        self D _write_int(co D co_argcount)
        T cond = → if hasattr(co, "co_posonlyargcount") → self D _write_int(co D co_posonlyargcount)
        self D _write_int(co D co_kwonlyargcount)
        T cond = → if hasattr(co, "co_nlocals") → self D _write_int(co D co_nlocals)
        self D _write_int(co D co_stacksize)
        self D _write_int(co D co_flags)
        P code_bytes = bytes(co D co_code)
        self D write_object(code_bytes)
        self D write_object(co D co_consts)
        self D write_object(co D co_names)
        self D write_object(co D co_varnames)
        self D write_object(co D co_freevars)
        self D write_object(co D co_cellvars)
        self D write_object(co D co_filename)
        self D write_object(co D co_name)
        T cond = → if hasattr(co, "co_qualname") → self D write_object(co D co_qualname)
        self D _write_int(co D co_firstlineno)
        T cond = → if (minor ≥ 11 && hasattr(co, "co_linetable")) → self D write_object(bytes(co D co_linetable))
        → E P
            T cond = → if hasattr(co, "co_lnotab") → self D write_object(bytes(co D co_lnotab))
            → E self D write_object(b'')
        T cond = → if (minor ≥ 11 && hasattr(co, "co_exceptiontable")) → self D write_object(bytes(co D co_exceptiontable))
    }
P MANIFOLD_SYMMETRY = 12
P BASE_VARIANCE = (1.0 / 12.0)
P KOIDE_RATIO = (2.0 / 3.0)
P DARK_ENERGY_RATIO = (68.3 / 100.0)
P DARK_MATTER_RATIO = (26.8 / 100.0)
P ORDINARY_MATTER_RATIO = (4.9 / 100.0)
P PLANCK_CONSTANT_HBAR = 1.054571817e-34
P PLANCK_CONSTANT_H = 6.62607015e-34
P ELEMENTARY_CHARGE = 1.602176634e-19
P SPEED_OF_LIGHT = 299792458.0
P FINE_STRUCTURE_CONSTANT = 0.0072973525693
P FINE_STRUCTURE_INVERSE = 137.035999084
P ELECTRON_MASS = 9.1093837015e-31
P PROTON_MASS = 1.67262192369e-27
P BOHR_RADIUS = 5.29177210903e-11
P RYDBERG_ENERGY = 13.605693122994
P RYDBERG_CONSTANT = 10973731.56816
P GRAVITATIONAL_CONSTANT = 6.6743e-11
P PLANCK_LENGTH = 1.616255e-35
P PLANCK_TIME = 5.391247e-44
P VACUUM_PERMITTIVITY = 8.8541878128e-12
P CARDINALITY_P_INFINITE = float("inf")
P CARDINALITY_D_FINITE = MANIFOLD_SYMMETRY
P CARDINALITY_T_INDETERMINATE = 0
P STATE_COUNT = 4
P EM_CHANNELS = 8
P SHIMMER_AMPLITUDE = ETMathNative D et_sqrt(BASE_VARIANCE)
P MANIFOLD_IMPEDANCE = (((MANIFOLD_SYMMETRY - 1) ^ 2) + (STATE_COUNT ^ 2))
P EIM_EXCEPTION = 1
P EIM_INCOHERENCE = 2
P EIM_MEDIATION = 3
P EIM_COHERENCE_FACTOR = (1.0 / ((MANIFOLD_SYMMETRY / 6) ^ 0.5))
P SOMETHING_FORMULA = "P∘D∘T=EIM=S"
P TAUTOLOGICAL_FORM = "3=3=3=Σ"
P M_STATE_UNSUBSTANTIATED = 0
P M_STATE_GROUND = 0
P M_STATE_SUBSTANTIATED = 1
P M_STATE_EXCITED = 1
P M_STATE_INCOHERENT = 2
P M_STATE_TRAVERSAL = 3
P M_STATES_COUNT = 4
P T_SINGULARITY_THRESHOLD = 1e-09
P PHI_GOLDEN_RATIO = ((1.0 + ETMathNative D et_sqrt(5.0)) / 2.0)
P POINT_IS_INFINITE = 1
P DESCRIPTOR_IS_FINITE = 1
P BINDING_CREATES_FINITUDE = 1
P ULTIMATE_DESCRIPTOR_COMPLETE = 1
P CARDINALS_ARE_NOT_PROPER_CLASSES = 1
P WHILE_LOOP_FINITE_BOUND = (MANIFOLD_SYMMETRY ^ 2)
P ETPL_VERSION = "1.4.9"
P ETPL_BUILD = "20260302-linker-abi-fix"
P _ET_MATH_PREAMBLE = "\n# ET-Native Math Functions (zero import math — P o D o T = E)\ndef _et_ln2():\n    # ln(2) = 2*arctanh(1/3) via T-series\n    r, x, xsq = 0.0, 1.0/3.0, 1.0/9.0\n    for k in range(72):\n        r += x / (2*k+1)\n        x *= xsq\n    return 2.0 * r\ndef _et_ln10():\n    ln2 = _et_ln2()\n    r, x, xsq = 0.0, 1.0/9.0, 1.0/81.0\n    for k in range(72):\n        r += x / (2*k+1)\n        x *= xsq\n    return 3.0*ln2 + 2.0*r\n_ET_LN2  = _et_ln2()\n_ET_LN10 = _et_ln10()\ndef _et_sqrt(x):\n    if x < 0: return float('nan')\n    if x == 0: return 0.0\n    g = x/2.0 if x >= 1.0 else x*2.0\n    if g > 1e154: g = 1e154\n    elif g < 1e-154 and x > 0: g = 1e-154\n    for _ in range(64):\n        gn = (g + x/g)*0.5\n        if abs(gn-g) <= abs(g)*2.220446049250313e-16: return gn\n        g = gn\n    return g\ndef _et_exp(x):\n    if x > 709.78: return float('inf')\n    if x < -745.13: return 0.0\n    r, t = 1.0, 1.0\n    for k in range(1, 145):\n        t *= x/k; r += t\n        if abs(t) < abs(r)*2.220446049250313e-16: break\n    return r\ndef _et_log(x):\n    if x <= 0: return float('nan') if x < 0 else float('-inf')\n    if x == 1.0: return 0.0\n    e, m = 0, x\n    while m > 2.0: m /= 2.0; e += 1\n    while m < 0.5: m *= 2.0; e -= 1\n    t = (m-1.0)/(m+1.0); ts = t*t; r = 0.0; xp = t\n    for k in range(72): r += xp/(2*k+1); xp *= ts\n    return 2.0*r + e*_ET_LN2\ndef _et_arctan_ser(x, n=72):\n    # Leibniz T-series arctan(x) = sum(-1)^k x^(2k+1)/(2k+1), |x|<=1\n    r, xp, xsq, sg = 0.0, x, x*x, 1.0\n    for k in range(n): r += sg*xp/(2*k+1); xp *= xsq; sg = -sg\n    return r\n# ET_PI via Machin's formula: pi/4 = 4*arctan(1/5) - arctan(1/239)\n# FIX v1.4.3: computed natively here (zero import math — P o D o T = E)\n_ET_PI = 4.0*(4.0*_et_arctan_ser(1.0/5.0) - _et_arctan_ser(1.0/239.0))\ndef _et_sin(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    x -= 2.0*_ET_PI*int(x/(2.0*_ET_PI)+0.5)\n    r, t, xsq = x, x, x*x\n    for k in range(72):\n        t = -t*xsq/((2*k+2)*(2*k+3)); r += t\n        if abs(t) < abs(r)*2.220446049250313e-16: break\n    return r\ndef _et_cos(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    x -= 2.0*_ET_PI*int(x/(2.0*_ET_PI)+0.5)\n    r, t, xsq = 1.0, 1.0, x*x\n    for k in range(72):\n        t = -t*xsq/((2*k+1)*(2*k+2)); r += t\n        if abs(t) < abs(r)*2.220446049250313e-16: break\n    return r\ndef _et_tan(x):\n    c = _et_cos(x)\n    return _et_sin(x)/c if c != 0 else float('inf')\ndef _et_floor(x):\n    n = int(x)\n    if x < 0.0 and x != n: n -= 1\n    return float(n)\ndef _et_ceil(x): return -_et_floor(-x)\ndef _et_fabs(x): return -x if x < 0 else x\ndef _et_pow(x, y):\n    if y == 0.0: return 1.0\n    if x == 0.0: return 0.0 if y > 0 else float('inf')\n    return _et_exp(y * _et_log(_et_fabs(x))) * (1 if x > 0 or int(y)%2==0 else -1)\ndef _et_atan(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    if abs(x) > 1.0:\n        s = 1.0 if x > 0 else -1.0\n        r, xp, xsq, sg = 0.0, 1.0/abs(x), 1.0/(x*x), 1.0\n        for k in range(72): r += sg*xp/(2*k+1); xp *= xsq; sg = -sg\n        return s*(_ET_PI/2.0 - r)\n    r, xp, xsq, sg = 0.0, x, x*x, 1.0\n    for k in range(72): r += sg*xp/(2*k+1); xp *= xsq; sg = -sg\n    return r\ndef _et_atan2(y, x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    if x > 0: return _et_atan(y/x)\n    if x < 0: return _et_atan(y/x)+_ET_PI if y >= 0 else _et_atan(y/x)-_ET_PI\n    if y > 0: return _ET_PI/2\n    if y < 0: return -_ET_PI/2\n    return 0.0\ndef _et_asin(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    if x > 1 or x < -1: return float('nan')\n    if x == 1: return _ET_PI/2\n    if x == -1: return -_ET_PI/2\n    g = x\n    for _ in range(12):\n        sg, cg = _et_sin(g), _et_cos(g)\n        if cg == 0: break\n        g -= (sg - x)/cg\n    return g\ndef _et_acos(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    return _ET_PI/2 - _et_asin(x)\ndef _et_sinh(x): return (_et_exp(x) - _et_exp(-x)) * 0.5\ndef _et_cosh(x): return (_et_exp(x) + _et_exp(-x)) * 0.5\ndef _et_tanh(x):\n    c = _et_cosh(x)\n    return _et_sinh(x)/c if c != 0 else float('nan')\ndef _et_log2(x): return _et_log(x)/_ET_LN2\ndef _et_log10(x): return _et_log(x)/_ET_LN10\ndef _et_isnan(x): return x != x\ndef _et_isinf(x): return _et_fabs(x) > 1.7976931348623157e+308\ndef _et_isfinite(x): return not _et_isnan(x) and not _et_isinf(x)\ndef _et_hypot(x, y): return _et_sqrt(x*x + y*y)\ndef _et_degrees(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    return x * (180.0/_ET_PI)\ndef _et_radians(x):\n    # FIX v1.4.3: use _ET_PI (no import math)\n    return x * (_ET_PI/180.0)\ndef _et_factorial(n):\n    r = 1\n    for k in range(2, n+1): r *= k\n    return r\ndef _et_gcd(a, b):\n    a, b = abs(a), abs(b)\n    for _ in range(144):\n        if a == 0: return b\n        a, b = b%a, a\n    return a\n# Make ET math available as module-level names in compiled output\nimport math as _math_compat  # kept for complex stdlib code; ET functions take priority\nsin=_et_sin; cos=_et_cos; tan=_et_tan; log=_et_log; sqrt=_et_sqrt\nexp=_et_exp; log2=_et_log2; log10=_et_log10; floor=_et_floor; ceil=_et_ceil\nfabs=_et_fabs; pow=_et_pow; atan=_et_atan; atan2=_et_atan2; asin=_et_asin\nacos=_et_acos; sinh=_et_sinh; cosh=_et_cosh; tanh=_et_tanh; hypot=_et_hypot\ndegrees=_et_degrees; radians=_et_radians; factorial=_et_factorial; gcd=_et_gcd\nisnan=_et_isnan; isinf=_et_isinf; isfinite=_et_isfinite\n"
D PrimitiveType = λ . P  // class(Enum)
    // The three fundamental primitives of Exception Theory.
    P POINT = auto(P)
    P DESCRIPTOR = auto(P)
    P TRAVERSER = auto(P)
D Point = λ . P  // class
    // P (Point): The substrate of existence.     |P| = Ω (absolute infinite). A Point is infinite until bound.     Cardinal: T
    P location = P
    P state = P
    P descriptors = P
    D Point__bind = λ self, descriptor . {
        T cond = → if self D descriptors == P → D self_D_descriptors = manifold []  // self D descriptors := manifold []
        self D descriptors D append(descriptor)
        → self
    }
    D Point__substantiate = λ self, value . {
        D self_D_state = value  // self D state := value
        → self
    }
D Descriptor = λ . P  // class
    // D (Descriptor): Constraints and properties.     |D| = n (finite). A Descriptor is finite.     Cardinal: The set of all s
    P name = ""
    P constraint = P
    P metadata = P
    P left = P
    P right = P
    P body = P
    P params = P
    P elements = P
    P condition = P
    P then_branch = P
    P else_branch = P
    P op_token = ""
    D Descriptor__apply = λ self, point . {
        T cond = → if callable(self D constraint) → → self D constraint(if isinstance(point, Point) → point D state → E point)
        → if isinstance(point, Point) → point D state → E point == self D constraint
    }
    D Descriptor__compose = λ self, other . {
        D Descriptor__composed_constraint = λ value . {
            P r1 = if callable(self D constraint) → self D constraint(value) → E value == self D constraint
            P r2 = if callable(other D constraint) → other D constraint(value) → E value == other D constraint
            → (r1 && r2)
        }
        → Descriptor(manifold ["name", self D name + "∘" + other D name], manifold ["constraint", composed_constraint], manifold ["metadata", manifold [manifold ["composition", manifold [self, other]]]])
    }
D Traverser = λ . P  // class
    // T (Traverser): Agency and navigation.     |T| = [0/0] (indeterminate). A Traverser is Indeterminate.     Cardinal: The s
    P identity = ""
    P current_point = P
    P history = P
    P choices = P
    P m_state = M_STATE_UNSUBSTANTIATED
    D Traverser____post_init = λ self . T cond = → if self D history == P → D self_D_history = manifold []  // self D history := manifold []
    D Traverser__traverse = λ self, target_point . {
        // Navigate T to a new P∘D configuration.
        T cond = → if self D current_point ≠ P → self D history D append(self D current_point)
        D self_D_current_point = target_point  // self D current_point := target_point
        D self_D_m_state = M_STATE_TRAVERSAL  // self D m_state := M_STATE_TRAVERSAL
        → self
    }
    D Traverser__observe = λ self, point . {
        // T observes a Point — collapses to M_STATE_SUBSTANTIATED.
        D self_D_m_state = M_STATE_SUBSTANTIATED  // self D m_state := M_STATE_SUBSTANTIATED
        → if isinstance(point, Point) → point D state → E point
    }
    D Traverser__ground = λ self . {
        // Return to unsubstantiated state.
        D self_D_m_state = M_STATE_UNSUBSTANTIATED  // self D m_state := M_STATE_UNSUBSTANTIATED
        → self
    }
D ETException = λ . P  // class
    // E (Exception): The unified state P ∘ D ∘ T = Something.     Everything that exists is an Exception to void.     EIM = E 
    D ETException____init = λ self, point, descriptor, traverser . {
        D self_D_point = point  // self D point := point
        D self_D_descriptor = descriptor  // self D descriptor := descriptor
        D self_D_traverser = traverser  // self D traverser := traverser
        D self_D_eim_state = EIM_EXCEPTION  // self D eim_state := EIM_EXCEPTION
    }
    D ETException__is_coherent = λ self . → self D descriptor D apply(self D point)
    D ETException__substantiate = λ self . → manifold [self D point, self D descriptor, self D traverser]
D bind_pdt = λ point, descriptor, traverser . {
    // P ∘ D ∘ T = E — The Master Equation binding operator.     Implements: 3 = 3 = 3 = Σ (tautological form).
    → ETException(point, descriptor, traverser)
}
D ETGroundException = λ . P  // class(Exception)
    // Python exception for the ET runtime's → E value path (Form A).     Raised by the interpreter when evaluating `→ E value`
    D ETGroundException____init = λ self, value . {
        D self_D_et_value = value  // self D et_value := value
        super(P) D __init__("ET:E-ground(" + value + ")")
    }
    D ETGroundException__exit_code = λ self . {
        // Extract integer exit code for sys.exit() semantics.
        T cond = → if isinstance(self D et_value, manifold [int, float]) → → int(self D et_value)
        → 0
    }
D ETMathV2 = λ . P  // class
    // Operationalized ET Equations — Core Mathematics.     All math DERIVED from Exception Theory primitives: P, D, T, E.     
    D ETMathV2__density = λ payload, container . {
        // Eq 211: S = D/D² (Structural Density).
        → if container → (float(payload) / float(container)) → E 0.0
    }
    D ETMathV2__effort = λ observers, byte_delta . {
        // Eq 212: |T|² = |D₁|² + |D₂|² — Traverser metabolic cost.
        → ETMathNative D et_sqrt(((observers ^ 2) + (byte_delta ^ 2)))
    }
    D ETMathV2__bind = λ p, d, t . {
        // P ∘ D ∘ T = E — Master Equation binding.
        → if t → manifold [p, d, t] → E manifold [p, d]
    }
    D ETMathV2__bind_operation = λ  . {
        // Bind multiple elements via ∘ composition (Eq 186).
        T cond = → if (len(args) == 1 && isinstance(args[0], manifold [list, tuple])) → P
            P items = args[0]
            T cond = → if (!items) → → P
            P result = items[0]
            T loop = ∞ (
                P item = items[1:Ω][_loop_index]
                P result = manifold [result, item]
            ) (D |items[1:Ω]|)
            → result
        T cond = → if len(args) == 2 → → manifold [args[0], args[1]]
        T cond = → if len(args) == 3 → → bind_pdt(if isinstance(args[0], Point) → args[0] → E Point(manifold ["location", "bound"], manifold ["state", args[0]]), if isinstance(args[1], Descriptor) → args[1] → E Descriptor(manifold ["name", "bound"], manifold ["constraint", args[1]]), if isinstance(args[2], Traverser) → args[2] → E Traverser(manifold ["identity", "bound"], manifold ["current_point", args[2]]))
        → args
    }
    D ETMathV2__something_compose = λ p_val, d_val, t_val . {
        // Σ = P ∘ D ∘ T — tautological composition: 3=3=3=Σ.         Returns the substantiated Something from the three primitives
        T cond = → if t_val == P → → manifold [p_val, d_val, M_STATE_UNSUBSTANTIATED]
        → manifold [p_val, d_val, t_val, EIM_EXCEPTION]
    }
    D ETMathV2__phase_transition = λ gradient_input, threshold . {
        // Eq 30: Sigmoid phase transition.
        T attempt = → P  // try
            P adjusted = (gradient_input - threshold)
            → (1.0 / (1.0 + ETMathNative D et_exp((-adjusted))))
        → E OverflowError (_)
            → if gradient_input > threshold → 1.0 → E 0.0
    }
    D ETMathV2__variance_gradient = λ current_variance, target_variance, step_size . {
        // Eq 83: Intelligence is Minimization of Variance.
        P delta = (target_variance - current_variance)
        P direction = if delta > 0 → 1.0 → E (-1.0)
        P magnitude = _et_abs(delta)
        → (current_variance + ((step_size * direction) * magnitude))
    }
    D ETMathV2__manifold_variance = λ n . {
        // Variance formula: σ² = (n²-1)/12. Derived from ET manifold structure.
        → (((n ^ 2) - 1) / 12.0)
    }
    D ETMathV2__koide_formula = λ m1, m2, m3 . {
        // Koide: (m1+m2+m3)/(√m1+√m2+√m3)² = 2/3.
        P sum_masses = ((m1 + m2) + m3)
        P sum_sqrt = ((ETMathNative D et_sqrt(_et_abs(m1)) + ETMathNative D et_sqrt(_et_abs(m2))) + ETMathNative D et_sqrt(_et_abs(m3)))
        → if sum_sqrt ≠ 0 → (sum_masses / (sum_sqrt ^ 2)) → E 0
    }
    D ETMathV2__cosmological_ratios = λ total_energy . {
        // Dark energy/matter/ordinary matter ratios (68.3/26.8/4.9).
        → manifold [manifold ["dark_energy", (total_energy * DARK_ENERGY_RATIO)], manifold ["dark_matter", (total_energy * DARK_MATTER_RATIO)], manifold ["ordinary_matter", (total_energy * ORDINARY_MATTER_RATIO)]]
    }
    D ETMathV2__finite_bound = λ value . {
        // Eq 204: Convert to D-bounded finite value.
        T attempt = → P  // try
            T cond = → if isinstance(value, str) → P
                T cond = → if ("." == value || "e" == value D lower(P)) → → float(value)
                → int(value)
            → float(value)
        → E manifold [ValueError, TypeError] (_)
            → 0
    }
    D ETMathV2__indeterminate_form = λ choices . {
        // Eq 217: [0/0] — T resolves indeterminacy via ET T-singularity entropy.         Uses multi-sample timing deltas (T-singul
        T cond = → if (!choices) → → P
        T cond = → if isinstance(choices, manifold [list, tuple]) → P
            P t1 = time D time_ns(P)
            P t2 = time D time_ns(P)
            P t3 = time D time_ns(P)
            P delta = ((_et_abs((t2 - t1)) ^ _et_abs((t3 - t2))) ^ _et_abs((t3 - t1)))
            T cond = → if delta == 0 → P
                P delta = _et_abs(hash(str({ T loop = ∞ (type(c) D __name__) (D |choices|) })))
                P delta = (((delta * MANIFOLD_SYMMETRY) + STATE_COUNT) % (MANIFOLD_SYMMETRY * STATE_COUNT))
            P idx = (delta % len(choices))
            → choices[idx]
        → choices
    }
    D ETMathV2__manifold_binding = λ elements . {
        // Eq 186: Bind manifold elements into composite structure.
