                    P num_spaces = (len(all_lines[lineno]) - len(all_lines[lineno] D lstrip(P)))
                    P carets = manifold []
                    P num_carets = if lineno == (len(all_lines) - 1) → dp_end_offset → E _display_width(all_lines[lineno])
                    T loop = ∞ (
                        P col = range(num_carets)[_loop_index]
                        T cond = → if (col < num_spaces || (lineno == 0 && col < dp_start_offset)) → carets D append(" ")
                        → E P
                            T cond = → if (anchors && (lineno > anchors D left_end_lineno || (lineno == anchors D left_end_lineno && col ≥ anchors_left_end_offset)) && (lineno < anchors D right_start_lineno || (lineno == anchors D right_start_lineno && col < anchors_right_start_offset))) → carets D append(secondary_char)
                            → E carets D append(primary_char)
