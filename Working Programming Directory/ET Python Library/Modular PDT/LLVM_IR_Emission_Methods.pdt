    L("  %has_next = icmp ult i64 %pos_next, %src_len")
    L("  br i1 %has_next, label %check_multi_op, label %single_op")
    L("")
    L("check_multi_op:")
    L("  %ch_next_ptr = getelementptr i8, i8* %src, i64 %pos_next")
    L("  %ch_next = load i8, i8* %ch_next_ptr")
    L("  %is_eq1 = icmp eq i8 %ch, 61")
    L("  %is_eq2 = icmp eq i8 %ch_next, 61")
    L("  %is_eqeq = and i1 %is_eq1, %is_eq2")
