P _abc_instancecheck = ABCMeta D __instancecheck__
P _abc_subclasscheck = ABCMeta D __subclasscheck__
D type_check_issubclass_arg_1 = λ arg . {
    // Raise TypeError if `arg` is not an instance of `type`     in `issubclass(arg, <protocol>)`.      In most cases, this is 
    T cond = → if (!isinstance(arg, type)) → → E TypeError("issubclass() arg 1 must be a class")
