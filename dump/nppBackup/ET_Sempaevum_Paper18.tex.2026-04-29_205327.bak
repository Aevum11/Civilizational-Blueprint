\caption{The six shadow families at base $N=12$: minimal native lattice resolution and physical identification.}\label{tab:shadow-forces}
\end{table}

\begin{proposition}[Universal native resolution]\label{prop:universal-native}
At the universal lattice resolution $N_{\mathrm{FULL}} = \mathrm{lcm}(1,2,\ldots,11) = 27720$, every simple sublattice family $d \in \{1,2,\ldots,12\}$ is native simultaneously, including all six shadow families.
\end{proposition}

\begin{proof}
$N_{\mathrm{FULL}} = \mathrm{lcm}(1,\ldots,11) = 2^{3}\cdot 3^{2}\cdot 5\cdot 7\cdot 11 = 27720$. Every $d\in\{1,\ldots,12\}$ divides $27720$ (note $12 = 2^{2}\cdot 3 \mid 2^{3}\cdot 3^{2}$ and each of $5,7,8,9,10,11$ divides $27720$ as a single prime factor or product thereof). By Proposition~\ref{prop:int-resolution}, native presence requires $d\mid N$, which holds for every $d\in\{1,\ldots,12\}$ at $N=27720$. \qed
\end{proof}

\begin{remark}[Identification Principle reading of the shadow forces]\label{rem:shadow-identification}
The identifications of Table~\ref{tab:shadow-forces} are applications of the Identification Principle (\S\ref{subsec:identification}) to the six shadow families: each identifies the structural sublattice $d$ with the physical sector whose internal symmetry has cardinality matching the family's totient or whose minimal Lie-algebraic structure is dimensionally compatible with $d$. The principal identifications --- $d=8 \leftrightarrow \mathrm{SU}(3)$ (gluon octet), $d=10 \leftrightarrow$ superstring, $d=11 \leftrightarrow$ M-theory --- are promoted from dimensional observations to ET-native structural derivations in Section~\ref{sec:gauge}: the adjoint formula $d^{2}-1$ (Theorem~\ref{thm:adjoint}) derives the $d=3 \to d=8$ relationship from the Subsumption Law; the critical dimensions $D=10$ and $D=11$ are derived via multiple independent routes (Theorems~\ref{thm:critical-dims}, \ref{thm:D10-div-alg}, \ref{thm:D11}); and the uniqueness of the Standard Model gauge group $\mathrm{SU}(3)\times\mathrm{SU}(2)\times\mathrm{U}(1)$ is established by exhaustive enumeration (Theorem~\ref{thm:n-exhaustion}). The remaining shadow identifications ($d=5$ with icosahedral/golden structure, $d=7$ with $G_{2}$, $d=9$ with the quark colour--generation grid) stand as dimensional observations awaiting further derivation.
\end{remark}

\begin{remark}[Shadow status at base $N=12$]\label{rem:shadow-base}
At base $N=12$ the shadow families do not vanish from the lattice --- they appear as $|\varepsilon|>0$ residuals in the cascade dynamics rather than as native sublattice cells. The cascade-residual mechanism of \S\ref{subsec:general-cascade-rule} guarantees that any orbit whose true sublattice is a shadow family is projected at base onto its nearest divisor cell of $12$, with the descriptor-gap residual carrying the shadow character. At higher LCM-tower resolution the shadow becomes native and the residual collapses to zero. This is the structural reason why phenomena such as the SU(3) gluon octet are visible in physics but not natively expressible in the base $N=12$ lattice: their structural home is the canonical higher resolution $\mathrm{lcm}(12,d)$, and they appear as shadows at $N=12$.
\end{remark}

% ===========================================================
\section{Physical sublattice structure: gauge theory, critical dimensions, and the Standard Model}\label{sec:gauge}
% ===========================================================

The shadow-force identifications of Table~\ref{tab:shadow-forces} associate sublattice families with physical sectors by dimensional coincidence. This section derives those associations from the ET primitives, promoting them from observations to structural theorems. The derivations use only the ET constants $N$, $K$, $|\Pi|$, and $S$, the Three Tools of \S\ref{subsec:three-tools}, and standard mathematical facts (the Hurwitz theorem, combinatorial identities). No external physics axioms are introduced.

\subsection{The adjoint formula from the Subsumption Law}\label{subsec:adjoint}

The adjoint representation of a $d$-fold symmetry group counts the independent gauge bosons that compensate local symmetry transformations. Its dimension is a direct consequence of the Subsumption Law (Principle~\ref{princ:subsumption}).

\begin{theorem}[Adjoint dimension from the Subsumption Law]\label{thm:adjoint}
For a sublattice family of order $d \ge 1$, the number of independent transformation generators --- the adjoint dimension --- is
\[
\boxed{\;\dim(\mathrm{adjoint\ of\ }d\text{-fold symmetry}) \;=\; d^{2} - 1.\;}
\]
\end{theorem}

\begin{proof}
Apply the Identification Principle (\S\ref{subsec:identification}) to the transformation structure of a $d$-fold sublattice:
\begin{itemize}[leftmargin=*]
\item $P$: the $d$-element configuration space (the $d$ lattice positions within one sublattice period).
\item $D$: the transformation descriptors. A general linear transformation on $d$ elements requires $d \times d = d^{2}$ parameters --- one for each source-to-target mapping.
\item $T$: the identity-removal constraint. The transformation proportional to the identity matrix maps every element to itself. This transformation IS the $d=1$ octave sublattice transformation --- the identity/gravity sector already fully accounted for at the $d=1$ family (Table~\ref{tab:families}).
\end{itemize}
By the Subsumption Law (Principle~\ref{princ:subsumption}, condition~(iii)), including the $d=1$ component again would create remainder: a double-counted identity transformation that belongs to $d=1$, not to $d$. The traceless condition ($\mathrm{tr}\,A = 0$) removes exactly one degree of freedom from the $d^{2}$ total. This removal is not a convention but the Subsumption Law's demand for completeness without remainder: $d^{2} - 1$ generators, each producing a genuine $d$-fold transformation that is not already subsumed by a lower-$d$ family. \qed
\end{proof}

\begin{corollary}[Shadow family $d=8$ is the adjoint of $d=3$]\label{cor:d8-su3}
The shadow family $d=8$ of Table~\ref{tab:shadow-forces} is structurally derived from the native family $d=3$:
\[
d_{\mathrm{adj}}(3) \;=\; 3^{2} - 1 \;=\; 8.
\]
The eight gluons of the SU$(3)$ strong-force octet are not merely dimensionally compatible with $d=8$; they are \emph{forced} by the Subsumption Law applied to the three-fold ($d=3$) sublattice's transformation space.
\end{corollary}

The adjoint formula at each native sublattice family gives the entries of Table~\ref{tab:adjoint-values}.

\begin{table}[h]
