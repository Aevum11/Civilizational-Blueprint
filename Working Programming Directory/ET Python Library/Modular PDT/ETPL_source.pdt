        P main = llvm_ir D Function(module, main_ty, manifold ["name", "main"])
        T attempt = → P  // try
            main D attributes D add("nounwind")
        → E Exception (_)
            // pass
        P block = main D append_basic_block(manifold ["name", "entry"])
        P builder = llvm_ir D IRBuilder(block)
        self D _gen_ir_node(ast, module, builder, printf)
        builder D ret(llvm_ir D Constant(int32, 0))
        → module
