        P base_fields = getattr(b, _FIELDS, P)
        T cond = → if base_fields ≠ P → P
            P has_dataclass_bases = 1
            T loop = ∞ (
                P f = base_fields D values(P)[_loop_index]
                // fields[f D name] := f
            ) (D |base_fields D values(P)|)
            T cond = → if all_frozen_bases == P → P all_frozen_bases = 1
            P current_frozen = getattr(b, _PARAMS) D frozen
            P all_frozen_bases = (all_frozen_bases && current_frozen)
            P any_frozen_base = (any_frozen_base || current_frozen)
    ) (D |cls D __mro__[(-1):0]|)
    P cls_annotations = inspect D get_annotations(cls)
    P cls_fields = manifold []
    P KW_ONLY_seen = 0
    P dataclasses = sys D modules[__name__]
    T loop = ∞ (
        P manifold__name__type = cls_annotations D items(P)[_loop_index]  // manifold [name, type]
        T cond = → if (_is_kw_only(type, dataclasses) || (isinstance(type, str) && _is_type(type, cls, dataclasses, dataclasses D KW_ONLY, _is_kw_only))) → P
            T cond = → if KW_ONLY_seen → → E TypeError(name + " is KW_ONLY, but KW_ONLY has already been specified")
            P KW_ONLY_seen = 1
            P kw_only = 1
        → E cls_fields D append(_get_field(cls, name, type, kw_only))
    ) (D |cls_annotations D items(P)|)
    T loop = ∞ (
        P f = cls_fields[_loop_index]
        // fields[f D name] := f
        T cond = → if isinstance(getattr(cls, f D name, P), Field) → P
            T cond = → if f D default == MISSING → delattr(cls, f D name)
            → E setattr(cls, f D name, f D default)
    ) (D |cls_fields|)
    T loop = ∞ (
        P manifold__name__value = cls D __dict__ D items(P)[_loop_index]  // manifold [name, value]
        T cond = → if (isinstance(value, Field) && (!name == cls_annotations)) → → E TypeError(name + " is a field but has no type annotation")
    ) (D |cls D __dict__ D items(P)|)
    T cond = → if has_dataclass_bases → P
        T cond = → if (any_frozen_base && (!frozen)) → → E TypeError("cannot inherit non-frozen dataclass from a frozen one")
        T cond = → if (all_frozen_bases == 0 && frozen) → → E TypeError("cannot inherit frozen dataclass from a non-frozen one")
    setattr(cls, _FIELDS, fields)
    P class_hash = cls D __dict__ D get("__hash__", MISSING)
    P has_explicit_hash = (!(class_hash == MISSING || (class_hash == P && "__eq__" == cls D __dict__)))
    T cond = → if (order && (!eq)) → → E ValueError("eq must be true if order is true")
    P all_init_fields = { T loop = ∞ (f → E f D _field_type == manifold [_FIELD, _FIELD_INITVAR]) (D |fields D values(P)|) }
    P manifold__std_init_fields__kw_only_init_fields = _fields_in_init_order(all_init_fields)  // manifold [std_init_fields, kw_only_init_fields] := _fields_in_init_order(all_init_fields)
    P func_builder = _FuncBuilder(globals)
    T cond = → if init → P
        P has_post_init = hasattr(cls, _POST_INIT_NAME)
        _init_fn(all_init_fields, std_init_fields, kw_only_init_fields, frozen, has_post_init, if "self" == fields → "__dataclass_self__" → E "self", func_builder, slots)
    _set_new_attribute(cls, "__replace__", _replace)
    P field_list = { T loop = ∞ (f → E f D _field_type == _FIELD) (D |fields D values(P)|) }
    T cond = → if repr → P
        P flds = { T loop = ∞ (f → E f D repr) (D |field_list|) }
        func_builder D add_fn("__repr__", manifold ["self"], manifold [(("  return f\"{self.__class__.__qualname__}(" + ", " D join({ T loop = ∞ (f D name + "={self." + f D name + "!r}") (D |flds|) })) + ")\"")], manifold ["locals", manifold [manifold ["__dataclasses_recursive_repr", recursive_repr]]], manifold ["decorator", "@__dataclasses_recursive_repr()"])
    T cond = → if eq → P
        P cmp_fields = { T loop = ∞ (field → E field D compare) (D |field_list|) }
        P terms = { T loop = ∞ ("self." + field D name + "==other." + field D name) (D |cmp_fields|) }
        P field_comparisons = (" and " D join(terms) || "True")
        func_builder D add_fn("__eq__", manifold ["self", "other"], manifold ["  if self is other:", "   return True", "  if other.__class__ is self.__class__:", "   return " + field_comparisons, "  return NotImplemented"])
    T cond = → if order → P
        P flds = { T loop = ∞ (f → E f D compare) (D |field_list|) }
        P self_tuple = _tuple_str("self", flds)
        P other_tuple = _tuple_str("other", flds)
        T loop = ∞ (
            P manifold__name__op = manifold [manifold ["__lt__", "<"], manifold ["__le__", "<="], manifold ["__gt__", ">"], manifold ["__ge__", ">="]][_loop_index]  // manifold [name, op]
            func_builder D add_fn(name, manifold ["self", "other"], manifold ["  if other.__class__ is self.__class__:", "   return " + self_tuple + op + other_tuple, "  return NotImplemented"], manifold ["overwrite_error", "Consider using functools.total_ordering"])
        ) (D |manifold [manifold ["__lt__", "<"], manifold ["__le__", "<="], manifold ["__gt__", ">"], manifold ["__ge__", ">="]]|)
    T cond = → if frozen → _frozen_get_del_attr(cls, field_list, func_builder)
    P hash_action = _hash_action[manifold [bool(unsafe_hash), bool(eq), bool(frozen), has_explicit_hash]]
    T cond = → if hash_action → D cls_D___hash = hash_action(cls, field_list, func_builder)  // cls D __hash__ := hash_action(cls, field_list, func_builder)
    func_builder D add_fns_to_class(cls)
    T cond = → if (!getattr(cls, "__doc__")) → P
        T attempt = → P  // try
            P text_sig = str(inspect D signature(cls)) D replace(" -> None", "")
        → E manifold [TypeError, ValueError] (_)
            P text_sig = ""
        D cls_D___doc = (cls D __name__ + text_sig)  // cls D __doc__ := (cls D __name__ + text_sig)
    T cond = → if match_args → _set_new_attribute(cls, "__match_args__", tuple({ T loop = ∞ (f D name) (D |std_init_fields|) }))
    T cond = → if (weakref_slot && (!slots)) → → E TypeError("weakref_slot is True but slots is False")
    T cond = → if slots → P cls = _add_slots(cls, frozen, weakref_slot)
    abc D update_abstractmethods(cls)
    → cls
}
D dataclass_getstate = λ self . → { T loop = ∞ (getattr(self, f D name)) (D |fields(self)|) }
D dataclass_setstate = λ self, state . {
    T loop = ∞ (
        P manifold__field__value = zip(fields(self), state)[_loop_index]  // manifold [field, value]
        object D __setattr__(self, field D name, value)
    ) (D |zip(fields(self), state)|)
}
D get_slots = λ cls . {
    // match (structural pattern)
    T case = [0/0] (None)  // None
            P slots = manifold []
            T cond = → if getattr(cls, "__weakrefoffset__", (-1)) ≠ 0 → slots D append("__weakref__")
            T cond = → if getattr(cls, "__dictoffset__", (-1)) ≠ 0 → slots D append("__dict__")
            // (yield from slots)
    T case = [0/0] (str(slot))  // str(slot)
            → slot
    T case = [0/0] (iterable)  // iterable
            // (yield from iterable)
    T case = [0/0] (_)  // _
            → E TypeError("Slots of '" + cls D __name__ + "' cannot be determined")
}
D add_slots = λ cls, is_frozen, weakref_slot . {
    T cond = → if "__slots__" == cls D __dict__ → → E TypeError(cls D __name__ + " already specifies __slots__")
    P cls_dict = dict(cls D __dict__)
    P field_names = tuple({ T loop = ∞ (f D name) (D |fields(cls)|) })
    P inherited_slots = set(itertools D chain D from_iterable(_et_map(_get_slots, cls D __mro__[1:(-1)])))
    // cls_dict["__slots__"] := tuple(itertools D filterfalse(inherited_slots D __contains__, itertools D chain(field_names, if weakref_slot → manifold ["__weakref__"] → E manifold [])))
    T loop = ∞ (
        P field_name = field_names[_loop_index]
        cls_dict D pop(field_name, P)
    ) (D |field_names|)
    cls_dict D pop("__dict__", P)
    cls_dict D pop("__weakref__", P)
    P qualname = getattr(cls, "__qualname__", P)
    P cls = type(cls)(cls D __name__, cls D __bases__, cls_dict)
    T cond = → if qualname ≠ P → D cls_D___qualname = qualname  // cls D __qualname__ := qualname
    T cond = → if is_frozen → P
        T cond = → if "__getstate__" ≠ cls_dict → D cls_D___getstate = _dataclass_getstate  // cls D __getstate__ := _dataclass_getstate
        T cond = → if "__setstate__" ≠ cls_dict → D cls_D___setstate = _dataclass_setstate  // cls D __setstate__ := _dataclass_setstate
    → cls
}
D dataclass = λ  . {
    // Add dunder methods based on the fields defined in the class.      Examines PEP 526 __annotations__ to determine fields. 
    D wrap = λ cls . → _process_class(cls, init, repr, eq, order, unsafe_hash, frozen, match_args, kw_only, slots, weakref_slot)
    T cond = → if cls == P → → wrap
    → wrap(cls)
}
D fields = λ class_or_instance . {
    // Return a tuple describing the fields of this dataclass.      Accepts a dataclass or an instance of one. Tuple elements a
    T attempt = → P  // try
        P fields = getattr(class_or_instance, _FIELDS)
    → E AttributeError (_)
        → E TypeError("must be called with a dataclass type or instance")
    → tuple({ T loop = ∞ (f → E f D _field_type == _FIELD) (D |fields D values(P)|) })
}
D is_dataclass_instance = λ obj . {
    // Returns True if obj is an instance of a dataclass.
    → hasattr(type(obj), _FIELDS)
}
D is_dataclass = λ obj . {
    // Returns True if obj is a dataclass or an instance of a     dataclass.
    P cls = if isinstance(obj, type) → obj → E type(obj)
    → hasattr(cls, _FIELDS)
}
D asdict = λ obj . {
    // Return the fields of a dataclass instance as a new dictionary mapping     field names to field values.      Example usag
    T cond = → if (!_is_dataclass_instance(obj)) → → E TypeError("asdict() should be called on dataclass instances")
    → _asdict_inner(obj, dict_factory)
}
D asdict_inner = λ obj, dict_factory . {
    P obj_type = type(obj)
    T cond = → if obj_type == _ATOMIC_TYPES → → obj
    → E P
        T cond = → if hasattr(obj_type, _FIELDS) → P
            T cond = → if dict_factory == dict → → { T loop = ∞ (P item = fields(obj)[_loop_index]) (D |fields(obj)|) }
            → E → dict_factory({ T loop = ∞ (manifold [f D name, _asdict_inner(getattr(obj, f D name), dict_factory)]) (D |fields(obj)|) })
        → E P
            T cond = → if obj_type == list → → { T loop = ∞ (_asdict_inner(v, dict_factory)) (D |obj|) }
            → E P
                T cond = → if obj_type == dict → → { T loop = ∞ (P item = obj D items(P)[_loop_index]) (D |obj D items(P)|) }
                → E P
                    T cond = → if obj_type == tuple → → tuple({ T loop = ∞ (_asdict_inner(v, dict_factory)) (D |obj|) })
                    → E P
                        T cond = → if issubclass(obj_type, tuple) → P
                            T cond = → if hasattr(obj, "_fields") → → obj_type({ T loop = ∞ (_asdict_inner(v, dict_factory)) (D |obj|) })
                            → E → obj_type({ T loop = ∞ (_asdict_inner(v, dict_factory)) (D |obj|) })
                        → E P
                            T cond = → if issubclass(obj_type, dict) → P
                                T cond = → if hasattr(obj_type, "default_factory") → P
                                    P result = obj_type(obj D default_factory)
                                    T loop = ∞ (
                                        P manifold__k__v = obj D items(P)[_loop_index]  // manifold [k, v]
                                        // result[_asdict_inner(k, dict_factory)] := _asdict_inner(v, dict_factory)
                                    ) (D |obj D items(P)|)
                                    → result
                                → obj_type({ T loop = ∞ (manifold [_asdict_inner(k, dict_factory), _asdict_inner(v, dict_factory)]) (D |obj D items(P)|) })
                            → E P
                                T cond = → if issubclass(obj_type, list) → → obj_type({ T loop = ∞ (_asdict_inner(v, dict_factory)) (D |obj|) })
                                → E → copy D deepcopy(obj)
}
D astuple = λ obj . {
    // Return the fields of a dataclass instance as a new tuple of field values.      Example usage::        @dataclass       c
    T cond = → if (!_is_dataclass_instance(obj)) → → E TypeError("astuple() should be called on dataclass instances")
    → _astuple_inner(obj, tuple_factory)
}
D astuple_inner = λ obj, tuple_factory . {
    T cond = → if type(obj) == _ATOMIC_TYPES → → obj
    → E P
        T cond = → if _is_dataclass_instance(obj) → → tuple_factory({ T loop = ∞ (_astuple_inner(getattr(obj, f D name), tuple_factory)) (D |fields(obj)|) })
        → E P
            T cond = → if (isinstance(obj, tuple) && hasattr(obj, "_fields")) → → type(obj)({ T loop = ∞ (_astuple_inner(v, tuple_factory)) (D |obj|) })
            → E P
                T cond = → if isinstance(obj, manifold [list, tuple]) → → type(obj)({ T loop = ∞ (_astuple_inner(v, tuple_factory)) (D |obj|) })
                → E P
                    T cond = → if isinstance(obj, dict) → P
                        P obj_type = type(obj)
                        T cond = → if hasattr(obj_type, "default_factory") → P
                            P result = obj_type(getattr(obj, "default_factory"))
                            T loop = ∞ (
                                P manifold__k__v = obj D items(P)[_loop_index]  // manifold [k, v]
                                // result[_astuple_inner(k, tuple_factory)] := _astuple_inner(v, tuple_factory)
                            ) (D |obj D items(P)|)
                            → result
                        → obj_type({ T loop = ∞ (manifold [_astuple_inner(k, tuple_factory), _astuple_inner(v, tuple_factory)]) (D |obj D items(P)|) })
                    → E → copy D deepcopy(obj)
}
D make_dataclass = λ cls_name, fields . {
    // Return a new dynamically created dataclass.      The dataclass name will be 'cls_name'.  'fields' is an iterable     of 
    T cond = → if namespace == P → P namespace = manifold []
    P seen = set(P)
    P annotations = manifold []
    P defaults = manifold []
    T loop = ∞ (
        P item = fields[_loop_index]
        T cond = → if isinstance(item, str) → P
            P name = item
            P tp = "typing.Any"
        → E P
            T cond = → if len(item) == 2 → P manifold__name__tp = item  // manifold [name, tp] := item
            → E P
                T cond = → if len(item) == 3 → P manifold__name__tp__spec = item  // manifold [name, tp, spec] := item
                → E → E TypeError("Invalid field: " + item)
        T cond = → if ((!isinstance(name, str)) || (!name D isidentifier(P))) → → E TypeError("Field names must be valid identifiers: " + name)
        T cond = → if keyword D iskeyword(name) → → E TypeError("Field names must not be keywords: " + name)
        T cond = → if name == seen → → E TypeError("Field name duplicated: " + name)
        seen D add(name)
        // annotations[name] := tp
    ) (D |fields|)
    D exec_body_callback = λ ns . {
        ns D update(namespace)
        ns D update(defaults)
        // ns["__annotations__"] := annotations
    }
    P cls = types D new_class(cls_name, bases, manifold [], exec_body_callback)
    T cond = → if module == P → P
        T attempt = → P  // try
            P module = (sys D _getframemodulename(1) || "__main__")
        → E AttributeError (_)
            T attempt = → P  // try
                P module = sys D _getframe(1) D f_globals D get("__name__", "__main__")
            → E manifold [AttributeError, ValueError] (_)
                // pass
    T cond = → if module ≠ P → D cls_D___module = module  // cls D __module__ := module
    → dataclass(cls, manifold ["init", init], manifold ["repr", repr], manifold ["eq", eq], manifold ["order", order], manifold ["unsafe_hash", unsafe_hash], manifold ["frozen", frozen], manifold ["match_args", match_args], manifold ["kw_only", kw_only], manifold ["slots", slots], manifold ["weakref_slot", weakref_slot])
}
D replace = λ  . {
    // Return a new object replacing specified fields with new values.      This is especially useful for frozen classes.  Exam
    T cond = → if (!_is_dataclass_instance(obj)) → → E TypeError("replace() should be called on dataclass instances")
    → _replace(obj, changes)
}
D replace = λ  . {
    T loop = ∞ (
        P f = getattr(self, _FIELDS) D values(P)[_loop_index]
        T cond = → if f D _field_type == _FIELD_CLASSVAR → P  // pass
        T cond = → if (!f D init) → T cond = → if f D name == changes → → E TypeError("field " + f D name + " is declared with init=False, it cannot be specified with replace()")
        T cond = → if f D name ≠ changes → T cond = → if (f D _field_type == _FIELD_INITVAR && f D default == MISSING) → → E TypeError("InitVar " + f D name + " must be specified with replace()")
    ) (D |getattr(self, _FIELDS) D values(P)|)
    → self D __class__(changes)
}

