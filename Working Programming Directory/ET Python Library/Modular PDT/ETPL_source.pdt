        // self D env["StopIteration"] := StopIteration
        // self D env["NotImplementedError"] := NotImplementedError
    }
    D ETPLInterpreter___process_preload_directives = λ self, code . {
        // Process // @ETPL:preload directives in .pdt source.          ET Identity Principle: @ETPL:preload directives in the .pdt
        // @ETPL:preload importlib importlib
        // Import importlib — resolved at translate-time
        T loop = ∞ (
            P line = code D splitlines(P)[_loop_index]
            P line = line D strip(P)
            T cond = → if (!line D startswith("// @ETPL:preload")) → P  // pass
            P parts = line D split(P)
            T cond = → if len(parts) < 4 → P  // pass
            P local_name = parts[2]
            P qname = parts[3]
            T cond = → if local_name == self D env → P  // pass
            P parts_q = qname D split(".")
            P obj = P
            T loop = ∞ (
                P i = range(len(parts_q), 0, (-1))[_loop_index]
                P mod_part = "_" D join(parts_q[0:i])
                T cond = → if mod_part == self D env → P
                    P obj = self D env[mod_part]
                    T loop = ∞ (
                        P attr = parts_q[i:Ω][_loop_index]
                        T attempt = → P  // try
                            P obj = getattr(obj, attr)
                        → E AttributeError (_)
                            P obj = P
                            // break
                    ) (D |parts_q[i:Ω]|)
                    T cond = → if obj ≠ P → P  // pass
            ) (D |range(len(parts_q), 0, (-1))|)
            T cond = → if (obj == P && len(parts_q) > 1) → P
                T attempt = → P  // try
                    P mod = importlib D import_module(parts_q[0])
                    P obj = mod
                    T loop = ∞ (
                        P attr = parts_q[1:Ω][_loop_index]
                        P obj = getattr(obj, attr)
                    ) (D |parts_q[1:Ω]|)
                → E Exception (_)
                    P obj = P
            T cond = → if obj ≠ P → P  // pass
        ) (D |code D splitlines(P)|)
    }
    D ETPLInterpreter___et_map = λ self, func, collection . {
        // ET map: apply D to each element of manifold.
        T cond = → if (callable(func) && hasattr(collection, "__iter__")) → → { T loop = ∞ (func(x)) (D |collection|) }
        → collection
    }
    D ETPLInterpreter___et_filter = λ self, func, collection . {
        // ET filter: keep elements satisfying D constraint.
        T cond = → if (callable(func) && hasattr(collection, "__iter__")) → → { T loop = ∞ (x → E func(x)) (D |collection|) }
        → collection
    }
    D ETPLInterpreter__interpret = λ self, code . {
        // Parse and interpret ETPL code.
        self D _process_preload_directives(code)
        P parser = ETPLParser(P)
        P ast = parser D parse(code)
        → self D eval(ast)
    }
    D ETPLInterpreter__interpret_file = λ self, filepath . {
        // Parse and interpret .pdt file.          Auto-loads ET native libraries (ET_Math_Native.pdt, ET_Platform_Native.pdt)     
        P _fdir = os D path D dirname(os D path D abspath(filepath))
        P _lib_dirs = manifold [_fdir, if hasattr(sys D modules[__name__], "__file__") → os D path D dirname(os D path D abspath(__file__)) → E _fdir, os D environ D get("ETPL_PROJECT_DIR", ""), "/mnt/project", "/home/claude"]
        D ETPLInterpreter___try_load_lib = λ libname . {
            T loop = ∞ (
                P d = _lib_dirs[_loop_index]
                T cond = → if (!d) → P  // pass
                P candidate = os D path D join(d, libname)
                T cond = → if os D path D isfile(candidate) → P
                    T attempt = → P  // try
                        T scope__lf = → open(candidate, "r", manifold ["encoding", "utf-8"])
                        P _lf = scope__lf  // context var
                            → _lf D read(P)
                    → E Exception (_)
                        // pass
            ) (D |_lib_dirs|)
            → P
        }
        P math_native = _try_load_lib("ET_Math_Native.pdt")
        T cond = → if math_native → P
            self D _process_preload_directives(math_native)
            P _math_parser = ETPLParser(P)
            P _math_ast = _math_parser D parse(math_native)
            self D eval(_math_ast)
        P platform_native = _try_load_lib("ET_Platform_Native.pdt")
        T cond = → if platform_native → P
            self D _process_preload_directives(platform_native)
            P _plat_parser = ETPLParser(P)
            P _plat_ast = _plat_parser D parse(platform_native)
            self D eval(_plat_ast)
        T scope__f = → open(filepath, "r", manifold ["encoding", "utf-8"])
        P _f = scope__f  // context var
            P _code = _f D read(P)
        self D _process_preload_directives(_code)
        P parser = ETPLParser(P)
        P ast = parser D parse(_code)
        → self D eval(ast)
    }
    D ETPLInterpreter__eval = λ self, node . {
        // Evaluate an AST node — core T-traversal.
        T cond = → if node == P → → P
        P nt = node D node_type
        T cond = → if nt == ASTNodeType D PROGRAM → P
            P result = P
            T loop = ∞ (
                P child = node D children[_loop_index]
                P result = self D eval(child)
            ) (D |node D children|)
            → result
        T cond = → if nt == ASTNodeType D POINT_DECL → P
            P value = self D eval(node D body)
            // self D env[node D name] := value
            T cond = → if self D debug → sovereign_print ∘ "  P " + node D name + " = " + value
            → value
        T cond = → if nt == ASTNodeType D DESCRIPTOR_DECL → P
            T cond = → if node D params ≠ P → P
                P params = node D params
                P body = node D body
                P env_snapshot = dict(self D env)
                P interp_ref = self
                D ETPLInterpreter__make_closure = λ param_list, captured_env, bound_args . {
                    // Create closure with currying: if called with fewer args than params,                     return a new closure binding th
                    T cond = → if bound_args == P → P bound_args = manifold []
                    D ETPLInterpreter__closure = λ  . {
                        P all_args = (list(bound_args) + list(args))
                        T cond = → if len(all_args) < len(param_list) → → make_closure(param_list, captured_env, all_args)
                        P local_env = dict(captured_env)
                        T loop = ∞ (
                            P manifold__i__p = enumerate(param_list)[_loop_index]  // manifold [i, p]
                            // local_env[p] := if i < len(all_args) → all_args[i] → E P
                        ) (D |enumerate(param_list)|)
                        // local_env[node D name] := interp_ref D env D get(node D name, closure)
                        P old_env = interp_ref D env
                        D interp_ref_D_env = local_env  // interp_ref D env := local_env
                        T attempt = → P  // try
                            P result = interp_ref D eval(body)
                        // finally:
                            D interp_ref_D_env = old_env  // interp_ref D env := old_env
                        → result
                    }
                    → closure
                }
                P closure = make_closure(params, env_snapshot)
                // self D env[node D name] := closure
                T cond = → if self D debug → sovereign_print ∘ "  D " + node D name + " = λ(" + ", " D join(params) + ")"
                → closure
            → E P
                P value = self D eval(node D body)
                // self D env[node D name] := value
                T cond = → if self D debug → sovereign_print ∘ "  D " + node D name + " = " + value
                → value
        T cond = → if nt == ASTNodeType D TRAVERSER_DECL → P
            P result = self D eval(node D body)
            // self D env[node D name] := result
            T cond = → if self D debug → sovereign_print ∘ "  T " + node D name + " = " + result
            → result
        T cond = → if nt == ASTNodeType D PATH → → self D eval(node D body)
        T cond = → if nt == ASTNodeType D EXCEPTION_PATH → P
            P body = node D body
            P is_form_a = (body ≠ P && body D node_type == ASTNodeType D IDENTIFIER && getattr(body, "value", P) == "E")
            T cond = → if is_form_a → P
                P val = if node D handler → self D eval(node D handler) → E P
                → E ETGroundException(val)
            T attempt = → P  // try
                → self D eval(node D body)
            → E ETGroundException (_)
                → E P
            → E Exception (e)
                T cond = → if node D handler → → self D eval(node D handler)
                → self D sovereign D handle_exception(e)
        T cond = → if nt == ASTNodeType D IF_EXPR → P
            P cond = self D eval(node D condition)
            T cond = → if (cond && cond ≠ 0) → → self D eval(node D then_branch)
            → E T cond = → if node D else_branch → → self D eval(node D else_branch)
            → P
        T cond = → if nt == ASTNodeType D LOOP → P
            P bound_val = self D eval(node D bound)
            P bound_int = if isinstance(bound_val, manifold [int, float]) → int(bound_val) → E 10
            P result = P
            T loop = ∞ (
                P i = range(bound_int)[_loop_index]
                // self D env["_loop_index"] := i
                P result = self D eval(node D body)
            ) (D |range(bound_int)|)
            → result
        T cond = → if nt == ASTNodeType D INDETERMINATE → P
            P evaluated = manifold []
            T loop = ∞ (
                P child = node D children[_loop_index]
                T attempt = → P  // try
                    evaluated D append(self D eval(child))
                → E Exception (e)
                    evaluated D append(self D sovereign D handle_exception(e))
            ) (D |node D children|)
            → ETMathV2 D indeterminate_form(evaluated)
        T cond = → if nt == ASTNodeType D SOVEREIGN_CALL → P
            P arg = self D eval(node D body)
            T cond = → if node D name == "sovereign_print" → P
                sovereign_print ∘ arg
                → arg
            → E P
                T cond = → if node D name == "sovereign_import" → P
                    P modname = if isinstance(arg, str) → arg → E str(arg)
                    T attempt = → P  // try
                        → __import__(modname)
                    → E ImportError (_)
                        → P
                → E P
                    T cond = → if node D name == "sovereign_sleep" → P
                        time D sleep(float(arg))
                        → P
            → P
        T cond = → if nt == ASTNodeType D LOGICAL_OP → P
            T cond = → if node D op == "!" → P
                P operand = self D eval(node D body)
                → ETMathV2 D logical_not(operand)
            → E P
                T cond = → if node D op == "&&" → P
                    P left = self D eval(node D left)
                    T cond = → if ((!left) || left == 0) → → 0
                    P right = self D eval(node D right)
                    → ETMathV2 D logical_and(left, right)
                → E P
                    T cond = → if node D op == "||" → P
                        P left = self D eval(node D left)
                        T cond = → if (left && left ≠ 0) → → 1
                        P right = self D eval(node D right)
                        → ETMathV2 D logical_or(left, right)
            → 0
        T cond = → if nt == ASTNodeType D CALL → P
            P func = self D eval(node D left)
            P arg = self D eval(node D right)
            T cond = → if callable(func) → P
                T attempt = → P  // try
                    → func(arg)
                → E TypeError (te)
                    T cond = → if isinstance(arg, manifold [list, tuple]) → P
                        T attempt = → P  // try
                            → func(arg)
                        → E TypeError (_)
                            // pass
                    T attempt = → P  // try
                        → func(P)
                    → E TypeError (_)
                        // pass
                    → E te
            T cond = → if (isinstance(func, type) && isinstance(arg, str)) → P
                P method = getattr(func, arg, P)
                T cond = → if method → → method
            T cond = → if (hasattr(func, "__dict__") && isinstance(arg, str)) → P
                P attr = getattr(func, arg, P)
                T cond = → if attr ≠ P → → attr
            → manifold [func, arg]
        T cond = → if nt == ASTNodeType D MATH_OP → P
            P left = self D eval(node D left)
            P right = self D eval(node D right)
            → self D _eval_math_op(node D op, left, right)
        T cond = → if nt == ASTNodeType D UNARY_OP → P
            P operand = self D eval(node D body)
            → self D _eval_unary_op(node D op, operand)
        T cond = → if nt == ASTNodeType D COMPARISON → P
            P left = self D eval(node D left)
            P right = self D eval(node D right)
            → self D _eval_comparison(node D op, left, right)
        T cond = → if nt == ASTNodeType D BINARY_OP → P
            P left = self D eval(node D left)
            P right = self D eval(node D right)
            P op = node D op
            T cond = → if op == "|" → → (int(left) | int(right))
            T cond = → if op == "&" → → (int(left) & int(right))
            T cond = → if op == "^" → → (int(left) ^ int(right))
            T cond = → if op == "<<" → → (int(left) << int(right))
            T cond = → if op == ">>" → → (int(left) >> int(right))
            T cond = → if op == "~" → → (-int(left) - 1)
            → E ValueError("ETPL: Unknown binary op '" + op + "'")
        T cond = → if nt == manifold [ASTNodeType D LITERAL_INT, ASTNodeType D LITERAL_FLOAT, ASTNodeType D LITERAL_STRING] → P
            P val = node D value
            T cond = → if (isinstance(val, tuple) && len(val) == 2 && val[0] == "__bytes__") → → val[1] D encode("latin-1", manifold ["errors", "replace"])
            → val
        T cond = → if nt == manifold [ASTNodeType D LITERAL_INFINITY, ASTNodeType D LITERAL_OMEGA] → → float("inf")
        T cond = → if nt == ASTNodeType D IDENTIFIER → P
            P name = (node D value || node D name)
            T cond = → if name == self D env → → self D env[name]
            → E NameError("ETPL: Undefined identifier '" + name + "' at line " + node D line)
        T cond = → if nt == ASTNodeType D MANIFOLD → → { T loop = ∞ (self D eval(child)) (D |node D children|) }
        T cond = → if nt == ASTNodeType D LAMBDA → P
            P params = (node D params || manifold [])
            P body = node D body
            P env_snapshot = dict(self D env)
            P interp_ref = self
            D ETPLInterpreter__make_lambda_closure = λ param_list, captured_env, bound_args . {
                T cond = → if bound_args == P → P bound_args = manifold []
                D ETPLInterpreter__lambda_closure = λ  . {
                    P all_args = (list(bound_args) + list(args))
                    T cond = → if len(all_args) < len(param_list) → → make_lambda_closure(param_list, captured_env, all_args)
                    P local_env = dict(captured_env)
                    T loop = ∞ (
                        P manifold__i__p = enumerate(param_list)[_loop_index]  // manifold [i, p]
                        // local_env[p] := if i < len(all_args) → all_args[i] → E P
                    ) (D |enumerate(param_list)|)
                    P old_env = interp_ref D env
                    D interp_ref_D_env = local_env  // interp_ref D env := local_env
                    T attempt = → P  // try
                        P result = interp_ref D eval(body)
                    // finally:
                        D interp_ref_D_env = old_env  // interp_ref D env := old_env
                    → result
                }
                → lambda_closure
            }
            → make_lambda_closure(params, env_snapshot)
        T cond = → if nt == ASTNodeType D QUANTUM_WAVE → P
            P params_eval = { T loop = ∞ (self D eval(c)) (D |node D children|) }
            T cond = → if len(params_eval) == 3 → → ETMathV2Quantum D hydrogen_wavefunction(params_eval)
            P body_val = self D eval(node D body)
            → body_val
        T cond = → if nt == ASTNodeType D INDEX → P
            P collection = self D eval(node D left)
            P idx = self D eval(node D right)
            T cond = → if (isinstance(node D right, ASTNode) && node D right D node_type == ASTNodeType D BINDING) → P
                P start = self D eval(node D right D left)
                P end = self D eval(node D right D right)
                → collection[int(start):int(end)]
            T cond = → if isinstance(collection, manifold [list, tuple, str]) → → collection[int(idx)]
            → P
        T cond = → if nt == ASTNodeType D MEMBER_ACCESS → P
            P obj = self D eval(node D left)
            P member = node D name
            T cond = → if isinstance(obj, dict) → → obj D get(member)
            T cond = → if hasattr(obj, member) → → getattr(obj, member)
            → P
        T cond = → if nt == ASTNodeType D HARDWARE_ACCESS → P
            T cond = → if node D body == P → P
                D ETPLInterpreter___hw_callable = λ addr . → self D _eval_hardware_access_str(if addr ≠ P → str(addr) → E "")
                → _hw_callable
            P addr = self D eval(node D body)
            P addr_str = if addr ≠ P → str(addr) → E ""
            → self D _eval_hardware_access_str(addr_str)
        T cond = → if nt == ASTNodeType D BINDING → P
            P left = self D eval(node D left)
            P right = self D eval(node D right)
            → manifold [left, right]
        → node D value
    }
    D ETPLInterpreter___eval_hardware_access_str = λ self, addr_str . {
        // Dispatch hardware_access ∘ addr_str to the appropriate platform operation.         ET: hardware_access is the universal 
        P addr_str = if addr_str ≠ P → str(addr_str) → E ""
        T cond = → if addr_str == "monotonic_clock" → P
            T attempt = → P  // try
                → time D monotonic(P)
            → E Exception (_)
                → float(time D time(P))
        → E P
            T cond = → if addr_str == "nanosecond_clock" → P
                T attempt = → P  // try
                    → time D time_ns(P)
                → E Exception (_)
                    → int((time D time(P) * 1000000000.0))
            → E P
                T cond = → if addr_str == "perf_counter" → P
                    T attempt = → P  // try
                        → time D perf_counter(P)
                    → E Exception (_)
                        → time D time(P)
                → E P
                    T cond = → if addr_str == "perf_counter_ns" → P
                        T attempt = → P  // try
                            → time D perf_counter_ns(P)
                        → E Exception (_)
                            → int((time D time(P) * 1000000000.0))
                    → E P
                        T cond = → if addr_str == "process_time" → P
                            T attempt = → P  // try
                                → time D process_time(P)
                            → E Exception (_)
                                → 0.0
                        → E P
                            T cond = → if addr_str == "tick" → P
                                T attempt = → P  // try
                                    time D sleep(0.001)
                                → E Exception (_)
                                    // pass
                                → 0
                            → E P
                                T cond = → if addr_str == "platform" → → sys D platform
                                → E P
                                    T cond = → if addr_str == "getpid" → → os D getpid(P)
                                    → E P
