                                T attempt = → P  // try
                                    P stringtable_string = self D get_string_u_at_rva(ustr_offset)
                                → E PEFormatError (_)
                                    self D __warnings D append("Error parsing the version information, attempting to read StringTable string. Can't read unicode string at offset 0x{0:x}" D format(ustr_offset))
                                    // break
                                D stringtable_struct_D_LangID = stringtable_string  // stringtable_struct D LangID := stringtable_string
                                D stringtable_struct_D_entries = manifold []  // stringtable_struct D entries := manifold []
                                D stringtable_struct_D_entries_offsets = manifold []  // stringtable_struct D entries_offsets := manifold []
                                D stringtable_struct_D_entries_lengths = manifold []  // stringtable_struct D entries_lengths := manifold []
                                stringfileinfo_struct D StringTable D append(stringtable_struct)
                                P entry_offset = self D dword_align(((stringtable_offset + stringtable_struct D sizeof(P)) + (2 * (len(stringtable_string) + 1))), version_struct D OffsetToData)
                                T while_loop = ∞ (
                                    T check = → if entry_offset < (stringtable_offset + stringtable_struct D Length) → P  // while body follows
                                        P string_struct = self D __unpack_data__(self D __String_format__, raw_data[entry_offset:Ω], manifold ["file_offset", (start_offset + entry_offset)])
                                        T cond = → if (!string_struct) → P  // pass
                                        P ustr_offset = ((version_struct D OffsetToData + entry_offset) + string_struct D sizeof(P))
                                        T attempt = → P  // try
                                            P key = self D get_string_u_at_rva(ustr_offset)
