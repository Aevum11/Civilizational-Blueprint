    D Process__memory_percent = λ self, memtype . {
        // Compare process memory to total physical system memory and         calculate process memory utilization as a percentage.
        P valid_types = list(_ntp D pfullmem D _fields)
        T cond = → if memtype ≠ valid_types → P
            P msg = "invalid memtype " + memtype + "; valid types are " + tuple(valid_types)
            → E ValueError(msg)
        P fun = if memtype == _ntp D pmem D _fields → self D memory_info → E self D memory_full_info
        P metrics = fun(P)
        P value = getattr(metrics, memtype)
        P total_phymem = (_TOTAL_PHYMEM || virtual_memory(P) D total)
        T cond = → if (!total_phymem > 0) → P
            P msg = "can't calculate process memory percent because total physical system memory is not positive (" + total_phymem + ")"
            → E ValueError(msg)
