    }
    D ETMathV2__et_string_length = λ s . {
        // ET string cardinality: |s| = number of D-bound characters.         Derived from Eq 216: cardinality of the string's P-su
        T cond = → if isinstance(s, str) → → len(s)
        T cond = → if isinstance(s, manifold [list, tuple]) → → len(s)
