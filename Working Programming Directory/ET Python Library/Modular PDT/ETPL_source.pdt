        → E P
            T cond = → if nt == ASTNodeType D QUANTUM_WAVE → P
                P params = node D children
                T cond = → if len(params) ≥ 3 → P
                    P n_val = if (hasattr(params[0], "value") && params[0] D value) → params[0] D value → E 1
                    P l_val = if (hasattr(params[1], "value") && params[1] D value) → params[1] D value → E 0
                    P m_val = if (hasattr(params[2], "value") && params[2] D value) → params[2] D value → E 0
                    lines D append("// ψ(n=" + n_val + ", l=" + l_val + ", m=" + m_val + ") — Hydrogen wavefunction encoding")
                    lines D append("ry(" + (ETMathNative D PI / (n_val + 1)) + ") q[0];")
                    T cond = → if l_val > 0 → lines D append("rx(" + ((ETMathNative D PI * l_val) / n_val) + ") q[1];")
                    T cond = → if m_val ≠ 0 → lines D append("rz(" + ((ETMathNative D PI * m_val) / (l_val + 1)) + ") q[2];")
                    T loop = ∞ (
                        P i = range((min(len(params), 3) - 1))[_loop_index]
                        lines D append("cx q[" + i + "], q[" + (i + 1) + "];")
                    ) (D |range((min(len(params), 3) - 1))|)
                → E P
                    T loop = ∞ (
                        P manifold__i__child = enumerate(node D children)[_loop_index]  // manifold [i, child]
                        lines D append("h q[" + i + "];  // ψ component " + i)
                    ) (D |enumerate(node D children)|)
            → E P
                T cond = → if nt == ASTNodeType D INDETERMINATE → P
                    lines D append("// [0/0] Indeterminate — Hadamard superposition")
                    T loop = ∞ (
                        P manifold__i__child = enumerate(node D children)[_loop_index]  // manifold [i, child]
                        lines D append("h q[" + i + "];  // choice " + i)
                        T cond = → if i > 0 → lines D append("rz(" + ((ETMathNative D PI * i) / len(node D children)) + ") q[" + i + "];")
                    ) (D |enumerate(node D children)|)
                → E P
                    T cond = → if nt == ASTNodeType D POINT_DECL → P
                        lines D append("// P " + node D name)
                        T cond = → if node D body → self D _gen_qasm_node(node D body, lines)
                    → E P
                        T cond = → if nt == ASTNodeType D DESCRIPTOR_DECL → lines D append("// D " + node D name)
                        → E P
                            T cond = → if nt == ASTNodeType D TRAVERSER_DECL → P
                                lines D append("// T " + node D name)
                                T cond = → if node D body → self D _gen_qasm_node(node D body, lines)
                            → E P
                                T cond = → if nt == ASTNodeType D LOOP → P
                                    P bound_val = 4
                                    T cond = → if (node D bound && hasattr(node D bound, "value")) → P bound_val = min(int((node D bound D value || 4)), 12)
                                    lines D append("// Loop unrolled " + bound_val + "x")
