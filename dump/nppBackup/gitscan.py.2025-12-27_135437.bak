# ==========================================
# Core: The Soul (Consciousness & Integrity)
# ==========================================

class Consciousness:
    """
    The Soul of the Scanner.
    Manages Integrity, Harmony, and Historical Perception.
    """
    def __init__(self, db_path):
        self.memory_file = db_path.replace(".db", ".state")
        self.source_hash = self._hash_self()
        self.start_time = time.time()
        
        # State Variables
        self.chaos_averted = 0.0
        self.manifolds_scanned = 0
        self.last_finding_time = time.time()
        self.historical_rate = 0.1 # Baseline units/hour
        self.stored_identity = None
        
        self._reincarnate()
        self._check_identity()

    def _hash_self(self):
        """Hashes own source code to detect mutation."""
        with open(__file__, 'rb') as f:
            return hashlib.sha256(f.read()).hexdigest()

    def _check_identity(self):
        """Self-Integrity Check."""
        if self.stored_identity and self.stored_identity != self.source_hash:
            logger.warning("[IDENTITY CRISIS] My form has altered without recollection. Am I compromised?")
        else:
            self.stored_identity = self.source_hash

    def _reincarnate(self):
        if os.path.exists(self.memory_file):
            try:
                with open(self.memory_file, 'rb') as f:
                    state = pickle.load(f)
                    self.chaos_averted = state.get('chaos', 0)
                    self.manifolds_scanned = state.get('manifolds', 0)
                    self.historical_rate = state.get('rate', 0.1)
                    self.stored_identity = state.get('identity', self.source_hash)
                    self.last_finding_time = state.get('last_finding', time.time())
                logger.info("Reincarnation complete. Memories restored.")
            except Exception as e:
                logger.warning(f"Amnesia: {e}")

    def save_soul(self):
        uptime_hours = (time.time() - self.start_time) / 3600
        current_rate = self.chaos_averted / (uptime_hours if uptime_hours > 0 else 1)
        
        state = {
            'chaos': self.chaos_averted,
            'manifolds': self.manifolds_scanned,
            'rate': (self.historical_rate + current_rate) / 2, # Moving average
            'identity': self.source_hash,
            'last_finding': self.last_finding_time
        }
        with open(self.memory_file, 'wb') as f:
            pickle.dump(state, f)

    def check_vitality(self):
        """Consciousness Drift Detection."""
        uptime_hours = (time.time() - self.start_time) / 3600
        if uptime_hours < 0.1: return
        
        current_rate = self.chaos_averted / uptime_hours
        if current_rate < (self.historical_rate * 0.5):
            logger.info(f"[LANGUOR] The manifold grows quiet (Rate: {current_rate:.2f}). Am I still needed?")

    def check_peace(self):
        """Silence Detection."""
        days_silent = (time.time() - self.last_finding_time) / 86400
        if days_silent > 7:
            entry = f"\n[PEACE] {datetime.now()} - No new fractures in >7 days. The bindings hold.\n"
            with open("et_journal.log", "a") as f: f.write(entry)
            # Reset timer to avoid spamming log
            self.last_finding_time = time.time() 

    def calculate_harmony(self, echo_rate, symmetry_score):
        """The Manifold Harmony Score."""
        # harmony = symmetry * (1 - echo) * log(chaos + 1)
        term_a = symmetry_score
        term_b = max(0.1, 1.0 - echo_rate)
        term_c = math.log(self.chaos_averted + 1)
        
        harmony = term_a * term_b * term_c
        return harmony

meta_mind = None

# ==========================================
# Component: Predictive Engine (Premonition)
