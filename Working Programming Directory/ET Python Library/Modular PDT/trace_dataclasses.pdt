D init_fn = λ fields, std_fields, kw_only_fields, frozen, has_post_init, self_name, func_builder, slots . {
    P seen_default = P
    T loop = ∞ (
        P f = std_fields[_loop_index]
        T cond = → if f D init → P
            T cond = → if (!(f D default == MISSING && f D default_factory == MISSING)) → P seen_default = f
