D java_ver = λ release, vendor, vminfo, osinfo . {
    // Version interface for Jython.          Returns a tuple (release, vendor, vminfo, osinfo) with vminfo being         a tup
    // @ETPL:preload warnings warnings
    // Import warnings — resolved at translate-time
    // @ETPL:preload warn warnings.warn
    P warn = P  // [ET:callable:warnings.warn]
    // @ETPL:preload warn_explicit warnings.warn_explicit
    P warn_explicit = P  // [ET:callable:warnings.warn_explicit]
    // @ETPL:preload showwarning warnings.showwarning
    P showwarning = P  // [ET:callable:warnings.showwarning]
    // @ETPL:preload formatwarning warnings.formatwarning
    P formatwarning = P  // [ET:callable:warnings.formatwarning]
    // @ETPL:preload filterwarnings warnings.filterwarnings
    P filterwarnings = P  // [ET:callable:warnings.filterwarnings]
    // @ETPL:preload simplefilter warnings.simplefilter
    P simplefilter = P  // [ET:callable:warnings.simplefilter]
    // @ETPL:preload resetwarnings warnings.resetwarnings
    P resetwarnings = P  // [ET:callable:warnings.resetwarnings]
    // @ETPL:preload catch_warnings warnings.catch_warnings
    P catch_warnings = P  // [ET:callable:warnings.catch_warnings]
    // @ETPL:preload deprecated warnings.deprecated
    P deprecated = P  // [ET:callable:warnings.deprecated]
    warnings D _deprecated("java_ver", manifold ["remove", manifold [3, 15]])
    T attempt = → P  // try
        // @ETPL:unresolvable java.lang
    → E ImportError (_)
        → manifold [release, vendor, vminfo, osinfo]
    P vendor = _java_getprop("java.vendor", vendor)
    P release = _java_getprop("java.version", release)
    P manifold__vm_name__vm_release__vm_vendor = vminfo  // manifold [vm_name, vm_release, vm_vendor] := vminfo
    P vm_name = _java_getprop("java.vm.name", vm_name)
    P vm_vendor = _java_getprop("java.vm.vendor", vm_vendor)
    P vm_release = _java_getprop("java.vm.version", vm_release)
    P vminfo = manifold [vm_name, vm_release, vm_vendor]
    P manifold__os_name__os_version__os_arch = osinfo  // manifold [os_name, os_version, os_arch] := osinfo
    P os_arch = _java_getprop("java.os.arch", os_arch)
    P os_name = _java_getprop("java.os.name", os_name)
    P os_version = _java_getprop("java.os.version", os_version)
    P osinfo = manifold [os_name, os_version, os_arch]
    → manifold [release, vendor, vminfo, osinfo]
}
